        "rogue_mass_label30064=暗焱蛟",
        "rogue_mass_label30065=溫柔花",
        "rogue_mass_label30066=生氣菇",
        "rogue_mass_label30067=笑魘貓",
        "rogue_mass_label30068=強力菇",
        "rogue_mass_label30069=旋疾蟲",
        "rogue_mass_label30070=吹炎鼬",
        "rogue_mass_label30071=一拳超菇",
        "rogue_mass_label30072=光鳴球",
        "rogue_mass_label30073=瓦斯龍",
        "rogue_mass_label30074=大磐蟹",
        "rogue_mass_label30075=嬌耳兔",
        "rogue_mass_label30076=晶冠龍",
        "rogue_mass_label30077=蝠耳龍",
        "rogue_mass_label30078=冠軍龍",
        "rogue_mass_label30079=胖達獸",
        "rogue_mass_label30080=鋼背獸",
        "rogue_mass_label30081=滑水魚",
        "rogue_mass_label30082=磁浮怪",
        "rogue_mass_label30083=綿綿怪",
        "rogue_mass_label30084=滴露蜥",
        "rogue_mass_label30085=博愛花",
        "rogue_mass_label30086=蜥尾龍",
        "rogue_mass_label30087=貫空鳥",
        "rogue_mass_label30088=融靈娘",
        "rogue_mass_label30089=燧炎雀",
        "rogue_mass_label30090=踏春花",
        "rogue_mass_label30091=凶凶鳥",
        "rogue_mass_label30092=派博鳥",
        "rogue_mass_label30093=小頑石",
        "rogue_mass_label30094=花崗石",
        "rogue_mass_label30095=不動王",
        "rogue_mass_label30096=泡泡魚",
        "rogue_mass_label30097=米花獸",
        "rogue_mass_label30098=皮皮魚",
        "rogue_mass_label30099=黃絨魚",
        "rogue_mass_label30100=紅幕魚",
        "rogue_mass_des30001=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>黑悠悠</color>\n“暗影中的獵手，從不放過任何破綻！”",
        "rogue_mass_des30002=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>調皮貓</color>\n“就算倒下...也要為大家點亮最後的希望！”",
        "rogue_mass_des30003=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>朦朦龍</color>\n“雲霧中的利爪，專挑最脆弱的時刻！”",
        "rogue_mass_des30004=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>藍空鼠</color>\n“星光會治癒所有傷痕~”",
        "rogue_mass_des30005=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>黑絨鴉</color>\n“看見這黑色羽毛時，你已經死了！”",
        "rogue_mass_des30006=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>音波狐</color>\n“聆聽這死亡的頻率吧！”",
        "rogue_mass_des30007=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>可憐喵</color>\n“集體哀鳴...才是最可怕的攻擊！”",
        "rogue_mass_des30008=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>澄澄泥</color>\n“越是骯髒的環境...我越強大！”",
        "rogue_mass_des30009=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>撩葉猴</color>\n“大自然的生命力，與我同在！”",
        "rogue_mass_des30010=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>樹呆呆</color>\n“陽光...雨露...都是我的營養劑~”",
        "rogue_mass_des30011=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>綠棘鼠</color>\n“想碰我？先問問我的尖刺同不同意！”",
        "rogue_mass_des30012=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>乎乎泥</color>\n“泥漿就是我最棒的鎧甲！”",
        "rogue_mass_des30013=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>綠萌萌</color>\n“長得可愛不代表好欺負哦~”",
        "rogue_mass_des30014=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>珍啾啾</color>\n“痛苦只會讓我唱得更響亮！”",
        "rogue_mass_des30015=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>狠勇菇</color>\n“我的孢子會讓你的治療變成笑話！”",
        "rogue_mass_des30016=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>米米娜</color>\n“蜜糖般的生命，可不是用來浪費的！”",
        "rogue_mass_des30017=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>誕誕魔</color>\n“在死亡邊緣？讓我給你重生的禮物！”",
        "rogue_mass_des30018=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>露娜娜</color>\n“月光會撫平所有傷痛~”",
        "rogue_mass_des30019=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>蒂娜露</color>\n“晨露般清新的治癒，要來一點嗎？”",
        "rogue_mass_des30020=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>可愛狐</color>\n“尾巴著火？不，這是治癒的火焰啦！”",
        "rogue_mass_des30021=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>勾勾鼠</color>\n“我們的羈絆...就是最好的良藥！”",
        "rogue_mass_des30022=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>招魂貓</color>\n“每道傷痕...都會成為我的食糧！”",
        "rogue_mass_des30023=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>骨拉卡拉</color>\n“死亡...不過是另一種能量來源！”",
        "rogue_mass_des30024=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>咩斯特</color>\n“聖光啊！淨化這個敵人吧！”",
        "rogue_mass_des30025=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>喵頭鷹</color>\n“黑夜給了我完美的暴擊視野！”",
        "rogue_mass_des30026=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>嗶嗶鳥</color>\n“吵死人的叫聲就是我的武器！”",
        "rogue_mass_des30027=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>睡羊羊</color>\n“在夢裏...被我吃掉吧~”",
        "rogue_mass_des30028=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>爆萌龜</color>\n“縮進殼裏？不，我是在蓄力反擊！”",
        "rogue_mass_des30029=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>寶莉狐</color>\n“銀尾掃過的傷口，連詛咒都會消失！”",
        "rogue_mass_des30030=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>高知狐</color>\n“知識就是力量...特別是敵人的弱點知識！”",
        "rogue_mass_des30031=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>爆炎豬</color>\n“讓火焰...再猛烈些吧！”",
        "rogue_mass_des30032=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>讀報蠑</color>\n“就算被控制，我也要繼續看報紙！”",
        "rogue_mass_des30033=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>綿絨仙</color>\n“雲朵般柔軟的治癒，專為危難時刻準備！”",
        "rogue_mass_des30034=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>咩小棉</color>\n“絨毛撫過的傷口，痛痛都飛走啦~”",
        "rogue_mass_des30035=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>大耳棉</color>\n“我聽到...你體內負面能量的聲音了！”",
        "rogue_mass_des30036=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>鬼小子</color>\n“幽火灼燒的...可是靈魂哦！”",
        "rogue_mass_des30037=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>重小工</color>\n“工裝褲的每個口袋...都裝著閃避技巧！”",
        "rogue_mass_des30038=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>光靈</color>\n“我的光芒...會刺穿你的要害！”",
        "rogue_mass_des30039=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>噗靈</color>\n“噗哈哈哈...這一擊很痛吧？”",
        "rogue_mass_des30040=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>泥小鰍</color>\n“滑溜溜的泥漿攻擊來啦！”",
        "rogue_mass_des30041=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>蠟胖達</color>\n“蠟質防禦...能量攻擊無效！”",
        "rogue_mass_des30042=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>深海螈</color>\n“來自深海的利爪...見過的人都沉沒了！”",
        "rogue_mass_des30043=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>大嘴球</color>\n“我的大嘴...連能量都能吃掉！”",
        "rogue_mass_des30044=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>小蛋球</color>\n“別看我現在是蛋...破殼時超凶的！”",
        "rogue_mass_des30045=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>鍬形甲</color>\n“團隊防禦...才是完美的防禦！”",
        "rogue_mass_des30046=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>美夢兔</color>\n“在夢裏...你傷不到我~”",
        "rogue_mass_des30047=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>無棘花</color>\n“沒有尖刺...但有毒哦！”",
        "rogue_mass_des30048=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>啼啼蟲</color>\n“吵死了？這才剛剛開始呢！”",
        "rogue_mass_des30049=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>怯怯蟲</color>\n“我、我很害怕...所以下手會特別重！”",
        "rogue_mass_des30050=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>帕露夢</color>\n“夢境碎片...比刀片更鋒利！”",
        "rogue_mass_des30051=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>低魔草</color>\n“低級毒素...也能要你的命！”",
        "rogue_mass_des30052=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>中魔草</color>\n“我的藤蔓...會慢慢勒死你！”",
        "rogue_mass_des30053=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>黑魔草</color>\n“深淵的腐化...從接觸我開始！”",
        "rogue_mass_des30054=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>幻悅魔</color>\n“你的防禦...在我眼裏滿是漏洞！”",
        "rogue_mass_des30055=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>緩緩球</color>\n“等我爆炸...可能要等到下輩子...”",
        "rogue_mass_des30056=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>炎焰狸</color>\n“火焰鞭擊...抽起來特別疼哦！”",
        "rogue_mass_des30057=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>萬磁娃</color>\n“磁力偏轉...你的攻擊打歪啦！”",
        "rogue_mass_des30058=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>閃小花</color>\n“美麗的花瓣...藏著致命毒藥！”",
        "rogue_mass_des30059=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>朋克甲</color>\n“機械義肢...專治各種不服！”",
        "rogue_mass_des30060=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>假面梟</color>\n“獵殺時刻...殘血目標優先！”",
        "rogue_mass_des30061=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>騎士鸮</color>\n“以騎士之名...守護大家！”",
        "rogue_mass_des30062=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>悠點蜂</color>\n“蜂針處決...保證一滴不剩！”",
        "rogue_mass_des30063=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>可怖球</color>\n“殺戮...讓我充滿活力！”",
        "rogue_mass_des30064=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>暗焱蛟</color>\n“黑暗火焰...焚燒一切！”",
        "rogue_mass_des30065=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>溫柔花</color>\n“溫柔的毒藥...才是最致命的！”",
        "rogue_mass_des30066=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>生氣菇</color>\n“生氣起來...連我自己都怕！”",
        "rogue_mass_des30067=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>笑魘貓</color>\n“笑著把你送進噩夢！”",
        "rogue_mass_des30068=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>強力菇</color>\n“孢子爆炸...藝術就是爆炸！”",
        "rogue_mass_des30069=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>旋疾蟲</color>\n“吃掉一個...我就更強壯一分！”",
        "rogue_mass_des30070=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>吹炎鼬</color>\n“連環攻擊...才是我的風格！”",
        "rogue_mass_des30071=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>一拳超菇</color>\n“一拳！只要一拳！”",
        "rogue_mass_des30072=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>光鳴球</color>\n“光芒吞噬...轉化為我的生命！”",
        "rogue_mass_des30073=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>瓦斯龍</color>\n“毒雲過境...寸草不生！”",
        "rogue_mass_des30074=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>大磐蟹</color>\n“蟹鉗重擊...山崩地裂！”",
        "rogue_mass_des30075=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>嬌耳兔</color>\n“月光聚焦...暴擊準備就緒！”",
        "rogue_mass_des30076=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>晶冠龍</color>\n“戰鬥開始...就是我的showtime！”",
        "rogue_mass_des30077=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>蝠耳龍</color>\n“超聲波鎖定...控場開始！”",
        "rogue_mass_des30078=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>冠軍龍</color>\n“王者的審判...你準備好了嗎？”",
        "rogue_mass_des30079=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>胖達獸</color>\n“鐵竹消化中...防禦力max！”",
        "rogue_mass_des30080=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>鋼背獸</color>\n“能量攻擊？撓癢癢而已！”",
        "rogue_mass_des30081=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>滑水魚</color>\n“水流會帶走所有衝擊力~”",
        "rogue_mass_des30082=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>磁浮怪</color>\n“殘血收割機...啟動！”",
        "rogue_mass_des30083=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>綿綿怪</color>\n“軟綿綿...但打不死！”",
        "rogue_mass_des30084=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>滴露蜥</color>\n“晨露的治癒效果...超級加倍！”",
        "rogue_mass_des30085=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>博愛花</color>\n“被暴擊？送你個護盾當回禮！”",
        "rogue_mass_des30086=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>蜥尾龍</color>\n“龍尾橫掃...清場開始！”",
        "rogue_mass_des30087=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>貫空鳥</color>\n“俯衝攻擊...控場者的噩夢！”",
        "rogue_mass_des30088=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>融靈娘</color>\n“虛化狀態...能量攻擊無效化！”",
        "rogue_mass_des30089=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>燧炎雀</color>\n“生命之火...將永遠傳承！”",
        "rogue_mass_des30090=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>踏春花</color>\n“春之印記...治癒永不停歇！”",
        "rogue_mass_des30091=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>凶凶鳥</color>\n“兇暴模式ON！連環攻擊準備！”",
        "rogue_mass_des30092=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>派博鳥</color>\n“派對時間...連擊狂歡開始！”",
        "rogue_mass_des30093=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>小頑石</color>\n“我超硬的...你打不動！”",
        "rogue_mass_des30094=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>花崗石</color>\n“花崗岩防禦...站著讓你打！”",
        "rogue_mass_des30095=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>不動王</color>\n“王者的尊嚴...不容撼動！”",
        "rogue_mass_des30096=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>泡泡魚</color>\n“泡泡防禦陣...群體傷害減免！”",
        "rogue_mass_des30097=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>米花獸</color>\n“爆米花護盾...單點防禦專家！”",
        "rogue_mass_des30098=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>皮皮魚</color>\n“彈性皮膚...傷害反彈！”",
        "rogue_mass_des30099=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>黃絨魚</color>\n“絨毛緩衝...單攻克星！”",
        "rogue_mass_des30100=此處有<color=#ff8000>概率</color>成功捕捉<color=#ff8000>紅幕魚</color>\n“紅色警戒...群體防禦啟動！”",
        "rogue_title_41111=高知狐",
        "rogue_lang1_41111=<Color=#FFB912>咦？新面孔呢~</color>這裡是虛無裂隙，連接破碎維度的危險空間，請務必謹慎行動。裂隙中充滿未知的威脅與機遇，你的每個選擇都至關重要。你要繼續探索嗎？",
        "rogue_lang1_choiceA_41111=是的，我已準備好探索裂隙",
        "rogue_lang1_choiceB_41111=等等...狐狸為什麼會說話？",
        "rogue_chooseA_lang_41111=很好，勇氣可嘉。記住！<color=#FFB912>發光的可以踩</color>！請跟隨指引進行首次探索吧！",
        "rogue_chooseB_lang_41111=在裂隙裡，會說話的狐狸只是最普通的異常現象呢~記住！<color=#FFB912>發光的可以踩</color>！快跟隨指引進行首次探索吧！",
        "rogue_lang2_chooseA_41111=離開",
        "rogue_lang2_chooseB_41111=離開",
        "rogue_title_41112=讀報蠑",
        "rogue_lang1_41112=哦？新顧客！請允許我為您介紹——《紋章商店使用指南》頭條！",
        "rogue_lang1_choiceA_41112=最貴的那個！立刻給我！",
        "rogue_chooseA_lang_41112=豪爽的客人！但建議先看看錢包...",
        "rogue_lang2_chooseA_41112=有沒有...免費體驗裝？",
        "rogue_title_41113=咩斯特",
        "rogue_lang1_41113=咩咿~歡迎來到冒險者營地！受傷的心靈和身體都可以在這裡得到治癒哦~",
        "rogue_lang1_choiceA_41113=才、才不是特地來治療的！只是路過！",
        "rogue_chooseA_lang_41113=知道啦~那要'順路'做個免費體檢嗎？咩咿~",
        "rogue_lang2_chooseA_41113=給我上最貴的恢復套餐！",
        "rogue_title_41114=喵頭鷹",
        "rogue_lang1_41114=咕咕~ 夜安，冒險者。在虛無裂隙中，可不止有明面上的戰鬥哦~讓我為你揭示那些…‘意外的小驚喜’。",
        "rogue_lang1_choiceA_41114=我要最瘋狂的那個事件！現在！",
        "rogue_chooseA_lang_41114=咕哈哈哈哈——！！",
        "rogue_lang2_chooseA_41114=喵？",
        "rogue_title_411141=喵頭鷹",
        "rogue_lang1_411141=歡迎來到【禁忌·午夜馬戲團】特別場！來選擇你要參與的專案吧！",
        "rogue_lang1_choiceA_411141=攻擊馬戲團帳篷",
        "rogue_lang1_choiceB_411141=參與魔術表演",
        "rogue_lang1_choiceC_411141=向觀眾席扔金幣",
        "rogue_chooseA_lang_411141=小丑們集體進入暴走模式。",
        "rogue_chooseB_lang_411141=你自願進入電鋸箱子，分身出1個臨時克隆體。(離開馬戲團後馬上消失)",
        "rogue_chooseC_lang_411141=獲得增加1%歡呼條（滿100%直接勝利）",
        "rogue_lang2_chooseA_411141=你趁亂從暴走小丑的假髮裡摸出<Color=#FFB912>1個星鑽</color>。真是一場鬧劇！",
        "rogue_lang2_chooseB_411141=克隆體從魔術師的高帽裡偷出<Color=#FFB912>1顆星鑽</color>遞給你。真是一場鬧劇！",
        "rogue_lang2_chooseC_411141=<Color=#FFB912>1個星鑽</color>精准砸中你的頭。真是一場鬧劇！",
        "rogue_title_41115=晶冠龍",
        "rogue_lang1_41115=吼~！幸運的尋寶者！本龍的寶箱，可比那些破銅爛鐵刺激多了。每次開啟都是一個驚喜！",
        "rogue_lang1_choiceA_41115=都是空的！你尾巴尖在偷偷發光…是不是能控制結果？",
        "rogue_chooseA_lang_41115=記住！最好的寶藏永遠在……你剛才沒檢查的那個破袋子裡！吼！！！",
        "rogue_lang2_chooseA_41115=破袋子是吧？我要全部撕爛！！",
        "rogue_title_41116=高知狐",
        "rogue_lang1_41116=看來你已初步適應裂隙的規則。你是被裂隙‘選中’的人，選一個與你靈魂共鳴的夥伴吧。對了，這是",
        "rogue_lang1_choiceA_41116=我全都要！",
        "rogue_lang1_choiceB_41116=坐下開始冥想",
        "rogue_lang1_choiceC_41116=我要看四只源神的詳細數值表！",
        "rogue_chooseA_lang_41116=檢測到貪欲超載！激活懲罰協議。對了，把<Color=#FFB912>逆流之刻</color>帶上，你會用到的",
        "rogue_chooseB_lang_41116=你的猶豫讓裂隙都卡頓了…對了，把<Color=#FFB912>逆流之刻</color>帶上，你會用到的",
        "rogue_chooseC_lang_41116=這裡是虛無裂隙，不是遊戲！對了，把<Color=#FFB912>逆流之刻</color>帶上，你會用到的",
        "rogue_lang2_chooseA_41116=懲罰協議？我連你一起揍！",
        "rogue_lang2_chooseB_41116=不要著急，不要著急，休息，休息一會...",
        "rogue_lang2_chooseC_41116=可你的設定很像NPC啊！",
        "rogue_title_41117=幻悅魔",
        "rogue_lang1_41117=哦？選中了這個小傢伙？……但在我面前，你真的能帶走它嗎？",
        "rogue_lang1_choiceA_41117=如果我能贏，你以後不准再干擾我！",
        "rogue_lang1_choiceB_41117=轉身就跑",
        "rogue_chooseA_lang_41117=可以……但輸了的話，你的靈魂也得抵押哦~",
        "rogue_chooseB_lang_41117=脆弱的掙扎……真令人愉悅。",
        "rogue_lang2_chooseA_41117=少廢話！開打吧！",
        "rogue_lang2_chooseB_41117=別、別過來！",
        "rogue_area1=裂隙淺層",
        "rogue_area2=裂隙中層",
        "rogue_area3=裂隙深層",
        "rogue_area4=裂隙暗淵",
        "rogue_area5=裂隙禁域",
        "rogue_area_des1=<Color=#ff8000>裂隙淺層</color>\n解鎖劇情：<Color=#2894FF>踏入深淵</color>\n解鎖地圖：<Color=#2894FF>星空迴廊、沸土焦痕</color>",
        "rogue_area_des2=<Color=#ff8000>裂隙中層</color>\n解鎖特殊地圖：<Color=#2894FF>時隙之約</color>，<Color=#FFB912>可獲得大量喚靈誓約</color>",
        "rogue_area_des3=<Color=#ff8000>裂隙深層</color>\n解鎖地圖：<Color=#2894FF>風息綠海</color>",
