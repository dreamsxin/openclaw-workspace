        "hero_age_064=0",
        "hero_birthplace_064=0",
        "hero_hate_064=0",
        "hero_zm_064=又見面了啊？我現在算是編外人員嗎，之前填表格的時候好像是這麼說的。",
        "hero_chat1_064=0",
        "hero_chat2_064=0",
        "hero_chat3_064=0",
        "hero_name_065=撒拉弗",
        "hero_j_name_065=露西娜",
        "hero_description_065=0",
        "hero_hobby_065=0",
        "hero_height_065=0",
        "hero_birth_065=0",
        "hero_age_065=0",
        "hero_birthplace_065=0",
        "hero_hate_065=0",
        "hero_zm_065=你好，執行官。我可不是來玩的，是來學習的。奧莉瑞安小姐都過來了，我也不好一個人呆在帕克斯。",
        "hero_chat1_065=0",
        "hero_chat2_065=0",
