        "fail_text_1008=解鎖陣型槽位",
        "fail_text_1009=陣營克制",
        "fail_text_1010=指令等級",
        "fail_text_1011=幻靈羈絆",
        "fail_text_1012=更強幻靈",
        "fail_text_1013=提升帶兵量",
