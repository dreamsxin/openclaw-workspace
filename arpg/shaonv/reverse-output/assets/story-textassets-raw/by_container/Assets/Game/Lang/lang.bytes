        "draw_rate110101=出現概率(含保底)：<Color=#FFA500>SSR</Color>概率2%，<Color=#8000ff>SR</Color>概率8.5%，<Color=#FFA500>SR碎片</Color>概率18%，<Color=#1E90FF>其它</Color>概率71.5%",
        "draw_rate110201=出現概率(含保底)：<Color=#FF0000>SSR+</Color>概率2%，<Color=#FFA500>SSR</Color>概率2.6%，<Color=#8000ff>SR</Color>概率3%，<Color=#FFA500>SSR碎片</Color>概率5.2%，<Color=#8000ff>SR碎片</Color>概率15%，<Color=#1E90FF>其它</Color>概率72.2%",
        "draw_rate120101=出現概率(含保底)：<Color=#FF0000>SSR+</Color>概率0.2%，<Color=#FFA500>SSR</Color>概率2%，<Color=#FFA500>SSR碎片</Color>概率17.5%，<Color=#1E90FF>其它</Color>概率80.3%",
        "draw_rate120201=出現概率(含保底)：<Color=#FF0000>SSR+</Color>概率2%，<Color=#FFA500>SSR</Color>概率3%，<Color=#FF0000>SSR+碎片</Color>概率6%，<Color=#FFA500>SSR碎片</Color>概率10%，<Color=#1E90FF>其它</Color>概率79%",
        "draw_rate140101=出現概率(含保底)：<Color=#8000ff>SR</Color>概率1.2%，<Color=#1E90FF>R</Color>概率5%，<Color=#8000ff>SR碎片</Color>概率5.5%，<Color=#1E90FF>R碎片</Color>概率12%，<Color=#1E90FF>其它</Color>概率76.3%",
        "draw_rate140201=出現概率(含保底)：<Color=#FFA500>SSR</Color>概率1%，<Color=#8000ff>SR</Color>概率4%，<Color=#FFA500>SSR碎片</Color>概率6%，<Color=#8000ff>SR碎片</Color>概率10%，<Color=#1E90FF>其它</Color>概率79%",
        "draw_rate140301=出現概率(含保底)：<Color=#FF0000>SSR+</Color>概率0.5%，<Color=#FFA500>SSR</Color>概率3%，<Color=#FF0000>SSR+碎片</Color>概率5%，<Color=#FFA500>SSR碎片</Color>概率10%，<Color=#1E90FF>其它</Color>概率81.5%",
        "draw_rate140401=出現概率(含保底)：<Color=#FF0000>SSR+</Color>概率2.5%，<Color=#FFA500>SSR</Color>概率1.5%，<Color=#FF0000>SSR+碎片</Color>概率10%，<Color=#FFA500>SSR碎片</Color>概率7.5%，<Color=#1E90FF>其它</Color>概率78.5%",
