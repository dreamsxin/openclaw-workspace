        "label_des_2400681=行動結束時,對業火蓮種持有方所有單位造成施加者100%攻擊的能量傷害",
        "label_n_2400691=<Color=#54c194>烈陽</Color>",
        "label_des_2400691=1級：暴擊率提升15%，持續2回合\n2級：暴擊率提升25%，生命偷取提高15%，持續2回合",
        "label_n_2400692=<Color=#54c194>女帝天威</Color>",
        "label_des_2400692=反擊概率提升50%，持續3回合",
        "label_n_2400761=<Color=#54c194>紅顏</Color>",
        "label_des_2400761=(不可驅散)每層提升3%傷害，最高疊加20層，達到滿層時，額外提升40%傷害，持續至戰鬥結束",
        "label_n_2400762=<Color=#54c194>紅顏鏡盾</Color>",
        "label_des_2400762=屬於護盾的一種。根據等級護盾值為貂蟬最大生命的3%/4%/5%/6%，護盾持續2回合。該護盾被打破時，貂蟬獲得2層【紅顏】，達到紅顏鏡盾LV4時，被打破額外獲得【琉璃淨體】",
        "label_n_2400768=<Color=#54c194>琉璃淨體</Color>",
        "label_des_2400768=免疫燃燒、中毒、裂痕且免傷提高25%，持續2回合",
        "label_n_2400811=<Color=#FF5F59>雷霆威壓</Color>",
        "label_des_2400811=受到傷害提升10%，造成傷害降低10%，持續2回合",
        "label_n_2400819=<Color=#FFD06C>轟雷</Color>",
        "label_des_2400819=雷電對敵方生命百分比最低的單位造成自身攻擊80%的物理傷害，本次傷害必定暴擊",
        "label_n_2400821=<Color=#54c194>愛神之吻</Color>",
        "label_des_2400821=回合結束時,恢復阿布羅狄忒最大生命7.5%的生命,持續3回合",
        "label_n_2400822=<Color=#54c194>玫瑰輕吻</Color>",
        "label_des_2400822=回合結束時,恢復阿布羅狄忒最大生命5%的生命,持續2回合",
        "label_n_2400831=<Color=#54c194>神怒</Color>",
        "label_des_2400831=(不可驅散)每層提升5%傷害，上限7層，持續至戰鬥結束",
        "label_n_2400861=<Color=#54c194>黃沙渴飲</Color>",
        "label_des_2400861=生命偷取+15%，根據等級受到直接治療的50%/60%/70%會轉化為護盾施加給賽特,該護盾最大值不超過賽特最大生命的15%，該護盾不受護盾加成效果影響",
        "label_n_2400862=<Color=#FFD06C>混沌守護</Color>",
        "label_des_2400862=為目標分攤100%傷害，持續2回合",
        "label_n_2400863=<Color=#54c194>沙之甲</Color>",
        "label_des_2400863=屬於護盾的一種，根據等級獲得賽特7.5%/10%/12.5%/15%最大生命的護盾，受到傷害降低10%/15%/20%/25%。擁有該護盾時賽特受到傷害時，根據等級30%/40%/50%/60%概率會為攻擊者施加【沙縛】。沙之甲效果持續2回合",
        "label_n_2400871=<Color=#54c194>心臟稱量</Color>",
        "label_des_2400871=根據等級免傷提升10%/15%/20%",
        "label_n_2400911=<Color=#FFD06C>聖焰同契</Color>",
        "label_des_2400911=根據等級受到單體傷害減少15%/25%,受到傷害的30%由瓦爾基裡分攤,持續2回合",
        "label_n_2400931=<Color=#FFD06C>熾羽蓄勢</Color>",
        "label_des_2400931=最高疊加150層，每層提升0.3%免傷，並為朱雀技能「南煌流焰」提供傷害",
        "label_n_2400941=<Color=#FFD06C>對位</Color>",
        "label_des_2400941=攻擊與自己相同站位的敵方目標，若敵方目標退場，則攻擊前方敵方單位",
        "label_n_2400942=<Color=#FF5F59>獵殺標記</Color>",
        "label_des_2400942=受到傷害提升20%，受療效果降低20%，持續2回合",
        "label_n_2400981=<Color=#54c194>天穹之愈</Color>",
        "label_des_2400981=行動後結束後，根據等級回復自身3%/3.5%/4%最大生命，持續2回合",
        "label_n_2400989=<Color=#FF5F59>隨機減益</Color>",
        "label_des_2400989=隨機施加【攻擊降低5%】、【防禦降低5%】、【暴擊率降低5%】、【傷害降低5%】、【易傷5%】中的一個，持續2回合",
        "label_n_2400991=<Color=#54c194>神翼領域</Color>",
        "label_des_2400991=自身免傷提升20%，持續3回合",
        "label_n_2400992=<Color=#FFD06C>鷹翼庇護</Color>",
        "label_des_2400992=荷魯斯為我方目標單位分攤30%傷害，根據等級該單位受到範圍傷害降低15%/20%/25%",
        "label_n_2401011=<Color=#54c194>歸墟暴怒</Color>",
        "label_des_2401011=根據等級暴擊率提升25%/35%/50%，持續2回合",
        "label_n_2401012=<Color=#54c194>玄冥蓄勢</Color>",
        "label_des_2401012=(不可驅散)根據等級每層提升3%/4%/5%暴擊傷害和傷害加成，最高疊加8層，達到4級時，滿層額外獲得20%暴擊傷害和傷害加成，持續至戰鬥結束",
        "label_n_2401021=<Color=#FFD06C>漢雪</Color>",
        "label_des_2401021=根據等級傷害提升15%/25%/35%，造成傷害時，為目標施加【漢律】",
        "label_n_2401022=<Color=#FF5F59>漢燼</Color>",
        "label_des_2401022=(不可淨化)受到護盾、治療效果降低100%,持續3回合",
        "label_n_2401023=<Color=#FF5F59>漢律</Color>",
        "label_des_2401023=受到護盾、治療效果降低30%,持續3回合",
        "label_n_2401031=<Color=#54c194>太初元息</Color>",
        "label_des_2401031=受到傷害後，消耗1層【太初元息】，根據等級獲得東皇太一最大生命3%/4%/5%的治療",
        "label_n_2400925=<Color=#54c194>女媧庇護</Color>",
        "label_des_2400925=免傷提升35%，持續2回合",
        "label_n_2400975=<Color=#FFD06C>智慧之壁·固</Color>",
        "label_des_2400975=每層免傷提高1.5%，最高疊加20層，持續至戰鬥結束",
        "label_n_2400978=<Color=#54c194>智慧之壁·禦</Color>",
        "label_des_2400978=免疫【攻擊降低】、【防禦降低】效果，持續2回合",
        "label_n_2400684=<Color=#FF5F59>業火蓮種</Color>",
        "label_des_2400684=(不可淨化)行動後，對所有處於【燃燒】狀態的友方單位造成施加者100%攻擊的傷害，持續1回合",
        "label_n_2400969=<Color=#FFD06C>龍吟</Color>",
        "label_des_2400969=對敵方隨機2個單位造成自身攻擊70%的能量傷害，分別有60%概率為目標施加2回合【傷害降低15%】。該技能冷卻2回合",
        "label_n_1=",
        "label_des_1=",
        "buff_name_1001=燃燒",
