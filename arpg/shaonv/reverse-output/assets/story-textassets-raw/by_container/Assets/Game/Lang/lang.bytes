        "fail_tips_1001=提升天文秘儀等級至<Color=#FFA500>{0}</Color>",
        "fail_tips_1002=兵力未達到最大帶兵量",
        "fail_tips_1003=提升等級至<Color=#FFA500>{0}</Color>級",
        "fail_tips_1004=提升星級至<Color=#FFA500>{0}</Color>星{1}階",
        "fail_tips_1005=提升已解鎖技能至<Color=#FFA500>{0}</Color>級",
        "fail_tips_1006=靈裝強化至<Color=#FFA500>{0}</Color>級",
        "fail_tips_1007=收容所工作人數達到<Color=#FFA500>{0}</Color>人",
        "fail_tips_1008=前往解鎖更多陣型槽位",
        "fail_tips_1009=注意陣營克制，進行站位優化",
        "fail_tips_1010=指令平均等級達到<Color=#FFA500>{0}</Color>級",
        "fail_tips_1011=使用羈絆幻靈上場",
