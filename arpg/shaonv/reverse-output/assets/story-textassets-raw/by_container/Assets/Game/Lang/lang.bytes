        "skilln_240103201=熒惑守心",
        "skilld_240058001=伊卡洛斯煽動羽翼,發射機械導彈矩陣,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害",
        "skilld_240040001=希爾芙使用冰淇淩進行攻擊,<Color=#FFD06C>普通攻擊</Color>後,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【裂痕】</Color>",
        "skilld_240040101=希爾芙使用冰淇淩進行攻擊,<Color=#FFD06C>普通攻擊</Color>後,對普通攻擊目標造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,自身獲得<Color=#54c194>【攻擊提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240043001=奇美拉扔出手裡的小黑進行變形攻擊,對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,本段傷害附帶<Color=#FFD06C>{1}%</Color>暴擊率",
        "skilld_240043101=奇美拉扔出隱藏的微形爆彈,對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害",
        "skilld_240086001=賽特引導沙漠與風暴之力守護己身,自身獲得<Color=#54c194>【沙之甲LV{0}】</Color>，為橫排(優先後排)隊友施加<Color=#FFD06C>{1}</Color>回合<Color=#54c194>【能量免傷提升{2}%】</Color>",
        "skilld_240086101=賽特積蓄神力,使風之力環繞己方場地，其他友方獲得<Color=#54c194>【黃沙渴飲LV{0}】</Color>,持續<Color=#FFD06C>{1}</Color>回合",
        "skilld_240086201=賽特在場時，其他隊友受到主動攻擊後，生命值首次低於<Color=#FFD06C>{0}%</Color>時，賽特為其施加<Color=#FFD06C>【混沌守護】</Color>，每場戰鬥只會觸發<Color=#FFD06C>{1}</Color>次，每個單位每場戰鬥只會觸發1次",
        "skilld_240067001=妖姬俯身蓄力,引導妖刀之力發動斬擊,對敵方橫排（優先攻擊後排）造成自身攻擊<Color=#FFD06C>{0}%</Color>物理傷害，並<Color=#FFD06C>{1}%</Color>概率施加<Color=#FF5F59>【裂痕】</Color>",
        "skilld_240067101=妖姬旋身高高躍起,揮刀下砸,對敵方橫排（優先攻擊後排）造成自身攻擊<Color=#FFD06C>{0}%</Color>物理傷害，並施加<Color=#FFD06C>{1}</Color>回合的<Color=#FF5F59>【受療降低{2}%】</Color>",
        "skilld_240067201=對後排傷害提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240084001=孫尚香投擲風之槍,釋放風之力後強力揮擊,對敵方橫排（優先攻擊後排）造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,當目標處於<Color=#FF5F59>【裂痕】</Color>狀態,係數提升至<Color=#FFD06C>{1}%</Color>。",
        "skilld_240084101=孫尚香揮舞風之槍快速突刺後急速下砸,對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並為目標施加<Color=#FF5F59>【裂痕】</Color>",
        "skilld_240084201=敵方每存在1個處於<Color=#FF5F59>【裂痕】</Color>的單位,孫尚香對後排傷害提高<Color=#FFD06C>{0}%</Color>",
        "skilld_240081001=雷神索爾揮動巨錘快速旋轉,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，並為目標施加<Color=#FF5F59>【雷霆威壓】</Color>",
        "skilld_240081101=對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，額外附帶<Color=#FFD06C>{1}%</Color>的暴擊率",
        "skilld_240081201=自身對攜帶<Color=#FF5F59>【雷霆威壓】</Color>的單位，傷害提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240047001=須佐之男召喚黑蝕旋風後貫射吞噬萬物的冥獄之箭,對敵方隨機3人單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並<Color=#FFD06C>{1}%</Color>有概率為目標施加<Color=#FF5F59>【裂痕】</Color>",
        "skilld_240047101=須佐之男揮刀快速斬擊,對敵方攻擊最高單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,若目標處於<Color=#FF5F59>【裂痕】</Color>狀態，則係數提升至<Color=#FFD06C>{1}%</Color>",
        "skilld_240047201=對<Color=#FF5F59>【裂痕】</Color>狀態下的敵人傷害提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240075001=為我方全體施加自身最大生命<Color=#FFD06C>{0}%</Color>的<Color=#54c194>【護盾】</Color>,處於該<Color=#54c194>【護盾】</Color>保護下受到的傷害降低<Color=#FFD06C>{1}%</Color>,<Color=#54c194>【護盾】</Color>持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240075101=為自身與自身外攻擊最高的友方單位施加自身最大生命<Color=#FFD06C>{0}%</Color>的<Color=#54c194>【護盾】</Color>,處於該<Color=#54c194>【護盾】</Color>保護下造成傷害提升<Color=#FFD06C>{1}%</Color>,<Color=#54c194>【護盾】</Color>持續{2}</Color>回合",
        "skilld_240075201=回合開始前,為我方生命最低單位施加施加自身最大生命<Color=#FFD06C>{0}%</Color>的<Color=#54c194>【護盾】</Color>,<Color=#54c194>【護盾】</Color>持續{1}</Color>回合",
        "skilld_240042001=妖師引導鯤鵬之力加護自身,自身獲得最大生命<Color=#FFD06C>{0}%</Color>的<Color=#54c194>【護盾】</Color>,持續<Color=#FFD06C>{1}</Color>回合",
        "skilld_240042101=妖師召喚鯤鵬虛影從空中下落猛擊,對敵方隨機3個單位造成攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，並額外使自身與我方攻擊最高單位獲得鯤鵬最大生命<Color=#FFD06C>{1}%</Color>的<Color=#54c194>【護盾】</Color>，持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240042201=妖師鯤鵬在場時,我方受到持續傷害降低<Color=#FFD06C>{0}%</Color>",
        "skilld_240053001=小喬引導星羅法球的治癒之力,治療我方生命最低的2個單位,治療量為小喬最大生命的<Color=#FFD06C>{0}%</Color>",
        "skilld_240053101=小喬引導星羅之力鎖定友軍,治療我方生命最低的2個單位,治療量為小喬最大生命的<Color=#FFD06C>{0}%</Color>,並為其施加<Color=#54c194>【免傷提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240053201=回合開始前，<Color=#FFD06C>{0}%</Color>概率為敵方全體施加<Color=#FF5F59>【裂痕】</Color>",
        "skilld_240062001=大喬揮舞紙傘連續打擊,對敵方攻擊最高的目標造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,為目標施加<Color=#FF5F59>【裂痕】</Color>",
        "skilld_240062101=大喬乘風而下揮舞紙傘衝刺突擊,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並為我方攻擊最高的2個單位施加<Color=#FFD06C>{1}</Color>回合<Color=#54c194>【單體傷害提升{2}%】</Color>和大喬<Color=#FFD06C>{3}%</Color>最大生命的【護盾】",
        "skilld_240062201=大喬在場時,敵方被施加<Color=#FF5F59>【裂痕】</Color>的目標受到傷害提高<Color=#FFD06C>{0}%</Color>",
        "skilld_240037001=阿修羅長槍亂舞,對敵方攻擊最高單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害並施加<Color=#FF5F59>【戰慄烙印】</Color>",
        "skilld_240037101=對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,攻擊處於<Color=#FF5F59>【戰慄烙印】</Color>效果的目標,技能傷害提升至<Color=#FFD06C>{1}%</Color>",
        "skilld_240037201=攻擊<Color=#FF5F59>【裂痕】</Color>狀態下的敵人，自身獲得<Color=#FFD06C>{0}%</Color>傷害加成",
        "skilld_240074001=立花訚千代揮動太刀,釋放血色劍氣,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,攝取目標<Color=#FFD06C>{1}%</Color>攻擊、<Color=#FFD06C>{1}%</Color>防禦,持續<Color=#FFD06C>{2}</Color>回合;若目標處於<Color=#FF5F59>【裂痕】</Color>,額外攝取<Color=#FFD06C>{3}</Color>倍屬性",
        "skilld_240074101=立花訚千代收刀蓄力後,釋放一字斬,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,之後將攝取的攻擊<Color=#FFD06C>共用</Color>給後排隊友,將攝取的防禦<Color=#FFD06C>共用</Color>給前排隊友（共用目標不包括自身）",
        "skilld_240074201=立花訚千代在場時,敵方攻擊最高單位受到傷害提高<Color=#FFD06C>{0}%</Color>,造成傷害降低<Color=#FFD06C>{1}%</Color>",
        "skilld_240064001=對敵方橫排造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害",
        "skilld_240044001=諸葛月姬高高躍起,投擲機械工具箱引發爆炸,對敵方單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,之後自身獲得<Color=#54c194>【防禦提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240044101=諸葛月姬揮動機械工具箱二連砸擊,<Color=#FFD06C>普通攻擊</Color>後,<Color=#FFD06C>{0}%</Color>概率觸發,對普通攻擊目標造成自身攻擊<Color=#FFD06C>{1}%</Color>的物理傷害,並為自身施加<Color=#54c194>【物理免傷提升{2}%】</Color>,持續<Color=#FFD06C>{3}</Color>回合",
        "skilld_240080001=甄宓旋轉提燈引導治癒之力,治療我方生命最低單位,治療量為甄宓最大生命的<Color=#FFD06C>{0}%</Color>,之後為我方攻擊最高的單位施加<Color=#54c194>【攻擊提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240080101=甄宓虔誠祈禱生成治癒法陣,治療我方生命最低單位,治療量為甄宓最大生命的<Color=#FFD06C>{0}%</Color>,之後為我方防禦最高的單位施加<Color=#54c194>【防禦提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240035001=伊斯塔爾拉滿弓弦,射出烈陽之箭,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,敵方人數越少傷害越高,傷害最高提升至<Color=#FFD06C>{1}%</Color>,若成功擊退目標,則重置<Color=#FFD06C>滅世之吻</Color>的技能冷卻",
        "skilld_240035101=伊斯塔爾轉弓為槍,猛擊前方敵人,對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,若成功擊退目標,則重置<Color=#FFD06C>滅世之吻</Color>的技能冷卻",
        "skilld_240035201=攻擊目標生命低等於<Color=#FFD06C>{0}%</Color>,傷害提高<Color=#FFD06C>{1}%</Color>",
        "skilld_240052001=普羅米修士積蓄電光之力,向前釋放雷電之網,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害，並為敵方攻擊最高2個單位施加<Color=#FFD06C>{1}</Color>回合<Color=#FF5F59>【暴擊易傷{2}%】</Color>",
        "skilld_240052101=普羅米修士啟用電子機械眼,釋放鐳射子彈,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,本段傷害附帶<Color=#FFD06C>{1}%</Color>暴擊概率",
        "skilld_240052201=自身暴擊率提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240055001=天狐妲己沖入敵陣,揮動摺扇,形成火焰風暴,對縱列造成自身最大生命值<Color=#FFD06C>{0}%</Color>的能量傷害，自身獲得<Color=#FFD06C>{1}</Color>層<Color=#54c194>【狐之庇佑】</Color>\n被動效果：若處於<Color=#FFD06C>【天狐】</Color>狀態下，則恢復自身<Color=#FFD06C>{2}%</Color>最大生命",
        "skilld_240055101=天狐妲己旋舞摺扇喚起燎原火環,灼燒周圍敵人,對敵方全體造成自身最大生命值<Color=#FFD06C>{0}%</Color>的能量傷害，<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【魅惑】</Color>",
        "skilld_240055201=天狐妲己受到攻擊後<Color=#FFD06C>{0}%</Color>概率給攻擊者施加<Color=#FF5F59>【魅惑】</Color>。\n天狐妲己受到致命傷時不會死亡，立即恢復最大生命值的<Color=#FFD06C>{1}%</Color>,並變身<Color=#FFD06C>【天狐】</Color>",
        "skilld_240048001=鄧嬋玉拋出小機器人,使用巨化泰山壓頂,對敵方隨機單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,若擊退目標則再次釋放該技能（單回合只能連續釋放1次）",
        "skilld_240048101=鄧嬋玉駕駛機車進行風馳電掣的衝撞攻擊,對敵方隨機單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,下次釋放的<Color=#FFD06C>「追光」</Color>技能傷害係數提升<Color=#FFD06C>{1}%</Color>",
        "skilld_240048201=自身攻擊生命百分比小於等於<Color=#FFD06C>{0}%</Color>的目標,吸血提高<Color=#FFD06C>{1}%</Color>;大於<Color=#FFD06C>{2}%</Color>的目標,傷害提高<Color=#FFD06C>{3}%</Color>",
        "skilld_240069001=女帝躍入敵陣,使用長槍進行戳刺攻擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,自身獲得<Color=#54c194>【烈陽LV{1}】</Color>",
        "skilld_240069101=女帝使用長槍蓄力,召喚五爪金龍向前衝鋒,對敵方單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,之後進入<Color=#54c194>【女帝天威】</Color>狀態",
        "skilld_240069201=任意友方單位受到主動攻擊<Color=#FFD06C>{0}%</Color>概率進行<Color=#FFD06C>反擊</Color>,對攻擊者造成<Color=#FFD06C>{1}%</Color>女帝攻擊的物理傷害;敵方人數越少,本次傷害越高,最高獲得傷害加成<Color=#FFD06C>{2}%</Color>",
        "skilld_240076001=貂蟬舞動星杖引動星流,發動高頻連擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,每命中1個目標，為自身疊加1層 <Color=#54c194>【紅顏】</Color>",
        "skilld_240076101=貂蟬引導天相之力,向敵方投射無盡星刺,對敵方單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害",
        "skilld_240076201=回合開始時，貂蟬獲得<Color=#54c194>【紅顏鏡盾LV{0}】</Color>，冷卻<Color=#FFD06C>{1}</Color>回合",
        "skilld_240031001=申公豹召喚“豹豹”,發動超高速的瘋狂亂抓！並施加祝福,對敵方隨機2名單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，我方防禦最高單位獲得<Color=#54c194>【抗暴率提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240031101=申公豹揮鞭快速抽擊,破環敵方裝甲,對敵方攻擊最高單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並施加<Color=#FF5F59>【暴擊率降低{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240031201=生命高於<Color=#FFD06C>{0}%</Color>時，免傷提升提高<Color=#FFD06C>{1}%</Color>",
        "skilld_240088001=亞瑟召喚光之力,環繞自身,獲得自身最大生命<Color=#FFD06C>{0}%</Color>的<Color=#54c194>【護盾】</Color>，持續<Color=#FFD06C>{1}</Color>回合",
        "skilld_240088101=亞瑟引導光之力,凝聚光之巨劍攻擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,我方全體獲得<Color=#54c194>【免傷提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240088201=戰鬥開始前，我方全體獲得亞瑟<Color=#FFD06C>{0}%</Color>最大生命的<Color=#54c194>【護盾】</Color>，持續至戰鬥結束",
        "skilld_240087001=阿努比斯展開魔導之書,揮落審判金頁灼燒前方敵人,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,為自身施加<Color=#54c194>【心臟稱量LV{1}】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240087101=阿努比斯舞動秩序手杖臨空猛擊,對敵方隨機3人造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並為我方攻擊最高的<Color=#FFD06C>{1}</Color>個單位施加<Color=#FFD06C>{2}</Color>回合<Color=#54c194>【傷害提升{3}%】</Color>",
        "skilld_240087201=行動結束時，恢復自身<Color=#FFD06C>{0}%</Color>的最大生命",
        "skilld_240045001=蔡文姬撥動琴弦,發出治癒音波,治療我方生命最低的2個單位,治療量為蔡文姬最大生命的<Color=#FFD06C>{0}%</Color>,敵方每存在1個<Color=#FF5F59>【燃燒】</Color>單位,本次治療係數提高<Color=#FFD06C>{1}%</Color>,最多生效<Color=#FFD06C>{2}</Color>個",
        "skilld_240045101=蔡文姬輕輕躍起,撥動琴弦,生成恢復法陣,治療我方全體,治療量為蔡文姬最大生命的<Color=#FFD06C>{0}%</Color>",
        "skilld_240045201=回合開始時,蔡文姬分別有<Color=#FFD06C>{0}%</Color>概率為敵方全體施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240082001=阿布羅狄忒向空中投射治癒之箭,生成治癒領域,為我方生命最低單位進行治療,治療量為阿布羅狄忒最大生命的<Color=#FFD06C>{0}%</Color>,並為其施加<Color=#54c194>【愛神之吻】</Color>",
        "skilld_240082101=阿布羅狄忒飛向高空,降下治癒之吻,為我方生命最低單位進行治療,治療量為阿布羅狄忒最大生命的<Color=#FFD06C>{0}%</Color>,並為其施加<Color=#54c194>【玫瑰輕吻】</Color>",
        "skilld_240082201=回合開始前，為我方攻擊最高的{0}個單位施加<Color=#FFD06C>{1}</Color>回合<Color=#54c194>【攻擊提升{2}%】</Color>，冷卻<Color=#FFD06C>{3}</Color>回合",
        "skilld_240072001=河童向空中發射治癒水彈,治療我方全體,治療量為河童最大生命的<Color=#FFD06C>{0}%</Color>",
        "skilld_240073001=鳳凰火騰空揮鞭二連擊,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,本段傷害附帶<Color=#FFD06C>{1}%</Color>傷害加成",
        "skilld_240073101=鳳凰火召喚火鴉揮鞭螺旋衝擊,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240057001=輝夜揮舞太刀蓄力突刺,臨空後揮刀下劈,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,敵方全場每存在1個<Color=#FF5F59>【中毒】</Color>狀態,本段傷害係數提升<Color=#FFD06C>{1}%</Color>,最高提升至<Color=#FFD06C>{2}%</Color>",
        "skilld_240057101=輝夜瞬移至敵人上方,揮刀劈砍後向下突刺,對敵方隨機單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,若目標處於<Color=#FF5F59>【中毒】</Color>狀態,則附帶<Color=#FFD06C>{1}%</Color>傷害加成",
        "skilld_240057201=對處於<Color=#FF5F59>【中毒】</Color>狀態下單位傷害提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240054001=黃月英引導自然能量,造成能量爆炸,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害;<Color=#FFD06C>{1}%</Color>概率為命中目標施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240054101=黃月英積蓄奧數能量,向前方發射奧數鐳射,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害;<Color=#FFD06C>{1}%</Color>概率對攻擊目標施加<Color=#FF5F59>【傷害降低{2}%】</Color>，持續<Color=#FFD06C>{3}</Color>回合",
        "skilld_240054201=行動結束時,隨機選取2名敵方單位,分別有<Color=#FFD06C>{0}%</Color>概率對其施加<Color=#FFD06C>{1}</Color>回合的<Color=#FF5F59>【防禦降低{2}%】</Color>",
        "skilld_240089001=蔥聾高高騰空躍起,向前方射下大量箭雨,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害;敵方人數越少傷害係數越高,最高提升至<Color=#FFD06C>{1}%</Color>;並分別有<Color=#FFD06C>{2}%</Color>概率為目標施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240089101=蔥聾使用弓弦蓄力，射出巨型能量箭，對敵方生命最低的2個單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害;若目標處於<Color=#FF5F59>【中毒】</Color>,傷害係數提升至<Color=#FFD06C>{1}%</Color>",
        "skilld_240089201=行動結束時,蔥聾對敵方生命最低單位施加<Color=#FF5F59>【中毒】</Color>,若目標已處於<Color=#FF5F59>【中毒】</Color>對其造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害",
        "skilld_240046001=相柳召喚氣劍從天而降,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，並有<Color=#FFD06C>{1}%</Color>概率施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240046101=相柳積蓄劍氣,召喚龍之力禦空斬擊,對敵方隨機單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害;若對方處於<Color=#FF5F59>【中毒】</Color>狀態下，本次傷害必定暴擊",
        "skilld_240046201=對處於<Color=#FF5F59>【中毒】</Color>狀態下單位傷害提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240060001=努特召喚巨大碎岩,從空中墜落,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240060101=努特揮舞法杖召喚沙石漩渦,對敵方攻擊最高單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並施加<Color=#FFD06C>{1}</Color>回合<Color=#FF5F59>【減速】</Color>",
        "skilld_240060201=努特被攻擊時,有<Color=#FFD06C>{0}%</Color>概率為目標施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240038001=玉兔揮舞氣錘,擊打月餅,引發大爆炸,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害並有<Color=#FFD06C>{1}%</Color>概率施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240038101=玉兔揮舞氣錘,一頓亂砸,對敵方隨機單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,附帶<Color=#FFD06C>{1}%</Color>傷害加成",
        "skilld_240038201=若攻擊目標生命高於<Color=#FFD06C>{0}%</Color>，則傷害提高<Color=#FFD06C>{1}%</Color>",
        "skilld_240034001=迦樓羅化為巨大旋風,向前突進,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,再對敵方全體造成自身攻擊<Color=#FFD06C>{1}%</Color>的能量傷害",
        "skilld_240034101=迦樓羅煽動羽翼飛至敵方上空,投擲能量翎羽,對敵方全體造成<Color=#FFD06C>{0}%</Color>的能量傷害",
        "skilld_240034201=造成物理傷害時有<Color=#FFD06C>{0}%</Color>概率為目標施加<Color=#FFD06C>{1}</Color>回合<Color=#FF5F59>【攻擊降低{2}%】</Color>;造成能量傷害時有<Color=#FFD06C>{3}%</Color>概率為目標施加<Color=#FFD06C>{4}</Color>回合<Color=#FF5F59>【防禦降低{5}%】</Color>",
        "skilld_240083001=米迦勒拉動提琴,奏響神聖樂章,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【恐懼】</Color>",
        "skilld_240083101=米迦勒召喚神庭,向目的地區域傾瀉審判聖槍,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，命中處於<Color=#FF5F59>【中毒】</Color>下的敵人時,該技能有<Color=#FFD06C>{1}%</Color>概率重置冷卻",
        "skilld_240083201=對擁有<Color=#FF5F59>負面狀態</Color>的敵人傷害提升<Color=#FFD06C>{0}%</Color>，造成傷害時，有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240090001=狄俄涅揮舞水之槍,召喚水之力向前轟擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【中毒】</Color>,每中毒1人獲得自身最大生命值<Color=#FFD06C>{2}%</Color>的<Color=#54c194>【護盾】</Color>（該護盾不受護盾加成效果影響），<Color=#54c194>【護盾】</Color>持續<Color=#FFD06C>{3}</Color>回合",
        "skilld_240090101=狄俄涅快速近身繞後斬擊,對敵方敵方橫排（優先攻擊後排）造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並為目標施加<Color=#FFD06C>{1}</Color>回合<Color=#FF5F59>【攻擊降低{2}%】</Color>",
        "skilld_240090201=回合開始前，為敵方攻擊最高單位施加<Color=#FFD06C>{0}</Color>回合的<Color=#FF5F59>【範圍傷害降低{1}%】</Color>和<Color=#FF5F59>【減速】</Color>",
        "skilld_240039001=梅林引導光之符文形成治癒之息,治療我方生命最低的2個單位,治療量為梅林最大生命的<Color=#FFD06C>{0}%</Color>,為目標施加<Color=#54c194>【能量免傷提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240039101=梅林召喚治癒法球,治療我方生命最低單位,治療量為梅林最大生命的<Color=#FFD06C>{0}%</Color>",
        "skilld_240039201=行動結束時,會治療生命最低的單位,治療量為梅林最大生命的<Color=#FFD06C>{0}%</Color>",
        "skilld_240041001=阿奴凱特召喚治癒法陣,治療我方攻擊最高單位,治療量為自身最大生命的<Color=#FFD06C>{0}%</Color>,治療目標獲得<Color=#54c194>【攻擊提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240041101=阿奴凱特召喚治癒水球,治療我方生命最低的2個單位,治療量為阿奴凱特最大生命的<Color=#FFD06C>{0}%</Color>,治療目標獲得<Color=#54c194>【防禦提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240041201=治療時，若目標生命低於<Color=#FFD06C>{0}%</Color>，則治療效果提高<Color=#FFD06C>{1}%</Color>",
        "skilld_240066001=步練師揮舞長槍旋身二連擊,對敵方橫排造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害",
        "skilld_240030001=妲己揮舞摺扇,卷起火焰旋風,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240030101=妲己以扇起舞,引動火焰風暴,<Color=#FFD06C>普通攻擊</Color>後<Color=#FFD06C>{0}%</Color>概率觸發,對普通攻擊目標造成自身攻擊<Color=#FFD06C>{1}%</Color>的能量傷害,並為自身施加最大生命<Color=#FFD06C>{2}%</Color>的<Color=#54c194>【護盾】</Color>,持續<Color=#FFD06C>{3}</Color>回合",
        "skilld_240065001=莉莉絲舞動法杖,引導光耀之力騰空猛擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>能量傷害,攻擊生命百分比<Color=#FFD06C>{1}%</Color>以上的目標時,係數提升至<Color=#FFD06C>{2}%</Color>",
        "skilld_240065101=莉莉絲騰空引導光耀之力,降下懲戒光柱,對敵方生命最低的2個單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,本段傷害附帶<Color=#FFD06C>{1}%</Color>傷害加成",
        "skilld_240065201=行動結束時,莉莉絲對我方橫排（優先後排）施加<Color=#54c194>【月鋒LV{0}】</Color>",
        "skilld_250065001=寂漣・莉莉絲舞動法杖,引導光耀之力騰空猛擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>能量傷害,攻擊生命百分比<Color=#FFD06C>{1}%</Color>以上的目標時,係數提升至<Color=#FFD06C>{2}%</Color>;第1次釋放該技能時,傷害提升<Color=#FFD06C>{3}%</Color>",
        "skilld_250065101=寂漣・莉莉絲騰空引導光耀之力,降下懲戒光柱,對敵方生命最低的2個單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,本段傷害附帶<Color=#FFD06C>{1}%</Color>傷害加成",
        "skilld_250065201=行動結束時,寂漣・莉莉絲為我方橫排（優先後排）施加<Color=#54c194>【寂刃LV{0}】</Color>",
        "skilld_240032001=玉藻前引導狐火生成爆炸法陣,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240032101=玉藻前積蓄能量,指引粉色狐火,對敵方單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,目標身上每有1層<Color=#FF5F59>【燃燒】</Color>傷害係數提升<Color=#FFD06C>{1}%</Color>,最多生效<Color=#FFD06C>{2}</Color>個",
        "skilld_240032201=對處於<Color=#FF5F59>【燃燒】</Color>狀態下單位傷害提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240068001=哪吒揮槍向空中突刺，騰空後猛擊地面,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,目標存在<Color=#FF5F59>【燃燒】</Color>，則係數提升至<Color=#FFD06C>{1}%</Color>;並有<Color=#FFD06C>{2}%</Color>概率施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240068101=哪吒引導勾玉中的火焰能量釋放火蓮,對敵方單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,若敵方處於<Color=#FF5F59>【燃燒】</Color>,本次攻擊必定暴擊；且造成爆炸,對所有<Color=#FF5F59>【燃燒】</Color>下的其他敵人造成攻擊<Color=#FFD06C>{1}%</Color>的能量傷害",
        "skilld_240068201=全場每存在1個處於<Color=#FF5F59>【燃燒】</Color>的單位,哪吒將提高<Color=#FFD06C>{0}%</Color>暴擊率",
        "skilld_240085001=伊邪那美積蓄煉獄紫炎,釋放大爆炸,對敵方隨機3人造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,並分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240085101=伊邪那美召喚幽冥魚群,釋放煉獄紫炎向前侵蝕,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【焚燼】</Color>,若目標處於<Color=#FF5F59>【燃燒】</Color>,施加<Color=#FF5F59>【焚燼】</Color>的概率提升至<Color=#FFD06C>{2}%</Color>",
        "skilld_240085201=伊邪那美在場時,我方全體對<Color=#FF5F59>【燃燒】</Color>下敵方單位造成傷害提高<Color=#FFD06C>{0}%</Color>",
        "skilld_240050001=海姆達爾揮刀蓄力,施展紫炎斬擊,對敵方全體造成自攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,驅散目標<Color=#FFD06C>{1}</Color>個增益",
        "skilld_240050101=海姆達爾轉刀突刺,引導紫炎爆炸侵襲,對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,目標生命每降低<Color=#FFD06C>{1}%</Color>,本次係數提高<Color=#FFD06C>{2}%</Color>,最高提升至<Color=#FFD06C>{3}%</Color>",
        "skilld_240050201=造成傷害時，若受擊單位生命低於<Color=#FFD06C>{0}%</Color>，則傷害提升<Color=#FFD06C>{1}%</Color>",
        "skilld_240079001=陰陽師揮動太刀發動四連斬擊,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,為目標施加<Color=#FF5F59>【暴擊率降低{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240079101=陰陽師引導術式之力環繞自身,獲得<Color=#FFD06C>{0}</Color>回合<Color=#FFD06C>{1}%</Color>最大生命的<Color=#54c194>【護盾】</Color>",
        "skilld_240079201=被暴擊時,受到暴傷降低<Color=#FFD06C>{0}%</Color>",
        "skilld_240070001=紫苑從虛空中召喚能量箭雨,向前方快速投射,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,為我方全體施加<Color=#FFD06C>{1}</Color>回合<Color=#54c194>【免傷提升{2}%】</Color>",
        "skilld_240070101=紫苑念力控制巨型光輪進行旋轉打擊,對敵方攻擊最高單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,若命中<Color=#FFD06C>毀滅</Color>或<Color=#FFD06C>狂刃</Color>職業,則獲得<Color=#FFD06C>{1}%</Color>最大生命的<Color=#54c194>【護盾】</Color>;若命中其他職業則獲得<Color=#FFD06C>{2}%</Color>最大生命的<Color=#54c194>【護盾】</Color>,持續<Color=#FFD06C>{3}</Color>回合",
        "skilld_240070201=回合開始前，紫苑為我方攻擊最高單位施加<Color=#FFD06C>{0}</Color>回合<Color=#54c194>【單體免傷提升{1}%】</Color>",
        "skilld_240091001=瓦爾基裡使用騎兵長槍,進行多次高速突刺,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240091101=瓦爾基裡使用長槍蓄力,向前打出旋風衝擊,對敵方隨機單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,自身獲得<Color=#FFD06C>{1}%</Color>最大生命的<Color=#54c194>【護盾】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240091201=回合開始時，獲得<Color=#FFD06C>{0}%</Color>自身最大生命的<Color=#54c194>【護盾】</Color>；自身外友方攻擊最高單位獲得<Color=#FFD06C>【聖焰同契LV{1}】</Color>，技能冷卻<Color=#FFD06C>{2}</Color>回合",
        "skilld_240061001=塔納托斯揮動鐮刀,發射死亡脈衝,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，我方攻擊最高單位獲得<Color=#54c194>【冥府契約LV{1}】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240061101=塔納托斯躍上月空,召喚紅月並投下暗影鐮刀,對敵方生命最低的2個單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，本段技能附帶<Color=#FFD06C>{1}%</Color>暴擊，擊退目標後立即再次釋放該技能（每回合只能觸發1次）",
        "skilld_240061201=本場戰鬥中,每有1個單位退場，自身獲得1層<Color=#54c194>【冥息LV{0}】</Color>",
        "skilld_240092001=女媧揮筆舞動山河畫卷,治療我方生命最低的2個單位,治療量為女媧最大生命的<Color=#FFD06C>{0}%</Color>，並為我方攻擊最高的<Color=#FFD06C>{1}</Color>個單位施加<Color=#54c194>【攻擊提升{2}%】</Color>,持續<Color=#FFD06C>{3}</Color>回合",
        "skilld_240092101=女媧淩空召喚上古靈蛇，降下生命之雨,治療我方生命最低單位,治療量為女媧最大生命的<Color=#FFD06C>{0}%</Color>,若目標生命低於<Color=#FFD06C>{1}%</Color>，則該技能治療量提升<Color=#FFD06C>{2}%</Color>",
        "skilld_240092201=女媧在場時，其他隊友若受到致命傷害，女媧施展造化輪回技能，將該單位生命變更為<Color=#FFD06C>{0}%</Color>的最大生命，每場戰鬥最多生效<Color=#FFD06C>{1}</Color>次，同一個單位可多次觸發",
        "skilld_240093001=朱雀揮動熾焰劍,釋放離炎劍氣,對敵方全體造成<Color=#FFD06C>{0}%</Color>自身攻擊的能量傷害，若目標擁有<Color=#FF5F59>【燃燒】</Color>，則有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240093101=朱雀騰空掠起，向地面區域進行離火衝擊,對敵方全體造成<Color=#FFD06C>{0}%</Color>自身攻擊的能量傷害，自身每擁有1層<Color=#FFD06C>【熾羽蓄勢】</Color>，本段傷害係數提升<Color=#FFD06C>{1}%</Color>；滿層時釋放時，本段傷害獲得<Color=#FFD06C>{2}%</Color>傷害加成，但釋放後會消除所有<Color=#FFD06C>【熾羽蓄勢】</Color>層數；該技能無法暴擊",
        "skilld_240093201=朱雀釋放主動技能後，目標中每有1層<Color=#FF5F59>【燃燒】</Color>，自身獲得{0}層<Color=#FFD06C>【熾羽蓄勢】</Color>;目標中每有1個<Color=#FF5F59>【焚燼】</Color>，自身獲得{1}層<Color=#FFD06C>【熾羽蓄勢】</Color>；敵方每退場1人，額外獲得<Color=#FFD06C>{2}</Color>層<Color=#FFD06C>【熾羽蓄勢】</Color>；單次最多獲得<Color=#FFD06C>{3}</Color>層",
        "skilld_240094001=白虎揮舞虎爪進行迅猛爪擊,對敵方<Color=#FFD06C>【對位】</Color>的單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，並為目標施加<Color=#FF5F59>【獵殺標記】</Color>",
        "skilld_240094101=白虎高高躍起,臨空墜地猛擊,對敵方<Color=#FFD06C>【對位】</Color>的單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，若目標為<Color=#FF5F59>【獵殺標記】</Color>目標，則本次傷害提升<Color=#FFD06C>{1}%</Color>",
        "skilld_240094201=友方對處於<Color=#FF5F59>【獵殺標記】</Color>的目標進行主動單體攻擊後，白虎進行一次<Color=#FFD06C>追擊</Color>，每回合最多觸發<Color=#FFD06C>{0}</Color>次，造成白虎攻擊<Color=#FFD06C>{1}%</Color>的物理傷害。戰場中退場1名幻靈，白虎永久獲得<Color=#FFD06C>{2}%</Color>傷害提升,不可驅散",
        "skilld_240095001=修普諾斯引導月華,使用長槍進行攻擊,對敵方單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，該傷害附帶<Color=#FFD06C>{1}%</Color>穿甲",
        "skilld_240095101=修普諾斯自新月而下,長槍俯衝突擊,對敵方單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，若目標為存禦或療佑職業，<Color=#FFD06C>{1}%</Color>概率再對敵方單體追加自身攻擊<Color=#FFD06C>{2}%</Color>的物理傷害",
        "skilld_240095201=當修普諾斯受到敵方攻擊生命首次低於<Color=#FFD06C>{0}%</Color>且未陣亡時，對敵方全體造成自身攻擊<Color=#FFD06C>{1}%</Color>的物理傷害（受到主動攻擊時觸發）",
        "skilld_240096001=青龍召喚水龍卷，牽引並撕裂範圍內的敵人,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害，分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240096101=青龍改易山川，召喚神力發動滔天水嘯,對敵方隨機2個單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害，分別有<Color=#FFD06C>{1}%</Color>概率為<Color=#FF5F59>【中毒】</Color>狀態的目標施加<Color=#FF5F59>【水葬】</Color>",
        "skilld_240096201=青龍造成傷害時，敵方每擁有1個<Color=#FF5F59>負面狀態</Color>，青龍獲得1層<Color=#FFD06C>{0}%</Color>傷害加成，最多<Color=#FFD06C>{1}</Color>層",
        "skilld_240097001=雅典娜引導戰爭女神的庇護,為我方全體施加<Color=#FFD06C>{0}</Color>回合雅典娜最大生命<Color=#FFD06C>{1}%</Color>的<Color=#54c194>【護盾】</Color>",
        "skilld_240097101=雅典娜召喚戰爭替身,協同貫射審判之槍,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，並為目標施加<Color=#FFD06C>{1}</Color>回合<Color=#FF5F59>【受療降低{2}%】</Color>",
        "skilld_240097201=雅典娜在場時，我方攜帶<Color=#54c194>【護盾】</Color>單位受到的能量傷害降低<Color=#FFD06C>{0}%</Color>",
        "skilld_240098001=赫拉撥動神琴奏響覆蓋全場的聖音,為我方全體施加<Color=#54c194>【天穹之愈LV{0}】</Color>，為敵方全體施加<Color=#FF5F59>【中毒】</Color>與<Color=#FFD06C>{1}</Color>個<Color=#FF5F59>【隨機減益】</Color>狀態",
        "skilld_240098101=赫拉詠唱淨化聖歌,淨化我方<Color=#FF5F59>負面狀態</Color>最多的2人的<Color=#FFD06C>{0}</Color>個<Color=#FF5F59>負面狀態</Color>，治療我方生命最低的2個單位，治療量為赫拉最大生命的<Color=#FFD06C>{1}%</Color>",
        "skilld_240098201=自身在場時，若敵方單位的<Color=#FF5F59>負面狀態</Color>超過{0}個，造成能量傷害降低<Color=#FFD06C>{1}%</Color>（<Color=#FF5F59>負面狀態</Color>數量每個單位單獨判斷）",
        "skilld_240099001=荷魯斯進入<Color=#54c194>【神翼領域】</Color>，並為我方隊友施加<Color=#FFD06C>【鷹翼庇護LV{0}】</Color>",
        "skilld_240099101=荷魯斯引導星辰之力,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，為我方生命最低的2個單位施加<Color=#FFD06C>{1}</Color>回合荷魯斯最大生命<Color=#FFD06C>{2}%</Color>的<Color=#54c194>【護盾】</Color>",
        "skilld_240099201=自身抗暴率提升<Color=#FFD06C>{0}%</Color>。行動結束時，恢復自身及除自身外攻擊最高的我方單位<Color=#FFD06C>{1}%</Color>最大生命",
        "skilld_240100001=撒拉弗使用巨型治療槍，向前方區域釋放療愈聖霧,治療我方生命最低單位，治療量為撒拉弗最大生命的<Color=#FFD06C>{0}%</Color>,並為我方攻擊最高的2個單位施加<Color=#FFD06C>{1}</Color>回合的<Color=#54c194>【攻擊提升{2}%】</Color>",
        "skilld_240100101=撒拉弗躍至半空，釋放天使之力，向地面釋放神聖治癒波,治療我方生命最低2人，治療量為撒拉弗最大生命值的<Color=#FFD06C>{0}%</Color>",
        "skilld_240100201=奇數回合開始時，分別有<Color=#FFD06C>{0}%</Color>概率為敵方每個單位施加<Color=#FF5F59>【燃燒】</Color>；偶數回合開始時，別分有<Color=#FFD06C>{1}%</Color>概率為敵方每個單位施加<Color=#FF5F59>【焚燼】</Color>",
        "skilld_240101001=玄武操縱巨像獸炮火連射,對敵方橫排造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，自身獲得<Color=#54c194>【歸墟暴怒LV{1}】</Color>",
        "skilld_240101101=玄武召喚戰場空襲炮火打擊,對敵方單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，若目標為<Color=#FFD06C>存禦</Color>、<Color=#FFD06C>療佑</Color>職業，傷害提升<Color=#FFD06C>{1}%</Color>",
        "skilld_240101201=回合開始時，每回合獲得1層<Color=#54c194>【玄冥蓄勢LV{0}】</Color>",
        "skilld_240102001=王昭君舞動團扇,引動風暴向前侵襲,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害，目標每有1個<Color=#FF5F59>負面狀態</Color>，該技能對其的攻擊係數提升<Color=#FFD06C>{1}%</Color>，最高提升至<Color=#FFD06C>{2}%</Color>",
        "skilld_240102101=王昭君喚起荒漠之力,召喚吞噬萬物的沙暴龍卷,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害，若目標生命低於<Color=#FFD06C>{1}%</Color>的單位，該技能對其的攻擊係數提升至<Color=#FFD06C>{2}%</Color>",
        "skilld_240102201=戰鬥開始時，自身獲得<Color=#FFD06C>【漢雪LV{0}】</Color>",
        "skilld_240103001=東皇太一揮劍疾斬，幻化多重劍影撕裂敵人,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害，並目標施加{1}回合<Color=#FF5F59>【能量傷害降低{2}%】</Color>",
        "skilld_240103101=東皇太一踏月臨空，引萬仞傾天而落,對敵方隨機3個單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害，之後治療我方生命最低的3個單位，治療量為東皇太一最大生命<Color=#FFD06C>{1}%</Color>",
        "skilld_240103201=東皇太一主動攻擊後，為我方全體施加<Color=#FFD06C>{0}</Color>回合<Color=#54c194>【免傷提升{1}%】</Color>",
        "skilld_240062001_j=大喬揮舞紙傘連續打擊,對敵方攻擊最高的目標造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,為目標施加<Color=#FF5F59>【裂痕】</Color>，為我方攻擊最高的2個單位施加<Color=#54c194>【裂變】</Color>",
        "skilld_240062101_j=大喬乘風而下揮舞紙傘衝刺突擊,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並為我方攻擊最高的2個單位施加<Color=#FFD06C>{1}</Color>回合<Color=#54c194>【單體傷害提升{2}%】</Color>和大喬<Color=#FFD06C>{3}%</Color>最大生命的【護盾】",
        "skilld_240062201_j=大喬在場時,敵方被施加<Color=#FF5F59>【裂痕】</Color>的目標受到傷害提高<Color=#FFD06C>{0}%</Color>且造成傷害降低<Color=#FFD06C>{1}%</Color>",
        "skilld_240037001_j=阿修羅長槍亂舞,對敵方攻擊最高單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害並施加<Color=#FF5F59>【戰慄烙印】</Color>",
        "skilld_240037201_j=攻擊<Color=#FF5F59>【裂痕】</Color>狀態下的敵人，自身獲得<Color=#FFD06C>{0}%</Color>傷害加成",
        "skilld_240037101_j=對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,攻擊處於<Color=#FF5F59>【戰慄烙印】</Color>效果的目標,技能傷害提升至<Color=#FFD06C>{1}%</Color>;本次攻擊附帶<Color=#FFD06C>{2}%</Color>傷害加成",
        "skilld_240069001_j=女帝躍入敵陣,使用長槍進行戳刺攻擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,自身獲得<Color=#54c194>【烈陽LV{1}】</Color>",
        "skilld_240069201_j=任意友方單位受到主動攻擊<Color=#FFD06C>{0}%</Color>概率進行反擊,對攻擊者造成<Color=#FFD06C>{1}%</Color>女帝攻擊的物理傷害;敵方人數越少,本次傷害越高,最高獲得傷害加成<Color=#FFD06C>{2}%</Color>;每次反擊後女帝會永久獲得<Color=#FFD06C>{3}%</Color>暴擊,最高疊加<Color=#FFD06C>{4}</Color>層",
        "skilld_240082001_j=阿布羅狄忒向空中投射治癒之箭,生成治癒領域,為我方生命最低單位進行治療,治療量為阿布羅狄忒最大生命的<Color=#FFD06C>{0}%</Color>,並為其施加<Color=#54c194>【愛神之吻】</Color>和<Color=#FFD06C>{1}</Color>回合<Color=#54c194>【防禦提升{2}%】</Color>",
        "skilld_240082101_j=阿布羅狄忒飛向高空,降下治癒之吻,為我方生命最低單位進行治療,治療量為阿布羅狄忒最大生命的<Color=#FFD06C>{0}%</Color>,並為其施加<Color=#54c194>【玫瑰輕吻】</Color>;若目標擁有<Color=#54c194>【愛神之吻】</Color>狀態,立即結算該狀態治療量",
        "skilld_240082201_j=回合開始前，為我方攻擊最高的{0}個單位施加<Color=#FFD06C>{1}</Color>回合<Color=#54c194>【攻擊提升{2}%】</Color>，冷卻<Color=#FFD06C>{3}</Color>回合",
        "skilld_240068001_j=哪吒揮槍向空中突刺，騰空後猛擊地面,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,目標存在<Color=#FF5F59>【燃燒】</Color>，則係數提升至<Color=#FFD06C>{1}%</Color>;並有<Color=#FFD06C>{2}%</Color>概率施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240068201_j=全場每存在1個處於<Color=#FF5F59>【燃燒】</Color>的單位,哪吒將提高<Color=#FFD06C>{0}%</Color>暴擊率",
        "skilld_240068101_j=哪吒引導勾玉中的火焰能量釋放火蓮,對敵方單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,若敵方處於<Color=#FF5F59>【燃燒】</Color>,本次攻擊必定暴擊；且為其施加<Color=#FF5F59>【業火蓮種】</Color>，且造成爆炸,對所有<Color=#FF5F59>【燃燒】</Color>下的其他敵人造成攻擊<Color=#FFD06C>{1}%</Color>的能量傷害",
        "skilld_240091001_j=瓦爾基裡使用騎兵長槍,進行多次高速突刺,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240091101_j=瓦爾基裡使用長槍蓄力,向前打出旋風衝擊,對敵方隨機單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,自身獲得<Color=#FFD06C>{1}%</Color>最大生命的<Color=#54c194>【護盾】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240091201_j=回合開始時，獲得<Color=#FFD06C>{0}%</Color>自身最大生命的<Color=#54c194>【護盾】</Color>；自身外友方攻擊最高單位獲得<Color=#FFD06C>【聖焰同契LV{1}】</Color>，技能冷卻<Color=#FFD06C>{2}</Color>回合",
        "skilld_240046001_j=相柳召喚氣劍從天而降,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，並有<Color=#FFD06C>{1}%</Color>概率施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240046101_j=相柳積蓄劍氣,召喚龍之力禦空斬擊,對敵方隨機單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害;若對方處於<Color=#FF5F59>【中毒】</Color>狀態下，本次傷害必定暴擊",
        "skilld_240046201_j=對處於<Color=#FF5F59>【中毒】</Color>狀態下單位傷害提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240089001_j=蔥聾高高騰空躍起,向前方射下大量箭雨,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害;敵方人數越少傷害係數越高,最高提升至<Color=#FFD06C>{1}%</Color>;並分別有<Color=#FFD06C>{2}%</Color>概率為目標施加<Color=#FF5F59>【中毒】</Color>;每成功施加1個<Color=#FF5F59>【中毒】</Color>,自身獲得<Color=#FFD06C>{3}%</Color>攻擊,持續<Color=#FFD06C>{4}</Color>回合",
        "skilld_240089101_j=蔥聾使用弓弦蓄力，射出巨型能量箭，對敵方生命最低的2個單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害;若目標處於<Color=#FF5F59>【中毒】</Color>,傷害係數提升至<Color=#FFD06C>{1}%</Color>",
        "skilld_240089201_j=行動結束時,蔥聾對敵方生命最低單位施加<Color=#FF5F59>【中毒】</Color>,若目標已處於<Color=#FF5F59>【中毒】</Color>對其造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,敵方每有1個<Color=#FF5F59>【中毒】</Color>狀態下的單位,傷害係數提升<Color=#FFD06C>{1}%</Color>",
        "skilld_240065001_j=莉莉絲舞動法杖,引導光耀之力騰空猛擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>能量傷害,攻擊生命百分比<Color=#FFD06C>{1}%</Color>以上的目標時,係數提升至<Color=#FFD06C>{2}%</Color>;第1次釋放該技能時,傷害提升<Color=#FFD06C>{3}%</Color>",
        "skilld_240065101_j=莉莉絲騰空引導光耀之力,降下懲戒光柱,對敵方生命最低的2個單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,本段傷害附帶<Color=#FFD06C>{1}%</Color>傷害加成",
        "skilld_240065201_j=行動結束時,莉莉絲對我方橫排（優先後排）施加<Color=#54c194>【月鋒LV{0}】</Color>",
        "skilld_250065001_j=寂漣・莉莉絲舞動法杖,引導光耀之力騰空猛擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>能量傷害,攻擊生命百分比<Color=#FFD06C>{1}%</Color>以上的目標時,係數提升至<Color=#FFD06C>{2}%</Color>;第1/2/3/4次釋放該技能時,傷害提升<Color=#FFD06C>{3}%/{4}%/{5}%/{6}%</Color>",
        "skilld_250065101_j=寂漣・莉莉絲騰空引導光耀之力,降下懲戒光柱,對敵方生命最低的2個單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,本段傷害附帶<Color=#FFD06C>{1}%</Color>傷害加成",
        "skilld_250065201_j=行動結束時,寂漣・莉莉絲對我方橫排（優先後排）施加<Color=#54c194>【寂刃LV{0}】</Color>，友方攻擊最高單位獲得<Color=#FFD06C>{1}</Color>回合<Color=#54c194>【穿甲提升{2}%】</Color>",
        "skilld_240054001_j=黃月英引導自然能量,造成能量爆炸,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害;<Color=#FFD06C>{1}%</Color>概率為命中目標施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240054101_j=黃月英積蓄奧數能量,向前方發射奧數鐳射,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害;<Color=#FFD06C>{1}%</Color>概率對攻擊目標施加<Color=#FF5F59>【傷害降低{2}%】</Color>;若目標處於<Color=#FF5F59>【中毒】</Color>,施加概率提升至<Color=#FFD06C>{3}%</Color>，持續<Color=#FFD06C>{4}</Color>回合",
        "skilld_240054201_j=行動結束時,隨機選取2名敵方單位,分別有<Color=#FFD06C>{0}%</Color>概率對其施加<Color=#FFD06C>{1}</Color>回合的<Color=#FF5F59>【防禦降低{2}%】</Color>,如果目標已處於<Color=#FF5F59>【中毒】</Color>,則施加概率翻倍。",
        "skilld_240055001_j=天狐妲己沖入敵陣,揮動摺扇,形成火焰風暴,對縱列造成自身最大生命值<Color=#FFD06C>{0}%</Color>的能量傷害，自身獲得<Color=#FFD06C>{1}</Color>層<Color=#54c194>【狐之庇佑】</Color>\n被動效果：若處於<Color=#FFD06C>【天狐】</Color>狀態下，則恢復自身<Color=#FFD06C>{2}%</Color>最大生命",
        "skilld_240055101_j=天狐妲己旋舞摺扇喚起燎原火環,灼燒周圍敵人,對敵方全體造成自身最大生命值<Color=#FFD06C>{0}%</Color>的能量傷害，<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【魅惑】</Color>，且為目標施加<Color=#FFD06C>{2}</Color>回合<Color=#FF5F59>【攻擊降低{3}%】</Color>",
        "skilld_240055201_j=天狐妲己受到攻擊後<Color=#FFD06C>{0}%</Color>概率給攻擊者施加<Color=#FF5F59>【魅惑】</Color>。\n天狐妲己受到致命傷時不會死亡，立即恢復最大生命值的<Color=#FFD06C>{1}%</Color>,並變身<Color=#FFD06C>【天狐】</Color>\n行動前，若<Color=#54c194>【狐之庇佑】</Color>滿層且不處於<Color=#FFD06C>【天狐】</Color>狀態下，則會變身<Color=#FFD06C>【天狐】</Color>(若已處於<Color=#FFD06C>【天狐】</Color>狀態，該效果仍會觸發)",
        "skilld_240076001_j=貂蟬舞動星杖引動星流,發動高頻連擊,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,每命中1個目標，為自身疊加1層 <Color=#54c194>【紅顏】</Color>",
        "skilld_240076101_j=貂蟬引導天相之力,向敵方投射無盡星刺,對敵方單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,若目標生命低於<Color=#FFD06C>{1}%</Color>，則傷害係數提升至<Color=#FFD06C>{2}%</Color>",
        "skilld_240076201_j=回合開始時，貂蟬獲得<Color=#54c194>【紅顏鏡盾LV{0}】</Color>，冷卻<Color=#FFD06C>{1}</Color>回合",
        "skilld_240081001_j=雷神索爾揮動巨錘快速旋轉,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，並為目標施加<Color=#FF5F59>【雷霆威壓】</Color>",
        "skilld_240081101_j=對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，額外附帶<Color=#FFD06C>{1}%</Color>的暴擊率\n被動效果：若受擊目標中帶有<Color=#FF5F59>【雷霆威壓】</Color>，額外追加技能<Color=#FFD06C>「轟雷」</Color>：雷電對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{2}%</Color>的物理傷害，本次傷害必定暴擊",
        "skilld_240081201_j=自身對攜帶<Color=#FF5F59>【雷霆威壓】</Color>的單位，傷害提升<Color=#FFD06C>{0}%</Color>；自身每少1%生命值，暴傷提升<Color=#FFD06C>{1}%</Color>，最高提升至<Color=#FFD06C>{2}%</Color>",
        "skilld_240083001_j=米迦勒拉動提琴,奏響神聖樂章,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【恐懼】</Color>",
        "skilld_240083101_j=米迦勒召喚神庭,向目的地區域傾瀉審判聖槍,對敵方縱列造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,對目標中攻擊最高的單位造成的傷害係數提升至<Color=#FFD06C>{1}%</Color>;命中處於<Color=#FF5F59>【中毒】</Color>下的敵人時,該技能有<Color=#FFD06C>{2}%</Color>概率重置冷卻",
        "skilld_240083201_j=對擁有<Color=#FF5F59>負面狀態</Color>的敵人傷害提升<Color=#FFD06C>{0}%</Color>，造成傷害時，有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【中毒】</Color>。若自身生命低於<Color=#FFD06C>{2}%</Color>，造成傷害時,生命偷取提高<Color=#FFD06C>{3}%</Color>",
        "skilld_240085001_j=伊邪那美積蓄煉獄紫炎,釋放大爆炸,對敵方隨機3人造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,並分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240085101_j=伊邪那美召喚幽冥魚群,釋放煉獄紫炎向前侵蝕,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【焚燼】</Color>,若目標處於<Color=#FF5F59>【燃燒】</Color>,施加<Color=#FF5F59>【焚燼】</Color>的概率提升至<Color=#FFD06C>{2}%</Color>",
        "skilld_240085201_j=伊邪那美在場時,我方全體對<Color=#FF5F59>【燃燒】</Color>下敵方單位造成傷害提高<Color=#FFD06C>{0}%</Color>;<Color=#FF5F59>【焚燼】</Color>下敵方全體造成傷害降低<Color=#FF5F59>{1}%</Color>",
        "skilld_240092001_j=女媧揮筆舞動山河畫卷,治療我方生命最低的2個單位,治療量為女媧最大生命的<Color=#FFD06C>{0}%</Color>，並為我方攻擊最高的<Color=#FFD06C>{1}</Color>個單位施加<Color=#54c194>【攻擊提升{2}%】</Color>,持續<Color=#FFD06C>{3}</Color>回合",
        "skilld_240092101_j=女媧淩空召喚上古靈蛇，降下生命之雨,治療我方生命最低單位,治療量為女媧最大生命的<Color=#FFD06C>{0}%</Color>,若目標生命低於<Color=#FFD06C>{1}%</Color>，則該技能治療量提升<Color=#FFD06C>{2}%</Color>",
        "skilld_240092201_j=女媧在場時，其他隊友若受到致命傷害，女媧施展造化輪回技能，將該單位生命變更為<Color=#FFD06C>{0}%</Color>的最大生命，並獲得<Color=#54c194>【女媧庇護】</Color>，每場戰鬥最多生效<Color=#FFD06C>{1}</Color>次，同一個單位可多次觸發",
        "skilld_240069101_j=女帝使用長槍蓄力,召喚五爪金龍向前衝鋒,對敵方單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,之後進入<Color=#54c194>【女帝天威】</Color>狀態",
        "skilld_240031001_j=申公豹召喚“豹豹”,發動超高速的瘋狂亂抓！並施加祝福,對敵方隨機2名單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，我方防禦最高單位獲得<Color=#54c194>【抗暴率提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240031101_j=申公豹揮鞭快速抽擊,破環敵方裝甲,對敵方攻擊最高單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並施加<Color=#FF5F59>【暴擊率降低{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240031201_j=生命高於<Color=#FFD06C>{0}%</Color>時，免傷提升提高<Color=#FFD06C>{1}%</Color>",
        "skilld_240032101_j=玉藻前積蓄能量,指引粉色狐火,對敵方單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,目標身上每有1層<Color=#FF5F59>【燃燒】</Color>傷害係數提升<Color=#FFD06C>{1}%</Color>,最多生效<Color=#FFD06C>{2}</Color>個",
        "skilld_240032001_j=玉藻前引導狐火生成爆炸法陣,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,分別有<Color=#FFD06C>{1}%</Color>概率為目標施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240032201_j=對處於<Color=#FF5F59>【燃燒】</Color>狀態下單位傷害提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240034101_j=迦樓羅煽動羽翼飛至敵方上空,投擲能量翎羽,對敵方全體造成<Color=#FFD06C>{0}%</Color>的能量傷害",
        "skilld_240034001_j=迦樓羅化為巨大旋風,向前突進,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,再對敵方全體造成自身攻擊<Color=#FFD06C>{1}%</Color>的能量傷害",
        "skilld_240034201_j=造成物理傷害時有<Color=#FFD06C>{0}%</Color>概率為目標施加<Color=#FFD06C>{1}</Color>回合<Color=#FF5F59>【攻擊降低{2}%】</Color>;造成能量傷害時有<Color=#FFD06C>{3}%</Color>概率為目標施加<Color=#FFD06C>{4}</Color>回合<Color=#FF5F59>【防禦降低{5}%】</Color>",
        "skilld_240035001_j=伊斯塔爾拉滿弓弦,射出烈陽之箭,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,敵方人數越少傷害越高,傷害最高提升至<Color=#FFD06C>{1}%</Color>,若成功擊退目標,則重置<Color=#FFD06C>滅世之吻</Color>,的技能冷卻",
        "skilld_240035101_j=伊斯塔爾轉弓為槍,猛擊前方敵人,對敵方生命最低單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的能量傷害,若成功擊退目標,則重置<Color=#FFD06C>滅世之吻</Color>的技能冷卻",
        "skilld_240035201_j=攻擊目標生命低等於<Color=#FFD06C>{0}%</Color>,傷害提高<Color=#FFD06C>{1}%</Color>",
        "skilld_240038001_j=玉兔揮舞氣錘,擊打月餅,引發大爆炸,對敵方全體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害並有<Color=#FFD06C>{1}%</Color>概率施加<Color=#FF5F59>【中毒】</Color>",
        "skilld_240038101_j=玉兔揮舞氣錘,一頓亂砸,對敵方隨機單體造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,附帶<Color=#FFD06C>{1}%</Color>傷害加成",
        "skilld_240038201_j=若攻擊目標生命高於<Color=#FFD06C>{0}%</Color>，則傷害提高<Color=#FFD06C>{1}%</Color>",
        "skilld_240039001_j=梅林引導光之符文形成治癒之息,治療我方生命最低的2個單位,治療量為梅林最大生命的<Color=#FFD06C>{0}%</Color>,為目標施加<Color=#54c194>【能量免傷提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240039201_j=行動結束時,會治療生命最低的單位,治療量為梅林最大生命的<Color=#FFD06C>{0}%</Color>",
        "skilld_240039101_j=梅林召喚治癒法球,治療我方生命最低單位,治療量為梅林最大生命的<Color=#FFD06C>{0}%</Color>",
        "skilld_240041101_j=阿奴凱特召喚治癒水球,治療我方生命最低的2個單位,治療量為阿奴凱特最大生命的<Color=#FFD06C>{0}%</Color>,治療目標獲得<Color=#54c194>【防禦提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240041201_j=治療時，若目標生命低於<Color=#FFD06C>{0}%</Color>，則治療效果提高<Color=#FFD06C>{1}%</Color>",
        "skilld_240041001_j=阿奴凱特召喚治癒法陣,治療我方攻擊最高單位,治療量為自身最大生命的<Color=#FFD06C>{0}%</Color>,治療目標獲得<Color=#54c194>【攻擊提升{1}%】</Color>,持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240042001_j=妖師引導鯤鵬之力加護自身,自身獲得最大生命<Color=#FFD06C>{0}%</Color>的<Color=#54c194>【護盾】</Color>,持續<Color=#FFD06C>{1}</Color>回合",
        "skilld_240042101_j=妖師召喚鯤鵬虛影從空中下落猛擊,對敵方隨機3個單位造成攻擊<Color=#FFD06C>{0}%</Color>的物理傷害，並額外使自身與我方攻擊最高單位獲得鯤鵬最大生命<Color=#FFD06C>{1}%</Color>的<Color=#54c194>【護盾】</Color>，持續<Color=#FFD06C>{2}</Color>回合",
        "skilld_240042201_j=妖師鯤鵬在場時,我方受到持續傷害降低<Color=#FFD06C>{0}%</Color>",
        "skilld_240045101_j=蔡文姬輕輕躍起,撥動琴弦,生成恢復法陣,治療我方全體,治療量為蔡文姬最大生命的<Color=#FFD06C>{0}%</Color>",
        "skilld_240045201_j=回合開始時,蔡文姬分別有<Color=#FFD06C>{0}%</Color>概率為敵方全體施加<Color=#FF5F59>【燃燒】</Color>",
        "skilld_240045001_j=蔡文姬撥動琴弦,發出治癒音波,治療我方生命最低的2個單位,治療量為蔡文姬最大生命的<Color=#FFD06C>{0}%</Color>,敵方每存在1個<Color=#FF5F59>【燃燒】</Color>單位,本次治療係數提高<Color=#FFD06C>{1}%</Color>,最多生效<Color=#FFD06C>{2}</Color>個",
        "skilld_240047201_j=對<Color=#FF5F59>【裂痕】</Color>狀態下的敵人傷害提升<Color=#FFD06C>{0}%</Color>",
        "skilld_240047101_j=須佐之男揮刀快速斬擊,對敵方攻擊最高單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,若目標處於<Color=#FF5F59>【裂痕】</Color>狀態，則係數提升至<Color=#FFD06C>{1}%</Color>",
        "skilld_240047001_j=須佐之男召喚黑蝕旋風後貫射吞噬萬物的冥獄之箭,對敵方隨機3人造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,並<Color=#FFD06C>{1}%</Color>有概率為目標施加<Color=#FF5F59>【裂痕】</Color>",
        "skilld_240048001_j=鄧嬋玉拋出小機器人,使用巨化泰山壓頂,對敵方隨機單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,若擊退目標則再次釋放該技能（單回合只能連續釋放1次）",
        "skilld_240048101_j=鄧嬋玉駕駛機車進行風馳電掣的衝撞攻擊,對敵方隨機單位造成自身攻擊<Color=#FFD06C>{0}%</Color>的物理傷害,下次釋放的<Color=#FFD06C>「追光」</Color>技能傷害係數提升<Color=#FFD06C>{1}%</Color>",
