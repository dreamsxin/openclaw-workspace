        "tactics_add2_101=需求:全種類核心10級",
        "tactics_add2_102=需求:全種類核心20級",
        "tactics_add2_103=需求:全種類核心30級",
        "tactics_add2_104=需求:全種類核心40級",
        "tactics_add2_105=需求:全種類核心50級",
        "tactics_add2_106=需求:全種類核心60級",
        "tactics_add2_107=需求:全種類核心70級",
        "tactics_add2_108=需求:全種類核心80級",
        "tactics_add2_109=需求:全種類核心90級",
        "tactics_add2_110=需求:全種類核心100級",
