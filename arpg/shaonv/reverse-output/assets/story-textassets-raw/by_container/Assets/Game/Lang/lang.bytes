        "gal_title_head1=「觸摸·語音1」",
        "gal_title_head2=「觸摸·語音2」",
        "gal_title_head3=「觸摸·語音3」",
        "gal_title_chest1=「親密·語音1」",
        "gal_title_chest2=「親密·語音2」",
        "gal_title_chest3=「親密·語音3」",
        "gal_title_arm1=「互動·語音1」",
        "gal_title_arm2=「互動·語音2」",
        "gal_title_arm3=「互動·語音3」",
        "gal_title_leg1=「交流·語音1」",
        "gal_title_leg2=「交流·語音2」",
        "gal_title_leg3=「交流·語音3」",
        "gal_title_secret1=「私密·語音1」",
        "gal_title_secret2=「私密·語音2」",
        "gal_title_secret3=「私密·語音3」",
        "gal_title_greet=「日常問候」",
        "gal_title_wait1=「放置·語音1」",
        "gal_title_wait2=「放置·語音2」",
        "gal_title_wait3=「放置·語音3」",
        "gal_title_gift1=「贈送普通禮物」",
        "gal_title_gift2=「贈送喜好禮物」",
        "gal_hero_037_head1=你打算把我按到哪裡去？",
        "gal_hero_037_head2=別把我當小孩子",
        "gal_hero_037_head3=小孩子才不會在你揉腦袋的時候就心動。",
        "gal_hero_037_chest1=誒……別亂動……",
        "gal_hero_037_chest2=隔著衣服怎麼能夠數清楚我的心跳",
        "gal_hero_037_chest3=這次要不要看看內衣合不合身？",
        "gal_hero_037_arm1=這麼執著於我的手，是希望我主動攀住你的後頸嗎？",
        "gal_hero_037_arm2=這樣的小動作……不能夠對其他人做哦",
        "gal_hero_037_arm3=你好像對我的手，比對我更感興趣",
        "gal_hero_037_leg1=這裡有什麼東西嗎……",
        "gal_hero_037_leg2=你的手也太不安分了",
        "gal_hero_037_leg3=你把我的腿當作什麼玩具了嗎?",
        "gal_hero_037_secret1=喂喂喂，現在逃還來得及……",
        "gal_hero_037_secret2=剛才就發現你的眼神亂瞟...",
        "gal_hero_037_secret3=好摸嗎，上次留下的痕跡還沒消……",
        "gal_hero_037_greet=猜到你這個時候回來，所以一直在這裡等你",
        "gal_hero_037_wait1=一句話都不說，是想要玩木頭人的遊戲嗎",
        "gal_hero_037_wait2=回來了嗎？剛才沒講完的故事，可以繼續講嗎？",
        "gal_hero_037_wait3=什麼時候想聊天的話，慢慢和我說就好",
        "gal_hero_037_gift=倒是合乎眼緣呢",
        "gal_hero_037_gift_fav=誒，這可是個好東西呀～",
        "gal_hero_021_head1=我竟然有點想閉上眼睛睡一覺",
        "gal_hero_021_head2=這個距離還不準備做點什麼，真是太可惜了",
        "gal_hero_021_head3=上一個這麼肆無忌憚地摸我頭髮的人，就只有理髮師",
        "gal_hero_021_chest1=我都不知道你還會做出什麼舉動來。",
        "gal_hero_021_chest2=關於身材的分享就到此為止啦！",
        "gal_hero_021_chest3=好熱，幫我把衣服解開吧……",
        "gal_hero_021_arm1=來握著我的手吧，我給你取暖",
        "gal_hero_021_arm2=過來吧，大大方方地牽住",
        "gal_hero_021_arm3=聽說牽手能夠蹭到對方的好運",
        "gal_hero_021_leg1=剛才好像有只調皮的傢伙搗蛋",
        "gal_hero_021_leg2=摸一下就立馬撒手",
        "gal_hero_021_leg3=……嫌這裡不夠軟嗎？又不是棉花",
        "gal_hero_021_secret1=你這些手段我可都記下了",
        "gal_hero_021_secret2=一次兩次的我都懶得說你",
        "gal_hero_021_secret3=有本事就更深入一點，看我不打扁你！",
        "gal_hero_021_greet=今天的我也是元氣滿滿，必須做點什麼",
        "gal_hero_021_wait1=你上次自言自語的時候不小心說了一句心裡話",
        "gal_hero_021_wait2=心情怎麼樣？要不要和我分享一下今天的見聞？",
        "gal_hero_021_wait3=繼續待在這裡看看我也不是不行",
        "gal_hero_021_gift=啊？行吧，我挺喜歡的",
        "gal_hero_021_gift_fav=可以，可以，可以，太可以了！",
        "gal_hero_003_head1=下一個地方想摸哪裡，我提前和它打好招呼",
        "gal_hero_003_head2=有點忍不住想反過來捏捏你怎麼辦",
        "gal_hero_003_head3=應該不介意我檢查一下你的身體吧",
        "gal_hero_003_chest1=下手沒輕沒重的，萬一我真的生氣了",
        "gal_hero_003_chest2=好了，不可以再往裡面摸了",
        "gal_hero_003_chest3=要不要換一種消磨時光的方式",
        "gal_hero_003_arm1=別人是動口不動手，你這是既動口又動手",
        "gal_hero_003_arm2=是想要我主動走過來，牽起你的手嗎？",
        "gal_hero_003_arm3=現在不牽著你的手反而有些不習慣",
        "gal_hero_003_leg1=你在調皮搗蛋這件事上，總能夠給我玩出點新花樣。",
        "gal_hero_003_leg2=……還以為是有小蟲子爬過去，原來是你不聽話的手指……",
        "gal_hero_003_leg3=手一閑下來就開始搞小動作……難道你又想到了什麼鬼點子？",
        "gal_hero_003_secret1=你還挺會抓重點的……",
        "gal_hero_003_secret2=在考驗我的忍耐力？",
        "gal_hero_003_secret3=這種事情是不是應該換一個地方做……",
        "gal_hero_003_greet=正好我也忙得差不多了，可以聽聽你今天有什麼打算",
        "gal_hero_003_wait1=這麼久一直不說話，是在做什麼忍耐力挑戰嗎？",
        "gal_hero_003_wait2=又在悄悄醞釀什麼惡作劇嗎，可不要嚇到我",
        "gal_hero_003_wait3=你是進入深度思考模式，還是單純地睡著了？",
        "gal_hero_003_gift=這東西，不算討厭",
        "gal_hero_003_gift_fav=這也算是物盡其用",
        "gal_hero_052_head1=三秒鐘夠嗎？……呵，等會兒可別求著我延長時間",
        "gal_hero_052_head2=摸夠了？……接下來是哪，起碼要讓我有點準備吧",
        "gal_hero_052_head3=你這種行動會打亂我的節奏……你的手太會挑地方了，讓我沒法思考。",
        "gal_hero_052_chest1=你的手抖得這麼厲害",
        "gal_hero_052_chest2=既然敢碰，就應該做好無法全身而退的準備",
        "gal_hero_052_chest3=心跳加速？不如你親自確認一下",
        "gal_hero_052_arm1=牽手可以，但是等會兒可別求著我放開",
        "gal_hero_052_arm2=看了這麼久……是在想你綁住它的時候會是什麼場面嗎",
        "gal_hero_052_arm3=十指相扣？不如試試看，它會出現在哪裡",
        "gal_hero_052_leg1=肌肉緊繃？你自己往上摸摸看，還不是因為你有點太激進了！",
        "gal_hero_052_leg2=你是在檢查什麼？不如我直接躺下，讓你全方位地檢查一下。",
        "gal_hero_052_leg3=……這是你説明自己冷靜的方式嗎，但我覺得你的手一點都不冷靜。",
        "gal_hero_052_secret1=你的手都已經闖入禁區了",
        "gal_hero_052_secret2=計畫好的還是。突然來了興致？",
        "gal_hero_052_secret3=讓你放肆了這麼久，是不是應該輪到我了",
        "gal_hero_052_greet=突然跑來找我，不會只為了看一眼吧",
        "gal_hero_052_wait1=我今天一整天都屬於你",
        "gal_hero_052_wait2=眼神在我身上遊移，手指也在蠢蠢欲動，是在等我主動嗎？",
        "gal_hero_052_wait3=休息還是思考，還是說在醞釀什麼更過分的事情",
        "gal_hero_052_gift=通通——拿走~",
        "gal_hero_052_gift_fav=哇…真的是給我的嗎？",
        "gal_hero_051_head1=這個力道好舒服，我被摸得都有一些困了，要不要睡一會兒呢？",
        "gal_hero_051_head2=等一下，整個頭都要摸，不能只摸一邊，兩邊都要！",
        "gal_hero_051_head3=這一次戳我頭的藉口是什麼，像你這麼明目張膽的人可不多",
        "gal_hero_051_chest1=等一下，這裡不行……",
        "gal_hero_051_chest2=再這麼摸下去，感覺似乎不太妙",
        "gal_hero_051_chest3=喂……快看看你的手放在哪裡了",
        "gal_hero_051_arm1=我都說了，手裡什麼都沒有",
        "gal_hero_051_arm2=怎麼？是想和我拉鉤嗎",
        "gal_hero_051_arm3=想約定什麼？太奇怪的可不行。",
        "gal_hero_051_leg1=你再摸我也不會長出尾巴的",
        "gal_hero_051_leg2=你這個一肚子壞水嘩啦啦響的傢伙",
        "gal_hero_051_leg3=……想不到你還有這種嗜好，你不會還摸別人吧？",
        "gal_hero_051_secret1=不要玩得太過火啦……現在這個時候不太合適……",
        "gal_hero_051_secret2=這樣吧，你要是想摸，就給一包糖果，先付後用，概不賒帳",
        "gal_hero_051_secret3=你別告訴我這不是你的錯，明明是你的手自己在動",
        "gal_hero_051_greet=我今天沒什麼安排，接下來的時間就由你來安排吧",
        "gal_hero_051_wait1=再讓你休息一會兒，待會你就沒時間偷懶了",
        "gal_hero_051_wait2=你什麼時候想說話了，我隨時都在，只要別走遠就行",
        "gal_hero_051_wait3=不需要講話，我們就這樣安安靜靜地待一會兒吧，之前太鬧騰了",
        "gal_hero_051_gift=好有意思的禮物",
        "gal_hero_051_gift_fav=嗚~這個東西我好喜歡~",
        "gal_hero_050_head1=摸得這麼熟練，看來不是第一次了吧？",
        "gal_hero_050_head2=是想讓我主動靠近還是等著我咬你一口",
        "gal_hero_050_head3=腦袋裡又在想什麼壞事？……沒關係，反正我也沒打算攔你",
        "gal_hero_050_chest1=平常笨手笨腳的，怎麼在解扣子這件事上那麼利索了？",
        "gal_hero_050_chest2=人在緊張時心跳總是會快一些",
        "gal_hero_050_chest3=再摸下去，可就得找個休息室了……",
        "gal_hero_050_arm1=手這麼不安分，是希望我用別的方式固定住你嗎？",
        "gal_hero_050_arm2=盯著我的手看了半天，還沒有決定要不要牽起來嗎？",
        "gal_hero_050_arm3=這雙手是應該出現在你身上的哪個地方嗎？",
        "gal_hero_050_leg1=手指再往上移動一下，我就知道你是不是故意的了",
        "gal_hero_050_leg2=嘴上說著不敢，但是手指還是很誠實嘛",
        "gal_hero_050_leg3=想檢查絲襪還是想看腿，不如直接幫我脫掉，能夠看得更仔細",
        "gal_hero_050_secret1=這麼緊張？……都還沒開始呢，難道你這個人喜歡被動？",
        "gal_hero_050_secret2=那麼現在是打算循序漸進，還是打算直搗黃龍呢？",
        "gal_hero_050_secret3=反正只要你足夠厲害，我就不會有任何意見……",
        "gal_hero_050_greet=就算我再怎麼忙，見你的時間總是不會少的，這是最重要的事項",
        "gal_hero_050_wait1=靠這麼近，卻只是看著嗎？……真讓人著急",
        "gal_hero_050_wait2=走神了？還是在想，什麼時候動手？我已經做好準備了哦",
        "gal_hero_050_wait3=不如來玩點更刺激的遊戲，最好是只有我們兩個人的遊戲",
        "gal_hero_050_gift=那我就不客氣地收下了",
        "gal_hero_050_gift_fav=送給我？我很喜歡，讓你破費了",
        "gal_hero_053_head1=你這是在做提前演練嗎",
        "gal_hero_053_head2=我想你應該更想試試其他地方的觸感。",
        "gal_hero_053_head3=一直戳這裡……是想要看我咬嘴唇的樣子",
        "gal_hero_053_chest1=心跳聲這麼大……要不要我把衣服拉開點",
        "gal_hero_053_chest2=相比於揍你，我更想用其他地方夾住你這雙不安分的手。",
        "gal_hero_053_chest3=這麼迷戀的話，不如把我關起來",
        "gal_hero_053_arm1=牽得這麼緊，是想要把我綁在床上?",
        "gal_hero_053_arm2=抓得這麼緊是在暗示我，你已經做好準備了嗎",
        "gal_hero_053_arm3=手這麼涼，不如塞進我的衣服裡取暖",
        "gal_hero_053_leg1=揉腿的話要再往上三寸",
        "gal_hero_053_leg2=要不要試試這個玩具能夠玩出多少種姿勢",
        "gal_hero_053_leg3=按摩的話應該按對位置，你現在明顯按偏了",
        "gal_hero_053_secret1=等等！直接就開始實踐教學嗎?",
        "gal_hero_053_secret2=是你想像中的感覺嗎？",
        "gal_hero_053_secret3=還不挪開嗎，看來是等著我用腿夾住你",
        "gal_hero_053_greet=今天也要全力發光！",
        "gal_hero_053_wait1=數時間嗎？不如數數，你能堅持幾分鐘不把我推倒在沙發上。",
        "gal_hero_053_wait2=要玩什麼嗎？輸的人要無條件服從哦",
        "gal_hero_053_wait3=正好，今天的時間還很多，我們可以補課到天亮",
        "gal_hero_053_gift=這麼珍貴的禮物，難得",
        "gal_hero_053_gift_fav=我還只是學生，太貴重了",
        "gal_map_text_203100001=華燈初上，商業街的人流裹挾著週末特有的歡快氣息。你們並肩走在流光溢彩的霓虹燈下，剛剛結束晚餐，夜晚的時光正等待著被賦予新的意義。",
        "gal_map_text_203100002=卡洛菲斯指尖漫不經心地劃過路邊櫥窗的玻璃，指甲上的金屬色美甲在燈光下閃著細碎的光。",
        "gal_map_text_203100003=她側過頭看你，唇角勾起一抹帶點挑釁的笑，語氣火辣卻藏著期待：'晚餐你選的餐廳還算合我胃口，接下來的場子可別掉鏈子。我這人怕無聊，沒意思的地方我可不會多待。'",
        "gal_map_text_203100004=能讓卡洛菲斯滿意，看來我晚餐的眼光沒出錯。其實我早就琢磨著幾個地方，都挺對我印象裡你的喜好，就等你點頭。'",
        "gal_map_text_203100005=哦？這麼有信心？說說看，要是敢推薦那種俗套網紅店，我可真要轉身走了。'",
        "gal_map_text_203100006=卡洛菲斯挑眉看著你，雙手抱在胸前，姿態帶著點審視，卻難掩眼底的好奇。",
        "gal_map_text_203100007=你看著卡洛菲斯火辣直接的模樣，知道不能用敷衍的選擇應付。既要貼合她 '不無聊' 的要求，又要體現你的用心，讓這場約會從一開始就抓住她的注意力。",
        "gal_map_text_203100008=高空觀景台咖啡館",
        "gal_map_text_203100009=塔羅占卜小屋",
        "gal_map_text_203100010=迷你 Livehouse",
        "gal_map_text_203100011=雲境觀景台的特調 + 全城夜景，夠特別嗎？'",
        "gal_map_text_203100012=卡洛菲斯拍了下你的胳膊，眼神銳利。",
        "gal_map_text_203100013=有點意思，我倒要看看夜景配特調能不能驚豔我。'",
        "gal_map_text_203100014=觀景台？比逛馬路強。帶路吧，要是景色配不上名氣，我可會直接吐槽。'",
        "gal_map_text_203100015=俯瞰全城？聽起來好浪漫，你怎麼知道我喜歡這種視野好的地方？'",
        "gal_map_text_203100016=只要是你選的，應該不會差吧？我相信你，我們趕緊走吧。'",
        "gal_map_text_203100017=星語塔羅館，小眾卻准，敢挑戰嗎？'",
        "gal_map_text_203100018=神秘學？我對邏輯之外的東西挺好奇，正好驗證下準確率。'",
        "gal_map_text_203100019=塔羅的象徵體系其實有規律可循，去看看他們怎麼解讀也不錯。'",
        "gal_map_text_203100020=哇！我一直想試塔羅卻沒機會，會不會算出什麼驚喜？有點緊張！'",
        "gal_map_text_203100021=占卜耶！會不會能看出我們的緣分？想想就好期待，快帶路！'",
        "gal_map_text_203100022=鼓動心弦 Livehouse，原創音樂夠勁？'",
        "gal_map_text_203100023=原創音樂？正合我意！現場氛圍夠燃就行，走！'",
        "gal_map_text_203100024=終於有個不無聊的選擇！希望歌手唱功別拉胯，不然我可要離場。'",
        "gal_map_text_203100025=Livehouse？人不多的話可以去，我怕吵。'",
        "gal_map_text_203100026=也行，總比站在街邊吹風強，先看看再說。'",
        "gal_map_text_203100027=放心，我特意查過，他們的特調是主廚手工調製，名字和口感都很特別，夜景更是沒話說，絕對配得上你。'",
        "gal_map_text_203100028=算你用心。' 她嘴角揚起笑意，率先邁步：'走，別讓我等太久，我已經想嘗嘗那所謂的特別特調了。'",
        "gal_map_text_203100029=我打聽了，這家不是網紅店，老闆很懂塔羅，而且環境很安靜，不會有人打擾。你要是不想說自己的問題，純屬體驗也可以。'",
        "gal_map_text_203100030=考慮得還挺周到。' 她收起審視的姿態，往前走了兩步：'那趕緊去，我倒要看看這小眾塔羅館有沒有真本事。'",
        "gal_map_text_203100031=放心，這家是小眾場地，人不會擠，歌手都是原創音樂人，風格很多樣，不會有吵鬧的蹦迪環節，氛圍剛好。'",
        "gal_map_text_203100032=還算你懂我。' 她甩了甩頭髮，語氣輕快：'走，去聽聽看，要是歌好聽，我不介意多待一會兒。'",
        "gal_map_text_203100033=你們並肩朝著選定的方向走去，路燈將兩人的影子拉得很長。卡洛菲斯偶爾會點評路邊的店鋪，言語直接卻不失趣味，偶爾又會好奇地問你關於目的地的細節，火辣的性子中藏著不輕易示人的期待。",
        "gal_map_text_203100034=這場約會的開端，就在她的直接與你的體貼中，悄然拉開了序幕。",
        "gal_map_text_203100035=沿著商業街的霓虹一路前行，喧囂漸漸被專屬目的地的氛圍取代。",
        "gal_map_text_203100036=當目的地的大門在眼前打開，一個與外界截然不同的世界鋪展開來，而一場突如其來的小意外，正悄悄拉近你們的距離。",
        "gal_map_text_203100037=電梯飛速上升，輕微的失重感後，門開了。你們仿佛一步踏入了星空。",
        "gal_map_text_203100038=咖啡館內以深空藍為主色調，點綴著細碎的暖光，落地窗外是連綿的城市燈火，如同打翻的星河，舒緩的爵士樂在空氣中流淌，氛圍感十足。",
        "gal_map_text_203100039=服務員引導你們走向靠窗的絕佳位置，腳下的地毯柔軟厚實，卻沒注意到邊角有些翹起。",
        "gal_map_text_203100040=就在卡洛菲斯邁步時，鞋跟不小心勾到地毯，身體瞬間失去平衡，朝著旁邊的餐桌倒去，而桌上正擺放著其他客人未取的飲品。",
        "gal_map_text_203100041=你看這個位置，視野剛好，能看到…… 小心！' 你話音未落就發現了危險，立刻繃緊神經。",
        "gal_map_text_203100042=哎呀！' 她驚呼一聲，身體不受控制地前傾，下意識地伸手想扶住什麼。",
        "gal_map_text_203100043=千鈞一髮之際，你必須立刻行動。既要穩穩護住卡洛菲斯，避免她摔倒或被飲品濺到，又要照顧到現場的情況，不能讓場面變得尷尬，這正是體現你高情商和體貼的時刻。",
        "gal_map_text_203100044=護住卡洛菲斯",
        "gal_map_text_203100045=身體擋住飲品",
        "gal_map_text_203100046=墊身擋桌緩衝擊",
        "gal_map_text_203100047=別動，我扶你！'",
        "gal_map_text_203100048=卡洛菲斯站穩後立刻直起身，拍了拍衣服，卻忍不住笑，",
        "gal_map_text_203100049=可以啊，反應夠快，沒讓我出醜。' 指尖不經意間觸碰到你扶過的腰側，臉頰微紅。",
        "gal_map_text_203100050=卡洛菲斯語氣依舊強勢，卻主動幫你整理了一下被碰歪的袖口。",
        "gal_map_text_203100051=謝了，幸好你反應快。不然我今天可就丟臉了。'",
        "gal_map_text_203100052=卡洛菲斯緊緊抓著你的胳膊，眼神裡滿是後怕，身體還微微發顫。",
        "gal_map_text_203100053=嚇死我了！剛才差點就摔了，還好有你扶住我。'",
        "gal_map_text_203100054=卡洛菲斯靠得你更近了些，聲音帶著點鼻音。",
        "gal_map_text_203100055=你好厲害！要是沒有你，我肯定會摔得很難看，還會被飲料潑到。'",
        "gal_map_text_203100056=往我這邊來！",
        "gal_map_text_203100057=卡洛菲斯點點頭，語氣帶著贊許，卻悄悄揉了揉被你拉住的胳膊。",
        "gal_map_text_203100058=不錯，判斷力可以，精准避開了桌子和飲品，沒造成麻煩。'",
        "gal_map_text_203100059=卡洛菲斯客觀評價著，眼神卻不自覺地停在你牽著卡洛菲斯的手上。",
        "gal_map_text_203100060=你的反應邏輯很清晰，先拉人再避障礙，比慌手慌腳強多了。'",
        "gal_map_text_203100061=卡洛菲斯捂著胸口，臉頰泛紅，眼神躲閃卻帶著笑意。",
        "gal_map_text_203100062=剛才好險！你拉我的時候好有安全感，我現在心跳還很快。'",
        "gal_map_text_203100063=卡洛菲斯眼眶微紅，看向你的眼神滿是依賴。",
        "gal_map_text_203100064=嗚嗚，剛才差點就哭了，幸好你及時拉住我。你對我真好。'",
        "gal_map_text_203100065=小心桌子！'",
        "gal_map_text_203100066=卡洛菲斯拍了拍你的肩膀，語氣雀躍，眼神裡滿是欣賞。",
        "gal_map_text_203100067=可以啊你！居然用自己擋著，夠 man！'",
        "gal_map_text_203100068=卡洛菲斯興奮地說著，主動湊近查看你有沒有撞到",
        "gal_map_text_203100069=哇！你也太拼了吧！不過真的好帥！幸好我沒事，不然都對不起你。",
        "gal_map_text_203100070=卡洛菲斯語氣平淡，卻還是伸手幫你拂去了肩上的灰塵。",
        "gal_map_text_203100071=謝謝。下次不用這麼冒險，我自己能穩住。'",
        "gal_map_text_203100072=卡洛菲斯轉身走向座位，卻在轉身時悄悄放慢了腳步，等你跟上。",
        "gal_map_text_203100073=嗯，還好沒摔。走吧，趕緊入座，別讓別人看笑話。'",
        "gal_map_text_203100074=沒事吧？有沒有哪裡撞到？都怪我沒提前注意地毯。' 你扶著她的胳膊，眼神滿是關切，順手將旁邊的椅子拉過來讓她坐下。",
        "gal_map_text_203100075=我沒事，是我自己沒看路。'",
        "gal_map_text_203100076=她坐下後，指尖還是忍不住摩挲著腰側",
        "gal_map_text_203100077=不過你剛才扶我的時候，還挺穩的。'",
        "gal_map_text_203100078=她抬眼看向你，眼神裡少了幾分火辣，多了幾分柔和。",
        "gal_map_text_203100079=還好拉住你了，要是真撞到桌子或者被飲品濺到，多影響心情。' 你鬆開她的胳膊，卻還是保持著護在她身側的姿態。",
        "gal_map_text_203100080=確實，要是真出了岔子，今天這約會可就毀了。'",
        "gal_map_text_203100081=她喝了口水平復心情",
        "gal_map_text_203100082=說起來，你剛才反應真快，是不是早就注意到地毯有問題了？'",
        "gal_map_text_203100083=她好奇地看著你，眼底帶著讚賞。",
        "gal_map_text_203100084=沒事就好，我皮糙肉厚的，撞一下沒關係。倒是你，以後走路可得小心點。' 你揉了揉被撞到的胳膊，語氣輕鬆。",
        "gal_map_text_203100085=誰要你逞能了。'",
        "gal_map_text_203100086=她嗔怪地看了你一眼，卻還是伸手想碰你的胳膊",
        "gal_map_text_203100087=真的沒事嗎？要不要看看有沒有淤青？'",
        "gal_map_text_203100088=語氣裡帶著不自覺的關心。",
        "gal_map_text_203100089=服務員很快過來道歉，並表示會立刻處理地毯問題，店長還特意贈送了兩份招牌小點心作為補償。",
        "gal_map_text_203100090=卡洛菲斯拿起一塊馬卡龍放進嘴裡，眼神柔和了許多：'算他們有誠意，不過主要還是你剛才反應快。'她看向窗外的燈火，又轉頭看向你，嘴角帶著淺淺的笑意，兩人之間的氛圍因為剛才的小意外，悄然升溫。",
        "gal_map_text_203100091=跟隨手機地圖的指引，你們在商業街一條僻靜的岔道盡頭，找到了那家名為「星語」的小店。",
        "gal_map_text_203100092=木質門扉上掛著復古銅鈴，推門時發出清脆的聲響。店內彌漫著淡淡的檀香，牆面掛滿了星座掛毯，暖黃色的燈光透過磨砂玻璃灑下，營造出神秘而舒適的氛圍。",
        "gal_map_text_203100093=一位穿著波西米亞長裙、氣質沉靜的女占卜師從帷幔後悄然現身，她似乎並不意外，只是對你們露出一個神秘的微笑。",
        "gal_map_text_203100094=占卜師示意你們坐在鋪著絲絨桌布的圓桌旁，轉身去取塔羅牌時，放在桌邊的水晶陣突然傾倒，其中一顆較大的粉晶朝著卡洛菲斯的方向滾來。",
        "gal_map_text_203100095=她正低頭打量桌下的地毯花紋，完全沒注意到。更巧的是，她放在桌邊的手機也因為水晶陣的晃動，朝著桌邊滑去，眼看就要摔落在地",
        "gal_map_text_203100096=這裡的氛圍真不錯，檀香的味道很讓人放鬆。你平時對塔羅…… 小心！' 你話沒說完，就看到了即將滾落的粉晶和手機。",
        "gal_map_text_203100097=嗯，這裡比我想像中…… 啊？怎麼了？'",
        "gal_map_text_203100098=卡洛菲斯抬頭看向你，眼神帶著疑惑，還沒反應過來危險。",
        "gal_map_text_203100099=你看著即將發生的意外，必須立刻行動。既要護住她不被粉晶碰到，又要接住即將掉落的手機，兩個目標都不能耽誤，還要做得自然不突兀，讓她感受到你的細心和穩妥。",
        "gal_map_text_203100100=接住手機擋住水晶",
        "gal_map_text_203100101=護膝接水晶扶手機",
        "gal_map_text_203100102=挪位擋水晶拾手機",
        "gal_map_text_203100103=手機要掉，小心水晶！'",
        "gal_map_text_203100104=卡洛菲斯反應過來後立刻穩住身體，看著你手裡的手機和粉晶，挑眉道。",
        "gal_map_text_203100105=可以啊，雙手操作夠利索，沒讓我的手機遭殃。'",
        "gal_map_text_203100106=謝了，這手機剛買沒多久，摔了可就麻煩了。你反應挺快，沒掉鏈子。'",
        "gal_map_text_203100107=哇！好險啊！剛才差點就摔了手機，還差點被水晶碰到。你也太厲害了吧！'",
        "gal_map_text_203100108=嚇死我了！幸好有你在，不然我的手機肯定要摔壞了。你怎麼這麼及時啊？'",
        "gal_map_text_203100109=低頭，我來接！'",
        "gal_map_text_203100110=卡洛菲斯看著你將水晶放回原位，語氣帶著贊許。",
        "gal_map_text_203100111=你這應對挺科學，先護人再護物，邏輯很清晰。'",
        "gal_map_text_203100112=預判很准，動作也連貫，既沒讓水晶碰到我，也沒讓手機摔了，效率很高。'",
        "gal_map_text_203100113=卡洛菲斯捂著胸口，臉頰泛紅。",
        "gal_map_text_203100114=剛才你蹲下來護著我的時候，好有安全感啊。我的心跳都快了好多。'",
        "gal_map_text_203100115=卡洛菲斯向你的眼神滿是柔軟。",
        "gal_map_text_203100116=剛才真的嚇到我了。你這麼保護我，我真的好感動。'",
        "gal_map_text_203100117=往我這邊靠！'",
        "gal_map_text_203100118=可以啊你！居然直接挪過來擋住，夠果斷！我喜歡這種不拖泥帶水的風格。'",
        "gal_map_text_203100119=哇！你也太帥了吧！剛才那個動作簡直像電影裡的場景，太酷了！'",
        "gal_map_text_203100120=卡洛菲斯語氣平淡，卻悄悄將手機往你那邊挪了挪。",
        "gal_map_text_203100121=謝謝。幸好沒碰到，手機也沒事，繼續占卜吧。'",
        "gal_map_text_203100122=卡洛菲斯轉頭看向占卜師，卻在轉身時輕輕碰了下你的胳膊。",
        "gal_map_text_203100123=嗯，沒出問題就好。趕緊開始吧，我還想看看占卜結果呢。'",
        "gal_map_text_203100124=還好接住了，你這手機要是摔了，今天的約會可就留下遺憾了。' 你將手機遞給卡洛菲斯，又把粉晶放回水晶陣。",
        "gal_map_text_203100125=以後手機可別放在桌邊邊緣了，太危險。'",
        "gal_map_text_203100126=知道了知道了，囉嗦。'",
        "gal_map_text_203100127=卡洛菲斯接過手機，卻忍不住笑著說，",
        "gal_map_text_203100128=不過還是要謝謝你，剛才反應真的太快了，我都沒反應過來。'",
        "gal_map_text_203100129=卡洛菲斯指尖劃過手機螢幕，眼神裡帶著笑意。",
        "gal_map_text_203100130=沒事吧？有沒有碰到腿？這水晶雖然不大，但滾過來還是有點力道的。' 你站起身，關切地看著卡洛菲斯的膝蓋。",
        "gal_map_text_203100131=我沒事，你護得很到位。'",
        "gal_map_text_203100132=卡洛菲斯搖搖頭，看著你整理好的水晶陣。",
        "gal_map_text_203100133=沒想到你還挺細心，還知道把水晶放回原位。'",
        "gal_map_text_203100134=卡洛菲斯的語氣柔和了許多，眼神裡帶著欣賞。",
        "gal_map_text_203100135=還好沒出事，剛才真是太巧了，水晶和手機居然一起出狀況。' 你擦了擦手機上的灰塵，遞給卡洛菲斯。",
        "gal_map_text_203100136=確實挺巧的，幸好有你。'",
        "gal_map_text_203100137=卡洛菲斯接過手機，小聲說。",
        "gal_map_text_203100138=剛才你擋在我前面的時候，還挺有安全感的。'",
        "gal_map_text_203100139=說完卡洛菲斯就轉頭看向占卜師，臉頰微微泛紅。",
        "gal_map_text_203100140=占卜師笑著道謝，重新擺放好水晶陣，說道：'兩位的默契和緣分真是天生的，剛進來就化解了一場小意外。看來今天的占卜結果一定會很順利。'",
        "gal_map_text_203100141=卡洛菲斯聽著占卜師的話，臉頰微紅，偷偷瞥了你一眼，指尖無意識地摩挲著手機殼。",
        "gal_map_text_203100142=空氣中的檀香似乎變得更加柔和，兩人之間的氛圍也因為這場意外的互助，多了幾分曖昧。",
        "gal_map_text_203100143=推開厚重的隔音門，「鼓動心弦」裡的世界及閘外截然不同。燈光被壓得很低，只留舞臺中央一束暖光和每張桌上小小的蠟燭。",
        "gal_map_text_203100144=空氣裡混合著舊木料、啤酒花和一絲電子設備發熱的味道。",
        "gal_map_text_203100145=一個戴著鴨舌帽的歌手正抱著一把木吉他，唱著一首旋律輕快帶著點布魯斯味道的原創歌曲，嗓音沙啞而有磁性，台下的觀眾們或輕聲跟唱，或隨著節奏輕輕點頭，氛圍鬆弛又愜意。",
        "gal_map_text_203100146=你們在角落的雙人桌坐下，桌上的小蠟燭跳動著暖黃的光，將兩人的影子拉得有些模糊。",
        "gal_map_text_203100147=服務員拿著手寫功能表過來點單，剛要遞到你們面前，身後突然有醉醺醺的客人撞了他一下，服務員手中的功能表和筆瞬間脫手，朝著卡洛菲斯的方向掉下來，而她正低頭看著桌下的復古音箱，完全沒注意到頭頂的情況。",
        "gal_map_text_203100148=更巧的是，桌上的蠟燭因為碰撞產生的氣流，火苗猛地竄起，差點燒到她垂在桌邊的長髮。",
        "gal_map_text_203100149=這個位置不錯，既能看清舞臺，又不會太吵。你想喝點什麼？我看他們家的精釀評價…… 小心！' 你餘光瞥見掉落的菜單和晃動的蠟燭，立刻警覺起來。",
        "gal_map_text_203100150=精釀嗎？我想試試果香的…… 啊？怎麼了？'",
        "gal_map_text_203100151=卡洛菲斯抬頭看向你，眼神帶著疑惑，長髮還垂在蠟燭上方不遠的地方。",
        "gal_map_text_203100152=危急時刻，你必須兼顧兩件事 —— 既要擋住掉落的菜單避免砸到卡洛菲斯，又要護住卡洛菲斯的頭髮不被火苗燎到。動作既要迅速果斷，又要溫柔穩妥，不能讓卡洛菲斯受到絲毫驚嚇，這正是展現你高情商和保護欲的關鍵。",
        "gal_map_text_203100153=護髮擋單穩燭火",
        "gal_map_text_203100154=扶肩躲單吹燭焰",
        "gal_map_text_203100155=接單擋頭護周全",
        "gal_map_text_203100156=低頭！小心頭髮和菜單！'",
        "gal_map_text_203100157=卡洛菲斯反應過來後立刻攏了攏頭髮，看著你手裡的菜單和穩好的蠟燭。",
        "gal_map_text_203100158=可以啊，手腳夠麻利，沒讓我變成‘焦發公主’。'",
        "gal_map_text_203100159=指尖輕輕碰了碰被你護住的發梢，嘴角帶著笑意。",
        "gal_map_text_203100160=謝了，幸好你反應快。不然我這頭髮和衣服，今天可就遭殃了。'",
        "gal_map_text_203100161=卡洛菲斯語氣依舊乾脆，卻主動拿起桌上的紙巾，幫你擦了擦接菜單時沾上的墨漬。",
        "gal_map_text_203100162=哇！好險啊！剛才差點就燒到頭髮了，還差點被菜單砸到。你也太厲害了吧！'",
        "gal_map_text_203100163=卡洛菲斯緊緊抓著你的胳膊，眼神裡滿是後怕，身體微微靠近你。",
        "gal_map_text_203100164=嚇死我了！幸好有你在，不然我肯定要慌了。你怎麼能同時顧到這麼多事啊？'",
        "gal_map_text_203100165=卡洛菲斯往你身邊縮了縮，聲音帶著點委屈的顫音。",
        "gal_map_text_203100166=往我這邊靠，小心蠟燭！'",
        "gal_map_text_203100167=卡洛菲斯攏了攏頭髮，語氣帶著贊許，眼神卻不自覺地停在你扶著卡洛菲斯肩膀的手上。",
        "gal_map_text_203100168=你這應對很周全，先躲危險再處理隱患，邏輯很清晰。'",
        "gal_map_text_203100169=卡洛菲斯客觀評價著，卻悄悄將椅子往你這邊挪了挪，縮短了兩人的距離。",
        "gal_map_text_203100170=預判準確，動作連貫，既避開了菜單，又吹滅了危險的燭火，效率很高。'",
        "gal_map_text_203100171=卡洛菲斯捂著胸口，臉頰泛紅，眼神躲閃卻藏不住笑意。",
        "gal_map_text_203100172=剛才你扶著我的時候，我心跳都快了好多。那種被保護的感覺，真的好安心。'",
        "gal_map_text_203100173=卡洛菲斯手指輕輕勾了勾你的袖口。",
        "gal_map_text_203100174=剛才真的嚇到我了。你這麼注意我，我真的好感動。'",
        "gal_map_text_203100175=小心上方！我來接！'",
        "gal_map_text_203100176=卡洛菲斯拍了拍你的肩膀，語氣雀躍，眼神裡滿是欣賞。",
        "gal_map_text_203100177=可以啊你！居然直接接住菜單還護住我，夠 man！我就喜歡這種果斷的！'",
        "gal_map_text_203100178=卡洛菲斯興奮地說著，主動湊近查看你有沒有被墨漬弄髒。",
        "gal_map_text_203100179=哇！你也太帥了吧！剛才那個動作簡直帥炸了！幸好有你，不然我可就慘了。'",
        "gal_map_text_203100180=語氣平淡，卻還是伸手幫你拂去了肩上的灰塵，指尖不經意間觸碰到你的皮膚。",
        "gal_map_text_203100181=謝謝。下次不用這麼急，我自己能躲開。'",
        "gal_map_text_203100182=卡洛菲斯轉頭看向舞臺，卻在轉身時悄悄放慢了腳步，等你一起點單。",
        "gal_map_text_203100183=嗯，沒出事就好。趕緊點單吧，別影響聽歌。'",
        "gal_map_text_203100184=沒事吧？有沒有燙到頭髮？都怪我沒注意周圍的情況。' 你放下功能表，仔細檢查了一下卡洛菲斯的發梢，又將蠟燭往桌子中間挪了挪。",
        "gal_map_text_203100185=我沒事，是我自己沒注意。' 卡洛菲斯攏了攏頭髮，'",
        "gal_map_text_203100186=不過你剛才反應真快，又護著我的頭髮，又接住了菜單，還穩住了蠟燭，你怎麼做到的？'",
        "gal_map_text_203100187=卡洛菲斯抬眼看向你，眼神裡少了幾分火辣，多了幾分好奇和欣賞。",
        "gal_map_text_203100188=還好躲開了，剛才真是太危險了，差一點就燒到你的頭髮了。' 你鬆開卡洛菲斯的肩膀，卻還是保持著護在卡洛菲斯身側的姿態。",
        "gal_map_text_203100189=以後離蠟燭遠點，安全第一。'",
        "gal_map_text_203100190=確實挺危險的，幸好有你。'",
        "gal_map_text_203100191=卡洛菲斯喝了口水平復心情",
        "gal_map_text_203100192=說起來，你剛才吹蠟燭的樣子還挺認真的，好像在做什麼重要的事一樣。'",
        "gal_map_text_203100193=卡洛菲斯嘴角帶著淺淺的笑意，眼神柔和了許多。",
        "gal_map_text_203100194=沒事就好，這菜單砸下來雖然不重，但砸到頭上也挺疼的。' 你把功能表遞給服務員。",
        "gal_map_text_203100195=而且你的頭髮那麼好看，要是被燒到就太可惜了。'",
        "gal_map_text_203100196=誰要你多管閒事了。'",
        "gal_map_text_203100197=卡洛菲斯嗔怪地看了你一眼，卻忍不住笑了。",
        "gal_map_text_203100198=不過還是要謝謝你，剛才確實挺危險的。你這麼護著我，還挺讓人安心的。'",
        "gal_map_text_203100199=卡洛菲斯的聲音比剛才柔和了許多，臉頰微微泛紅。",
        "gal_map_text_203100200=服務員連連道歉，不僅幫你們重新點了單，還特意贈送了一份招牌小吃作為補償。",
        "gal_map_text_203100201=歌手剛好唱完一首歌曲，台下響起熱烈的掌聲，他笑著說了聲 '謝謝'，然後開始唱下一首舒緩的民謠。",
        "gal_map_text_203100202=卡洛菲斯拿起一塊小吃放進嘴裡，眼神柔和地看著舞臺，又悄悄瞥了你一眼：'算他們有誠意，不過主要還是你剛才反應快。'",
        "gal_map_text_203100203=暖黃的燭光映在卡洛菲斯的臉上，讓卡洛菲斯的輪廓顯得格外柔和，兩人之間的氛圍因為這場意外的互助，悄然變得曖昧起來。",
        "gal_map_text_203100204=小意外過後，約會的氛圍愈發鬆弛愜意。專屬目的地的獨特魅力漸漸展露，而你們之間的互動也從最初的試探，變得更加自然親密。",
        "gal_map_text_203100205=每一個眼神交匯，每一次不經意的觸碰，都在悄悄拉近距離，讓曖昧的情愫在空氣中慢慢發酵。",
        "gal_map_text_203100206=你們點了兩杯名字最飄渺的特調 —— 一杯叫 '夜航星'，深藍漸變綴以銀粉，入口是清爽的薄荷味，後調帶著淡淡的柑橘香；一杯叫 '暮雲吻'，暖橙交織著奶白，口感綿密，混合著焦糖和玫瑰的香氣。",
        "gal_map_text_203100207=兩杯飲品放在桌上，在燈光下折射出夢幻的光澤，與窗外的城市夜景相得益彰",
        "gal_map_text_203100208=服務員將特調端上桌，貼心地附上小勺子和紙巾。卡洛菲斯拿起 '夜航星'，對著燈光仔細打量，銀粉在液體中緩緩流動，像極了夜空中的星辰。",
        "gal_map_text_203100209=卡洛菲斯好奇地抿了一口，眼睛瞬間亮了起來，轉頭看向你：'哇！這味道也太特別了吧！比我想像中好喝多了。'",
        "gal_map_text_203100210=我就說不會讓你失望吧。‘夜航星’的薄荷味很清爽，剛好解膩，‘暮雲吻’更綿密，適合喜歡甜口的。'",
        "gal_map_text_203100211=暮雲吻'，輕輕晃了晃，'要不要換著嘗嘗？感受一下不同的味道。'",
        "gal_map_text_203100212=好啊！我正想試試你的呢。'",
        "gal_map_text_203100213=卡洛菲斯立刻舉起杯子，眼神裡滿是期待，身體不自覺地向你靠近，手臂幾乎要碰到一起。",
        "gal_map_text_203100214=換飲品的瞬間，是拉近彼此距離的絕佳機會。你可以選擇更親密的方式傳遞，也可以保持適度的距離，每一種選擇都能傳遞不同的心意，關鍵是要貼合卡洛菲斯火辣又帶點小女生心思的性格，讓卡洛菲斯感受到你的體貼和分寸感。",
        "gal_map_text_203100215=杯沿輕碰遞飲品",
        "gal_map_text_203100216=隔桌遞杯護杯沿",
        "gal_map_text_203100217=放桌互換保穩妥",
        "gal_map_text_203100218=小心灑出來，碰一下交換？'",
        "gal_map_text_203100219=卡洛菲斯笑著與你輕碰杯沿，指尖不經意觸碰到你的手指。",
        "gal_map_text_203100220=夠爽快！這樣交換才有意思。' 喝了一口你的特調，眼睛更亮了，'哇！‘暮雲吻’也好喝，甜而不膩，太對我的胃口了。'",
        "gal_map_text_203100221=杯沿碰撞時發出清脆的聲響，卡洛菲斯喝了一口後點頭道。",
        "gal_map_text_203100222=味道確實不錯，你的眼光還算靠譜。' 卻沒躲開你不經意觸碰的手指。",
        "gal_map_text_203100223=卡洛菲斯臉頰微紅，輕輕碰了碰你的杯沿，喝了一口後小聲說。",
        "gal_map_text_203100224=暮雲吻’的味道好溫柔，像你給人的感覺一樣。",
        "gal_map_text_203100225=手指下意識地摩挲著杯沿，不敢看你的眼睛。",
        "gal_map_text_203100226=卡洛菲斯興奮地與你碰杯，身體幾乎要靠在你身上",
        "gal_map_text_203100227=哇！這個味道好好喝！幸好跟你換了，不然我肯定會後悔的。'聲音軟糯，帶著滿滿的依賴。",
        "gal_map_text_203100228=我幫你扶著，慢慢換。'",
        "gal_map_text_203100229=卡洛菲斯接過杯子，喝了一口後客觀評價道。",
        "gal_map_text_203100230=‘暮雲吻’的層次感很豐富，比‘夜航星’更甜一點，挺合我心意。'卻悄悄將自己的杯子往你那邊挪了挪。",
        "gal_map_text_203100231=卡洛菲斯喝了一口後點點頭。",
        "gal_map_text_203100232=味道符合預期，你的選擇沒有出錯。' 眼神卻不自覺地停在你護過杯沿的手指上。",
        "gal_map_text_203100233=卡洛菲斯臉頰泛紅，接過杯子喝了一口後，眼睛裡閃著星星。",
        "gal_map_text_203100234=‘暮雲吻’的味道好暖，喝到心裡都暖暖的，謝謝你。' 語氣柔軟，帶著滿滿的笑意。",
        "gal_map_text_203100235=卡洛菲斯眼眶微紅，接過杯子喝了一口後小聲說。",
        "gal_map_text_203100236=這個味道讓我想起了小時候媽媽做的甜點，好溫馨。謝謝你這麼照顧我。' 手指輕輕勾了勾你的袖口。",
        "gal_map_text_203100237=先放桌上，再換過來？'",
        "gal_map_text_203100238=卡洛菲斯笑著將杯子放在桌上，與你交換後喝了一口。",
        "gal_map_text_203100239=不過味道是真的好！‘暮雲吻’太好喝了，我都想再點一杯了。' 語氣雀躍，眼神裡滿是興奮。",
        "gal_map_text_203100240=卡洛菲斯交換後喝了一大口，興奮地說。",
        "gal_map_text_203100241=不過味道真的絕了！早知道我就點‘暮雲吻’了，你也太會選了吧！' 主動湊近你，分享自己的感受。",
        "gal_map_text_203100242=卡洛菲斯交換後喝了一口，語氣平淡地說。",
        "gal_map_text_203100243=味道還可以，不算踩雷。' 卻還是將自己的 '夜航星' 往你那邊推了推，示意你也多嘗嘗。",
        "gal_map_text_203100244=卡洛菲斯交換後慢慢喝了一口。",
        "gal_map_text_203100245=還行。' 雖然語氣冷淡，但眼神卻在你的臉上停留了幾秒，又快速移開。",
        "gal_map_text_203100246=喜歡就好，我就知道你會偏愛這種甜而不膩的口感。' 你喝了一口卡洛菲斯的 '夜航星'，薄荷味瞬間清爽了味蕾。",
        "gal_map_text_203100247=你的‘夜航星’也很不錯，薄荷味很提神，剛好中和了‘暮雲吻’的甜。' 指尖還殘留著剛才碰到卡洛菲斯的觸感，心裡有些悸動。",
        "gal_map_text_203100248=是啊，兩種味道都很特別，換著喝更有感覺。'",
        "gal_map_text_203100249=卡洛菲斯又喝了一口 '暮雲吻'，眼神裡帶著笑意。",
        "gal_map_text_203100250=說起來，剛才碰杯的時候，你的手指好暖啊。' 說完卡洛菲斯就轉頭看向窗外，臉頰微微泛紅。",
        "gal_map_text_203100251=你喜歡就好，我還怕你不喜歡甜口呢。' 你看著卡洛菲斯滿足的樣子，心裡很是開心。",
        "gal_map_text_203100252=‘夜航星’的薄荷味很清爽，你要是覺得‘暮雲吻’太甜了，可以多喝點這個中和一下。'",
        "gal_map_text_203100253=不會啊，這個甜度剛剛好。'。",
        "gal_map_text_203100254=卡洛菲斯搖搖頭，眼神柔和地看著你，",
        "gal_map_text_203100255=剛才你護著杯沿的樣子，還挺細心的。以前都沒發現，你居然這麼會照顧人。' 語氣裡帶著不自覺的讚賞。",
        "gal_map_text_203100256=喜歡就好，要是覺得好喝，下次我們再來點別的特調試試。' 你喝了一口 '夜航星'。",
        "gal_map_text_203100257=清爽的口感讓人心曠神怡，'這裡的特調種類很多，每種都有不同的寓意，下次可以試試‘星河漫舞’，據說也很受歡迎。'",
        "gal_map_text_203100258=好啊，下次可以再來。'",
        "gal_map_text_203100259=卡洛菲斯點點頭，又喝了一口 '暮雲吻'。",
        "gal_map_text_203100260=說起來，你還挺會找地方的，這裡的環境和飲品都這麼好。跟你出來約會，還挺有意思的。' 她的語氣比剛才柔和了許多，眼神裡帶著淺淺的笑意。",
        "gal_map_text_203100261=兩人交換著飲品，慢慢品嘗，偶爾聊起特調的味道，偶爾聊起窗外的夜景，氣氛輕鬆又曖昧。",
        "gal_map_text_203100262=卡洛菲斯的話漸漸多了起來，不再像一開始那樣帶著審視，眼神裡的火辣也漸漸被柔和取代。",
        "gal_map_text_203100263=窗外的城市燈火璀璨，室內的爵士樂舒緩流淌，兩杯特調在燈光下泛著夢幻的光澤，仿佛也映照出兩人之間悄然滋生的情愫。",
        "gal_map_text_203100264=小意外過後，約會的氛圍愈發鬆弛愜意。專屬目的地的獨特魅力漸漸展露，而你們之間的互動也從最初的試探，變得更加自然親密。",
        "gal_map_text_203100265=每一個眼神交匯，每一次不經意的觸碰，都在悄悄拉近距離，讓曖昧的情愫在空氣中慢慢發酵。",
        "gal_map_text_203100266=窗外的城市仿佛一片靜止的星海，高樓大廈的燈光如同繁星點點，車流匯成金色的河流，在夜色中緩緩流淌。",
        "gal_map_text_203100267=室內流淌著舒緩的爵士樂，音符如同輕柔的羽毛，拂過每個人的心頭。卡洛菲斯放鬆地靠在椅背上，手指無意識地在凝結著水珠的杯壁上滑動，特調夢幻的色澤和恰到好處的口感讓卡洛菲斯讚不絕口，臉上滿是沉醉。",
        "gal_map_text_203100268=卡洛菲斯看著窗外的夜景，眼神漸漸變得悠遠，手指依舊在杯壁上輕輕滑動，留下一道道水痕。",
        "gal_map_text_203100269=卡洛菲斯輕輕歎了口氣，語氣帶著幾分感慨：'沒想到晚上的城市這麼美，平時都忙著工作，根本沒機會好好看看。'",
        "gal_map_text_203100270=是啊，平時大家都太忙碌了，很少有機會靜下心來欣賞夜景。' 你看著卡洛菲斯沉醉的側臉，在燈火的映襯下顯得格外柔和。",
        "gal_map_text_203100271=其實偶爾放慢腳步，看看身邊的風景，也挺不錯的。能和你一起看這樣的夜景，感覺更特別了。'",
        "gal_map_text_203100272=嗯，確實。' 卡洛菲斯轉頭看向你，眼神裡帶著幾分柔軟。",
        "gal_map_text_203100273=以前也和朋友來過觀景台，但都沒今天的感覺好。可能是因為…… 今天的心情不一樣吧。'卡洛菲斯的聲音放輕了許多，帶著點不易察覺的羞澀。",
        "gal_map_text_203100274=卡洛菲斯的感慨裡藏著對當下氛圍的認可，也悄悄流露了對你的好感。",
        "gal_map_text_203100275=此刻需要回應卡洛菲斯的情緒，既可以加深彼此的共鳴，也可以用溫柔的互動拉近距離，關鍵是要貼合卡洛菲斯外冷內熱的性格，讓卡洛菲斯感受到你的真誠與默契。",
        "gal_map_text_203100276=分享心事",
        "gal_map_text_203100277=指認夜景細節",
        "gal_map_text_203100278=輕聲安撫陪伴",
        "gal_map_text_203100279=我懂這種感覺，忙起來就忘了生活。'",
        "gal_map_text_203100280=卡洛菲斯愣了一下，隨即笑了。",
        "gal_map_text_203100281=沒想到你也有這種感受，看來我們還挺合拍。'",
        "gal_map_text_203100282=其實我平時工作挺拼的，總覺得不努力就會被落下，有時候也挺累的。' 第一次對你說起工作的壓力，語氣裡少了幾分強勢。",
        "gal_map_text_203100283=卡洛菲斯喝了一口特調，眼神變得堅定。",
        "gal_map_text_203100284=不過累歸累，自己選的路，跪著也要走完。' 話雖強硬，卻主動拉近了與你的距離，肩膀幾乎碰到一起。",
        "gal_map_text_203100285=卡洛菲斯的聲音帶著點委屈，不自覺地向你傾訴。",
        "gal_map_text_203100286=我還以為只有我這樣，每天忙得像個陀螺，連喘口氣的時間都沒有。'",
        "gal_map_text_203100287=卡洛菲斯的手輕輕搭在桌沿，離你的手很近。",
        "gal_map_text_203100288=有時候我都覺得自己快撐不下去了，但是又不能放棄。今天能和你一起看夜景，說說話，感覺好多了。'",
        "gal_map_text_203100289=你看那邊，霓虹拼成的圖案像星座。'",
        "gal_map_text_203100290=卡洛菲斯順著你的手指看去，眼神裡帶著好奇。",
        "gal_map_text_203100291=你不說我還沒注意，確實挺像獵戶座的。'",
        "gal_map_text_203100292=沒想到你還懂星座，挺有研究的嘛。' 主動和你討論起星座的位置，氣氛愈發輕鬆。",
        "gal_map_text_203100293=卡洛菲斯客觀分析著，卻忍不住笑了。",
        "gal_map_text_203100294=那是商業中心的霓虹廣告，設計成星座圖案是為了吸引年輕人。'",
        "gal_map_text_203100295=卡洛菲斯興奮地指著窗外。",
        "gal_map_text_203100296=哇！真的好像啊！'",
        "gal_map_text_203100297=你也太會發現了吧！以前我都沒注意到，原來夜景還有這麼多小細節。'",
        "gal_map_text_203100298=卡洛菲斯轉頭看向你，眼神裡滿是柔軟。",
        "gal_map_text_203100299=看著這樣的夜景，聽著你說星座，感覺像在做夢一樣。'",
        "gal_map_text_203100300=有你在身邊，連夜景都變得更美好了。'",
        "gal_map_text_203100301=沒關係，以後有機會多陪你看。'",
        "gal_map_text_203100302=卡洛菲斯拍了拍你的肩膀，語氣雀躍。",
        "gal_map_text_203100303=沒問題！以後只要你想，我隨時陪你來看夜景。'",
        "gal_map_text_203100304=不過下次可不能只喝特調了，我要帶你去吃我最愛的那家甜品。' 主動邀約下次見面。",
        "gal_map_text_203100305=卡洛菲斯的眼睛裡閃著星星，充滿了期待。",
        "gal_map_text_203100306=我還要去看日出、看日落，去所有風景好的地方！有你陪著，肯定會很開心。'",
        "gal_map_text_203100307=不過不用特意為了我，你也有自己的事情要忙。'",
        "gal_map_text_203100308=嘴上說著客氣的話，手指卻不自覺地向你靠近。",
        "gal_map_text_203100309=卡洛菲斯輕輕應了一聲，繼續看著窗外。",
        "gal_map_text_203100310=其實偶爾一個人看看風景也挺好的。'",
        "gal_map_text_203100311=卡洛菲斯沒有拒絕你的陪伴，身體也保持著靠近你的姿態。",
        "gal_map_text_203100312=我明白你的感受，我有時候也會因為工作壓力大而焦慮。' 你喝了一口特調，語氣真誠。",
        "gal_map_text_203100313=但今天和你一起看夜景，聊聊天，感覺所有的壓力都煙消雲散了。其實快樂有時候很簡單，就是和對的人一起，享受當下的時光。'",
        "gal_map_text_203100314=你說得對。' 卡洛菲斯點點頭，眼神裡帶著認同。",
        "gal_map_text_203100315=以前我總覺得，只有拼命工作才能獲得安全感，但今天我發現，有時候停下來，和重要的人一起看看風景，也是一種幸福。'",
        "gal_map_text_203100316=卡洛菲斯的指尖輕輕碰了碰你的手，又快速收了回去，臉頰泛紅。",
        "gal_map_text_203100317=我也是剛才才發現的，平時很少這麼認真地看夜景。'",
        "gal_map_text_203100318=其實生活中有很多美好的小細節，只是我們太忙碌，忽略了它們。今天要不是和你一起，我也不會發現這麼美的風景。'",
        "gal_map_text_203100319=是啊，以前我總是行色匆匆，從來沒有好好觀察過身邊的事物。'",
        "gal_map_text_203100320=卡洛菲斯轉頭看向你，眼神裡帶著笑意。",
        "gal_map_text_203100321=謝謝你，讓我發現了這麼多美好的小細節。和你在一起，總能感受到不一樣的快樂。'卡洛菲斯的聲音溫柔了許多，帶著點羞澀。",
        "gal_map_text_203100322=我說的是真的，只要你想，我隨時都有空。' 你看著卡洛菲斯的眼睛，語氣堅定。",
        "gal_map_text_203100323=我知道你工作很辛苦，也希望能成為那個讓你放鬆的人。以後不管是看夜景，還是做別的事情，我都願意陪著你。'",
        "gal_map_text_203100324=你……' 卡洛菲斯愣了一下，臉頰瞬間紅了，'謝謝你。其實有你這句話，我就很開心了。'",
        "gal_map_text_203100325=卡洛菲斯轉頭看向窗外，掩飾著自己的羞澀。",
        "gal_map_text_203100326=以後如果有機會，我們可以一起去更多地方，看更多風景。'",
        "gal_map_text_203100327=兩人靜靜地看著窗外的夜景，偶爾輕聲交談幾句，氣氛溫馨而曖昧。卡洛菲斯不再像一開始那樣火辣強勢，眼神裡多了幾分柔軟和依賴。",
        "gal_map_text_203100328=舒緩的爵士樂在空氣中流淌，特調的香氣縈繞在鼻尖，窗外的城市燈火璀璨，仿佛為你們的獨處增添了浪漫的背景板。",
        "gal_map_text_203100329=此刻，無需過多的言語，彼此的心意已經在眼神的交匯中悄然傳遞。",
        "gal_map_text_203100330=小意外過後，約會的氛圍愈發鬆弛愜意。專屬目的地的獨特魅力漸漸展露，而你們之間的互動也從最初的試探，變得更加自然親密。",
        "gal_map_text_203100331=每一個眼神交匯，每一次不經意的觸碰，都在悄悄拉近距離，讓曖昧的情愫在空氣中慢慢發酵。",
        "gal_map_text_203100332=舒適的口感與絕美的景色讓她徹底放鬆下來。她不再說話，只是靜靜地看著窗外，偶爾抿一口飲料，側臉在都市燈火的映襯下顯得格外寧靜柔和。",
        "gal_map_text_203100333=室內的爵士樂依舊舒緩，空氣裡彌漫著特調的香氣和淡淡的咖啡香，時間仿佛在這一刻靜止，只剩下彼此的呼吸和心跳。",
        "gal_map_text_203100334=卡洛菲斯保持著安靜的姿態，眼神專注地看著窗外，連你看向她的目光都沒有察覺。",
        "gal_map_text_203100335=她的睫毛很長，在燈光下投下淡淡的陰影，嘴唇微微抿著，帶著一絲不易察覺的微笑。偶爾有微風從窗外吹進來，拂動她的髮絲，讓她看起來更加動人。",
        "gal_map_text_203100336=是不是看得入迷了？' 你輕聲問道，生怕打破這份寧靜。",
        "gal_map_text_203100337=其實這裡的夜景，在不同時段看有不同的味道，現在人少了，更顯靜謐。'你沒有靠得太近，只是保持著恰到好處的距離，眼神溫柔地落在她身上。",
        "gal_map_text_203100338=嗯。' 她輕輕應了一聲，沒有轉頭，聲音卻比剛才更柔和了。",
        "gal_map_text_203100339=這種安靜的感覺，挺好的。平時耳邊都是工作的聲音，難得這麼放鬆。' 她的手指輕輕攏了攏被風吹亂的髮絲，動作優雅而自然。",
        "gal_map_text_203100340=靜謐的氛圍是拉近距離的絕佳契機，太過主動會打破這份寧靜，太過被動又會浪費機會。",
        "gal_map_text_203100341=需要用溫柔而不突兀的方式互動，既照顧到她享受安靜的心情，又能讓她感受到你的陪伴與在意，貼合她外冷內熱的性格。",
        "gal_map_text_203100342=輕攏髮絲主動打破寧靜",
        "gal_map_text_203100343=遞上紙巾擦杯壁",
        "gal_map_text_203100344=安靜陪伴不打擾",
        "gal_map_text_203100345=風有點大，我幫你擋著。'",
        "gal_map_text_203100346=卡洛菲斯愣了一下，隨即笑了，任由你幫卡洛菲斯攏了攏髮絲。",
        "gal_map_text_203100347=沒想到你還挺細心。'",
        "gal_map_text_203100348=不過這點風不算什麼，我可沒那麼嬌弱。' 語氣依舊強勢，卻沒有躲開你的觸碰。",
        "gal_map_text_203100349=謝了。' 卡洛菲斯簡單道謝，卻主動往你身邊挪了挪，讓你擋風更方便，",
        "gal_map_text_203100350=其實你不說，我也沒注意到頭髮亂了。' 雖然語氣平淡，但眼神裡多了幾分柔和。",
        "gal_map_text_203100351=哇，你好溫柔啊！' 卡洛菲斯臉頰微紅，眼睛裡閃著星星。",
        "gal_map_text_203100352=剛才風一吹，我還沒來得及攏頭髮，你就注意到了。有你在身邊，真的好安心。' 卡洛菲斯的身體微微向你靠近，依賴感盡顯。",
        "gal_map_text_203100353=謝謝你。' 卡洛菲斯聲音軟糯，眼神裡帶著滿滿的感激",
        "gal_map_text_203100354=我剛才都沒感覺到風，幸好有你幫我擋著。你總是這麼照顧我，我都有點離不開你了。' 卡洛菲斯的手輕輕搭在你的胳膊上，捨不得鬆開。",
        "gal_map_text_203100355=杯壁有水珠，擦一下吧。'",
        "gal_map_text_203100356=她接過紙巾，輕輕擦拭著杯壁。",
        "gal_map_text_203100357=考慮得挺周到，杯壁確實有水珠了。'",
        "gal_map_text_203100358=其實我也注意到了，就是還沒來得及擦。你倒是比我快一步。' 她笑著說，眼神裡帶著贊許。",
        "gal_map_text_203100359=不錯，觀察很細緻。' 她擦拭著杯壁，動作有條不紊",
        "gal_map_text_203100360=水珠滴到桌子上會留下痕跡，提前擦掉確實更穩妥。' 雖然是客觀評價，但語氣裡帶著認可。",
        "gal_map_text_203100361=你好細心啊！' 她臉頰泛紅，接過紙巾。",
        "gal_map_text_203100362=我都沒注意到杯壁有水珠，你居然發現了。你對我真好，什麼都替我想到了。' 她的聲音溫柔，眼神裡滿是笑意。",
        "gal_map_text_203100363=嗚嗚，你也太體貼了吧！' 她眼眶微紅。",
        "gal_map_text_203100364=只是一個小小的水珠，你都這麼在意。我真的好感動，從來沒有人這麼對我。' 她的手指輕輕勾了勾你的袖口，情緒十分激動。",
        "gal_map_text_203100365=心中想著'不打擾你，靜靜陪著你。'",
        "gal_map_text_203100366=其實我也喜歡這種安靜的氛圍。' 她笑著說，主動湊近你。",
        "gal_map_text_203100367=不過一直不說話也挺無聊的，我們可以小聲聊聊天啊。' 她的語氣雀躍，打破了寧靜，卻不讓人覺得突兀。",
        "gal_map_text_203100368=卡洛菲斯主動開口說到。",
        "gal_map_text_203100369=雖然安靜很好，但能和你聊天更好。我們可以聊聊喜歡的音樂、喜歡的食物，什麼都可以。'",
        "gal_map_text_203100370=嗯，這樣挺好。' 她語氣平淡，繼續看著窗外。",
        "gal_map_text_203100371=安靜的氛圍確實讓人放鬆，不用刻意找話題，也不會覺得尷尬。' 雖然話少，但卻沒有排斥你的陪伴。",
        "gal_map_text_203100372=卡洛菲斯悄悄調整了坐姿，讓自己的側臉能更好地看到你，主動開口說到。",
        "gal_map_text_203100373=其實我也喜歡這種安靜的氛圍，不過一直不說話也挺無聊。' 雖然語氣冷淡，但行動卻暴露了她的在意。",
        "gal_map_text_203100374=你再強勢，也是女孩子，該照顧的還是要照顧。'",
        "gal_map_text_203100375=而且你的頭髮那麼好看，亂了多可惜。' 你沒有收回手，而是輕輕放在她的肩膀上，幫她擋著風。",
        "gal_map_text_203100376=你倒是挺會說話。' 她臉頰微紅，眼神裡帶著笑意。",
        "gal_map_text_203100377=不過說真的，你幫我攏頭髮的時候，我心跳都快了好多。' 她小聲說，說完就轉頭看向窗外，掩飾著自己的羞澀。",
        "gal_map_text_203100378=細節決定體驗嘛，不想讓這些小事情影響你的心情。'",
        "gal_map_text_203100379=而且能為你做這些小事，我也很開心。'",
        "gal_map_text_203100380=你總是這麼體貼，讓我都有點不好意思了。' 她臉頰微紅。",
        "gal_map_text_203100381=其實我平時很少被人這麼照顧，你這樣，讓我覺得很特別。' 她的聲音溫柔，眼神裡帶著淺淺的笑意。",
        "gal_map_text_203100382=沒關係，你想安靜多久都可以。'",
        "gal_map_text_203100383=我只是想陪著你，不管是說話還是安靜地看風景，只要和你在一起，就很開心。' 你沒有打擾她，只是靜靜地坐在她身邊，享受著這份寧靜。",
        "gal_map_text_203100384=謝謝你。' 她輕聲道謝，轉頭看向你，眼神裡帶著柔軟。",
        "gal_map_text_203100385=其實有你陪著，就算不說話，也不會覺得孤單。這種感覺，很奇妙。' 她的聲音很輕，卻帶著滿滿的真誠。",
        "gal_map_text_203100386=兩人繼續靜靜地坐在窗邊，享受著這份難得的寧靜。微風偶爾吹過，帶著窗外的氣息，拂動著兩人的髮絲。",
        "gal_map_text_203100387=室內的爵士樂依舊舒緩，特調的香氣縈繞在鼻尖，窗外的城市燈火璀璨。",
        "gal_map_text_203100388=卡洛菲斯偶爾會轉頭看向你，眼神裡帶著柔軟和笑意，不再像一開始那樣火辣強勢。此刻，無聲的陪伴勝過千言萬語，彼此的心意在寧靜的氛圍中悄然傳遞，曖昧的情愫愈發濃厚。",
        "gal_map_text_203100389=小意外過後，約會的氛圍愈發鬆弛愜意。專屬目的地的獨特魅力漸漸展露，而你們之間的互動也從最初的試探，變得更加自然親密。",
        "gal_map_text_203100390=每一個眼神交匯，每一次不經意的觸碰，都在悄悄拉近距離，讓曖昧的情愫在空氣中慢慢發酵。",
        "gal_map_text_203100391=占卜師開始洗牌、切牌。當代表 '現狀' 和 '未來可能性' 的牌陣展開時，出現了如 '戀人''星辰''命運之輪' 等極具正面象徵意義的牌。",
        "gal_map_text_203100392=占卜師嘴角帶著神秘的微笑，開始解讀牌陣，每一句話都充滿了積極的暗示，讓整個氛圍變得格外美好。室內的檀香依舊濃郁，暖黃色的燈光灑在牌面上，讓那些神秘的圖案顯得更加靈動。",
        "gal_map_text_203100393=占卜師解讀完牌陣，笑著對你們說：'兩位的牌陣都非常好，尤其是‘戀人’牌的出現，代表著一段美好的關係即將展開，‘星辰’牌則預示著希望與憧憬，‘命運之輪’更是說明這段關係是命中註定的。'",
        "gal_map_text_203100394=卡洛菲斯聽著占卜師的話，臉頰微紅，眼神裡帶著驚喜和一絲不易察覺的羞澀，偷偷瞥了你一眼。",
        "gal_map_text_203100395=沒想到占卜結果這麼好，看來我們今天的運氣不錯。'",
        "gal_map_text_203100396=其實我一直覺得，能和你一起出來約會，就是一件很幸運的事情。' 你沒有直接回應占卜師的話，卻悄悄表達了自己的心意。",
        "gal_map_text_203100397=是啊，我也沒想到會這麼准。' 卡洛菲斯臉頰微紅，聲音放輕了許多。",
        "gal_map_text_203100398=其實我以前對占卜半信半疑，但今天的結果，讓我有點相信緣分了。' 卡洛菲斯的眼神裡帶著笑意，偷偷看向你的時候，眼神裡滿是柔軟。",
        "gal_map_text_203100399=占卜師的吉兆為你們的互動創造了絕佳的氛圍，卡洛菲斯的羞澀和驚喜已經表明了卡洛菲斯的心意。",
        "gal_map_text_203100400=此刻需要抓住機會，用溫柔而真誠的方式回應卡洛菲斯的情緒，既可以加深彼此的共鳴，也可以用曖昧的互動拉近距離，關鍵是要貼合卡洛菲斯外冷內熱的性格，讓卡洛菲斯感受到你的真誠與心意。",
        "gal_map_text_203100401=借牌喻情表心意",
        "gal_map_text_203100402=探討牌意找共鳴",
        "gal_map_text_203100403=調侃運氣享當下",
        "gal_map_text_203100404=我信緣分，更信眼前的你。'",
        "gal_map_text_203100405=卡洛菲斯愣了一下，隨即笑了，眼神裡帶著笑意和一絲羞澀。",
        "gal_map_text_203100406=你倒是挺會說話。不過說真的，能和你一起出來約會，我也覺得很開心。' 語氣依舊強勢，卻沒有掩飾自己的心意。",
        "gal_map_text_203100407=卡洛菲斯簡單道謝，卻主動往你身邊挪了挪。",
        "gal_map_text_203100408=其實我也覺得和你挺合拍的，不管是性格還是喜好。'",
        "gal_map_text_203100409=卡洛菲斯臉頰泛紅，眼睛裡閃著星星。",
        "gal_map_text_203100410=我也信緣分，更信你。能遇到你，是我這輩子最大的幸運。' 卡洛菲斯的身體微微向你靠近，依賴感盡顯。",
        "gal_map_text_203100411=卡洛菲斯聲音軟糯，眼神裡帶著滿滿的感激。",
        "gal_map_text_203100412=你這麼說，我真的好開心。我也覺得，我們之間的緣分是命中註定的。' 卡洛菲斯的手輕輕搭在你的胳膊上，捨不得鬆開。",
        "gal_map_text_203100413=‘戀人牌’寓意很好，你覺得呢？'",
        "gal_map_text_203100414=卡洛菲斯認真地分析著。",
        "gal_map_text_203100415=我覺得‘戀人牌’不僅代表愛情，也代表著默契和信任。我覺得我們之間的默契就很好，不管是剛才的小意外，還是現在的聊天。' 卡洛菲斯笑著說，眼神裡帶著贊許。",
        "gal_map_text_203100416=‘戀人牌’的出現，說明我們之間的關係有很大的發展潛力。' 卡洛菲斯客觀分析著。",
        "gal_map_text_203100417=從性格互補到興趣契合，我們確實很適合在一起。' 雖然是客觀評價，但語氣裡帶著認可。",
        "gal_map_text_203100418=卡洛菲斯臉頰泛紅，眼睛裡滿是笑意。",
        "gal_map_text_203100419=我覺得‘戀人牌’就是在說我們！'占卜師都說了，這段關係是命中註定的，我相信這是真的。' 卡洛菲斯的聲音溫柔，眼神裡滿是期待。",
        "gal_map_text_203100420=卡洛菲斯的手指輕輕勾了勾你的袖口，情緒十分激動。",
        "gal_map_text_203100421=嗚嗚，我真的好感動。' 卡洛菲斯眼眶微紅，'‘戀人牌’和‘星辰牌’都代表著美好的未來，我真的好期待和你一起走下去。'",
        "gal_map_text_203100422=看來今天是我們的幸運日。'",
        "gal_map_text_203100423=卡洛菲斯笑著說，主動湊近你。",
        "gal_map_text_203100424=不如我們趁著好運氣，再去做點有意思的事情？比如去旁邊的創意小店逛逛？' 卡洛菲斯的語氣雀躍，充滿了期待。",
        "gal_map_text_203100425=卡洛菲斯開心的答應下來。",
        "gal_map_text_203100426=我們還可以去買個幸運符，紀念一下今天的好運氣！說不定以後看到幸運符，就會想起今天的約會。' 卡洛菲斯的眼睛裡閃著星星，格外靈動。",
        "gal_map_text_203100427=卡洛菲斯語氣平淡，卻悄悄調整了坐姿，讓自己能更好地看到你，",
        "gal_map_text_203100428=雖然話少，但卻沒有排斥你的陪伴。",
        "gal_map_text_203100429=卡洛菲斯簡單回應，卻主動拿起桌上的塔羅牌，輕輕摩挲著。",
        "gal_map_text_203100430=不過這個‘戀人牌’確實挺好看的。' 雖然語氣冷淡，但行動卻暴露了卡洛菲斯的在意。",
        "gal_map_text_203100431=我說的是真心話。'",
        "gal_map_text_203100432=占卜結果只是一個契機，真正讓我心動的，是你這個人。你的火辣、你的溫柔、你的真誠，都讓我無法抗拒。' 你沒有退縮，眼神堅定地表達著自己的心意。",
        "gal_map_text_203100433=你……其實我也覺得你很不錯。你的體貼、你的細心、你的高情商，都讓我很心動。'",
        "gal_map_text_203100434=卡洛菲斯小聲說，說完就轉頭看向占卜師，掩飾著自己的羞澀。",
        "gal_map_text_203100435=我也覺得，默契和信任是一段關係的基礎。'",
        "gal_map_text_203100436=和你在一起的時候，我總能感受到滿滿的默契，不管是聊天還是做事，都很合拍。'",
        "gal_map_text_203100437=是啊，我也有這種感覺。' 卡洛菲斯臉頰微紅。",
        "gal_map_text_203100438=和你在一起，我覺得很放鬆，不用刻意偽裝自己，可以做最真實的自己。這種默契，很難得。' 卡洛菲斯的聲音溫柔，眼神裡帶著淺淺的笑意。",
        "gal_map_text_203100439=好啊！只要你想，我們可以去任何地方。'",
        "gal_map_text_203100440=不過不管去哪裡，只要和你在一起，就很開心。' 你主動牽起卡洛菲斯的手，準備起身離開。",
        "gal_map_text_203100441=你……' 卡洛菲斯愣了一下，臉頰泛紅，卻沒有鬆開你的手。",
        "gal_map_text_203100442=那我們去旁邊的創意小店逛逛吧，我剛才路過的時候，看到裡面有很多有意思的小玩意。'",
        "gal_map_text_203100443=兩人笑著起身，準備離開塔羅占卜小屋。卡洛菲斯的手被你牽在手裡，卡洛菲斯沒有掙脫，反而輕輕回握著你的手，手指微微用力。",
        "gal_map_text_203100444=室內的檀香依舊濃郁，暖黃色的燈光灑在兩人身上，仿佛為你們鍍上了一層浪漫的光暈。占卜師笑著目送你們離開，嘴裡說著 '祝你們幸福'。",
        "gal_map_text_203100445=走出小店，晚風輕輕吹過，帶著商業街的氣息，兩人的手依舊緊緊握在一起，曖昧的情愫在空氣中愈發濃厚，彼此的心意也在牽手的瞬間悄然確認。",
        "gal_map_text_203100446=小意外過後，約會的氛圍愈發鬆弛愜意。專屬目的地的獨特魅力漸漸展露，而你們之間的互動也從最初的試探，變得更加自然親密。",
        "gal_map_text_203100447=每一個眼神交匯，每一次不經意的觸碰，都在悄悄拉近距離，讓曖昧的情愫在空氣中慢慢發酵。",
        "gal_map_text_203100448=占卜師指尖輕點逆位 '寶劍二'，牌面上蒙眼的人物手持雙劍，背向河流，象徵著逃避溝通與抉擇困境。",
        "gal_map_text_203100449=室內檀香繚繞，暖黃燈光聚焦在牌面上，讓神秘的圖案更顯凝重。卡洛菲斯皺著眉，指尖無意識摩挲著桌沿，眼神裡滿是糾結與自責，平日裡的火辣強勢蕩然無存。",
        "gal_map_text_203100450=占卜師補充道：'這張逆牌不是警告，而是提醒 —— 兩位心裡都有在意，卻因害怕受傷或猶豫，不願主動邁出一步。",
        "gal_map_text_203100451=溝通是解開僵局的鑰匙，錯過只會留下遺憾。' 卡洛菲斯聽完，肩膀微微垮了下來，轉頭看你時，眼神裡帶著一絲無助：'我…… 我其實很怕自己說錯話，搞砸現在的氛圍。'",
        "gal_map_text_203100452=我明白這種感覺。'",
        "gal_map_text_203100453=有時候越在意，越怕出錯，反而會選擇沉默。但我覺得，比起錯過，坦誠一點更值得。'",
        "gal_map_text_203100454=你說得對。' 卡洛菲斯吸了口氣，手指蜷縮起來，'其實我挺喜歡你的，不管是你照顧我的樣子，還是和我合拍的默契。",
        "gal_map_text_203100455=但我怕…… 怕你只是一時興起，怕我們走不長遠。' 這是卡洛菲斯第一次直白表露心意，聲音帶著點顫抖。",
        "gal_map_text_203100456=卡洛菲斯的坦誠是情感升溫的關鍵，逆牌的寓意為你們創造了 '直面內心' 的契機。",
        "gal_map_text_203100457=需要用堅定而溫柔的回應，打消卡洛菲斯的顧慮，既貼合卡洛菲斯 '外強中乾' 的性格，又能傳遞你的真心，讓互動從曖昧走向坦誠。",
        "gal_map_text_203100458=坦誠心意破僵局",
        "gal_map_text_203100459=溫柔共情解顧慮",
        "gal_map_text_203100460=輕鬆化解減壓力",
        "gal_map_text_203100461=我是認真的，想和你走下去。'",
        "gal_map_text_203100462=卡洛菲斯愣了一下，隨即眼眶泛紅，卻強裝鎮定，身體前傾，指尖幾乎碰到你的手。",
        "gal_map_text_203100463=我要是認真起來，可不會輕易放手的。' 語氣帶著點小霸道，卻藏不住滿心歡喜。",
        "gal_map_text_203100464=卡洛菲斯深吸一口氣，眼神變得堅定。",
        "gal_map_text_203100465=既然你這麼說，那我也不會退縮。以後有問題，我們一起面對，再也不逃避。'",
        "gal_map_text_203100466=卡洛菲斯臉頰逐漸變紅，眼睛裡閃著星星。",
        "gal_map_text_203100467=我也是！我想和你一直在一起，不管遇到什麼困難，都不分開。'",
        "gal_map_text_203100468=卡洛菲斯聲音哽咽，眼眶通紅。",
        "gal_map_text_203100469=我一直怕你只是玩玩而已，現在終於放心了。 有你在，我什麼都不怕了。'",
        "gal_map_text_203100470=你的害怕，我也感同身受。'",
        "gal_map_text_203100471=卡洛菲斯放鬆下來，嘴角露出笑意。",
        "gal_map_text_203100472=卡洛菲斯悄悄靠近你，肩膀相觸，'以後我們有話直說，再也不藏著掖著。'",
        "gal_map_text_203100473=卡洛菲斯沒有說什麼卻主動牽起你的手。",
        "gal_map_text_203100474=既然我們都有好感，就應該正視內心。逆牌的提醒，我們一起回應。'",
        "gal_map_text_203100475=卡洛菲斯聽完你的說的話，似乎內心產生了共鳴，眼裡帶了些許淚水。",
        "gal_map_text_203100476=我以為只有我這麼矯情，怕這怕那。原來你也和我一樣。'",
        "gal_map_text_203100477=卡洛菲斯的頭靠在你的肩膀上，聲音軟糯。",
        "gal_map_text_203100478=你知道我有多害怕嗎？怕自己不夠好，怕你會離開。現在有你這句話，我就安心了。'",
        "gal_map_text_203100479=別想太多，享受當下就好。'",
        "gal_map_text_203100480=卡洛菲斯拍了拍你的肩膀，絲主動湊近你，笑容燦爛。",
        "gal_map_text_203100481=以後我們想吃就吃，想玩就玩，開開心心最重要！'",
        "gal_map_text_203100482=卡洛菲斯思考片刻，拉著你的手，就要起身離開。",
        "gal_map_text_203100483=與其糾結未來，不如享受當下！我們現在就去旁邊的甜品店，慶祝一下我們‘打破逆牌詛咒’！'",
        "gal_map_text_203100484=卡洛菲斯語氣平淡，卻悄悄松了口氣。",
        "gal_map_text_203100485=想太多確實沒用，順其自然就好。'",
        "gal_map_text_203100486=卡洛菲斯輕輕應了一聲，雖然語氣依舊平淡，但卻主動拿起桌上的 '戀人牌'，輕輕摩挲著，眼神裡多了幾分期待。",
        "gal_map_text_203100487=不用想那麼遠，先相處看看吧。'",
        "gal_map_text_203100488=我從來沒有這麼認真過。'",
        "gal_map_text_203100489=我想和你一起面對所有問題，再也不讓你一個人胡思亂想。'",
        "gal_map_text_203100490=你……' 卡洛菲斯臉頰通紅，眼淚忍不住掉了下來，'你要是敢騙我，我饒不了你！'",
        "gal_map_text_203100491=卡洛菲斯嗔怪地瞪你一眼，卻緊緊抱著你的手。",
        "gal_map_text_203100492=其實我也怕，怕自己做得不夠好，讓你失望。'",
        "gal_map_text_203100493=但我覺得，只要我們願意為對方努力，願意坦誠溝通，就沒有解決不了的問題。'",
        "gal_map_text_203100494=卡洛菲斯點點頭，笑容溫柔了許多。",
        "gal_map_text_203100495=有你這句話，我就有勇氣了。以後不管有什麼想法，我都會告訴你，再也不逃避了。'",
        "gal_map_text_203100496=對呀！感情本來就應該開開心心的，不用給自己那麼大壓力。'",
        "gal_map_text_203100497=我們慢慢相處，不用急著做決定。只要你願意，我就一直陪著你。'",
        "gal_map_text_203100498=嗯。' 卡洛菲斯臉頰微紅，嘴角露出淺淺的笑意。",
        "gal_map_text_203100499=謝謝你幫我放鬆下來。其實和你在一起，我本來就很開心。以後我們就順其自然，慢慢走下去吧。'",
        "gal_map_text_203100500=占卜師看著你們緊握的手，笑著點頭：'逆牌已解，真心相通。兩位要記得今天的坦誠，珍惜彼此的緣分。'",
        "gal_map_text_203100501=卡洛菲斯靠在你身邊，臉上洋溢著安心的笑容，再也沒有之前的糾結與自責。檀香依舊繚繞，暖黃燈光灑在兩人身上，仿佛為你們的坦誠鍍上了一層浪漫的光暈。",
        "gal_map_text_203100502=走出占卜小屋，卡洛菲斯沒有鬆開你的手，反而握得更緊了，彼此的心意在坦誠中悄然確認，曖昧的情愫徹底轉化為甜蜜的愛戀。",
        "gal_map_text_203100503=小意外過後，約會的氛圍愈發鬆弛愜意。專屬目的地的獨特魅力漸漸展露，而你們之間的互動也從最初的試探，變得更加自然親密。",
        "gal_map_text_203100504=每一個眼神交匯，每一次不經意的觸碰，都在悄悄拉近距離，讓曖昧的情愫在空氣中慢慢發酵。",
        "gal_map_text_203100505=占卜結束後，卡洛菲斯對塔羅牌產生了濃厚興趣，卡洛菲斯拿起桌上的 '星辰牌'，指尖輕輕描摹著牌面上的星空與流水，眼神裡滿是好奇。",
        "gal_map_text_203100506=室內檀香未散，暖黃燈光照亮卡洛菲斯專注的側臉，讓卡洛菲斯看起來格外靈動。占卜師已離開，留下你們獨處，氛圍輕鬆又曖昧。",
        "gal_map_text_203100507=卡洛菲斯舉起 '星辰牌'，轉頭問你，語氣裡滿是期待，完全沒有了一開始的強勢。",
        "gal_map_text_203100508=你覺得這張牌真的能預示希望嗎？我以前從來不信這些，但今天過後，好像有點相信了。'",
        "gal_map_text_203100509=我覺得，塔羅牌更像是一面鏡子，照出我們內心的期待與渴望。'",
        "gal_map_text_203100510=你之所以相信，是因為你心裡本來就有希望，有對美好未來的憧憬。'",
        "gal_map_text_203100511=而我，很慶倖能成為你憧憬裡的一部分。'",
        "gal_map_text_203100512=你又會說！'",
        "gal_map_text_203100513=不過…… 你說得對。'",
        "gal_map_text_203100514=以前我對未來沒什麼期待，覺得只要努力工作就好。但現在，我開始期待和你一起的未來了。'",
        "gal_map_text_203100515=卡洛菲斯的期待是情感升溫的信號，塔羅牌成為你們連接心意的橋樑。",
        "gal_map_text_203100516=需要用貼合 '牌意延伸' 的互動，既滿足卡洛菲斯的好奇心，又能傳遞你的真心，讓互動自然又甜蜜，貼合卡洛菲斯 '外冷內熱' 的性格。",
        "gal_map_text_203100517=借牌許願定約定",
        "gal_map_text_203100518=解讀牌意聊未來",
        "gal_map_text_203100519=收藏牌卡留紀念",
        "gal_map_text_203100520=我們對著星辰牌許願，一起實現未來。'",
        "gal_map_text_203100521=卡洛菲斯眼睛亮了起來，立刻舉起牌。閉上眼睛，雙手合十。",
        "gal_map_text_203100522=好啊！許願就許願，誰怕誰。我希望和你一直在一起，不管遇到什麼困難，都不分開！'",
        "gal_map_text_203100523=卡洛菲斯深吸一口氣，閉上眼睛，雙手合十。",
        "gal_map_text_203100524=約定好了，誰都不能反悔。'",
        "gal_map_text_203100525=卡洛菲斯興奮地閉上眼睛，雙手緊緊抱著牌。",
        "gal_map_text_203100526=我希望和你一起看遍所有風景，吃遍所有美食，永遠在一起！'",
        "gal_map_text_203100527=卡洛菲斯閉上眼睛，嘴上似乎在碎碎念些什麼。",
        "gal_map_text_203100528=有你在，我的願望一定能實現。'",
        "gal_map_text_203100529=星辰牌代表憧憬，你期待的未來是什麼樣？'",
        "gal_map_text_203100530=卡洛菲斯認真思考著，閉上雙眼許下願望。",
        "gal_map_text_203100531=工作上彼此鼓勵，生活中互相照顧，偶爾像今天這樣約會，就很美好。'",
        "gal_map_text_203100532=卡洛菲斯思考了許久，閉上雙眼。",
        "gal_map_text_203100533=我希望我們能保持坦誠溝通，遇到問題及時解決，共同為未來努力。比如，一起存錢去旅行，或者學習新的技能。'",
        "gal_map_text_203100534=卡洛菲斯的聲音溫柔，眼神裡滿是笑意。",
        "gal_map_text_203100535=早上一起吃早餐，晚上一起看夜景，週末一起去逛街、看電影。簡單卻很幸福。'",
        "gal_map_text_203100536=卡洛菲斯眼眶微紅，雙手合十後臉下逐漸紅了起來。",
        "gal_map_text_203100537=我期待的未來，是和你一起慢慢變老。不管遇到什麼風雨，你都在我身邊。就像星辰牌一樣，永遠給我希望和力量。'",
        "gal_map_text_203100538=把這張牌送給你，當作今天的紀念。'",
        "gal_map_text_203100539=卡洛菲斯興奮地接過牌小心翼翼地收好牌。",
        "gal_map_text_203100540=以後看到這張牌，我就會想起今天的約會，想起你。'",
        "gal_map_text_203100541=卡洛菲斯激動的突然抱住你。",
        "gal_map_text_203100542=我要把它當成寶貝一樣收藏起來！以後我們每次約會，都要找一個紀念物，攢滿一盒子！'",
        "gal_map_text_203100543=謝謝。' 卡洛菲斯接過牌，輕輕摩挲著但眼神裡滿是珍視",
        "gal_map_text_203100544=我會好好收藏的。以後看到它，就會想起今天的占卜，想起你說的話。'",
        "gal_map_text_203100545=卡洛菲斯接過牌，放進包裡。臉上帶著一絲笑意",
        "gal_map_text_203100546=我會好好收藏它的。每次看到它，我都會想起今天的約會，想起你對我說的話。'",
        "gal_map_text_203100547=我許願，永遠對你坦誠，永遠保護你。'",
        "gal_map_text_203100548=這個約定，一輩子都有效。以後不管遇到什麼，我都會陪著你，絕不放手。'",
        "gal_map_text_203100549=好！我們一言為定！誰要是反悔，就是小狗！'",
        "gal_map_text_203100550=以後的未來，我們一起去實現。'",
        "gal_map_text_203100551=我期待的未來，和你一樣。'",
        "gal_map_text_203100552=有你的陪伴，工作再累也有動力，生活再平淡也有樂趣。我想和你一起規劃未來，一起去旅行，一起體驗所有美好的事情。'",
        "gal_map_text_203100553=真的嗎？'",
        "gal_map_text_203100554=那我們以後可以一起存錢，先去海邊旅行，我一直想去看海。' 卡洛菲斯的語氣裡滿是期待，臉頰泛紅。",
        "gal_map_text_203100555=這張星辰牌代表著希望，也代表著我們今天的相遇。'",
        "gal_map_text_203100556=你笑著說，'希望它能像占卜師說的那樣，給你帶來好運，也能讓你想起，有一個人一直在意你。'",
        "gal_map_text_203100557=謝謝你。我會好好收藏它的。'",
        "gal_map_text_203100558=每次看到它，我都會想起今天的約會，想起你對我說的話。'",
        "gal_map_text_203100559=兩人拿著 '星辰牌'，聊得不亦樂乎，從牌意聊到未來，從約會聊到生活。卡洛菲斯的話越來越多，眼神裡滿是期待與歡喜，再也沒有一開始的強勢與疏離。",
        "gal_map_text_203100560=室內檀香依舊繚繞，暖黃燈光映在兩人臉上，氛圍甜蜜又溫馨。走出塔羅占卜小屋時，卡洛菲斯緊緊握著你送的 '星辰牌'，另一隻手不自覺地挽住了你的胳膊，彼此的心意在歡聲笑語中悄然升溫，曖昧徹底轉化為甜蜜的愛戀。",
        "gal_map_text_203100561=小意外過後，約會的氛圍愈發鬆弛愜意。專屬目的地的獨特魅力漸漸展露，而你們之間的互動也從最初的試探，變得更加自然親密。",
        "gal_map_text_203100562=每一個眼神交匯，每一次不經意的觸碰，都在悄悄拉近距離，讓曖昧的情愫在空氣中慢慢發酵。",
        "gal_map_text_203100563=臺上歌手換了一首深情的民謠，沙啞的嗓音伴著吉他旋律，唱著 '相遇是猝不及防的驚喜，陪伴是細水長流的溫柔'。",
        "gal_map_text_203100564=台下觀眾漸漸安靜下來，暖黃的燭光映著每個人的臉龐，空氣中彌漫著溫柔的情愫。卡洛菲斯托著下巴，眼神專注地看著舞臺，手指跟著旋律輕輕敲擊桌沿，嘴角帶著淺淺的笑意。",
        "gal_map_text_203100565=歌手唱到副歌時，卡洛菲斯不自覺地跟著輕聲哼唱，聲音柔軟，與平日裡的火辣截然不同。",
        "gal_map_text_203100566=卡洛菲斯唱到 '你是藏在我心底的溫柔' 時，轉頭看了你一眼，眼神裡帶著一絲羞澀，又快速轉回頭，臉頰微微泛紅。",
        "gal_map_text_203100567=沒想到你唱歌這麼好聽。' 你輕聲說，生怕打擾到卡洛菲斯和周圍的氛圍，'這首歌的歌詞，好像就是在說我們。'",
        "gal_map_text_203100568=你別取笑我了。' 卡洛菲斯嗔怪地瞪你一眼，聲音卻很輕。",
        "gal_map_text_203100569=不過…… 這首歌確實很戳人。尤其是那句‘相遇是猝不及防的驚喜’，和我遇見你時的感覺一樣。'",
        "gal_map_text_203100570=曲的氛圍為情感表達創造了絕佳契機，需要用貼合歌詞意境的互動，回應卡洛菲斯的共鳴，既不突兀又能傳遞心意，貼合卡洛菲斯 '害羞卻坦誠' 的狀態。",
        "gal_map_text_203100571=借歌表心意",
        "gal_map_text_203100572=跟著旋律輕和",
        "gal_map_text_203100573=靜靜傾聽陪伴",
        "gal_map_text_203100574=對我來說，你才是最大的驚喜。'",
        "gal_map_text_203100575=卡洛菲斯臉頰爆紅，卻故意板起臉，身體卻不自覺地向你靠近。",
        "gal_map_text_203100576=不過…… 我也覺得，遇到你是我今年最幸運的事。'",
        "gal_map_text_203100577=卡洛菲斯深吸一口氣，眼神堅定地看著你主動握住你的手，指尖輕輕用力。",
        "gal_map_text_203100578=我也是。遇見你之後，我的生活好像變得更有意思了。'",
        "gal_map_text_203100579=卡洛菲斯眼睛裡閃著星星，身體幾乎靠在你身上。卡洛菲斯的手緊緊抱著你的胳膊。",
        "gal_map_text_203100580=我也是！自從遇見你，每天都很開心，連工作都有動力了。'",
        "gal_map_text_203100581=卡洛菲斯聲音軟糯，眼眶微紅。撲進你懷裡，緊緊抱住你，捨不得鬆開。",
        "gal_map_text_203100582=謝謝你……我從來沒有被人這麼在乎過。有你在，我真的很幸福。'",
        "gal_map_text_203100583=我們一起跟著唱吧，很有感覺。'",
        "gal_map_text_203100584=卡洛菲斯笑著說，聲音放輕，跟著旋律輕輕哼唱。",
        "gal_map_text_203100585=這樣的感覺真好，好像整個世界只剩下我們和這首歌。'",
        "gal_map_text_203100586=卡洛菲斯客觀說，卻主動湊近你，壓低聲音跟著唱。唱到副歌時，卡洛菲斯的手輕輕碰了碰你的手。",
        "gal_map_text_203100587=歌詞寫得很真實，我們的相遇確實很奇妙。'",
        "gal_map_text_203100588=卡洛菲斯聲音帶著點小雀躍，跟著旋律輕輕唱起來。",
        "gal_map_text_203100589=和你一起唱歌，感覺這首歌更有意義了。'",
        "gal_map_text_203100590=卡洛菲斯眼眶微紅，跟著旋律哼唱頭輕輕靠在你的肩膀上。",
        "gal_map_text_203100591=和喜歡的人一起唱喜歡的歌，這是我能想到的最幸福的事。' 卡洛菲斯的頭輕輕靠在你的肩膀上。",
        "gal_map_text_203100592=不打擾你，聽你唱歌就很美好。'",
        "gal_map_text_203100593=卡洛菲斯拍了拍你的肩膀，笑著說。",
        "gal_map_text_203100594=不過你也不能只聽我唱，下次要單獨唱給我一個人聽。'",
        "gal_map_text_203100595=卡洛菲斯眼睛裡閃著期待的光芒。",
        "gal_map_text_203100596=我要把我喜歡的歌都唱給你聽！以後我們可以一起去 KTV，我唱給你聽個夠！'",
        "gal_map_text_203100597=卡洛菲斯輕輕應了一聲，繼續跟著旋律哼唱。",
        "gal_map_text_203100598=你願意聽，我就唱給你聽。' 卡洛菲斯的手指悄悄向你靠近，幾乎碰到你的手。",
        "gal_map_text_203100599=卡洛菲斯語氣平淡，卻調整了坐姿，雖然話少，眼神裡卻帶著溫柔。。",
        "gal_map_text_203100600=讓你能更清楚地聽到卡洛菲斯唱歌，'不過…… 你的耳朵還算有點眼光。'",
        "gal_map_text_203100601=我說的是真心話。' 你反握卡洛菲斯的手，眼神溫柔地看著卡洛菲斯。",
        "gal_map_text_203100602=遇見你之前，我的生活很平淡，每天都是工作、回家兩點一線。但遇見你之後，我開始期待每一天的到來，期待和你見面、聊天、約會。'",
        "gal_map_text_203100603=卡洛菲斯眼眶泛紅，眼淚忍不住掉了下來。",
        "gal_map_text_203100604=你要是敢騙我，我饒不了你！'",
        "gal_map_text_203100605=是啊，這樣的感覺真的很好。'",
        "gal_map_text_203100606=和你一起做什麼都很有意義，不管是唱歌、約會，還是只是靜靜地待在一起。'",
        "gal_map_text_203100607=嗯。'",
        "gal_map_text_203100608=我也是。以前我覺得一個人挺好，但和你在一起之後，我發現有人陪伴的感覺更美好。'",
        "gal_map_text_203100609=真的，你唱歌的聲音很溫柔，很好聽。'",
        "gal_map_text_203100610=能這樣聽你唱歌，看著你，對我來說就是最幸福的事。'",
        "gal_map_text_203100611=卡洛菲斯臉頰微紅，嘴角露出淺淺的笑意。",
        "gal_map_text_203100612=其實有你在旁邊聽我唱歌，我也很開心。以後有機會，我唱更多歌給你聽。'",
        "gal_map_text_203100613=歌曲漸漸進入尾聲，兩人的歌聲交織在一起，溫柔而甜蜜。卡洛菲斯靠在你的肩膀上，閉著眼睛，臉上洋溢著幸福的笑容。",
        "gal_map_text_203100614=歌聲結束時，台下響起熱烈的掌聲，卡洛菲斯睜開眼，轉頭看你，眼神裡滿是溫柔與歡喜。暖黃的燭光、溫柔的旋律與彼此的心意交織，讓氛圍愈發甜蜜。",
        "gal_map_text_203100615=小意外過後，約會的氛圍愈發鬆弛愜意。專屬目的地的獨特魅力漸漸展露，而你們之間的互動也從最初的試探，變得更加自然親密。",
        "gal_map_text_203100616=每一個眼神交匯，每一次不經意的觸碰，都在悄悄拉近距離，讓曖昧的情愫在空氣中慢慢發酵。",
        "gal_map_text_203100617=歌手唱完民謠，笑著對台下說：'接下來這首歌，想邀請一對情侶上臺合唱，有沒有願意的？'",
        "gal_map_text_203100618=台下立刻響起起哄聲，不少人轉頭看向你們，因為剛才的互動，你們早已成為周圍人眼中的 '甜蜜情侶'。卡洛菲斯臉頰泛紅，眼神裡滿是期待，卻又帶著一絲羞澀，悄悄拉了拉你的衣袖。",
        "gal_map_text_203100619=歌手注意到了你們，笑著指向你們：'那邊的情侶看起來很般配，要不要上來試試？這首歌很適合情侶合唱，會有小禮物哦！'",
        "gal_map_text_203100620=周圍的人跟著起哄，'上去啊！''很般配的樣子！' 卡洛菲斯的臉更紅了，轉頭看你，眼神裡滿是詢問。",
        "gal_map_text_203100621=要不要上去試試？'",
        "gal_map_text_203100622=如果你不想，我們就不上去，不用在意別人。'",
        "gal_map_text_203100623=我…… 我有點怕。'",
        "gal_map_text_203100624=但又覺得很有意思。而且…… 那個小禮物看起來不錯，好像是定制的情侶鑰匙扣。'",
        "gal_map_text_203100625=上臺合唱是情感升溫的 '催化劑'，既可以滿足卡洛菲斯的期待，又能讓互動更有紀念意義。需要用堅定而溫柔的回應，給卡洛菲斯勇氣，貼合卡洛菲斯 '害羞卻想嘗試' 的性格。",
        "gal_map_text_203100626=主動牽手上臺",
        "gal_map_text_203100627=詢問歌曲再決定",
        "gal_map_text_203100628=尊重卡洛菲斯的選擇",
        "gal_map_text_203100629=有我在，不用怕，我們一起上去。'",
        "gal_map_text_203100630=卡洛菲斯眼睛亮了起來，卻故意猶豫了一下。手卻緊緊握住你的手，跟著你起身。",
        "gal_map_text_203100631=好吧，既然你都這麼說了，我就陪你上去試試。不過要是唱砸了，你可不許笑我！'",
        "gal_map_text_203100632=卡洛菲斯深吸一口氣，眼神堅定。主動挽住你的胳膊，跟著你走向舞臺。",
        "gal_map_text_203100633=一起上去。不管唱得好不好，都是一次特別的經歷。'",
        "gal_map_text_203100634=卡洛菲斯興奮地跟著你起身，緊緊抱住你的胳膊。",
        "gal_map_text_203100635=有你在，我就不怕了。我們一定要好好唱，拿到那個情侶鑰匙扣！'",
        "gal_map_text_203100636=卡洛菲斯跟著你走向舞臺，身體微微靠向你。",
        "gal_map_text_203100637=謝謝你，我一個人肯定不敢上去，但有你陪著，我就有勇氣了。'",
        "gal_map_text_203100638=先問問是什麼歌，要是會唱就上去。'",
        "gal_map_text_203100639=卡洛菲斯笑著說，向歌手喊道。得到 '小幸運' 的答案後，卡洛菲斯轉頭看你，眼睛亮了起來。",
        "gal_map_text_203100640=我會唱！我們上去吧！'",
        "gal_map_text_203100641=卡洛菲斯聽到歌曲名後點點頭。主動牽起你的手。",
        "gal_map_text_203100642=這首歌難度不大，我們應該能唱好。上去試試吧，還能拿到紀念禮物。' 卡洛菲斯主動牽起你的手。",
        "gal_map_text_203100643=哇！是《小幸運》！我超喜歡這首歌！' 卡洛菲斯興奮地跳了起來。",
        "gal_map_text_203100644=我們上去吧！這首歌很適合我們，一定要好好唱！' 卡洛菲斯拉著你的手，迫不及待地想上臺。",
        "gal_map_text_203100645=是《小幸運》！' 卡洛菲斯眼眶微紅。",
        "gal_map_text_203100646=這首歌是我最喜歡的歌，每次聽都會想起很多事。我們上去唱吧，把它唱給彼此聽。'",
        "gal_map_text_203100647=不想去也沒關係，我都聽你的。'",
        "gal_map_text_203100648=卡洛菲斯眼神裡滿是期待。",
        "gal_map_text_203100649=那個情侶鑰匙扣很可愛，我們可以一起用。而且和你一起上臺唱歌，肯定很有意思。'",
        "gal_map_text_203100650=卡洛菲斯興奮地說，拉著你的手就要起身。",
        "gal_map_text_203100651=我們上去吧上去吧！不管唱得好不好，開心最重要！而且還能拿到禮物，多好啊！'",
        "gal_map_text_203100652=卡洛菲斯語氣平淡，卻悄悄松了口氣。手指輕輕勾了勾你的袖口。",
        "gal_map_text_203100653=如果你想去，我們就去；如果你不想，我們就不去。'",
        "gal_map_text_203100654=卡洛菲斯輕輕應了一聲。雖然語氣平淡，卻主動起身，示意你一起上去。",
        "gal_map_text_203100655=不過…… 那個鑰匙扣確實挺好看的。'",
        "gal_map_text_203100656=別害怕，有我在身邊，不管唱得怎麼樣，都是最特別的回憶。'",
        "gal_map_text_203100657=而且我相信，我們一起唱，一定能唱得很好。' 你牽著卡洛菲斯走向舞臺，眼神堅定。",
        "gal_map_text_203100658=卡洛菲斯重重點頭，眼神裡充滿了勇氣。",
        "gal_map_text_203100659=有你在，我什麼都不怕。我們一定要好好唱，拿到那個情侶鑰匙扣，作為我們今天的紀念。'",
        "gal_map_text_203100660=太好了！我也很喜歡這首歌。'",
        "gal_map_text_203100661=我們一起唱，把它唱給彼此聽。不管好不好聽，都是我們的小幸運。'",
        "gal_map_text_203100662=卡洛菲斯開心的點點頭，笑容燦爛。手緊緊握著你的手，充滿了期待。",
        "gal_map_text_203100663=我們一定要好好唱，讓所有人都知道，我們是最般配的情侶！'",
        "gal_map_text_203100664=那我們上去試試吧。'",
        "gal_map_text_203100665=就當是一次特別的體驗，而且還能拿到情侶鑰匙扣，很有紀念意義。'",
        "gal_map_text_203100666=卡洛菲斯臉頰微紅，嘴角露出淺淺的笑意。",
        "gal_map_text_203100667=好。有你陪著，我就不怕了。我們一起加油！'",
        "gal_map_text_203100668=兩人牽手走上舞臺，接過歌手遞來的話筒。前奏響起，你們對視一眼，默契地一起唱了起來。卡洛菲斯的聲音溫柔，你的聲音沉穩，交織在一起格外動聽。",
        "gal_map_text_203100669=台下的觀眾跟著鼓掌、合唱，氛圍熱烈又甜蜜。唱到副歌 '原來你是我最想留住的幸運' 時，你們緊緊握住彼此的手，眼神裡滿是愛意。",
        "gal_map_text_203100670=歌曲結束後，歌手送上定制的情侶鑰匙扣，笑著說 '祝你們永遠幸福'。走下臺時，卡洛菲斯緊緊握著鑰匙扣，另一隻手挽著你的胳膊，臉上洋溢著幸福的笑容，彼此的心意在歌聲與掌聲中徹底確認。",
        "gal_map_text_203100671=小意外過後，約會的氛圍愈發鬆弛愜意。專屬目的地的獨特魅力漸漸展露，而你們之間的互動也從最初的試探，變得更加自然親密。",
        "gal_map_text_203100672=每一個眼神交匯，每一次不經意的觸碰，都在悄悄拉近距離，讓曖昧的情愫在空氣中慢慢發酵。",
        "gal_map_text_203100673=民謠結束後，樂隊換成了更有活力的流行樂，鼓手敲起歡快的節奏，吉他手彈奏著激昂的旋律，台下的觀眾們跟著節奏點頭、搖擺，氛圍熱烈又歡快。",
        "gal_map_text_203100674=卡洛菲斯也被氛圍感染，跟著節奏輕輕晃動身體，臉上滿是興奮的笑容，完全沒有了一開始的拘謹。",
        "gal_map_text_203100675=主唱拿著話筒，笑著對台下說：'接下來這首歌，需要一位勇敢的女生上臺和我一起互動，有沒有願意的？'",
        "gal_map_text_203100676=台下立刻響起熱烈的歡呼聲，不少女生舉手。卡洛菲斯也有些心動，眼神裡滿是期待，卻又有些猶豫，沒有舉手。",
        "gal_map_text_203100677=看起來很有意思，要不要上去試試？'",
        "gal_map_text_203100678=你要是想去，我支持你；要是不想，我們就在台下跟著嗨。'",
        "gal_map_text_203100679=我…… 我有點想，但又怕自己表現不好。'",
        "gal_map_text_203100680=而且上臺和主唱互動，好像很有挑戰性，我從來沒有試過。'",
        "gal_map_text_203100681=熱烈的氛圍適合鼓勵卡洛菲斯突破自我，需要用支援且有安全感的回應，給卡洛菲斯勇氣，同時傳遞 '不管你做什麼我都支持你' 的心意，貼合卡洛菲斯 '想嘗試卻缺乏勇氣' 的性格。",
        "gal_map_text_203100682=鼓勵上臺支持",
        "gal_map_text_203100683=提出一起互動",
        "gal_map_text_203100684=尊重選擇陪伴",
        "gal_map_text_203100685=你這麼優秀，肯定能表現得很好，我在台下為你加油。'",
        "gal_map_text_203100686=卡洛菲斯眼睛亮了起來，咬了咬牙",
        "gal_map_text_203100687=你可一定要在台下為我加油啊！要是我表現不好，你可不許笑我！'",
        "gal_map_text_203100688=卡洛菲斯深吸一口氣，眼神堅定。轉身走向舞臺，走了兩步又回頭看你，嘴角露出笑容。",
        "gal_map_text_203100689=既然你這麼相信我，我就試試。'",
        "gal_map_text_203100690=卡洛菲斯興奮地舉起手，朝著主唱喊道。",
        "gal_map_text_203100691=等我回來，一定要誇我表現得好！'",
        "gal_map_text_203100692=卡洛菲斯聲音軟糯，緊緊拉著你的手。另一隻手舉起，被主唱注意到，走向舞臺時還頻頻回頭看你。",
        "gal_map_text_203100693=有你為我加油，我就有勇氣了。'",
        "gal_map_text_203100694=要是主唱同意，我陪你一起上去，這樣你就不怕了。'",
        "gal_map_text_203100695=卡洛菲斯眼睛亮了起來，看著你。 手緊緊握著你的手。",
        "gal_map_text_203100696=要是可以的話，我就敢上去了。有你在身邊，我就不害怕了。'",
        "gal_map_text_203100697=卡洛菲斯向主唱詢問，得到肯定答覆後，卡洛菲斯轉頭看你，眼神裡滿是期待。",
        "gal_map_text_203100698=我們一起上去吧。'",
        "gal_map_text_203100699=卡洛菲斯興奮地拉著你的手，眼睛裡閃著星星。",
        "gal_map_text_203100700=有你陪著，我就什麼都不怕了！我們一起上去，肯定會很有意思！'",
        "gal_map_text_203100701=卡洛菲斯眼眶微紅，緊緊抱著你的胳膊。",
        "gal_map_text_203100702=只要有你在身邊，我就有勇氣嘗試一切。我們一起上去，把這個互動變成我們的專屬回憶吧！'",
        "gal_map_text_203100703=不想去也沒關係，我們在台下跟著節奏嗨也很開心。'",
        "gal_map_text_203100704=卡洛菲斯跟著旋律輕輕晃動身體，笑容燦爛。",
        "gal_map_text_203100705=但又有點怕。不過沒關係，我們在台下跟著節奏嗨，也一樣開心！'",
        "gal_map_text_203100706=卡洛菲斯拉著你的手，跟著節奏搖擺。",
        "gal_map_text_203100707=雖然有點想上去，但有你陪著在台下嗨，也超開心的！'",
        "gal_map_text_203100708=卡洛菲斯的手指悄悄勾了勾你的手指，跟著旋律輕輕晃動。",
        "gal_map_text_203100709=這樣也能感受到氛圍，不用緊張。'",
        "gal_map_text_203100710=卡洛菲斯輕輕應了一聲，卻調整了坐姿，讓身體更貼近你。",
        "gal_map_text_203100711=台下也能嗨，不用特意上臺。'",
        "gal_map_text_203100712=我相信你，你這麼優秀，不管做什麼都能做好。'",
        "gal_map_text_203100713=我會在台下一直看著你，為你加油。不管結果怎麼樣，你在我心裡都是最棒的。' 你緊緊握了握卡洛菲斯的手，給卡洛菲斯最後的鼓勵。",
        "gal_map_text_203100714=卡洛菲斯重重點頭，眼神裡充滿了勇氣。",
        "gal_map_text_203100715=我一定不會讓你失望的！等我下來，我們一起去吃夜宵，我要好好慶祝一下！'",
        "gal_map_text_203100716=走吧，我們一起上去，有我在，不用怕。'",
        "gal_map_text_203100717=我可是很有信心拿下冠軍，把禮物拿下送給你。'",
        "gal_map_text_203100718=太好了！'",
        "gal_map_text_203100719=有你陪著，我就什麼都不怕了。我們一起加油，一定要把互動做好，讓所有人都羡慕我們！'",
        "gal_map_text_203100720=好啊！'",
        "gal_map_text_203100721=在台下跟著嗨也很開心。我們一起跟著唱，一起搖擺，享受當下的氛圍。'",
        "gal_map_text_203100722=好！我們一起嗨起來！讓這個夜晚變得更難忘！'",
        "gal_map_text_203100723=卡洛菲斯跟著節奏搖擺身體，手緊緊握著你的手，臉上洋溢著幸福的笑容。",
        "gal_map_text_203100724=互動落幕，掌聲未散。卡洛菲斯挽著你的胳膊走下臺，臉頰泛著紅暈，指尖摩挲著樂隊紀念徽章。",
        "gal_map_text_203100725=尾曲旋律溫柔流淌，你們並肩慢走，掌心相觸的溫度伴著音樂餘韻，心意悄悄靠近，不願打破這份繾綣。",
        "gal_map_text_203100726=從觀景台下來，你們意猶未盡地在雲境的霓虹中漫步。不知不覺，走到了中央那座巨大的、裝飾著璀璨燈帶的空中秋千下。",
        "gal_map_text_203100727=它緩緩搖晃，每個座位都像一顆移動的星辰，燈帶隨著秋千擺動流淌出夢幻的光影，周圍零星有幾對情侶在排隊等候，輕聲說著悄悄話。",
        "gal_map_text_203100728=卡洛菲斯仰頭看著空中秋千，眼睛裡閃著星星，腳步不自覺地停了下來。",
        "gal_map_text_203100729=剛才在咖啡館的靜謐互動讓卡洛菲斯徹底放鬆，此刻面對浪漫的秋千，卡洛菲斯臉上露出了少女般的憧憬，手指輕輕拉了拉你的衣袖。",
        "gal_map_text_203100730=確實很特別，像在星空中蕩秋千。'",
        "gal_map_text_203100731=要不要排隊試試？看起來很有意思。'",
        "gal_map_text_203100732=好啊！不過…… 好像要兩個人一起坐才行，你願意陪我嗎？'",
        "gal_map_text_203100733=空中秋千的浪漫氛圍為心意傳遞創造了絕佳契機，無需激進表達，只需用溫柔的互動回應卡洛菲斯的期待，讓彼此的情愫在星光照影中進一步沉澱。不同性格的回應，能讓卡洛菲斯感受到你多面的心意。",
        "gal_map_text_203100734=向卡洛菲斯提出牽手乘坐",
        "gal_map_text_203100735=檢查秋千確保安全",
        "gal_map_text_203100736=一起和卡洛菲斯排隊體驗秋千",
        "gal_map_text_203100737=拍一張秋千合照",
        "gal_map_text_203100738=先去給卡洛菲斯占位置",
        "gal_map_text_203100739=當然願意，能和你一起坐星空秋千很幸運，牽著我的手，我護著你，不怕晃。'",
        "gal_map_text_203100740=卡洛菲斯臉頰泛紅，卻緊緊回握你的手腳步輕快地跟著你往前走，語氣帶著點小強勢。",
        "gal_map_text_203100741=算你識相！不過別以為牽個手就能偷懶，秋千晃的時候可得抓穩我。'",
        "gal_map_text_203100742=卡洛菲斯主動握緊你的手，指尖用力。",
        "gal_map_text_203100743=不過要是秋千不好玩，我可會直接吐槽的。'",
        "gal_map_text_203100744=卡洛菲斯興奮地靠向你，手緊緊攥著你的手指。",
        "gal_map_text_203100745=有你牽著我就不怕了，我一直想坐這種高空秋千，終於有人陪我了。'",
        "gal_map_text_203100746=卡洛菲斯聲音軟糯，身體幾乎貼在你身邊。",
        "gal_map_text_203100747=有你在我就安心了，我有點怕高，牽著你就不怕晃了。'",
        "gal_map_text_203100748=你看秋千安全帶是雙人設計，我先幫你調整好角度，我們再坐，既安全又舒服。'",
        "gal_map_text_203100749=卡洛菲斯點點頭，主動配合你查看秋千設施。",
        "gal_map_text_203100750=這樣既安全又不會影響體驗，很合理。'",
        "gal_map_text_203100751=卡洛菲斯客觀提醒，眼神專注。",
        "gal_map_text_203100752=雙人安全帶的承重和貼合度很重要，你調整的時候注意卡扣位置，確保鎖死，避免晃動時鬆開。'",
        "gal_map_text_203100753=卡洛菲斯看到你細心的樣子，臉上露出滿意的笑容。",
        "gal_map_text_203100754=被你這麼照顧，感覺好溫暖，比秋千本身還讓人期待。'",
        "gal_map_text_203100755=卡洛菲斯在身後看著你檢查的秋千也主動上去配合你檢查。",
        "gal_map_text_203100756=我都沒想到這麼多細節，有你在身邊，真的太安心了，感覺什麼都不用怕。'",
        "gal_map_text_203100757=你的眼神都亮了，肯定很想試，我陪你排隊，人多我擋著，不讓別人擠到你。'",
        "gal_map_text_203100758=卡洛菲斯興奮地拉著你往隊伍裡走。",
        "gal_map_text_203100759=我早就想坐了，人多你可得護好我，別讓別人擠到我。'",
        "gal_map_text_203100760=卡洛菲斯跳了起來，眼神發亮。",
        "gal_map_text_203100761=我要坐最外面的位置，看得更遠！排隊的時候你可要一直陪著我，不許走開。'",
        "gal_map_text_203100762=卡洛菲斯語氣平淡，卻悄悄往你身邊靠了靠。",
        "gal_map_text_203100763=人多的時候確實麻煩，你擋著點也好。'",
        "gal_map_text_203100764=卡洛菲斯輕輕應了一聲，卻沒有鬆開你的衣袖。",
        "gal_map_text_203100765=快點排隊，別浪費時間。'",
        "gal_map_text_203100766=坐完秋千，我們在霓虹下拍張合照，我設成手機壁紙，以後每次看都能想起今天的星空時刻。'",
        "gal_map_text_203100767=卡洛菲斯挑眉看著你。主動拿出手機讓你拍照。",
        "gal_map_text_203100768=我要站在光好的地方，要是拍不好，我可會讓你重拍的。'",
        "gal_map_text_203100769=卡洛菲斯聽到你的提議，快速拿出手機示意你拍照。",
        "gal_map_text_203100770=等下我選角度，你配合我就行，拍完發我一份。'",
        "gal_map_text_203100771=卡洛菲斯很快的答應下來，臉上露出開心的表情拿出手機讓你拍照。",
        "gal_map_text_203100772=我要靠在你肩膀上拍，還要比愛心，拍好後要設成聊天背景。'",
        "gal_map_text_203100773=卡洛菲斯一邊拿著你的手，一邊拿出手機臉上顯示期待的表情。",
        "gal_map_text_203100774=這樣以後想你的時候，就能看看照片，好像你就在我身邊一樣。'",
        "gal_map_text_203100775=排隊人不多，我先去占位置，你在這兒等我，別亂跑，我很快回來找你，放心。'",
        "gal_map_text_203100776=卡洛菲斯雙手抱胸，卻忍不住叮囑",
        "gal_map_text_203100777=知道了，你快去快回，我在這兒等你，不會亂跑的。別排太久，我可沒耐心等。'",
        "gal_map_text_203100778=卡洛菲斯擺擺手。",
        "gal_map_text_203100779=我自己在這兒等著，你不用著急，注意安全。'",
        "gal_map_text_203100780=卡洛菲斯乖巧地點頭，目光一直跟著你，生怕你走遠。",
        "gal_map_text_203100781=好，我就在這兒等你，你快點回來。'",
        "gal_map_text_203100782=卡洛菲斯聲音帶著點委屈。",
        "gal_map_text_203100783=你可一定要快點回來啊！''我一個人在這裡會害怕，你別讓我等太久。'",
        "gal_map_text_203100784=放心，我會抓得牢牢的，秋千晃的時候你要是怕，就靠在我肩膀上。排隊人有點擠，我護著你，不讓別人碰到你。'",
        "gal_map_text_203100785=誰會怕啊！不過…… 靠在你肩膀上也可以。'",
        "gal_map_text_203100786=以前都是我自己扛事，現在被人護著的感覺，還挺特別的。'",
        "gal_map_text_203100787=好了，你坐進來試試，這個角度剛好，不會勒到，也能坐穩。'",
        "gal_map_text_203100788=你扶著卡洛菲斯的胳膊，'放心，卡扣都鎖死了，絕對安全。'",
        "gal_map_text_203100789=確實挺舒服的，謝謝你這麼細心。'",
        "gal_map_text_203100790=以前和朋友出來，從來沒人會注意這些細節，你真的很不一樣。'",
        "gal_map_text_203100791=你站在這裡，我來排隊，有位置了就喊你。這裡人多，我擋著，不會有人擠到你。'",
        "gal_map_text_203100792=好，你快點啊。' 卡洛菲斯看著空中晃動的秋千，嘴角帶笑。",
        "gal_map_text_203100793=我已經開始期待了，等下我們要蕩得高一點，看得更遠。'",
        "gal_map_text_203100794=我已經看好了，那邊的霓虹燈帶當背景最好看，等下我們坐完秋千就去拍。你想擺什麼姿勢都可以，我都配合你。'",
        "gal_map_text_203100795=哇！這個角度真不錯！我要靠在你肩膀上，比個小愛心，還要笑得多一點。'",
        "gal_map_text_203100796=拍好後要發朋友圈，讓大家看看我們的星空秋千之約。'",
        "gal_map_text_203100797=我排在第三個，很快就到我們了，你別亂跑，就在原地等我，有情況隨時喊我。'",
        "gal_map_text_203100798=知道啦！我就在這兒等你，不會亂跑的。'",
        "gal_map_text_203100799=你快點回來，我一個人有點無聊。'",
        "gal_map_text_203100800=你們一起坐上空中秋千，安全帶將兩人緊緊靠在一起。秋千緩緩升起、搖晃，腳下是璀璨的霓虹，身邊是彼此的溫度。",
        "gal_map_text_203100801=卡洛菲斯下意識地靠在你的肩膀上，嘴角帶著滿足的笑意。",
        "gal_map_text_203100802=風輕輕吹過，帶著卡洛菲斯髮絲的清香，兩人的手一直緊緊握著，心意在星光照影中悄然沉澱。",
        "gal_map_text_203100803=離開占卜屋後，你們正沿著掛滿暖燈的小巷漫步，忽然被一陣悠揚的吉他聲和清澈的歌聲吸引。",
        "gal_map_text_203100804=巷口的路燈下，一位抱著木吉他的街頭藝人正在表演，面前放著打開的琴盒，裡面散落著幾枚硬幣，周圍稀疏地圍著幾個聽眾。",
        "gal_map_text_203100805=唱著一首旋律輕快又帶著些許浪漫惆悵的民謠，歌詞裡滿是相遇與心動的細膩情愫。",
        "gal_map_text_203100806=卡洛菲斯停下腳步，眼神瞬間被藝人的歌聲吸引，剛才占卜時的羞澀一掃而空。",
        "gal_map_text_203100807=卡洛菲斯專注地看著藝人撥動琴弦的手指，跟著旋律輕輕晃動身體，頭髮被晚風拂起，在暖燈光下泛著柔和的光澤。",
        "gal_map_text_203100808=當唱到副歌 '相遇是猝不及防的溫柔，陪伴是細水長流的守候' 時，藝人的目光掃過人群，忽然落在了你們身上，嘴角帶著默契的笑意，歌聲也愈發溫柔。",
        "gal_map_text_203100809=確實很動人，尤其是副歌部分，歌詞和旋律都很有畫面感。'",
        "gal_map_text_203100810=沒想到在小巷裡還能遇到這麼有才華的藝人，這首歌唱到心裡去了。'",
        "gal_map_text_203100811=尤其是藝人看向我們的時候，感覺這首歌好像是專門唱給我們聽的。",
        "gal_map_text_203100812=卡洛菲斯頓了頓，臉頰微紅。",
        "gal_map_text_203100813=街頭民謠的浪漫氛圍讓彼此的距離進一步拉近，藝人的目光停留更讓心動悄然發酵。",
        "gal_map_text_203100814=此刻的互動既可以呼應歌曲意境傳遞心意，也能借著氛圍拉近距離，不同性格的回應能讓這場意外的街頭表演，成為你們情感升溫的獨特契機。",
        "gal_map_text_203100815=借歌喻情表心意",
        "gal_map_text_203100816=邀請卡洛菲斯合唱",
        "gal_map_text_203100817=打賞藝人",
        "gal_map_text_203100818=幫卡洛菲斯擋風",
        "gal_map_text_203100819=溫柔陪伴不打擾",
        "gal_map_text_203100820=歌詞說的沒錯，遇見你也是我的猝不及防，我想把這份溫柔變成細水長流的陪伴。'",
        "gal_map_text_203100821=卡洛菲斯臉頰瞬間泛紅，眼神躲閃了一下又迎上你",
        "gal_map_text_203100822=不過…… 我也覺得，遇見你之後，很多平凡的瞬間都變得特別了。'",
        "gal_map_text_203100823=你倒是直接。' 卡洛菲斯深吸一口氣，眼神堅定地看著你。",
        "gal_map_text_203100824=既然你這麼說，我也不繞彎子了，我對你也有好感，想試試把這份心動延續下去。'",
        "gal_map_text_203100825=哇！你說得好浪漫啊！'",
        "gal_map_text_203100826=我也是！遇見你之後，每天都很開心，這首歌簡直就是為我們寫的。'",
        "gal_map_text_203100827=卡洛菲斯聲音軟糯，眼眶微紅。緊緊拉著你的衣袖，捨不得鬆開。",
        "gal_map_text_203100828=我從來沒有被人這麼直白地表達過，這首歌和你說的話，都讓我好感動。有你在身邊，我真的很幸福。'",
        "gal_map_text_203100829=我們點一首合唱的歌吧？就唱剛才那首副歌，讓藝人伴奏，一起把這份心動唱出來。'",
        "gal_map_text_203100830=卡洛菲斯興奮地舉手示意藝人。",
        "gal_map_text_203100831=能在演奏一邊剛剛的副歌嗎？，我們想嘗試一下合唱'。",
        "gal_map_text_203100832=卡洛菲斯拉著你的手往前湊了湊。",
        "gal_map_text_203100833=我早就想唱了，這首歌的副歌太戳人了！等下我們要看著彼此唱，讓所有人都知道我們的心動！' 興奮得跳了一下，眼神發亮。",
        "gal_map_text_203100834=卡洛菲斯語氣平淡，卻沒有拒絕。 臉頰微微泛紅，身體卻很誠實地做好準備。",
        "gal_map_text_203100835=不過偶爾體驗一次也不錯，就唱副歌部分，別太張揚。'",
        "gal_map_text_203100836=卡洛菲斯輕輕應了一聲，卻悄悄調整了站姿，讓自己能更清楚地聽到伴奏。",
        "gal_map_text_203100837=唱的時候小聲點，別影響其他人。'",
        "gal_map_text_203100838=我去給藝人打賞，順便問他這首歌的名字，以後每次聽到，就想起今晚的小巷、民謠和你。'",
        "gal_map_text_203100839=卡洛菲斯挑眉看著你。",
        "gal_map_text_203100840=打賞不用太多，意思一下就好。'",
        "gal_map_text_203100841=卡洛菲斯掏出錢包遞你幾張零錢。",
        "gal_map_text_203100842=順便問問能不能錄一段副歌，我想保存下來，以後想聽了隨時能聽。'",
        "gal_map_text_203100843=卡洛菲斯興奮地拉著你的手。 眼神裡滿是贊同，支持你的決定。",
        "gal_map_text_203100844=我也想知道這首歌的名字，以後要單曲迴圈！打賞多給一點吧，藝人唱得這麼好。'",
        "gal_map_text_203100845=卡洛菲斯緊緊拉著你的手，直到你轉身才鬆開。",
        "gal_map_text_203100846=快去快回，我在這裡等你，別讓我一個人。'",
        "gal_map_text_203100847=風有點大，我幫你擋著，你湊近點聽，藝人彈得越來越投入了，別錯過精彩部分。'",
        "gal_map_text_203100848=卡洛菲斯點點頭，主動往你身邊靠了靠。",
        "gal_map_text_203100849=這樣既能擋風，又能聽得更清楚，一舉兩得。'",
        "gal_map_text_203100850=卡洛菲斯語氣平淡，卻很配合地湊近你。",
        "gal_map_text_203100851=你擋在側風向，能有效減少風噪，這個位置很合理。'",
        "gal_map_text_203100852=卡洛菲斯臉頰泛紅，聲音柔軟。",
        "gal_map_text_203100853=被你擋著風，聽著這麼動人的歌，感覺好幸福。從來沒有人這麼細心地照顧我。'",
        "gal_map_text_203100854=身體微微靠在你身上，依賴感十足。",
        "gal_map_text_203100855=有你在身邊，不管什麼情況都覺得很安心。'",
        "gal_map_text_203100856=不打擾你聽歌，就站在旁邊陪著你，這種安靜分享同一首歌的感覺，真的很美好。'",
        "gal_map_text_203100857=卡洛菲斯笑著點頭，卻悄悄往你身邊靠了靠。享受當下的氛圍。",
        "gal_map_text_203100858=其實這樣安靜陪著也很好，能一起分享同一首歌，感覺心都貼得更近了。'",
        "gal_map_text_203100859=卡洛菲斯拉著你的手輕輕晃動。",
        "gal_map_text_203100860=我們可以跟著旋律一起輕輕哼唱，不用大聲，就我們兩個人能聽到，當成我們的小秘密。'",
        "gal_map_text_203100861=卡洛菲斯語氣平淡，專注地聽著歌。雖然話少，但能感受到卡洛菲斯的投入。",
        "gal_map_text_203100862=安靜的氛圍更能體會歌詞的意境，不用刻意找話題，也不會覺得尷尬。'",
        "gal_map_text_203100863=卡洛菲斯輕輕應了一聲，卻調整了坐姿，讓自己能更舒適地聽完整首歌。",
        "gal_map_text_203100864=這首歌確實不錯，值得認真聽。'",
        "gal_map_text_203100865=我說的是真心話。從占卜屋的坦誠到現在的街頭民謠，每一刻都讓我確定，我想和你一直走下去，把這份猝不及防的心動，變成細水長流的陪伴。'",
        "gal_map_text_203100866=你…… 你可別騙我！'",
        "gal_map_text_203100867=其實我也早就想對你說了，和你在一起的每一刻都很踏實，我也想把這份溫柔延續下去。'",
        "gal_map_text_203100868=沒問題！我們一起看著彼此唱，把心裡的感覺都唱出來。別緊張，有我陪著你，就算跑調也沒關係，重要的是這一刻的心意。'",
        "gal_map_text_203100869=嗯！有你在我就不怕了。等下我們要大聲唱，讓這首歌成為我們的專屬回憶。'",
        "gal_map_text_203100870=卡洛菲斯看著你，眼裡滿是期待與勇氣。",
        "gal_map_text_203100871=放心，一定問清楚歌名和歌手，還會錄一段副歌給你保存。'",
        "gal_map_text_203100872=你轉身走向藝人，又回頭叮囑，'你在這裡乖乖等我，別亂跑，我很快就回來。'",
        "gal_map_text_203100873=知道啦！你快去快回，別錯過後面的歌。記得錄清楚一點，我要設置成手機鈴聲。'",
        "gal_map_text_203100874=卡洛菲斯眼神一直跟著你，滿是期待。",
        "gal_map_text_203100875=這樣是不是聽得更清楚了？藝人的吉他彈得真好，歌詞也寫得很細膩，剛好唱出了我們的感覺。'",
        "gal_map_text_203100876=嗯，清楚多了，也不冷了。謝謝你這麼細心，被你照顧著的感覺真的很好。'",
        "gal_map_text_203100877=這首歌越聽越喜歡，尤其是和你一起聽。'",
        "gal_map_text_203100878=是啊，這種不用說話，安靜分享同一首歌的感覺真的很美好。不用刻意找話題，卻能感受到彼此的心意，這種默契很難得。'",
        "gal_map_text_203100879=嗯，我也這麼覺得。和你在一起，不管是熱鬧的互動還是安靜的陪伴，都讓我覺得很舒服、很安心。'",
        "gal_map_text_203100880=藝人唱完最後一首歌，周圍響起了稀疏的掌聲，你們也跟著鼓掌。卡洛菲斯看著藝人收拾吉他，眼神裡滿是不舍，嘴裡還輕輕哼著剛才的副歌旋律。",
        "gal_map_text_203100881=卡洛菲斯的手一直挽著你的胳膊，偶爾抬頭看你，眼神裡的溫柔與心動藏不住。這場意外的街頭民謠表演，像一根溫柔的紐帶，將你們的心意緊緊連在一起。",
        "gal_map_text_203100882=讓情愫在浪漫的旋律中徹底沉澱，為第五階段的升溫做好了完美鋪墊。",
        "gal_map_text_203100883=耳朵裡還殘留著音樂的餘韻，角落中一位戴著貝雷帽、氣質文藝的年輕畫師坐在畫架後，面前擺著一些人物速寫樣品 —— 有情侶相依的姿態，有朋友打鬧的瞬間，線條簡潔流暢，卻精准捕捉了人物的情緒與氛圍。",
        "gal_map_text_203100884=看到你們轉過來，他微笑著主動招呼：'兩位看起來很有默契，要不要畫一張速寫留作紀念？很快就能完成。",
        "gal_map_text_203100885=卡洛菲斯看著畫師筆下的速寫，眼睛裡滿是好奇，剛才 Livehouse 的熱烈氛圍還未褪去，此刻面對溫柔的速寫，卡洛菲斯臉上露出了柔和的笑容。",
        "gal_map_text_203100886=卡洛菲斯轉頭看你，眼神裡帶著詢問，手指輕輕拉了拉你的衣袖，帶著點期待。",
        "gal_map_text_203100887=好啊，我覺得挺有意義的。'",
        "gal_map_text_203100888=畫師的技術很好，能把瞬間的氛圍定格下來，留作紀念也不錯。'",
        "gal_map_text_203100889=卡洛菲斯立刻點頭，拉著你走到畫架前坐下。",
        "gal_map_text_203100890=那我們擺什麼姿勢好呢？要不要像樣品裡的情侶一樣，稍微靠近一點？'",
        "gal_map_text_203100891=速寫的定格瞬間為心意傳遞創造了溫柔的契機，靠近的姿勢讓彼此的距離進一步拉近。",
        "gal_map_text_203100892=不同性格的回應既能配合卡洛菲斯的期待，又能傳遞真誠的心意，讓情愫在筆墨間沉澱得更立體。",
        "gal_map_text_203100893=細節適配建議",
        "gal_map_text_203100894=配合畫師速寫",
        "gal_map_text_203100895=向畫師提出要兩張速寫畫",
        "gal_map_text_203100896=讓卡洛菲斯自然一些",
        "gal_map_text_203100897=主動牽手卡洛菲斯的手",
        "gal_map_text_203100898=我們自然一點就好，你靠在我肩膀上，我看著你，像平時一樣放鬆，這樣畫師能捕捉到最真實的我們。'",
        "gal_map_text_203100899=卡洛菲斯輕輕靠在你肩膀上。",
        "gal_map_text_203100900=這樣畫師能捕捉到最真實的我們，不會顯得刻意。'",
        "gal_map_text_203100901=卡洛菲斯調整好姿勢，頭微微靠在你的肩膀上。",
        "gal_map_text_203100902=我們保持這個姿勢，不要動，讓畫師好好畫。'",
        "gal_map_text_203100903=卡洛菲斯調整好姿勢，卡洛菲斯眼神帶有些許期待。",
        "gal_map_text_203100904=這樣拍出來肯定很溫柔，我很喜歡這種感覺，謝謝你為我著想。'",
        "gal_map_text_203100905=卡洛菲斯偷偷牽著你的手，調整好姿勢。",
        "gal_map_text_203100906=我從來沒有和別人這樣一起畫過速寫，這種感覺太美好了，我會永遠記住的。'",
        "gal_map_text_203100907=看你這麼好奇速寫，我們好好配合畫師，畫好後我幫你裝裱起來，當成珍貴的紀念，以後看到都能想起今天。'",
        "gal_map_text_203100908=卡洛菲斯興奮地坐好。",
        "gal_map_text_203100909=我們一定要好好配合畫師，畫好後裝裱起來，放在我的梳粧檯上，每天都能看到。'",
        "gal_map_text_203100910=太好了！我一直想擁有一幅屬於自己的速寫，今天終於能實現了！",
        "gal_map_text_203100911=畫好後我們還要拍張照，發朋友圈紀念一下。'",
        "gal_map_text_203100912=嗯，裝裱起來也可以。' 卡洛菲斯語氣平淡，卻坐得很端正。",
        "gal_map_text_203100913=不過別選太花哨的相框，簡單一點就好。'",
        "gal_map_text_203100914=卡洛菲斯輕輕應了一聲，卻沒有拒絕。",
        "gal_map_text_203100915=快點畫，畫完好走，別耽誤時間。'",
        "gal_map_text_203100916=畫好後我們一人一張，我要放在書桌前，每天看到它，就能想起今晚的 Livehouse 和街角的溫柔時光。'",
        "gal_map_text_203100917=卡洛菲斯挑眉看著你。",
        "gal_map_text_203100918=放書桌前可以，但要選我畫得好看的那張。一人一張公平合理，不過你要是敢弄丟，我可饒不了你。'",
        "gal_map_text_203100919=卡洛菲斯坐得很端正。",
        "gal_map_text_203100920=不過我要自己選相框，不用你操心，我知道自己喜歡什麼樣的。'",
        "gal_map_text_203100921=卡洛菲斯興奮地拉著你的手。",
        "gal_map_text_203100922=我要把速寫放在我的梳粧檯上，每天早上起床都能看到，想起今天的快樂時光。'",
        "gal_map_text_203100923=卡洛菲斯緊緊握著你的手。",
        "gal_map_text_203100924=這樣以後想你的時候，就能看看速寫，好像你就在我身邊一樣，太有意義了。'",
        "gal_map_text_203100925=你要是覺得靠得太近不自在，我們就稍微拉開一點距離，不用勉強自己，舒服最重要，不用在意別人怎麼看。'",
        "gal_map_text_203100926=卡洛菲斯搖搖頭。",
        "gal_map_text_203100927=不用拉開距離，這樣就很好。靠得近一點更自然，也不會顯得刻意，我覺得很舒服。'",
        "gal_map_text_203100928=卡洛菲斯調整好姿勢，距離卻偷偷做近了一些。",
        "gal_map_text_203100929=我們保持這個姿勢，讓畫師好好畫，不用在意其他。'",
        "gal_map_text_203100930=卡洛菲斯臉頰微紅，坐的位置逐漸拉近。",
        "gal_map_text_203100931=其實我挺喜歡這樣的距離，感覺很親密，也很安心，不會覺得不自在。'",
        "gal_map_text_203100932=卡洛菲斯眼眶微紅，將彼此的距離拉近。",
        "gal_map_text_203100933=我本來還有點不好意思，被你這麼一說，就放心多了，有你在身邊真的太好了。'",
        "gal_map_text_203100934=我們手牽著手坐，這樣既親密又自然，畫師畫出來也更有氛圍感，以後看到速寫，就想起今天的牽手約定。'",
        "gal_map_text_203100935=卡洛菲斯握緊你的手。",
        "gal_map_text_203100936=行，牽手就牽手，能讓速寫更有氛圍感。不過姿勢要自然，別太僵硬，影響畫師發揮。'",
        "gal_map_text_203100937=卡洛菲斯害羞地握住你的手。",
        "gal_map_text_203100938=牽手坐在一起感覺好親密，畫出來肯定很浪漫，謝謝你為我著想。'",
        "gal_map_text_203100939=卡洛菲斯興奮地握住你的手。",
        "gal_map_text_203100940=牽手坐在一起感覺好親密，畫出來肯定很浪漫，謝謝你為我著想。'",
        "gal_map_text_203100941=卡洛菲斯緊緊握著你的手。",
        "gal_map_text_203100942=有你牽著我，我就覺得很安心，一點都不緊張了，這樣能更好地配合畫師。'",
        "gal_map_text_203100943=不用緊張，自然一點就好，像平時我們聊天一樣，靠在我肩膀上很舒服，不用刻意僵硬。'",
        "gal_map_text_203100944=嗯，靠在你肩膀上確實很踏實。' 卡洛菲斯嘴角帶笑。",
        "gal_map_text_203100945=我從來沒有和別人一起畫過速寫，這種感覺很特別，希望畫師能把我們畫得好看一點。'",
        "gal_map_text_203100946=畫師的技術很好，線條很流暢，肯定能把我們畫得很有默契。'",
        "gal_map_text_203100947=畫好後我幫你選一個簡約的相框，裝裱起來，放在你的梳粧檯上，每天都能看到。'",
        "gal_map_text_203100948=好啊，謝謝你。' 卡洛菲斯眼神裡滿是期待。",
        "gal_map_text_203100949=我很想知道我們在畫師筆下是什麼樣子，希望能把我們的默契都畫出來。'",
        "gal_map_text_203100950=你看，畫師把你靠在我肩膀上的樣子畫得好溫柔，我的眼神也很專注，太有氛圍感了。'",
        "gal_map_text_203100951=真的！畫得太像了，連我嘴角的小梨渦都畫出來了！'",
        "gal_map_text_203100952=我要把速寫放在我的梳粧檯上，每天早上起床都能看到，想起今天的快樂時光。'",
        "gal_map_text_203100953=不用不好意思，這樣的距離很自然，也很親密，畫師能捕捉到最真實的我們。'",
        "gal_map_text_203100954=放鬆一點，不用緊張，這樣畫出來更好看。'",
        "gal_map_text_203100955=嗯，我會儘量放鬆的。'",
        "gal_map_text_203100956=有你在身邊，我就覺得很安心，什麼都不用怕了。'",
        "gal_map_text_203100957=這樣牽手坐在一起，既親密又自然，畫師畫出來也更有氛圍感，以後看到速寫，就想起今天的牽手約定。'",
        "gal_map_text_203100958=嗯，這樣真的很有安全感。'",
        "gal_map_text_203100959=我很喜歡這種感覺，希望我們能一直這樣，永遠都這麼親密。'",
        "gal_map_text_203100960=畫師很快完成了速寫，將畫紙遞給你們。紙上，用簡潔流暢的線條捕捉了你們相依的姿態 —— 卡洛菲斯輕輕靠在你的肩膀上，嘴角帶著溫柔的笑意，你側臉看著卡洛菲斯，眼神滿是珍視，背景是寥寥數筆的街燈與夜色，氛圍感十足。",
        "gal_map_text_203100961=卡洛菲斯拿著速寫，反復翻看，臉上洋溢著滿足的笑容，卡洛菲斯小心翼翼地將速寫折好放進包裡，轉頭看向你時，眼神裡滿是溫柔與依賴。",
        "gal_map_text_203100962=你們並肩離開街角，手裡的速寫成了此刻最珍貴的紀念，餘韻悠長的音樂與筆墨定格的溫柔交織，讓這份情愫徹底沉澱，為第五階段的升溫埋下完美伏筆。",
        "gal_map_text_203100963=商業街的人潮漸漸散去，隱蔽的消防樓梯帶著鏽跡與舊海報，通往一棟老式建築的頂層天臺。走上天臺，晚風迎面吹來，帶著城市夜晚的微涼。",
        "gal_map_text_203100964=遠處霓虹璀璨如星河，近處未完工的鋼筋骨架透著原始的粗糲，月光灑在地面，空紙箱與散落的木板勾勒出 '秘密基地' 的氛圍，靜謐中藏著一絲冒險感。",
        "gal_map_text_203100965=卡洛菲斯扶著天臺邊緣的欄杆，俯瞰著下方的燈火，長髮被風吹得輕輕飄動。",
        "gal_map_text_203100966=卡洛菲斯抬手將碎發別到耳後，轉頭看你時，卡洛菲斯往前走了兩步，腳下的木板發出輕微聲響，又回頭朝你招手似乎示意你過來看。",
        "gal_map_text_203100967=確實很特別，比觀景台多了點‘專屬感’。風有點大，要不要往裡面站一點？小心著涼。'",
        "gal_map_text_203100968=卡洛菲斯輕輕搖頭，卻下意識往你身邊靠了靠，肩膀幾乎相觸。",
        "gal_map_text_203100969=以前總覺得城市很擁擠，今天才發現，原來還有這麼安靜的地方。而且…… 和你一起待在這裡，感覺更安心。'",
        "gal_map_text_203100970=天臺的靜謐與 '專屬感' 讓彼此放下防備，晚風的觸碰、並肩的距離，都為情感升溫創造了契機。",
        "gal_map_text_203100971=此刻的回應既要貼合 '秘密基地' 的氛圍，又要傳遞隱晦的牽掛，讓好感度再上一個臺階。",
        "gal_map_text_203100972=將此地方作為秘密基地",
        "gal_map_text_203100973=為卡洛菲斯披上外套",
        "gal_map_text_203100974=和卡洛菲斯說出心中想法",
        "gal_map_text_203100975=以後這就是我們的秘密基地，只有你我知道，想來隨時來。'",
        "gal_map_text_203100976=卡洛菲斯踮起腳尖往四周看了看，眼神亮得像星星，手卻緊緊抓住你的胳膊。",
        "gal_map_text_203100977=那我們拉鉤，不能告訴別人！'",
        "gal_map_text_203100978=卡洛菲斯伸出手指勾住你的手，指尖用力。 語氣帶著點強勢，卻難掩眼底的歡喜。",
        "gal_map_text_203100979=以後想來提前說，我可不會隨時有空陪你瞎逛。'",
        "gal_map_text_203100980=卡洛菲斯輕輕點頭，與你拉鉤。",
        "gal_map_text_203100981=那我們約定好，不輕易帶別人來，讓這裡成為我們的專屬回憶。'",
        "gal_map_text_203100982=卡洛菲斯平靜地與你拉鉤。",
        "gal_map_text_203100983=秘密基地象徵著專屬聯結，我會遵守約定，也希望你能重視。'",
        "gal_map_text_203100984=我帶了外套，給你披上吧，晚風越吹越涼。'",
        "gal_map_text_203100985=卡洛菲斯主動轉過身讓你披外套，裹緊外套，往你身邊靠了靠。",
        "gal_map_text_203100986=有你的外套和你陪著，再冷的風都不怕了～'",
        "gal_map_text_203100987=讓你幫卡洛菲斯披外套。裹緊外套，往你身邊靠了靠。",
        "gal_map_text_203100988=你的外套好暖，還帶著你的味道，簡直是‘移動暖爐’！以後出門你都要帶著它，當我的專屬保暖裝備！'",
        "gal_map_text_203100989=謝謝，確實有點涼。' 卡洛菲斯輕輕點頭，配合你披上外套。",
        "gal_map_text_203100990=你的外套好暖，還帶著你的味道，好舒服。'",
        "gal_map_text_203100991=卡洛菲斯平靜地接受外套，整理好衣領。沒有過多表情，卻保持著靠近你的姿態。",
        "gal_map_text_203100992=沒有過多表情，卻保持著靠近你的姿態。'",
        "gal_map_text_203100993=和你一起發現這種小美好，比任何風景都珍貴。'",
        "gal_map_text_203100994=卡洛菲斯轉頭看向你，眼神裡帶著認同。",
        "gal_map_text_203100995=和對的人一起發現美好，比風景本身更有價值，這是一種情感與場景的雙重契合。'",
        "gal_map_text_203100996=卡洛菲斯客觀分析。",
        "gal_map_text_203100997=我們可以記錄下這個地方，以後定期來打卡，讓美好延續。'",
        "gal_map_text_203100998=卡洛菲斯眼眶微紅，聲音柔軟。緊緊抓住你的手，聲音帶著哽咽。",
        "gal_map_text_203100999=和你一起逛這種小眾角落，感覺心都貼得更近了，這種小美好我想永遠記住。'",
        "gal_map_text_203101000=卡洛菲斯緊緊抓住你的手，聲音帶著哽咽。",
        "gal_map_text_203101001=以前都是一個人逛，從來沒覺得風景這麼動人，有你在，一切都不一樣了。'",
        "gal_map_text_203101002=當然算數！拉鉤上吊，一百年不許變！'",
        "gal_map_text_203101003=以後這就是我們的專屬小天地，不管開心還是難過，想來隨時叫我，我都陪你。'",
        "gal_map_text_203101004=卡洛菲斯指尖微微發燙，輕輕應了一聲，目光落在遠處的星光上，嘴角藏不住笑意。",
        "gal_map_text_203101005=幸好帶了外套，不然今晚可要凍著了。'",
        "gal_map_text_203101006=這樣站著能擋點風，要是還冷，就再靠近我一點。'",
        "gal_map_text_203101007=謝謝你，這樣暖和多了。'",
        "gal_map_text_203101008=其實風景好不好看，全看身邊的人。'",
        "gal_map_text_203101009=和你一起發現這種小眾角落，分享這份安靜的美好，比任何熱門景點都有意義。'",
        "gal_map_text_203101010=我也是這麼覺得，和你在一起，連晚風都變得溫柔了。'",
        "gal_map_text_203101011=兩人並肩靠在欄杆上，晚風輕輕吹過，帶著彼此的氣息。卡洛菲斯裹著你的外套，肩膀緊緊挨著你，偶爾輕聲聊起生活中的小事，偶爾沉默地看著夜景。",
        "gal_map_text_203101012=卡洛菲斯的頭慢慢靠向你的肩膀，又快速抬起，耳尖泛紅；你的手悄悄靠近卡洛菲斯的手，指尖相觸的瞬間，兩人都沒有躲開，只是緊緊握住。",
        "gal_map_text_203101013=天臺的月光、遠處的霓虹、緊握的雙手，讓這份情愫在靜謐中徹底升溫，距離告白只剩一層薄薄的窗戶紙。",
        "gal_map_text_203101014=大部分店鋪已打烊，雲境內卻飄來食物的誘人香氣 —— 原來這裡正舉辦深夜派對，幾家深夜食堂、甜品店亮著溫暖的燈光。門口擺著臨時的桌椅，三五成群的人低聲談笑，空氣中混合著烤麵包的麥香、奶茶的甜香和淡淡的花草香。",
        "gal_map_text_203101015=門口擺著臨時的桌椅，三五成群的人低聲談笑，空氣中混合著烤麵包的麥香、奶茶的甜香和淡淡的花草香。暖黃的串燈掛在店鋪門口，營造出溫馨熱鬧的氛圍，與剛才天臺的靜謐形成鮮明對比。",
        "gal_map_text_203101016=卡洛菲斯聞到香氣，眼睛立刻亮了起來，剛才在天臺的安靜瞬間被拋到腦後。",
        "gal_map_text_203101017=卡洛菲斯拉著你的手，腳步輕快地走向派對區域：'哇，居然有深夜派對！我好久沒參加過這種夜晚的小聚會了，看起來好熱鬧！' 卡洛菲斯指著一家甜品店的櫥窗，'你看那個草莓舒芙蕾，看起來好好吃！我們去嘗嘗好不好？'",
        "gal_map_text_203101018=不過剛在咖啡館喝了特調，要不要先吃點鹹的墊墊，再吃甜品？'",
        "gal_map_text_203101019=你說得對！'",
        "gal_map_text_203101020=那我們先去吃烤麵包，再吃舒芙蕾！剛才在天臺吹了風，正好吃點熱的暖一暖。'",
        "gal_map_text_203101021=深夜派對的溫馨熱鬧讓氛圍變得輕鬆愉悅，食物的香氣拉近了彼此的距離。",
        "gal_map_text_203101022=此刻的互動既要滿足卡洛菲斯的興奮，又要傳遞 '把你放在心上' 的細節，讓升溫的情愫在煙火氣中更顯真摯。",
        "gal_map_text_203101023=獨自去排隊買麵包，讓卡洛菲斯先找位置",
        "gal_map_text_203101024=和卡洛菲斯一起排隊，順便聊聊各自喜好",
        "gal_map_text_203101025=拍照紀念這個深夜派對",
        "gal_map_text_203101026=人多呵護卡洛菲斯不被擠到",
        "gal_map_text_203101027=我去排隊買烤麵包，你找個位置坐著等，順便看看想吃什麼甜品，我一起買。'",
        "gal_map_text_203101028=卡洛菲斯找了個靠窗的位置坐下，揮手說。",
        "gal_map_text_203101029=烤麵包要微焦的，甜品選草莓舒芙蕾和芒果西米露，記得別放太多糖，謝謝。'",
        "gal_map_text_203101030=卡洛菲斯掏出手機查看店家。",
        "gal_map_text_203101031=需要我提前查好甜品店評價，幫你篩選推薦嗎？避免踩雷。' 語氣客觀，注重實用。",
        "gal_map_text_203101032=卡洛菲斯臉頰微紅，眼神一直跟著你，時不時詢問排到幾號了。",
        "gal_map_text_203101033=不用太著急，慢慢排隊就好，我不餓。'",
        "gal_map_text_203101034=卡洛菲斯眼眶微紅。",
        "gal_map_text_203101035=居然讓我坐著等，自己去排隊，從來沒有人這麼照顧我，真的好感動。'",
        "gal_map_text_203101036=我們一起排隊吧，順便聊聊你平時喜歡吃什麼，以後我記下來，隨時帶你吃。'",
        "gal_map_text_203101037=卡洛菲斯臉頰微紅，緊緊握著你的手。",
        "gal_map_text_203101038=其實我平時很少吃甜品，怕胖，但今天和你一起，想放縱一下。'",
        "gal_map_text_203101039=行，一起排隊正好，我也想說說我的口味。'",
        "gal_map_text_203101040=我不吃香菜，甜品要少糖，以後約會提前按我的口味準備，別每次都問。'",
        "gal_map_text_203101041=卡洛菲斯分享起商家的美食，並說起了自己的口味。",
        "gal_map_text_203101042=我平時口味比較清淡，喜歡吃蔬菜和魚類，甜品偶爾吃一次，草莓味的還不錯。' 語氣溫和，慢慢分享。",
        "gal_map_text_203101043=卡洛菲斯介紹起自己的飲食環境。",
        "gal_map_text_203101044=我飲食偏健康，少鹽少糖，甜品儘量選低糖款，你記一下就行。'",
        "gal_map_text_203101045=這裡的串燈好好看，等會兒吃完東西，我們在這邊拍張照吧，紀念這個深夜派對。'",
        "gal_map_text_203101046=卡洛菲斯拉著你的手，四處打量。",
        "gal_map_text_203101047=我們等會兒站在甜品店門口拍，背景是草莓舒芙蕾和串燈，肯定很浪漫！' 興奮雀躍，眼神發亮。",
        "gal_map_text_203101048=卡洛菲斯拿出手機，準備好拍照的動作。",
        "gal_map_text_203101049=比愛心的、靠肩膀的、搞怪的，還要發朋友圈，配文就寫‘和喜歡的人一起打卡深夜派對’！'",
        "gal_map_text_203101050=卡洛菲斯輕輕點頭語氣平靜，卻主動往串燈方向走。",
        "gal_map_text_203101051=拍照紀念挺好的。' 卡洛菲斯輕輕點頭，'串燈確實很有氛圍，拍出來應該會很好看。'",
        "gal_map_text_203101052=卡洛菲斯站在串燈旁，整理了一下衣服準備好拍照的姿勢。",
        "gal_map_text_203101053=別拍太多，簡單記錄就行，不用太張揚。'",
        "gal_map_text_203101054=人有點多，你拉緊我的手，別被擠到，我一直陪著你。'",
        "gal_map_text_203101055=卡洛菲斯緊緊回握你的手，手指用力。",
        "gal_map_text_203101056=人多的時候有你護著，感覺好安心，就像有了專屬保鏢一樣！'",
        "gal_map_text_203101057=卡洛菲斯往你身邊靠得更近，幾乎貼在你身上。",
        "gal_map_text_203101058=人多我最沒安全感了，有你牽著我，我什麼都不怕！以後出門人多，你都要這樣牽著我！'",
        "gal_map_text_203101059=卡洛菲斯輕輕回握你的手。",
        "gal_map_text_203101060=人多確實容易走散，這樣挺好，謝謝你照顧我。'",
        "gal_map_text_203101061=好，我知道了。'",
        "gal_map_text_203101062=牽手能有效避免走散，也能提供安全感，這個做法很合理。'",
        "gal_map_text_203101063=好，那你在這兒坐好等我，我儘快回來。'",
        "gal_map_text_203101064=要是等得無聊，就發消息給我，我看到會及時回你。'",
        "gal_map_text_203101065=知道啦，你快去快回，我在這裡乖乖等你。",
        "gal_map_text_203101066=烤麵包要微焦的，甜品選草莓舒芙蕾和芒果西米露，記得別放太多糖，謝謝。'",
        "gal_map_text_203101067=正好趁排隊的時間，好好聽聽你的口味偏好，以後約會就按你的喜好來準備。'",
        "gal_map_text_203101068=其實我平時吃得比較清淡，但偶爾也想嘗嘗微辣的烤物，甜品就偏愛草莓味的。'",
        "gal_map_text_203101069=好，都記下來了，以後慢慢帶你嘗。'",
        "gal_map_text_203101070=你看，暖黃色的串燈配上甜品店的香氣，氛圍感直接拉滿了。' 你掏出手機晃了晃。",
        "gal_map_text_203101071=等會兒買完甜品，我們就在這裡拍張照，把這份浪漫存下來。'",
        "gal_map_text_203101072=好啊！我們可以找個角度把串燈和甜品都拍進去，肯定很好看。'",
        "gal_map_text_203101073=人多有點擠，你跟緊我，別鬆開手。'",
        "gal_map_text_203101074=要是被碰到或者不舒服，隨時告訴我，我帶你到旁邊休息。'",
        "gal_map_text_203101075=嗯，我會跟緊你的，有你在身邊，我很安心。'",
        "gal_map_text_203101076=兩人吃著烤麵包和甜品，聊著彼此的口味喜好，笑聲融入深夜派對的氛圍中。吃完後，在串燈下發了張親密的合照，卡洛菲斯將照片設成聊天背景，嘴角一直帶著笑意。",
        "gal_map_text_203101077=離開時，卡洛菲斯的手一直緊緊握著你的手，沒有鬆開，人群中，卡洛菲斯下意識地往你身邊靠，依賴感愈發明顯。深夜的煙火氣與彼此的牽掛交織，讓這份情愫升溫到頂點，只差一個契機，就能挑明心意。",
        "gal_map_text_203101078=你們拐進一條掛滿暖黃色小燈的巷子，一家只在夜晚營業的創意糖果店亮著夢幻的燈光。櫥窗裡擺著像行星、星座一樣晶瑩剔透的 '星空糖'，色彩斑斕，透著淡淡的光澤。",
        "gal_map_text_203101079=店主是個活潑的姑娘，笑著招呼：'新店開業，情侶挑戰福利！兩人合作，不用手，只用嘴傳遞一張糖紙，堅持十秒不落，就能免費獲得限量‘雙子座’星空糖，還能把願望寫在紙條上，封進‘月光願望罐’永久保存！'",
        "gal_map_text_203101080=店內擠滿了參與挑戰的情侶，氛圍熱鬧又曖昧。",
        "gal_map_text_203101081=卡洛菲斯看著櫥窗裡的星空糖，眼睛亮了起來，又看到其他情侶的挑戰，臉頰瞬間泛紅。",
        "gal_map_text_203101082=卡洛菲斯拉著你的衣袖，聲音帶著點羞澀又期待。",
        "gal_map_text_203101083=想試就試試，不用怕。'",
        "gal_map_text_203101084=我會配合你，慢慢傳遞，肯定能成功。而且那個星空糖看起來確實很特別，還能寫願望，很有紀念意義。'",
        "gal_map_text_203101085=卡洛菲斯重重點頭，鼓起勇氣說。",
        "gal_map_text_203101086=那我們試試！不過…… 你可不許笑我，也不許靠太近嚇到我。'",
        "gal_map_text_203101087=卡洛菲斯跟著店主走到挑戰區域，拿起那張薄薄的糖紙，臉頰紅得像熟透的蘋果。",
        "gal_map_text_203101088=星空糖挑戰的曖昧規則讓氛圍瞬間拉滿，既帶著點小刺激，又能自然拉近彼此的距離。",
        "gal_map_text_203101089=此刻的回應既要給卡洛菲斯勇氣，又要傳遞 '尊重你、保護你' 的心意，讓升溫的情愫在挑戰中更顯甜蜜。",
        "gal_map_text_203101090=鼓勵卡洛菲斯，別緊張",
        "gal_map_text_203101091=眼神暗示卡洛菲斯，數1.2.3後開始傳遞",
        "gal_map_text_203101092=輕輕拖住糖紙",
        "gal_map_text_203101093=別緊張，我會放慢速度，跟著你的節奏來，肯定不會讓糖紙掉下來。'",
        "gal_map_text_203101094=卡洛菲斯深吸一口氣，點點頭，眼神裡的緊張少了幾分。",
        "gal_map_text_203101095=你可一定要放慢速度，我要是緊張把糖紙弄掉了，可饒不了你！'",
        "gal_map_text_203101096=卡洛菲斯興奮地湊近你。",
        "gal_map_text_203101097=你可千萬要穩住，我們一定要拿到星空糖！拿到後我們一人一半，一起吃，多甜蜜！'",
        "gal_map_text_203101098=卡洛菲斯輕輕點頭，眼神專注地看著你。",
        "gal_map_text_203101099=你放慢速度就好，我會跟著你的節奏，應該不會出錯。'",
        "gal_map_text_203101100=我相信你的節奏把控。' 卡洛菲斯平靜地站在你對面。",
        "gal_map_text_203101101=不用太在意結果，盡力就好，重點是體驗過程。'",
        "gal_map_text_203101102=我們先眼神示意，我數 1、2、3，再開始傳遞，放心，我會一直看著你，不會讓你尷尬。'",
        "gal_map_text_203101103=卡洛菲斯與你對視，睫毛輕輕顫動。",
        "gal_map_text_203101104=眼神示意+倒計時，這個約定很合理。這樣能減少尷尬，也能提高成功率，就按你說的來。'。",
        "gal_map_text_203101105=卡洛菲斯覺得這個默契約定很科學，先建立信號再行動。卡洛菲斯認真與你對視。",
        "gal_map_text_203101106=我會緊盯你的眼神，倒計時結束後再靠近，確保萬無一失。'",
        "gal_map_text_203101107=卡洛菲斯臉頰泛紅，與你對視時心跳加速。",
        "gal_map_text_203101108=這樣好像電視劇裡的情節，我都有點緊張了，你可一定要記得數秒呀！'",
        "gal_map_text_203101109=卡洛菲斯眼眶微紅，與你對視時眼神柔軟。",
        "gal_map_text_203101110=能和你有這樣的默契，感覺心都連在一起了，就算糖紙掉了也沒關係，我已經很開心了。'",
        "gal_map_text_203101111=糖紙很薄，我會輕輕用嘴唇托住，你慢慢靠近，不用急，安全第一，挑戰第二。'",
        "gal_map_text_203101112=卡洛菲斯心頭一暖，緊繃的肩膀放鬆下來。卡洛菲斯慢慢靠近你，聲音放輕。",
        "gal_map_text_203101113=那我慢慢湊過去，你可一定要托穩糖紙呀，別讓我白期待一場。'",
        "gal_map_text_203101114=卡洛菲斯點點頭，慢慢靠近你。語氣強勢，注重邊界感。",
        "gal_map_text_203101115=我會控制好距離，不會靠太近讓你不舒服，你只要托穩糖紙就行。'",
        "gal_map_text_203101116=卡洛菲斯輕輕點頭，慢慢靠近你。",
        "gal_map_text_203101117=我會儘量放鬆，不緊張，不給你添麻煩。'",
        "gal_map_text_203101118=卡洛菲斯平靜地靠近你。語氣平淡，保持冷靜。",
        "gal_map_text_203101119=我會保持勻速移動，你不用刻意遷就我，按你的節奏來就好。'",
        "gal_map_text_203101120=別慌，我們慢慢來，我完全跟著你的節奏走，糖紙掉了也沒關係，大不了重新來一次。'",
        "gal_map_text_203101121=準備好了嗎？我們先深呼吸，調整好狀態再開始。'",
        "gal_map_text_203101122=嗯，我準備好了，這次一定能成功！'",
        "gal_map_text_203101123=我們先對個眼神信號，你覺得可以了就眨下眼睛，我再開始數秒。'",
        "gal_map_text_203101124=不用緊張，我會一直看著你，確保不會讓你覺得尷尬。'",
        "gal_map_text_203101125=好，我明白了，你數秒的時候慢一點就好。'",
        "gal_map_text_203101126=你慢慢過來，不用急，我會把糖紙托穩的。'",
        "gal_map_text_203101127=差不多這個位置就好，稍微低頭就能碰到，注意安全。'",
        "gal_map_text_203101128=好，我會小心的，你可一定要托穩啊。'",
        "gal_map_text_203101129=挑戰成功！店主笑著送上限量 '雙子座' 星空糖，遞來兩張紙條：'快寫下你們的願望，封進月光願望罐，會實現哦！'",
        "gal_map_text_203101130=卡洛菲斯拿著紙條，低頭認真寫下願望，悄悄折好放進罐子裡，轉頭看你時，眼神裡滿是甜蜜。卡洛菲斯剝開一顆星空糖，遞到你嘴邊：'嘗嘗，很甜。'",
        "gal_map_text_203101131=你咬下一半，剩下的一半卡洛菲斯自己吃掉，甜意在舌尖蔓延，像此刻的情愫。離開糖果店時，卡洛菲斯的手一直緊緊握著你的手，星空糖的甜味與彼此的心跳交織，讓好感度徹底臨近告白邊緣。",
        "gal_map_text_203101132=為了從剛才被矚目的害羞中徹底放鬆，你們看到一家充滿歡聲笑語的復古大頭貼拍照館。",
        "gal_map_text_203101133=店面不大，門口掛著彩色的燈牌，櫥窗裡展示著各種誇張的假髮、眼鏡和道具 —— 粉色爆炸頭、搞怪鬍子、超大黑框眼鏡、卡通兔耳朵應有盡有，裡面傳來情侶打鬧的笑聲，氛圍輕鬆又歡樂。",
        "gal_map_text_203101134=卡洛菲斯看到拍照館，眼睛瞬間亮了起來，剛才占卜時的羞澀一掃而空。",
        "gal_map_text_203101135=卡洛菲斯拉著你的手就往裡走，語氣雀躍：'哇！這個好有意思！我好久沒拍過大頭貼了，我們拍一組搞怪的怎麼樣？不准耍帥，要配合我做鬼臉！'",
        "gal_map_text_203101136=卡洛菲斯已經開始在門口的道具架上挑選誇張的貓耳朵和彩色墨鏡。",
        "gal_map_text_203101137=沒問題，完全聽你的指揮。'",
        "gal_map_text_203101138=不過你選的道具可不能太誇張，不然我怕拍出來認不出自己。'",
        "gal_map_text_203101139=放心吧！' 卡洛菲斯拿起一個粉色兔耳朵戴在頭上，又遞了一個黑色貓耳朵給你。",
        "gal_map_text_203101140=就選這個，很可愛！我們要拍一組最搞怪、最特別的大頭貼，留作紀念。'",
        "gal_map_text_203101141=復古大頭貼的歡樂氛圍讓彼此的距離進一步拉近，搞怪的道具為互動增添了趣味。此刻的互動既可以配合卡洛菲斯的搞怪，又能傳遞溫柔的心意，不同性格的回應能讓這場搞怪時光更有層次感。",
        "gal_map_text_203101142=選一張搞怪的照片用來收藏",
        "gal_map_text_203101143=誇張卡洛菲斯裝扮好看",
        "gal_map_text_203101144=一起合照留念",
        "gal_map_text_203101145=一起拍大頭照",
        "gal_map_text_203101146=拍好後我們選一張最大的相框，我要掛在床頭，每天醒來都能看到你的搞怪樣子。'",
        "gal_map_text_203101147=卡洛菲斯臉頰泛紅，卻故意板起臉。語氣帶著點小霸道，卻藏不住歡喜。",
        "gal_map_text_203101148=不過…… 我同意！我們選一張最搞怪的，讓你每天都能想起今天的快樂時光，但不許給別人看！'",
        "gal_map_text_203101149=卡洛菲斯拿起一張搞怪合照，急忙分享給你看。",
        "gal_map_text_203101150=這張不錯，既搞笑又不丟人，就選它了，你要是敢換別的，我就把你的相框藏起來。' 語氣強勢，掌控欲強。",
        "gal_map_text_203101151=卡洛菲斯輕輕點頭。語氣溫和，認同你的想法。",
        "gal_map_text_203101152=我們選一張既搞怪又溫馨的，以後看到就能想起今天的快樂，也挺好。' 語氣溫和，認同你的想法。",
        "gal_map_text_203101153=卡洛菲斯平靜地挑選照片。",
        "gal_map_text_203101154=選一張不容易過時的，掛在床頭也不突兀，就這張吧，挺合適。'",
        "gal_map_text_203101155=你戴貓耳朵的樣子真的很可愛，比任何道具都好看，我們多拍幾張這個造型的。'",
        "gal_map_text_203101156=卡洛菲斯嗔怪地瞪你一眼，卻忍不住摸了摸頭上的貓耳朵。",
        "gal_map_text_203101157=那我們多拍幾張，我要選一張最好看的，設成手機壁紙，讓你每天都能看到我可愛的樣子！'",
        "gal_map_text_203101158=卡洛菲斯極度興奮，毫不掩飾開心。",
        "gal_map_text_203101159=那我們把所有帶貓耳朵的造型都拍一遍，正面、側面、搞怪鬼臉，每一張都要保存好，還要發朋友圈炫耀！'",
        "gal_map_text_203101160=卡洛菲斯輕輕點頭。",
        "gal_map_text_203101161=那我們多拍幾張，選幾張好看的存起來，留作紀念。'",
        "gal_map_text_203101162=卡洛菲斯平靜地調整姿勢。",
        "gal_map_text_203101163=我們拍幾張就行，不用太多，選兩張最好看的保存，其他的可以刪掉。'",
        "gal_map_text_203101164=我們來拍一張‘頭靠頭’的合照，這樣顯得更親密，也更有紀念意義。'",
        "gal_map_text_203101165=卡洛菲斯主動將頭靠在你的肩膀上。",
        "gal_map_text_203101166=這樣拍出來既能體現默契，又不會太刻意，很自然。'",
        "gal_map_text_203101167=卡洛菲斯靠在你的肩膀上。感性十足，容易害羞。",
        "gal_map_text_203101168=我們保持這個姿勢 3 秒，確保拍出來清晰，再換別的姿勢，提高效率。'",
        "gal_map_text_203101169=卡洛菲斯主動將頭靠在你的肩膀上，臉頰泛紅，",
        "gal_map_text_203101170=這樣感覺心都貼得更近了，拍出來肯定很好看，我要把這張設成聊天背景！'",
        "gal_map_text_203101171=卡洛菲斯靠在你的肩膀上，眼眶微紅。",
        "gal_map_text_203101172=能這樣和你拍照，我真的好幸福，感覺我們的距離又拉近了，我會永遠保存這張照片。'",
        "gal_map_text_203101173=和你一起拍大頭貼，不管是搞怪還是溫柔的，都想永遠保存下來，當成最珍貴的回憶。'",
        "gal_map_text_203101174=卡洛菲斯聲音放輕。語氣帶著點小羞澀，卻保持著獨立。",
        "gal_map_text_203101175=和你一起拍的每一張照片，我都想好好保存，但你不許隨便翻看我的相冊，要經過我同意！'",
        "gal_map_text_203101176=卡洛菲斯認真地點頭。語氣強勢，注重隱私。",
        "gal_map_text_203101177=我會單獨建一個相冊保存，密碼只有我知道，你想看也要提前說，不許偷偷看。'",
        "gal_map_text_203101178=嗯，我也想永遠保存這些回憶。' 卡洛菲斯輕輕點頭。",
        "gal_map_text_203101179=和你一起拍的照片，不管是搞怪還是溫柔的，都很有意義，我會好好收藏，偶爾拿出來看看。' 語氣溫和，珍惜回憶。",
        "gal_map_text_203101180=這些照片是我們的專屬回憶，值得保存。'卡洛菲斯平靜地說。",
        "gal_map_text_203101181=我會備份在雲端，防止丟失，以後老了還能拿出來回憶今天的時光。' 語氣平淡，考慮長遠。",
        "gal_map_text_203101182=就這張吧，又搞笑又有紀念意義，掛在床頭每天醒來都能想起今天的快樂。'",
        "gal_map_text_203101183=我們再選一張溫柔的，你放錢包裡，我放手機殼裡，隨時都能看到彼此。'",
        "gal_map_text_203101184=好啊，就選這兩張！不過你可不許把搞怪的拿給別人看，不然我饒不了你。'",
        "gal_map_text_203101185=你戴這個貓耳朵是真的可愛，比其他任何道具都襯你。'",
        "gal_map_text_203101186=我們再拍幾張不同角度的，正面、側面都來一張，選最好看的存下來。'",
        "gal_map_text_203101187=真的嗎？那我們多拍幾張，我要選一張設成手機壁紙。'",
        "gal_map_text_203101188=我們拍一張頭靠頭的合照吧，這樣顯得更親密，也更有氛圍感。'",
        "gal_map_text_203101189=準備好了嗎？我們一起笑一個，自然一點就好。'",
        "gal_map_text_203101190=準備好了，這樣真的很有安全感，拍出來肯定很好看。'",
        "gal_map_text_203101191=這些照片都好好收著吧，每一張都是我們今天的回憶。'",
        "gal_map_text_203101192=不管是搞怪的還是溫柔的，我都想永遠保存下來，當成我們之間最珍貴的紀念。'",
        "gal_map_text_203101193=我也是，我會單獨找個相冊把它們存起來，好好珍藏。'",
        "gal_map_text_203101194=你們拍了一組又一組大頭貼，從搞怪鬼臉到溫柔對視，每一張都充滿了專屬你們的回憶。",
        "gal_map_text_203101195=卡洛菲斯拿著列印出來的照片，小心翼翼地放進相框，臉上洋溢著滿足的笑容。",
        "gal_map_text_203101196=離開拍照館時，卡洛菲斯將其中一張合照塞進你的口袋。卡洛菲斯的手一直挽著你的胳膊，眼神裡的依賴與心動愈發明顯，情愫已升溫到極致，只差最後一步就能挑明心意。",
        "gal_map_text_203101197=畫師將速寫遞給你們，紙上的線條簡潔流暢，精准捕捉了你們相依的姿態 —— 卡洛菲斯輕輕靠在你的肩膀上。",
        "gal_map_text_203101198=嘴角帶著溫柔的笑意，你側臉看著卡洛菲斯，眼神滿是珍視，背景是寥寥數筆的街燈與夜色，氛圍感十足。",
        "gal_map_text_203101199=周圍偶爾有行人經過，腳步聲與遠處 Livehouse 殘留的音樂聲交織，氛圍靜謐又溫柔。",
        "gal_map_text_203101200=卡洛菲斯拿著速寫，反復翻看，眼睛裡滿是驚喜與感動。卡洛菲斯輕輕撫摸著紙上的線條，轉頭看你時。",
        "gal_map_text_203101201=畫師畫得真好，把我們當時的感覺都畫出來了。你看你看著我的樣子，好溫柔。'",
        "gal_map_text_203101202=因為當時的感覺是真實的。'",
        "gal_map_text_203101203=和你靠在一起的瞬間，覺得很踏實，很幸福，所以眼神裡的情緒藏不住。'",
        "gal_map_text_203101204=卡洛菲斯臉頰泛紅，卻忍不住笑了出來。",
        "gal_map_text_203101205=其實我當時也很緊張，怕靠得太近你會覺得不舒服。' 卡洛菲斯頓了頓，聲音放輕，'但靠在你肩膀上，又覺得很安心。'",
        "gal_map_text_203101206=速寫定格的溫柔瞬間讓彼此的心意更加清晰，紙上的相依姿態與現實中的距離形成呼應。",
        "gal_map_text_203101207=此刻的回應既要貼合速寫的氛圍，又要傳遞隱晦的心動，讓升溫的情愫在共鳴中更顯真摯。",
        "gal_map_text_203101208=看著畫誇讚卡洛菲斯",
        "gal_map_text_203101209=拿走卡洛菲斯的速寫畫",
        "gal_map_text_203101210=指出速寫上好玩的地方",
        "gal_map_text_203101211=你沒有看畫，而是深深地看著卡洛菲斯捧著畫的樣子：'畫的很像，但是有一點他永遠畫不出來，就是我眼中最真實的你。'",
        "gal_map_text_203101212=卡洛菲斯臉頰瞬間爆紅，眼神躲閃了一下又迎上你，故意板起臉。",
        "gal_map_text_203101213=不過…… 算你有眼光，知道我比畫裡更好看。'",
        "gal_map_text_203101214=卡洛菲斯深吸一口氣，眼神堅定地看著你。主動往你身邊靠了靠，肩膀輕輕相觸。",
        "gal_map_text_203101215=畫裡的樣子只是瞬間，我真實的樣子，以後你有的是時間慢慢看。'",
        "gal_map_text_203101216=卡洛菲斯興奮地拉著你的手，身體幾乎靠在你身上。",
        "gal_map_text_203101217=我也是！在我心裡，你比畫裡還要溫柔，能被你這麼看著，真的好幸福。'",
        "gal_map_text_203101218=謝謝你……' 卡洛菲斯聲音軟糯，眼眶微紅。",
        "gal_map_text_203101219=從來沒有人這麼說過，我都有點不好意思了。有你在身邊，我覺得自己什麼都好，這種感覺真的很安心。' 緊緊拉著你的衣袖，捨不得鬆開。",
        "gal_map_text_203101220=你從卡洛菲斯手中輕輕抽走畫紙，在卡洛菲斯疑惑的目光中，將它仔細折好放入自己的口袋：'好了，現在它是我的了，至於模特費我會慢慢付給你。'",
        "gal_map_text_203101221=你居然直接收起來了？' 卡洛菲斯愣了一下，隨即笑了。",
        "gal_map_text_203101222=行吧，既然是你的了，那模特費可要好好‘付’，可不許敷衍。' 邏輯清晰，卻悄悄調整坐姿，向你靠近了些。",
        "gal_map_text_203101223=卡洛菲斯客觀評價，卻沒有要拿回速寫的意思。",
        "gal_map_text_203101224=模特費可以按‘陪伴時長’折算，以後多陪我聽幾場演出，就算抵消了。'",
        "gal_map_text_203101225=卡洛菲斯臉頰泛紅，眼神裡滿是驚喜。",
        "gal_map_text_203101226=這是不是代表，我也是你的專屬了？太甜了，我都有點害羞了。'",
        "gal_map_text_203101227=卡洛菲斯眼眶微紅，聲音帶著哽咽。",
        "gal_map_text_203101228=你把我們的速寫收起來，好像把我們的回憶也珍藏起來了。有你這麼在乎我，我真的好感動。' 輕輕靠在你的肩膀上。",
        "gal_map_text_203101229=你也湊近仔細看畫，笑著指指畫上的自己：'你看這個表情是不是有點傻，真的好好笑。'",
        "gal_map_text_203101230=卡洛菲斯笑著點頭，手指點著畫上你的表情。",
        "gal_map_text_203101231=不過傻得還挺可愛，和你平時認真的樣子完全不一樣。'",
        "gal_map_text_203101232=卡洛菲斯興奮地拍著你的胳膊。拿起手機就要拍照。",
        "gal_map_text_203101233=沒想到你還有這麼呆萌的一面，被畫師抓得真准！我們趕緊拍張照，以後就用這個調侃你。'",
        "gal_map_text_203101234=卡洛菲斯語氣平淡，嘴角卻忍不住微微上揚。雖然話少，卻主動指著畫和你一起討論。",
        "gal_map_text_203101235=不過和你當時的樣子挺像，還算寫實。'",
        "gal_map_text_203101236=卡洛菲斯輕輕應了一聲，眼神卻在畫上停留了幾秒。卻沒有排斥這份輕鬆的互動。",
        "gal_map_text_203101237=比我想像中強，不算太醜。'",
        "gal_map_text_203101238=畫裡的你很美，但只有我知道，你低頭淺笑時的梨渦、緊張時輕輕攥著衣角的小動作，這些真實的模樣，比畫裡更讓我心動。'",
        "gal_map_text_203101239=你…… 你居然注意到這麼多。' 卡洛菲斯輕輕咬了咬下唇，'其實在我心裡，你也是最特別的，沒有人能替代。'",
        "gal_map_text_203101240=這份速寫是我們的專屬回憶，當然要好好珍藏。'",
        "gal_map_text_203101241=模特費我早就想好了，以後你的每場喜歡的演出，我都陪你看，你的每個小願望，我都幫你實現。'",
        "gal_map_text_203101242=真的嗎？那我可要好好記著，以後可不許反悔。' 卡洛菲斯輕輕拉著你的手，'其實…… 能被你這麼在乎，我真的很開心。'",
        "gal_map_text_203101243=確實有點傻，當時滿腦子都是你靠在我肩膀上的樣子，都沒注意自己的表情。'",
        "gal_map_text_203101244=不過幸好畫師畫下來了，以後看到這張速寫，就能想起我們今天的快樂。'",
        "gal_map_text_203101245=是啊，今天真的很開心。不管是畫裡的傻樣子，還是現在和你一起調侃的時刻，我都想永遠記住。'",
        "gal_map_text_203101246=兩人並肩站在街角，手裡的速寫或是被細心收好，或是被一起翻看調侃。遠處 Livehouse 的音樂漸漸消散，晚風輕輕吹過，帶著彼此的氣息。",
        "gal_map_text_203101247=卡洛菲斯偶爾抬頭看你，眼神裡的溫柔與依賴藏不住，身體不自覺地向你靠近；你的手悄悄靠近卡洛菲斯的手，指尖相觸的瞬間，兩人都沒有躲開，只是輕輕相握。",
        "gal_map_text_203101248=速寫定格的溫柔與現實中的心動交織，讓這份情愫徹底升溫到臨近告白的邊緣，只待一個合適的契機就能挑明心意。",
        "gal_map_text_203101249=畫師將速寫交給你們，卡洛菲斯看著畫上兩人略顯卡通但神韻十足的形象，忍不住 '噗嗤' 笑出聲來：'哈哈，你看你的頭髮，被畫成好像被風吹起來一撮！還有你的表情，好像在偷偷看我，眼睛都快眯成一條縫了，好可愛！'",
        "gal_map_text_203101250=卡洛菲斯拿著速寫在你面前晃了晃，手指點著畫中你的髮型，臉上滿是搞怪的笑容。周圍偶爾有行人被卡洛菲斯的笑聲吸引，轉頭看來，遠處 Livehouse 殘留的鼓點與笑聲交織，氛圍輕鬆又歡樂，與剛才速寫共鳴的溫柔形成鮮明對比。",
        "gal_map_text_203101251=卡洛菲斯笑得眉眼彎彎，將速寫遞到你手裡，自己則湊在旁邊，指著畫中你的細節不停調侃。",
        "gal_map_text_203101252=其實我當時就知道你在看我，只是假裝沒發現，沒想到被畫師畫得這麼明顯！'",
        "gal_map_text_203101253=被你發現了！'",
        "gal_map_text_203101254=誰讓你靠在我肩膀上的樣子那麼可愛，我忍不住就多看了幾眼，沒想到被畫師抓了個正著。'",
        "gal_map_text_203101255=不過你畫得也很有意思啊，嘴角的小梨渦都畫出來了，還有你偷偷抿嘴笑的樣子，明明也在緊張吧？'",
        "gal_map_text_203101256=你別取笑我了！' 卡洛菲斯嗔怪地瞪你一眼，伸手輕輕拍了拍你的胳膊，卻掩不住嘴角的笑意。",
        "gal_map_text_203101257=我那是自然的笑容，不像你，偷偷看我還被當場‘抓包’，畫出來多糗啊！' 卡洛菲斯搶回速寫，又看了一眼，忍不住又笑了，'不過說真的，還挺像我們當時的樣子，雖然搞怪，但很真實。'",
        "gal_map_text_203101258=搞怪速寫的歡樂互動讓彼此徹底放下防備，調侃中帶著隱晦的心動，物理距離在打鬧中自然拉近。",
        "gal_map_text_203101259=此刻的回應既要順著卡洛菲斯的搞怪節奏接梗，又要在玩笑中悄悄拉近距離、傳遞在意，既不破壞輕鬆氛圍，又能讓情愫在歡樂中悄悄升溫，貼合卡洛菲斯'外熱內柔'的性格。",
        "gal_map_text_203101260=拿過畫，假裝嚴肅地端詳",
        "gal_map_text_203101261=做出畫裡的動作逗卡洛菲斯笑",
        "gal_map_text_203101262=調侃畫裡的自己",
        "gal_map_text_203101263=把這張畫送給卡洛菲斯",
        "gal_map_text_203101264=你一把拿過畫，假裝嚴肅地端詳：'畫的也不是很準確，我和你之間的距離應該更近才對。'",
        "gal_map_text_203101265=卡洛菲斯笑著拍了一下你的胳膊，卻主動往你身邊湊了湊。卡洛菲斯拿起速寫比劃著兩人的距離。",
        "gal_map_text_203101266=不過…… 好像確實近一點更真實！'",
        "gal_map_text_203101267=這樣是不是更像我們當時的樣子？'",
        "gal_map_text_203101268=卡洛菲斯興奮地抓住你的手，身體幾乎貼在你身上。",
        "gal_map_text_203101269=確實應該更近一點！不如我們現在湊近點，讓畫師再畫一張？或者我用手機拍一張，比這張速寫還親密！'",
        "gal_map_text_203101270=卡洛菲斯語氣平淡，卻悄悄調整姿勢，讓肩膀輕輕碰到你的肩膀。",
        "gal_map_text_203101271=不過畫都畫好了，說這些也沒用。' 雖然話少，卻用行動呼應你的話。'",
        "gal_map_text_203101272=隨便你。' 卡洛菲斯輕輕應了一聲，卻沒有躲開你靠近的動作。",
        "gal_map_text_203101273=只要別太過分就行。'",
        "gal_map_text_203101274=也算是百分百還原，只是看起來還差一點意思 —— 缺個和你湊近的畫面。'",
        "gal_map_text_203101275=卡洛菲斯笑著模仿你畫裡的表情，頭髮也故意甩了甩。",
        "gal_map_text_203101276=是不是要這樣湊近你才對？'",
        "gal_map_text_203101277=這樣是不是就完美還原‘真實場景’了？'",
        "gal_map_text_203101278=。卡洛菲斯拿起手機，直接把鏡頭對準兩人，主動湊近你比了個搞怪鬼臉，'哢嚓' 一聲拍下合照",
        "gal_map_text_203101279=不過確實缺個湊近的畫面！我們現在就補拍一張！'",
        "gal_map_text_203101280=還行，挺像的。' 卡洛菲斯嘴角微微上揚，難得露出明顯的笑意。",
        "gal_map_text_203101281=湊近點確實更符合當時的氛圍。' 卡洛菲斯沒有主動靠近，卻默許你往卡洛菲斯身邊挪了挪。",
        "gal_map_text_203101282=卡洛菲斯輕輕點頭，眼神裡閃過一絲笑意。",
        "gal_map_text_203101283=不過不用特意補拍，這張速寫已經夠用來調侃你了。'",
        "gal_map_text_203101284=這畫的有點抽象了，我覺得應該要畫的更好才對 —— 至少得把我偷偷看你的溫柔眼神畫出來，而不是像個‘偷瞄怪’。'",
        "gal_map_text_203101285=卡洛菲斯笑著挑眉，眼神裡帶著調侃。拿著速寫點了點你的胸口。",
        "gal_map_text_203101286=溫柔眼神？我怎麼沒看出來？明明就是偷偷看我被抓包的窘迫樣。'",
        "gal_map_text_203101287=不過要是重畫，確實該把你‘圖謀不軌’的眼神畫得更明顯點。'",
        "gal_map_text_203101288=卡洛菲斯客觀分析，卻忍不住笑了。",
        "gal_map_text_203101289=不過你說得對，要是能體現出‘刻意靠近’的意圖，畫面會更貼合當時的真實狀態。'",
        "gal_map_text_203101290=哈哈，你居然承認偷偷看我了！'",
        "gal_map_text_203101291=其實…… 我當時也在偷偷看你，只是沒被畫師畫出來。' 卡洛菲斯聲音放輕，'你的眼神本來就很溫柔，不用特意畫，我都能感受到。'",
        "gal_map_text_203101292=卡洛菲斯眼眶微紅，聲音帶著點哽咽。",
        "gal_map_text_203101293=被你這麼一說，我都有點不好意思了。其實我當時就覺得你的眼神好溫柔，心跳都快了好多，沒想到你真的在偷偷看我。'",
        "gal_map_text_203101294=你喜歡就好，我幫你裝起來。你要是喜歡，這張畫就送給你，以後想調侃我了，隨時拿出來看。'",
        "gal_map_text_203101295=卡洛菲斯小心翼翼地把速寫折好放進包裡。",
        "gal_map_text_203101296=算你識相！不過你要是敢後悔，我可饒不了你！以後我想調侃你了，就拿出來看看，讓你再糗一次。'",
        "gal_map_text_203101297=卡洛菲斯認真地把速寫放進包裡。",
        "gal_map_text_203101298=我會好好保存，以後見面就拿出來調侃你，作為你偷偷看我的‘證據’。' 語氣乾脆，卻悄悄將包往你這邊挪了挪。",
        "gal_map_text_203101299=真的送給我嗎？' 卡洛菲斯眼睛亮了起來，緊緊拉著你的手。卻悄悄將包往你這邊挪了挪。",
        "gal_map_text_203101300=我太喜歡這張速寫了！以後我要把它放在我的書桌前，每天都能看到，想起今天和你一起打鬧的快樂時光。'",
        "gal_map_text_203101301=卡洛菲斯聲音軟糯，眼眶微紅。",
        "gal_map_text_203101302=你居然願意把這麼特別的速寫送給我，我真的好開心。以後看到這張速寫，我就會想起你對我的好，想起今天的快樂，我會好好珍藏的。'",
        "gal_map_text_203101303=你看，畫師把我們畫得隔著一點距離，其實當時我都想再靠近你一點，只是怕你覺得唐突。'",
        "gal_map_text_203101304=現在這樣，是不是就和我心裡想的距離一樣了？'",
        "gal_map_text_203101305=你就會說好聽的！'",
        "gal_map_text_203101306=不過…… 確實這樣更真實。",
        "gal_map_text_203101307=那我們現在就補拍一張‘完美版’！你湊近我，我保持這個鬼臉，肯定比速寫還有意思。'",
        "gal_map_text_203101308=你看，這樣是不是就差一點意思都補上了？'",
        "gal_map_text_203101309=哈哈，你這個樣子也太傻了！' 卡洛菲斯搶過手機翻看。",
        "gal_map_text_203101310=不過確實比速寫還親密！這張照片我要保存下來，和速寫放在一起，以後都是調侃你的證據。'",
        "gal_map_text_203101311=本來就是嘛，我偷偷看你是因為你太可愛了，眼神裡都是溫柔，只是畫師沒get到精髓。'",
        "gal_map_text_203101312=你轉頭看向卡洛菲斯，'不過你當時偷偷抿嘴笑的樣子，也被我抓到了，是不是也在想什麼甜甜的事？'",
        "gal_map_text_203101313=你才想甜甜的事呢！'",
        "gal_map_text_203101314=不過…… 當時確實覺得和你靠在一起很開心，所以才忍不住笑了。你的眼神確實很溫柔，我沒騙你。'",
        "gal_map_text_203101315=給你，小心點放好，別弄髒了。'",
        "gal_map_text_203101316=只要你喜歡，以後不管是速寫還是別的，只要能讓你開心，我都願意送給你。'",
        "gal_map_text_203101317=謝謝你，我會好好保存的。'",
        "gal_map_text_203101318=其實只要和你在一起，不管是搞怪的速寫還是平淡的日常，我都覺得很珍貴。'",
        "gal_map_text_203101319=卡洛菲斯把速寫小心翼翼地放進包裡，時不時拿出來翻看兩眼，嘴角一直掛著笑意。卡洛菲斯拉著你的胳膊，手指緊緊扣著你的手腕，打鬧間不經意的觸碰、眼神交匯時的羞澀，都藏著未說出口的心動。",
        "gal_map_text_203101320=遠處的街燈漸漸亮起，Livehouse 的餘韻與歡樂的氛圍交織，兩人的距離在調侃中越來越近，肩膀緊緊挨著，偶爾指尖相觸也不再躲開。",
        "gal_map_text_203101321=這份在歡樂中升溫的情愫，已經臨近臨界點，只差一個合適的契機就能挑明心意。",
        "gal_map_text_203101322=走出溫暖的深夜派對，午夜的商業街幾乎空無一人，只剩下規律閃爍的霓虹和一路綿延的昏黃路燈。",
        "gal_map_text_203101323=地面倒映著兩人拉長的影子，偶爾有晚歸的車輛駛過，留下短暫的光影軌跡後，街道又回歸寂靜。",
        "gal_map_text_203101324=你們沿著街道慢慢走向今晚的終點 —— 地鐵站與停車場的岔路口，腳步放緩，似乎都在珍惜這最後的獨處時光。",
        "gal_map_text_203101325=卡洛菲斯踢著路邊的小石子，頭髮被晚風輕輕吹起，手裡還攥著剛才深夜派對剩下的一顆草莓糖。",
        "gal_map_text_203101326=卡洛菲斯時不時轉頭看你，又快速移開目光，臉頰帶著未褪去的紅暈。",
        "gal_map_text_203101327=走到岔路口，卡洛菲斯停下腳步，抬頭看著你，眼神裡滿是複雜的情緒，有不舍，有期待，還有藏不住的心動。",
        "gal_map_text_203101328=我走到卡洛菲斯身邊，與卡洛菲斯並肩站在路燈下，影子交織在一起。",
        "gal_map_text_203101329=和你在一起的時光，總是過得特別快，每一個瞬間都值得好好珍藏。'",
        "gal_map_text_203101330=其實從空中秋千上你靠在我肩膀的那一刻起，我就有很多話想對你說。'",
        "gal_map_text_203101331=卡洛菲斯輕輕踢著腳邊的小石子，指尖攥緊了手裡的草莓糖。",
        "gal_map_text_203101332=我也是……和你在一起的每一刻都很踏實，不管是鬧哄哄的派對還是安安靜靜的天臺，都讓我覺得很安心。其實我也攢了好多話，一直沒好意思說。'",
        "gal_map_text_203101333=午夜的寂靜與岔路口的 '終點感'，讓氛圍變得格外坦誠。高好感組側重 '深度心意傳遞'，直擊內心；一般好感組側重 '溫和情感表達'，留有餘韻，每個選項都貼合不同性格特質，讓心意自然流淌。",
        "gal_map_text_203101334=說出天臺上心動的瞬間",
        "gal_map_text_203101335=坦誠深夜派對的心意",
        "gal_map_text_203101336=說出專屬與卡洛菲斯的承諾",
        "gal_map_text_203101337=說出今晚回憶最深的舉動",
        "gal_map_text_203101338=分享和卡洛菲斯一起的快樂時光",
        "gal_map_text_203101339=邀約卡洛菲斯下次的約會",
        "gal_map_text_203101340=我記得你在天臺上裹著我外套的樣子，記得你吃草莓舒芙蕾時滿足的笑容，記得你偷偷靠近我時泛紅的臉頰，這些細節都刻在我心裡，想一直照顧你。'",
        "gal_map_text_203101341=卡洛菲斯眼神真誠，輕輕點頭。",
        "gal_map_text_203101342=其實我也注意到你一直護著我，記得我喜歡的口味，被人放在心上的感覺真的很好。'",
        "gal_map_text_203101343=卡洛菲斯思考後，點點頭。",
        "gal_map_text_203101344=被你認真對待的感覺不錯，我也願意和你一起走下去，共同面對以後的日子。'",
        "gal_map_text_203101345=卡洛菲斯眼眶微紅，臉頰發燙。",
        "gal_map_text_203101346=從來沒有人這麼認真記住我的小細節，我真的好感動，我也想一直被你這樣愛著、陪著。'",
        "gal_map_text_203101347=卡洛菲斯緊緊抓住你的手，聲音帶著哽咽。",
        "gal_map_text_203101348=這些細節我自己都快忘了，你卻記得這麼清楚，我真的離不開你了。'",
        "gal_map_text_203101349=從空中秋千到深夜派對，每一刻都因為有你而珍貴，我早就心動了，想和你一直走下去，分享所有喜怒哀樂。'",
        "gal_map_text_203101350=卡洛菲斯興奮地跳起來，緊緊抱住你的胳膊。",
        "gal_map_text_203101351=從空中秋千靠在你肩膀的那一刻，我就心動了，終於等到你說這句話！'",
        "gal_map_text_203101352=卡洛菲斯拉著你的手不停晃動。",
        "gal_map_text_203101353=我早就想告訴你我喜歡你了，一直沒敢說，現在我們終於心意相通了，以後要天天在一起！'",
        "gal_map_text_203101354=卡洛菲斯臉頰微紅，語氣依舊平淡，卻主動靠近你半步。",
        "gal_map_text_203101355=和你在一起很踏實，我也想一直走下去。'",
        "gal_map_text_203101356=卡洛菲斯輕輕應了一聲，眼神卻柔和了許多。",
        "gal_map_text_203101357=我對你也有好感，既然你坦誠了，那我們就試試吧。'",
        "gal_map_text_203101358=今晚不是結束，是開始。我想把你寫進我的未來，從星空秋千走到白髮蒼蒼，你願意成為我生命裡最特別的存在嗎？'",
        "gal_map_text_203101359=卡洛菲斯臉頰爆紅，卻故意揚起下巴。",
        "gal_map_text_203101360=不過…… 我願意！但你要是敢反悔，我可饒不了你！'",
        "gal_map_text_203101361=卡洛菲斯深吸一口氣，眼神堅定。",
        "gal_map_text_203101362=既然你想把我寫進未來，那我也會認真對待，以後有問題一起面對，絕不逃避。'",
        "gal_map_text_203101363=卡洛菲斯撲進你懷裡，聲音軟糯。",
        "gal_map_text_203101364=我當然願意！我一直想和你有以後，從星空秋千到白髮蒼蒼，我都想陪著你。'",
        "gal_map_text_203101365=卡洛菲斯聲音哽咽，緊緊抱著你。",
        "gal_map_text_203101366=我從來不敢奢望有人把我規劃進未來，你願意給我這個機會，我一定會好好珍惜。'",
        "gal_map_text_203101367=今晚的每一個場景都因為有你而特別 —— 星空秋千的浪漫、天臺的靜謐、深夜派對的煙火氣，我想把這些回憶永遠留在心裡。'",
        "gal_map_text_203101368=卡洛菲斯笑著點頭，眼神發亮。",
        "gal_map_text_203101369=這些回憶都特別珍貴，我會好好珍藏，每次想起都會覺得很開心。'",
        "gal_map_text_203101370=卡洛菲斯拉著你的手不停比劃。",
        "gal_map_text_203101371=我現在閉眼都能想起天臺的風、派對的串燈，以後我們要創造更多這樣的回憶！'",
        "gal_map_text_203101372=卡洛菲斯語氣平淡，卻悄悄將頭髮別到耳後。",
        "gal_map_text_203101373=這些場景因為有你，才變得不一樣。'",
        "gal_map_text_203101374=卡洛菲斯輕輕應了一聲。",
        "gal_map_text_203101375=回憶挺美好，我會記住的。'",
        "gal_map_text_203101376=和你在一起的時光很舒服，不管是聊天還是安靜待著，都覺得很安心，希望以後能有更多這樣的瞬間。'",
        "gal_map_text_203101377=你說得對，和你在一起確實很舒服。' 卡洛菲斯客觀回應。",
        "gal_map_text_203101378=這種安心的感覺很難得，我也希望以後能有更多這樣的相處時光。'",
        "gal_map_text_203101379=卡洛菲斯平靜下來，腦中閃過",
        "gal_map_text_203101380=溫和的陪伴有利於關係發展，我不反對以後多見面。'",
        "gal_map_text_203101381=你太懂我了！' 卡洛菲斯臉頰微紅，眼神柔軟。",
        "gal_map_text_203101382=和你在一起不管做什麼都很安心，這種感覺真的很珍貴。'",
        "gal_map_text_203101383=嗚嗚，好溫暖。' 卡洛菲斯眼眶微紅。",
        "gal_map_text_203101384=從來沒有人這麼懂我，和你在一起的每一刻都讓我覺得很踏實。'",
        "gal_map_text_203101385=今晚真的很開心，以後有空的話，想再帶你去更多地方，看更多風景，你願意嗎？'",
        "gal_map_text_203101386=卡洛菲斯笑著點頭，眼神裡滿是期待。",
        "gal_map_text_203101387=只要是你推薦的地方，肯定不會差，我很期待下次見面。'",
        "gal_map_text_203101388=卡洛菲斯語氣乾脆，卻主動拿出手機。",
        "gal_map_text_203101389=那要選擇一天好天氣的日子，我可是有好多風景都想去看一看了。'",
        "gal_map_text_203101390=卡洛菲斯興奮地湊近你。",
        "gal_map_text_203101391=我早就想多出去走走了，有你陪著，我更放心。'",
        "gal_map_text_203101392=卡洛菲斯聲音軟糯，緊緊拉著你的衣袖。",
        "gal_map_text_203101393=只要能和你一起，去哪裡我都願意。'",
        "gal_map_text_203101394=因為你值得被這樣用心對待。'",
        "gal_map_text_203101395=你的笑容、你的羞澀、你的小脾氣，都讓我著迷，我想一直這樣關注你、照顧你。'",
        "gal_map_text_203101396=卡洛菲斯臉頰更紅了，卻緊緊回握你的手。",
        "gal_map_text_203101397=你……我也是。和你在一起，我覺得很踏實、很安心，以後我也會記得你的喜好，把你放在心裡最重要的位置。'",
        "gal_map_text_203101398=聽到你這麼說，我真的太開心了。' 你抬手輕輕拭去卡洛菲斯眼角的淚珠。'",
        "gal_map_text_203101399=以後不管開心還是難過，我都會在你身邊，做你最堅實的依靠。'",
        "gal_map_text_203101400=卡洛菲斯重重點頭，靠在你的肩膀上。",
        "gal_map_text_203101401=我也會在你身邊，支持你、陪伴你，做你最溫暖的港灣，一起面對所有風雨。'",
        "gal_map_text_203101402=謝謝你願意走進我的生命裡。' 你緊緊將卡洛菲斯攬入懷中。",
        "gal_map_text_203101403=以後我會好好愛你、照顧你，讓你永遠都這麼幸福，不讓你受一點委屈。'",
        "gal_map_text_203101404=我相信你。'",
        "gal_map_text_203101405=以後我們一起努力，把日子過得越來越好，讓我們的故事越來越長、越來越甜。'",
        "gal_map_text_203101406=能和你擁有這些回憶，我也覺得很幸運。'",
        "gal_map_text_203101407=以後想起這些瞬間，就能想起今晚的快樂。'",
        "gal_map_text_203101408=卡洛菲斯重重點頭，主動往你身邊靠了靠。",
        "gal_map_text_203101409=我也會把這些回憶好好記下來，等到以後，我們一起翻看。'",
        "gal_map_text_203101410=我也是，這種舒服的相處模式很難得。'",
        "gal_map_text_203101411=不用刻意找話題，也不會覺得尷尬，希望以後能一直這樣。'",
        "gal_map_text_203101412=是啊。' 卡洛菲斯臉頰微紅，嘴角帶著淺淺的笑意。",
        "gal_map_text_203101413=和你在一起，我總能徹底放鬆下來，做最真實的自己。'",
        "gal_map_text_203101414=太好了！'",
        "gal_map_text_203101415=我已經開始琢磨下次要帶你去哪家書店了，肯定不會讓你失望。'",
        "gal_map_text_203101416=卡洛菲斯點點頭，笑容明媚。",
        "gal_map_text_203101417=我相信你，不管去哪裡，只要和你一起，都會很開心。'",
        "gal_map_text_203101418=路燈將兩人的影子拉得很長，緊緊交織在一起。卡洛菲斯靠在你的懷裡，手裡的草莓糖慢慢融化，甜味在舌尖蔓延，像此刻的情愫。",
        "gal_map_text_203101419=岔路口不再是終點，而是彼此心意的起點，直白的心意傳遞讓兩人的心徹底靠近，無需明說，卻已確認了彼此的重要性。",
        "gal_map_text_203101420=商業街的喧囂如潮水般退去，只留下溫柔的寂靜。你們不知不覺走到一處小巧的街心花園，纏繞著星星燈串的長椅散發著暖黃的光芒，照亮了周圍的綠植。",
        "gal_map_text_203101421=遠處還有流浪歌手的餘音隱約飄來，歌聲溫柔舒緩，空氣裡彌漫著夜晚植物的清冽氣息，混合著淡淡的花香，氛圍浪漫又靜謐。",
        "gal_map_text_203101422=卡洛菲斯坐在長椅上，抬頭看著頭頂的星星燈串，手指輕輕撫摸著長椅的木質紋理。",
        "gal_map_text_203101423=卡洛菲斯手裡拿著剛才大頭貼的合照，時不時翻看一眼，嘴角揚起溫柔的笑容。",
        "gal_map_text_203101424=流浪歌手的歌聲傳來，卡洛菲斯跟著輕輕哼唱，轉頭看你時，眼神裡滿是溫柔與期待：'今晚真的很特別，從占卜屋的坦誠到星空糖的挑戰，再到大頭貼的歡樂，每一個瞬間都讓我覺得很珍貴。'",
        "gal_map_text_203101425=對我來說，更特別的是有你。'",
        "gal_map_text_203101426=如果沒有你，這些場景都只是普通的風景。但因為有你，占卜屋的卡牌、星空糖的甜味、大頭貼的笑容，都變得意義非凡。'",
        "gal_map_text_203101427=卡洛菲斯摩挲著手裡的大頭貼，眼神溫柔得像星光。",
        "gal_map_text_203101428=以前不管是占卜還是玩挑戰，都沒這麼開心過。其實從你認真聽我解讀牌意的時候，我就覺得你和別人不一樣。'",
        "gal_map_text_203101429=星燈、歌聲、花香交織的浪漫氛圍，讓心意無需掩飾。高好感組側重 '深度心意傳遞'，契合浪漫氛圍。",
        "gal_map_text_203101430=坦誠本次約會心動的瞬間",
        "gal_map_text_203101431=與卡洛菲斯分享占卜屋的趣事",
        "gal_map_text_203101432=借占卜屋事情與卡洛菲斯定下專屬約定",
        "gal_map_text_203101433=分享本次約會寶貴回憶",
        "gal_map_text_203101434=坦白想一直陪伴在卡洛菲斯身邊",
        "gal_map_text_203101435=向卡洛菲斯發起下次約會邀約",
        "gal_map_text_203101436=其實從占卜時你臉紅著說‘想和我多待一會兒’開始，我就心動了，星空糖挑戰、大頭貼互動，每一刻都讓我確定喜歡你。'",
        "gal_map_text_203101437=卡洛菲斯抓住你的手，臉頰通紅。",
        "gal_map_text_203101438=從你幫我擋水晶的時候，我就對你有好感了，終於等到你說這句話！'",
        "gal_map_text_203101439=卡洛菲斯突然抱住你。",
        "gal_map_text_203101440=我早就喜歡你了，一直沒敢說，現在我們終於心意相通了，以後要天天在一起！'",
        "gal_map_text_203101441=卡洛菲斯臉頰泛紅，語氣依舊平淡，卻主動靠近你。",
        "gal_map_text_203101442=和你在一起很開心，我也喜歡你。'",
        "gal_map_text_203101443=卡洛菲斯輕輕應了一聲，眼神卻柔和了許多。",
        "gal_map_text_203101444=我對你也有好感，既然你坦誠了，那我們就試試吧。'",
        "gal_map_text_203101445=我記得你占卜時認真的樣子，記得你星空糖挑戰時緊張的顫抖，記得你大頭貼裡的搞怪鬼臉，這些瞬間都刻在我心裡。'",
        "gal_map_text_203101446=卡洛菲斯眼神真誠，輕輕點頭。",
        "gal_map_text_203101447=被人這麼珍視的感覺很好，我也很珍惜和你在一起的每一個瞬間。'",
        "gal_map_text_203101448=卡洛菲斯擺出思考的姿態，思考片刻後客官的答覆。",
        "gal_map_text_203101449=這些瞬間我也記得，能被你記住，我很認可。'",
        "gal_map_text_203101450=卡洛菲斯眼眶微紅，聲音帶著哽咽。",
        "gal_map_text_203101451=從來沒有人這麼認真記住我的小細節，我真的好感動。'",
        "gal_map_text_203101452=卡洛菲斯緊緊抓住你的手。",
        "gal_map_text_203101453=這些細節我自己都快忘了，你卻記得這麼清楚，我真的離不開你了。'",
        "gal_map_text_203101454=占卜說我們的緣分是‘命中註定’，我信了，想把你寫進我的未來裡，以後的每一個瞬間都想有你的身影。'",
        "gal_map_text_203101455=卡洛菲斯臉頰爆紅，卻故意揚起下巴。",
        "gal_map_text_203101456=不過…… 我願意！但你要是敢反悔，我可饒不了你！'",
        "gal_map_text_203101457=卡洛菲斯深吸一口氣，眼神堅定。",
        "gal_map_text_203101458=既然你想把我寫進未來，那我也會認真對待，以後有問題一起面對。'",
        "gal_map_text_203101459=卡洛菲斯撲進你懷裡，聲音軟糯。",
        "gal_map_text_203101460=我願意！占卜說得對，我們就是命中註定，我想一直陪著你。'",
        "gal_map_text_203101461=卡洛菲斯聲音哽咽，緊緊抱著你。",
        "gal_map_text_203101462=我從來不敢奢望有人把我規劃進未來，你願意給我這個機會，我一定會好好珍惜。'",
        "gal_map_text_203101463=今晚的每一個場景都很特別 —— 占卜屋的神秘、星空糖的甜蜜、大頭貼的歡樂，這些回憶我會好好珍藏。'",
        "gal_map_text_203101464=卡洛菲斯笑著點頭，眼神發亮。",
        "gal_map_text_203101465=這些回憶都特別珍貴，每次想起都會覺得很開心，星空糖的甜味我現在都記得。'",
        "gal_map_text_203101466=卡洛菲斯拉著你的手不停比劃。",
        "gal_map_text_203101467=我現在閉眼都能想起占卜時的檀香、大頭貼的搞怪道具，以後要創造更多這樣的回憶！'",
        "gal_map_text_203101468=卡洛菲斯語氣平淡，卻悄悄摩挲著手裡的大頭貼。",
        "gal_map_text_203101469=這些場景因為有你，才變得不一樣。'",
        "gal_map_text_203101470=卡洛菲斯輕輕應了一聲。",
        "gal_map_text_203101471=回憶挺美好，我會記住的。'",
        "gal_map_text_203101472=和你在一起的感覺很舒服，不管是占卜時的互動還是挑戰時的配合，都覺得很合拍，希望以後能有更多這樣的相處。'",
        "gal_map_text_203101473=你說得對，和你在一起確實很合拍。'",
        "gal_map_text_203101474=這種默契很難得，我也希望以後能有更多這樣的相處時光。'",
        "gal_map_text_203101475=卡洛菲斯發現從互動表現來看，兩個人的默契程度越來越高。",
        "gal_map_text_203101476=溫和的相處有利於關係發展，我不反對以後多見面。'",
        "gal_map_text_203101477=卡洛菲斯臉頰微紅，眼神柔軟。",
        "gal_map_text_203101478=和你在一起不管做什麼都很默契，這種感覺真的很珍貴。'",
        "gal_map_text_203101479=卡洛菲斯眼眶微紅。",
        "gal_map_text_203101480=從來沒有人這麼懂我，和你在一起的每一刻都讓我覺得很踏實。'",
        "gal_map_text_203101481=今晚真的很開心，如果你願意的話，以後想再帶你體驗更多有意思的事，比如去逛小眾書店、嘗特色甜品。'",
        "gal_map_text_203101482=卡洛菲斯笑著點頭，眼神裡滿是期待。",
        "gal_map_text_203101483=你推薦的地方肯定很有意思，我很期待下次見面。'",
        "gal_map_text_203101484=卡洛菲斯語氣乾脆，卻主動拿出手機。",
        "gal_map_text_203101485=你可要記好這家點名哦，我可是對這家店感興趣很久了。'",
        "gal_map_text_203101486=卡洛菲斯興奮地湊近你。",
        "gal_map_text_203101487=我早就想逛小眾書店了，有你陪著，我更放心。'",
        "gal_map_text_203101488=卡洛菲斯聲音軟糯，緊緊拉著你的衣袖。",
        "gal_map_text_203101489=你願意陪我一起去看看嘛。'",
        "gal_map_text_203101490=聽到你這麼說，我真的太開心了。'",
        "gal_map_text_203101491=以後不管遇到什麼事，我都會在你身邊，開心的時候陪你笑，難過的時候陪你哭。'",
        "gal_map_text_203101492=卡洛菲斯靠在你的肩膀上。",
        "gal_map_text_203101493=我也會在你身邊，支持你、陪伴你，做你最溫暖的港灣，一起面對所有風雨。'",
        "gal_map_text_203101494=因為這些細節都很珍貴，每一個瞬間都因為有你而變得特別。'",
        "gal_map_text_203101495=我想把它們都珍藏起來，到老了還能拿出來回憶。'",
        "gal_map_text_203101496=卡洛菲斯笑著點頭。",
        "gal_map_text_203101497=我們以後可以把這些回憶寫成一本書，記錄我們從占卜屋到白頭的每一個故事。'",
        "gal_map_text_203101498=謝謝你願意走進我的生命裡。'",
        "gal_map_text_203101499=以後我會好好愛你、照顧你，讓你永遠都這麼幸福、這麼快樂。'",
        "gal_map_text_203101500=卡洛菲斯靠在你的懷裡，聲音帶著點哽咽。",
        "gal_map_text_203101501=以後我也會好好愛你，珍惜我們之間的緣分，讓我們的愛情像星星燈一樣，永遠明亮。'",
        "gal_map_text_203101502=能和你擁有這些回憶，我也覺得很幸運。'",
        "gal_map_text_203101503=以後想起這些瞬間，就能想起今晚的快樂。'",
        "gal_map_text_203101504=卡洛菲斯主動往你身邊靠了靠。",
        "gal_map_text_203101505=我也會把這些回憶好好記下來，等到以後，我們一起翻看。'",
        "gal_map_text_203101506=我也是，這種默契的相處模式很難得。'",
        "gal_map_text_203101507=不用刻意找話題，也不會覺得尷尬，希望以後能一直這樣。'",
        "gal_map_text_203101508=卡洛菲斯臉頰微紅，嘴角帶著淺淺的笑意。",
        "gal_map_text_203101509=和你在一起，我總能徹底放鬆下來，做最真實的自己。'",
        "gal_map_text_203101510=太好了！'",
        "gal_map_text_203101511=我已經開始琢磨下次要帶你去哪家書店了，肯定不會讓你失望。'",
        "gal_map_text_203101512=卡洛菲斯點點頭，笑容明媚。",
        "gal_map_text_203101513=我相信你，不管去哪裡，只要和你一起，都會很開心。'",
        "gal_map_text_203101514=流浪歌手的歌聲漸漸遠去，星星燈串的光芒溫柔地籠罩著兩人。卡洛菲斯靠在你的肩膀上，手裡的大頭貼合照被緊緊攥在手心，臉上洋溢著幸福的笑容。",
        "gal_map_text_203101515=空氣裡的花香與彼此的氣息交織，心意在溫柔的氛圍中徹底挑明，無需華麗的辭藻，卻已足夠真摯動人。",
        "gal_map_text_203101516=夜深了，你們拿著那張搞怪又傳神的速寫，漫步到一處相對安靜的街邊小廣場。",
        "gal_map_text_203101517=廣場中央有個老式的廣播喇叭，正播放著舒緩的深夜電臺音樂，音質帶著點沙沙的雜音，卻莫名有種時光沉澱的質感。",
        "gal_map_text_203101518=周圍的街燈散發著昏黃的光芒，偶爾有晚歸的行人匆匆走過，留下短暫的身影後，廣場又回歸寧靜。你們在廣場邊的長椅坐下，手裡的速寫成為此刻最珍貴的紀念。",
        "gal_map_text_203101519=卡洛菲斯看著手裡的速寫，時不時指著畫中的細節笑出聲來，又很快收斂笑容，眼神變得溫柔。",
        "gal_map_text_203101520=深夜電臺的音樂緩緩流淌，卡洛菲斯轉頭看你時，眼神裡滿是深情與期待：'今晚的 Livehouse 真的很燃，街角的速寫也很特別，和你在一起的每一個瞬間，都讓我覺得很快樂、很踏實。'",
        "gal_map_text_203101521=卡洛菲斯頓了頓，聲音放輕，'其實我很久沒有這麼放鬆過了，只有和你在一起，我才能卸下所有的防備，做最真實的自己。'",
        "gal_map_text_203101522=我也是。'",
        "gal_map_text_203101523=和你在一起，我覺得很自在、很開心。Livehouse 的音樂因為有你而更燃，速寫因為有你而更特別，連這深夜的電臺音樂，都因為有你而更溫柔。'",
        "gal_map_text_203101524=卡洛菲斯低頭看著速寫裡搞怪的兩人，嘴角忍不住上揚。",
        "gal_map_text_203101525=其實我早就想告訴你，和你在一起，我才能真正放鬆下來。'",
        "gal_map_text_203101526=老式廣播的時光感與深夜的靜謐，讓氛圍變得格外坦誠。",
        "gal_map_text_203101527=高好感組側重 '深度心意傳遞'，契合熱烈後的溫柔；一般好感組側重 '溫和情感表達'，保留輕鬆與分寸，每個選項都貼合不同性格特質，讓情感自然流淌。",
        "gal_map_text_203101528=坦誠說出約會中心動瞬間",
        "gal_map_text_203101529=分享約會中寶貴的回憶",
        "gal_map_text_203101530=借速寫對卡洛菲斯定下專屬承諾",
        "gal_map_text_203101531=說出今晚印象最深的回憶",
        "gal_map_text_203101532=坦誠說出和卡洛菲斯約會中趣事",
        "gal_map_text_203101533=鼓起勇氣說出心中的想法",
        "gal_map_text_203101534=其實從我們一起合唱的那一刻起，我就被你吸引了，街角速寫、打鬧互動，每一刻都讓我確定，我想和你一直走下去。'",
        "gal_map_text_203101535=卡洛菲斯地抓住你的手，臉頰通紅。",
        "gal_map_text_203101536=從合唱時你靠近我的那一刻，我就心動了，終於等到你說這句話！'",
        "gal_map_text_203101537=卡洛菲斯突然跑過來突然抱住你。",
        "gal_map_text_203101538=我早就喜歡你了，一直沒敢說，現在我們終於心意相通了，以後要一起追更多演出！'",
        "gal_map_text_203101539=卡洛菲斯臉頰泛紅，語氣依舊平淡，卻主動靠近你。",
        "gal_map_text_203101540=能和你在一起很開心，我也喜歡你。'",
        "gal_map_text_203101541=卡洛菲斯輕輕應了一聲，眼神卻柔和了許多。",
        "gal_map_text_203101542=我對你也有好感，既然你坦誠了，那我們就試試吧。'",
        "gal_map_text_203101543=我記得你在 Livehouse 裡跟著音樂搖擺的樣子，記得你調侃速寫時燦爛的笑容，這些細節都讓我心動不已，想一直陪著你。'",
        "gal_map_text_203101544=卡洛菲斯開心的輕輕點頭，臉頰微紅。",
        "gal_map_text_203101545=被人這麼關注的感覺很好，我也很珍惜和你在一起的每一個瞬間。'",
        "gal_map_text_203101546=卡洛菲斯抓住你的手，輕聲說到。",
        "gal_map_text_203101547=這些瞬間我也記得，能被你記住，我很認可。'",
        "gal_map_text_203101548=卡洛菲斯眼眶微紅，聲音帶著哽咽。",
        "gal_map_text_203101549=從來沒有人這麼認真記住我的小細節，我真的好感動。'",
        "gal_map_text_203101550=卡洛菲斯緊緊抓住你的手。",
        "gal_map_text_203101551=這些細節我自己都快忘了，你卻記得這麼清楚，我真的離不開你了。'",
        "gal_map_text_203101552=這張速寫是我們故事的開始，我想把它當成信物，以後的每一次 Livehouse 演出、每一張速寫，都想有你的身影，你願意嗎？'",
        "gal_map_text_203101553=卡洛菲斯臉頰爆紅，卻故意揚起下巴。",
        "gal_map_text_203101554=不過…… 我願意！但你要是敢反悔，我可饒不了你！'",
        "gal_map_text_203101555=卡洛菲斯深吸一口氣，眼神堅定。",
        "gal_map_text_203101556=既然你想把我寫進未來，那我也會認真對待，以後一起追演出、畫速寫。'",
        "gal_map_text_203101557=卡洛菲斯撲進你懷裡，聲音軟糯。",
        "gal_map_text_203101558=我然願意！這張速寫是我們的信物，我想一直陪著你，創造更多故事。'",
        "gal_map_text_203101559=卡洛菲斯聲音哽咽，緊緊抱著你。",
        "gal_map_text_203101560=我從來不敢奢望有人把我規劃進未來，你願意給我這個機會，我一定會好好珍惜。'",
        "gal_map_text_203101561=今晚的 Livehouse 真的很燃，街角的速寫也很特別，這些回憶都很珍貴，我會好好珍藏。'",
        "gal_map_text_203101562=卡洛菲斯笑著點頭，眼神發亮，",
        "gal_map_text_203101563=這些回憶都特別珍貴，Livehouse 的音樂、速寫的細節，我都會好好記住。'",
        "gal_map_text_203101564=卡洛菲斯拉著你的手不停比劃。",
        "gal_map_text_203101565=我現在閉眼都能想起演出的氛圍、速寫的搞怪，以後要創造更多這樣的回憶！'",
        "gal_map_text_203101566=卡洛菲斯語氣平淡，卻悄悄摩挲著手裡的速寫。",
        "gal_map_text_203101567=這些場景因為有你，才變得不一樣。'",
        "gal_map_text_203101568=卡洛菲斯輕輕應了一聲。",
        "gal_map_text_203101569=回憶挺美好，我會記住的。'",
        "gal_map_text_203101570=和你在一起的感覺很舒服，不管是聽演出還是打鬧互動，都覺得很合拍，希望以後能有更多這樣的瞬間。'",
        "gal_map_text_203101571=卡洛菲斯點了點頭，臉上露出開心的表情滿意的回答道。",
        "gal_map_text_203101572=這種默契很難得，我也希望以後能有更多這樣的相處時光。'",
        "gal_map_text_203101573=卡洛菲斯聽到你這樣說，臉上漸漸紅了起來，輕聲說到。",
        "gal_map_text_203101574=溫和的相處有利於關係發展，我不反對以後多見面。'",
        "gal_map_text_203101575=卡洛菲斯臉頰微紅，眼神柔軟。",
        "gal_map_text_203101576=和你在一起不管做什麼都很默契，這種感覺真的很珍貴。'",
        "gal_map_text_203101577=卡洛菲斯眼眶微紅。",
        "gal_map_text_203101578=從來沒有人這麼懂我，和你在一起的每一刻都讓我覺得很踏實。'",
        "gal_map_text_203101579=今晚真的很開心，如果你願意的話，以後有喜歡的樂隊演出，想再約你一起，還想帶你畫更多速寫，怎麼樣？'",
        "gal_map_text_203101580=卡洛菲斯笑著點頭，眼神裡滿是期待。",
        "gal_map_text_203101581=有好的樂隊演出，一定要約我，我也想畫更多速寫。'",
        "gal_map_text_203101582=卡洛菲斯語氣乾脆，卻主動拿出手機。",
        "gal_map_text_203101583=下次就去這個樂隊吧，我對好樂隊也挺感興趣。'",
        "gal_map_text_203101584=卡洛菲斯興奮地湊近你，",
        "gal_map_text_203101585=我早就想追更多演出了，有你陪著，我更放心。'",
        "gal_map_text_203101586=卡洛菲斯聲音軟糯，緊緊拉著你的衣袖。",
        "gal_map_text_203101587=只要能和你一起，不管是聽演出還是畫速寫，我都願意。'",
        "gal_map_text_203101588=合唱時你的聲音貼在我耳邊，我就知道，我不想再錯過你了。'",
        "gal_map_text_203101589=以後不管是熱烈的演出，還是安靜的深夜散步，我都想在你身邊，做你最合拍的搭檔。'",
        "gal_map_text_203101590=卡洛菲斯緊緊抱住你的胳膊。",
        "gal_map_text_203101591=我也想做你的搭檔，陪你追逐所有熱愛，分擔所有煩惱，以後我們的歌單要共用，速寫本要一起填滿。'",
        "gal_map_text_203101592=因為你值得被這樣用心對待。'",
        "gal_map_text_203101593=你在舞臺下發光的樣子、笑起來眉眼彎彎的樣子，都刻在我心裡，想一直陪著你。'",
        "gal_map_text_203101594=卡洛菲斯臉頰發燙，卻大膽地與你對視。",
        "gal_map_text_203101595=我也想陪著你，看你認真聽音樂的樣子、包容我搞怪的樣子，以後我們一起去更多 Livehouse，前排的位置留給彼此。'",
        "gal_map_text_203101596=謝謝你願意走進我的故事裡。'",
        "gal_map_text_203101597=這張速寫我會好好珍藏，以後每一個紀念日，都想和你一起來這裡，讓畫師見證我們的故事。'",
        "gal_map_text_203101598=卡洛菲斯靠在你的懷裡，聲音軟糯卻堅定。",
        "gal_map_text_203101599=以後的故事裡，有你有我，有音樂有速寫，這就是我能想到的最幸福的樣子。'",
        "gal_map_text_203101600=能和你擁有這些回憶，我也覺得很幸運。'",
        "gal_map_text_203101601=以後想起這些瞬間，就能想起今晚的快樂。'",
        "gal_map_text_203101602=卡洛菲斯主動往你身邊靠了靠。",
        "gal_map_text_203101603=我也會把這些回憶好好記下來，等到以後，我們一起翻看。'",
        "gal_map_text_203101604=我也是，這種默契的相處模式很難得。'",
        "gal_map_text_203101605=不用刻意找話題，也不會覺得尷尬，希望以後能一直這樣。'",
        "gal_map_text_203101606=卡洛菲斯臉頰微紅，嘴角帶著淺淺的笑意。",
        "gal_map_text_203101607=和你在一起，我總能徹底放鬆下來，做最真實的自己。'",
        "gal_map_text_203101608=太好了！'",
        "gal_map_text_203101609=我已經開始關注接下來的演出了，有合適的一定第一時間約你。'",
        "gal_map_text_203101610=卡洛菲斯點點頭，笑容明媚。",
        "gal_map_text_203101611=我相信你，不管是聽演出還是畫速寫，只要和你一起，都會很開心。'",
        "gal_map_text_203101612=深夜電臺的音樂漸漸停了，老式廣播傳來輕微的沙沙聲後歸於寂靜。卡洛菲斯靠在你的懷裡，手裡緊緊攥著那張搞怪速寫，臉上洋溢著幸福的笑容。",
        "gal_map_text_203101613=街燈的光芒溫柔地灑在兩人身上，拉長的影子緊緊依偎，仿佛再也不會分開。Livehouse 的余溫、速寫的質感、彼此的氣息交織在一起，心意在靜謐的夜晚徹底交融。",
        "gal_map_text_203101614=昏黃路燈將兩人影子拉得綿長，晚風裹挾著咖啡館殘留的咖啡香與甜品甜香，遠處偶爾有晚歸的車輛駛過，留下短暫的引擎聲後，街道又回歸沉寂。",
        "gal_map_text_203101615=你們沿著人行道慢慢走向岔路口，準備各自奔赴返程的方向，腳步都比來時慢了許多。",
        "gal_map_text_203101616=你抬手示意準備往地鐵站方向走，剛邁出兩步，身後的卡洛菲斯突然輕聲喊住你。",
        "gal_map_text_203101617=卡洛菲斯快步追上來，指尖攥著一枚細細的項鍊，鏈端掛著塊不規則深灰色金屬片，在路燈下泛著冷冽的光澤。",
        "gal_map_text_203101618=卡洛菲斯將金屬片放進你掌心，聲音帶著不易察覺的輕顫。",
        "gal_map_text_203101619=是去年冬天我親手打磨的，材料來自小時候住的老宅。' 卡洛菲斯指尖輕輕劃過金屬片的邊緣，'老宅拆的時候我偷偷撿了塊鐵片，磨了好幾個晚上才弄成這樣。它陪我熬過很多獨自加班的夜晚，現在…… 我想讓它陪著你。'",
        "gal_map_text_203101620=你記得我所有小細節的樣子，讓我覺得把它交給你很安心。'",
        "gal_map_text_203101621=卡洛菲斯，謝謝你願意把這麼珍貴的東西交給我。'",
        "gal_map_text_203101622=這不僅是一塊金屬片，更是你毫無保留的信任。我會好好珍藏它，就像珍藏和你有關的每一個瞬間，以後換我陪著你，不再讓你獨自面對深夜。'",
        "gal_map_text_203101623=金屬片的冰涼與卡洛菲斯掌心的余溫在你手心交織，路燈將兩人的影子疊得愈發緊密，連呼吸都仿佛同步。",
        "gal_map_text_203101624=她踮起腳尖，飛快地吻了吻你的臉頰，然後撲進你懷裡緊緊抱住，聲音悶悶的：'不許弄丟，這是我們的情侶信物！'",
        "gal_map_text_203101625=這枚承載她童年與孤單的金屬片，此刻成了情侶關係的見證，擁抱的溫度、臉頰的觸感，都在宣告：你們正式成為情侶，甜蜜在沉默中炸開。",
        "gal_map_text_203101626=昏黃路燈將兩人影子拉得綿長，晚風裹挾著咖啡館殘留的咖啡香與甜品甜香，遠處偶爾有晚歸的車輛駛過，留下短暫的引擎聲後，街道又回歸沉寂。",
        "gal_map_text_203101627=你們沿著人行道慢慢走向岔路口，準備各自奔赴返程的方向，腳步都比來時慢了許多。",
        "gal_map_text_203101628=你抬手示意準備往地鐵站方向走，剛邁出兩步，身後的卡洛菲斯突然輕聲喊住你。",
        "gal_map_text_203101629=你們走到岔路口，正準備道別，卡洛菲斯突然拉住你的衣袖。",
        "gal_map_text_203101630=卡洛菲斯從包裡掏出一個扁平的亞克力相框，遞到你面前。相框裡沒有照片，而是精心排列著幾樣小物件：一片天臺的枯葉、摩天輪票根碎片、'深夜暖煮' 的關東煮竹簽、還有一縷商業街的細閃絲線，襯著深藍色的卡紙，格外別致。",
        "gal_map_text_203101631=卡洛菲斯指尖輕輕點著相框裡的物件。",
        "gal_map_text_203101632=每一樣都能想起和你在一起的瞬間 —— 天臺的風、秋千的搖晃、派對的煙火氣。本來想自己收藏，但是剛才聽你說想和我走到白頭，突然就想分享給你。'",
        "gal_map_text_203101633=以後看到它，就像重溫了今晚的快樂，也算給我們的未來留個念想。'",
        "gal_map_text_203101634=這個相框太珍貴了，每一件小物件都是我們的獨家回憶。謝謝你把這麼甜的瞬間分享給我，我會把它放在書桌最顯眼的位置，每次看到都能想起今晚和你在一起的快樂。'",
        "gal_map_text_203101635=和你走到白頭的約定，我記在心裡了，會用一輩子去兌現。'",
        "gal_map_text_203101636=你捧著相框，裡面的小物件還帶著今晚的溫度與煙火氣，天臺枯葉殘留著晚風的觸感，票根碎片泛著霓虹的微光。",
        "gal_map_text_203101637=卡洛菲斯背著手站在一旁，笑著看你小心翼翼收好，指尖無意識摩挲著包帶，臉頰還帶著未褪去的紅暈。這枚裝滿細碎回憶的相框，讓陪伴關係在甜蜜中定格，溫柔綿長，如同此刻街道的靜謐與溫暖。",
        "gal_map_text_203101638=昏黃路燈將兩人影子拉得綿長，晚風裹挾著咖啡館殘留的咖啡香與甜品甜香，遠處偶爾有晚歸的車輛駛過，留下短暫的引擎聲後，街道又回歸沉寂。",
        "gal_map_text_203101639=你們沿著人行道慢慢走向岔路口，準備各自奔赴返程的方向，腳步都比來時慢了許多。",
        "gal_map_text_203101640=你抬手示意準備往地鐵站方向走，剛邁出兩步，身後的卡洛菲斯突然輕聲喊住你。",
        "gal_map_text_203101641=你說了句 '下次再約' 準備轉身，卡洛菲斯突然開口喊住你。",
        "gal_map_text_203101642=卡洛菲斯攥著手裡沒吃完的草莓糖，快步走到你面前，主動拉住你的手。",
        "gal_map_text_203101643=我剛才一直在想，今晚的星空秋千、天臺、深夜派對，每一刻都好珍貴。'",
        "gal_map_text_203101644=你說想創造更多瞬間，我願意呀。以後我們常來這家咖啡館，常去天臺看夜景，把這裡當成我們的專屬小據點，好不好？'",
        "gal_map_text_203101645=好啊，太好不過了。我早就想有一個和你專屬的小據點了，以後不管是開心還是想放鬆，我們都來這裡。星空秋千、天臺夜景，還有和你在一起的每一刻，我都想永遠珍藏。'",
        "gal_map_text_203101646=手牽手的影子在路燈下交織纏繞，草莓糖的甜味仿佛從卡洛菲斯的指尖悄悄蔓延過來。你們並肩站在岔路口，身後的咖啡館還亮著一盞暖燈，像是為這場約會保留最後的溫柔。沒有信物，卻有無需多言的心意默契，晚風輕輕吹過，帶著彼此的氣息，陪伴關係在無聲中確立，連沉默都顯得格外愜意。",
        "gal_map_text_203101647=昏黃路燈將兩人影子拉得綿長，晚風裹挾著咖啡館殘留的咖啡香與甜品甜香，遠處偶爾有晚歸的車輛駛過，留下短暫的引擎聲後，街道又回歸沉寂。",
        "gal_map_text_203101648=你們沿著人行道慢慢走向岔路口，準備各自奔赴返程的方向，腳步都比來時慢了許多。",
        "gal_map_text_203101649=你抬手示意準備往地鐵站方向走，剛邁出兩步，身後的卡洛菲斯突然輕聲喊住你。",
        "gal_map_text_203101650=你揮手道別後轉身走向停車場，剛走幾步就聽到身後卡洛菲斯的聲音。",
        "gal_map_text_203101651=等一下！'",
        "gal_map_text_203101652=卡洛菲斯正快步朝你跑來，臉頰泛紅，手指輕輕絞著衣角。",
        "gal_map_text_203101653=卡洛菲斯抬頭看著你，笑容在霓虹下格外明媚。",
        "gal_map_text_203101654=以後還有很多機會，明天晚上我們再來這條街散步，或者去吃你說過的那家甜品店，怎麼樣？'",
        "gal_map_text_203101655=我當然願意！今晚的時光我也覺得不夠長，能和你再一起散步、吃甜品，我求之不得。",
        "gal_map_text_203101656=那家甜品店的招牌我都記好了，明天晚上我們就去，讓快樂繼續延續。'",
        "gal_map_text_203101657=你點頭時，卡洛菲斯眼裡迸發出的光芒比岔路口的霓虹還要耀眼。兩人並肩站得很近，影子緊緊依偎，晚風掀起卡洛菲斯的髮絲，拂過你的胳膊，帶來淡淡的清香。沒有信物，卻有明確的同行約定，關係簡單純粹，帶著對下一次見面的期待，街道的靜謐與遠處隱約的車聲，都成了這份期待的背景音。",
        "gal_map_text_203101658=星星燈串纏繞著長椅的扶手，暖黃的光灑在周圍的綠植上，投下斑駁的光影。",
        "gal_map_text_203101659=流浪歌手的歌聲早已遠去，只留下空氣裡淡淡的花香與檀香混合的氣息。你們從長椅上站起身，整理好衣物，準備離開這片靜謐的小花園，夜色已經漸漸深了。",
        "gal_map_text_203101660=你邁步走向花園出口，卡洛菲斯突然在身後喊住你。",
        "gal_map_text_203101661=等等我。'",
        "gal_map_text_203101662=卡洛菲斯從包裡翻出一個深紫色絲絨小盒，快步走到你面前，輕輕打開。裡面是一枚塔羅 '戀人' 牌吊墜，邊緣刻著細密的星紋，背面還刻著一個小小的 '莉' 字，在星燈的映照下泛著柔和的光。",
        "gal_map_text_203101663=這是我十八歲生日時外婆送我的，'",
        "gal_map_text_203101664=外婆說它能幫我找到心意相通的人，我戴了很多年，從來沒摘下來過。'",
        "gal_map_text_203101665=卡洛菲斯把絲絨盒放進你手心，指尖微微發燙，'今晚占卜說我們是‘命中註定’，你也坦誠了心意，我想把它送給你，當成我們相遇的見證。'",
        "gal_map_text_203101666=卡洛菲斯，我真的不知道該說什麼好。這枚吊墜承載著外婆的祝福和你的心意，是最珍貴的禮物。'",
        "gal_map_text_203101667=我會好好戴著它，讓它見證我們每一次的相遇和陪伴，我也會像外婆期待的那樣，做和你心意相通的人，永遠珍惜你。'",
        "gal_map_text_203101668=絲絨盒的觸感細膩柔軟，吊墜帶著一絲殘留的體溫，冰涼中藏著溫柔。卡洛菲斯順勢靠在你的肩膀上，語氣滿是安心，呼吸輕輕拂過你的脖頸。",
        "gal_map_text_203101669=這枚承載著長輩祝福與多年珍藏的吊墜，成了你們心意相通的最好證明，關係在緣分的羈絆中悄然定格，星燈的光芒溫柔籠罩著兩人，花香與檀香交織，氛圍格外繾綣。",
        "gal_map_text_203101670=星星燈串纏繞著長椅的扶手，暖黃的光灑在周圍的綠植上，投下斑駁的光影。",
        "gal_map_text_203101671=流浪歌手的歌聲早已遠去，只留下空氣裡淡淡的花香與檀香混合的氣息。你們從長椅上站起身，整理好衣物，準備離開這片靜謐的小花園，夜色已經漸漸深了。",
        "gal_map_text_203101672=你們走到花園門口，正準備道別，卡洛菲斯突然拉住你的手腕。",
        "gal_map_text_203101673=等一下，有個東西要給你。'",
        "gal_map_text_203101674=卡洛菲斯從包裡掏出一個巴掌大的復古鐵皮糖果盒，盒身印著璀璨的星空圖案，輕輕搖晃時，裡面傳來 '噠、噠' 的輕響。",
        "gal_map_text_203101675=卡洛菲斯打開盒子，裡面裝著幾顆和星空糖挑戰時同款的糖果，還有一張折疊的便簽，上面寫著：'星空糖的約定：每次見面，一起吃一顆。'",
        "gal_map_text_203101676=我小時候就喜歡收集這種鐵皮盒，特意為今晚準備的。'",
        "gal_map_text_203101677=裡面的星空糖和那晚的味道一模一樣，以後看到它，就能想起街心花園的歌聲、我們一起許的願望，還有這場甜甜的相遇。'",
        "gal_map_text_203101678=這個糖果盒太可愛了，謝謝你為我準備這麼用心的禮物。'",
        "gal_map_text_203101679=星空糖的味道我一直記得，以後每次和你見面吃一顆，就讓這份甜蜜一直延續下去。街心花園的歌聲和願望，我也會永遠記在心裡。'",
        "gal_map_text_203101680=糖果盒碰撞的聲音清脆悅耳，便簽上的字跡娟秀可愛。卡洛菲斯指尖摩挲著盒身的星空圖案，笑容溫柔得像夜色裡的星光。",
        "gal_map_text_203101681=這枚裝滿甜蜜回憶的糖果盒，讓你們的關係在甜味中定格，純粹而美好，星燈的光暈灑在兩人身上，連空氣都變得甜絲絲的。",
        "gal_map_text_203101682=星星燈串纏繞著長椅的扶手，暖黃的光灑在周圍的綠植上，投下斑駁的光影。",
        "gal_map_text_203101683=流浪歌手的歌聲早已遠去，只留下空氣裡淡淡的花香與檀香混合的氣息。你們從長椅上站起身，整理好衣物，準備離開這片靜謐的小花園，夜色已經漸漸深了。",
        "gal_map_text_203101684=你轉身準備往主街方向走，身後的卡洛菲斯突然喊住你。",
        "gal_map_text_203101685=卡洛菲斯快步追上來，握住你的手，眼裡閃著星燈映照的光。",
        "gal_map_text_203101686=其實我在月光願望罐裡寫的願望，就是想和你有更多交集。'",
        "gal_map_text_203101687=以後我們常來這裡吧，每次都寫一張願望紙條，攢夠一遝就一起拆開看，看看我們的心願會不會慢慢實現，好不好？'",
        "gal_map_text_203101688=好！這個約定太浪漫了。我其實也一直在期待和你有更多交集，以後我們就常來這裡寫願望，把每一份期待都攢起來。'",
        "gal_map_text_203101689=等攢夠一遝拆開的時候，我相信我們的心願都會實現，因為有你在身邊。'",
        "gal_map_text_203101690=星星燈的光芒灑在你們交握的手上，卡洛菲斯的手心溫暖而柔軟，緊緊包裹著你的指尖。沒有信物，卻有彼此默契的許願約定，關係裡藏著對未來的美好期許，浪漫而真摯。夜風輕輕吹過，帶來淡淡的花香，星燈的光影在地面晃動，仿佛在為這份約定祝福。",
        "gal_map_text_203101691=星星燈串纏繞著長椅的扶手，暖黃的光灑在周圍的綠植上，投下斑駁的光影。",
        "gal_map_text_203101692=流浪歌手的歌聲早已遠去，只留下空氣裡淡淡的花香與檀香混合的氣息。你們從長椅上站起身，整理好衣物，準備離開這片靜謐的小花園，夜色已經漸漸深了。",
        "gal_map_text_203101693=你們走出街心花園，站在主街的路燈下準備分開，卡洛菲斯突然開口。",
        "gal_map_text_203101694=卡洛菲斯撫摸著口袋裡的大頭貼合照，臉頰泛紅，語氣帶著羞澀卻認真。",
        "gal_map_text_203101695=我從來沒被人這麼珍視過，今晚真的很感動。' 卡洛菲斯抬頭看你，眼裡滿是期待，'我想下次帶你去一家小眾書店，裡面有很多塔羅和星座的書，你應該會喜歡。下週末我們就去吧，怎麼樣？'",
        "gal_map_text_203101696=我當然願意！能被你放在心上，我也很感動。'",
        "gal_map_text_203101697=小眾書店聽起來就很有意思，尤其是能和你一起去，不管是看塔羅書還是星座書，我都會很開心。下週末我一定準時赴約，期待和你的再次見面。'",
        "gal_map_text_203101698=你點頭時，卡洛菲斯的笑容瞬間在臉上綻放，比街燈還要明亮。兩人並肩站在路燈下，沒有過多的肢體接觸，卻能清晰感受到彼此傳遞的心意。沒有信物，卻有明確的重逢約定，關係簡單而真摯，帶著對下一次見面的滿心期待，夜色都變得格外溫柔。",
        "gal_map_text_203101699=深夜電臺的音樂已經停了，老式廣播傳來輕微的沙沙聲後歸於寂靜。",
        "gal_map_text_203101700=手裡的速寫還帶著紙張的溫熱，周圍的街燈散發著昏黃的光芒，偶爾有晚歸的行人匆匆走過，留下短暫的身影後，廣場又恢復了寧靜。",
        "gal_map_text_203101701=你們並肩從長椅上站起身，準備各自返程，Livehouse 的音樂餘韻似乎還在耳邊縈繞。",
        "gal_map_text_203101702=你抬手看了眼時間，準備說再見，身後的卡洛菲斯突然喊住你。",
        "gal_map_text_203101703=卡洛菲斯從包裡取出一個扁平的小木盒，走到你面前輕輕打開，裡面是一張裝裱在卡紙上的聲紋圖，線條起伏錯落，格外別致。",
        "gal_map_text_203101704=這是我們剛才在 Livehouse 合唱的聲紋，聲紋和指紋一樣，都是獨一無二的。這裡是你唱高音的部分，這裡是我合聲的地方，就像我們現在這樣，彼此契合。'",
        "gal_map_text_203101705=送給你，以後看到它，就能想起我們一起合唱的夜晚，想起這份合拍的心動。'",
        "gal_map_text_203101706=卡洛菲斯，這太有意義了！聲紋是獨一無二的，就像我們之間的合拍一樣。'",
        "gal_map_text_203101707=謝謝你把這麼特別的瞬間變成了可以珍藏的禮物，我會好好保存這個木盒，每次看到它，就會想起和你在 Livehouse 合唱的心動瞬間，以後我們還要一起唱更多的歌，留下更多專屬我們的聲紋。'",
        "gal_map_text_203101708=木盒的觸感溫潤細膩，聲紋圖的線條清晰分明，仿佛能再次聽到那晚的合唱與台下的歡呼。卡洛菲斯輕輕靠在你的懷裡，呼吸輕柔而平穩，髮絲的清香混合著 Livehouse 殘留的煙火氣。",
        "gal_map_text_203101709=這張承載著熱愛與默契的聲紋圖，讓你們的關係在熱烈中定格，合拍而堅定，街燈的光芒溫柔地灑在兩人身上，拉長的影子緊緊依偎",
        "gal_map_text_203101710=深夜電臺的音樂已經停了，老式廣播傳來輕微的沙沙聲後歸於寂靜。",
        "gal_map_text_203101711=手裡的速寫還帶著紙張的溫熱，周圍的街燈散發著昏黃的光芒，偶爾有晚歸的行人匆匆走過，留下短暫的身影後，廣場又恢復了寧靜。",
        "gal_map_text_203101712=你們並肩從長椅上站起身，準備各自返程，Livehouse 的音樂餘韻似乎還在耳邊縈繞。",
        "gal_map_text_203101713=你們走到廣場出口，正準備道別，卡洛菲斯突然拉住你。",
        "gal_map_text_203101714=等一下，我有個東西要送你。' 卡洛菲斯從包裡掏出一支深藍色的錄音筆，外殼印著細碎的星河圖案，在燈光下泛著微光。",
        "gal_map_text_203101715=這個送給你，別嫌它小。'",
        "gal_map_text_203101716=我每次去聽現場都會帶著它，它‘聽’過的歌比我還多。剛才在 Livehouse，我偷偷錄了我們的合唱和現場的歡呼聲，想著今晚這麼開心，就想把這份熱鬧分享給你。'",
        "gal_map_text_203101717=卡洛菲斯按下播放鍵，熟悉的歌聲輕輕流出。",
        "gal_map_text_203101718=怎麼會嫌小！這是最珍貴的‘聲音相冊’啊。'",
        "gal_map_text_203101719=謝謝你把這份熱鬧和快樂分享給我，以後我們不管去聽什麼演出，都帶著它，把每一次的合拍和快樂都錄下來，攢成我們專屬的回憶。每次聽到這些聲音，就像回到了和你在一起的快樂時光。'",
        "gal_map_text_203101720=錄音筆泛著星河般的光澤，熟悉的合唱聲在寂靜的廣場上輕輕流淌。卡洛菲斯靠在你身邊，跟著旋律輕輕哼唱，笑容明媚得像星光。",
        "gal_map_text_203101721=這支承載著現場熱烈氛圍的錄音筆，讓你們的關係在音樂共鳴中定格，充滿熱愛與期待，街燈的光暈與錄音筆的微光交織，氛圍格外溫暖。",
        "gal_map_text_203101722=深夜電臺的音樂已經停了，老式廣播傳來輕微的沙沙聲後歸於寂靜。",
        "gal_map_text_203101723=手裡的速寫還帶著紙張的溫熱，周圍的街燈散發著昏黃的光芒，偶爾有晚歸的行人匆匆走過，留下短暫的身影後，廣場又恢復了寧靜。",
        "gal_map_text_203101724=你們並肩從長椅上站起身，準備各自返程，Livehouse 的音樂餘韻似乎還在耳邊縈繞。",
        "gal_map_text_203101725=你轉身準備走向地鐵站，身後的卡洛菲斯突然喊住你。",
        "gal_map_text_203101726=等一下！' 卡洛菲斯快步追上來，握緊你的手，眼眶微微泛紅：'其實我也很喜歡你，剛才合唱的時候，我覺得整個世界只剩下我們兩個人。'",
        "gal_map_text_203101727=這是我第一次和別人一起聽現場，也是最開心的一次。以後有我喜歡的樂隊演出，我可以約你一起嗎？'",
        "gal_map_text_203101728=想和你聽更多歌，感受更多現場的熱烈，把每一場演出都變成我們的回憶。'",
        "gal_map_text_203101729=卡洛菲斯，我也喜歡你！和你一起聽現場、一起合唱的時光，是我最開心的時刻。'",
        "gal_map_text_203101730=以後你不管喜歡什麼樂隊的演出，隨時都可以約我，我一定陪你去。我們把每一場演出都變成我們的專屬回憶，一起感受現場的熱烈，一起創造更多快樂的瞬間。這張票根我會好好珍藏，當成我們共同熱愛的開始。'",
        "gal_map_text_203101731=天臺無任何單一場館的強綁定元素，三個迷你紀念物僅作為回憶點綴，串燈與星空營造出 '專屬二人世界' 的氛圍。遠處城市的燈火與星空交相輝映，你們並肩坐在長椅上，偶爾有晚風吹過，帶著彼此的氣息，成為你們定情的最佳見證。",
        "gal_map_text_203101732=深夜電臺的音樂已經停了，老式廣播傳來輕微的沙沙聲後歸於寂靜。",
        "gal_map_text_203101733=手裡的速寫還帶著紙張的溫熱，周圍的街燈散發著昏黃的光芒，偶爾有晚歸的行人匆匆走過，留下短暫的身影後，廣場又恢復了寧靜。",
        "gal_map_text_203101734=你們並肩從長椅上站起身，準備各自返程，Livehouse 的音樂餘韻似乎還在耳邊縈繞。",
        "gal_map_text_203101735=你們走出小廣場，站在街燈下拉開車門準備上車，卡洛菲斯突然敲了敲你的車窗。",
        "gal_map_text_203101736=卡洛菲斯將手裡的搞怪速寫遞給你，嘴角帶著溫柔的笑意。",
        "gal_map_text_203101737=和你在一起真的很快樂，不管是打鬧還是聽音樂，都覺得很自在。'",
        "gal_map_text_203101738=這個給你，以後我們一起畫更多速寫吧，去公園、去海邊，把我們去過的每一個地方都畫下來。其實我一直想學畫畫，你能當我的‘專屬模特’嗎？我們一邊畫一邊玩，慢慢創造更多回憶。'",
        "gal_map_text_203101739=當然可以！能當你的專屬模特，我很榮幸。'",
        "gal_map_text_203101740=和你在一起的時光不管是打鬧還是聽音樂，都讓我覺得很自在、很快樂。以後我們就一起去公園、去海邊，畫更多的速寫，把每一個去過的地方都變成我們的回憶。我會陪著你一起學畫畫，見證你的每一次進步。'",
        "gal_map_text_203101741=你接過速寫，上面的搞怪形象格外鮮活，仿佛能重現當時的歡樂場景。卡洛菲斯眼裡滿是期待的光芒，雖然沒有肢體接觸，卻能感受到彼此的親近。沒有信物，卻有速寫本的同行約定，關係簡單而充滿樂趣，街燈的光芒照亮速寫本的紙面，也照亮了兩人對未來的期待。",
        "gal_map_text_203101742=同一深夜，你們回到最初相遇的商業街街角，手裡捧著收集的所有信物，路燈與遠處的霓虹交織成溫柔的光，晚風帶著淡淡的煙火氣，為這場約會畫上圓滿的句點。",
        "gal_map_text_203101743=你們並肩坐在街角的長椅上，卡洛菲斯小心翼翼地將所有信物一一擺放在面前 —— 老宅金屬片項鍊、拼貼相框、絲絨盒吊墜、鐵皮糖果盒、聲紋圖木盒、星河錄音筆，在燈光下泛著不同的光澤，像一串串聯回憶的星星。",
        "gal_map_text_203101744=沒想到我們已經有這麼多回憶了。每一個信物，都能想起當時的心情，想起和你在一起的點點滴滴。'",
        "gal_map_text_203101745=其實從第一次見面，我就覺得和你很合拍。這些信物不是什麼沉重的約定，只是我想把心裡的在意，都變成能摸到的東西，變成我們一起走過的證明。'",
        "gal_map_text_203101746=以後不管我們去什麼地方，經歷什麼事，我都會把這些回憶好好珍藏，也想和你創造更多值得收藏的瞬間，在這串‘星光’後面，添上更多屬於我們的印記。'",
        "gal_map_text_203101747=卡洛菲斯沒有說 '永遠'，也沒有說 '承諾'，只是輕輕拿起一枚信物放進你手心，又拿起另一枚自己收好。",
        "gal_map_text_203101748=卡洛菲斯，這些信物對我來說，是最珍貴的寶藏。'",
        "gal_map_text_203101749=每一枚都承載著我們的回憶和心意，我會好好珍藏。我期待和你一起，在這串‘星光’後面添上更多屬於我們的印記，讓我們的故事一直延續下去，慢慢書寫更多溫暖的篇章。'",
        "gal_map_text_203101750=所有信物在長椅上排成一排，在路燈與霓虹的映照下泛著柔和的光。你們並肩坐著，偶爾拿起某件信物，輕聲說起當時的場景 —— 路燈下的金屬片、街心花園的糖果盒、小廣場的聲紋圖。",
        "gal_map_text_203101751=沒有華麗的誓約，沒有刻意的表白，卻有滿溢的心意與對未來的無限期待。這些信物承載著彼此的過往、當下的甜蜜與未來的憧憬，讓陪伴關係變得格外厚重。",
        "gal_map_text_203101752=你們沒有明確說 '在一起'，卻早已是彼此生命裡最珍貴的存在，未來的路，將在一枚枚新信物的見證下，慢慢延伸，溫暖而堅定。",
        "gal_map_text_202100000=週五傍晚的商業街燈火璀璨，草莓糖葫蘆的甜脆混著扭蛋機的哢嗒聲，遠處遊戲廳的電子樂隱約傳來。",
        "gal_map_text_202100001=你在泡泡瑪特盲盒店門口的長椅等候，阿米菈背著毛絨背包小跑而來，卡通徽章隨著動作晃悠，馬尾甩得輕快。",
        "gal_map_text_202100002=阿米菈原地小跳一下，眼睛亮如星辰：'報告！可愛能量已充滿！快說，今天的神秘約會地點是什麼？'",
        "gal_map_text_202100003=商業街人流熙攘，三家特色場館的招牌格外醒目：「毛球行星」的雲朵拱門飄著彩色氣球，「香氣遊樂園」的香水瓶大門噴著彩虹霧氣，「聲音糖果屋」的圓門像放大的復古糖果罐，每個場館都透著獨特的吸引力。",
        "gal_map_text_202100004=阿米菈踮腳張望，手指點著下巴打轉。",
        "gal_map_text_202100005=哇，看起來都好有意思！不過我可有個小條件 —— 選的地方必須能讓我玩得盡興，還得有點挑戰感，可別讓我輕易覺得無聊哦！'",
        "gal_map_text_202100006=阿米菈挑眉看向你，眼底藏著狡黠，顯然在期待你的選擇能帶來驚喜。",
        "gal_map_text_202100007=「毛球行星」手工體驗",
        "gal_map_text_202100008=「香氣遊樂園」調香冒險",
        "gal_map_text_202100009=「聲音糖果屋」錄音挑戰",
        "gal_map_text_202100010=一起戳羊毛氈做流體畫，專屬我們的小創作。'",
        "gal_map_text_202100011=阿米菈拉住你的袖子輕輕搖晃，指尖蹭過你的手腕。",
        "gal_map_text_202100012=哇！手工創作聽起來好棒，我動手能力超差，你可得多幫我呀！'",
        "gal_map_text_202100013=阿米菈湊近你，肩膀幾乎貼在一起，眼神滿是依賴。",
        "gal_map_text_202100014=太好了！我一個人肯定做不好，全程都要靠你指導啦！'",
        "gal_map_text_202100015=阿米菈挺起胸膛，假裝倔強卻忍不住笑。",
        "gal_map_text_202100016=手工嗎？雖然我不太擅長，但可以試試！不過我要自己設計造型哦！'",
        "gal_map_text_202100017=阿米菈挑眉挑戰，卻悄悄記下你喜歡的顏色。",
        "gal_map_text_202100018=可以，手工我能搞定，但我們得比賽誰做得更有創意！'",
        "gal_map_text_202100019=扭香味配方，調製專屬香水。'",
        "gal_map_text_202100020=阿米菈拉著你往場館方向走，腳步輕快。",
        "gal_map_text_202100021=調香水！聽起來好浪漫又刺激，我要選最奇幻的配方挑戰一下！'",
        "gal_map_text_202100022=阿米菈蹦蹦跳跳地在前帶路，時不時回頭招手。",
        "gal_map_text_202100023=哇！可以扭盲盒配方還能自己調？這也太酷了吧！我們趕緊去，我要扭到最特別的香味！'",
        "gal_map_text_202100024=阿米菈語氣平靜，卻悄悄加快了腳步。",
        "gal_map_text_202100025=調香聽起來很有趣，我對氣味很敏感，說不定能調出獨特的味道。'",
        "gal_map_text_202100026=阿米菈點頭應允，眼神裡藏著期待。",
        "gal_map_text_202100027=可以，調香需要耐心，我能專注完成，但配方得我們一起選。'",
        "gal_map_text_202100028=錄個性化聲音，做聲音明信片。'",
        "gal_map_text_202100029=阿米菈側耳傾聽場館裡的笑聲，眼神好奇。",
        "gal_map_text_202100030=聲音明信片？好特別！能錄下我們的互動，以後聽起來肯定很有意思。'",
        "gal_map_text_202100031=阿米菈清了清嗓子，準備大展身手。",
        "gal_map_text_202100032=這個好！我能模仿好多聲音，我們可以錄一段搞怪對話，保證讓你印象深刻！'",
        "gal_map_text_202100033=阿米菈撓撓頭，笑容憨厚。",
        "gal_map_text_202100034=錄音嗎？好像挺新鮮的，我沒試過，跟著你玩就好。'",
        "gal_map_text_202100035=可以，錄音簡單，我配合你就行，不過別錄太傻的內容。'",
        "gal_map_text_202100036=阿米菈語氣平淡，卻悄悄整理了衣領。",
        "gal_map_text_202100037=放心，我會幫你但不代勞，我們一起完成專屬作品。'",
        "gal_map_text_202100038=成交！不過要是我做砸了，你可不能笑我，還得陪我一起補救！'",
        "gal_map_text_202100039=阿米菈伸手勾住你的小指，笑容狡黠。",
        "gal_map_text_202100040=扭到什麼配方都不怕，我們一起平衡氣味，打造專屬香氣。'",
        "gal_map_text_202100041=好！要是調出來的味道很奇怪，你也得收下，還得天天用！'",
        "gal_map_text_202100042=阿米菈眨著眼睛，嘴角上揚。",
        "gal_map_text_202100043=我們可以錄點特別的，以後看到明信片就能想起今天的時光。'",
        "gal_map_text_202100044=成交！但我要當主導，你得聽我指揮，不准笑場哦！'",
        "gal_map_text_202100045=阿米菈叉著腰，假裝嚴肅。",
        "gal_map_text_202100046=你選定場館後，阿米菈眼睛亮得更甚，拉著你快步走向目的地，嘴裡嘰嘰喳喳地猜測著裡面的場景。",
        "gal_map_text_202100047=不知道裡面有沒有隱藏玩法？我一定要解鎖全部體驗！' 阿米菈的指尖緊緊握著你的手腕，溫熱的觸感傳來，讓這場約會的期待值瞬間拉滿。",
        "gal_map_text_202100048=著阿米菈的腳步走進選定的場館，獨特的氛圍瞬間包裹住你們。柔軟的羊毛香氣、奇妙的混合香味或是歡樂的錄音笑聲，都為這場約會增添了別樣的色彩。",
        "gal_map_text_202100049=阿米菈像好奇的小貓，四處打量，很快就被某個角落吸引，一場充滿意外與驚喜的互動即將展開。",
        "gal_map_text_202100050=推開雲朵狀的拱門，暖融融的羊毛與甜膩膠水味撲面而來。鵝黃色燈光下，牆上掛滿了色彩斑斕的羊毛氈和流體畫，操作區的籃子裡裝滿了蓬鬆的彩色羊毛、戳針和奶油膠。",
        "gal_map_text_202100051=阿米菈發出一聲驚歎，眼睛瞪得圓溜溜的，蹲在粉色羊毛前，指尖小心翼翼地戳了戳：'這也太軟了吧！感覺像在摸雲！'",
        "gal_map_text_202100052=哇，好蓬鬆！我要做一個超可愛的小貓羊毛氈，還要用奶油膠給它裝飾寶石眼睛！",
        "gal_map_text_202100053=羊毛要順著一個方向戳才緊實，我幫你準備材料，你先選喜歡的顏色組合。",
        "gal_map_text_202100054=就粉白配色！像小奶貓一樣！不過…… 我動手能力超差，你可不能嘲笑我做的歪瓜裂棗哦！",
        "gal_map_text_202100055=阿米菈拿起戳針開始嘗試，專注地抿著嘴唇，一下一下地戳著羊毛。可蓬鬆的羊毛根本不聽指揮，要麼歪向一邊，要麼戳得太用力散了架。",
        "gal_map_text_202100056=她急得鼻尖沁出細汗，戳針不小心戳到手指，疼得她輕輕嘶了一聲，卻倔強地揉了揉手指繼續嘗試。",
        "gal_map_text_202100057=手把手教阿米菈塑形",
        "gal_map_text_202100058=幫阿米菈調整羊毛團",
        "gal_map_text_202100059=教阿米菈找發力技巧",
        "gal_map_text_202100060=我扶著你的手，找對力度。'",
        "gal_map_text_202100061=阿米菈乖乖伸出手，指尖微微顫抖，臉頰泛起紅暈。",
        "gal_map_text_202100062=哇，好！你可得輕點，別弄疼我～'",
        "gal_map_text_202100063=阿米菈主動靠近，肩膀貼緊你的胸膛，呼吸溫熱地拂過你的手腕。",
        "gal_map_text_202100064=太好了！有你幫忙肯定能成！'",
        "gal_map_text_202100065=阿米菈眼神專注，卻忍不住偷偷瞟向你貼近的手。",
        "gal_map_text_202100066=嗯，這樣效率更高，你說我做。'",
        "gal_map_text_202100067=阿米菈語氣平靜，手指卻下意識收緊，握住你的手。",
        "gal_map_text_202100068=麻煩你指導發力點，我會快速掌握。'",
        "gal_map_text_202100069=讓我來，我幫你塑形。'",
        "gal_map_text_202100070=阿米菈把羊毛團塞進你手裡，托著下巴湊過來圍觀。",
        "gal_map_text_202100071=好耶！快救救我的小奶貓！它再這樣就要變成歪脖子啦！'",
        "gal_map_text_202100072=阿米菈圍著你轉了半圈，手指點著桌面催促。",
        "gal_map_text_202100073=拜託拜託！你一定要把它變圓！變圓了我請你喝奶茶！'",
        "gal_map_text_202100074=阿米菈坐在旁邊，雙手放在膝蓋上，眼神專注地看著你的動作。",
        "gal_map_text_202100075=麻煩你了，我試了好幾次都沒成功。'",
        "gal_map_text_202100076=阿米菈點頭示意，卻悄悄記下你調整羊毛的手法。",
        "gal_map_text_202100077=辛苦你，塑形後我來裝飾。'",
        "gal_map_text_202100078=來來看我的，找准發力點，這樣就可以了。'",
        "gal_map_text_202100079=阿米菈湊近觀察，眼睛緊緊盯著你的手指。",
        "gal_map_text_202100080=發力點？我看看你是怎麼弄的，應該能學會。'",
        "gal_map_text_202100081=阿米菈模仿你的動作，卻還是戳歪了，吐了吐舌頭。",
        "gal_map_text_202100082=我知道了！是不是戳中心位置？讓我試試！'",
        "gal_map_text_202100083=阿米菈撓撓頭，按照你說的方法反復嘗試，偶爾抬頭求助。",
        "gal_map_text_202100084=哦，好，我慢慢試。'",
        "gal_map_text_202100085=阿米菈語氣平淡，卻悄悄把椅子往你身邊挪了挪。",
        "gal_map_text_202100086=麻煩再示範一次，我沒看清。'",
        "gal_map_text_202100087=力度要輕柔，像撫摸小貓一樣，順著羊毛紋理戳。'",
        "gal_map_text_202100088=哦～原來如此！你手心好暖，比戳針好掌握多了。'",
        "gal_map_text_202100089=阿米菈的指尖蹭過你的掌心，嘴角忍不住上揚。",
        "gal_map_text_202100090=現在可以輕輕戳了，記得保持力度均勻。'",
        "gal_map_text_202100091=哇！真的變圓了！你也太厲害了吧！'",
        "gal_map_text_202100092=阿米菈抬頭對你笑，眼睛彎成月牙，指尖不小心碰到你的手背。",
        "gal_map_text_202100093=就是這樣，對準中心輕輕發力，羊毛就會緊實。'",
        "gal_map_text_202100094=啊！我做到了！雖然還是有點歪，但比之前好多了！'",
        "gal_map_text_202100095=阿米菈興奮地舉起羊毛團，臉頰泛紅。",
        "gal_map_text_202100096=在你的幫助下，阿米菈的羊毛氈小貓終於有了雛形。她小心翼翼地給小貓貼上眼睛，用粉色奶油膠畫了小嘴巴，得意地舉到你面前。",
        "gal_map_text_202100097=雖然有點醜萌，但也是你們一起努力的結果，她把小貓放在你手心，指尖停留片刻才收回，眼底藏著笑意。",
        "gal_map_text_202100098=推開香水瓶造型的大門，複雜的香氣瞬間襲來。店裡擺滿了貼著古怪標籤的精油瓶，'雨後苔蘚''舊書圖書館''貓咪打盹的陽臺' 等字樣格外吸睛。",
        "gal_map_text_202100099=中央的香味扭蛋機噴著彩虹霧氣，分別對應花果、木質、美食、奇幻四個主題。",
        "gal_map_text_202100100=阿米菈眼睛一亮，小跑著沖到扭蛋機前，摸摸這個又拍拍那個。",
        "gal_map_text_202100101=阿米菈每個都想要！這個奇幻主題聽起來最有意思，選它吧！",
        "gal_map_text_202100102=哇，不知道裡面會藏著什麼奇怪的配方！希望不要太離譜，不然調出來的香水會沒人敢用吧？",
        "gal_map_text_202100103=試試運氣，就算配方奇怪，我們也能平衡出獨特的味道。我陪你一起挑戰。",
        "gal_map_text_202100104=好！要是調砸了，你可得第一個試噴，還得說好聽的！ 她投幣轉動搖杆，眼神滿是期待。",
        "gal_map_text_202100105=扭蛋滾落，阿米菈迫不及待地打開，卡片上寫著 '仲夏夜之夢' 配方：前調檸檬、黑加侖葉，中調玫瑰、茉莉、蜂蜜，後調苔蘚、廣藿香、泥土。",
        "gal_map_text_202100106=調香時，阿米菈小心地滴入蜂蜜精油，甜膩的氣味瞬間彌漫，阿米菈皺著鼻子後退半步，調香味道突然變得好沖，似乎搞砸了。",
        "gal_map_text_202100107=加玫瑰中和甜膩",
        "gal_map_text_202100108=補檸檬增加清冽",
        "gal_map_text_202100109=換配方重新調製",
        "gal_map_text_202100110=添加一些玫瑰柔潤，能平衡甜膩，這樣能讓味道能緩解一些，不會讓調香味道變得太沖。'",
        "gal_map_text_202100111=阿米菈遞過玫瑰精油瓶，指尖輕輕搭在你的手上。",
        "gal_map_text_202100112=真的嗎？那你快幫我加，我怕自己加太多反而更糟。'",
        "gal_map_text_202100113=阿米菈湊近你，呼吸拂過你的耳廓，眼神滿是依賴。",
        "gal_map_text_202100114=太好了！我完全不知道該怎麼辦，全靠你了！'",
        "gal_map_text_202100115=阿米菈拿起滴管，卻還是看向你尋求確認。",
        "gal_map_text_202100116=我來試試加一點，你幫我看著量，別太多。'",
        "gal_map_text_202100117=阿米菈挑眉提議，卻悄悄按你說的量添加。",
        "gal_map_text_202100118=我知道玫瑰能中和，不過我們可以試試不同比例。'",
        "gal_map_text_202100119=添加一些檸檬清冽，能破甜膩，這樣能讓味道就不會變得太沖了。'",
        "gal_map_text_202100120=阿米菈拉著你的袖子晃了晃，眼神急切。",
        "gal_map_text_202100121=對哦！檸檬那麼清新，肯定能壓住甜味！快加快加，我都等不及想聞聞了！'",
        "gal_map_text_202100122=阿米菈蹦蹦跳跳地遞過檸檬精油，滿臉期待。",
        "gal_map_text_202100123=檸檬！我怎麼沒想到！加多加多，我喜歡清新的味道！'",
        "gal_map_text_202100124=阿米菈坐在旁邊，雙手托著下巴，專注地看著你的動作。",
        "gal_map_text_202100125=嗯，檸檬的清冽應該合適，我們慢慢加，邊加邊聞。'",
        "gal_map_text_202100126=阿米菈語氣平靜，卻悄悄湊近瓶口聞了聞。",
        "gal_map_text_202100127=檸檬比例要控制好，避免蓋過其他氣味。'",
        "gal_map_text_202100128=我們重新調配一下，改善一下配方。'",
        "gal_map_text_202100129=阿米菈咬著嘴唇，眼神猶豫。",
        "gal_map_text_202100130=可是這個配方雖然奇怪，但我有點捨不得放棄，再試試調整？'",
        "gal_map_text_202100131=阿米菈拿起黑加侖葉精油，語氣堅定。",
        "gal_map_text_202100132=我覺得再加點黑加侖葉就能平衡，不用重新扭，相信我！'",
        "gal_map_text_202100133=阿米菈撓撓頭，跟著你走向扭蛋機。",
        "gal_map_text_202100134=重新調配嗎？也行，剛才那個確實有點沖。'",
        "gal_map_text_202100135=阿米菈語氣平淡，卻悄悄把原來的配方卡片收了起來。",
        "gal_map_text_202100136=都可以，你決定就好，我沒意見。'",
        "gal_map_text_202100137=你現在在聞聞，花香把甜膩串起來了。'",
        "gal_map_text_202100138=哇！真的好好聞！像在夏夜花園裡，既有晚風清冽又有花瓣甜潤。'",
        "gal_map_text_202100139=阿米菈下意識抓住你的胳膊，指尖用力，笑容燦爛。",
        "gal_map_text_202100140=你在試試？清冽感剛好中和甜膩。'",
        "gal_map_text_202100141=檸檬的清新太合適了，這樣聞起來舒服多了。'",
        "gal_map_text_202100142=阿米菈主動幫你整理散落的精油瓶，指尖不經意碰到你的手背。",
        "gal_map_text_202100143=其實不用換，我們再調整一下就能變好聞。'",
        "gal_map_text_202100144=真的嗎？那太好了！我就覺得這個配方很特別。'",
        "gal_map_text_202100145=阿米菈拉著你回到調香台，眼神堅定又帶著期待。",
        "gal_map_text_202100146=經過調整，'仲夏夜之夢' 香水終於呈現出獨特的香氣，檸檬的清冽、玫瑰的柔潤與苔蘚的沉靜完美融合。",
        "gal_map_text_202100147=阿米菈小心地將香水裝入小瓶，貼上空白標籤，寶貝似的捧在手裡。她把瓶子湊近你，讓你再聞一次，指尖不經意劃過你的掌心。",
        "gal_map_text_202100148=推開復古糖果罐般的圓門，混雜的歡笑聲與錄音重播聲撲面而來。",
        "gal_map_text_202100149=空間被分成多個粉藍相間的迷你電話亭隔間，牆上掛滿卡通耳機、毛絨麥克風套和搞怪手舉牌。",
        "gal_map_text_202100150=店員遞上 '聲音菜單'：'可錄 60 秒個性化片段，選背景白噪音，生成帶二維碼的聲音明信片，支持雙人合作哦！'",
        "gal_map_text_202100151=哇，還能錄雙人搞怪對話！我要模仿暴躁吃貨，你扮演霸道老闆怎麼樣？",
        "gal_map_text_202100152=沒問題，不過我們可以先選個背景音，篝火劈啪聲怎麼樣？氛圍更特別。",
        "gal_map_text_202100153=好主意！就選篝火聲！等會兒我要發出各種奇怪的吃播聲音，你可不准笑場！",
        "gal_map_text_202100154=隔間裡暖黃的氛圍燈亮起，螢幕開始 60 秒倒計時，篝火劈啪聲輕柔響起。一開始兩人都有些不自然，阿米菈率先打破沉默，模仿起暴躁吃貨的語氣。",
        "gal_map_text_202100155=老闆！你家蛋糕怎麼這麼小！我要吃十個！'",
        "gal_map_text_202100156=你配合著用霸道語氣回應。",
        "gal_map_text_202100157=限量供應，想吃就得等！'",
        "gal_map_text_202100158=說著說著，兩人都被對方拙劣的模仿逗得不行，阿米菈笑得直不起腰，不小心撞到你的肩膀，麥克風都掉在了桌上。",
        "gal_map_text_202100159=一起錄搞怪片段",
        "gal_map_text_202100160=換溫情對話模式",
        "gal_map_text_202100161=重錄保持正經",
        "gal_map_text_202100162=要不要再錄一個，錄一個更好玩的搞笑片段'",
        "gal_map_text_202100163=阿米菈撿起麥克風，臉頰泛紅，眼神亮晶晶的。",
        "gal_map_text_202100164=好耶！剛才笑得太開心了，我們再來一段，這次我要模仿撒嬌顧客！'",
        "gal_map_text_202100165=阿米菈湊近你，肩膀緊緊貼在一起，呼吸溫熱地拂過你的耳廓。",
        "gal_map_text_202100166=太好了！和你一起搞怪太有意思了！我要錄到完美為止，以後天天聽！'",
        "gal_map_text_202100167=阿米菈調整麥克風位置，卻忍不住偷偷瞟你。",
        "gal_map_text_202100168=嗯，趁狀態好繼續錄，不過要控制時間，避免超時。'",
        "gal_map_text_202100169=阿米菈語氣平靜，卻悄悄調整坐姿，離你更近了些。",
        "gal_map_text_202100170=可以，我們分工明確，我負責接梗，你負責搞怪，提高效率。'",
        "gal_map_text_202100171=要不要試試溫情告白，錄一個特別。'",
        "gal_map_text_202100172=阿米菈雙手托著下巴，眼神期待。",
        "gal_map_text_202100173=溫情對話？好呀好呀！我扮演害羞學妹，你扮演溫柔學長怎麼樣？'",
        "gal_map_text_202100174=阿米菈開心地調整麥克風，臉頰泛紅。",
        "gal_map_text_202100175=哇！溫情模式也很有意思！我要假裝表白，你可不准當真哦！'",
        "gal_map_text_202100176=阿米菈坐在旁邊，雙手放在膝蓋上，語氣平靜卻帶著期待。",
        "gal_map_text_202100177=溫情對話挺好的，適合留作紀念，我們自然發揮就好。'",
        "gal_map_text_202100178=阿米菈點頭應允，卻悄悄握緊了麥克風。",
        "gal_map_text_202100179=可以，溫情風格更有意義，不過別說太肉麻的話。'",
        "gal_map_text_202100180=正經錄一段，留作紀念。'",
        "gal_map_text_202100181=阿米菈咬著嘴唇，眼神猶豫。",
        "gal_map_text_202100182=正經錄嗎？可是搞怪更有意思呀，再錄一次搞怪的好不好？'",
        "gal_map_text_202100183=阿米菈拉著你的袖子晃了晃，語氣急切。",
        "gal_map_text_202100184=我覺得搞怪的更有紀念意義，以後聽了還能想起今天的快樂！'",
        "gal_map_text_202100185=阿米菈撓撓頭，笑容憨厚。",
        "gal_map_text_202100186=正經錄也行，不過我不太會說正經話，你多引導我。'",
        "gal_map_text_202100187=阿米菈語氣平淡，卻悄悄調整了麥克風的位置，讓兩人的聲音都能清晰收錄。",
        "gal_map_text_202100188=都可以，你說內容，我跟著念就行。'",
        "gal_map_text_202100189=準備好了嗎？這次我扮演高冷廚師，你儘管發揮。",
        "gal_map_text_202100190=廚師哥哥～我想吃你做的紅燒肉，能不能多放糖呀？",
        "gal_map_text_202100191=阿米菈的指尖不經意搭在你的手上，笑容狡黠。",
        "gal_map_text_202100192=學妹，最近學習累嗎？有不懂的可以問我。",
        "gal_map_text_202100193=學長，我數學不太好，你能幫我補習嗎？",
        "gal_map_text_202100194=阿米菈抬頭看你，眼神裡藏著羞澀，指尖輕輕劃過桌面。",
        "gal_map_text_202100195=其實不用刻意正經，自然就好，說說今天的感受吧。",
        "gal_map_text_202100196=今天和你一起玩很開心，希望以後還有機會一起體驗更多有意思的事。",
        "gal_map_text_202100197=阿米菈的眼神溫柔，指尖輕輕敲擊桌面",
        "gal_map_text_202100198=錄音完成後，聲音明信片緩緩列印出來，上面印著你們錄音時的卡通形象和二維碼。阿米菈小心地接過明信片，對著燈光看了又看。",
        "gal_map_text_202100199=阿米菈把明信片放進包裡，卻忍不住又拿出來看了一眼，嘴角上揚。",
        "gal_map_text_202100200=你們之間的氛圍愈發黏膩。羊毛氈的柔軟觸感、香水的獨特餘韻或是錄音的歡樂迴響，都讓彼此的距離不斷拉近。",
        "gal_map_text_202100201=每一個選擇都將牽動心動的節奏，阿米菈的古靈精怪也將帶來更多意想不到的小挑戰。",
        "gal_map_text_202100202=你 '毛茸茸像你' 的調侃讓阿米菈臉更紅了一點，笑著輕捶了你一下，但眼睛亮亮地接過了羊毛氈材料包。",
        "gal_map_text_202100203=你們選了一個靠窗的明亮位置坐下，拿出淡粉色和白色的羊毛、戳針和小眼睛配件。一開始還算順利，但要把蓬鬆的羊毛戳成一個緊實的、有形狀的球體，需要不小的耐心和巧勁。",
        "gal_map_text_202100204=阿米菈非常專注，抿著嘴唇，一下一下地戳，可是手裡的粉色羊毛團卻不太聽話，總是歪向一邊。",
        "gal_map_text_202100205=啊…… 它怎麼不肯變圓！明明教程裡說得超簡單，是不是故意跟我作對呀？",
        "gal_map_text_202100206=別急，羊毛要順著一個方向戳才緊實，你看我這個，像這樣轉動著戳。",
        "gal_map_text_202100207=哦…… 原來是這樣！我剛才太用力還沒轉方向。",
        "gal_map_text_202100208=阿米菈揉了揉被戳到的指尖，鼻尖微微泛紅，卻還是咬著嘴唇想繼續嘗試。",
        "gal_map_text_202100209=你看著阿米菈既委屈又不服輸的小模樣，伸手輕輕按住了阿米菈拿著戳針的手，指尖傳來阿米菈皮膚溫熱細膩的觸感。",
        "gal_map_text_202100210=阿米菈身體猛地一僵，臉頰瞬間染上緋紅，呼吸也變得有些急促，卻沒有抽回手，只是睫毛輕輕顫動著，不敢看你。",
        "gal_map_text_202100211=手把手教阿米菈戳",
        "gal_map_text_202100212=幫阿米菈調整羊毛團",
        "gal_map_text_202100213=教阿米菈戳的技巧",
        "gal_map_text_202100214=我扶著你手，慢慢找感覺。'",
        "gal_map_text_202100215=阿米菈乖乖伸直手指，指尖微微顫抖，臉頰紅得像一個蘋果一樣。",
        "gal_map_text_202100216=哇，好…… 你可得輕點，別再讓我戳到手啦。'",
        "gal_map_text_202100217=阿米菈主動往你身邊靠了靠，肩膀貼緊你的胸膛，呼吸溫熱地拂過你的手腕。",
        "gal_map_text_202100218=太好了！有你幫忙肯定能成！我一個人根本搞不定這頑固的羊毛。'",
        "gal_map_text_202100219=阿米菈挺起小胸脯假裝倔強，指尖卻不自覺地跟著你的力道動。",
        "gal_map_text_202100220=手工嘛，我試試！不過你得在旁邊看著，不對的地方趕緊提醒我。'",
        "gal_map_text_202100221=阿米菈挺起小胸脯假裝倔強，指尖卻不自覺地跟著你的力道動。",
        "gal_map_text_202100222=可以，不過我們得比賽，看誰先做出完美的毛球！輸的人要請喝奶茶。'",
        "gal_map_text_202100223=羊毛團給我，我來幫你調整一下，這樣戳起來會輕鬆一點。'",
        "gal_map_text_202100224=阿米菈把羊毛團塞進你手裡，托著下巴湊得極近，鼻尖幾乎要碰到你的手。",
        "gal_map_text_202100225=好耶！快救救我的小奶貓毛球！它再這樣就要變成歪脖子怪物啦！'",
        "gal_map_text_202100226=阿米菈圍著你轉了半圈，手指點著桌面催促，馬尾辮掃過你的胳膊。",
        "gal_map_text_202100227=拜託拜託！你一定要把它變圓！變圓了我請你喝超甜的珍珠奶茶，加雙倍珍珠！'",
        "gal_map_text_202100228=阿米菈坐在旁邊，雙手放在膝蓋上，眼神專注地盯著你的動作，睫毛輕輕顫動。",
        "gal_map_text_202100229=麻煩你了，我試了好幾次都沒成功，總是控制不好力度。'",
        "gal_map_text_202100230=阿米菈點頭示意，卻悄悄把椅子往你身邊挪了挪，能更清楚地看到你的側臉。",
        "gal_map_text_202100231=辛苦你，塑形後我來裝飾眼睛和嘴巴，保證讓它變可愛。'",
        "gal_map_text_202100232=看我的操作，找准需要戳的地方，不難掌握。'",
        "gal_map_text_202100233=阿米菈湊近觀察，眼睛緊緊盯著你的手指，呼吸拂過你的手背。",
        "gal_map_text_202100234=發力點？我看看你是怎麼弄的，是不是戳中心位置？應該能學會。'",
        "gal_map_text_202100235=阿米菈模仿你的動作，卻還是戳歪了，吐了吐舌頭，臉頰泛紅。",
        "gal_map_text_202100236=我知道了！是不是用指腹發力而不是指尖？讓我試試！'",
        "gal_map_text_202100237=阿米菈撓撓頭，笑容憨厚，把羊毛團遞到你面前。",
        "gal_map_text_202100238=哦，好，我慢慢試。你剛才說的發力點是哪裡來著？再指給我看看。'",
        "gal_map_text_202100239=阿米菈語氣平淡，卻悄悄把羊毛團往你手邊推了推，希望你能多示範幾次。",
        "gal_map_text_202100240=麻煩再示範一次，我沒看清力度大小。'",
        "gal_map_text_202100241=感受一下力度，像撫摸小貓一樣輕，順著羊毛紋理慢慢轉。",
        "gal_map_text_202100242=哦～原來如此！你手心好暖，比戳針好掌握多了。",
        "gal_map_text_202100243=阿米菈的指尖輕輕蹭過你的掌心，嘴角忍不住上揚，偷偷用餘光瞟你。",
        "gal_map_text_202100244=現在可以輕輕戳了，保持力度均勻就好。",
        "gal_map_text_202100245=哇！真的變圓了！你也太厲害了吧！",
        "gal_map_text_202100246=阿米菈抬頭對你笑，眼睛彎成月牙，指尖不小心碰到你的手背，像觸電般縮了一下又悄悄蹭了蹭。",
        "gal_map_text_202100247=就是這樣，對準中心輕輕發力，羊毛就會慢慢緊實。",
        "gal_map_text_202100248=啊！我做到了！雖然還是有點歪，但比之前好多了！",
        "gal_map_text_202100249=阿米菈興奮地晃了晃手裡的毛球，不小心碰到你的胳膊，笑容燦爛得像陽光。",
        "gal_map_text_202100250=羊毛氈製作完成，阿米菈的粉色毛球雖然不算完美，卻帶著滿滿的成就感。阿米菈小心翼翼地給毛球貼上圓溜溜的小眼睛，用粉色奶油膠畫了個小巧的愛心嘴巴，得意地舉到你面前。",
        "gal_map_text_202100251=阿米菈把毛球放在你手心，指尖停留了三秒才輕輕收回，眼底藏著狡黠的笑意。",
        "gal_map_text_202100252=你們之間的氛圍愈發黏膩。羊毛氈的柔軟觸感、香水的獨特餘韻或是錄音的歡樂迴響，都讓彼此的距離不斷拉近。",
        "gal_map_text_202100253=每一個選擇都將牽動心動的節奏，阿米菈的古靈精怪也將帶來更多意想不到的小挑戰。",
        "gal_map_text_202100254=好！就玩高級藝術！' 阿米菈被你的提議點燃，興致勃勃地戴好手套，拿起裝著各色奶油膠的擠花袋。",
        "gal_map_text_202100255=流體畫的關鍵在於將不同顏色的顏料倒在畫板上，然後傾斜畫板，讓顏色自然流淌、混合。你們決定一起創作，阿米菈選了夢幻的粉紫藍，你挑了大膽的橙綠黃。",
        "gal_map_text_202100256=當顏色倒在畫板中央，開始隨著你們傾斜畫板而蔓延、交匯時，意想不到的化學反應發生了 —— 顏色碰撞出奇妙的紋理和層次，像宇宙星雲般絢爛，竟然意外地好看。",
        "gal_map_text_202100257=哇！太神奇了！粉紫藍和橙綠黃竟然這麼配！你看這個漩渦，像不像我們上次看的星空紀錄片裡的星雲？",
        "gal_map_text_202100258=是啊，顏色融合得剛好。我們再慢慢調整角度，讓顏色自然過渡，別太急，不然顏料會灑出來。",
        "gal_map_text_202100259=好！聽你的！不過要是灑出來，你可得幫我收拾殘局哦！ 阿米菈轉頭對你笑，鼻尖幾乎碰到你的臉頰，呼吸溫熱地拂過你的皮膚。",
        "gal_map_text_202100260=就在你們專注調整畫板角度時，阿米菈太過興奮，手腕用力過猛，畫板傾斜角度太大，一部分橙色顏料濺了出來，正好落在阿米菈的白色手套上，還濺到了你的袖口和阿米菈的發梢。",
        "gal_map_text_202100261=阿米菈驚呼一聲，連忙放下畫板跑來查看，發現我的袖口被濺到，連忙道歉起來。",
        "gal_map_text_202100262=阿米菈急得手足無措，伸手想幫你擦拭袖口，卻又怕把顏料蹭得更髒，指尖懸在半空，眼眶微微泛紅。",
        "gal_map_text_202100263=一起清理再創作",
        "gal_map_text_202100264=用顏料點綴成設計",
        "gal_map_text_202100265=換畫板重新開始",
        "gal_map_text_202100266=沒事，一起清理後，再繼續創作。'",
        "gal_map_text_202100267=阿米菈眼睛紅紅的，帶著歉意，指尖輕輕拉著你的袖口，語氣委屈又自責。",
        "gal_map_text_202100268=真的嗎？你不怪我？我把你的衣服都弄髒了。'",
        "gal_map_text_202100269=阿米菈湊近你，肩膀緊緊貼住你的手臂，呼吸溫熱地拂過你的手腕，指尖不自覺地抓緊你的袖子",
        "gal_map_text_202100270=太好了！你真好！我還以為你會生氣呢！我們趕緊清理，爭取把畫完成得更漂亮，彌補我的過錯！'",
        "gal_map_text_202100271=阿米菈語氣平靜，卻悄悄加快了清理的速度，眼神裡滿是愧疚。",
        "gal_map_text_202100272=沒關係，顏料濺到很正常，創作過程中難免有意外。我們先清理乾淨，別讓顏料幹了不好洗。'",
        "gal_map_text_202100273=阿米菈語氣平靜，卻悄悄加快了清理的速度，眼神裡滿是愧疚。",
        "gal_map_text_202100274=沒關係，顏料濺到很正常，創作過程中難免有意外。我們先清理乾淨，別讓顏料幹了不好洗。'",
        "gal_map_text_202100275=沒有關係，看我在濺到的地方點綴成花紋。'",
        "gal_map_text_202100276=阿米菈眼睛瞬間亮了，一掃之前的愧疚，立刻拿起擠花袋開始構思，指尖興奮地比劃著。",
        "gal_map_text_202100277=哇！這個主意太棒了！我們把濺出來的顏料都變成裝飾，肯定更特別！就像給畫作加了隱藏彩蛋一樣！'",
        "gal_map_text_202100278=阿米菈配合地拿起不同顏色的顏料，滿臉興奮，拉著你的手就要往袖口畫圖案。",
        "gal_map_text_202100279=對哦！這樣反而更有藝術感和獨特性！我們來畫點小愛心和星星，把你的袖口也畫個小圖案，讓它變成獨一無二的‘限量款’！'",
        "gal_map_text_202100280=阿米菈坐在旁邊，仔細觀察顏料的位置，慢慢構思，指尖輕輕敲擊桌面。",
        "gal_map_text_202100281=這個想法不錯，很有創意。我們可以順著顏料濺落的方向點綴，讓它更自然，和畫板上的圖案呼應起來。'",
        "gal_map_text_202100282=阿米菈語氣平靜，卻悄悄拿起顏料袋，眼神裡藏著期待。",
        "gal_map_text_202100283=可以，這樣能節省時間，還能讓畫作更有創意。我們先規劃好點綴的位置和形狀，避免雜亂無章。'",
        "gal_map_text_202100284=沒事，我們換一個畫板繼續創作吧。'",
        "gal_map_text_202100285=阿米菈咬著嘴唇，眼神猶豫，指尖輕輕撫摸著畫板邊緣。",
        "gal_map_text_202100286=可是這個畫板已經有這麼多好看的紋理了，扔掉太可惜了，而且上面還有我們一起創作的痕跡。我們再試試拯救一下？'",
        "gal_map_text_202100287=阿米菈拿起其他顏色的顏料袋，語氣堅定，眼神裡滿是不舍。",
        "gal_map_text_202100288=我覺得還能補救！我們用其他顏色把濺落的顏料蓋住，或者變成其他圖案，不用換畫板！這個配色我們好不容易才調出來的，換了多可惜。",
        "gal_map_text_202100289=阿米菈撓撓頭，跟著你走向材料區，臉上沒什麼表情，卻悄悄回頭看了一眼原來的畫板。",
        "gal_map_text_202100290=重新扭嗎？也行，剛才那個確實有點沖，換個畫板可能會更順利。'",
        "gal_map_text_202100291=阿米菈語氣平淡，卻悄悄把原來的畫板往旁邊挪了挪，捨不得立刻扔掉。",
        "gal_map_text_202100292=都可以，你決定就好，我沒意見。換畫板也好，省得清理麻煩。'",
        "gal_map_text_202100293=這點顏料不算什麼，反而讓這場創作更有紀念意義。你的頭髮上沾了點顏料，別動，我幫你擦掉。",
        "gal_map_text_202100294=謝謝你…… 你真好。",
        "gal_map_text_202100295=阿米菈主動幫你擦拭袖口，指尖輕輕蹭過你的皮膚，動作小心翼翼，眼神裡滿是感激和羞澀。",
        "gal_map_text_202100296=你看，這樣點綴之後，手套和畫板都呼應起來了，是不是很特別？",
        "gal_map_text_202100297=是啊！太有意思了！沒想到意外也能變成驚喜！你畫的愛心好可愛，我要一直戴著這個手套，捨不得摘了！",
        "gal_map_text_202100298=阿米菈的指尖不小心碰到你的手，兩人同時頓了一下，眼神交匯，臉頰都泛起紅暈。",
        "gal_map_text_202100299=其實不用換，我們再調整一下，就能把濺落的顏料變成亮點。你這麼喜歡這個配色，換了多可惜。",
        "gal_map_text_202100300=那太好了！我就覺得這個畫板不能放棄，有你的幫忙肯定能變好！",
        "gal_map_text_202100301=阿米菈拉著你的胳膊，指尖用力，笑容裡滿是欣喜和依賴。",
        "gal_map_text_202100302=最終你們選擇了最契合心意的方式處理顏料意外，流體畫也順利完成。畫板上的色彩絢爛而獨特，帶著專屬你們的小印記。阿米菈小心翼翼地捧著畫板，像寶貝一樣護在懷裡。",
        "gal_map_text_202100303=阿米菈側頭對你笑，眼底的光芒比畫板上的色彩還要耀眼，指尖輕輕碰了碰你的手背，又快速收回，臉頰泛紅。",
        "gal_map_text_202100304=你們之間的氛圍愈發黏膩。羊毛氈的柔軟觸感、香水的獨特餘韻或是錄音的歡樂迴響，都讓彼此的距離不斷拉近。",
        "gal_map_text_202100305=每一個選擇都將牽動心動的節奏，阿米菈的古靈精怪也將帶來更多意想不到的小挑戰。",
        "gal_map_text_202100306=選擇相對穩妥的羊毛氈後，你們進入了安靜的製作階段。阿米菈按照教程，認真地戳著一個小貓形狀的底胚，你則在做一個簡單的星星羊毛氈。",
        "gal_map_text_202100307=店裡輕柔的背景音樂流淌，只有偶爾的戳針聲和別人的低語。一開始有點安靜，但阿米菈很快沉浸其中，偶爾會因為戳到手（不疼）而小小地 '嘶' 一聲，或者因為形狀有點進步而得意地翹起嘴角。",
        "gal_map_text_202100308=過了一會兒，阿米菈似乎覺得太安靜了，抬起頭，看了眼你手裡初具雛形的星星，又看看自己有點抽象的小貓，眼睛一轉，冒出了鬼點子。",
        "gal_map_text_202100309=哎，我們來玩個遊戲吧！光做羊毛氈有點無聊，我們把羊毛氈和流體畫結合起來怎麼樣？",
        "gal_map_text_202100310=哦？怎麼結合？你又想到了什麼鬼點子？",
        "gal_map_text_202100311=我們把做好的羊毛氈粘在流體畫上面，做成一個立體裝飾畫！比如我的小貓可以坐在你的星星旁邊，像在宇宙裡探險一樣！",
        "gal_map_text_202100312=說幹就幹，你們快速完成了羊毛氈製作，開始準備將羊毛氈粘在流體畫上面。阿米菈拿起膠水，小心翼翼地往小貓羊毛氈底部塗抹，卻不小心擠多了膠水，黏糊糊的膠水順著羊毛氈滴了下來。",
        "gal_map_text_202100313=正好滴在流體畫的中央，還粘到了阿米菈的指尖，讓阿米菈的小貓羊毛氈差點從手裡滑落。",
        "gal_map_text_202100314=阿米菈驚呼一聲，連忙穩住羊毛氈，卻因為指尖粘了膠水而手足無措。阿米菈急得團團轉，想擦掉多餘的膠水又怕弄壞畫作和羊毛氈。",
        "gal_map_text_202100315=用羊毛氈遮擋膠水",
        "gal_map_text_202100316=用亮片裝飾覆蓋",
        "gal_map_text_202100317=用顏料暈染補救",
        "gal_map_text_202100318=別急，用羊毛氈遮擋膠水，說不定還能變成畫的一部分。'",
        "gal_map_text_202100319=你輕聲安慰阿米菈，順手將自己的星星羊毛氈按在膠水滴落處，微微用力壓緊。阿米菈一愣，隨即睜大眼睛。",
        "gal_map_text_202100320=阿米菈眼睛瞬間亮了，緊緊抓住你的胳膊，指尖因為緊張還帶著點黏膩的膠水，臉頰泛紅。",
        "gal_map_text_202100321=哇！這個辦法太妙了！我怎麼沒想到！'",
        "gal_map_text_202100322=阿米菈把小貓羊毛氈遞到你手裡，身體湊近你，幾乎完全靠在你的肩膀上。",
        "gal_map_text_202100323=太好了！有你在我就不用慌了！你說怎麼擺，我就怎麼粘，全聽你的！'",
        "gal_map_text_202100324=阿米菈挺起小胸脯，開始構思擺放位置，卻悄悄看向你尋求認可。",
        "gal_map_text_202100325=可以試試！我把我的小貓放在膠水痕跡上，你把你的星星也擺過來，我們組成一個場景。'",
        "gal_map_text_202100326=阿米菈語氣堅定，卻還是等你先確定位置後才動手粘貼。",
        "gal_map_text_202100327=這個方案可行！我們分工，你負責擺星星，我負責固定小貓，爭取一次成功。'",
        "gal_map_text_202100328=撒一些亮片，可以掩蓋膠水痕跡。'",
        "gal_map_text_202100329=阿米菈眼睛一亮，立刻拿起裝著亮片的小盒子，興奮地晃了晃。",
        "gal_map_text_202100330=哇！亮片！這個主意太棒了！膠水痕跡瞬間變成閃亮的星空！'",
        "gal_map_text_202100331=阿米菈挑選起不同顏色的亮片，拉著你的手一起撒，亮片落在你們的指尖。",
        "gal_map_text_202100332=對哦！亮片能讓畫更閃亮！我們多撒點不同顏色的，把膠水痕跡變成最特別的亮點！'",
        "gal_map_text_202100333=阿米菈坐在旁邊，小心翼翼地捏起亮片，慢慢撒在膠水痕跡上。",
        "gal_map_text_202100334=亮片裝飾挺合適的，我們順著膠水痕跡撒，讓它更自然，像星星落在畫裡。'",
        "gal_map_text_202100335=阿米菈語氣平靜，卻悄悄挑選了你喜歡的顏色亮片。",
        "gal_map_text_202100336=可以，亮片能有效掩蓋膠水痕跡，還能提升畫作的精緻感。我們控制用量，避免過於雜亂。'",
        "gal_map_text_202100337=可以將顏色調淡色，暈染膠水痕跡。'",
        "gal_map_text_202100338=阿米菈咬著嘴唇，眼神猶豫，指尖輕輕撫摸著畫板邊緣。",
        "gal_map_text_202100339=淡色暈染？會不會把原來的顏色弄髒？我們先在旁邊試一下再動手吧。'",
        "gal_map_text_202100340=阿米菈拿起顏料，語氣堅定，眼神裡滿是期待。",
        "gal_map_text_202100341=我覺得用淡紫色暈染最合適，既能蓋住膠水，又能和原來的粉紫藍配色呼應！我來調顏色，你幫我看著效果。'",
        "gal_map_text_202100342=阿米菈撓撓頭，笑容憨厚，把顏料盤推到你面前。",
        "gal_map_text_202100343=淡色暈染嗎？也行，我不太會調顏色，你調好了我來暈染。'",
        "gal_map_text_202100344=阿米菈語氣平淡，卻悄悄把畫板往你身邊挪了挪，方便你操作。",
        "gal_map_text_202100345=都可以，你決定就好，我沒意見。暈染的時候小心點，別把畫弄壞了。'",
        "gal_map_text_202100346=你看這樣，小貓趴在星星旁邊，剛好能擋住膠水，還像在撒嬌一樣。",
        "gal_map_text_202100347=哇！真的完全擋住了！你也太會想辦法了吧！",
        "gal_map_text_202100348=阿米菈的指尖輕輕按壓羊毛氈固定，不小心碰到你的手指，像觸電般縮了一下又悄悄蹭了蹭。",
        "gal_map_text_202100349=你看，金色亮片像星星，和你的小貓、我的星星羊毛氈剛好呼應。",
        "gal_map_text_202100350=是啊！太好看了！沒想到膠水擠多了還能變成驚喜！以後創作遇到問題，我第一個想到你！",
        "gal_map_text_202100351=阿米菈的指尖不小心碰到你的手，兩人同時頓了一下，眼神交匯，臉頰都泛起紅暈。",
        "gal_map_text_202100352=你看，這樣慢慢暈染，膠水痕跡就和周圍的顏色融合了。",
        "gal_map_text_202100353=真的嗎？太厲害了！我還以為這畫要毀了呢，沒想到還能補救得這麼好！",
        "gal_map_text_202100354=阿米菈拉著你的胳膊，指尖用力，笑容裡滿是欣喜和依賴。",
        "gal_map_text_202100355=立體裝飾畫最終完成，小貓羊毛氈依偎在星星羊毛氈旁，膠水痕跡被巧妙掩蓋，還成了畫作的點睛之筆。阿米菈小心翼翼地捧著畫板，像寶貝一樣護在懷裡。",
        "gal_map_text_202100356=阿米菈側頭對你笑，眼底的光芒比畫板上的亮片還要耀眼，指尖輕輕碰了碰你的手背，又快速收回，臉頰泛紅。",
        "gal_map_text_202100357=你們之間的氛圍愈發黏膩。羊毛氈的柔軟觸感、香水的獨特餘韻或是錄音的歡樂迴響，都讓彼此的距離不斷拉近。",
        "gal_map_text_202100358=每一個選擇都將牽動心動的節奏，阿米菈的古靈精怪也將帶來更多意想不到的小挑戰。",
        "gal_map_text_202100359=你提出'共同命運' 的提議讓阿米菈愣了一下，隨即眼睛彎成了月牙，重重地點了點頭。",
        "gal_map_text_202100360=阿米菈握著那枚硬幣，在 '奇幻' 區扭蛋機前鄭重其事地投幣，轉動搖杆。'咕咚' 一聲，一顆紫色的扭蛋滾了出來。打開一看，裡面的小卡片上寫著神秘配方：【'星夜海岸' —— 前調海鹽、藍風鈴 | 中調海水、睡蓮 | 後調麝香、琥珀、冷杉】",
        "gal_map_text_202100361=阿米菈捧著配方卡，眼神裡滿是期待又有點猶豫。",
        "gal_map_text_202100362=海鹽和藍風鈴，海水和睡蓮，麝香和琥珀…… 這些味道混在一起會是什麼樣？會不會太複雜了？",
        "gal_map_text_202100363=不會，這些味道都是互補的。海鹽帶來清冽感，藍風鈴增添溫柔，睡蓮和海水呼應，麝香和琥珀收尾，會很有層次感。",
        "gal_map_text_202100364=好！那我們開始調吧！不過我從來沒調過香水，你可得多指導我，別讓我把比例搞砸了。",
        "gal_map_text_202100365=調香過程還算順利，前調的海鹽和藍風鈴、中調的海水和睡蓮都完美融合，呈現出清新又溫柔的氣息。",
        "gal_map_text_202100366=可到了後調，阿米菈過於興奮，不小心滴多了麝香精油，濃郁的麝香味瞬間蓋過了其他氣味，讓原本清新的香水變得有些厚重。",
        "gal_map_text_202100367=阿米菈驚呼一聲，連忙放下滴管，急得手足無措，眼神裡滿是愧疚，伸手想拿起香水稀釋，卻又怕越弄越糟。",
        "gal_map_text_202100368=加冷杉中和厚重",
        "gal_map_text_202100369=加補藍風鈴增添清新",
        "gal_map_text_202100370=加琥珀調和層次",
        "gal_map_text_202100371=要不要試一試加一點冷杉，好像可以平衡麝香味。",
        "gal_map_text_202100372=阿米菈遞過冷杉精油瓶，指尖輕輕搭在你的手上，臉頰泛紅。",
        "gal_map_text_202100373=哇，真的可以嗎？你快幫我加，我怕自己掌握不好用量。'",
        "gal_map_text_202100374=阿米菈湊近你，肩膀緊緊貼住你的胸膛，呼吸溫熱地拂過你的手腕。",
        "gal_map_text_202100375=太好了！有你在我就不用慌了！我完全不知道該怎麼辦，全靠你拯救這瓶香水了！'",
        "gal_map_text_202100376=阿米菈拿起滴管，卻還是看向你尋求確認，指尖微微顫抖。",
        "gal_map_text_202100377=我來試試加一點，你幫我看著，不對的地方趕緊提醒我。'",
        "gal_map_text_202100378=阿米菈挑眉提議，卻悄悄按你說的量添加，眼神裡滿是信任。",
        "gal_map_text_202100379=我知道冷杉能中和厚重感，不過我們可以試試不同比例，找到最完美的平衡。'",
        "gal_map_text_202100380=我看可以加一點補藍風鈴，提亮一些香氣。",
        "gal_map_text_202100381=阿米菈拉著你的袖子晃了晃，眼神急切，馬尾辮掃過你的胳膊。",
        "gal_map_text_202100382=對哦！藍風鈴那麼清新，肯定能壓住麝香的厚重！快加快加，我都等不及想聞聞最終的味道了！'",
        "gal_map_text_202100383=阿米菈遞過藍風鈴精油，滿臉期待，身體緊緊挨著你。",
        "gal_map_text_202100384=藍風鈴！我怎麼沒想到！加多加多，我喜歡清新的味道，這樣香水聞起來會更舒服！'",
        "gal_map_text_202100385=阿米菈坐在旁邊，雙手托著下巴，專注地看著你的動作，睫毛輕輕顫動。",
        "gal_map_text_202100386=嗯，藍風鈴的清新感剛好合適，我們慢慢加，邊加邊聞，找到最佳比例。'",
        "gal_map_text_202100387=阿米菈語氣平靜，卻悄悄湊近瓶口，仔細分辨香氣的變化。",
        "gal_map_text_202100388=藍風鈴比例要控制好，避免蓋過其他氣味，保持香水的整體平衡。'",
        "gal_map_text_202100389=加一點琥珀，可以豐富香氣的層次",
        "gal_map_text_202100390=阿米菈咬著嘴唇，眼神猶豫，指尖輕輕撫摸著精油瓶身。",
        "gal_map_text_202100391=可是琥珀也是偏厚重的味道，會不會讓香水更濃？我們先加一點點試試吧。'",
        "gal_map_text_202100392=阿米菈拿起琥珀精油，語氣堅定，眼神裡滿是期待。",
        "gal_map_text_202100393=我覺得少量琥珀能和麝香呼應，讓後調更持久，還能增添溫柔感！我來滴，你幫我聞聞效果。'",
        "gal_map_text_202100394=阿米菈撓撓頭，笑容憨厚，把精油瓶往你身邊推了推。",
        "gal_map_text_202100395=加琥珀嗎？也行，我不太懂香氣搭配，你說加多少就加多少。'",
        "gal_map_text_202100396=阿米菈語氣平淡，卻悄悄把椅子往你身邊挪了挪，能更清楚地聞到香水的味道。",
        "gal_map_text_202100397=都可以，你決定就好，我沒意見。加完之後我們再聞聞，不好再調整。'",
        "gal_map_text_202100398=冷杉的清冽能中和麝香的厚重，現在聞聞，層次感就出來了。",
        "gal_map_text_202100399=哇！真的好好聞！像在星夜下的海岸邊，既有海水的清冽，又有森林的沉靜，還有淡淡的花香。",
        "gal_map_text_202100400=阿米菈下意識抓住你的胳膊，指尖用力，笑容燦爛得像陽光。",
        "gal_map_text_202100401=試試？清新感剛好中和厚重，香氣變得更靈動了。",
        "gal_map_text_202100402=好多了！藍風鈴的清新太合適了，這樣聞起來既有層次又不厚重，你也太會調香了吧！",
        "gal_map_text_202100403=阿米菈主動幫你整理散落的精油瓶，指尖不經意碰到你的手背，像觸電般縮了一下又悄悄蹭了蹭。",
        "gal_map_text_202100404=你看，少量琥珀能讓麝香的厚重變得溫潤，香氣更有質感了。",
        "gal_map_text_202100405=真的！比之前好聞多了！既有後調的醇厚，又不失前調的清新，太神奇了！",
        "gal_map_text_202100406=阿米菈拉著你的胳膊，指尖用力，笑容裡滿是欣喜和崇拜。",
        "gal_map_text_202100407=星夜海岸' 香水最終調試完成，清冽的海鹽混著溫柔的藍風鈴，中間夾雜著海水和睡蓮的清新，尾調是麝香和琥珀的溫潤，還有冷杉的沉靜，層次豐富而和諧。",
        "gal_map_text_202100408=阿米菈小心地將香水裝入小瓶，寶貝似的捧在手裡。阿米菈把瓶子湊近你，讓你再聞一次，指尖不經意劃過你的掌心，臉頰泛紅。",
        "gal_map_text_202100409=你們之間的氛圍愈發黏膩。羊毛氈的柔軟觸感、香水的獨特餘韻或是錄音的歡樂迴響，都讓彼此的距離不斷拉近。",
        "gal_map_text_202100410=每一個選擇都將牽動心動的節奏，阿米菈的古靈精怪也將帶來更多意想不到的小挑戰。",
        "gal_map_text_202100411=你想阿米菈提議嘗試最冒險的 '奇幻' 區，阿米菈也興奮地投幣扭蛋。扭蛋打開，卡片上赫然寫著：【'仲夏夜之夢' —— 前調檸檬、黑醋栗葉 | 中調玫瑰、茉莉、蜂蜜 | 後調苔蘚、廣藿香、泥土】 '檸檬和…… 泥土？'。",
        "gal_map_text_202100412=阿米菈看著配方，忍不住笑出聲，'這組合也太奇幻了！蜂蜜配苔蘚，真的能好聞嗎？'",
        "gal_map_text_202100413=挑戰性激起了阿米菈的好勝心，阿米菈眼神發亮地看著你。似乎心裡下定了某種決心。",
        "gal_map_text_202100414=檸檬的清冽，黑醋栗葉的清新，玫瑰和茉莉的花香，蜂蜜的甜潤，還有苔蘚、廣藿香和泥土的沉靜…… 元素好多，我們得好好搭配比例。",
        "gal_map_text_202100415=沒關係，我們先少量添加，慢慢調整。檸檬和黑醋栗葉作為前調，要突出清冽感；玫瑰和茉莉作為中調，溫柔為主；蜂蜜少量提甜，後調的苔蘚和泥土要沉穩，不能太重。",
        "gal_map_text_202100416=好！聽你的！我負責加前調和中調，你負責後調，我們一起打造獨一無二的 '仲夏夜之夢'！",
        "gal_map_text_202100417=調香過程中，阿米菈小心翼翼地添加檸檬和黑醋栗葉，前調的清冽感完美呈現。可到了中調，阿米菈過於喜歡蜂蜜的甜潤，不小心滴多了蜂蜜精油，甜膩的氣味瞬間彌漫。",
        "gal_map_text_202100418=蓋過了玫瑰和茉莉的花香，讓香水變得有些齁甜。阿米菈驚呼一聲，連忙放下滴管。",
        "gal_map_text_202100419=阿米菈急得手足無措，眼神裡滿是愧疚，伸手想拿起香水稀釋，卻又怕越弄越糟。",
        "gal_map_text_202100420=嘗試加玫瑰中和甜膩",
        "gal_map_text_202100421=小心補檸檬增加清冽",
        "gal_map_text_202100422=自信加廣藿香調和甜感",
        "gal_map_text_202100423=DIY說明書中說到可以加一些玫瑰，柔化甜膩感。要不我們也試一試。",
        "gal_map_text_202100424=阿米菈眼睛紅紅的，帶著歉意，指尖輕輕拉著你的袖口，語氣委屈又自責。",
        "gal_map_text_202100425=真的可以嗎？你快幫我加，我怕自己加太多反而更糟。'",
        "gal_map_text_202100426=阿米菈湊近你，肩膀緊緊貼住你的手臂，呼吸溫熱地拂過你的手腕，指尖不自覺地抓緊你的袖子。",
        "gal_map_text_202100427=太好了！你真好！我還以為你會生氣呢！我們趕緊加玫瑰，爭取把香水救回來！'",
        "gal_map_text_202100428=阿米菈語氣平靜，卻悄悄加快了速度，眼神裡滿是期待。",
        "gal_map_text_202100429=沒關係，蜂蜜放多了很正常，玫瑰的花香能中和甜膩，我們慢慢加，邊加邊聞。'",
        "gal_map_text_202100430=阿米菈有條不紊地遞過玫瑰精油，卻時不時看向你，確認你是否真的不介意。",
        "gal_map_text_202100431=意外而已，不用在意。玫瑰和蜂蜜是經典搭配，適量添加能讓香氣更溫潤。我們控制用量，避免花香過重。'",
        "gal_map_text_202100432=我剛才聞了一下檸檬的味道，好像可以添加一些提亮清冽感，可以讓味道沒有甜膩。",
        "gal_map_text_202100433=阿米菈拉著你的袖子晃了晃，眼神急切，馬尾辮掃過你的胳膊。",
        "gal_map_text_202100434=對哦！檸檬那麼清新，肯定能壓住甜味！快加快加，我都等不及想聞聞最終的味道了！'",
        "gal_map_text_202100435=阿米菈遞過檸檬精油，滿臉期待，身體緊緊挨著你，指尖不自覺地抓住你的袖子。",
        "gal_map_text_202100436=檸檬！我怎麼沒想到！加多加多，我喜歡清新的味道，這樣香水聞起來會更清爽！'",
        "gal_map_text_202100437=阿米菈坐在旁邊，雙手托著下巴，專注地看著你的動作，睫毛輕輕顫動。",
        "gal_map_text_202100438=檸檬的清冽感剛好能中和甜膩，我們少量多次添加，避免蓋過中調的花香。'",
        "gal_map_text_202100439=阿米菈語氣平靜，卻悄悄湊近瓶口，仔細分辨香氣的變化。",
        "gal_map_text_202100440=補檸檬是合理選擇，但用量要精准，保持前調、中調、後調的平衡，不能讓檸檬味過於突出。'",
        "gal_map_text_202100441=以我這個DIY多次的經驗，可以添加一些廣藿香，增加厚重層次。",
        "gal_map_text_202100442=阿米菈咬著嘴唇，眼神猶豫，指尖輕輕撫摸著精油瓶身。",
        "gal_map_text_202100443=廣藿香偏厚重，會不會讓香水更悶？我們先加一點點試試，不行再調整。'",
        "gal_map_text_202100444=阿米菈拿起廣藿香精油，語氣堅定，眼神裡滿是期待。",
        "gal_map_text_202100445=少量廣藿香能和蜂蜜呼應，讓甜感更有質感，還能銜接後調的苔蘚和泥土！我來滴，你幫我聞聞效果。'",
        "gal_map_text_202100446=阿米菈撓撓頭，笑容憨厚，把精油瓶往你身邊推了推。",
        "gal_map_text_202100447=加廣藿香嗎？也行，我不太懂香氣搭配，你說加多少就加多少。'",
        "gal_map_text_202100448=阿米菈語氣平淡，卻悄悄把椅子往你身邊挪了挪，能更清楚地聞到香水的味道。",
        "gal_map_text_202100449=都可以，你決定就好，我沒意見。加完之後我們再聞聞，不好再調整比例。'",
        "gal_map_text_202100450=玫瑰的花香能把蜂蜜的甜膩串起來，現在聞聞，是不是溫柔多了？",
        "gal_map_text_202100451=哇！真的好好聞！像在夏夜花園裡，既有蜂蜜的甜潤，又有玫瑰的芬芳，太神奇了！",
        "gal_map_text_202100452=阿米菈下意識抓住你的胳膊，指尖用力，笑容燦爛得像向日葵。",
        "gal_map_text_202100453=試試？清冽感剛好壓住甜膩，香氣變得更清爽了。",
        "gal_map_text_202100454=好多了！檸檬的清新太合適了，這樣聞起來既有蜂蜜的甜潤，又不失清冽，太神奇了！",
        "gal_map_text_202100455=阿米菈主動幫你整理散落的精油瓶，指尖不經意碰到你的手背，像觸電般縮了一下又悄悄蹭了蹭。",
        "gal_map_text_202100456=你看，少量廣藿香能讓蜂蜜的甜感變得溫潤，香氣更有層次了。",
        "gal_map_text_202100457=真的！比之前好聞多了！既有甜潤感，又不失沉穩，太厲害了！",
        "gal_map_text_202100458=阿米菈拉著你的胳膊，指尖用力，笑容裡滿是欣喜和崇拜。",
        "gal_map_text_202100459=仲夏夜之夢' 香水最終調試完成，前調的檸檬清冽，中調的玫瑰茉莉混著蜂蜜的甜潤，後調的苔蘚、廣藿香和泥土增添沉穩，層次豐富而和諧，像真的置身于仲夏夜的奇幻花園。",
        "gal_map_text_202100460=阿米菈小心地將香水裝入小瓶，寶貝似的捧在手裡。阿米菈把瓶子湊近你，讓你再聞一次，指尖不經意劃過你的掌心，臉頰泛紅。",
        "gal_map_text_202100461=你們之間的氛圍愈發黏膩。羊毛氈的柔軟觸感、香水的獨特餘韻或是錄音的歡樂迴響，都讓彼此的距離不斷拉近。",
        "gal_map_text_202100462=每一個選擇都將牽動心動的節奏，阿米菈的古靈精怪也將帶來更多意想不到的小挑戰。",
        "gal_map_text_202100463=這次我們選個穩妥的！' 阿米菈笑著拉你來到 '花果' 區扭蛋機前。",
        "gal_map_text_202100464=阿米菈投幣扭蛋，一顆粉色的扭蛋滾了出來，打開後小卡片上的配方果然溫柔又友好：【'春日野莓園' —— 前調：草莓、黑加侖 | 中調：玫瑰、牡丹 | 後調：白麝香、雪松】。",
        "gal_map_text_202100465=阿米菈看過配方後，眼睛亮了起來，指尖輕輕劃過配方卡，心裡滿是期待。",
        "gal_map_text_202100466=草莓的甜香好治癒啊！黑加侖能增加一點酸感，中和甜膩，玫瑰和牡丹的花香肯定很溫柔，白麝香和雪松收尾，應該會很清爽。",
        "gal_map_text_202100467=這個配方確實很友好，花果香搭配花香，不容易出錯。我們按照參考比例來，慢慢添加，讓香氣充分融合。",
        "gal_map_text_202100468=好！我負責加前調的草莓和黑加侖，你負責中調的玫瑰和牡丹，後調我們一起加，怎麼樣？ 阿米菈坐得離你更近了些，肩膀輕輕貼住你的胳膊，呼吸溫熱地拂過你的皮膚，臉上帶著柔和的笑意。",
        "gal_map_text_202100469=調香過程異常順利，沒有任何意外。前調的草莓甜香與黑加侖的微酸完美融合，清新又甜美；中調的玫瑰與牡丹花香溫柔綿長，不濃不淡剛剛好。",
        "gal_map_text_202100470=後調的白麝香和雪松也按比例添加完畢。阿米菈專注地看著香水的顏色漸漸變成淡粉色，像春日裡熟透的野莓汁，臉上帶著滿足的柔和笑意。",
        "gal_map_text_202100471=過了一會兒，阿米菈輕輕晃動了一下小香水瓶，讓氣味充分混合，然後小心翼翼地遞到你面前，眼神裡滿是期待，氣氛平和得甚至有些安靜，只有彼此的呼吸聲和精油瓶碰撞的輕微聲響。",
        "gal_map_text_202100472=輕鬆誇讚瓶中的香水",
        "gal_map_text_202100473=建議給瓶中的香水起一個專屬名字",
        "gal_map_text_202100474=分享香水使用場景",
        "gal_map_text_202100475=太好聞了，像把春日野莓園裝在了瓶子裡。'",
        "gal_map_text_202100476=阿米菈臉頰瞬間泛紅，手微微一顫，卻沒有收回，任由你的指尖觸碰阿米菈的手背，聲音軟糯。",
        "gal_map_text_202100477=真的嗎？你喜歡就好！'",
        "gal_map_text_202100478=阿米菈身體下意識往你身邊靠了靠，肩膀緊緊貼住你的胸膛，呼吸溫熱地拂過你的手腕。",
        "gal_map_text_202100479=太好了！我還怕比例沒調好呢！你覺得好聞就放心了，畢竟是我們一起做的。'",
        "gal_map_text_202100480=阿米菈挺起小胸脯，語氣帶著小驕傲，卻悄悄收緊了握著香水瓶的手，捨不得移開。",
        "gal_map_text_202100481=我就說這個配方不會出錯！不過還是要謝謝你幫忙把控中調和後調，不然肯定沒這麼好聞。'",
        "gal_map_text_202100482=阿米菈挑眉提議，卻沒有抽回被你觸碰的手，眼神裡滿是笑意和信任。",
        "gal_map_text_202100483=看來我們的調香天賦都不錯！這個味道很特別，以後可以試著自己調整比例，做更特別的版本。'",
        "gal_map_text_202100484=這個味道很特別，我們給它起個專屬名字吧？'",
        "gal_map_text_202100485=阿米菈眼睛一亮，立刻開始 brainstorm，拉著你的袖子晃了晃，指尖緊緊抓住你的袖口。",
        "gal_map_text_202100486=好耶！起名字！叫什麼好呢？‘野莓邂逅’？還是‘春日甜夢’？'",
        "gal_map_text_202100487=阿米菈湊近你，身體緊緊挨著你，馬尾辮掃過你的胳膊，眼神裡滿是興奮。",
        "gal_map_text_202100488=專屬名字！太有意思了！我們一起想，要獨一無二的，只有我們知道的名字！'",
        "gal_map_text_202100489=阿米菈坐在旁邊，雙手托著下巴，專注地看著你，睫毛輕輕顫動。",
        "gal_map_text_202100490=起名字是個好主意，能讓這瓶香水更有紀念意義。我們慢慢想，結合我們一起調香的過程，起個有意義的名字。'",
        "gal_map_text_202100491=阿米菈語氣平靜，卻悄悄接過你遞來的筆，指尖不經意劃過你的指尖，眼神裡滿是期待。",
        "gal_map_text_202100492=可以，專屬名字能體現這瓶香水的獨特性。我們先列出幾個備選，再挑選最合適的，要簡潔又有內涵。'",
        "gal_map_text_202100493=這個味道很適合春日約會，噴上它肯定很受歡迎。'",
        "gal_map_text_202100494=阿米菈咬著嘴唇，眼神裡帶著一絲羞澀，指尖輕輕撫摸著香水瓶身。",
        "gal_map_text_202100495=春日約會？確實很合適！不過平時出門逛街噴也很好，清新又甜美，不會太張揚。'",
        "gal_map_text_202100496=阿米菈語氣堅定，眼神裡滿是喜愛，悄悄湊近你，想再聞一次香水的味道。",
        "gal_map_text_202100497=我覺得不僅適合約會，看書、下午茶的時候噴也很治癒！這個味道能讓人放鬆心情，太完美了！'",
        "gal_map_text_202100498=阿米菈撓撓頭，笑容憨厚，把香水瓶往你身邊推了推，讓你再聞一次。",
        "gal_map_text_202100499=春日約會嗎？也行，這個味道確實挺好聞的，噴上應該會很受歡迎。'",
        "gal_map_text_202100500=阿米菈語氣平淡，卻悄悄把椅子往你身邊挪了挪，能更清楚地聞到香水的味道。",
        "gal_map_text_202100501=都可以，這個味道很百搭，不管什麼場景噴都合適。我們趕緊把標籤貼好，珍藏起來。'",
        "gal_map_text_202100502=真的很好聞，草莓的甜、黑加侖的酸、玫瑰牡丹的香，還有白麝香和雪松的清爽，層次很豐富，像在春日的野莓園裡散步。",
        "gal_map_text_202100503=我也覺得！尤其是晃動之後，香氣更融合了。",
        "gal_map_text_202100504=阿米菈的指尖輕輕蹭過你的掌心，眼神裡滿是欣喜和羞澀，悄悄抬眼看向你，又快速低下頭。",
        "gal_map_text_202100505=我覺得 '莓香共赴' 不錯，既體現了野莓的香氣，又紀念了我們一起調香的過程。",
        "gal_map_text_202100506=太好了！就叫 '莓香共赴'！這個名字太有意義了！",
        "gal_map_text_202100507=阿米菈主動拿起筆，在香水瓶的標籤上寫下名字，指尖不小心碰到你的手，像觸電般縮了一下又悄悄蹭了蹭，笑容燦爛。",
        "gal_map_text_202100508=以後春日約會，我們就一起噴這瓶 '莓香共赴'，做最默契的搭檔。",
        "gal_map_text_202100509=真的！這個主意太棒了！以後約會就噴它，聞到這個味道就想起今天的快樂！",
        "gal_map_text_202100510=阿米菈拉著你的胳膊，指尖用力，笑容裡滿是欣喜和期待。",
        "gal_map_text_202100511=春日野莓園' 香水最終定型，淡粉色的液體在陽光下泛著溫柔的光澤，香氣清新甜美又不失溫柔，像把整個春日的野莓園和花園都裝在了瓶子裡。",
        "gal_map_text_202100512=阿米菈小心地貼上寫有 '莓香共赴' 的標籤，寶貝似的捧在手裡。她把瓶子湊近你，讓你再聞一次，指尖不經意劃過你的掌心，臉頰泛紅。",
        "gal_map_text_202100513=你們之間的氛圍愈發黏膩。羊毛氈的柔軟觸感、香水的獨特餘韻或是錄音的歡樂迴響，都讓彼此的距離不斷拉近。",
        "gal_map_text_202100514=每一個選擇都將牽動心動的節奏，阿米菈的古靈精怪也將帶來更多意想不到的小挑戰。",
        "gal_map_text_202100515=你提議'錄製現在'讓她愣了一下，隨即眼睛彎了起來，同意的點點頭。",
        "gal_map_text_202100516=你們選了一個隔間，關上門，世界瞬間安靜了許多。狹小的空間裡只有你們兩人，暖黃的氛圍燈亮起，將彼此的影子拉得長長的。",
        "gal_map_text_202100517=螢幕上開始 60 秒倒計時，背景音你們選了極輕微的 '篝火劈啪' 聲，像冬夜裡的暖爐，溫柔又治癒。",
        "gal_map_text_202100518=我們真的就錄現在的聲音嗎？可是現在除了篝火聲，好像沒什麼特別的。",
        "gal_map_text_202100519=沒關係，我們可以創造聲音。比如…… 模仿小動物叫，或者發出奇奇怪怪的音效，讓這段錄音變成獨一無二的 '此刻紀念'。",
        "gal_map_text_202100520=好！我先來！ 她深吸一口氣，對著麥克風發出了一聲軟乎乎的 '喵～'，然後自己忍不住笑場，肩膀輕輕顫抖，不小心撞在你的胳膊上。",
        "gal_map_text_202100521=一開始，兩人都因為刻意要保持安靜而有點不自然，接著開始冒出各種奇怪的聲音，不僅僅是搞怪的動物叫，甚至還有一些奇形怪狀的嚎叫聲、氣泡破裂聲、樹葉沙沙聲。",
        "gal_map_text_202100522=阿米菈越玩越興奮，對著麥克風發出一連串輕快的 '咕嚕咕嚕' 聲，像可愛的小倉鼠。",
        "gal_map_text_202100523=就在她想模仿鯨魚叫時，過於用力，不小心把麥克風的線扯了一下，麥克風從支架上滑落，正好砸向她的膝蓋上。",
        "gal_map_text_202100524=接住麥克風",
        "gal_map_text_202100525=向前詢問情況",
        "gal_map_text_202100526=安撫阿米菈",
        "gal_map_text_202100527=小心！'",
        "gal_map_text_202100528=我迅速伸手接住麥克風，指尖不經意碰到阿米菈的膝蓋，語氣帶著關切。",
        "gal_map_text_202100529=阿米菈拍著胸口，臉頰泛紅，眼神裡滿是後怕和感激。",
        "gal_map_text_202100530=哇！謝謝你！嚇死我了！還好你接住了，不然麥克風就掉地上了。'",
        "gal_map_text_202100531=阿米菈身體下意識往你身邊靠了靠，肩膀緊緊貼住你的胸膛，呼吸溫熱地拂過你的手腕。",
        "gal_map_text_202100532=太好了！有你在我就不用怕了！我剛才太投入，都沒注意到線松了。'",
        "gal_map_text_202100533=阿米菈挺起小胸脯，假裝鎮定，卻悄悄抓住你的袖子，尋求安全感。",
        "gal_map_text_202100534=我沒事沒事！就是嚇了一跳。我們趕緊把麥克風放好，繼續錄，剩下的時間不多了。'",
        "gal_map_text_202100535=阿米菈語氣堅定，卻還是等你把麥克風放好，才繼續對著麥克風說話。",
        "gal_map_text_202100536=我自己也能接住的，不過還是謝謝你反應快。我們趕緊調整麥克風，爭取在倒計時結束前錄完。'",
        "gal_map_text_202100537=小倉鼠受驚啦？快重啟錄音，把你的鯨魚叫補回來！'",
        "gal_map_text_202100538=阿米菈撅著嘴反駁，接過麥克風，立刻對著麥克風發出一聲更大的鯨魚叫，眼神裡滿是不服氣。",
        "gal_map_text_202100539=才不是小倉鼠！我是鯨魚！'",
        "gal_map_text_202100540=阿米菈按下重啟鍵，身體緊緊挨著你，馬尾辮掃過你的胳膊。",
        "gal_map_text_202100541=對！我們趕緊重啟錄音，這次我要模仿一整段鯨魚對話，讓你刮目相看！'",
        "gal_map_text_202100542=阿米菈坐在旁邊，雙手托著麥克風，專注地看著螢幕上的倒計時，睫毛輕輕顫動。",
        "gal_map_text_202100543=嗯，剩下的時間還夠，我們趕緊補錄，把剛才沒完成的聲音錄完。'",
        "gal_map_text_202100544=阿米菈語氣平靜，卻悄悄把椅子往你身邊挪了挪，方便兩人配合。",
        "gal_map_text_202100545=意外而已，不用在意。我們快速調整狀態，在倒計時結束前完成錄音，別浪費之前的創意。'",
        "gal_map_text_202100546=沒事吧？要不要換個簡單點的聲音，比如風聲或者雨聲？'",
        "gal_map_text_202100547=阿米菈咬著嘴唇，眼神裡帶著一絲倔強，指尖緊緊握住麥克風。",
        "gal_map_text_202100548=我沒事！不用換，我還能模仿鯨魚叫！剛才只是不小心，這次我會注意的。'",
        "gal_map_text_202100549=阿米菈語氣堅定，眼神裡滿是執著，悄悄調整了麥克風的位置。",
        "gal_map_text_202100550=我覺得鯨魚叫很特別，不能換！我們再試一次，這次我會小心一點，不會再扯到線了。'",
        "gal_map_text_202100551=阿米菈撓撓頭，笑容憨厚，把決定權交給你。",
        "gal_map_text_202100552=換風聲也行，風聲比較簡單，不容易出錯。不過如果你想繼續模仿鯨魚叫，我也沒意見。'",
        "gal_map_text_202100553=阿米菈語氣平淡，卻悄悄觀察著你的表情，想知道你更傾向於哪種方案。",
        "gal_map_text_202100554=都可以，你決定就好。換個聲音能節省時間，避免再出意外。'",
        "gal_map_text_202100555=沒事吧？膝蓋有沒有砸到？剛才的鯨魚叫還沒錄完呢，我們繼續。",
        "gal_map_text_202100556=沒事沒事，一點都不疼。",
        "gal_map_text_202100557=阿米菈對著麥克風，重新發出了一聲悠長又軟乎乎的鯨魚叫，眼神裡滿是笑意，悄悄抬眼看向你。",
        "gal_map_text_202100558=好，鯨魚小姐，準備好了嗎？這次我們一起模仿，我來當雄性鯨魚，你當雌性鯨魚。",
        "gal_map_text_202100559=好！沒問題！",
        "gal_map_text_202100560=阿米菈對著麥克風，發出一聲溫柔的鯨魚叫，你立刻配合著發出低沉的回應，兩人眼神交匯，忍不住笑場，卻又趕緊憋住，繼續完成錄音。",
        "gal_map_text_202100561=好，那我們繼續模仿鯨魚叫，不過這次要小心一點，別再扯到線了。",
        "gal_map_text_202100562=太好了！謝謝你相信我！",
        "gal_map_text_202100563=阿米菈對著麥克風，深吸一口氣，發出了一聲完美的鯨魚叫，聲音悠長又溫柔，眼神裡滿是欣喜和成就感。",
        "gal_map_text_202100564=錄音順利完成，螢幕上顯示 '錄製成功' 的字樣。你們戴著耳機，一起聽著這段充滿奇奇怪怪聲音的錄音，從軟乎乎的貓叫、咕嚕咕嚕的倉鼠聲，到悠長的鯨魚叫，還有兩人忍不住的憋笑聲，每一個聲音都充滿了歡樂。",
        "gal_map_text_202100565=阿米菈笑得直不起腰，靠在你的肩膀上。阿米菈小心翼翼地將聲音明信片收好，寶貝似的放進包裡，轉頭對你笑，眼底的光芒比燈光還要耀眼",
        "gal_map_text_202100566=你們之間的氛圍愈發黏膩。羊毛氈的柔軟觸感、香水的獨特餘韻或是錄音的歡樂迴響，都讓彼此的距離不斷拉近。",
        "gal_map_text_202100567=每一個選擇都將牽動心動的節奏，阿米菈的古靈精怪也將帶來更多意想不到的小挑戰。",
        "gal_map_text_202100568=好！原始人劇場，Action！' 阿米菈興奮地戴好耳機，對著毛絨麥克風清了清嗓子，眼睛裡閃爍著調皮的光芒。你立刻進入角色，用誇張的粗啞嗓音吼道：'嗷！我是火神！這片林子的果子都歸我管！誰敢搶我的果子，我就用火焰燒他！'",
        "gal_map_text_202100569=阿米菈立刻接上，捏著嗓子假裝生氣：'呸！你這傻大個！那是我先發現的甜甜果！還給我！不然我就用石頭砸你！' 一開始還像模像樣，但很快，你們都被對方拙劣的模仿和荒唐的臺詞逗得不行。",
        "gal_map_text_202100570=尤其是當阿米菈試圖模仿 '暴躁吃貨' 發出各種奇怪的抗議擬聲詞時，你一個沒忍住，笑場了，粗啞的嗓音瞬間破功，變成了哈哈大笑。",
        "gal_map_text_202100571=你笑場了！你輸了！按照規則，笑場的人要接受懲罰！",
        "gal_map_text_202100572=好好好，我輸了！你說，什麼懲罰？",
        "gal_map_text_202100573=懲罰就是…… 你要模仿一隻大猩猩，繞著隔間走三圈，還要發出 '咚咚咚' 的腳步聲！",
        "gal_map_text_202100574=你按照阿米菈的要求，模仿著大猩猩的樣子，繞著隔間慢慢走，發出 '咚咚咚' 的腳步聲。阿米菈坐在椅子上，笑得前仰後合，雙手緊緊抓住椅子的扶手，身體微微晃動。",
        "gal_map_text_202100575=就在你走到第三圈，準備發出一聲大猩猩的嚎叫時，不小心踩到了阿米菈掉在地上的耳機線，身體一個踉蹌，差點摔倒，幸好及時扶住了牆壁。",
        "gal_map_text_202100576=阿米菈的笑聲瞬間停止，連忙站起來：'啊！你沒事吧？有沒有摔倒？' 阿米菈急得跑到你身邊，伸手想扶你，眼神裡滿是擔憂。",
        "gal_map_text_202100577=順勢尋求阿米菈幫助。",
        "gal_map_text_202100578=",
        "gal_map_text_202100579=整理現場並安撫阿米菈",
        "gal_map_text_202100580=沒事，不過大猩猩被石頭絆倒了，需要原始人姑娘扶一把。'",
        "gal_map_text_202100581=我假裝虛弱地靠在牆上，伸出手，語氣帶著調侃。",
        "gal_map_text_202100582=阿米菈立刻伸出手，緊緊抓住你的手，指尖用力，臉頰泛紅，眼神裡滿是擔憂和羞澀。",
        "gal_map_text_202100583=好！我扶你！'",
        "gal_map_text_202100584=阿米菈身體緊緊挨著你，肩膀貼住你的胸膛，呼吸溫熱地拂過你的手腕，雙手緊緊抓住你的胳膊。",
        "gal_map_text_202100585=太好了！你沒事就好！我還以為你要摔倒了，嚇死我了！'",
        "gal_map_text_202100586=阿米菈挺起小胸脯，假裝鎮定，卻悄悄收緊了握著你的手。",
        "gal_map_text_202100587=我扶你起來，不過你可要小心點，別再踩到線了。我們繼續演戲，就說大猩猩被石頭絆倒，原始人姑娘救了他。'",
        "gal_map_text_202100588=阿米菈語氣堅定，卻還是等你站穩後，才慢慢鬆開你的手。",
        "gal_map_text_202100589=我扶你起來，我們可以把這個意外加到劇情裡，讓故事更有趣。比如大猩猩被絆倒後，感謝原始人姑娘，決定和阿米菈分享果子。'",
        "gal_map_text_202100590=看來大猩猩輸了，這次換原始人姑娘接受懲罰，模仿小猴子跳三圈！'",
        "gal_map_text_202100591=阿米菈立刻答應，雙手放在頭頂模仿猴子的耳朵，蹦蹦跳跳地繞著隔間跳了三圈，眼神裡滿是不服氣。",
        "gal_map_text_202100592=好！跳就跳！誰怕誰！'",
        "gal_map_text_202100593=阿米菈蹦蹦跳跳地繞著隔間跳，身體緊緊挨著你，馬尾辮掃過你的胳膊，笑容燦爛。",
        "gal_map_text_202100594=跳就跳！不過我跳完之後，你也要模仿小猴子，我們一起跳！'",
        "gal_map_text_202100595=阿米菈坐在旁邊，雙手托著下巴，專注地看著你，睫毛輕輕顫動。",
        "gal_map_text_202100596=好，我接受懲罰。不過跳完之後，我們繼續演戲，就說小猴子和大猩猩成為了好朋友，一起守護林子。'",
        "gal_map_text_202100597=阿米菈語氣平靜，卻悄悄跟著你的節奏，一起模仿小猴子跳。",
        "gal_map_text_202100598=可以，不過我們要控制時間，跳完之後儘快回到劇情，避免耽誤太多時間。'",
        "gal_map_text_202100599=沒事，我們先把耳機線整理好，避免再踩到，然後重新開始演戲。'",
        "gal_map_text_202100600=阿米菈立刻彎腰，和你一起整理耳機線，指尖輕輕碰到你的手背，臉頰泛紅，眼神裡滿是歉意。",
        "gal_map_text_202100601=好！我來幫你整理！'",
        "gal_map_text_202100602=阿米菈語氣堅定，眼神裡滿是認真，悄悄把耳機線藏好。",
        "gal_map_text_202100603=我覺得我們可以把耳機線藏在椅子下面，這樣就不會再踩到了。整理好之後，我們繼續演戲，把剛才的劇情接上。'",
        "gal_map_text_202100604=阿米菈撓撓頭，笑容憨厚，把麥克風遞到你面前。",
        "gal_map_text_202100605=整理好就好，我們繼續演戲吧。剛才說到哪裡了？好像是原始人姑娘和火神在搶果子。'",
        "gal_map_text_202100606=阿米菈語氣平淡，卻悄悄把椅子往你身邊挪了挪，方便兩人配合演戲。",
        "gal_map_text_202100607=都可以，你決定就好。整理好之後，我們儘快重啟劇情，別浪費時間。'",
        "gal_map_text_202100608=謝謝你，原始人姑娘。為了感謝你，我把我最珍貴的甜甜果分給你一半。'",
        "gal_map_text_202100609=真的嗎？太好了！那我們一起吃甜甜果，以後一起守護這片林子！'",
        "gal_map_text_202100610=阿米菈的指尖輕輕蹭過你的掌心，眼神裡滿是笑意和羞澀。",
        "gal_map_text_202100611=小猴子跳得真好看！不過大猩猩決定和小猴子一起，去尋找更多的甜甜果。",
        "gal_map_text_202100612=好！我們一起去尋找甜甜果！",
        "gal_map_text_202100613=阿米菈主動拉起你的手，蹦蹦跳跳地對著麥克風繼續演戲，指尖不經意劃過你的掌心，笑容燦爛。",
        "gal_map_text_202100614=整理好了，我們繼續演戲。這次火神決定不搶果子了，和原始人姑娘一起分享，怎麼樣？",
        "gal_map_text_202100615=好！太好了！這樣我們就是好朋友了！",
        "gal_map_text_202100616=阿米菈拉著你的胳膊，指尖用力，笑容裡滿是欣喜和期待。",
        "gal_map_text_202100617=原始人劇場最終圓滿落幕，你們戴著耳機，一起聽著這段充滿歡聲笑語的錄音，從粗啞的火神咆哮、調皮的原始人抗議，到兩人忍不住的笑場聲，每一個瞬間都充滿了快樂。",
        "gal_map_text_202100618=阿米菈笑得直不起腰，靠在你的肩膀上。阿米菈小心翼翼地將聲音明信片收好，寶貝似的放進包裡，轉頭對你笑，眼底的光芒比燈光還要耀眼。",
        "gal_map_text_202100619=你們之間的氛圍愈發黏膩。羊毛氈的柔軟觸感、香水的獨特餘韻或是錄音的歡樂迴響，都讓彼此的距離不斷拉近。",
        "gal_map_text_202100620=每一個選擇都將牽動心動的節奏，阿米菈的古靈精怪也將帶來更多意想不到的小挑戰。",
        "gal_map_text_202100621=你們選擇了錄製 '今日感想'，氣氛變得平和許多。你們輪流對著麥克風，簡單說了說今晚的行程和感受。",
        "gal_map_text_202100622=隔間裡暖黃的燈光溫柔地灑在兩人身上，背景音選了極輕微的 '雨聲'，像春天的細雨，淅淅瀝瀝，溫柔又治癒。",
        "gal_map_text_202100623=阿米菈的聲音透過耳機傳來，溫和又清晰，帶著一點淺淺的笑意。",
        "gal_map_text_202100624=· 你說的小貓確實很可愛，尤其是你給它畫的愛心嘴巴，一看就是你的風格。我剛才對著麥克風說的時候，還特意提到你戳羊毛氈時專注的樣子，特別有意思。",
        "gal_map_text_202100625=真的嗎？你還提到我了呀…… 其實我剛才也沒說全，在 '春日野莓園' 調香水的時候，你幫我把控比例，耐心教我怎麼混合香氣，我覺得特別安心。",
        "gal_map_text_202100626=因為你選的草莓和黑加侖搭配得很好，我只是稍微幫了點忙。而且你聞精油時的小表情，特別認真，我都忍不住多看了幾眼。",
        "gal_map_text_202100627=哪有…… 你今天模仿恐龍咆哮的時候才好玩呢，雖然在 '毛球行星' 嚇了我一跳，但現在想起來還覺得好笑。對了，你剛才說和我在一起很治癒，是真的嗎？",
        "gal_map_text_202100628=當然是真的，不管是你突發奇想的創意，還是遇到小意外時慌張又可愛的樣子，都讓今天的時光變得很特別。和你在一起，就算是簡單的聊天，也覺得很放鬆。'",
        "gal_map_text_202100629=就在你們準備結束錄音，點擊 '保存' 按鈕時，阿米菈低頭確認檔案名，手指不小心按錯了鍵，螢幕瞬間彈出 '是否刪除當前錄音' 的提示框，阿米菈慌亂中誤點了 '確認'—— 剛才錄製的 '今日感想' 全部消失了！",
        "gal_map_text_202100630=阿米菈驚呼一聲，眼睛瞬間睜大，滿臉懊惱和愧疚，雨聲背景音還在輕輕迴響，暖黃的燈光下，阿米菈的臉頰泛著紅暈，既自責又無措，悄悄抬眼看向你，眼神裡滿是依賴。",
        "gal_map_text_202100631=安撫阿米菈重新錄製",
        "gal_map_text_202100632=調侃是老天爺希望我們錄一個'加強版'",
        "gal_map_text_202100633=接納遺憾，把遺憾變為珍藏的回憶",
        "gal_map_text_202100634=沒關係，刪了我們再錄一次就好。而且剛才的感想都記在心裡了，再說一遍會更真誠呀。'",
        "gal_map_text_202100635=輕輕拍了拍阿米菈的肩膀，語氣溫柔得像雨聲，伸手幫阿米菈重新點開錄音介面。",
        "gal_map_text_202100636=阿米菈臉頰泛紅，愧疚感減輕了些，指尖不再攥緊衣角，反而悄悄靠近你的手，聲音軟糯。",
        "gal_map_text_202100637=那我們重新錄，這次我一定小心，再也不按錯了。'",
        "gal_map_text_202100638=阿米菈身體下意識往你身邊靠了靠，肩膀輕輕貼住你的胳膊，呼吸溫熱地拂過你的手腕。",
        "gal_map_text_202100639=有你在真好，不管我犯什麼錯，你都能幫我解決。'",
        "gal_map_text_202100640=阿米菈挺起小胸脯，假裝鎮定，卻還是讓你的手搭在阿米菈的肩膀上，尋求安心。",
        "gal_map_text_202100641=剛才我說的感想還有點不完整，這次我要補充更多開心的細節。'",
        "gal_map_text_202100642=阿米菈語氣堅定，卻悄悄調整坐姿，讓兩人的距離更近了些，眼神裡滿是信任。",
        "gal_map_text_202100643=我們重新錄，正好可以把剛才沒說全的話補充上。比如在‘毛球行星’你幫我解決膠水問題的時候，我覺得你特別靠譜。'",
        "gal_map_text_202100644=看來這是老天爺讓我們錄一個‘加強版’感想！這次我們不說行程，專門說一個對方今天最可愛的瞬間！'",
        "gal_map_text_202100645=阿米菈立刻轉悲為喜，眼睛亮晶晶的，對著麥克風清了清嗓子。",
        "gal_map_text_202100646=我先說！你今天模仿恐龍咆哮的時候，聲音又誇張又搞笑，特別可愛！'",
        "gal_map_text_202100647=阿米菈湊近麥克風，身體緊緊挨著你，馬尾辮掃過你的肩膀，笑容燦爛得晃眼。",
        "gal_map_text_202100648=對！加強版感想更有意思！我還要說你幫我解麥克風線的時候，手指特別靈活，認真的樣子也很可愛！'",
        "gal_map_text_202100649=阿米菈坐得筆直，卻主動對著麥克風配合你，嘴角藏不住笑意。",
        "gal_map_text_202100650=嗯，這個提議不錯，能讓感想更特別。我來說說你今天的可愛瞬間 —— 戳羊毛氈的時候，因為太專注，嘴角不自覺上揚，特別萌。'",
        "gal_map_text_202100651=阿米菈語氣平靜，卻跟著你的節奏笑了起來，眼神裡滿是輕鬆。",
        "gal_map_text_202100652=可以，趣味補充能讓錄音更有紀念意義。我來說說你剛才按錯按鈕後，一臉慌張又愧疚的樣子，很真實也很可愛。'",
        "gal_map_text_202100653=沒關係，錄音刪了但回憶還在呀。而且有時候遺憾也是一種特別的紀念，我們不用再錄了，把這份遺憾和開心一起記在心裡就好。'",
        "gal_map_text_202100654=阿米菈臉頰泛紅，愧疚感漸漸消散，對著你溫柔一笑。",
        "gal_map_text_202100655=你說得對！回憶記在心裡比錄音更珍貴。而且剛才我們說的話，我都記住了，比如你說和我在一起很開心，我也一樣。'",
        "gal_map_text_202100656=阿米菈眼神靈動，拿起空白明信片在手裡把玩，指尖輕輕摩挲著卡片邊緣。",
        "gal_map_text_202100657=其實不用重新錄，我們可以做一張‘空白聲音明信片’，以後看到它，就會想起今天的小意外和開心的事，更有意義。'",
        "gal_map_text_202100658=阿米菈撓了撓頭，笑容憨厚，語氣放鬆地看著你。",
        "gal_map_text_202100659=對，回憶記在心裡就好，不用再麻煩錄一次了。今天確實很開心，不管是做手工還是錄音，都很有意思。'",
        "gal_map_text_202100660=阿米菈語氣平淡，卻悄悄把空白明信片收了起來，想留作紀念。",
        "gal_map_text_202100661=都可以，錄音刪了也沒關係，反正今天的行程和感受我們都知道。我們可以趕緊去下一個地方，或者坐下來喝點東西，繼續聊天。'",
        "gal_map_text_202100662=重新錄製今日感想 —— 其實除了做手工和錄音，和你聊天、看你認真做事的樣子，也很開心。",
        "gal_map_text_202100663=我也是！剛才沒說，其實你幫我調整羊毛氈的時候，我覺得你特別溫柔……",
        "gal_map_text_202100664=阿米菈的聲音越來越小，尾音帶著藏不住的羞澀，指尖輕輕蹭過你的手背。",
        "gal_map_text_202100665=我補充！你今天在 '春日野莓園' 調香水的時候，聞草莓精油的樣子，像小松鼠發現了寶藏，超可愛！",
        "gal_map_text_202100666=才不是！你今天幫我擦發梢顏料的時候，動作特別輕，才更可愛呢！",
        "gal_map_text_202100667=阿米菈拉著你的手輕輕搖晃，指尖緊緊攥著你的手指，眼底的光芒比燈光還要亮。",
        "gal_map_text_202100668=那這張 '空白聲音明信片' 就作為我們的紀念，以後提起今天，就會想起這個小意外和沒保存下來的感想。",
        "gal_map_text_202100669=嗯！我會好好珍藏這張明信片！以後不管過多久，我都會記得今天和你一起的開心時光，還有這個小小的遺憾。",
        "gal_map_text_202100670=阿米菈拉著你的胳膊，指尖輕輕用力，笑容溫柔又治癒。",
        "gal_map_text_202100671=最終你們選擇了最契合心意的方式面對錄音被刪的小意外，無論是重新錄製的真誠感想，還是趣味補充的可愛瞬間，亦或是珍藏遺憾的空白明信片，都成了專屬你們的特別紀念。",
        "gal_map_text_202100672=走出隔間，雨聲背景音仿佛還在耳邊迴響，暖黃的燈光映著兩人的身影。阿米菈小心翼翼地將聲音明信片（或空白紀念卡）收好，寶貝似的放進包裡，轉頭對你笑，眼底的光芒比燈光還要溫柔。",
        "gal_map_text_202100673=手工創作暫告一段落，你們拿著各自（或共同）完成的作品 —— 無論是略顯抽象的羊毛氈小物，還是色彩斑斕的流體畫板 —— 走到了工作室裡側的休息區。這裡有一排靠窗的高腳椅和小圓桌，窗外是商業街流動的夜景。",
        "gal_map_text_202100674=阿米菈把阿米菈的 '大作' 小心翼翼地放在桌子中央，然後，阿米菈長長地舒了一口氣，整個人鬆弛下來，臉上帶著完成一件 '藝術品' 後的成就感和一點點可愛的得意。",
        "gal_map_text_202100675=阿米菈指著桌上的作品，眼睛彎成月牙，假裝嚴肅地介紹。",
        "gal_map_text_202100676=嘴角的笑意根本藏不住，手指還輕輕戳了戳羊毛氈小貓的歪耳朵。窗外的霓虹燈光在阿米菈臉上明明滅滅，讓阿米菈看起來格外生動。",
        "gal_map_text_202100677=欣賞了一會兒自己的傑作，阿米菈托著下巴，目光從作品移到你臉上，眼神裡的興奮漸漸沉澱為一種溫暖的柔軟。",
        "gal_map_text_202100678=其實一開始我還擔心搞砸呢，你記得嗎？我擠奶油膠的時候手都抖了，流體畫調顏色也差點把藍色和綠色混成交叉色。",
        "gal_map_text_202100679=當然記得，不過你補救得很聰明 —— 用亮片蓋住溢出來的膠水，還把混色的地方改成了 '星雲特效'，比原本的設計更特別。",
        "gal_map_text_202100680=真的嗎？你居然注意到了！我還以為只有我自己知道這些小小心思呢…… 阿米菈往你身邊挪了挪，高腳椅輕輕碰撞，距離更近了些。",
        "gal_map_text_202100681=阿米菈拿起你的作品，仔細端詳著。",
        "gal_map_text_202100682=阿米菈把你的作品和阿米菈的放在一起，擺成 '貓狗對視' 的姿勢，笑得眉眼彎彎。",
        "gal_map_text_202100683=阿米菈的目光停留在兩件作品上，又慢慢移回你臉上，帶著期待的神色，等待著你的回應。",
        "gal_map_text_202100684=以回憶方式安撫阿米菈",
        "gal_map_text_202100685=和阿米菈來一場互動遊戲",
        "gal_map_text_202100686=與阿米菈約定下一次再一起製作",
        "gal_map_text_202100687=誇讚阿米菈作品做的好",
        "gal_map_text_202100688=為作品舉辦一個專屬儀式",
        "gal_map_text_202100689=它們不僅在打招呼，還在紀念我們今天的小插曲呢。你看這膠水痕跡，是你急得冒汗時我幫你遞紙巾的樣子；這混色的星雲，是我們一起吐槽‘顏色怎麼這麼難調’的瞬間。'",
        "gal_map_text_202100690=阿米菈眼睛一熱，悄悄握住你的手腕。",
        "gal_map_text_202100691=我還以為這些小事只有我會記著，原來你也把我們一起經歷的瞬間藏在心裡了……'",
        "gal_map_text_202100692=阿米菈身體往你這邊靠得更近，肩膀貼住你的胳膊",
        "gal_map_text_202100693=對呀對呀！每次看到這些痕跡，我就會想起你幫我的樣子！'",
        "gal_map_text_202100694=阿米菈挺直後背，卻把作品往你那邊推了推。",
        "gal_map_text_202100695=你說得對，這些小細節才是最珍貴的。'",
        "gal_map_text_202100696=阿米菈笑著拿起作品。",
        "gal_map_text_202100697=下次我們可以挑戰更難的款式，我相信我們能配合得更好。'",
        "gal_map_text_202100698=不如我們來玩個‘作品配音’遊戲？你模仿你的喵星人，我模仿我的小狗，讓它們來一段對話，怎麼樣？'",
        "gal_map_text_202100699=阿米菈立刻捏著嗓子模仿小貓叫。",
        "gal_map_text_202100700=喵～你好呀，憨憨小狗，謝謝你今天陪我一起做手工！'",
        "gal_map_text_202100701=阿米菈慢慢湊近你，低聲說到。",
        "gal_map_text_202100702=我的小貓要問：‘下次我們還能一起做奶油膠手機殼嗎？’'",
        "gal_map_text_202100703=阿米菈坐得筆直，卻配合著模仿小貓的溫柔語氣。",
        "gal_map_text_202100704=喵～今天的手工很開心，下次還要一起呀。'",
        "gal_map_text_202100705=阿米菈語氣平靜，卻悄悄調整坐姿，方便和你互動。",
        "gal_map_text_202100706=可以，我們可以把今天的經歷編進對話裡，讓遊戲更有紀念意義。'",
        "gal_map_text_202100707=這兩件作品這麼有緣分，不如我們做個約定 —— 下次見面的時候，帶著各自的作品來‘打卡’，再一起做一件新的手工，把我們的‘毛球收藏’越積越多。'",
        "gal_map_text_202100708=阿米菈臉頰泛紅，指尖輕輕蹭過你的手背。",
        "gal_map_text_202100709=我一定會好好保管我的喵星人，下次準時帶著它來見你。'",
        "gal_map_text_202100710=阿米菈緊緊握住你的手。",
        "gal_map_text_202100711=以後每次見面都要帶著作品，還要一起做新的，讓我們的回憶越來越多。'",
        "gal_map_text_202100712=阿米菈挺起小胸脯，假裝鎮定。",
        "gal_map_text_202100713=我會把作品放在書桌最顯眼的地方，每天都能看到，想起我們的約定。'",
        "gal_map_text_202100714=阿米菈語氣堅定，卻悄悄把你的手攥得更緊了些。",
        "gal_map_text_202100715=可以，我們還可以給每次的作品編號，做成‘毛球紀念冊’，記錄我們一起做手工的時光。'",
        "gal_map_text_202100716=其實我最喜歡你作品裡的小細節 —— 你給喵星人畫的愛心眼睛，還有偷偷粘在耳朵後面的小珍珠，都藏著你的可愛。就像你今天一樣，表面上慌慌張張，其實做事特別認真細心。'",
        "gal_map_text_202100717=阿米菈眼睛亮晶晶的，身體突然抽搐了一下。",
        "gal_map_text_202100718=哇！你居然發現了我的小秘密！我還以為沒人會注意到耳朵後面的珍珠呢，你太懂我了！'",
        "gal_map_text_202100719=阿米菈嘴角藏著笑意，眼神認真。",
        "gal_map_text_202100720=謝謝你的認可，其實這些小細節是我特意加上去的。我覺得手工的意義就在於這些藏在裡面的小心思。'",
        "gal_map_text_202100721=阿米菈臉頰泛紅，指尖摩挲著桌沿。",
        "gal_map_text_202100722=其實我也是因為和你一起做，才想把作品做得更特別一點。'",
        "gal_map_text_202100723=阿米菈撓了撓頭，笑容憨厚。",
        "gal_map_text_202100724=真的嗎？我就是覺得加上珍珠會更好看。'",
        "gal_map_text_202100725=因為你的小心思都很可愛，所以我忍不住想多關注一點。下次做手工，我還要找一找你藏在作品裡的小秘密。",
        "gal_map_text_202100726=我們來給作品辦個‘專屬儀式’吧 —— 一起在作品背面寫下今天的日期和各自的名字縮寫，再畫一個小小的愛心，這樣就算以後分開存放，它們也帶著彼此的印記。'",
        "gal_map_text_202100727=阿米菈眼睛亮了起來，接過筆認真寫字。",
        "gal_map_text_202100728=阿米菈寫完後把作品舉起來給你看。",
        "gal_map_text_202100729=以後看到這個愛心，就想起今天的時光，還有和你一起做手工的開心。'",
        "gal_map_text_202100730=阿米菈撓了撓頭，認真地在作品背面寫字。",
        "gal_map_text_202100731=好呀，這樣以後看到作品，就能想起今天的日期和我們一起做手工的事。'",
        "gal_map_text_202100732=阿米菈語氣平淡，卻悄悄把字寫得工工整整，還特意畫了一個小小的愛心。",
        "gal_map_text_202100733=都可以，這個儀式挺有紀念意義的。'",
        "gal_map_text_202100734=不如叫 '毛球星球的約定'，紀念我們今天在這裡的相遇和合作。",
        "gal_map_text_202100735=好！就叫這個名字！以後看到作品，就想起我們的約定，還要一起挑戰更多手工！",
        "gal_map_text_202100736=阿米菈臉頰泛紅，用力點頭。",
        "gal_map_text_202100737=汪！當然可以！下次我要做個和你小貓配對的手機殼，我們的作品就能一直在一起啦！",
        "gal_map_text_202100738=你模仿得太像了！那我們就約定好，下次一起來做配對手工，還要給它們配更多對話！",
        "gal_map_text_202100739=阿米菈笑得直不起腰",
        "gal_map_text_202100740=那我們現在就給作品編號，你的是 001，我的是 002，下次的新作品就是 003，一直攢下去。",
        "gal_map_text_202100741=好！我現在就寫！還要寫上今天的日期，這樣我們的約定就更正式啦！",
        "gal_map_text_202100742=阿米菈立刻拿出筆在作品底部寫字。",
        "gal_map_text_202100743=因為你的小心思都很可愛，所以我忍不住想多關注一點。下次做手工，我還要找一找你藏在作品裡的小秘密。",
        "gal_map_text_202100744=好呀！下次我會藏更多小細節，讓你找個夠，不過你也要告訴我你作品裡的小秘密哦！",
        "gal_map_text_202100745=阿米菈臉頰泛紅，輕輕點頭。",
        "gal_map_text_202100746=你看，我的名字縮寫旁邊畫了一個和你一樣的愛心，這樣我們的作品就永遠是一對啦。",
        "gal_map_text_202100747=嗯！它們本來就是一對，以後還要一起見證我們更多的開心時光！",
        "gal_map_text_202100748=阿米菈笑著點頭，把作品和你的放在一起",
        "gal_map_text_202100749=你們完成了屬於彼此的互動和約定，阿米菈小心翼翼地把作品裝進店員提供的禮品袋裡，寶貝似的抱在懷裡。",
        "gal_map_text_202100750=走到工作室門口，阿米菈轉頭對你笑，眼底的光芒比窗外的霓虹還要亮。",
        "gal_map_text_202100751=阿米菈輕輕碰了碰你的胳膊，臉頰泛紅。手裡護著喵星人",
        "gal_map_text_202100752=調香完成，你們拿著那瓶獨一無二的 '共創香水'，被店員指引著來到店鋪後方一個隱秘的小露臺。",
        "gal_map_text_202100753=這裡有幾張藤編的吊椅和 '氣泡椅'（透明半球形的搖椅），裝飾著串燈和香薰蠟燭，像個小小的空中花園。夜晚的微風正好吹散了店內濃烈的複合香氣，只留下你們手中那瓶香水淡淡的、獨特的尾巴。",
        "gal_map_text_202100754=阿米菈小心地把香水瓶放在小圓桌上，然後率先坐進一個氣泡椅，椅子輕輕晃動起來。",
        "gal_map_text_202100755=阿米菈閉上眼睛，深吸了一口氣，嘴角揚起滿足的笑意。一股特別的味道讓阿米菈十分享受。",
        "gal_map_text_202100756=阿米菈睜開眼睛，拿起香水瓶遞到你面前，眼神裡滿是期待。",
        "gal_map_text_202100757=確實不一樣了，晚風把前調的甜潤和後調的沉穩融合得恰到好處，像我們今天調香的過程 —— 從一開始的試探選料，到後來的默契配合。",
        "gal_map_text_202100758=對呀對呀！我剛才還在想，這個味道就像我們今天的約會，有甜甜的小驚喜，還有讓人安心的陪伴。",
        "gal_map_text_202100759=而且這是我們一起調的獨一無二的味道，再也找不到第二瓶了。",
        "gal_map_text_202100760=嗯！這是專屬我們的味道，我要給它起個名字，讓它成為我們的專屬紀念。",
        "gal_map_text_202100761=阿米菈拿著香水瓶，指尖輕輕劃過瓶身的標籤，看著標籤上的名稱總感覺差點意思。",
        "gal_map_text_202100762=阿米菈抬頭看向你，眼神裡帶著求助和期待你給阿米菈起一個好聽的名字。",
        "gal_map_text_202100763=露臺共杉",
        "gal_map_text_202100764=杉語甜遇",
        "gal_map_text_202100765=星露秘語",
        "gal_map_text_202100766=莓杉赴約",
        "gal_map_text_202100767=清杉甜風",
        "gal_map_text_202100768=不如叫‘露臺共杉’？‘露臺’藏著我們現在的場景，‘杉’對應後調的雪松，既簡潔又有畫面感，以後聞到雪松味，就想起今晚的晚風與共。'",
        "gal_map_text_202100769=阿米菈臉頰泛紅，悄悄握住你的手腕。",
        "gal_map_text_202100770=這個名字好浪漫！晚風與共’的感覺一下子就出來了，以後每次看到標籤，就想起我們坐在露臺吹晚風的瞬間，太有紀念意義了。",
        "gal_map_text_202100771=阿米菈身體往你這邊靠得更近，肩膀貼住你的胳膊。",
        "gal_map_text_202100772=每個字都藏著今天的回憶！以後噴這個香水，就像把露臺的晚風、你的陪伴都帶在身邊，太戳心了。'",
        "gal_map_text_202100773=阿米菈拿起筆在標籤上寫下名字。",
        "gal_map_text_202100774=‘露臺’是場景錨點，‘杉’是香氣核心，既好記又有專屬感，以後整理香水收藏也能快速想起由來。'",
        "gal_map_text_202100775=阿米菈拿出手機記錄。",
        "gal_map_text_202100776=我們把命名思路寫在備忘錄裡，再備註‘前調草莓+中調玫瑰+後調雪松’，以後翻看就能完整回憶創作過程，形成專屬檔案。'",
        "gal_map_text_202100777=叫‘杉語甜遇’怎麼樣？‘杉語’對應雪松的沉靜，‘甜遇’藏著草莓的甜香和我們的相遇，既呼應香氣，又帶著心動的感覺。'",
        "gal_map_text_202100778=阿米菈聽到名字後，開心的晃動氣泡椅。",
        "gal_map_text_202100779=哇！這個名字太甜了！‘甜遇’正好說透了今天的心情，和你一起調香、取名字，就是最甜的相遇呀！'",
        "gal_map_text_202100780=阿米菈拉著你的胳膊晃了晃。",
        "gal_map_text_202100781=我們還要給名字加個小注解，寫在標籤旁邊：‘雪松訴語，甜香遇你’，這樣更有故事感了！'",
        "gal_map_text_202100782=阿米菈坐得筆直，眼神溫柔。",
        "gal_map_text_202100783=‘杉語’顯沉靜，‘甜遇’帶暖意，剛好契合香水的層次，也藏著我們的相處氛圍。'",
        "gal_map_text_202100784=阿米菈語氣平靜卻帶著期待。",
        "gal_map_text_202100785=以後再調新香水，就沿用‘XX甜遇’的格式，形成我們的專屬香氣系列，很有延續性。'",
        "gal_map_text_202100786=不如叫‘星露秘語’？‘星’對應夜晚的星光，‘露’是露臺的晚風與露水感，‘秘語’藏著只有我們懂的香氣暗號，低調又專屬。'",
        "gal_map_text_202100787=阿米菈眼睛亮了起來。",
        "gal_map_text_202100788=這個名字好特別！秘語’剛好呼應我們的專屬香氣，以後聞到這個味，就像在聽只有我們懂的悄悄話，太有感覺了。'",
        "gal_map_text_202100789=阿米菈狡黠一笑。",
        "gal_map_text_202100790=我猜你是想把星光、露臺、暗號都藏進去！‘星露’是場景，‘秘語’是心意，這個名字既含蓄又有深度，完全符合我們的香水氣質。'",
        "gal_map_text_202100791=阿米菈撓撓頭，笑容憨厚。",
        "gal_map_text_202100792=這個名字聽起來很溫柔。雖然沒那麼直白，但慢慢品就覺得很有味道，和我們的香水一樣耐聞。'",
        "gal_map_text_202100793=阿米菈語氣平淡，卻悄悄把香水瓶往你身邊挪了挪。",
        "gal_map_text_202100794=‘秘語’意味著只有我們懂，以後看到名字就知道是我們的專屬，很有意義。'",
        "gal_map_text_202100795=叫‘莓杉赴約’怎麼樣？‘莓’是你喜歡的草莓甜香，‘杉’是我們一起選的雪松，‘赴約’藏著今天的相遇和未來的約定，每個字都有故事。'",
        "gal_map_text_202100796=阿米菈輕輕靠向你。",
        "gal_map_text_202100797=‘赴約’正好說透了我想和你再見面的心意，以後看到這個名字，就想起今天的約定，太暖心了。'",
        "gal_map_text_202100798=阿米菈緊緊握住你的手。",
        "gal_map_text_202100799=我太喜歡了！每個字都和我們有關，‘莓’是我的選擇，‘杉’是我們的默契，‘赴約’是我的期待，以後這就是我們的約定信物。'",
        "gal_map_text_202100800=阿米菈挺起小胸脯。",
        "gal_map_text_202100801=‘赴約’既不刻意又藏著心意，這種有邊界感的專屬才更珍貴，以後見面就帶著這瓶香水赴約。'",
        "gal_map_text_202100802=阿米菈笑著提議。",
        "gal_map_text_202100803=這次是‘莓杉赴約’，下次見面調新香水就叫‘XX同行’，讓名字跟著我們的羈絆成長。'",
        "gal_map_text_202100804=不如叫‘清杉甜風’？‘清杉’突出雪松的清冽，‘甜風’對應草莓的甜香和露臺的晚風，簡約又貼合香水的氣質，好記又耐品。'",
        "gal_map_text_202100805=阿米菈湊近香水瓶聞了聞。",
        "gal_map_text_202100806=‘清杉’剛好形容雪松的沉靜，‘甜風’像草莓香混著晚風的感覺，精准又有畫面感。'",
        "gal_map_text_202100807=阿米菈眼神靈動。",
        "gal_map_text_202100808=名字不長但信息量足，既點明了核心香氣，又藏著場景，以後別人問起，一說就懂我們的心意。'",
        "gal_map_text_202100809=阿米菈撓撓頭。",
        "gal_map_text_202100810=聽起來很舒服，和香水的味道一樣讓人放鬆，以後想不起來名字都能隨口說出來。'",
        "gal_map_text_202100811=阿米菈語氣平淡。",
        "gal_map_text_202100812=簡約不花哨，又能體現香水的特點，以後放在香水架上，一看名字就知道是我們一起調的，很實用。'",
        "gal_map_text_202100813=我們在標籤背面加個小暗號，畫個迷你露臺剪影，只有我們知道這個圖案的含義，讓名字和細節更配。",
        "gal_map_text_202100814=好呀！我現在就畫，還要把今天的日期寫上，讓這個名字成為我們專屬的時光印記。",
        "gal_map_text_202100815=用力點頭，臉頰泛紅。",
        "gal_map_text_202100816=那我們現在就把名字和注解寫在標籤上，用草莓色的筆寫'甜遇'，雪松色的筆寫'杉語'，顏色也和香氣呼應。",
        "gal_map_text_202100817=好！寫完我們拍張照存起來，以後每次用香水，都能想起這個甜甜的名字和今天的快樂。",
        "gal_map_text_202100818=阿米菈開心點點頭。",
        "gal_map_text_202100819=我們給'秘語'定個小規則，以後只有聞到這個香水味，才能說這句暗號：'星露之下，香遇是你'，怎麼樣？",
        "gal_map_text_202100820=好呀！這個暗號太浪漫了，以後見面就用它打招呼，成為我們獨有的小默契。",
        "gal_map_text_202100821=阿米菈開心的臉頰泛紅了起來。",
        "gal_map_text_202100822=我們在標籤上畫兩個小圖示，草莓和雪松枝並排，旁邊寫'第一次赴約'，以後每次見面都在標籤上補充新的印記。",
        "gal_map_text_202100823=好！這瓶香水現在不僅有名字，還有約定，以後帶著它赴約，就是最特別的儀式感。",
        "gal_map_text_202100824=阿米菈拉著你的胳膊晃了晃。",
        "gal_map_text_202100825=我們用兩種顏色的筆寫名字，藍色寫'清杉'，粉色寫'甜風'，視覺上也能體現香氣的層次感。",
        "gal_map_text_202100826=好！簡約又有細節，以後每次看到標籤，都能想起我們一起琢磨名字的溫柔時光。",
        "gal_map_text_202100827=阿米菈牽著你的手，點頭贊同。",
        "gal_map_text_202100828=你們終於確定了香水的專屬名字，阿米菈小心翼翼地把名字、日期和小注解寫在標籤上，筆尖劃過瓶身的動作溫柔又認真。",
        "gal_map_text_202100829=阿米菈雙手捧著香水，和你一起噴灑在彼此手腕——柑橘與雪松的清香纏繞，你的手指不經意覆在阿米菈的手背上，阿米菈臉頰泛紅，指尖微顫，卻沒有躲開。",
        "gal_map_text_202100830=阿米菈主動挽住你的胳膊，指尖輕輕搭在你的手腕上，帶著香水的微涼與阿米菈的體溫。",
        "gal_map_text_202100831=拿著那張剛剛列印出來的、帶著溫熱感的聲音明信片，你們走出了略顯喧鬧的錄音隔間區，來到了店鋪角落一個安靜的 '聲音郵筒' 旁。",
        "gal_map_text_202100832=這裡光線柔和，牆上有真正的復古郵筒造型，旁邊設有一個掃碼播放的耳機，可以試聽別人投遞的 '聲音糖果'（匿名且自願公開的片段）",
        "gal_map_text_202100833=阿米菈把明信片小心地拿在手裡，借著燈光看著上面列印的、你們錄音時的卡通化形象和那個醒目的二維碼，臉上帶著一種新奇又珍重的表情。",
        "gal_map_text_202100834=阿米菈手指劃過二維碼只要掃一下，就能立刻‘回到’那個小小的隔間裡，阿米菈轉頭看向你，眼裡滿是對這份 '聲音紀念' 的珍視。",
        "gal_map_text_202100835=確實很神奇，尤其是我們剛才錄的那些搞怪音效，現在看著卡通小人，仿佛還能聽到你模仿的鯨魚叫和我那聲誇張的恐龍咆哮。",
        "gal_map_text_202100836=不許笑！明明是你先帶頭搞怪的，害得我也跟著放飛自我了。",
        "gal_map_text_202100837=我覺得最特別的是，這張明信片裡藏著我們獨有的默契 —— 比如錄音時你撞翻支架，我們一起急中生智補錄音效的瞬間，只有我們知道背後的故事。",
        "gal_map_text_202100838=對呀！這就是專屬我們的 '聲音秘密'！",
        "gal_map_text_202100839=阿米菈把聲音明信片小心地拿在手裡，借著燈光反復欣賞，指尖輕輕劃過上面的卡通形象和二維碼，嘴角掛著藏不住的笑意。",
        "gal_map_text_202100840=只要掃一下碼，就能立刻‘回到’那個小隔間，阿米菈轉頭看向你，眼底閃著細碎的光，語氣帶著期待。",
        "gal_map_text_202100841=和阿米菈分享製作明信片的回憶",
        "gal_map_text_202100842=和阿米菈約定一起收集更多明信片",
        "gal_map_text_202100843=和一起阿米菈準備一個紀念盒",
        "gal_map_text_202100844=買一個合適裝明信片的小盒子",
        "gal_map_text_202100845=拉著阿米菈先去休息區重溫我們的錄音",
        "gal_map_text_202100846=我們把它變成‘回憶索引’。以後每多一段難忘的時光，就多一個這樣的‘索引’—— 可以是新的聲音明信片，也可以是錄音片段。等攢得夠多了，就按時間線整理成‘時光手冊’，每次翻起，就能順著索引找回所有心動瞬間。'",
        "gal_map_text_202100847=阿米菈臉頰泛紅，緊緊抓住你的手腕。",
        "gal_map_text_202100848=以後看到這張‘索引’，就想起今天的錄音和你的心意，像你一直在身邊一樣。我要把它放在床頭，每天睡前都看看，盼著攢滿一本‘時光手冊’。'",
        "gal_map_text_202100849=阿米菈身體往你身邊靠得更近，肩膀貼住你的胳膊。",
        "gal_map_text_202100850=太好了！我早就想和你有這樣的約定了！'",
        "gal_map_text_202100851=阿米菈挺直後背，卻把明信片往你那邊推了推。",
        "gal_map_text_202100852=既不會遺漏重要瞬間，又能讓回憶有跡可循，這種有規劃的紀念，比零散的收藏更珍貴。'",
        "gal_map_text_202100853=阿米菈不在刻意的保持距離，想著你身邊靠去。",
        "gal_map_text_202100854=聲音明信片標‘對話類’，單獨錄音標‘氛圍類’，以後還能新增‘場景類’—— 比如逛公園的自然音效，讓手冊內容更豐富，見證我們的每一步。'",
        "gal_map_text_202100855=那我們就多攢幾張唄！等足夠多的時候就貼滿一面‘回憶牆’，每張都標上日期和當時的小故事。這面牆比任何裝飾都珍貴，以後朋友來家裡，一看就知道我們一起經歷了多少開心時光。'",
        "gal_map_text_202100856=阿米菈開心的拉著你的手，臉上露出幸福的表情。",
        "gal_map_text_202100857=我們以後每次攢夠3張，就一起給牆面換個佈局，還能在旁邊貼照片、掛小掛件，把牆面變成我們的‘時光紀念館’！'",
        "gal_map_text_202100858=阿米菈眼睛亮得像星星，開心的說到。",
        "gal_map_text_202100859=我們還要把錄音的二維碼列印出來貼在旁邊，再掛上手作小裝飾，朋友掃碼就能聽到當時的聲音，身臨其境感受我們的快樂！'",
        "gal_map_text_202100860=阿米菈語氣平靜卻帶著笑意。",
        "gal_map_text_202100861=不用追求牆面多華麗，每張明信片背後的故事才是核心。我們慢慢攢，慢慢貼，讓牆面跟著我們的羈絆一起成長。'",
        "gal_map_text_202100862=阿米菈手指靠在下巴，認真的思考後說到。",
        "gal_map_text_202100863=按年份分成不同板塊，每張明信片旁邊用小字標注‘當時在做什麼’‘印象最深的瞬間’，讓回憶牆既有溫度又有條理，成為我們關係的‘視覺化見證’。",
        "gal_map_text_202100864=是啊，這種實體紀念品是挺有意思的。以後看到，肯定能想起很多細節—— 比如你模仿鯨魚叫時的軟乎乎的尾音，還有我們笑場時的慌亂。我們可以專門準備一個‘紀念盒’，把所有聲音明信片、錄音U盤都存進去，做成專屬的‘時光寶藏盒’。'",
        "gal_map_text_202100865=阿米菈嘴角藏著笑意，眼神認真。",
        "gal_map_text_202100866=我早就注意到你喜歡收藏小物件，這個盒子剛好能裝下我們所有的聲音紀念，以後打開盒子，就像打開了裝滿回憶的百寶箱。'",
        "gal_map_text_202100867=阿米菈眼神靈動，帶著一絲羞澀。",
        "gal_map_text_202100868=肯定是木質的，帶鎖的那種，還要在盒子裡鋪絨布，保護明信片不被磨損，對不對？我們還要給每個藏品貼標籤，寫清日期和背景。'",
        "gal_map_text_202100869=阿米菈撓了撓頭，笑容憨厚。",
        "gal_map_text_202100870=我家裡有個閒置的小盒子，剛好能用上。以後每次新增紀念，我們就一起放進盒子，慢慢把它裝滿，想想就很有成就感。'",
        "gal_map_text_202100871=阿米菈臉頰泛紅，指尖輕輕蹭過你的手背。",
        "gal_map_text_202100872=盒子不用太複雜，能好好保存紀念品就行。以後不管過多久，打開盒子看到這些明信片，就能想起今天的場景，比存在手機裡更有質感。'",
        "gal_map_text_202100873=這張明信片設計得挺可愛的，我們接下來是直接回去，還是再稍微逛一會？前面好像有家居店，說不定能買到適合裝明信片的小盒子，剛好能把它好好收起來。'",
        "gal_map_text_202100874=阿米菈挺起小胸脯，把明信片舉到你面前。",
        "gal_map_text_202100875=剛好能給這張‘寶貝明信片’選個專屬小盒子，最好是帶卡通圖案的，和上面的卡通形象呼應，太完美了！'",
        "gal_map_text_202100876=阿米菈語氣堅定，卻悄悄把你的手攥得更緊了些。",
        "gal_map_text_202100877=我們還能看看小掛件、貼紙，給明信片做個專屬裝飾，再拍一段‘開箱vlog’，記錄給它找‘家’的過程，超有意義！'",
        "gal_map_text_202100878=阿米菈臉頰泛紅，指尖摩挲著明信片邊緣。",
        "gal_map_text_202100879=剛好能慢慢挑選合適的盒子，不用太花哨，實用又好看就行，把明信片好好收起來，也是對這段回憶的珍視。'",
        "gal_map_text_202100880=阿米菈立刻點頭，腳步輕快地跟著你",
        "gal_map_text_202100881=選盒子要注意尺寸，剛好能放下明信片，最好是防潮材質，能長久保存。順便可以看看收納標籤，給明信片標上日期，方便以後查找。'",
        "gal_map_text_202100882=這邊好像沒什麼別的可看了，我們走。剛好前面有個休息區，能坐下來歇口氣，順便再掃一次二維碼，重溫一下我們的錄音，也算是給今天的約會畫個圓滿的句號。'",
        "gal_map_text_202100883=阿米菈眼睛一熱，悄悄握住你的手腕。",
        "gal_map_text_202100884=剛好能再聽一次我們的搞怪錄音，剛才光顧著開心，都沒仔細回味。休息區還有飲品賣，我們買杯喝的，邊聽邊聊，太愜意了！'",
        "gal_map_text_202100885=阿米菈拿出手機打開相機。",
        "gal_map_text_202100886=走！還要拍個‘重溫錄音’的小視頻！對著二維碼掃碼，記錄下我們聽錄音時的反應，以後翻出來看，肯定能再笑一次，完美收尾今天的約會！'",
        "gal_map_text_202100887=阿米菈語氣平和，慢慢跟著你走向休息區。",
        "gal_map_text_202100888=剛好能靜下心來再聽一遍錄音，感受裡面的笑聲和互動，給今天的時光做個溫柔的總結。'",
        "gal_map_text_202100889=阿米菈點頭回應，腳步平穩。",
        "gal_map_text_202100890=休息時再聽錄音，能更清晰地回憶當時的細節。我們還可以簡單聊聊剛才錄音的趣事，為今天的約會做個完整的收尾。'",
        "gal_map_text_202100891=我們現在就給這張明信片標上'索引001'，背面寫'聲音糖果屋·搞怪互動'，以後每新增一個，就按順序編號，手冊的目錄都現成了。",
        "gal_map_text_202100892=好！我還要畫個小小的麥克風圖示，作為'聲音索引'的專屬標識。等手冊攢到10個，我們就去定制一本實體冊，把明信片都貼進去！",
        "gal_map_text_202100893=阿米菈立刻拿出筆在明信片角落寫字。",
        "gal_map_text_202100894=我們現在就給這張'開篇明信片'選個牆面位置，等下次見面帶卷尺量尺寸，順便錄'索引002'，一步步把牆面填滿。",
        "gal_map_text_202100895=好！我要把它放在牆面最中間的位置，作為我們回憶牆的'核心'，以後所有新的'索引'都圍繞它展開",
        "gal_map_text_202100896=阿米菈把明信片緊緊攥在手裡。",
        "gal_map_text_202100897=我們給盒子加個'開箱儀式'，每次放新藏品的時候，都錄一段簡短的語音，說說當時的心情，和紀念品一起存進去，雙重回憶加持。",
        "gal_map_text_202100898=好呀！我還要在盒子外面貼一張我們的合照，再寫'我們的時光寶藏'，以後看到盒子，就知道裡面裝著我們所有的珍貴回憶。",
        "gal_map_text_202100899=阿米菈點頭贊同，拿起筆在合照上寫著'我們的時光寶藏'。",
        "gal_map_text_202100900=我們選個透明的盒子吧，能直接看到明信片的圖案，放在書桌也能當小裝飾，每次看到都能想起今天的錄音時光。",
        "gal_map_text_202100901=好！還要選個帶小鎖的，把我們的'時光門票'好好鎖住，以後每次打開盒子，都像打開一段專屬回憶。",
        "gal_map_text_202100902=阿米菈開心選起了這個存放'時光門票'的盒子。",
        "gal_map_text_202100903=來，掃碼一起聽！我記得你模仿鯨魚叫那段超可愛，等下要再聽一遍。",
        "gal_map_text_202100904=好！聽完我們再約定下次見面，就去定制專屬的錄音U盤，把今天的聲音好好保存起來。",
        "gal_map_text_202100905=阿米菈坐在休息區長椅上，拿出手機挨著你坐下。",
        "gal_map_text_202100906=你們完成了屬於彼此的聲音互動和專屬約定，阿米菈小心翼翼地把聲音明信片放進透明的卡套裡，寶貝似的放進包裡，還特意拍了張照片存在手機裡。",
        "gal_map_text_202100907=走到 '聲音郵筒' 旁，阿米菈轉頭對你笑，眼底的光芒比柔和的燈光還要亮。",
        "gal_map_text_202100908=阿米菈偷偷湊到你耳邊說到'我會每天都掃碼聽聽我們的錄音，把明信片放在最安全的地方，等著下次見面一起錄新的‘聲音糖果’，慢慢攢夠我們的專屬合集，讓每一段相處時光都有聲音可以回憶！'",
        "gal_map_text_202100909=離開休息區前，工作室深處一面巨大的 '材料靈感牆' 闖入視線。",
        "gal_map_text_202100910=牆面被暖黃色射燈照亮，左側掛滿了蓬鬆的高級羊毛（從奶白到焦糖色漸變排列）、閃著珠光的特種顏料，右側則貼滿了密密麻麻的客人 '許願單'—— 有畫著歪耳朵小貓的簡筆劃。",
        "gal_map_text_202100911=有歪歪扭扭寫著 '想和閨蜜挑戰等身羊駝' 的可愛字跡，還有用彩色膠帶裝飾的情侶約定，字裡行間都是對下次手作的期待。晚風從敞開的窗戶吹進來，帶著羊毛的柔軟氣息，吹動了牆上的便簽，發出輕輕的嘩啦聲。",
        "gal_map_text_202100912=阿米菈眼睛一亮，快步湊到牆邊，指尖輕輕拂過一張畫著情侶鑰匙扣的便簽，看到大家都有各種不同想法的作品忍不住輕笑出聲。",
        "gal_map_text_202100913=阿米菈逐字讀著不同的許願內容，從 '下次要做完美的奶油膠手機殼' 到 '希望和喜歡的人一起戳羊毛氈'，臉頰的紅暈慢慢加深。",
        "gal_map_text_202100914=阿米菈轉身從旁邊的原木桌上抽出一張雲朵形狀的空白便簽，拿起一支薄荷綠的彩色筆，筆尖在紙上輕輕點了點，轉頭看向你時，眼睛亮晶晶的，帶著躍躍欲試的狡黠拉著一起寫下約定期待下次來的時候能找出來。",
        "gal_map_text_202100915=你想寫什麼？是延續今天的羊毛氈作品，還是許個新的手工願望？",
        "gal_map_text_202100916=我還在想呢～ 你看別人有寫情侶款的，有寫挑戰目標的，還有藏小秘密的，都好特別。",
        "gal_map_text_202100917=不如和我們今天的作品綁定？這樣回憶更連貫，下次看到便簽，就能想起今天一起補救羊毛氈的樣子。",
        "gal_map_text_202100918=這個主意好！但具體寫什麼呢？是約定下次完善作品，還是…… 加個只有我們懂的小細節？",
        "gal_map_text_202100919=阿米菈把便簽平放在窗臺上，雙手撐著檯面，身體微微前傾，晚風拂動阿米菈耳邊的碎發，髮絲輕輕掃過臉頰。",
        "gal_map_text_202100920=阿米菈下意識地抬手撥開，指尖不經意間和你的手背輕輕擦過，又飛快地收回，臉頰的紅暈更濃了。阿米菈咬了咬下唇，筆尖在便簽上畫了個小小的貓狗輪廓（和你們的羊毛氈同款），抬頭看向你時，眼神裡滿是期待。",
        "gal_map_text_202100921=寫下次一起給貓狗組合做情侶小圍巾",
        "gal_map_text_202100922=與阿米菈一起完成便簽",
        "gal_map_text_202100923=與阿米菈來一個默契測試小遊戲",
        "gal_map_text_202100924=不如寫‘下次一起給貓狗組合做情侶小圍巾’？把今天的作品升級，下次來兌現這個願望，再把便簽和圍巾一起存進紀念冊，一步步積累我們的手工回憶。'",
        "gal_map_text_202100925=阿米菈工整地寫下約定內容，字體俐落。",
        "gal_map_text_202100926=先完成小圍巾，再推進後續的手工計畫，避免盲目約定，這樣每一次見面都有明確的目標，回憶也會更有條理。'",
        "gal_map_text_202100927=阿米菈拿出手機快速記錄，眼神認真而專注。",
        "gal_map_text_202100928=可以補充兩個細節：第一，下次見面時間初步定在兩周後，我會提前查好羊毛氈小圍巾的製作教程，標注需要準備的材料清單；第二，把便簽拍照存檔，分別存進我們的‘手工約定’專屬相冊，防止丟失。'",
        "gal_map_text_202100929=阿米菈筆尖帶著笑意，在便簽上畫了個小小的愛心。",
        "gal_map_text_202100930=每次看到這張便簽，就會想起今天一起補救羊毛氈的溫暖，想起你幫我挑羊毛時的認真，這種有溫度的約定，比任何完美的計畫都珍貴。'",
        "gal_map_text_202100931=阿米菈緊緊攥著便簽，指尖微微用力。",
        "gal_map_text_202100932=這不僅是手工約定，更是我們羈絆的延伸，以後看到小圍巾，就會想起你此刻的心意，想起我們一起度過的時光，真的太戳心了。'",
        "gal_map_text_202100933=我們一起完成這張便簽吧！你負責畫貓狗簡筆劃和裝飾，我負責寫約定內容，最後用我們兩人的頭髮絲纏在便簽角做專屬標記，這樣既體現共同創作，又有獨一無二的細節。'",
        "gal_map_text_202100934=阿米菈剪了根自己的碎發，又輕輕扯了扯你的頭髮（帶著調皮的笑意）。",
        "gal_map_text_202100935=哇！頭髮絲標記太有創意了！我們還要邊做邊拍小視頻，記錄這個專屬瞬間，以後翻出來看，肯定會覺得很有趣！'",
        "gal_map_text_202100936=阿米菈從材料架上翻出彩虹膠帶和閃粉貼紙。",
        "gal_map_text_202100937=不止頭髮絲！便簽貼滿裝飾，再在旁邊畫個 Q 版的我們！ 完成後我們還要跳個慶祝舞，紀念這個獨一無二的共同創作，太開心啦！'",
        "gal_map_text_202100938=阿米菈慢慢拿起彩筆，認真地畫著貓狗簡筆劃，線條流暢而細膩。",
        "gal_map_text_202100939=共同創作的過程比結果更珍貴，我們安靜地完成每一步，不用追求花哨，這種默契的互動，就是最好的儀式感。'",
        "gal_map_text_202100940=阿米菈輕輕接過你遞來的頭髮絲，動作緩慢而認真。",
        "gal_map_text_202100941=先把簡筆劃畫對稱，再把約定內容寫在中間，最後小心翼翼地把頭髮絲纏在一起打個結，不慌不忙，讓這個標記成為我們默契的見證，靜靜沉澱屬於我們的回憶。'",
        "gal_map_text_202100942=我們來玩個默契測試吧！各自在便簽的背面畫一個只有對方能看懂的小圖案（和今天的手工相關），再寫下一句暗號，然後交換便簽，看看能不能猜中對方的圖案和暗號含義，猜中了就把這個圖案作為我們的專屬標識。'",
        "gal_map_text_202100943=阿米菈立刻把便簽翻到背面，眼神專注。",
        "gal_map_text_202100944=我肯定能猜中你畫的圖案！畢竟今天一起做手工，你喜歡的細節我都看在眼裡，比如你剛才給小狗加的亮片裝飾，我就記得很清楚。'",
        "gal_map_text_202100945=阿米菈一邊畫一邊觀察你的表情。",
        "gal_map_text_202100946=你平時喜歡用簡潔的暗號，而且肯定和‘約定’‘陪伴’相關，再結合今天的羊毛氈，圖案大概率和小狗的某個細節有關 —— 比如你剛才特意調整的項圈位置。'",
        "gal_map_text_202100947=阿米菈撓了撓頭，慢慢在便簽上畫著。",
        "gal_map_text_202100948=我畫的圖案和我今天的喵星人有關，但可能有點抽象，你要慢慢猜哦。'",
        "gal_map_text_202100949=阿米菈認真地畫著圖案，動作緩慢而認真。",
        "gal_map_text_202100950=我畫的是今天補救羊毛氈時用的補色羊毛，暗號就寫‘歪耳朵的約定’，應該不算太難猜。不管猜不猜中，都是一次有趣的互動，以後看到這個圖案，就會想起今天的默契測試。'",
        "gal_map_text_202100951=我們還可以給每個約定的手工起個專屬名字，比如這次的小圍巾就叫 '羈絆・初遇款'，以後每完成一個，就按順序編號，慢慢攢成我們的 '專屬手工系列'。",
        "gal_map_text_202100952=這個主意好！我現在就把名字寫在便簽旁邊，還要標注上 '編號 001'。對了，紀念冊我們可以各自準備一本，每次見面交換著寫心得，這樣兩邊都有完整的回憶。",
        "gal_map_text_202100953=阿米菈眼睛亮了起來，同意的點點頭。",
        "gal_map_text_202100954=我們把頭髮絲的結打在便簽的右下角，旁邊再刻上我們名字的首字母縮寫，這樣細節更完整，也更有專屬感。",
        "gal_map_text_202100955=對呀！我還要用和我們羊毛氈同色系的彩筆塗色，讓簡筆劃和作品呼應起來。完成後我們把便簽貼在靈感牆的中間位置，下次來一眼就能看到。",
        "gal_map_text_202100956=阿米菈開心的點頭贊同，嘴角帶笑。",
        "gal_map_text_202100957=我畫的圖案和你的喵星人有關，暗號是‘下次一起完善’，看看你能不能猜中。其實就算沒猜中也沒關係，我們可以互相解釋，加深對彼此的瞭解。",
        "gal_map_text_202100958=讓我猜猜…… 你畫的是我喵星人的歪耳朵？因為今天我們一起補救過，對不對？暗號的含義就是下次一起完善這個歪耳朵，讓它變得更完美。",
        "gal_map_text_202100959=阿米菈接過便簽，認真端詳起來，嘴角帶笑。",
        "gal_map_text_202100960=無論選擇哪個選項，你們都完成了專屬便簽的創作，小心翼翼地把它貼在靈感牆最顯眼的位置。阿米菈拉著你一起和便簽、羊毛氈作品合影，照片裡的兩人臉頰都帶著淡淡的紅暈，眼神裡滿是藏不住的溫柔。",
        "gal_map_text_202100961=阿米菈把合照發給你，又認真地把便簽拍照存檔，放進專屬相冊。",
        "gal_map_text_202100962=晚風再次吹過，牆上的便簽輕輕晃動，仿佛在為這份臨近告白的曖昧羈絆作證。",
        "gal_map_text_202100963=準備離開工作室去結帳時，收銀台旁的木質展架格外顯眼。暖黃色燈光照亮了架上的 '作品認證' 道具：透明亞克力展示盒、印著 '手作大師（自封）' 的搞笑證書。",
        "gal_map_text_202100964=最吸睛的是一排排打磨光滑的木頭切片小掛牌 —— 表面刻著 '歪歪扭扭才可愛'",
        "gal_map_text_202100965=專屬回憶' 等字樣，旁邊立著 '可定制刻字（8 字內）+ 簡筆劃' 的告示牌，木質紋理搭配精緻刻痕，透著溫馨的專屬感。",
        "gal_map_text_202100966=阿米菈目光定格在定制掛牌上，伸手拿起一個湊到燈光下，指尖輕輕撫摸光滑的表面。心裡想著'這個好適合我們的羊毛氈！'。",
        "gal_map_text_202100967=阿米菈轉頭問店主：'能刻自己想寫的話嗎？比如和作品相關的約定？' 店主笑著點頭。",
        "gal_map_text_202100968=阿米菈捧著掛牌轉身看向你，眼睛亮晶晶的，臉頰帶著未褪的紅暈。連忙推著拉著我給兩個'小寶貝'刻個專屬掛牌。",
        "gal_map_text_202100969=確實很搭！你想刻什麼？是和剛才便簽的約定呼應，還是弄個只有我們懂的暗號？",
        "gal_map_text_202100970=暗號好像更特別！但又想和便簽的約定綁定，這樣回憶更連貫……",
        "gal_map_text_202100971=暗號 + 約定' 結合啊！比如刻一句短暗號，藏著下次的約定，既專屬又有延續性。",
        "gal_map_text_202100972=這個主意好！比如刻和 '貓狗組合' 相關的，以後看到掛牌，就想起便簽的約定，還能解鎖新互動。",
        "gal_map_text_202100973=阿米菈拿起兩個掛牌，分別放在你們的羊毛氈旁比對，指尖輕輕劃過掛牌邊緣。店主遞來樣冊，上面有楷書、行書、卡通體等字體，還有小貓、星星、愛心等簡筆劃範本。",
        "gal_map_text_202100974=阿米菈翻樣冊時，胳膊不經意碰到你的胳膊，下意識縮了縮，臉頰泛紅：'其實刻什麼都好，' 阿米菈輕聲說，'重要的是和你一起定制的，是屬於我們的專屬標記。' 說完抬頭看向你，眼神裡滿是徵詢和期待。",
        "gal_map_text_202100975=定制暗號專屬掛牌",
        "gal_map_text_202100976=定制回憶專屬掛牌",
        "gal_map_text_202100977=定制語音專屬掛牌",
        "gal_map_text_202100978=定制情侶專屬掛牌",
        "gal_map_text_202100979=我們刻互補暗號吧！你的掛牌刻‘喵星人待命’，我的刻‘小狗來赴約’，既呼應羊毛氈，又藏著‘下次見面’的約定，以後看到掛牌就像在打招呼～'",
        "gal_map_text_202100980=阿米菈拉著你的手腕。",
        "gal_map_text_202100981=好甜呀！' 臉頰微紅，立刻指著樣冊的卡通體，'就要這個字體！以後我把喵星人掛在包上，看到掛牌就像感覺到你在身邊，不許你把小狗的掛牌摘下來哦'",
        "gal_map_text_202100982=阿米菈緊緊攥著掛牌，眼神認真。",
        "gal_map_text_202100983=掛牌要一直掛在羊毛氈上，下次見面先檢查‘暗號成對’，少一個都不行'",
        "gal_map_text_202100984=阿米菈平靜地選擇了簡潔的楷書，指尖輕點樣冊上的小貓簡筆劃。",
        "gal_map_text_202100985=暗號設計很有專屬感。互補的設定既聯動又不刻意，這種有邊界的專屬才更珍貴'",
        "gal_map_text_202100986=阿米菈眼神堅定又帶著溫柔。",
        "gal_map_text_202100987=這次是‘待命’和‘赴約’，下次完成約定後，就定制新掛牌刻‘同行’和‘相伴’，讓標識跟著我們的羈絆升級'",
        "gal_map_text_202100988=不如把掛牌和語音綁定！我們各錄一句想對對方說的話，讓店主把錄音二維碼刻在掛牌背面，掃碼就能聽到，相當於給羊毛氈加了‘專屬語音包’～'",
        "gal_map_text_202100989=立刻拿起手機錄音，錄音時聲音軟軟的，嘴角帶著笑意。",
        "gal_map_text_202100990=這個設計太特別了！我剛才就注意到你總看我的羊毛氈，肯定是想讓它和你的有聯動'",
        "gal_map_text_202100991=阿米菈講錄音前湊到你耳邊",
        "gal_map_text_202100992=我猜你想錄‘下次見’！我要錄‘記得兌現便簽約定’，和你呼應'",
        "gal_map_text_202100993=阿米菈撓了撓頭慢慢錄音，錄完後有點不好意思地把手機遞給你。",
        "gal_map_text_202100994=我錄的是‘今天的羊毛氈很好看’，可能有點普通，但都是真心話。你也錄一句吧，我想聽聽'",
        "gal_map_text_202100995=認真對著手機錄音，語氣坦誠。",
        "gal_map_text_202100996=這樣能留住當下的聲音。以後掃碼聽到聲音，就能想起今天的場景，不管過多久都不會忘'",
        "gal_map_text_202100997=刻今天的回憶亮點吧！你的刻‘歪耳相遇・暖光相伴’，我的刻‘指尖相觸・約定未停’，既記錄今天的瞬間，又藏著下次的約定，讓羈絆跟著回憶升級～'",
        "gal_map_text_202100998=阿米菈立刻選了行書字體",
        "gal_map_text_202100999=這個設計邏輯很清晰！既記錄了今天的核心回憶，又銜接了下次的約定，讓每一個標記都有意義，不會只是單純的裝飾'",
        "gal_map_text_202101000=阿米菈拿出手機記下刻字內容，眼神變得認真起來。",
        "gal_map_text_202101001=我們各自把掛牌的含義寫在便簽背面存檔，下次見面交換核對，再補充新的回憶亮點，形成‘羈絆升級手冊’'，",
        "gal_map_text_202101002=阿米菈眼眶微紅，指尖輕輕摸著掛牌。",
        "gal_map_text_202101003=‘暖光相伴’剛好形容剛才在靈感牆的樣子，每次看到都會想起今天的溫柔，比任何華麗的文字都珍貴'",
        "gal_map_text_202101004=阿米菈緊緊攥著掛牌",
        "gal_map_text_202101005=看到這兩句話，我都想起剛才的場景了！指尖相觸的瞬間、暖光下的便簽、補救羊毛氈的默契…… 都藏在裡面了'，抬頭時眼底帶著淚光，'這不僅是掛牌，更是我們的回憶載體'",
        "gal_map_text_202101006=刻一句守護型約定吧！你的刻‘小狗守護歪耳’，我的刻‘喵星相伴左右’，既對應羊毛氈角色，又藏著‘我會陪著你’的心意，溫柔又專屬～'",
        "gal_map_text_202101007=阿米菈開心地選了卡通體，還加了個愛心簡筆劃。拉著你的手晃來晃去。",
        "gal_map_text_202101008=以後我的喵星人有小狗守護，你的小狗有喵星人相伴，它們和我們一樣都不孤單'",
        "gal_map_text_202101009=阿米菈給掛牌系上同款繩子，再拍個‘守護認證照’'，踮起腳尖湊到你身邊。",
        "gal_map_text_202101010=還要升級守護約定！' 翻出彩虹色的掛牌繩。以後見面要讓羊毛氈‘貼貼’，完成守護儀式～'",
        "gal_map_text_202101011=阿米菈認真的選擇了楷書，語氣平靜卻帶著溫度。",
        "gal_map_text_202101012=不用花哨的裝飾，簡單的一句話就能體現心意，這種默默的守護才更長久'",
        "gal_map_text_202101013=阿米菈輕輕撫摸掛牌上的刻痕，抬頭看向你，眼神溫柔而堅定。",
        "gal_map_text_202101014=我們專注把心意藏在細節裡。守護不需要刻意宣告，刻在掛牌上、記在心裡就好'",
        "gal_map_text_202101015=我們再加個同款小愛心簡筆劃吧？你的刻在暗號左邊，我的刻在右邊，湊起來就是完整的愛心。",
        "gal_map_text_202101016=好呀！這樣就算分開看，也知道是一對的～ 等刻好，我們給羊毛氈和掛牌拍個 '全家福'，存進專屬相冊。",
        "gal_map_text_202101017=阿米菈滿意的點了點頭。",
        "gal_map_text_202101018=我錄了‘你的喵星人歪耳朵很可愛，下次一起補救得更完美’，掃碼聽聽？其實就算忘了約定，聽到聲音也能想起。",
        "gal_map_text_202101019=你的聲音錄進去好好聽！我們把二維碼截圖發給對方，就算沒帶掛牌，也能隨時聽。",
        "gal_map_text_202101020=阿米菈掃碼時耳朵微微泛紅，聽完抬頭笑",
        "gal_map_text_202101021=我們再加個小細節，你的掛牌刻個小亮片圖案，我的刻個羊毛圖案，呼應今天的手工材料，回憶更完整。",
        "gal_map_text_202101022=對呀！這樣每個元素都有意義，以後看到亮片和羊毛，也會想起今天的羈絆。",
        "gal_map_text_202101023=阿米菈認真的刻制的小亮片圖案。",
        "gal_map_text_202101024=我們把掛牌掛在羊毛氈的項圈上吧？這樣就像給它們戴上了 '專屬守護符'，每次看到都能想起這份心意。",
        "gal_map_text_202101025=好！掛好後我們給它們拍個 '守護同框照'，以後每次見面都拍一張，看看它們的 '守護羈絆' 有沒有越來越深。",
        "gal_map_text_202101026=阿米菈立刻拿出手機，嘴角帶著笑意。",
        "gal_map_text_202101027=無論選擇哪個選項，定制好的掛牌都順利掛在了各自的羊毛氈上 —— 暗號成對、語音藏心、回憶定格、守護相伴，每個掛牌都成了專屬羈絆的延伸。",
        "gal_map_text_202101028=阿米菈捧著掛好牌的喵星人，和你的小狗羊毛氈湊在一起拍照，鏡頭裡兩個小物件緊緊挨著，像你們 '友達以上' 的距離。阿米菈把合照發給你，又小心翼翼地把羊毛氈放進隨身包。",
        "gal_map_text_202101029=店主笑著遞上打包好的作品，你們並肩走出工作室，晚風帶著羊毛的柔軟氣息，身後的 '毛球行星' 燈火溫暖，預示著這份臨近告白的羈絆，還將繼續升溫。",
        "gal_map_text_202101030=露臺角落立著一棵纏繞暖白燈帶的 '香味許願樹'，細枝上掛滿印著香水瓶輪廓的卡片，部分卡片邊緣浸染著精油痕跡，風一吹，玫瑰、薄荷、蜜桃的香氣交織彌漫。",
        "gal_map_text_202101031=樹下木桌上擺著空白卡片和三種香型的筆（薰衣草、柑橘、雪松），旁邊貼著手寫提示：'寫下你想與 TA 共赴的氣味之約，讓風為羈絆作證'。",
        "gal_map_text_202101032=阿米菈被卡片上的字跡吸引，駐足翻看：'有人寫‘想和喜歡的人去普羅旺斯聞薰衣草’，還有人寫‘希望每年生日都能聞到 TA 送的香水味’'",
        "gal_map_text_202101033=阿米菈拿起一張空白卡片，指尖輕嗅薰衣草味的筆，轉頭看向你時眼睛亮閃閃的。",
        "gal_map_text_202101034=阿米菈拉著你的手，露出期待的眼神似乎想拉著你一起寫一張。",
        "gal_map_text_202101035=想寫什麼約定？是一起去聞更多香味，還是藏個只有我們懂的暗號？",
        "gal_map_text_202101036=暗號好像更特別，但又想讓約定有畫面感…… 比如和季節相關的？",
        "gal_map_text_202101037=可以 '暗號 + 場景' 結合！比如用氣味當暗號，藏著下次見面的場景，既專屬又有期待感。",
        "gal_map_text_202101038=這個主意好！比如用今天的柑橘香當暗號，藏著 '秋天去摘橘子' 的約定，以後聞到柑橘味就想起要赴約。",
        "gal_map_text_202101039=阿米菈把卡片平放在木桌上，雙手撐著桌面微微前傾，風帶起阿米菈耳邊的碎發，不經意間掃過你的手腕。阿米菈拿起雪松味的筆在卡片邊緣畫小星星，筆尖停頓。",
        "gal_map_text_202101040=指尖輕輕碰了碰你的手背，又飛快收回，臉頰紅暈更深了。",
        "gal_map_text_202101041=寫雪松為證，共赴桂香之約",
        "gal_map_text_202101042=寫共赴",
        "gal_map_text_202101043=錄一段‘氣味語音’",
        "gal_map_text_202101044=我們寫‘雪松為證，共赴桂香之約’！雪松呼應今天的香水，桂香藏著‘秋天一起去賞桂’的約定，下次見面帶著這瓶香水，聞到桂香就兌現約定，讓季節、氣味、我們綁在一起。'",
        "gal_map_text_202101045=阿米菈立刻用雪松味的筆寫下文字",
        "gal_map_text_202101046=雪松是今天的印記，桂香是未來的期待，時間線明確，回憶也有連貫性。我會提前查好桂花開的時間，設成日曆提醒，還會備註‘帶星夜海岸香水赴約'",
        "gal_map_text_202101047=阿米菈拿出手機快速記錄，眼神認真而專注。",
        "gal_map_text_202101048=可以補充兩個細節：第一，賞桂地點選近郊的桂花園，避開週末人流高峰；第二，約定當天要完成‘氣味混合儀式’—— 用這瓶香水和桂花味混合，記錄下新氣味的成分比例，存入我們的‘專屬氣味檔案’'",
        "gal_map_text_202101049=阿米菈筆尖帶著笑意，在文字旁畫了小小的桂花。",
        "gal_map_text_202101050=以後聞到桂香，就會想起今天的約定，想起你說的‘綁在一起’，心裡都暖暖的'，眼眶微紅，'",
        "gal_map_text_202101051=阿米菈緊緊攥著卡片，指腹摩挲著字跡。",
        "gal_map_text_202101052=雪松的安心、桂香的溫柔，就像我們現在的感覺 —— 你陪著我，我跟著你'",
        "gal_map_text_202101053=我們錄一段‘氣味語音’吧！各自說一句想對對方說的話，生成二維碼貼在卡片上，以後掃碼就能聽到今天的聲音，再聞到對應的香味，雙重回憶暴擊。'",
        "gal_map_text_202101054=阿米菈立刻拿起手機錄音，錄音時聲音軟軟的，帶著笑意。",
        "gal_map_text_202101055=這個設計太特別了！我剛才就注意到你總看著我笑，眼神裡的溫柔都藏不住，肯定有悄悄話想對我說'",
        "gal_map_text_202101056=阿米菈將錄音前湊到你耳邊，氣息輕輕拂過你的耳廓。",
        "gal_map_text_202101057=我要錄‘下次見面，換我帶你去聞我喜歡的薰衣草，讓你知道被人放在心上的感覺’，和你呼應'",
        "gal_map_text_202101058=阿米菈撓了撓頭慢慢錄音，手指有點笨拙地操作手機。",
        "gal_map_text_202101059=我錄的是‘今天的香水很好聞，和你一起調香很開心，謝謝你一直陪著我，下次還要一起做更多有意思的事’，可能有點普通，但都是我心裡最真實的想法'",
        "gal_map_text_202101060=阿米菈認真對著手機錄音，語氣坦誠而平靜。",
        "gal_map_text_202101061=我錄了‘下次見面，我們再調一款新香水，就用今天約定的香味，把我們的回憶一直延續下去’，和我們的約定呼應'",
        "gal_map_text_202101062=我錄了‘你的聲音比柑橘還甜，和你在一起的每一秒都很珍貴，希望以後的每個日子，都能和你一起聞喜歡的香味，說想說的話’，掃碼聽聽？",
        "gal_map_text_202101063=阿米菈立刻翻出手機裡拍的梨渦特寫。",
        "gal_map_text_202101064=我還要加‘扭蛋時抽到的雪松香味’！這個也是今天的小幸運呀'，拉著你一起選筆，'",
        "gal_map_text_202101065=阿米菈飛快列出清單， 拿起畫筆在卡片上畫對應的小圖示。",
        "gal_map_text_202101066=不止三個細節，還要加‘你遞精油時的手’‘許願樹的暖光’‘你笑起來的虎牙’！'",
        "gal_map_text_202101067=阿米菈慢慢寫下細節，眼神溫柔而專注，用雪松味的筆輕輕描邊。",
        "gal_map_text_202101068=細節能留住最珍貴的回憶。選三個最有代表性的就好，太多反而會沖淡核心的記憶點'",
        "gal_map_text_202101069=阿米菈輕聲分析，仔細調整排版。",
        "gal_map_text_202101070=我們按時間線排列細節。第一滴精油（開始）→ 碰手的溫度（高潮）→ 梨渦笑容（收尾），文字用‘時光留痕，氣味存檔'",
        "gal_map_text_202101071=我們在卡片背面寫 '約定暗號：桂香漫時，雪松相伴'，以後見面先對暗號，不對上就罰對方給彼此拍一張桂花特寫。",
        "gal_map_text_202101072=好呀！我還要用柑橘味的筆給文字描邊，呼應今天的香水，讓卡片上也有 '我們的味道'。對了，我們把卡片掛在許願樹向陽的枝椏上，讓陽光曬著，就像我們的約定一直被溫暖守護著。",
        "gal_map_text_202101073=阿米菈臉頰泛紅，認真看著卡牌背面上寫的約定暗號。",
        "gal_map_text_202101074=我們把小符號畫在卡片右上角，再加上我們名字的首字母縮寫，用薰衣草味的筆寫，和卡片的其他顏色形成呼應，細節更完整。",
        "gal_map_text_202101075=好呀！我還要選和香水顏色相近的淡橙色卡片紙，讓卡片也帶著 '我們的味道'，以後看到這張卡片，就像聞到了今天的香水味一樣。",
        "gal_map_text_202101076=阿米菈拿起薰衣草味的筆，認真在卡片上畫起了小符號。",
        "gal_map_text_202101077=我們把文字定為 '共生之味，共創之約'，既呼應了分工創作的過程，又藏著 '一起走下去' 的心意，怎麼樣？",
        "gal_map_text_202101078=好！我還要在卡片上寫今天的日期，精確到分鐘，讓細節更完整，以後看到這個時間，就想起我們一起畫符號、印指紋、討論排版的每一刻，想起我們之間的默契。",
        "gal_map_text_202101079=阿米菈點頭贊同，嘴角帶著溫柔的笑意。",
        "gal_map_text_202101080=無論選擇哪個組合的選項，你們都完成了香味許願卡的創作。阿米菈小心翼翼地把卡片吹幹，對著燈光反復欣賞，指尖輕輕撫摸上面的文字和圖案，眼神裡滿是珍視。",
        "gal_map_text_202101081=阿米菈拉著你走到許願樹前，踮起腳尖把卡片掛在向陽的枝椏上，卡片在風裡輕輕晃動，帶著淡淡的香味。",
        "gal_map_text_202101082=風一吹，樹上的卡片沙沙作響，混合著周圍的香氣，仿佛在為你們的羈絆祝福。",
        "gal_map_text_202101083=收銀台旁的定制標籤小檯子上，擺著一台彩色標籤印表機，旁邊散落著各種圖案的標籤紙 —— 可愛的卡通香水瓶、簡約的線條、浪漫的愛心，還有能印照片的定制款。",
        "gal_map_text_202101084=標籤機螢幕上顯示著多種字體可選，店員笑著遞來一本樣冊。",
        "gal_map_text_202101085=店員簡單介紹了定制香水瓶標籤的內容。阿米菈聽得十分認真。暖黃色的燈光照在標籤紙上，顯得格外溫馨。",
        "gal_map_text_202101086=阿米菈拿起那瓶你們共同調製的香水，對著燈光看了看，透明的磨砂瓶身裡，淡橙色的液體泛著微光。",
        "gal_map_text_202101087=阿米菈在標籤機的螢幕上滑動選擇著圖案，手指輕輕點著螢幕，有點糾結。",
        "gal_map_text_202101088=轉頭看向你時，眼睛裡滿是徵詢的意味。",
        "gal_map_text_202101089=我覺得可以和許願卡的主題呼應！比如許願卡是約定，標籤就印約定的關鍵字；許願卡是默契挑戰，標籤就印默契香的名字，這樣回憶更連貫。",
        "gal_map_text_202101090=這個主意好！我想讓標籤不僅有文字，還要有小小的圖案，比如許願卡上的星星，這樣看到標籤就想起許願卡，看到許願卡就想起香水。",
        "gal_map_text_202101091=可以 '文字 + 圖案 + 暗號' 結合！文字印專屬名字，圖案印許願卡上的元素，暗號印只有我們懂的小符號，三重回憶疊加，更有意義。",
        "gal_map_text_202101092=太好啦！那我們就這麼定，把今天的回憶、約定、默契都印在標籤上，讓這瓶香水成為我們的 '回憶載體'",
        "gal_map_text_202101093=阿米菈把香水放在標籤機旁，指尖輕輕撫摸著瓶身，動作溫柔而認真。店員幫阿米菈調試著標籤機，時不時抬頭看向你，眼神裡帶著期待。",
        "gal_map_text_202101094=你看著阿米菈糾結圖案的模樣，忽然指了指兩人的手腕 —— 上面還留著彼此噴灑的香水味，氣息纏繞在一起。阿米菈的指尖不經意間碰到你的手，又飛快收回，臉頰泛著淺淺的紅暈，和瓶身裡的液體顏色一樣溫暖，眼神裡的期待更濃了。",
        "gal_map_text_202101095=叫‘共鳴’",
        "gal_map_text_202101096=叫‘與你’",
        "gal_map_text_202101097=印今天的日期",
        "gal_map_text_202101098=選個好看的圖案",
        "gal_map_text_202101099=就叫‘共鳴’吧。你看我們現在，共用同一個氣味，連呼吸都帶著彼此的香水味，這就是最特別的共鳴。再配個交織的香氣波紋圖案，和許願卡的羈絆主題呼應。'",
        "gal_map_text_202101100=阿米菈立刻選了簡約的香氣波紋圖案",
        "gal_map_text_202101101=氣味共鳴是我們今天的核心，圖案和文字呼應，邏輯清晰，以後看到就想起這份雙向的氣味羈絆。'",
        "gal_map_text_202101102=阿米菈拍了拍我的後背，補充到。",
        "gal_map_text_202101103=補充兩個細節：第一，香氣波紋用柑橘和雪松兩種顏色，對應香水主調；第二，標籤背面印‘氣味共鳴・202X.X.X’，標注日期方便歸檔，和我們的‘氣味檔案’保持一致。'",
        "gal_map_text_202101104=阿米菈指尖輕撫螢幕上的波紋圖案。",
        "gal_map_text_202101105=‘共鳴’不僅是氣味，更是我們的心意相通，以後噴香水時，就像在和你‘隔空共鳴’，心裡暖暖的。'",
        "gal_map_text_202101106=阿米菈緊緊攥著香水，眼底帶光。",
        "gal_map_text_202101107=我們的氣味交織，心意共鳴，這個標籤就是最好的見證，我要把它貼在瓶身最顯眼的位置，每次拿出來都能想起此刻。'",
        "gal_map_text_202101108=叫‘與你’怎麼樣？紀念我們第一次一起合作調香，‘與你’調香、‘與你’分享氣味、‘與你’留下回憶。圖案就選簡約的雙人剪影，和我們許願卡的互動主題呼應。'",
        "gal_map_text_202101109=阿米菈臉頰微紅，立刻指著雙人剪影圖案。",
        "gal_map_text_202101110=每次看到這兩個小身影，就想起你幫我調香的樣子，以後這瓶香水就是‘與你’相關的專屬紀念，我要天天帶在身邊。'",
        "gal_map_text_202101111=阿米菈緊緊攥著香水，眼神認真。",
        "gal_map_text_202101112=以後每次和你見面，都要噴一點‘與你’，讓這個名字成為我們的見面信號，少一次都不行。'",
        "gal_map_text_202101113=阿米菈平靜地選擇了楷書字體。",
        "gal_map_text_202101114=不刻意張揚，卻能體現專屬感，這種有邊界的羈絆才更珍貴，符合我們的相處節奏。'",
        "gal_map_text_202101115=阿米菈笑著提議。",
        "gal_map_text_202101116=這次是‘與你・初遇’，下次調香就叫‘與你・同行’，讓標籤跟著我們的關係慢慢升級，記錄每一段時光。'",
        "gal_map_text_202101117=就印今天的日期吧，最直接也最有紀念意義。一看就知道是我們今天一起調的香水，圖案選個小小的日曆圖示，和許願卡的時間約定呼應，簡單又好記。'",
        "gal_map_text_202101118=阿米菈開心著選了卡通日曆圖案。",
        "gal_map_text_202101119=日期太有儀式感了！每次看到這個日期，就想起今天的快樂，從扭蛋到調香，每一個瞬間都值得紀念，我要把日期設成手機壁紙。'",
        "gal_map_text_202101120=阿米菈拉著你的手讓店員調整字體。",
        "gal_map_text_202101121=日期旁邊加個小香水圖示，再用柑橘色描邊，和我們的香水顏色呼應，以後看到日期就想起這份專屬氣味。'",
        "gal_map_text_202101122=阿米菈眼神專注。",
        "gal_map_text_202101123=簡單的日期最打動人。不用複雜的文字，一個日期就能錨定所有回憶，以後翻‘氣味檔案’時，看到日期就能立刻想起今天的場景。'",
        "gal_map_text_202101124=阿米菈輕聲補充。",
        "gal_map_text_202101125=和我們許願卡的日期保持一致，形成完整的時間線，以後不管過多久，都能通過日期找回今天的回憶。'",
        "gal_map_text_202101126=其實不用太複雜，選個好看的圖案就好。比如這個小小的香水瓶圖示，簡潔又貼合主題，不用額外加文字，純粹記錄我們一起調香的快樂，輕鬆又自在。'",
        "gal_map_text_202101127=阿米菈立刻選了簡約香水瓶圖案。",
        "gal_map_text_202101128=不用刻意加文字，看到圖案就想起今天的調香時光，這種純粹的陪伴感才最放鬆，符合我們的相處氛圍。'",
        "gal_map_text_202101129=阿米菈狡黠一笑。",
        "gal_map_text_202101130=簡約圖案反而更有想像空間，以後看到這個香水瓶，就想起我們一起吐槽‘蜂蜜太甜’的瞬間，默契都在細節裡。'",
        "gal_map_text_202101131=阿米菈撓了撓頭笑。",
        "gal_map_text_202101132=不用費腦子想文字，這個香水瓶圖案也好看，以後看到就知道是我們一起調的香水，輕鬆又好記。'",
        "gal_map_text_202101133=阿米菈認真對著螢幕確認。",
        "gal_map_text_202101134=不會因為文字太多顯得雜亂，日常用也不突兀，而且能長久保存，以後看到圖案就想起今天的陪伴。'",
        "gal_map_text_202101135=再加上我們名字的首字母縮寫，藏在波紋圖案裡，只有我們能發現，細節更專屬。",
        "gal_map_text_202101136=好！列印後和許願卡同框拍照，存進 '專屬回憶冊'，以後每次用香水，都能想起我們的氣味共鳴。",
        "gal_map_text_202101137=阿米菈開心的點了點頭。",
        "gal_map_text_202101138=背面印 '第一次合作調香・星夜海岸'，標注香水名，回憶更完整。",
        "gal_map_text_202101139=好！以後看到 '與你' 兩個字，就想起我們一起選精油、試比例的默契，太有意義了。",
        "gal_map_text_202101140=阿米菈臉頰微紅，耳朵也微紅了起來。",
        "gal_map_text_202101141=把日期印成藝術字，再加點小小的亮片特效，讓簡單的日期也有專屬感。",
        "gal_map_text_202101142=好！以後每次翻看回憶冊，看到日期就想起我們一起調香的細節，時間會流逝，但回憶不會。",
        "gal_map_text_202101143=阿米菈手裡抱著回憶相冊，露出了開心的表情。",
        "gal_map_text_202101144=選和我們香水顏色相近的淡橙色圖案，和瓶身更搭，看起來更和諧。",
        "gal_map_text_202101145=好！這樣既簡單又有紀念意義，以後用香水時，就想起我們一起度過的輕鬆時光，不用有任何壓力。",
        "gal_map_text_202101146=阿米菈手裡拿著香水，迫不及待的想噴",
        "gal_map_text_202101147=無論選擇哪個選項，你們都完成了專屬標籤的定制。阿米菈小心翼翼地貼好標籤，雙手捧著香水，和你一起噴灑在彼此手腕 —— 柑橘與雪松的清香纏繞，你的手指不經意覆在阿米菈的手背上，阿米菈臉頰泛紅，指尖微顫，卻沒有躲開。",
        "gal_map_text_202101148=出店鋪，晚風拂過，標籤上的圖案在路燈下隱約可見。阿米菈把香水和許願卡的同框照設成鎖屏，轉頭對你笑。",
        "gal_map_text_202101149=兩人的影子在路燈下緊緊依偎，曖昧氛圍濃到極致，告白只差一個順其自然的契機。",
        "gal_map_text_202101150=店鋪深處的 '回聲牆' 由原木搭建，鑲嵌著數十個銀色小喇叭，每個喇叭下方對應彩色按鈕和便簽區。",
        "gal_map_text_202101151=牆面標注：'按下接收陌生人的聲音祝福，錄製留存自己的時光留言'。",
        "gal_map_text_202101152=暖黃燈光照在喇叭上，反射出柔和光暈，偶爾傳來其他客人的笑聲、低語，氛圍溫馨又曖昧。",
        "gal_map_text_202101153=阿米菈指尖劃過按鈕邊緣，好奇按下粉色按鈕，女孩輕快的聲音傳出：'給三個月後的我！減肥成功就去吃超貴的蛋糕！'",
        "gal_map_text_202101154=阿米菈忍不住笑彎眼，又按藍色按鈕，男孩緊張的聲音響起：'希望阿米菈下周考試順利。' 笑容慢慢變得溫柔。",
        "gal_map_text_202101155=阿米菈轉頭看向你時眼底帶光：'我們也錄一段吧？就像之前的香水標籤、許願卡，讓聲音也成為我們的專屬回憶。'",
        "gal_map_text_202101156=好啊！可以錄和我們約定相關的內容，比如桂香赴約、市集相遇，以後聽到聲音就想起今天。",
        "gal_map_text_202101157=還要加只有我們懂的暗號！和香水標籤、許願卡呼應，讓回憶更連貫。",
        "gal_map_text_202101158=店員說可以加 ASMR 音效，不如選和我們香水相關的柑橘、雪松聲，更有專屬感。",
        "gal_map_text_202101159=太好啦！這樣聲音裡也有 '我們的味道'，以後不管多久，都是珍貴的時光膠囊。",
        "gal_map_text_202101160=阿米菈接過店員遞來的復古麥克風，指尖觸到冰涼金屬杆時微微一顫。暖光映在阿米菈泛紅的臉頰上，眼神在你和麥克風間來回切換。",
        "gal_map_text_202101161=阿米菈指尖不經意間碰了碰你的手背，又飛快收回，氛圍曖昧到極致。",
        "gal_map_text_202101162=錄製一個有溫度的錄音",
        "gal_map_text_202101163=錄製一個廣播劇紀念",
        "gal_map_text_202101164=錄製一個下次來還能一起聽的錄音",
        "gal_map_text_202101165=我們錄‘留言給每次聽到這段錄音時的我們’—— 一定要記住此刻的溫度：回聲牆的暖光、你笑彎的眼睛，還有和你一起錄廣播劇時的雀躍，這些都值得永遠銘記。'",
        "gal_map_text_202101166=阿米菈握緊麥克風，眼神認真。",
        "gal_map_text_202101167=溫度是抽象卻深刻的回憶錨點，結合廣播劇的雀躍，讓錄音既有情感又有細節，以後聽著就能精准想起今天的場景。'",
        "gal_map_text_202101168=阿米菈思考了一會，覺得可以在補充一些內容。",
        "gal_map_text_202101169=補充細節：開頭加 2 秒廣播劇裡的‘原始人歡呼’片段，結尾報上今天的日期，錄兩份 —— 一份存回聲牆，一份拷貝 U 盤，和之前的聲音明信片一起歸檔，形成完整回憶鏈。'",
        "gal_map_text_202101170=阿米菈眼眶微紅，聲音柔軟。",
        "gal_map_text_202101171=‘記住此刻的溫度’這句話，比任何華麗的話都動人，以後聽到就想起我們靠在回聲牆旁的樣子，還有廣播劇裡的傻氣與快樂。'",
        "gal_map_text_202101172=阿米菈抬頭眼底帶光",
        "gal_map_text_202101173=你說前半句，我說後半句，讓我們的聲音纏在一起，以後聽著就像同時重溫了回聲牆和原始人劇場，雙倍溫暖。'",
        "gal_map_text_202101174=我們錄‘感謝今天勇敢選擇原始人廣播劇的我們’—— 感謝那個敢放開搞怪、不怕笑場的彼此，也期待以後一起解鎖更多有趣的互動，讓快樂一直延續。'",
        "gal_map_text_202101175=阿米菈仔細調整麥克風。",
        "gal_map_text_202101176=我要帶著笑意錄，讓聲音裡都是當時的快樂，還要模仿廣播劇裡的暴躁語氣，呼應之前的劇情，超有畫面感！'",
        "gal_map_text_202101177=阿米菈拉著你的手湊近麥克風",
        "gal_map_text_202101178=錄到‘勇敢’兩個字時，我們一起拍一下手，像廣播劇裡的‘擊掌約定’，讓錄音藏著雙重互動回憶。'",
        "gal_map_text_202101179=阿米菈眼神專注，十分認真的進行錄音",
        "gal_map_text_202101180=既感謝當時的勇敢，也期待未來的互動，讓錄音既有紀念性又有延續性，留存最真實的默契。'",
        "gal_map_text_202101181=阿米菈思考一會，補充到。",
        "gal_map_text_202101182=補充細節！' 提議，'錄的時候加一點點店內的木質香氣音效（店員提供的環境音），讓聲音裡有今天的氣味記憶，和廣播劇的聲音形成多維回憶。'",
        "gal_map_text_202101183=我們錄‘希望下次來的時候，還能一起聽到這段錄音’—— 那時要帶著新的故事，再錄一段‘原始人廣播劇續篇’，讓回聲牆見證我們的每一次重逢與默契。'",
        "gal_map_text_202101184=阿米菈眼神專注了起來。",
        "gal_map_text_202101185=我懂你的心意！你是想讓這段錄音成為我們的‘重逢暗號’，下次來不僅要聽，還要續更廣播劇，讓快樂一直延續，對不對？'",
        "gal_map_text_202101186=阿米菈湊近麥克風，拉住你的手。",
        "gal_map_text_202101187=連續篇劇情都想到了！下次我們可以錄‘原始人找到甜甜果，一起分享’，呼應之前的劇情，讓錄音形成完整故事線，太有意義了。'",
        "gal_map_text_202101188=阿米菈臉頰微紅，撓了一下頭。",
        "gal_map_text_202101189=以後再來這裡，聽到這段錄音，就想起今天的約定，還要一起錄續篇，這種有期待的感覺真好。'",
        "gal_map_text_202101190=阿米菈認真對著麥克風",
        "gal_map_text_202101191=希望每次重逢都能帶著新故事，讓回聲牆和廣播劇一起，見證我們的默契與陪伴，簡單又珍貴。'",
        "gal_map_text_202101192=留言給每次聽到這段錄音時的我們：一定要記住此刻的溫度。'",
        "gal_map_text_202101193=回聲牆的暖光、笑彎的眼睛，還有廣播劇裡的雀躍，都值得永遠銘記。' 錄完立刻要 U 盤，'我要隨身帶，想你的時候就聽，每次都能想起兩份快樂。'",
        "gal_map_text_202101194=阿米菈臉頰泛紅，摸了摸微紅的耳朵。",
        "gal_map_text_202101195=感謝今天勇敢選擇原始人廣播劇的我們！'",
        "gal_map_text_202101196=敢放開搞怪、不怕笑場的彼此，未來還要解鎖更多有趣互動，快樂不停歇！' 錄完忍不住重播，'聽到就想起當時笑場的樣子，太懷念了。'",
        "gal_map_text_202101197=阿米菈馬上接上對話內容，帶著笑意。",
        "gal_map_text_202101198=希望下次來的時候，還能一起聽到這段錄音。'",
        "gal_map_text_202101199=帶著新故事，錄一段原始人廣播劇續篇，讓回聲牆見證每一次重逢。'",
        "gal_map_text_202101200=阿米菈立馬接上對話，眼神明亮。",
        "gal_map_text_202101201=無論選擇哪個選項，你們都完成了專屬聲音的錄製。阿米菈小心翼翼地接過 U 盤，緊緊攥在手心，和聲音明信片、之前的廣播劇錄音一起放進隨身的小挎包，仿佛珍藏著全世界最珍貴的寶藏。",
        "gal_map_text_202101202=阿米菈抬頭看向你時，眼底閃著細碎的光，嘴角掛著藏不住的笑意。",
        "gal_map_text_202101203=阿米菈主動挽住你的胳膊，指尖輕輕搭在你的手腕上，暖光映在阿米菈泛紅的臉頰上，曖昧的氣息在兩人之間悄悄蔓延，每一步都像踩在溫柔的棉花上，而這段串聯起廣播劇與回聲牆的聲音羈絆，讓臨近告白的氛圍愈發濃厚。",
        "gal_map_text_202101204=收銀台旁的刺繡小櫃檯鋪著淺灰色絨布，陳列著數十個不同顏色的絨布耳機套 —— 淡粉、淺藍、米白、深灰，質感柔軟親膚。",
        "gal_map_text_202101205=櫃檯後擺放著彩色繡線、小巧的刺繡 hoop 和成品樣品，樣品上繡著簡約字母、愛心、星星等圖案，旁邊標注 '可繡名字縮寫、日期、小符號，20 分鐘快速定制'。",
        "gal_map_text_202101206=暖光透過櫃檯玻璃照在耳機套上，泛著溫柔的光澤，店員正耐心地給其他客人講解繡線顏色選擇。",
        "gal_map_text_202101207=阿米菈指尖捏著淡粉色和淺藍色耳機套反復比對，指腹輕輕摩挲著絨布表面，睫毛隨著猶豫的動作輕輕顫動。",
        "gal_map_text_202101208=阿米菈把兩個耳機套舉到燈光下，對著光線看布料的細膩紋理，又低頭聞了聞，似乎在感受布料的氣味，臉頰泛著淺淺的紅暈。",
        "gal_map_text_202101209=看到你走近，阿米菈立刻把耳機套遞到你面前，指尖還殘留著布料的溫熱。",
        "gal_map_text_202101210=淺藍色確實和聲音明信片的底色呼應，淺粉色更襯你的氣質，不過選哪個都好 —— 重點是繡什麼內容，要和我們的錄音、約定呼應才更有專屬感。",
        "gal_map_text_202101211=對！可以繡之前的錄音暗號、約定關鍵字，或者簡單的同款圖案，就像隨身帶著的小羈絆。",
        "gal_map_text_202101212=還能繡小圖案！比如星星、耳機圖示，和前序的聲音回憶呼應，更有專屬感。",
        "gal_map_text_202101213=太好啦！那我們選一對同款不同色，還是同色不同繡圖？我覺得同款不同色更默契，就像我們的錄音，聲音相通但各有特色。",
        "gal_map_text_202101214=阿米菈指尖輕輕劃過淺藍色耳機套的邊緣，又把淡粉色的貼在臉頰旁比對，最終把淺藍色遞到你手裡，指尖不經意蹭過你的掌心，停留兩秒才輕輕收回。",
        "gal_map_text_202101215=阿米菈抬頭看向你時，眼底帶著明顯的期待，手指緊張地捏住淡粉色耳機套的邊角，絨布被捏出淺淺的褶皺，'繡什麼內容交給你決定？我相信你的眼光，只要是和你相關的，都很有意義。",
        "gal_map_text_202101216=繡一個同款情侶圖案",
        "gal_map_text_202101217=繡一個今天的日期",
        "gal_map_text_202101218=繡一個小星球圖案",
        "gal_map_text_202101219=不用繡",
        "gal_map_text_202101220=麻煩在兩個耳機套上繡同一個情侶圖案吧，就選簡約的‘耳機 + 音符’組合 —— 耳機呼應我們的錄音，音符對應聲音糖果屋的主題，淺粉色繡淺紫色圖案，淺藍色繡深藍色圖案，低調又有專屬感。'",
        "gal_map_text_202101221=阿米菈臉頰瞬間泛紅，指尖輕輕碰了碰櫃檯上的耳機套。",
        "gal_map_text_202101222=情侶圖案好甜呀！以後戴著它聽我們錄的聲音，就像你在身邊陪著我一樣，每次看到圖案都能想起今天的錄音和你的笑容，我要天天戴著，捨不得摘下來。'",
        "gal_map_text_202101223=阿米菈緊緊盯著店員開始勾勒圖案，眼神認真。",
        "gal_map_text_202101224=這對耳機套只能我們一起用，以後見面必須戴著，少一個都不行'",
        "gal_map_text_202101225=阿米菈平靜地看著店員選繡線。",
        "gal_map_text_202101226=不刻意張揚，卻能體現專屬感，這種有邊界的羈絆才更珍貴，符合我們的相處節奏。'",
        "gal_map_text_202101227=阿米菈笑著提議。",
        "gal_map_text_202101228=這次是‘耳機 + 音符’，下次見面就繡‘錄音筆 + 二維碼’，讓耳機套跟著我們的聲音羈絆一起升級，記錄每一段回憶。'",
        "gal_map_text_202101229=繡今天的日期吧，最有紀念意義 —— 一看就知道是‘聲音糖果屋紀念款’，淺粉色繡深粉色日期，淺藍色繡深藍色日期，再各加一個小小的錄音圖示，呼應我們今天的專屬錄音，以後看到日期，就想起錄音裡的笑聲和約定。'",
        "gal_map_text_202101230=阿米菈認真看著店員在耳機套上標記日期位置。",
        "gal_map_text_202101231=既明確了紀念意義，又和我們的錄音、聲音明信片形成回憶閉環，以後整理專屬回憶時，能精准對應到今天，邏輯很清晰。'",
        "gal_map_text_202101232=阿米菈拿出手機記下日期格式。",
        "gal_map_text_202101233=讓店員繡上完整的年月日，再在日期下方繡一個極小的二維碼縮寫，對應聲音明信片的二維碼，形成‘日期 + 聲音’的雙重紀念，以後看到就能快速聯想到錄音。'",
        "gal_map_text_202101234=阿米菈指尖輕輕撫摸著耳機套上標記的日期輪廓，眼眶微紅。",
        "gal_map_text_202101235=以後每次戴耳機，看到這個日期，就會想起今天和你一起錄聲音、選耳機套的溫柔時光，這種把日子刻在身邊的感覺，太珍貴了。'",
        "gal_map_text_202101236=阿米菈緊緊盯著店員刺繡的每一針，眼底帶光。",
        "gal_map_text_202101237=日期是我們羈絆的開始，錄音是我們的專屬回憶，兩者結合在一起，就像把今天的時光隨身帶著，每次看到都能想起你的笑容和我們的悄悄話。'",
        "gal_map_text_202101238=繡這個小星球圖案吧，挺可愛的 —— 和我們今天的‘聲音星球’主題很搭，也呼應之前可能接觸過的‘毛球行星’，淺粉色繡淡紫色星球，淺藍色繡淡藍色星球，再各繡一個小小的星星點綴，像我們錄音裡的小彩蛋。'",
        "gal_map_text_202101239=阿米菈蹦了一下，指尖興奮地戳了戳圖案冊。",
        "gal_map_text_202101240=和聲音糖果屋的氛圍超配，還能呼應主題，以後戴著它聽 ASMR，就像在‘聲音星球’裡探險一樣，太有畫面感了！'",
        "gal_map_text_202101241=阿米菈拉著你的手讓店員調整星球大小。",
        "gal_map_text_202101242=我的淺粉色星球繡在正面，你的淺藍色星球繡在側面，見面時讓兩個星球‘對暗號’，形成‘星球聯動’，太有意思了！'",
        "gal_map_text_202101243=阿米菈平靜地看著店員勾勒星球輪廓。",
        "gal_map_text_202101244=主題呼應自然不刻意，繡線顏色和耳機套搭配和諧，以後戴耳機時，看到星球就想起今天的錄音和陪伴，很治癒。'",
        "gal_map_text_202101245=阿米菈輕聲和店員溝通。",
        "gal_map_text_202101246=星球的大小要一致，星星的位置對稱，繡線選耐磨的材質，讓這個主題圖案能長久保存，和我們的聲音羈絆一樣，不會輕易褪色。'",
        "gal_map_text_202101247=其實不用繡了吧 —— 耳機套用久了會髒會換，繡了圖案反而不好清洗，而且我們的羈絆已經藏在錄音和聲音明信片裡了，這對耳機套只要是一起選的，就已經是專屬紀念了，簡單點也挺好。'",
        "gal_map_text_202101248=阿米菈指尖輕輕摩挲著耳機套表面，臉頰泛紅。",
        "gal_map_text_202101249=實用確實重要，而且我們的聲音回憶已經很珍貴了，耳機套只要是和你一起選的，戴的時候就會想起今天的快樂，不一定需要刺繡點綴。'",
        "gal_map_text_202101250=阿米菈笑著把耳機套疊放在一起。",
        "gal_map_text_202101251=你是覺得刺繡會破壞耳機套的質感，而且清洗麻煩，其實我也有點擔心繡線掉色，簡單點反而更長久，我們的羈絆不用靠刺繡證明，記在心裡就好。'",
        "gal_map_text_202101252=阿米菈撓了撓頭，笑容憨厚。",
        "gal_map_text_202101253=這樣耳機套髒了就能隨便洗，不用小心翼翼，而且這兩個顏色本來就很配，就算沒有刺繡，也知道是我們一起選的‘專屬款’。'",
        "gal_map_text_202101254=阿米菈語氣平淡，卻把兩個耳機套緊緊捏在手裡。",
        "gal_map_text_202101255=耳機套本來就是用來保護耳機的，不用太複雜，一起選的顏色已經很有紀念意義了，以後戴的時候，能想起今天的錄音就夠了。'",
        "gal_map_text_202101256=我們再讓店員在圖案旁邊繡個小小的愛心縮寫，你的繡我的名字首字母，我的繡你的，藏個只有我們知道的彩蛋。",
        "gal_map_text_202101257=好呀！這樣就算別人看到，也不知道這個小縮寫的意思，太專屬了！等繡好，我們立刻戴上聽一段今天的錄音，感受雙重羈絆。",
        "gal_map_text_202101258=阿米菈指尖輕輕戳了戳淺粉色耳機套。",
        "gal_map_text_202101259=我們把日期繡在耳機套內側，既不影響外觀，又能成為專屬小秘密，只有戴的時候才能看到。",
        "gal_map_text_202101260=好呀！這樣每次戴耳機，都像在重溫今天的快樂，以後每次見面，我們都戴著這對'日期紀念款'，讓時光錨點一直延續。",
        "gal_map_text_202101261=阿米菈指尖輕輕碰了碰你的手背",
        "gal_map_text_202101262=我們再讓店員在星球旁邊繡個極小的字母，你的繡‘S’（聲音），我的繡‘N’（羈絆），組成‘SN’暗號，只有我們懂。",
        "gal_map_text_202101263=好呀！這樣小星球不僅有主題意義，還有專屬暗號，以後看到就想起我們的約定，太完美了！",
        "gal_map_text_202101264=阿米菈眼睛亮起來。",
        "gal_map_text_202101265=那我們現在就戴上試試？雖然沒有刺繡，但這是我們一起選的，一樣是專屬羈絆。",
        "gal_map_text_202101266=好呀！這樣以後用耳機聽我們的錄音，就像把‘彼此的選擇’戴在身邊，簡單又安心，太有意義了。",
        "gal_map_text_202101267=阿米菈立刻把淺粉色耳機套戴在耳機上，又幫你戴上淺藍色的",
        "gal_map_text_202101268=阿米菈小心翼翼地拿起屬於自己的淺粉色耳機套，指尖反復撫摸著繡好的圖案，觸感細膩又安心，眼底滿是歡喜。",
        "gal_map_text_202101269=阿米菈把你的淺藍色耳機套遞到你手裡，又忍不住拿起自己的，和你的放在一起比對，指尖輕輕碰了碰你的手背，兩人同時頓住，暖光映得阿米菈臉頰泛紅，卻沒有收回手。",
        "gal_map_text_202101270=阿米菈主動挽住你的胳膊，把套著專屬耳機套的耳機放進隨身挎包，和聲音明信片、U 盤放在一起，仿佛珍藏著一整個世界的溫柔。走出聲音糖果屋時，晚風帶著店內的薄荷香和彼此的氣息，耳機套的柔軟觸感仿佛還停留在指尖。",
        "gal_map_text_202101271=走出「毛球行星」，夜晚的商業街依舊熱鬧，但喧囂似乎被一層柔軟的隔膜擋在了外面。你們手裡拿著各自（或共同）完成的手工作品，裝在小紙袋裡，還有那個也許刻了字的小木牌。",
        "gal_map_text_202101272=清涼的晚風吹散了身上殘留的羊毛暖意和淡淡膠水味。阿米菈沒有立刻匯入人流，而是在店門外那盞造型可愛的貓咪街燈下停住了腳步。",
        "gal_map_text_202101273=阿米菈低下頭，從紙袋裡小心地捧出那個羊毛氈小貓或者看著那塊流體畫板，就著燈光又仔細看了看，臉上露出一種混合著珍惜、成就感和一點點不舍的溫柔表情。",
        "gal_map_text_202101274=阿米菈指尖輕輕摩挲著作品的邊緣，無論是羊毛氈的針腳還是流體畫的色塊，都在暖黃的燈光下顯得格外柔軟。",
        "gal_map_text_202101275=過了幾秒，阿米菈抬頭看向你，眼底映著貓咪路燈的剪影，語氣帶著一絲不易察覺的羞澀'以前做手工都是一個人，做完就隨便放在抽屜裡，從來沒像現在這樣，覺得一件小東西能這麼珍貴。'",
        "gal_map_text_202101276=晚風輕輕吹起阿米菈的發梢，阿米菈下意識往你身邊挪了半步，肩膀幾乎貼上你的手臂。",
        "gal_map_text_202101277=我能理解這種感覺，和喜歡的人一起做喜歡的事，連小失誤都成了專屬回憶。你看這羊毛氈的耳朵，雖然歪了點，但正好和你笑起來時彎彎的眼睛很像，特別可愛。而且和你一起動手的過程，比成品本身更讓人難忘。'",
        "gal_map_text_202101278=阿米菈臉頰微紅，輕輕跺腳",
        "gal_map_text_202101279=哪有！明明是你剛才扶著我的手時沒穩住嘛。' 阿米菈頓了頓，語氣變軟，'不過…… 被你這麼一說，好像確實變得更特別了。如果以後能經常這樣，一起做手工、一起補救小意外，好像也不錯。'",
        "gal_map_text_202101280=是因為和你有關，才特別。不管是作品，還是和你相處的每一刻，我都想一直延續下去。'",
        "gal_map_text_202101281=貓咪路燈的光暈落在阿米菈臉上，把阿米菈的耳尖映得微紅。阿米菈眼神裡滿是期待，又帶著一絲忐忑，指尖因為緊張而輕輕攥著紙袋邊緣，連呼吸都放得輕柔了些。",
        "gal_map_text_202101282=懷裡的羊毛氈小貓（或流體畫板）隨著阿米菈的動作輕輕晃動，紙袋摩擦的細碎聲響在安靜的角落格外清晰。空氣裡殘留著淡淡的膠水味和晚風的清涼，每一秒的沉默都在放大彼此的心跳，此刻，所有的試探都已鋪墊到位，你只想把藏在心裡的真實感受，認真地告訴阿米菈。",
        "gal_map_text_202101283=輕輕接過阿米菈抱著的紙袋",
        "gal_map_text_202101284=指了指阿米菈懷裡紙袋裡的羊毛氈",
        "gal_map_text_202101285=約定下次可以去試試更有意思的項目",
        "gal_map_text_202101286=分享今天遊玩體驗",
        "gal_map_text_202101287=分享過程中的享受",
        "gal_map_text_202101288=隨緣找一個地方待著",
        "gal_map_text_202101289=這哪裡只是手工作品，這是我們共同創作未來的第一季啊。以後還會有第二季、第三季，不只是做手工，連一起挑羊毛、補救歪耳朵、吐槽顏料難調的瞬間，都會變成我們之間最平常的日常。我想一直和你這樣，把每一段相處都變成值得珍藏的‘劇集’，永遠不收官。",
        "gal_map_text_202101290=阿米菈指尖停頓在紙袋邊緣，眼神認真卻帶暖意。",
        "gal_map_text_202101291=我完全認同這種感受。從手工協作到心意契合，我們的相處一直是‘雙向奔赴’的過程，這種把特殊變成日常的期待，我同樣珍視，也渴望讓它落地。'",
        "gal_map_text_202101292=阿米菈眼神認真卻帶暖意。",
        "gal_map_text_202101293=你的表述精准概括了情感遞進邏輯 —— 從具象的手工互動到抽象的日常期待。這種基於共同體驗的長期規劃，具備很強的可行性，我願意和你一起推進。'",
        "gal_map_text_202101294=阿米菈眼眶微紅，聲音柔軟帶哽咽。",
        "gal_map_text_202101295=聽到你說要變成日常，我心裡一下子就滿了。其實我每次摸到這針腳（色塊），就想起和你相處的溫柔，這種想每天都見到你、一起做小事的心情，我藏了好久，終於可以說出來了。'",
        "gal_map_text_202101296=阿米菈眼底閃著淚光，指尖緊緊回握你的手。",
        "gal_map_text_202101297=原來我們的心意一直同步！從你扶著我的手戳羊毛開始，到現在路燈下的對視，每一刻我都在期待你說這句話，這種想和你共度日常的歸屬感，只有你能給我。'",
        "gal_map_text_202101298=以後如果覺得現實世界有點冷、有點硬，就摸摸它。它不只是個手工品，是我們一起搭建的、毛茸茸的備用世界 —— 在這裡，有你認真戳羊毛的樣子，有我們一起補救失誤的默契，還有不用設防的輕鬆和溫暖，隨時可以‘回去’躲一躲。而我，想一直做這個世界的守護者，也想做你現實裡的依靠。'",
        "gal_map_text_202101299=阿米菈嘴角帶笑，眼神溫和",
        "gal_map_text_202101300=手作確實是情感的具象化載體，這個‘備用世界’的隱喻很有意義。它承載了我們的安全感與默契，這種雙向的守護與依賴，能讓關係更穩固，我很珍視。'",
        "gal_map_text_202101301=阿米菈悄悄點頭，聲音軟軟的。",
        "gal_map_text_202101302=從情感需求來看，‘備用世界’滿足了彼此的安全感訴求，而現實裡的依靠則提供了長期關係的支撐。這種雙重保障的關係模式，具備可持續性，我認同並期待。'",
        "gal_map_text_202101303=阿米菈臉頰泛紅，聲音輕柔。",
        "gal_map_text_202101304=你這麼說，我突然覺得這作品變得好珍貴！以後我要把它放在床頭，每次覺得累了、委屈了，就摸摸它，想起你說的話，好像就有了勇氣。這種被你放在心上、為我搭建港灣的感覺真好。'",
        "gal_map_text_202101305=阿米菈眼睛亮起來，把紙袋緊緊抱在胸口。",
        "gal_map_text_202101306=這就是我們的‘秘密基地’啊！它見證了我們的默契和心動，我會永遠珍藏。有你做守護者，有這個備用世界，不管現實多難，我都不怕了，因為我知道你一直在。'",
        "gal_map_text_202101307=我們下次可以去試試更有意思的項目，雖然還沒有‘立項’，但只要是我們兩個人一起，就肯定能成功。",
        "gal_map_text_202101308=阿米菈指尖摩挲紙袋邊緣，語氣堅定。",
        "gal_map_text_202101309=我能感知到這份雙向奔赴的期待，從手工協作到未知探險，我們的相處節奏很合拍。這種基於共同興趣的長期規劃，具備很強的可行性，我願意和你一起探索。'",
        "gal_map_text_202101310=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101311=從關係發展曲線來看，共同探索未知能有效提升情感聯結。我們在手工項目中的默契度已得到驗證，延伸到其他領域的成功率很高，建議按興趣梯度推進探險計畫。'",
        "gal_map_text_202101312=阿米菈眼眶微紅，聲音柔軟。",
        "gal_map_text_202101313=原來你也想和我一起探險！我每次和你見面都很開心，也悄悄期待著我們能一起嘗試更多新鮮事。這種被你堅定選擇、想一起奔赴未來的感覺，真的太讓人珍惜了。'",
        "gal_map_text_202101314=阿米菈臉頰發燙，聲音帶著哽咽。",
        "gal_map_text_202101315=我也是！從第一次和你一起戳羊毛開始，我就忍不住心動，現在能和你一起規劃未來的探險，我真的太幸福了。不管是陶藝還是拼貼畫，只要和你一起，我都願意嘗試，因為有你在身邊，每一場探險都充滿安全感。'",
        "gal_map_text_202101316=嗯，這個體驗真不錯，又好玩又有紀念品。和你一起做手工很開心，沒有壓力，還能收穫這麼特別的作品，以後有機會可以再試其他項目，比如陶藝、蠟燭製作，或者其他有意思的DIY，繼續解鎖新體驗。'",
        "gal_map_text_202101317=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101318=輕鬆無壓力的相處模式確實讓人舒適，手工體驗的趣味性和紀念性都很好。基於這次的良好互動，我願意繼續保持聯繫，嘗試更多新的DIY專案。'",
        "gal_map_text_202101319=阿米菈抬手輕輕拍了拍你的肩膀。",
        "gal_map_text_202101320=從體驗回饋來看，本次手工互動的滿意度較高。DIY類項目具備重複參與價值，可作為後續約會的核心方向，持續提升相處舒適度。'",
        "gal_map_text_202101321=阿米菈耳尖泛紅，聲音輕柔。",
        "gal_map_text_202101322=謝謝你，能和你一起完成手工、收穫紀念品真的很開心。這種輕鬆愉快的氛圍，我很珍惜，以後想嘗試更多類似的項目，創造更多開心的回憶。'",
        "gal_map_text_202101323=阿米菈臉頰微紅，眼神帶著歡喜。",
        "gal_map_text_202101324=我也是！和你一起做手工的每一刻都很快樂，這個紀念品我會好好收藏，以後每次看到它，就想起今天的美好體驗。以後我們一定要多解鎖新DIY，創造更多快樂時光！'",
        "gal_map_text_202101325=做手工還挺累人的，不過挺開心。尤其是和你一起琢磨怎麼補救歪耳朵、怎麼調顏色的過程，比最後拿到成品還有意思。以後不用特意找複雜的手工項目，哪怕只是找個安靜的地方一起做點簡單的小東西，或者單純聊聊天、吃點東西，這種簡單的陪伴也挺好。'",
        "gal_map_text_202101326=阿米菈點頭回應，語氣平和。",
        "gal_map_text_202101327=手工過程的互動價值確實高於成品本身，簡單的陪伴模式也符合輕鬆相處的期待。不刻意追求複雜項目，讓關係自然發展，是比較健康的方式。'",
        "gal_map_text_202101328=阿米菈臉頰微紅，眼神帶著歡喜。",
        "gal_map_text_202101329=從精力消耗和情感收益來看，簡單陪伴的投入產出比更高。後續可優先選擇低難度互動項目，保持相處的舒適度和可持續性。'",
        "gal_map_text_202101330=阿米菈臉頰微紅，聲音輕柔。",
        "gal_map_text_202101331=我也覺得過程比結果更重要！和你一起琢磨手工的時光，輕鬆又自在，這種不用刻意找話題、不用追求完美的陪伴，真的很舒服，我很珍惜。'",
        "gal_map_text_202101332=阿米菈眼睛亮起來，語氣雀躍。",
        "gal_map_text_202101333=對呀對呀！我從來沒覺得做手工累，因為和你一起互動太開心了。以後我們就選簡單的項目，或者乾脆不做手工，只是一起散散步、吃點好吃的，只要能和你在一起，做什麼都好！'",
        "gal_map_text_202101334=這邊人又開始多了，我們別堵在店門口，邊走邊說吧。今晚做手工的體驗確實不錯，和你相處也很舒服，以後有空可以常約，不用特意提前規劃，隨緣找個有意思的地方待著就好，順其自然就挺開心的。'",
        "gal_map_text_202101335=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101336=當下的相處體驗確實值得肯定，順其自然的模式也符合我的期待。不刻意、不勉強，在輕鬆的氛圍中慢慢瞭解彼此，是比較健康的關係發展方式。'",
        "gal_map_text_202101337=阿米菈手指托著下巴，思考片刻後語氣和平。",
        "gal_map_text_202101338=從社交場景來看，人少的環境更利於深入溝通。順其自然的相處模式雖短期體驗良好，但長期延續性需進一步觀察，建議保持開放心態，靈活調整約會節奏。'",
        "gal_map_text_202101339=阿米菈耳尖泛紅，聲音輕柔。",
        "gal_map_text_202101340=我也覺得今晚很開心，和你一起做手工、聊天都很放鬆。順其自然挺好的，不用有壓力，以後想見面了我們就約，慢慢探索更多有意思的地方，創造更多輕鬆的回憶。'",
        "gal_map_text_202101341=阿米菈臉頰微紅，眼神溫柔。",
        "gal_map_text_202101342=對呀，今天真的太快樂了！我喜歡這種沒有壓力的相處，不用想太多，只要和你一起享受當下的美好就好，每一次見面都是驚喜，這樣就很滿足了。'",
        "gal_map_text_202101343=以後，我們可以把‘共同創作’變成習慣，週末一起探索新手工，下班順路一起挑材料，不用再小心翼翼試探了，好不好？'",
        "gal_map_text_202101344=阿米菈悄悄點頭，主動挽住你的胳膊，把紙袋往你懷裡又送了送。",
        "gal_map_text_202101345=好…… 以後不管做什麼，我都想和你一起，讓每段日常都有彼此的痕跡，把每一季都過得有意義。'",
        "gal_map_text_202101346=我們交換作品吧，以後看到對方做的東西，就像擁有了‘備用世界’的鑰匙，不管相隔多遠，都能感受到彼此的溫暖，也知道有人在做你最堅實的後盾。'",
        "gal_map_text_202101347=阿米菈立刻接過，小心地抱在懷裡。",
        "gal_map_text_202101348=好呀！我會好好保管，下次見面我們再一起做一對新的，把我們的‘備用世界’搭建得更完整，讓裡面裝滿更多開心的回憶。'",
        "gal_map_text_202101349=我們現在就建一個‘探險清單’，把想做的事都寫下來，一個個去實現，每完成一個就做個小手工紀念，怎麼樣？'",
        "gal_map_text_202101350=阿米菈立刻點頭，主動湊近你看手機，嘴角彎起甜甜的弧度。",
        "gal_map_text_202101351=好呀！我要把‘雙人油畫’放在第一個，還要加上‘撿樹葉拼貼畫’，以後每次完成探險，都能留下專屬紀念，太有意義了。'",
        "gal_map_text_202101352=那以後有空就約出來吧，我看到有家陶藝館評價不錯，下次我們去試試？'",
        "gal_map_text_202101353=阿米菈微微點了點頭，腳步輕快地跟上你。",
        "gal_map_text_202101354=好呀！我早就想試試陶藝了，和你一起肯定更開心，說不定能做出比現在更特別的紀念品。'",
        "gal_map_text_202101355=那下次我們去一家手工咖啡館吧，裡面有簡單的塗色畫，做完還能喝杯咖啡，輕鬆又愜意。'",
        "gal_map_text_202101356=阿米菈開心的點了點，主動挽住你的胳膊。",
        "gal_map_text_202101357=好呀！我喜歡這種輕鬆的氛圍，和你一起肯定能度過一段愉快的時光。'",
        "gal_map_text_202101358=那我們現在去河邊散散步吧，吹吹晚風，再聊會兒天，那邊人少也安靜。'",
        "gal_map_text_202101359=阿米菈點頭回應，語氣輕快。",
        "gal_map_text_202101360=好呀！晚風這麼舒服，和你一起散步、聊聊手工或者其他有意思的事，肯定很愜意。'",
        "gal_map_text_202101361=阿米菈挽著你的胳膊，兩人並肩走在商業街的暖光裡，手裡的紙袋隨著腳步輕輕晃動，羊毛氈（或流體畫）碰撞的細碎聲響成了此刻最溫柔的背景音。",
        "gal_map_text_202101362=路過一家還在營業的糖水鋪，你們坐在靠窗的位置分享著一碗甜而不膩的雙皮奶，偶爾抬頭對視，都會被對方眼底的笑意感染，悄悄紅了臉頰。阿米菈把交換後的手作小心翼翼地放在桌面，指尖時不時輕輕觸碰，像是在確認這份心意的真實性。",
        "gal_map_text_202101363=離開時，你們緊緊攥著彼此的作品，指尖相觸的瞬間，默契的氛圍悄然定格，這份無需誓約的心意，早已在街燈下的告白中確認，而手作承載的羈絆，也讓這份關係多了幾分珍貴的質感，預示著未來的日常裡，會有更多雙向奔赴的溫暖。",
        "gal_map_text_202101364=走出「香氣遊樂園」，夜晚的商業街依舊喧鬧，但你們之間似乎多了一層無形的、私密的氣味屏障 —— 那是你們共同創造的香水，淡淡地縈繞在彼此身上，像一個只有你們能感知的、溫暖的信號。",
        "gal_map_text_202101365=阿米菈沒有立刻往地鐵站方向走，而是在店門外那盞復古路燈下停下了腳步。",
        "gal_map_text_202101366=阿米菈低下頭，從紙袋裡拿出那瓶貼著定制標籤的小香水，對著燈光看了看，標籤上的字在光下微微反光。然後，阿米菈小心地擰開瓶蓋，沒有噴，只是用手輕輕在瓶口扇了扇，讓一絲若有若無的香氣飄散出來。",
        "gal_map_text_202101367=復古路燈的暖光落在磨砂香水瓶上，折射出柔和的光暈。阿米菈指尖捏著瓶身，感受著殘留的體溫，指腹無意識地摩挲著定制標籤上的文字，抬頭看向你時，眼底帶著一絲羞澀的期待。",
        "gal_map_text_202101368=阿米菈輕輕扇動著空氣，讓香氣彌漫在兩人之間。一開始是清新的柑橘調，像第一次見面時的輕鬆愉快；後面慢慢透出木質香，又像和你待在一起時的踏實安心。",
        "gal_map_text_202101369=晚風帶著香氣掠過，阿米菈下意識往你身邊靠近了些，肩膀幾乎貼上你的胳膊，聲音放得更柔。",
        "gal_map_text_202101370=確實很特別，這種香味很有辨識度，和你給人的感覺一樣，清新又讓人安心。你偷偷加了我喜歡的木質香，我早就發現了 —— 畢竟第一次調香時，我就說過偏愛沉穩的後調，你居然記得這麼清楚。'",
        "gal_map_text_202101371=阿米菈臉頰泛紅，指尖下意識收緊握住香水瓶，眼神躲閃了一下。",
        "gal_map_text_202101372=居然被你發現了…… 我還以為做得很隱蔽呢。那你喜歡這個最終的味道嗎？它可是我們一起‘創作’的專屬氣味，藏著我好多小心思。'",
        "gal_map_text_202101373=當然喜歡，不只是因為香味本身，更因為它承載了和你一起調香的所有回憶 —— 你糾結選橙花還是檸檬時的蹙眉，試香時不小心碰手後迅速收回的羞澀，每一次呼吸都能想起你的認真。'",
        "gal_map_text_202101374=空氣中的香氣越來越濃郁，混合著復古路燈的暖光，把氛圍襯得格外繾綣。阿米菈的耳尖在燈光下泛著淡淡的粉，指尖因為緊張而輕輕攥著香水瓶，瓶身的磨砂質感被捏得微微發熱。",
        "gal_map_text_202101375=阿米菈低頭看了看瓶身上的定制標籤，又抬眼看向你，眼神裡滿是對這份 '專屬氣味' 的珍視，也藏著對你回應的忐忑期待 —— 阿米菈在等你讀懂這香味背後，那些沒說出口的心意。",
        "gal_map_text_202101376=專屬調香師",
        "gal_map_text_202101377=雙向奔赴",
        "gal_map_text_202101378=長期研香",
        "gal_map_text_202101379=體驗認可",
        "gal_map_text_202101380=專注疲憊",
        "gal_map_text_202101381=避人移步",
        "gal_map_text_202101382=這味道融合了我們兩個人的記憶 —— 你的清新靈動，我的沉穩踏實，就像我們的相處一樣。它會隨著時間慢慢沉澱，以後也會繼續延續下去，你願意當我永久的香味調理師嗎？以後每一個日子，都幫我把生活調得像現在這樣，滿是專屬我們的溫柔氣息。'",
        "gal_map_text_202101383=阿米菈指尖停頓在瓶身標籤，眼神認真卻帶暖意。",
        "gal_map_text_202101384=我完全認同這份羈絆！氣味是記憶的錨點，而我們的相處是雙向的‘調和’。當你的專屬調香師，把日子過成專屬香味，這個約定既浪漫又有意義，我願意認真履行。'",
        "gal_map_text_202101385=阿米菈眼神認真卻帶暖意，牽著你的手。",
        "gal_map_text_202101386=我完全認同這份羈絆！氣味是記憶的錨點，而我們的相處是雙向的‘調和’。當你的專屬調香師，把日子過成專屬香味，這個約定既浪漫又有意義，我願意認真履行。'",
        "gal_map_text_202101387=阿米菈眼眶微紅，聲音柔軟帶哽咽",
        "gal_map_text_202101388=聽到你這麼說，我心裡一下子就滿了！原來你懂我藏在香水裡的心意，願意讓我一直為你‘調香’。以後不管是香水還是生活，我都會把最溫柔的部分留給你，這個約定我一輩子都認。'",
        "gal_map_text_202101389=阿米菈眼底閃著淚光，指尖緊緊回握你的手",
        "gal_map_text_202101390=原來我們的心意一直同步！從調香時的默契，到現在的約定，每一刻都像這香水一樣甜。我願意當你的專屬調香師，一輩子為你調和生活的美好，讓我們的氣味羈絆永遠不消散。'",
        "gal_map_text_202101391=這個香味的有效期有限，但我們之間的羈絆是無限的 —— 它藏在調香時的默契裡，藏在碰手時的心動裡，藏在你偷偷遷就我的溫柔裡。這份羈絆能延續多久，就看你願意和我雙向奔赴多久，你願意陪我把每一個平凡日子，都染上專屬我們的氣味嗎？'",
        "gal_map_text_202101392=阿米菈嘴角帶笑，眼神溫和。",
        "gal_map_text_202101393=羈絆的無限性，恰恰在於雙向的奔赴與維護。香水會揮發，但我們的默契和心意不會。我願意和你一起，把日子染上專屬氣味，讓這份雙向奔赴的關係，成為彼此最堅實的依靠。'",
        "gal_map_text_202101394=阿米菈的臉頰瞬間泛起紅暈，卻依然嘴硬。",
        "gal_map_text_202101395=從關係發展邏輯來看，‘氣味羈絆’是情感的具象化表達，而雙向奔赴是長期關係的核心。我認可這份約定，會以實際行動維護我們的羈絆，讓它在日常相處中不斷深化。'",
        "gal_map_text_202101396=阿米菈臉頰泛紅，聲音輕柔。",
        "gal_map_text_202101397=你這麼說，我突然覺得這瓶香水變得更珍貴了！原來羈絆可以這麼浪漫，我願意陪你雙向奔赴，把每一個日子都過得有香味、有溫度，讓我們的故事永遠未完待續。'",
        "gal_map_text_202101398=阿米菈眼睛亮起來，把香水瓶貼在胸口。",
        "gal_map_text_202101399=這就是我們的‘羈絆香水’啊！它見證了我們的心動和默契，我願意陪你一直走下去，不管是一年、十年，還是更久，都要讓專屬我們的氣味，縈繞在彼此身邊。'",
        "gal_map_text_202101400=嗯，這個味道確實不錯，清新又沉穩，完全是我們的風格。為了能夠長期擁有這種專屬氣味，甚至解鎖更多屬於我們的香味，我們是不是應該早點計畫下一次的研發？比如，把季節、心情都融入香水，慢慢攢成我們的‘愛情香氛合集’，讓每一款都藏著一段回憶。'",
        "gal_map_text_202101401=阿米菈指尖摩挲瓶身，眼神堅定。",
        "gal_map_text_202101402=這個計畫邏輯清晰！將季節、心情與香水綁定，既能形成專屬回憶體系，又能讓每一次研發都有明確目標。我願意和你一起推進，把‘愛情香氛合集’越攢越豐富。'",
        "gal_map_text_202101403=阿米菈摸了摸香水瓶子，眼神認真。",
        "gal_map_text_202101404=從長期規劃來看，‘香氛合集’是情感的系統化留存。建議我們建立共用文件，記錄每款香水的配方、研發時間和背後的故事，讓回憶既有溫度又有邏輯，便於長期追溯。'",
        "gal_map_text_202101405=阿米菈眼眶微紅，聲音柔軟。",
        "gal_map_text_202101406=原來你早就想好了未來的計畫！我太期待了，以後春天調花香、夏天調果香、秋天調木質香，每一款都藏著我們的回憶。和你一起慢慢研發，慢慢攢合集，這種細水長流的感覺，真的太美好了。",
        "gal_map_text_202101407=阿米菈臉頰發燙，聲音帶著哽咽。",
        "gal_map_text_202101408=我也是！從調完這瓶香水開始，我就想和你一起做更多研發。每一款香水都是一段回憶，每一次合作都是一次心動，這個‘愛情香氛合集’，會成為我們最珍貴的寶藏，我要和你一起把它填滿。'",
        "gal_map_text_202101409=這次體驗真有意思，自己調的香水就是有感情 —— 每一滴精油都藏著我們的討論，每一次試香都有新的發現。和你一起做事，不管是調香還是其他，都覺得很合拍，以後可以多嘗試這種有意義的體驗。'",
        "gal_map_text_202101410=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101411=確實是一次很有價值的體驗！自主調香不僅能獲得專屬香水，更能加深彼此的瞭解。基於這次的良好互動，我願意繼續探索更多類似的體驗，豐富我們的相處模式。'",
        "gal_map_text_202101412=阿米菈眼神堅定。語氣平和。",
        "gal_map_text_202101413=從體驗回饋來看，本次調香互動的滿意度較高，且具備重複參與價值。後續可將‘DIY 體驗’作為核心約會方向，持續提升相處的新鮮感和默契度。'",
        "gal_map_text_202101414=阿米菈耳尖泛紅，聲音輕柔。",
        "gal_map_text_202101415=謝謝你的認可，我也覺得這次體驗很有意義。自己調的香水，聞起來都比買的更有溫度，以後和你一起嘗試更多有意思的事，肯定會有更多美好回憶。'",
        "gal_map_text_202101416=阿米菈臉頰微紅，眼神帶著歡喜。",
        "gal_map_text_202101417=我也是！和你一起調香的每一刻都很快樂，這種有參與感、有感情的體驗，比任何禮物都珍貴。以後我們一定要多約著做類似的事，創造更多專屬回憶！'",
        "gal_map_text_202101418=調香還挺需要專注的，盯著精油比例、反複試香，確實有點累了。不過很開心，能和你一起完成一瓶專屬香水，這種成就感很難得。時間不早了，我們該往回走了吧，順便在路上再聊聊剛才調香時的小插曲。'",
        "gal_map_text_202101419=阿米菈點頭回應，語氣平和。",
        "gal_map_text_202101420=專注做一件事確實容易疲憊，但成果和體驗都很值得。現在往回走剛好，路上可以複盤一下調香的過程，也能規劃下次的見面，高效又輕鬆。'",
        "gal_map_text_202101421=阿米菈同意點頭回應，語氣溫柔。",
        "gal_map_text_202101422=從精力分配來看，長時間專注後適當休息是合理選擇。往回走的途中複盤互動細節，既能加深回憶，又能自然銜接下次約會，符合高效相處的邏輯。'",
        "gal_map_text_202101423=阿米菈臉頰泛紅，聲音輕柔。",
        "gal_map_text_202101424=我也覺得有點累，但真的很開心！和你一起專注做一件事的感覺很踏實，路上我們可以多聊聊剛才試香時的趣事，再想想下次見面要做什麼。'",
        "gal_map_text_202101425=阿米菈眼睛亮起來，語氣雀躍。",
        "gal_map_text_202101426=對呀，雖然累但成就感滿滿！和你一起調香的每一個小插曲都很有意思，路上我們慢慢聊，順便看看夜景，這種輕鬆收尾的感覺真好。'",
        "gal_map_text_202101427=這邊人有點多，我們去外面的小路吧，又安靜又涼快。今晚調香挺開心的，路上再聊聊你平時喜歡的香型，下次見面可以針對性地選配方，更合你的心意。'",
        "gal_map_text_202101428=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101429=往人少的地方走確實更適合聊天。提前瞭解彼此喜歡的香型，能讓下次的調香體驗更契合預期，這種自然延續的相處模式很舒服。'",
        "gal_map_text_202101430=阿米菈你一眼，是伸手想碰你的胳膊。",
        "gal_map_text_202101431=從社交場景選擇來看，安靜的環境更利於深度溝通。提前溝通香型偏好，可提升下次互動的匹配度，避免盲目嘗試，符合高效相處的原則。'",
        "gal_map_text_202101432=阿米菈耳尖泛紅，聲音輕柔。",
        "gal_map_text_202101433=好呀，人少的地方確實更清淨，能好好聊天。我平時喜歡清新一點的花香，下次我們可以多試試這類配方，和你一起調香，不管什麼味道都很開心。'",
        "gal_map_text_202101434=阿米菈臉頰微紅，眼神溫柔。",
        "gal_map_text_202101435=對呀，這邊人太多有點吵，小路肯定更舒服。能和你聊聊喜歡的香型，提前為下次見面做準備，這種有期待的感覺真好，我已經開始盼著下次調香了。'",
        "gal_map_text_202101436=以後，我們可以一起做更多喜歡的事，把每一次的心動都記下來，不用再小心翼翼試探了，好不好？'",
        "gal_map_text_202101437=阿米菈悄悄點頭，聲音軟軟的。",
        "gal_map_text_202101438=好…… 以後不管做什麼，我都想和你一起，讓每段時光都有彼此的痕跡。'",
        "gal_map_text_202101439=我們交換作品吧，以後看到對方做的東西，就像看到彼此一樣，讓這份羈絆一直都在。'",
        "gal_map_text_202101440=阿米菈立刻接過，小心地抱在懷裡",
        "gal_map_text_202101441=好呀！我會好好保管，下次見面我們再一起做一對新的，讓羈絆越來越深。'",
        "gal_map_text_202101442=我們拍一張合照吧，和作品一起，把今天的美好時光定格下來，以後想對方了就拿出來看看。'",
        "gal_map_text_202101443=阿米菈立刻點頭，主動湊近你。",
        "gal_map_text_202101444=好呀！要把貓咪路燈也拍進去，它是我們心動的見證者。'",
        "gal_map_text_202101445=那以後有空就約出來見面吧，不管是做手工還是吃美食，都可以。'",
        "gal_map_text_202101446=阿米菈開心的點了點頭。",
        "gal_map_text_202101447=好呀！我隨時都有空，只要能和你一起，做什麼都好。'",
        "gal_map_text_202101448=那下次我們去試試陶藝？聽說和手工很像，應該會很有意思。'",
        "gal_map_text_202101449=阿米菈幸福的點了點頭，腳步輕快地跟上你。",
        "gal_map_text_202101450=好呀！我早就想試試了，和你一起肯定更開心。'",
        "gal_map_text_202101451=那我們現在去河邊散散步吧，吹吹晚風，再聊會兒天？'",
        "gal_map_text_202101452=阿米菈點頭回應，語氣輕快，側身做出 '請' 的手勢。",
        "gal_map_text_202101453=好呀！晚風這麼舒服，和你一起散步肯定很愜意。'",
        "gal_map_text_202101454=阿米菈挽著你的胳膊，兩人並肩走在商業街的暖光裡，手裡的手作隨著腳步輕輕晃動，紙袋摩擦的細碎聲響成了此刻最溫柔的背景音。",
        "gal_map_text_202101455=路過一家還在營業的糖水鋪，你們坐在靠窗的位置分享著一碗甜而不膩的雙皮奶，偶爾抬頭對視，都會被對方眼底的笑意感染，悄悄紅了臉頰。",
        "gal_map_text_202101456=離開時，你們交換了手作，指尖相觸的瞬間，曖昧的氛圍悄然定格，這份無需誓約的心意，早已在街燈下的告白中確認，而手作承載的羈絆，也讓這份關係多了幾分珍貴的質感。",
        "gal_map_text_202101457=走出「聲音糖果屋」，夜晚的商業街換上了更深沉的霓虹。喧囂依舊，但你們耳朵裡似乎還殘留著剛才錄音隔間的特殊靜謐，或是彼此笑聲的餘韻。",
        "gal_map_text_202101458=阿米菈小心地把那張聲音明信片和可能新得的刺繡耳機套收進包裡，然後在那盞畫著音符圖案的街燈下停住了腳步。",
        "gal_map_text_202101459=阿米菈沒有立刻說話，而是從包裡拿出那張聲音明信片，對著燈光又看了一眼上面的二維碼，仿佛在確認那個通往一小段過去的 '入口' 真的存在。",
        "gal_map_text_202101460=音符路燈的霓虹落在明信片上，二維碼的紋路清晰可見。阿米菈指尖輕輕拂過卡片邊緣，感受著紙質的細膩，抬頭看向你時，眼底閃著細碎的光。",
        "gal_map_text_202101461=阿米菈把明信片輕輕按在胸口，明信片上的二維碼好像一個時光膠囊，只要掃一下，就能回到剛才和你一起說笑的瞬間，這種能留住聲音的感覺，真的很奇妙。",
        "gal_map_text_202101462=晚風輕輕吹過，阿米菈往你身邊靠近了些，肩膀幾乎貼上你的胳膊，聲音放得更柔。",
        "gal_map_text_202101463=沒想到被你發現了，我還以為模仿得很誇張，會讓你覺得幼稚呢。其實我剛才也偷偷錄了一段你的笑聲，那種清脆又甜軟的感覺，想回去之後慢慢聽 —— 畢竟第一次見面時，我就覺得你的笑聲比任何音樂都好聽，像治癒的旋律。'",
        "gal_map_text_202101464=阿米菈臉頰微紅，輕輕跺腳。",
        "gal_map_text_202101465=你居然偷偷錄我的笑聲！' 阿米菈頓了頓，語氣帶著期待，'那…… 你覺得我的笑聲真的很好聽嗎？這可是我們一起錄的‘專屬單曲’，意義不一樣呢。'",
        "gal_map_text_202101466=當然好聽，不只是笑聲，和你有關的每一個聲音都讓我心動 —— 你破音後的羞澀、模仿小動物的可愛、輕聲和我討論臺詞的溫柔，這張聲音明信片，是比任何紀念品都珍貴的‘限量專輯’。'",
        "gal_map_text_202101467=音符路燈的霓虹在阿米菈臉上輕輕晃動，把阿米菈的耳尖映得微紅。阿米菈指尖緊緊攥著聲音明信片，二維碼的邊緣被捏得微微發皺，指腹因為緊張而泛著溫熱。",
        "gal_map_text_202101468=阿米菈下意識地往你身邊又挪了挪，身體輕輕靠在你的胳膊上，帶著一絲不易察覺的依賴，呼吸的溫熱拂過你的手腕。眼神裡滿是對這份 '專屬聲音' 的珍視，也藏著對你回應的忐忑期待 —— 阿米菈在等你讀懂這聲音背後，那些沒說出口的溫柔心意。此刻，周圍的喧囂仿佛都褪去了，只剩下彼此的呼吸聲與晚風的輕響，你只想把這份被聲音包裹的情感，認真地傳遞給阿米菈。",
        "gal_map_text_202101469=明信片巡迴演唱會",
        "gal_map_text_202101470=明信片專屬專輯",
        "gal_map_text_202101471=聲音檔案館",
        "gal_map_text_202101472=嘗試新奇體驗",
        "gal_map_text_202101473=分享今天錄音體驗",
        "gal_map_text_202101474=邀請阿米菈下次再來",
        "gal_map_text_202101475=一張成功的唱片之後，本來就該有巡迴演唱會啊。這張明信片只是我們的第一站，後面還會有第二站、第三站 —— 我們可以一起錄雙人配音、ASMR 睡前故事、甚至是日常的碎碎念，把每一次見面都變成一場專屬演唱會，讓我們的聲音羈絆，在更多時光裡迴圈播放。'",
        "gal_map_text_202101476=阿米菈指尖停頓在明信片邊緣，眼神認真卻帶暖意。",
        "gal_map_text_202101477=這個比喻很貼切！從‘單曲’到‘巡迴演唱會’，情感遞進邏輯清晰。這種基於共同興趣的長期規劃，既保留了專屬感，又具備可持續性，我很認同，也期待每一場‘演唱會’的開啟。'",
        "gal_map_text_202101478=阿米菈眼神認真，快速回答道。",
        "gal_map_text_202101479=你的表述精准概括了關係深化路徑 —— 從單次錄音（單曲）到長期多場景互動（巡迴演唱會）。建議建立‘聲音合集’共用資料夾，按時間線歸檔每一段錄音，形成完整的情感聲音體系。'",
        "gal_map_text_202101480=阿米菈眼眶微紅，聲音柔軟帶哽咽。",
        "gal_map_text_202101481=聽到你說‘巡迴演唱會’，我心裡一下子就滿了！原來你早就想和我延續這份羈絆，我也想把每一次見面都變成專屬回憶，讓我們的聲音，在時光裡一直陪伴彼此。'",
        "gal_map_text_202101482=阿米菈眼底閃著淚光，指尖緊緊攥住你的手。",
        "gal_map_text_202101483=原來我們的心意一直同步！從錄音時的默契，到現在的‘演唱會約定’，每一刻都像在做夢。我想和你一起，把所有日常都變成可聆聽的旋律，永遠單曲迴圈下去。'",
        "gal_map_text_202101484=一張‘單曲’怎麼夠？我更期待下一次，和你一起錄更長、更日常、更不用刻意想話題的‘專屬專輯’ —— 沒有固定腳本，沒有時間限制，就錄我們的日常碎碎念、一起做飯的聲響、散步時的晚風，把最真實的彼此，都藏進旋律裡，讓這份聲音羈絆，滲透到生活的每一個角落。'",
        "gal_map_text_202101485=阿米菈嘴角帶笑，眼神溫和。",
        "gal_map_text_202101486=日常化的錄音設定很有意義。聲音是情感的鮮活載體，把日常融入‘專輯’，能讓羈絆更具煙火氣，也讓關係在自然的互動中慢慢深化，我很期待這份‘生活化專輯’。'",
        "gal_map_text_202101487=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101488=從情感維繫角度來看，日常錄音能有效提升關係的親密度。建議確定‘專輯主題’，比如‘三餐四季’‘城市漫步’，按主題歸檔錄音，讓回憶更有條理。'",
        "gal_map_text_202101489=阿米菈臉頰泛紅，聲音輕柔。",
        "gal_map_text_202101490=你這麼說，我突然覺得生活都變得浪漫起來！原來最珍貴的聲音，不是刻意設計的臺詞，而是日常的瑣碎與陪伴。我想和你一起，把每一個平凡的瞬間，都變成專屬我們的‘限定曲目’。'",
        "gal_map_text_202101491=阿米菈眼睛亮起來，把明信片貼在胸口。",
        "gal_map_text_202101492=這就是我們的‘愛情專輯’啊！以後不管過多久，只要聽到這些日常的聲音，就會想起和你一起的點點滴滴，這種滲透在生活裡的羈絆，才最長久、最動人。'",
        "gal_map_text_202101493=所以，我單方面宣佈，這裡會成為我們長期的據點 —— 只要有時間，就一定會來光顧。以後我們可以在這裡錄下每個階段的聲音：開心時的笑聲、疲憊時的吐槽、節日的祝福，讓‘聲音糖果屋’，成為我們愛情裡的‘聲音檔案館’，見證我們每一段成長與陪伴。",
        "gal_map_text_202101494=阿米菈指尖摩挲明信片邊緣，語氣堅定。",
        "gal_map_text_202101495=將特定地點作為‘據點’，能為關係提供穩定的情感錨點。這種基於固定場景的長期約定，既保留了專屬感，又能讓回憶更有連貫性，我很認同，也願意和你一起守護這個‘檔案館’。'",
        "gal_map_text_202101496=阿米菈眼神認真卻帶暖意，牽著你的手。",
        "gal_map_text_202101497=從關係發展週期來看，固定據點能有效提升互動的頻率與品質。建議建立‘據點打卡記錄’，記錄每次錄音的主題、時長和核心內容，形成完整的情感成長檔案。'",
        "gal_map_text_202101498=阿米菈眼眶微紅，聲音柔軟。",
        "gal_map_text_202101499=原來你想和我長久相伴！把這裡當成‘據點’，就像有了專屬我們的秘密基地，每次來都能想起之前的回憶，這種慢慢積累的羈絆，真的太讓人珍惜了。'",
        "gal_map_text_202101500=阿米菈臉頰發燙，聲音帶著哽咽。",
        "gal_map_text_202101501=我也是！我從來沒有對一個地方有過這樣的期待，以後只要想到‘聲音糖果屋’，就會想起你，想起我們的聲音約定。有這個‘據點’在，就像我們的心意有了紮根的地方，永遠不會消散。'",
        "gal_map_text_202101502=嗯，這種自己錄音留念的方式確實挺有意思的，比單純拍照有感覺 —— 能聽到當時的笑聲、語氣，回憶起來更鮮活。和你一起錄的這段‘單曲’，確實是次不錯的體驗，以後有機會，還可以再來試試其他錄音主題。'",
        "gal_map_text_202101503=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101504=確實是一次很有新意的體驗！錄音留念比照片更具沉浸感，能更好地留存當下的情緒。基於這次的良好互動，我願意繼續探索更多類似的新鮮體驗，豐富相處的內容。'",
        "gal_map_text_202101505=阿米菈露出認真的眼神看向你。",
        "gal_map_text_202101506=從體驗回饋來看，本次錄音互動的滿意度較高，具備重複參與價值。後續可將‘聲音體驗’作為約會備選方向，持續提升相處的新鮮感。'",
        "gal_map_text_202101507=阿米菈耳尖泛紅，聲音輕柔。",
        "gal_map_text_202101508=謝謝你覺得有意思，我也覺得這種方式很特別。以後每次聽到這段錄音，就會想起今天的快樂，這種能喚醒回憶的體驗，我很珍惜。'",
        "gal_map_text_202101509=阿米菈臉頰微紅，眼神帶著歡喜。",
        "gal_map_text_202101510=太好啦！只要你覺得有意思就好。和你一起錄音的每一刻都很快樂，這種新奇的體驗，以後我們一定要多嘗試，創造更多鮮活的回憶。'",
        "gal_map_text_202101511=錄的時候不覺得，出來才感覺有點累了 —— 一直緊繃著想創意、憋笑聲，還挺消耗精力的。不過整體來說很開心，和你一起做事，就算累也覺得有意思。時間不早了，我們往地鐵站走吧，路上再聊會兒天。'",
        "gal_map_text_202101512=阿米菈點頭回應，語氣平和。",
        "gal_map_text_202101513=專注做一件事確實容易疲憊，但這次錄音的體驗價值很高，累也值得。現在往回走剛好，路上可以放鬆聊天，自然收尾，符合高效相處的節奏。'",
        "gal_map_text_202101514=阿米菈冷靜思考一下，點了點頭。",
        "gal_map_text_202101515=從精力分配來看，長時間專注互動後適當休息是合理選擇。路上聊天可複盤本次錄音的亮點與不足，為下次互動提供參考，兼顧放鬆與實用。'",
        "gal_map_text_202101516=阿米菈臉頰泛紅，聲音輕柔。",
        "gal_map_text_202101517=我也覺得有點累，但真的很開心！和你一起專注做一件事的感覺很踏實，就算疲憊，也覺得很有成就感。路上我們可以聊聊剛才錄音時的小插曲，再想想下次見面要做什麼。'",
        "gal_map_text_202101518=阿米菈眼睛亮起來，語氣雀躍。",
        "gal_map_text_202101519=對呀，雖然累但成就感滿滿！和你一起錄音的每一個小細節都很有意思，路上我們慢慢聊，順便看看夜景，這種輕鬆收尾的感覺真好。'",
        "gal_map_text_202101520=今天的錄音體驗確實不錯，和你相處也很舒服。以後不用特意提前規劃，想見面了就約，有空就來這個‘據點’錄一段，沒空就隨便逛逛街、吃點東西，順其自然就挺開心的。'",
        "gal_map_text_202101521=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101522=當下的相處體驗確實值得肯定，順其自然的模式也符合我的期待。不刻意、不勉強，在輕鬆的氛圍中慢慢瞭解彼此，是比較健康的關係發展方式。'",
        "gal_map_text_202101523=阿米菈雙手捂住臉，臉上帶點笑容。",
        "gal_map_text_202101524=從社交邏輯來看，無明確目標的互動模式雖短期體驗良好，但長期延續性需進一步觀察。建議保持開放心態，靈活調整約會節奏，專注當下的舒適感即可。'",
        "gal_map_text_202101525=阿米菈耳尖泛紅，聲音輕柔。",
        "gal_map_text_202101526=我也覺得今天很開心，和你一起錄音、聊天都很放鬆。順其自然挺好的，不用有壓力，以後想見面了我們就約，慢慢探索更多有意思的地方，創造更多輕鬆的回憶。'",
        "gal_map_text_202101527=阿米菈臉頰微紅，眼神溫柔。",
        "gal_map_text_202101528=對呀，今天真的太快樂了！我喜歡這種沒有壓力的相處，不用想太多，只要和你一起享受當下的美好就好，每一次見面都是驚喜，這樣就很滿足了。'",
        "gal_map_text_202101529=那我們現在就開啟‘巡迴演唱會’的預熱 —— 錄一段專屬約定，以後每次見面，都用它作為開場信號，好不好？'",
        "gal_map_text_202101530=阿米菈臉頰泛紅，用力點頭，對著手機輕聲說。",
        "gal_map_text_202101531=好…… 我先來！，第一站圓滿落幕，期待和你共赴每一場聲音之約。'",
        "gal_map_text_202101532=我特意準備了‘專輯錄製工具’，以後我們一人一支，隨時記錄日常的小聲響，攢夠一定數量，就一起整理成‘專輯’，怎麼樣？'",
        "gal_map_text_202101533=阿米菈立刻接過錄音筆，小心翼翼地放進包裡。",
        "gal_map_text_202101534=太好啦！我明天就開始記錄，把早餐的煎蛋聲、通勤的地鐵聲都錄下來，等見面和你分享，慢慢攢成我們的專屬回憶。'",
        "gal_map_text_202101535=我們把這張照片設成‘據點打卡封面’，每次來都拍一張合照，和錄音一起存檔，以後翻起來，就能看到我們的成長與陪伴。'",
        "gal_map_text_202101536=阿米菈立刻點頭，主動湊近你合拍。",
        "gal_map_text_202101537=好呀！我還要在照片背面標注錄音主題，讓每一次打卡都有專屬記憶點。以後我們的‘檔案館’，既有聲音，又有影像，太完整了。'",
        "gal_map_text_202101538=那以後有空就約出來吧，除了錄音，我們還可以試試雙人配音、劇本殺，都是能留下聲音回憶的體驗。'",
        "gal_map_text_202101539=阿米菈抬手輕輕拍了拍你的肩膀。",
        "gal_map_text_202101540=那我們現在去吃點東西，繼續享受今晚的快樂時光？'",
        "gal_map_text_202101541=那我們走河邊的小路回去吧，晚風涼快，人也少，聊起天來更舒服，還能緩解疲憊。'",
        "gal_map_text_202101542=阿米菈笑著跟上你，腳步輕快。",
        "gal_map_text_202101543=好呀！河邊的夜景肯定很美，和你一起散步、聊錄音的趣事，太愜意了。'",
        "gal_map_text_202101544=那我們現在去河邊散散步吧，吹吹晚風，再聊會兒天，那邊人少也安靜。'",
        "gal_map_text_202101545=阿米菈點頭回應，語氣輕快。",
        "gal_map_text_202101546=好呀！晚風這麼舒服，和你一起散步、聊聊錄音或者其他有意思的事，肯定很愜意。'",
        "gal_map_text_202101547=阿米菈挽著你的胳膊，兩人並肩走在商業街的霓虹裡，手裡的聲音明信片隨著腳步輕輕晃動，卡片摩擦的細碎聲響，與音符路燈的光影交織成浪漫的背景。",
        "gal_map_text_202101548=路過一家文創小店，你們進去挑選了同款聲音相框，把明信片嵌在裡面，做成了專屬的聲音信物。坐在街角的清吧裡，點了兩杯無酒精雞尾酒，戴上耳機一起重溫錄音裡的笑聲、輕聲的約定，偶爾抬頭對視，都會被對方眼底的笑意感染，悄悄紅了臉頰。",
        "gal_map_text_202101549=晚風裡，音符路燈的光芒溫柔籠罩著兩人，這份無需誓約的羈絆，早已在專屬聲音中深深紮根，而聲音承載的回憶，也讓這份關係多了幾分獨一無二的溫暖質感，正式宣告你們成為情侶。",
        "gal_map_text_202101550=就在你們準備轉身離開貓咪街燈，真正匯入夜色之前。",
        "gal_map_text_202101551=阿米菈忽然輕輕 '啊' 了一聲，拉住了你的手腕。",
        "gal_map_text_202101552=等一下！差點忘了……'",
        "gal_map_text_202101553=阿米菈有點不好意思地笑了笑，然後從自己那個毛絨絨的背包裡，小心地掏出一個用素色棉麻布包裹的、巴掌大小的扁平物件。",
        "gal_map_text_202101554=阿米菈將包裹放在你手中，指尖輕輕拂過布料，帶著一絲緊張的溫熱。",
        "gal_map_text_202101555=這是我提前準備的，本來想找個更自然的時機給你……'",
        "gal_map_text_202101556=我解開繫繩，裡面是一個定制的手工皮質零錢包 / 卡包。皮革是溫潤的植鞣革，觸感細膩，邊緣還帶著手工打磨的弧度。樣式簡潔大方，但最特別的是 —— 它的表面並非光滑，而是精心壓印著那晚你們共同製作的流體畫的紋理！",
        "gal_map_text_202101557=流體畫的色彩會變，但紋理是獨屬於我們的，就像和你一起的回憶一樣。'",
        "gal_map_text_202101558=阿米菈的聲音輕輕的，眼神卻很亮。",
        "gal_map_text_202101559=以後用它裝卡片或者零錢，就像我在陪著你一樣。'",
        "gal_map_text_202101560=我握緊那個帶著阿米菈溫度的卡包，皮革的質感與流體畫的記憶瞬間重疊。",
        "gal_map_text_202101561=這個禮物太特別了，我完全沒想到你會提前準備。每次摸到這個紋理，我都會想起我們一起補救顏料、討論配色的樣子，比任何紀念品都珍貴。'",
        "gal_map_text_202101562=你我順手將卡包放進貼身口袋，我手中還殘留著皮革的溫潤。",
        "gal_map_text_202101563=以後我每天都會帶著它，就像把我們的回憶揣在心裡。'",
        "gal_map_text_202101564=阿米菈沒有多說什麼，只是主動挽住你的胳膊，腳步輕快地跟著你走進夜色。",
        "gal_map_text_202101565=走吧，以後還有很多一起做手工的機會，我還要把更多我們的回憶，都‘拓印’下來呢。'",
        "gal_map_text_202101566=你們並肩走著，貓咪街燈的光暈在身後慢慢拉長，成為這段情侶關係最溫柔的注腳。",
        "gal_map_text_202101567=走到下一個路口，準備往不同方向的地鐵站走時，阿米菈忽然叫住你，然後低頭在自己的背包裡翻找了一會兒，嘴角帶著藏不住的笑意。",
        "gal_map_text_202101568=對了，這個給你！'",
        "gal_map_text_202101569=阿米菈拿出一個小巧的、羊毛氈戳制的迷你掛件，遞到你面前。",
        "gal_map_text_202101570=它不是店裡材料包做的，而是更精緻 —— 一個圓圓的、奶白色打底的小星球，上面用淡粉、淺藍的羊毛 '種' 了幾朵小小的絨球花，還用黑色羊毛戳了兩個豆豆眼和一個彎彎的微笑，像極了阿米菈笑起來的樣子。",
        "gal_map_text_202101571=星球背面，用幾乎看不見的黑色細線，工整地縫著今天的日期，針腳細密，能看出是花了心思的。",
        "gal_map_text_202101572=這是我偷偷回到店裡內，照著你教我方式製作的羊毛氈，特意縮小重做的。小星球代表‘毛球行星’，也代表…… 我們以後可以一起探索更多美好呀。'",
        "gal_map_text_202101573=你接過掛件，羊毛的觸感柔軟溫暖，還帶著阿米菈身上的淡淡清香，忍不住湊到鼻尖聞了聞。",
        "gal_map_text_202101574=太可愛了，和你一模一樣。這個日期縫得真精緻，你肯定花了不少時間吧？'",
        "gal_map_text_202101575=我立刻把掛件掛在鑰匙串上，輕輕晃動了一下。",
        "gal_map_text_202101576=以後我每次拿鑰匙，都會想起你戳羊毛氈時認真的樣子，還有我們一起補救歪耳朵的趣事。'",
        "gal_map_text_202101577=阿米菈看著你把掛件掛好，眼睛彎成了月牙。",
        "gal_map_text_202101578=這樣你每次拿鑰匙，就能想起今天的貓咪街燈和我們一起做手工的樣子啦。'",
        "gal_map_text_202101579=下次見面，我也給你帶個小禮物，是我照著你的羊毛氈小貓做的鑰匙扣，保證和你的小星球配成一對。'",
        "gal_map_text_202101580=你們手牽手走向地鐵，鑰匙串上的小星球輕輕晃動，像一顆小小的、承載著心意的星辰，宣告著你們正式成為情侶。",
        "gal_map_text_202101581=走到地鐵站入口，阿米菈停下腳步，臉上還帶著輕鬆的笑意，眼神明亮而純粹。",
        "gal_map_text_202101582=今天真的很開心，不管是戳羊毛氈還是做流體畫，和你一起都覺得特別有意思。'",
        "gal_map_text_202101583=阿米菈抬手理了理被風吹亂的頭髮，語氣自然又真誠。",
        "gal_map_text_202101584=其實從一起做手工的時候，我就覺得和你很合拍，現在…… 我想我們可以正式在一起試試。'",
        "gal_map_text_202101585=我也覺得和你相處很舒服，不管是討論配色還是補救小失誤，都不用刻意遷就，這種合拍的感覺很難得。我願意和你正式在一起，以後多創造些這樣開心的時光。'",
        "gal_map_text_202101586=阿米菈的笑容瞬間變得更燦爛了，像點亮了夜色裡的路燈。",
        "gal_map_text_202101587=那以後有空就約出來吧，不管是再去做手工，還是去吃你上次說的那家甜品店，都可以。'",
        "gal_map_text_202101588=好啊，我最近還發現一家做陶藝的工作室，和手工很像，下次我們一起去試試？我查過攻略，裡面的老師很專業，肯定不會讓你‘翻車’。'",
        "gal_map_text_202101589=阿米菈揮了揮手，轉身走進進站口，還回頭沖你比了個 '加油' 的手勢。",
        "gal_map_text_202101590=下次見啦，男朋友！'",
        "gal_map_text_202101591=沒有複雜的儀式，也沒有信物的交換，但彼此的心意已經明確。你們的情侶關係，就像今天的手工體驗一樣，簡單、純粹，卻充滿了輕鬆的快樂，在夜色中悄然開啟。",
        "gal_map_text_202101592=走出工作室，你們並肩走在商業街的人流中，手裡的手作被隨意放進紙袋，偶爾碰撞發出輕輕的聲響。",
        "gal_map_text_202101593=路過一家便利店，阿米菈拉著你進去買了兩支不同口味的霜淇淋，撕開包裝時，眼神裡還帶著做手工後的滿足笑意。",
        "gal_map_text_202101594=其實做手工最有意思的不是成品，是和你一起瞎琢磨的過程。'",
        "gal_map_text_202101595=阿米菈咬了一口草莓味霜淇淋，語氣輕快。",
        "gal_map_text_202101596=你幫我補救歪耳朵的時候，我還偷偷想，幸好有你，不然我的小貓就要變成‘歪脖星人’了。'",
        "gal_map_text_202101597=我反而覺得歪耳朵很可愛，是專屬你的風格。不過能幫你補救成功，我也挺有成就感的，比自己做好作品還開心。'",
        "gal_map_text_202101598=阿米菈也跟著笑起來，霜淇淋的甜膩混著晚風的清涼，氛圍格外愜意",
        "gal_map_text_202101599=走到地鐵站入口，阿米菈把沒吃完的霜淇淋扔進垃圾桶，轉頭對你揮揮手。",
        "gal_map_text_202101600=以後有空就約呀，不用特意提前準備手工，哪怕只是一起逛逛街、吃個霜淇淋也挺好。'",
        "gal_map_text_202101601=完全同意，下次我們可以不用規劃，走到哪算哪，路過有趣的店就進去看看，這樣更放鬆。'",
        "gal_map_text_202101602=看著阿米菈走進進站口，阿米菈還回頭沖你比了個'OK'的手勢，眼底的笑意明亮又純粹。這段關係沒有手作信物的綁定，卻有著基於輕鬆互動的自然好感，像一支簡單的霜淇淋，甜而不膩，在日常的陪伴中慢慢延續。",
        "gal_map_text_202101603=就在你們即將轉身離開復古路燈的光暈時，阿米菈忽然 '啊' 了一聲，急忙拉住了你的衣袖，眼底帶著一絲懊惱和不好意思。",
        "gal_map_text_202101604=等等！差點忘了最重要的東西……'",
        "gal_map_text_202101605=阿米菈抿嘴笑了笑，然後從自己隨身的斜挎包裡，小心地掏出一個用深藍色絲絨布袋裝著的、扁平的金屬盒子，布袋的觸感細膩柔軟。",
        "gal_map_text_202101606=阿米菈將盒子輕輕放在你手中，指尖無意識地劃過絲絨表面，能感受到阿米菈的些許緊張。",
        "gal_map_text_202101607=你打開盒子，裡面不是珠寶，而是一個定制的老式黃銅 '探香輪'。",
        "gal_map_text_202101608=它像一個精緻的懷錶，大小剛好能握在掌心，黃銅的色澤溫潤，帶著復古的質感，但表面是空白的金屬盤，沒有多餘的裝飾。",
        "gal_map_text_202101609=最特別的是，金屬盤上用鐳射蝕刻著你們今晚調製的 '星夜海岸' 香氣的完整配方公式 —— 檸檬醛、橙花醇、檀香醚…… 那些化學名稱和精確到小數點後兩位的比例，被排列成優雅的環形圖案，像某種神秘的星圖，又像香水的 '基因密碼'。",
        "gal_map_text_202101610=探香輪是調香師的工具，這個是我特意定制的，上面的配方是獨屬於我們的。'",
        "gal_map_text_202101611=阿米菈的聲音輕輕的，帶著一絲期待。",
        "gal_map_text_202101612=黃銅會隨著使用慢慢氧化，變得更有光澤，就像我們的關係一樣，會慢慢沉澱得更好。以後看到它，你就會想起我們一起調香的味道，想起今晚的路燈和晚風。'",
        "gal_map_text_202101613=我握緊探香輪，黃銅的涼意透過掌心傳來，卻能感受到背後阿米菈滿滿的心意，抬頭對阿米菈認真說。",
        "gal_map_text_202101614=這個禮物太用心了，我從來沒收到過這麼特別的東西。每次看到這個配方，我都會想起你糾結選精油時的樣子，還有我們一起試香時的驚喜，比任何昂貴的香水都珍貴。'",
        "gal_map_text_202101615=我會好好保管它，以後每次用的時候，都會想起今晚的約定。'",
        "gal_map_text_202101616=阿米菈主動牽住你的手，指尖相觸的瞬間，帶著淡淡的香水味。",
        "gal_map_text_202101617=走吧，以後我們可以一起調製更多專屬香味，把它們都‘刻’在心裡。'",
        "gal_map_text_202101618=好，下次我們試試以四季為主題調香，春天用花香，夏天用果香，把每個季節的回憶都做成專屬香氣，和這個探香輪一起收藏。'",
        "gal_map_text_202101619=復古路燈的光芒灑在你們相牽的手上，香氣與心意交織，正式宣告你們成為情侶，而這個獨特的探香輪，成為了這段關係最珍貴的見證。",
        "gal_map_text_202101620=走到下一個路口，準備往不同方向分別時，阿米菈從口袋裡拿出一個小小的、造型別致的噴霧分裝瓶，遞到你面前，臉上帶著甜甜的笑意。",
        "gal_map_text_202101621=瓶子是磨砂玻璃的，只有拇指大小，配著一個精緻的金屬噴頭，瓶身還刻著簡單的波浪紋，看起來很可愛。",
        "gal_map_text_202101622=給，這是你的‘移動香水庫’。'",
        "gal_map_text_202101623=我剛才在店裡，趁你去拿扭蛋的時候，偷偷分裝了一點我們一起調的香水進去。'",
        "gal_map_text_202101624=我接過瓶子，發現瓶身上貼著一張小小的、透明的手寫標籤，是阿米菈清秀的字跡：'備用鑰匙 - [今天的日期]'，旁邊還畫了一個小小的香味符號。",
        "gal_map_text_202101625=‘備用鑰匙’是說，這瓶香水是打開我心意的鑰匙呀。'",
        "gal_map_text_202101626=以後你想我的時候，就噴一點，就像我在你身邊一樣。'",
        "gal_map_text_202101627=磨砂玻璃的觸感微涼，裡面的香水卻仿佛承載著溫暖的心意。我輕輕按壓噴頭，熟悉的香氣彌漫開來，瞬間勾起了今天調香的所有回憶。",
        "gal_map_text_202101628=這個標籤太浪漫了，‘備用鑰匙’的寓意我懂。以後我每天出門都會噴一點，讓你的心意一直陪著我，走到哪裡都能想起我們一起調香的快樂。'",
        "gal_map_text_202101629=阿米菈看著你，眼神裡滿是期待，然後主動抱了抱你。",
        "gal_map_text_202101630=那我先走啦，男朋友，下次見！'",
        "gal_map_text_202101631=下次見面，我要給你一個驚喜，是我用我們的香水味，搭配了一款香薰蠟燭，以後我們可以一起在燭光下重溫這個味道。'",
        "gal_map_text_202101632=簡單的分裝瓶，卻裝滿了專屬的香氣與心意，宣告著你們情侶關係的開啟，也為未來的約會埋下了浪漫的伏筆。",
        "gal_map_text_202101633=走到街角的十字路口，阿米菈停下腳步，臉上帶著輕鬆愉悅的笑容，身上的香水味在晚風中輕輕飄散。",
        "gal_map_text_202101634=今天調香真的太有意思了，尤其是和你一起選精油、試比例，感覺時間過得特別快。'",
        "gal_map_text_202101635=阿米菈看著你，眼神真誠而直接。",
        "gal_map_text_202101636=我覺得我們很合拍，不管是對香味的喜好，還是相處的節奏，所以…… 我想和你正式在一起。'",
        "gal_map_text_202101637=我也早就有這個想法了。和你一起調香的時候，我就發現我們的喜好很契合，連對‘甜而不膩’的定義都一樣，這種默契很難得，我很想和你正式在一起，探索更多喜歡的香味。'",
        "gal_map_text_202101638=阿米菈的眼睛瞬間亮了起來，像盛滿了星光。",
        "gal_map_text_202101639=那以後我們可以一起去打卡更多香氛店，或者再去 DIY 其他味道的香水，甚至可以試試做香薰蠟燭，想想就覺得很有趣。'",
        "gal_map_text_202101640=我知道有家小眾香氛店，裡面有很多冷門香型，下次我們一起去試香，說不定能找到新的靈感，再一起調一款更特別的香水。'",
        "gal_map_text_202101641=阿米菈抬手看了看時間，有點不舍地說。",
        "gal_map_text_202101642=我該去趕地鐵了，下次我們提前約，去試試你說的那家帶香氛體驗的咖啡館吧？'",
        "gal_map_text_202101643=你們揮手告別，阿米菈轉身走向地鐵站，身影漸漸融入夜色。沒有信物的交換，但空氣中殘留的香水味和彼此的約定，已經明確了情侶的身份，這段關係像一款清新的前調香水，帶著輕鬆的快樂，在夜色中悄然綻放。",
        "gal_map_text_202101644=晚風帶著你們調的香水味，縈繞在彼此身邊。你們沒有刻意放慢腳步，只是隨意聊著天，從喜歡的香型聊到日常的通勤，話題輕鬆又無壓力。",
        "gal_map_text_202101645=路過一家奶茶店，阿米菈提議買杯奶茶再分開，你自然地答應。",
        "gal_map_text_202101646=其實香水不用天天噴，偶爾聞到這個味道，能想起今天的快樂就夠了。'",
        "gal_map_text_202101647=阿米菈捧著溫熱的珍珠奶茶，指尖蹭過杯壁的溫度。",
        "gal_map_text_202101648=以後我們不用總想著調新香水，有空就一起打卡網紅奶茶店，或者去公園散散步，這種不刻意的相處才最舒服。'",
        "gal_map_text_202101649=我完全同意，比起刻意規劃，我更喜歡這種自然的相處。下次我們可以去附近的公園散步，那裡晚上有晚風，還能聞到草木香，和我們的香水味肯定很搭。'",
        "gal_map_text_202101650=阿米菈喝了一口奶茶，眼睛彎成月牙。",
        "gal_map_text_202101651=下次見面不用提前做攻略，你隨便選個地方，我跟著你就行。'",
        "gal_map_text_202101652=走到地鐵口，阿米菈揮揮手轉身進站。",
        "gal_map_text_202101653=路上注意安全，到家記得告訴我一聲。下次我帶你去吃一家隱藏在巷子裡的甜品店，他們家的提拉米蘇，味道和我們香水的後調一樣，溫柔又綿長。'",
        "gal_map_text_202101654=奶茶的甜香與香水的餘韻交織，這段關係像一杯溫熱的奶茶，沒有專屬氣味的深刻羈絆，卻有著日常陪伴的溫暖愜意。",
        "gal_map_text_202101655=就在你們即將轉身離開音符街燈時，阿米菈忽然輕輕 '啊' 了一聲，急忙拉住了你的手腕，臉上帶著一絲懊惱的小表情。",
        "gal_map_text_202101656=等等…… 差點忘了這個重要的東西。'",
        "gal_map_text_202101657=阿米菈說著，從自己那個看起來總是能掏出驚喜的背包裡，小心地取出一個用黑色吸音棉材質包裹的、書本大小的扁平盒子，吸音棉的觸感柔軟粗糙，能很好地保護裡面的物品。",
        "gal_map_text_202101658=阿米菈將盒子輕輕放在你手中，指尖無意識地劃過包裹表面，眼神裡滿是期待。你打開盒子，裡面不是複雜的電子設備，而是一個定制的老式 '磁帶' 造型藍牙音箱。",
        "gal_map_text_202101659=它完美複刻了老式卡帶的外觀，但尺寸稍大一些，外殼是溫潤的深灰色磨砂金屬，觸感細膩，沒有指紋殘留。",
        "gal_map_text_202101660=正面的 '磁帶視窗' 是一塊黑色的液晶顯示幕，側面的 '播放鍵' 和 '音量旋鈕' 是真正的物理按鍵，轉動時還會發出輕微的 '哢噠' 聲，充滿復古感。",
        "gal_map_text_202101661=這是我特意定制的，裡面已經提前存好了我們那天錄的聲音明信片音訊。'",
        "gal_map_text_202101662=你連接藍牙就能播放，而且它還能錄音，以後我們每次見面，都可以錄一段新的聲音存進去，慢慢攢成我們的‘專屬聲音合集’。'",
        "gal_map_text_202101663=你看，開機之後，螢幕會顯示音訊的波形圖，就像我們的心意一樣，看得見也聽得見。'",
        "gal_map_text_202101664=我按下播放鍵，熟悉的笑聲和輕聲細語從音箱裡傳來，瞬間將你拉回錄音時的場景。",
        "gal_map_text_202101665=這個音箱也太有創意了，復古又實用。每次聽到裡面的聲音，我都會想起你模仿鯨魚叫時的可愛模樣，還有我們一起笑場的瞬間，比任何照片都有畫面感。'",
        "gal_map_text_202101666=我會把它放在床頭，每天睡前都聽一遍，就像你在我身邊講故事一樣。'",
        "gal_map_text_202101667=阿米菈主動牽住你的手，聲音裡滿是溫柔。",
        "gal_map_text_202101668=以後不管你在哪裡，想聽我的聲音了，打開它就好。'",
        "gal_map_text_202101669=好，下次見面我們錄一段睡前故事，存進音箱裡，以後不管誰出差，都能靠著這個聲音安心入睡。我們還要給每段錄音起名字，讓它變成我們的‘聲音日記’。'",
        "gal_map_text_202101670=音符路燈的光影落在你們身上，音箱裡的聲音輕輕流淌，你們的情侶關係，在專屬的聲韻與信物中正式確立，溫暖而堅定。",
        "gal_map_text_202101671=走到下一個路口，準備往不同方向走時，阿米菈從口袋裡拿出一個小巧的、金屬材質的 '復古麥克風' 造型 U 盤，遞到你面前，臉上帶著俏皮的笑意。",
        "gal_map_text_202101672=U 盤只有拇指大小，做工精緻，金屬網罩、開關按鈕的細節都惟妙惟肖，甚至還能看到 '麥克風線' 造型的掛繩孔，看起來又可愛又有質感。",
        "gal_map_text_202101673=給，這是你的‘音源備份’。我剛剛在店裡，用他們的設備把我們的‘聲音明信片’音訊檔拷貝到這裡面了，而且還多存了一段我偷偷錄的、沒讓你聽的 ASMR 輕語哦。'",
        "gal_map_text_202101674=我接過 U 盤，發現尾部的掛繩上，還系著一個非常小的、透明亞克力鑰匙扣，裡面封存著一小片印刷電路板，上面用極細的銀色線路，蝕刻著今天的日期和兩個抽象的聲波形圖案，一個像阿米菈的笑聲，一個像你的說話聲，巧妙又用心。",
        "gal_map_text_202101675=U 盤是‘麥克風’造型，代表我們的聲音約定。'",
        "gal_map_text_202101676=亞克力鑰匙扣裡的聲波形，是獨屬於我們的‘愛情密碼’。以後你把它插在電腦上，就能隨時聽到我們的聲音，想起今天的音符街燈和錄音時的快樂。'",
        "gal_map_text_202101677=這個‘愛情密碼’太特別了，我根本捨不得用，想一直珍藏著。不過為了聽你的 ASMR 輕語，我今晚就回家插電腦上，肯定能甜到睡著。'",
        "gal_map_text_202101678=下次見面，我要錄一段專屬你的起床鈴聲，存進這個 U 盤裡，以後每天都用它叫你起床。'",
        "gal_map_text_202101679=阿米菈看著你，眼睛彎成了月牙。",
        "gal_map_text_202101680=以後我們可以錄更多有趣的內容，比如一起讀詩、唱兒歌，都存在這個 U 卡裡，讓它成為我們的‘聲音時光機’。'",
        "gal_map_text_202101681=你們手牽手想著回家的方向走去，鑰匙串上的 '麥克風' U 盤輕輕晃動，像一顆小小的、會發聲的心意，見證著你們成為情侶的瞬間。",
        "gal_map_text_202101682=走到河邊的步道入口，晚風輕輕吹過，帶著淡淡的草木清香。阿米菈停下腳步，臉上帶著輕鬆愜意的笑容，眼神裡滿是愉悅。",
        "gal_map_text_202101683=今天的錄音體驗真的太特別了，尤其是和你一起模仿卡通人物、錄 ASMR，我好久沒這麼開心過了。'",
        "gal_map_text_202101684=阿米菈看著你，語氣自然又真誠。",
        "gal_map_text_202101685=其實從我們一起討論錄音內容的時候，我就覺得和你很合拍，現在…… 我想我們可以以情侶的身份，繼續探索更多有趣的聲音呀。'",
        "gal_map_text_202101686=我也覺得和你合拍得不可思議，不管是我拋的梗你都能接住，還是我們對錄音風格的喜好都一樣，這種感覺太舒服了。我很想和你正式在一起，以後一起解鎖更多聲音相關的體驗。'",
        "gal_map_text_202101687=阿米菈的笑容瞬間變得更燦爛了，像被風吹動的音符，充滿活力。",
        "gal_map_text_202101688=那以後我們可以去體驗雙人配音課，或者去公園錄自然的聲音，甚至可以一起做一個屬於我們的小播客，想想就覺得很有意思。",
        "gal_map_text_202101689=我知道一家專業的錄音棚，裡面有各種有趣的音效設備，下次我們一起去體驗，錄一段屬於我們的迷你廣播劇，肯定會很有紀念意義。'",
        "gal_map_text_202101690=阿米菈看了看天色，笑著說。",
        "gal_map_text_202101691=時間不早啦，我該回家了，下次我們約著去你說的那家錄音棚體驗吧？'",
        "gal_map_text_202101692=你們並肩走了一段，然後在路口揮手告別。但彼此對聲音的共同熱愛和輕鬆的相處氛圍，已經讓情侶關係水到渠成。這段關係，就像一段愉快的錄音，簡單、純粹，卻充滿了讓人回味的美好。",
        "gal_map_text_202101693=手裡的聲音明信片被阿米菈隨意塞進手機殼背面，露出一角卡通圖案。你們沿著河邊步道慢慢走，晚風帶著草木清香，偶爾能聽到遠處傳來的笑聲，和錄音裡的歡樂形成奇妙呼應。",
        "gal_map_text_202101694=其實錄音最有趣的不是保存下來，是當時忍不住笑場的瞬間。'",
        "gal_map_text_202101695=阿米菈拿出手機，翻出錄音片段快速聽了一句，自己先笑出了聲。",
        "gal_map_text_202101696=你模仿恐龍咆哮的時候，聲音都破音了，我當時差點憋不住笑，還好忍住了。'",
        "gal_map_text_202101697=還說我呢，你模仿撒嬌顧客的時候，聲音甜得發膩，我差點沒忍住笑場，硬憋回去的樣子肯定很搞笑。'",
        "gal_map_text_202101698=步道上的路燈把兩人的影子拉得很長，氛圍輕鬆又愜意。",
        "gal_map_text_202101699=走到路口，阿米菈停下腳步。",
        "gal_map_text_202101700=以後不用特意錄專屬聲音，想見面了就發消息，我們可以一起去吃火鍋、看電影，或者就像現在這樣隨便散散步，聊聊天。'",
        "gal_map_text_202101701=我也是這麼想的，比起刻意製造回憶，我更喜歡這種自然的相處。下次我們可以去看一場喜劇電影，看完之後去吃燒烤，邊吃邊聊電影裡的搞笑片段，肯定和今天錄音一樣開心。'",
        "gal_map_text_202101702=阿米菈揮揮手轉身走向馬路對面，手機殼背面的聲音明信片在燈光下隱約可見。",
        "gal_map_text_202101703=這段關係沒有聲音信物的綁定，卻有著基於共同快樂回憶的自然延續，像一場未完待續的輕鬆聊天，在日常的煙火氣中慢慢推進。",
        "gal_map_text_202101704=對呀，這邊人太多有點吵，小路肯定更舒服。能和你聊聊喜歡的香型，提前為下次見面做準備，這種有期待的感覺真好，我已經開始盼著下次調香了。'",
        "gal_map_text_202101705=以後，我們可以一起做更多喜歡的事，把每一次的心動都記下來，不用再小心翼翼試探了，好不好？'",
        "gal_map_text_202101706=阿米菈悄悄點頭，聲音軟軟的。",
        "gal_map_text_202101707=好…… 以後不管做什麼，我都想和你一起，讓每段時光都有彼此的痕跡。'",
        "gal_map_text_202101708=我們交換作品吧，以後看到對方做的東西，就像看到彼此一樣，讓這份羈絆一直都在。'",
        "gal_map_text_202101709=阿米菈立刻接過，小心地抱在懷裡",
        "gal_map_text_202101710=好呀！我會好好保管，下次見面我們再一起做一對新的，讓羈絆越來越深。'",
        "gal_map_text_202101711=我們拍一張合照吧，和作品一起，把今天的美好時光定格下來，以後想對方了就拿出來看看。'",
        "gal_map_text_202101712=阿米菈立刻點頭，主動湊近你。",
        "gal_map_text_202101713=好呀！要把貓咪路燈也拍進去，它是我們心動的見證者。'",
        "gal_map_text_202101714=那以後有空就約出來見面吧，不管是做手工還是吃美食，都可以。'",
        "gal_map_text_202101715=阿米菈開心的點了點頭。",
        "gal_map_text_202101716=好呀！我隨時都有空，只要能和你一起，做什麼都好。'",
        "gal_map_text_202101717=那下次我們去試試陶藝？聽說和手工很像，應該會很有意思。'",
        "gal_map_text_202101718=阿米菈幸福的點了點頭，腳步輕快地跟上你。",
        "gal_map_text_202101719=好呀！我早就想試試了，和你一起肯定更開心。'",
        "gal_map_text_202101720=那我們現在去河邊散散步吧，吹吹晚風，再聊會兒天？'",
        "gal_map_text_202101721=阿米菈點頭回應，語氣輕快，側身做出 '請' 的手勢。",
        "gal_map_text_202101722=好呀！晚風這麼舒服，和你一起散步肯定很愜意。'",
        "gal_map_text_202101723=阿米菈挽著你的胳膊，兩人並肩走在商業街的暖光裡，手裡的手作隨著腳步輕輕晃動，紙袋摩擦的細碎聲響成了此刻最溫柔的背景音。",
        "gal_map_text_202101724=路過一家還在營業的糖水鋪，你們坐在靠窗的位置分享著一碗甜而不膩的雙皮奶，偶爾抬頭對視，都會被對方眼底的笑意感染，悄悄紅了臉頰。",
        "gal_map_text_202101725=離開時，你們交換了手作，指尖相觸的瞬間，曖昧的氛圍悄然定格，這份無需誓約的心意，早已在街燈下的告白中確認，而手作承載的羈絆，也讓這份關係多了幾分珍貴的質感。",
        "gal_map_text_202101726=走出「聲音糖果屋」，夜晚的商業街換上了更深沉的霓虹。喧囂依舊，但你們耳朵裡似乎還殘留著剛才錄音隔間的特殊靜謐，或是彼此笑聲的餘韻。",
        "gal_map_text_202101727=阿米菈小心地把那張聲音明信片和可能新得的刺繡耳機套收進包裡，然後在那盞畫著音符圖案的街燈下停住了腳步。",
        "gal_map_text_202101728=阿米菈沒有立刻說話，而是從包裡拿出那張聲音明信片，對著燈光又看了一眼上面的二維碼，仿佛在確認那個通往一小段過去的 '入口' 真的存在。",
        "gal_map_text_202101729=音符路燈的霓虹落在明信片上，二維碼的紋路清晰可見。阿米菈指尖輕輕拂過卡片邊緣，感受著紙質的細膩，抬頭看向你時，眼底閃著細碎的光。",
        "gal_map_text_202101730=阿米菈把明信片輕輕按在胸口，明信片上的二維碼好像一個時光膠囊，只要掃一下，就能回到剛才和你一起說笑的瞬間，這種能留住聲音的感覺，真的很奇妙。",
        "gal_map_text_202101731=晚風輕輕吹過，阿米菈往你身邊靠近了些，肩膀幾乎貼上你的胳膊，聲音放得更柔。",
        "gal_map_text_202101732=沒想到被你發現了，我還以為模仿得很誇張，會讓你覺得幼稚呢。其實我剛才也偷偷錄了一段你的笑聲，那種清脆又甜軟的感覺，想回去之後慢慢聽 —— 畢竟第一次見面時，我就覺得你的笑聲比任何音樂都好聽，像治癒的旋律。'",
        "gal_map_text_202101733=阿米菈臉頰微紅，輕輕跺腳。",
        "gal_map_text_202101734=你居然偷偷錄我的笑聲！' 阿米菈頓了頓，語氣帶著期待，'那…… 你覺得我的笑聲真的很好聽嗎？這可是我們一起錄的‘專屬單曲’，意義不一樣呢。'",
        "gal_map_text_202101735=當然好聽，不只是笑聲，和你有關的每一個聲音都讓我心動 —— 你破音後的羞澀、模仿小動物的可愛、輕聲和我討論臺詞的溫柔，這張聲音明信片，是比任何紀念品都珍貴的‘限量專輯’。'",
        "gal_map_text_202101736=音符路燈的霓虹在阿米菈臉上輕輕晃動，把阿米菈的耳尖映得微紅。阿米菈指尖緊緊攥著聲音明信片，二維碼的邊緣被捏得微微發皺，指腹因為緊張而泛著溫熱。",
        "gal_map_text_202101737=阿米菈下意識地往你身邊又挪了挪，身體輕輕靠在你的胳膊上，帶著一絲不易察覺的依賴，呼吸的溫熱拂過你的手腕。眼神裡滿是對這份 '專屬聲音' 的珍視，也藏著對你回應的忐忑期待 —— 阿米菈在等你讀懂這聲音背後，那些沒說出口的溫柔心意。此刻，周圍的喧囂仿佛都褪去了，只剩下彼此的呼吸聲與晚風的輕響，你只想把這份被聲音包裹的情感，認真地傳遞給阿米菈。",
        "gal_map_text_202101738=明信片巡迴演唱會",
        "gal_map_text_202101739=明信片專屬專輯",
        "gal_map_text_202101740=聲音檔案館",
        "gal_map_text_202101741=嘗試新奇體驗",
        "gal_map_text_202101742=分享今天錄音體驗",
        "gal_map_text_202101743=邀請阿米菈下次再來",
        "gal_map_text_202101744=一張成功的唱片之後，本來就該有巡迴演唱會啊。這張明信片只是我們的第一站，後面還會有第二站、第三站 —— 我們可以一起錄雙人配音、ASMR 睡前故事、甚至是日常的碎碎念，把每一次見面都變成一場專屬演唱會，讓我們的聲音羈絆，在更多時光裡迴圈播放。'",
        "gal_map_text_202101745=阿米菈指尖停頓在明信片邊緣，眼神認真卻帶暖意。",
        "gal_map_text_202101746=這個比喻很貼切！從‘單曲’到‘巡迴演唱會’，情感遞進邏輯清晰。這種基於共同興趣的長期規劃，既保留了專屬感，又具備可持續性，我很認同，也期待每一場‘演唱會’的開啟。'",
        "gal_map_text_202101747=阿米菈眼神認真，快速回答道。",
        "gal_map_text_202101748=你的表述精准概括了關係深化路徑 —— 從單次錄音（單曲）到長期多場景互動（巡迴演唱會）。建議建立‘聲音合集’共用資料夾，按時間線歸檔每一段錄音，形成完整的情感聲音體系。'",
        "gal_map_text_202101749=阿米菈眼眶微紅，聲音柔軟帶哽咽。",
        "gal_map_text_202101750=聽到你說‘巡迴演唱會’，我心裡一下子就滿了！原來你早就想和我延續這份羈絆，我也想把每一次見面都變成專屬回憶，讓我們的聲音，在時光裡一直陪伴彼此。'",
        "gal_map_text_202101751=阿米菈眼底閃著淚光，指尖緊緊攥住你的手。",
        "gal_map_text_202101752=原來我們的心意一直同步！從錄音時的默契，到現在的‘演唱會約定’，每一刻都像在做夢。我想和你一起，把所有日常都變成可聆聽的旋律，永遠單曲迴圈下去。'",
        "gal_map_text_202101753=一張‘單曲’怎麼夠？我更期待下一次，和你一起錄更長、更日常、更不用刻意想話題的‘專屬專輯’ —— 沒有固定腳本，沒有時間限制，就錄我們的日常碎碎念、一起做飯的聲響、散步時的晚風，把最真實的彼此，都藏進旋律裡，讓這份聲音羈絆，滲透到生活的每一個角落。'",
        "gal_map_text_202101754=阿米菈嘴角帶笑，眼神溫和。",
        "gal_map_text_202101755=日常化的錄音設定很有意義。聲音是情感的鮮活載體，把日常融入‘專輯’，能讓羈絆更具煙火氣，也讓關係在自然的互動中慢慢深化，我很期待這份‘生活化專輯’。'",
        "gal_map_text_202101756=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101757=從情感維繫角度來看，日常錄音能有效提升關係的親密度。建議確定‘專輯主題’，比如‘三餐四季’‘城市漫步’，按主題歸檔錄音，讓回憶更有條理。'",
        "gal_map_text_202101758=阿米菈臉頰泛紅，聲音輕柔。",
        "gal_map_text_202101759=你這麼說，我突然覺得生活都變得浪漫起來！原來最珍貴的聲音，不是刻意設計的臺詞，而是日常的瑣碎與陪伴。我想和你一起，把每一個平凡的瞬間，都變成專屬我們的‘限定曲目’。'",
        "gal_map_text_202101760=阿米菈眼睛亮起來，把明信片貼在胸口。",
        "gal_map_text_202101761=這就是我們的‘愛情專輯’啊！以後不管過多久，只要聽到這些日常的聲音，就會想起和你一起的點點滴滴，這種滲透在生活裡的羈絆，才最長久、最動人。'",
        "gal_map_text_202101762=所以，我單方面宣佈，這裡會成為我們長期的據點 —— 只要有時間，就一定會來光顧。以後我們可以在這裡錄下每個階段的聲音：開心時的笑聲、疲憊時的吐槽、節日的祝福，讓‘聲音糖果屋’，成為我們愛情裡的‘聲音檔案館’，見證我們每一段成長與陪伴。",
        "gal_map_text_202101763=阿米菈指尖摩挲明信片邊緣，語氣堅定。",
        "gal_map_text_202101764=將特定地點作為‘據點’，能為關係提供穩定的情感錨點。這種基於固定場景的長期約定，既保留了專屬感，又能讓回憶更有連貫性，我很認同，也願意和你一起守護這個‘檔案館’。'",
        "gal_map_text_202101765=阿米菈眼神認真卻帶暖意，牽著你的手。",
        "gal_map_text_202101766=從關係發展週期來看，固定據點能有效提升互動的頻率與品質。建議建立‘據點打卡記錄’，記錄每次錄音的主題、時長和核心內容，形成完整的情感成長檔案。'",
        "gal_map_text_202101767=阿米菈眼眶微紅，聲音柔軟。",
        "gal_map_text_202101768=原來你想和我長久相伴！把這裡當成‘據點’，就像有了專屬我們的秘密基地，每次來都能想起之前的回憶，這種慢慢積累的羈絆，真的太讓人珍惜了。'",
        "gal_map_text_202101769=阿米菈臉頰發燙，聲音帶著哽咽。",
        "gal_map_text_202101770=我也是！我從來沒有對一個地方有過這樣的期待，以後只要想到‘聲音糖果屋’，就會想起你，想起我們的聲音約定。有這個‘據點’在，就像我們的心意有了紮根的地方，永遠不會消散。'",
        "gal_map_text_202101771=嗯，這種自己錄音留念的方式確實挺有意思的，比單純拍照有感覺 —— 能聽到當時的笑聲、語氣，回憶起來更鮮活。和你一起錄的這段‘單曲’，確實是次不錯的體驗，以後有機會，還可以再來試試其他錄音主題。'",
        "gal_map_text_202101772=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101773=確實是一次很有新意的體驗！錄音留念比照片更具沉浸感，能更好地留存當下的情緒。基於這次的良好互動，我願意繼續探索更多類似的新鮮體驗，豐富相處的內容。'",
        "gal_map_text_202101774=阿米菈露出認真的眼神看向你。",
        "gal_map_text_202101775=從體驗回饋來看，本次錄音互動的滿意度較高，具備重複參與價值。後續可將‘聲音體驗’作為約會備選方向，持續提升相處的新鮮感。'",
        "gal_map_text_202101776=阿米菈耳尖泛紅，聲音輕柔。",
        "gal_map_text_202101777=謝謝你覺得有意思，我也覺得這種方式很特別。以後每次聽到這段錄音，就會想起今天的快樂，這種能喚醒回憶的體驗，我很珍惜。'",
        "gal_map_text_202101778=阿米菈臉頰微紅，眼神帶著歡喜。",
        "gal_map_text_202101779=太好啦！只要你覺得有意思就好。和你一起錄音的每一刻都很快樂，這種新奇的體驗，以後我們一定要多嘗試，創造更多鮮活的回憶。'",
        "gal_map_text_202101780=錄的時候不覺得，出來才感覺有點累了 —— 一直緊繃著想創意、憋笑聲，還挺消耗精力的。不過整體來說很開心，和你一起做事，就算累也覺得有意思。時間不早了，我們往地鐵站走吧，路上再聊會兒天。'",
        "gal_map_text_202101781=阿米菈點頭回應，語氣平和。",
        "gal_map_text_202101782=專注做一件事確實容易疲憊，但這次錄音的體驗價值很高，累也值得。現在往回走剛好，路上可以放鬆聊天，自然收尾，符合高效相處的節奏。'",
        "gal_map_text_202101783=阿米菈冷靜思考一下，點了點頭。",
        "gal_map_text_202101784=從精力分配來看，長時間專注互動後適當休息是合理選擇。路上聊天可複盤本次錄音的亮點與不足，為下次互動提供參考，兼顧放鬆與實用。'",
        "gal_map_text_202101785=阿米菈臉頰泛紅，聲音輕柔。",
        "gal_map_text_202101786=我也覺得有點累，但真的很開心！和你一起專注做一件事的感覺很踏實，就算疲憊，也覺得很有成就感。路上我們可以聊聊剛才錄音時的小插曲，再想想下次見面要做什麼。'",
        "gal_map_text_202101787=阿米菈眼睛亮起來，語氣雀躍。",
        "gal_map_text_202101788=對呀，雖然累但成就感滿滿！和你一起錄音的每一個小細節都很有意思，路上我們慢慢聊，順便看看夜景，這種輕鬆收尾的感覺真好。'",
        "gal_map_text_202101789=今天的錄音體驗確實不錯，和你相處也很舒服。以後不用特意提前規劃，想見面了就約，有空就來這個‘據點’錄一段，沒空就隨便逛逛街、吃點東西，順其自然就挺開心的。'",
        "gal_map_text_202101790=阿米菈嘴角帶笑，語氣平和。",
        "gal_map_text_202101791=當下的相處體驗確實值得肯定，順其自然的模式也符合我的期待。不刻意、不勉強，在輕鬆的氛圍中慢慢瞭解彼此，是比較健康的關係發展方式。'",
        "gal_map_text_202101792=阿米菈雙手捂住臉，臉上帶點笑容。",
        "gal_map_text_202101793=從社交邏輯來看，無明確目標的互動模式雖短期體驗良好，但長期延續性需進一步觀察。建議保持開放心態，靈活調整約會節奏，專注當下的舒適感即可。'",
        "gal_map_text_202101794=阿米菈耳尖泛紅，聲音輕柔。",
        "gal_map_text_202101795=我也覺得今天很開心，和你一起錄音、聊天都很放鬆。順其自然挺好的，不用有壓力，以後想見面了我們就約，慢慢探索更多有意思的地方，創造更多輕鬆的回憶。'",
        "gal_map_text_202101796=阿米菈臉頰微紅，眼神溫柔。",
        "gal_map_text_202101797=對呀，今天真的太快樂了！我喜歡這種沒有壓力的相處，不用想太多，只要和你一起享受當下的美好就好，每一次見面都是驚喜，這樣就很滿足了。'",
        "gal_map_text_202101798=那我們現在就開啟‘巡迴演唱會’的預熱 —— 錄一段專屬約定，以後每次見面，都用它作為開場信號，好不好？'",
        "gal_map_text_202101799=阿米菈臉頰泛紅，用力點頭，對著手機輕聲說。",
        "gal_map_text_202101800=好…… 我先來！，第一站圓滿落幕，期待和你共赴每一場聲音之約。'",
        "gal_map_text_202101801=我特意準備了‘專輯錄製工具’，以後我們一人一支，隨時記錄日常的小聲響，攢夠一定數量，就一起整理成‘專輯’，怎麼樣？'",
        "gal_map_text_202101802=阿米菈立刻接過錄音筆，小心翼翼地放進包裡。",
        "gal_map_text_202101803=太好啦！我明天就開始記錄，把早餐的煎蛋聲、通勤的地鐵聲都錄下來，等見面和你分享，慢慢攢成我們的專屬回憶。'",
        "gal_map_text_202101804=我們把這張照片設成‘據點打卡封面’，每次來都拍一張合照，和錄音一起存檔，以後翻起來，就能看到我們的成長與陪伴。'",
        "gal_map_text_202101805=阿米菈立刻點頭，主動湊近你合拍。",
        "gal_map_text_202101806=好呀！我還要在照片背面標注錄音主題，讓每一次打卡都有專屬記憶點。以後我們的‘檔案館’，既有聲音，又有影像，太完整了。'",
        "gal_map_text_202101807=那以後有空就約出來吧，除了錄音，我們還可以試試雙人配音、劇本殺，都是能留下聲音回憶的體驗。'",
        "gal_map_text_202101808=阿米菈抬手輕輕拍了拍你的肩膀。",
        "gal_map_text_202101809=那我們現在去吃點東西，繼續享受今晚的快樂時光？'",
        "gal_map_text_202101810=那我們走河邊的小路回去吧，晚風涼快，人也少，聊起天來更舒服，還能緩解疲憊。'",
        "gal_map_text_202101811=阿米菈笑著跟上你，腳步輕快。",
        "gal_map_text_202101812=好呀！河邊的夜景肯定很美，和你一起散步、聊錄音的趣事，太愜意了。'",
        "gal_map_text_202101813=那我們現在去河邊散散步吧，吹吹晚風，再聊會兒天，那邊人少也安靜。'",
        "gal_map_text_202101814=阿米菈點頭回應，語氣輕快。",
        "gal_map_text_202101815=好呀！晚風這麼舒服，和你一起散步、聊聊錄音或者其他有意思的事，肯定很愜意。'",
        "gal_map_text_202101816=阿米菈挽著你的胳膊，兩人並肩走在商業街的霓虹裡，手裡的聲音明信片隨著腳步輕輕晃動，卡片摩擦的細碎聲響，與音符路燈的光影交織成浪漫的背景。",
        "gal_map_text_202101817=路過一家文創小店，你們進去挑選了同款聲音相框，把明信片嵌在裡面，做成了專屬的聲音信物。坐在街角的清吧裡，點了兩杯無酒精雞尾酒，戴上耳機一起重溫錄音裡的笑聲、輕聲的約定，偶爾抬頭對視，都會被對方眼底的笑意感染，悄悄紅了臉頰。",
        "gal_map_text_202101818=晚風裡，音符路燈的光芒溫柔籠罩著兩人，這份無需誓約的羈絆，早已在專屬聲音中深深紮根，而聲音承載的回憶，也讓這份關係多了幾分獨一無二的溫暖質感，正式宣告你們成為情侶。",
        "gal_map_text_202101819=就在你們準備轉身離開貓咪街燈，真正匯入夜色之前。",
        "gal_map_text_202101820=阿米菈忽然輕輕 '啊' 了一聲，拉住了你的手腕。",
        "gal_map_text_202101821=等一下！差點忘了……'",
        "gal_map_text_202101822=阿米菈有點不好意思地笑了笑，然後從自己那個毛絨絨的背包裡，小心地掏出一個用素色棉麻布包裹的、巴掌大小的扁平物件。",
        "gal_map_text_202101823=阿米菈將包裹放在你手中，指尖輕輕拂過布料，帶著一絲緊張的溫熱。",
        "gal_map_text_202101824=這是我提前準備的，本來想找個更自然的時機給你……'",
        "gal_map_text_202101825=我解開繫繩，裡面是一個定制的手工皮質零錢包 / 卡包。皮革是溫潤的植鞣革，觸感細膩，邊緣還帶著手工打磨的弧度。樣式簡潔大方，但最特別的是 —— 它的表面並非光滑，而是精心壓印著那晚你們共同製作的流體畫的紋理！",
        "gal_map_text_202101826=流體畫的色彩會變，但紋理是獨屬於我們的，就像和你一起的回憶一樣。'",
        "gal_map_text_202101827=阿米菈的聲音輕輕的，眼神卻很亮。",
        "gal_map_text_202101828=以後用它裝卡片或者零錢，就像我在陪著你一樣。'",
        "gal_map_text_202101829=我握緊那個帶著阿米菈溫度的卡包，皮革的質感與流體畫的記憶瞬間重疊。",
        "gal_map_text_202101830=這個禮物太特別了，我完全沒想到你會提前準備。每次摸到這個紋理，我都會想起我們一起補救顏料、討論配色的樣子，比任何紀念品都珍貴。'",
        "gal_map_text_202101831=你我順手將卡包放進貼身口袋，我手中還殘留著皮革的溫潤。",
        "gal_map_text_202101832=以後我每天都會帶著它，就像把我們的回憶揣在心裡。'",
        "gal_map_text_202101833=阿米菈沒有多說什麼，只是主動挽住你的胳膊，腳步輕快地跟著你走進夜色。",
        "gal_map_text_202101834=走吧，以後還有很多一起做手工的機會，我還要把更多我們的回憶，都‘拓印’下來呢。'",
        "gal_map_text_202101835=你們並肩走著，貓咪街燈的光暈在身後慢慢拉長，成為這段情侶關係最溫柔的注腳。",
        "gal_map_text_202101836=走到下一個路口，準備往不同方向的地鐵站走時，阿米菈忽然叫住你，然後低頭在自己的背包裡翻找了一會兒，嘴角帶著藏不住的笑意。",
        "gal_map_text_202101837=對了，這個給你！'",
        "gal_map_text_202101838=阿米菈拿出一個小巧的、羊毛氈戳制的迷你掛件，遞到你面前。",
        "gal_map_text_202101839=它不是店裡材料包做的，而是更精緻 —— 一個圓圓的、奶白色打底的小星球，上面用淡粉、淺藍的羊毛 '種' 了幾朵小小的絨球花，還用黑色羊毛戳了兩個豆豆眼和一個彎彎的微笑，像極了阿米菈笑起來的樣子。",
        "gal_map_text_202101840=星球背面，用幾乎看不見的黑色細線，工整地縫著今天的日期，針腳細密，能看出是花了心思的。",
        "gal_map_text_202101841=這是我偷偷回到店裡內，照著你教我方式製作的羊毛氈，特意縮小重做的。小星球代表‘毛球行星’，也代表…… 我們以後可以一起探索更多美好呀。'",
        "gal_map_text_202101842=你接過掛件，羊毛的觸感柔軟溫暖，還帶著阿米菈身上的淡淡清香，忍不住湊到鼻尖聞了聞。",
        "gal_map_text_202101843=太可愛了，和你一模一樣。這個日期縫得真精緻，你肯定花了不少時間吧？'",
        "gal_map_text_202101844=我立刻把掛件掛在鑰匙串上，輕輕晃動了一下。",
        "gal_map_text_202101845=以後我每次拿鑰匙，都會想起你戳羊毛氈時認真的樣子，還有我們一起補救歪耳朵的趣事。'",
        "gal_map_text_202101846=阿米菈看著你把掛件掛好，眼睛彎成了月牙。",
        "gal_map_text_202101847=這樣你每次拿鑰匙，就能想起今天的貓咪街燈和我們一起做手工的樣子啦。'",
        "gal_map_text_202101848=下次見面，我也給你帶個小禮物，是我照著你的羊毛氈小貓做的鑰匙扣，保證和你的小星球配成一對。'",
        "gal_map_text_202101849=你們手牽手走向地鐵，鑰匙串上的小星球輕輕晃動，像一顆小小的、承載著心意的星辰，宣告著你們正式成為情侶。",
        "gal_map_text_202101850=走到地鐵站入口，阿米菈停下腳步，臉上還帶著輕鬆的笑意，眼神明亮而純粹。",
        "gal_map_text_202101851=今天真的很開心，不管是戳羊毛氈還是做流體畫，和你一起都覺得特別有意思。'",
        "gal_map_text_202101852=阿米菈抬手理了理被風吹亂的頭髮，語氣自然又真誠。",
        "gal_map_text_202101853=其實從一起做手工的時候，我就覺得和你很合拍，現在…… 我想我們可以正式在一起試試。'",
        "gal_map_text_202101854=我也覺得和你相處很舒服，不管是討論配色還是補救小失誤，都不用刻意遷就，這種合拍的感覺很難得。我願意和你正式在一起，以後多創造些這樣開心的時光。'",
        "gal_map_text_202101855=阿米菈的笑容瞬間變得更燦爛了，像點亮了夜色裡的路燈。",
        "gal_map_text_202101856=那以後有空就約出來吧，不管是再去做手工，還是去吃你上次說的那家甜品店，都可以。'",
        "gal_map_text_202101857=好啊，我最近還發現一家做陶藝的工作室，和手工很像，下次我們一起去試試？我查過攻略，裡面的老師很專業，肯定不會讓你‘翻車’。'",
        "gal_map_text_202101858=阿米菈揮了揮手，轉身走進進站口，還回頭沖你比了個 '加油' 的手勢。",
        "gal_map_text_202101859=下次見啦，男朋友！'",
        "gal_map_text_202101860=沒有複雜的儀式，也沒有信物的交換，但彼此的心意已經明確。你們的情侶關係，就像今天的手工體驗一樣，簡單、純粹，卻充滿了輕鬆的快樂，在夜色中悄然開啟。",
        "gal_map_text_202101861=走出工作室，你們並肩走在商業街的人流中，手裡的手作被隨意放進紙袋，偶爾碰撞發出輕輕的聲響。",
        "gal_map_text_202101862=路過一家便利店，阿米菈拉著你進去買了兩支不同口味的霜淇淋，撕開包裝時，眼神裡還帶著做手工後的滿足笑意。",
        "gal_map_text_202101863=其實做手工最有意思的不是成品，是和你一起瞎琢磨的過程。'",
        "gal_map_text_202101864=阿米菈咬了一口草莓味霜淇淋，語氣輕快。",
        "gal_map_text_202101865=你幫我補救歪耳朵的時候，我還偷偷想，幸好有你，不然我的小貓就要變成‘歪脖星人’了。'",
        "gal_map_text_202101866=我反而覺得歪耳朵很可愛，是專屬你的風格。不過能幫你補救成功，我也挺有成就感的，比自己做好作品還開心。'",
        "gal_map_text_202101867=阿米菈也跟著笑起來，霜淇淋的甜膩混著晚風的清涼，氛圍格外愜意",
        "gal_map_text_202101868=走到地鐵站入口，阿米菈把沒吃完的霜淇淋扔進垃圾桶，轉頭對你揮揮手。",
        "gal_map_text_202101869=以後有空就約呀，不用特意提前準備手工，哪怕只是一起逛逛街、吃個霜淇淋也挺好。'",
        "gal_map_text_202101870=完全同意，下次我們可以不用規劃，走到哪算哪，路過有趣的店就進去看看，這樣更放鬆。'",
        "gal_map_text_202101871=看著阿米菈走進進站口，阿米菈還回頭沖你比了個'OK'的手勢，眼底的笑意明亮又純粹。這段關係沒有手作信物的綁定，卻有著基於輕鬆互動的自然好感，像一支簡單的霜淇淋，甜而不膩，在日常的陪伴中慢慢延續。",
        "gal_map_text_202101872=就在你們即將轉身離開復古路燈的光暈時，阿米菈忽然 '啊' 了一聲，急忙拉住了你的衣袖，眼底帶著一絲懊惱和不好意思。",
        "gal_map_text_202101873=等等！差點忘了最重要的東西……'",
        "gal_map_text_202101874=阿米菈抿嘴笑了笑，然後從自己隨身的斜挎包裡，小心地掏出一個用深藍色絲絨布袋裝著的、扁平的金屬盒子，布袋的觸感細膩柔軟。",
        "gal_map_text_202101875=阿米菈將盒子輕輕放在你手中，指尖無意識地劃過絲絨表面，能感受到阿米菈的些許緊張。",
        "gal_map_text_202101876=你打開盒子，裡面不是珠寶，而是一個定制的老式黃銅 '探香輪'。",
        "gal_map_text_202101877=它像一個精緻的懷錶，大小剛好能握在掌心，黃銅的色澤溫潤，帶著復古的質感，但表面是空白的金屬盤，沒有多餘的裝飾。",
        "gal_map_text_202101878=最特別的是，金屬盤上用鐳射蝕刻著你們今晚調製的 '星夜海岸' 香氣的完整配方公式 —— 檸檬醛、橙花醇、檀香醚…… 那些化學名稱和精確到小數點後兩位的比例，被排列成優雅的環形圖案，像某種神秘的星圖，又像香水的 '基因密碼'。",
        "gal_map_text_202101879=探香輪是調香師的工具，這個是我特意定制的，上面的配方是獨屬於我們的。'",
        "gal_map_text_202101880=阿米菈的聲音輕輕的，帶著一絲期待。",
        "gal_map_text_202101881=黃銅會隨著使用慢慢氧化，變得更有光澤，就像我們的關係一樣，會慢慢沉澱得更好。以後看到它，你就會想起我們一起調香的味道，想起今晚的路燈和晚風。'",
        "gal_map_text_202101882=我握緊探香輪，黃銅的涼意透過掌心傳來，卻能感受到背後阿米菈滿滿的心意，抬頭對阿米菈認真說。",
        "gal_map_text_202101883=這個禮物太用心了，我從來沒收到過這麼特別的東西。每次看到這個配方，我都會想起你糾結選精油時的樣子，還有我們一起試香時的驚喜，比任何昂貴的香水都珍貴。'",
        "gal_map_text_202101884=我會好好保管它，以後每次用的時候，都會想起今晚的約定。'",
        "gal_map_text_202101885=阿米菈主動牽住你的手，指尖相觸的瞬間，帶著淡淡的香水味。",
        "gal_map_text_202101886=走吧，以後我們可以一起調製更多專屬香味，把它們都‘刻’在心裡。'",
        "gal_map_text_202101887=好，下次我們試試以四季為主題調香，春天用花香，夏天用果香，把每個季節的回憶都做成專屬香氣，和這個探香輪一起收藏。'",
        "gal_map_text_202101888=復古路燈的光芒灑在你們相牽的手上，香氣與心意交織，正式宣告你們成為情侶，而這個獨特的探香輪，成為了這段關係最珍貴的見證。",
        "gal_map_text_202101889=走到下一個路口，準備往不同方向分別時，阿米菈從口袋裡拿出一個小小的、造型別致的噴霧分裝瓶，遞到你面前，臉上帶著甜甜的笑意。",
        "gal_map_text_202101890=瓶子是磨砂玻璃的，只有拇指大小，配著一個精緻的金屬噴頭，瓶身還刻著簡單的波浪紋，看起來很可愛。",
        "gal_map_text_202101891=給，這是你的‘移動香水庫’。'",
        "gal_map_text_202101892=我剛才在店裡，趁你去拿扭蛋的時候，偷偷分裝了一點我們一起調的香水進去。'",
        "gal_map_text_202101893=我接過瓶子，發現瓶身上貼著一張小小的、透明的手寫標籤，是阿米菈清秀的字跡：'備用鑰匙 - [今天的日期]'，旁邊還畫了一個小小的香味符號。",
        "gal_map_text_202101894=‘備用鑰匙’是說，這瓶香水是打開我心意的鑰匙呀。'",
        "gal_map_text_202101895=以後你想我的時候，就噴一點，就像我在你身邊一樣。'",
        "gal_map_text_202101896=磨砂玻璃的觸感微涼，裡面的香水卻仿佛承載著溫暖的心意。我輕輕按壓噴頭，熟悉的香氣彌漫開來，瞬間勾起了今天調香的所有回憶。",
        "gal_map_text_202101897=這個標籤太浪漫了，‘備用鑰匙’的寓意我懂。以後我每天出門都會噴一點，讓你的心意一直陪著我，走到哪裡都能想起我們一起調香的快樂。'",
        "gal_map_text_202101898=阿米菈看著你，眼神裡滿是期待，然後主動抱了抱你。",
        "gal_map_text_202101899=那我先走啦，男朋友，下次見！'",
        "gal_map_text_202101900=下次見面，我要給你一個驚喜，是我用我們的香水味，搭配了一款香薰蠟燭，以後我們可以一起在燭光下重溫這個味道。'",
        "gal_map_text_202101901=簡單的分裝瓶，卻裝滿了專屬的香氣與心意，宣告著你們情侶關係的開啟，也為未來的約會埋下了浪漫的伏筆。",
        "gal_map_text_202101902=走到街角的十字路口，阿米菈停下腳步，臉上帶著輕鬆愉悅的笑容，身上的香水味在晚風中輕輕飄散。",
        "gal_map_text_202101903=今天調香真的太有意思了，尤其是和你一起選精油、試比例，感覺時間過得特別快。'",
        "gal_map_text_202101904=阿米菈看著你，眼神真誠而直接。",
        "gal_map_text_202101905=我覺得我們很合拍，不管是對香味的喜好，還是相處的節奏，所以…… 我想和你正式在一起。'",
        "gal_map_text_202101906=我也早就有這個想法了。和你一起調香的時候，我就發現我們的喜好很契合，連對‘甜而不膩’的定義都一樣，這種默契很難得，我很想和你正式在一起，探索更多喜歡的香味。'",
        "gal_map_text_202101907=阿米菈的眼睛瞬間亮了起來，像盛滿了星光。",
        "gal_map_text_202101908=那以後我們可以一起去打卡更多香氛店，或者再去 DIY 其他味道的香水，甚至可以試試做香薰蠟燭，想想就覺得很有趣。'",
        "gal_map_text_202101909=我知道有家小眾香氛店，裡面有很多冷門香型，下次我們一起去試香，說不定能找到新的靈感，再一起調一款更特別的香水。'",
        "gal_map_text_202101910=阿米菈抬手看了看時間，有點不舍地說。",
        "gal_map_text_202101911=我該去趕地鐵了，下次我們提前約，去試試你說的那家帶香氛體驗的咖啡館吧？'",
        "gal_map_text_202101912=你們揮手告別，阿米菈轉身走向地鐵站，身影漸漸融入夜色。沒有信物的交換，但空氣中殘留的香水味和彼此的約定，已經明確了情侶的身份，這段關係像一款清新的前調香水，帶著輕鬆的快樂，在夜色中悄然綻放。",
        "gal_map_text_202101913=晚風帶著你們調的香水味，縈繞在彼此身邊。你們沒有刻意放慢腳步，只是隨意聊著天，從喜歡的香型聊到日常的通勤，話題輕鬆又無壓力。",
        "gal_map_text_202101914=路過一家奶茶店，阿米菈提議買杯奶茶再分開，你自然地答應。",
        "gal_map_text_202101915=其實香水不用天天噴，偶爾聞到這個味道，能想起今天的快樂就夠了。'",
        "gal_map_text_202101916=阿米菈捧著溫熱的珍珠奶茶，指尖蹭過杯壁的溫度。",
        "gal_map_text_202101917=以後我們不用總想著調新香水，有空就一起打卡網紅奶茶店，或者去公園散散步，這種不刻意的相處才最舒服。'",
        "gal_map_text_202101918=我完全同意，比起刻意規劃，我更喜歡這種自然的相處。下次我們可以去附近的公園散步，那裡晚上有晚風，還能聞到草木香，和我們的香水味肯定很搭。'",
        "gal_map_text_202101919=阿米菈喝了一口奶茶，眼睛彎成月牙。",
        "gal_map_text_202101920=下次見面不用提前做攻略，你隨便選個地方，我跟著你就行。'",
        "gal_map_text_202101921=走到地鐵口，阿米菈揮揮手轉身進站。",
        "gal_map_text_202101922=路上注意安全，到家記得告訴我一聲。下次我帶你去吃一家隱藏在巷子裡的甜品店，他們家的提拉米蘇，味道和我們香水的後調一樣，溫柔又綿長。'",
        "gal_map_text_202101923=奶茶的甜香與香水的餘韻交織，這段關係像一杯溫熱的奶茶，沒有專屬氣味的深刻羈絆，卻有著日常陪伴的溫暖愜意。",
        "gal_map_text_202101924=就在你們即將轉身離開音符街燈時，阿米菈忽然輕輕 '啊' 了一聲，急忙拉住了你的手腕，臉上帶著一絲懊惱的小表情。",
        "gal_map_text_202101925=等等…… 差點忘了這個重要的東西。'",
        "gal_map_text_202101926=阿米菈說著，從自己那個看起來總是能掏出驚喜的背包裡，小心地取出一個用黑色吸音棉材質包裹的、書本大小的扁平盒子，吸音棉的觸感柔軟粗糙，能很好地保護裡面的物品。",
        "gal_map_text_202101927=阿米菈將盒子輕輕放在你手中，指尖無意識地劃過包裹表面，眼神裡滿是期待。你打開盒子，裡面不是複雜的電子設備，而是一個定制的老式 '磁帶' 造型藍牙音箱。",
        "gal_map_text_202101928=它完美複刻了老式卡帶的外觀，但尺寸稍大一些，外殼是溫潤的深灰色磨砂金屬，觸感細膩，沒有指紋殘留。",
        "gal_map_text_202101929=正面的 '磁帶視窗' 是一塊黑色的液晶顯示幕，側面的 '播放鍵' 和 '音量旋鈕' 是真正的物理按鍵，轉動時還會發出輕微的 '哢噠' 聲，充滿復古感。",
        "gal_map_text_202101930=這是我特意定制的，裡面已經提前存好了我們那天錄的聲音明信片音訊。'",
        "gal_map_text_202101931=你連接藍牙就能播放，而且它還能錄音，以後我們每次見面，都可以錄一段新的聲音存進去，慢慢攢成我們的‘專屬聲音合集’。'",
        "gal_map_text_202101932=你看，開機之後，螢幕會顯示音訊的波形圖，就像我們的心意一樣，看得見也聽得見。'",
        "gal_map_text_202101933=我按下播放鍵，熟悉的笑聲和輕聲細語從音箱裡傳來，瞬間將你拉回錄音時的場景。",
        "gal_map_text_202101934=這個音箱也太有創意了，復古又實用。每次聽到裡面的聲音，我都會想起你模仿鯨魚叫時的可愛模樣，還有我們一起笑場的瞬間，比任何照片都有畫面感。'",
        "gal_map_text_202101935=我會把它放在床頭，每天睡前都聽一遍，就像你在我身邊講故事一樣。'",
        "gal_map_text_202101936=阿米菈主動牽住你的手，聲音裡滿是溫柔。",
        "gal_map_text_202101937=以後不管你在哪裡，想聽我的聲音了，打開它就好。'",
        "gal_map_text_202101938=好，下次見面我們錄一段睡前故事，存進音箱裡，以後不管誰出差，都能靠著這個聲音安心入睡。我們還要給每段錄音起名字，讓它變成我們的‘聲音日記’。'",
        "gal_map_text_202101939=音符路燈的光影落在你們身上，音箱裡的聲音輕輕流淌，你們的情侶關係，在專屬的聲韻與信物中正式確立，溫暖而堅定。",
        "gal_map_text_202101940=走到下一個路口，準備往不同方向走時，阿米菈從口袋裡拿出一個小巧的、金屬材質的 '復古麥克風' 造型 U 盤，遞到你面前，臉上帶著俏皮的笑意。",
        "gal_map_text_202101941=U 盤只有拇指大小，做工精緻，金屬網罩、開關按鈕的細節都惟妙惟肖，甚至還能看到 '麥克風線' 造型的掛繩孔，看起來又可愛又有質感。",
        "gal_map_text_202101942=給，這是你的‘音源備份’。我剛剛在店裡，用他們的設備把我們的‘聲音明信片’音訊檔拷貝到這裡面了，而且還多存了一段我偷偷錄的、沒讓你聽的 ASMR 輕語哦。'",
        "gal_map_text_202101943=我接過 U 盤，發現尾部的掛繩上，還系著一個非常小的、透明亞克力鑰匙扣，裡面封存著一小片印刷電路板，上面用極細的銀色線路，蝕刻著今天的日期和兩個抽象的聲波形圖案，一個像阿米菈的笑聲，一個像你的說話聲，巧妙又用心。",
        "gal_map_text_202101944=U 盤是‘麥克風’造型，代表我們的聲音約定。'",
        "gal_map_text_202101945=亞克力鑰匙扣裡的聲波形，是獨屬於我們的‘愛情密碼’。以後你把它插在電腦上，就能隨時聽到我們的聲音，想起今天的音符街燈和錄音時的快樂。'",
        "gal_map_text_202101946=這個‘愛情密碼’太特別了，我根本捨不得用，想一直珍藏著。不過為了聽你的 ASMR 輕語，我今晚就回家插電腦上，肯定能甜到睡著。'",
        "gal_map_text_202101947=下次見面，我要錄一段專屬你的起床鈴聲，存進這個 U 盤裡，以後每天都用它叫你起床。'",
        "gal_map_text_202101948=阿米菈看著你，眼睛彎成了月牙。",
        "gal_map_text_202101949=以後我們可以錄更多有趣的內容，比如一起讀詩、唱兒歌，都存在這個 U 卡裡，讓它成為我們的‘聲音時光機’。'",
        "gal_map_text_202101950=你們手牽手想著回家的方向走去，鑰匙串上的 '麥克風' U 盤輕輕晃動，像一顆小小的、會發聲的心意，見證著你們成為情侶的瞬間。",
        "gal_map_text_202101951=走到河邊的步道入口，晚風輕輕吹過，帶著淡淡的草木清香。阿米菈停下腳步，臉上帶著輕鬆愜意的笑容，眼神裡滿是愉悅。",
        "gal_map_text_202101952=今天的錄音體驗真的太特別了，尤其是和你一起模仿卡通人物、錄 ASMR，我好久沒這麼開心過了。'",
        "gal_map_text_202101953=阿米菈看著你，語氣自然又真誠。",
        "gal_map_text_202101954=其實從我們一起討論錄音內容的時候，我就覺得和你很合拍，現在…… 我想我們可以以情侶的身份，繼續探索更多有趣的聲音呀。'",
        "gal_map_text_202101955=我也覺得和你合拍得不可思議，不管是我拋的梗你都能接住，還是我們對錄音風格的喜好都一樣，這種感覺太舒服了。我很想和你正式在一起，以後一起解鎖更多聲音相關的體驗。'",
        "gal_map_text_202101956=阿米菈的笑容瞬間變得更燦爛了，像被風吹動的音符，充滿活力。",
        "gal_map_text_202101957=那以後我們可以去體驗雙人配音課，或者去公園錄自然的聲音，甚至可以一起做一個屬於我們的小播客，想想就覺得很有意思。",
        "gal_map_text_202101958=我知道一家專業的錄音棚，裡面有各種有趣的音效設備，下次我們一起去體驗，錄一段屬於我們的迷你廣播劇，肯定會很有紀念意義。'",
        "gal_map_text_202101959=阿米菈看了看天色，笑著說。",
        "gal_map_text_202101960=時間不早啦，我該回家了，下次我們約著去你說的那家錄音棚體驗吧？'",
        "gal_map_text_202101961=你們並肩走了一段，然後在路口揮手告別。但彼此對聲音的共同熱愛和輕鬆的相處氛圍，已經讓情侶關係水到渠成。這段關係，就像一段愉快的錄音，簡單、純粹，卻充滿了讓人回味的美好。",
        "gal_map_text_202101962=手裡的聲音明信片被阿米菈隨意塞進手機殼背面，露出一角卡通圖案。你們沿著河邊步道慢慢走，晚風帶著草木清香，偶爾能聽到遠處傳來的笑聲，和錄音裡的歡樂形成奇妙呼應。",
        "gal_map_text_202101963=其實錄音最有趣的不是保存下來，是當時忍不住笑場的瞬間。'",
        "gal_map_text_202101964=阿米菈拿出手機，翻出錄音片段快速聽了一句，自己先笑出了聲。",
        "gal_map_text_202101965=你模仿恐龍咆哮的時候，聲音都破音了，我當時差點憋不住笑，還好忍住了。'",
        "gal_map_text_202101966=還說我呢，你模仿撒嬌顧客的時候，聲音甜得發膩，我差點沒忍住笑場，硬憋回去的樣子肯定很搞笑。'",
        "gal_map_text_202101967=步道上的路燈把兩人的影子拉得很長，氛圍輕鬆又愜意。",
        "gal_map_text_202101968=走到路口，阿米菈停下腳步。",
        "gal_map_text_202101969=以後不用特意錄專屬聲音，想見面了就發消息，我們可以一起去吃火鍋、看電影，或者就像現在這樣隨便散散步，聊聊天。'",
        "gal_map_text_202101970=我也是這麼想的，比起刻意製造回憶，我更喜歡這種自然的相處。下次我們可以去看一場喜劇電影，看完之後去吃燒烤，邊吃邊聊電影裡的搞笑片段，肯定和今天錄音一樣開心。'",
        "gal_map_text_202101971=阿米菈揮揮手轉身走向馬路對面，手機殼背面的聲音明信片在燈光下隱約可見。",
        "gal_map_text_202101972=這段關係沒有聲音信物的綁定，卻有著基於共同快樂回憶的自然延續，像一場未完待續的輕鬆聊天，在日常的煙火氣中慢慢推進。",
        "gal_map_text_206100001=陽光明媚的午後，繁華商業街的標誌性鐘樓下，鎏金般的陽光鋪灑在石板路上，櫥窗反射著粼粼光影，街頭音樂輕快悠揚。",
        "gal_map_text_206100002=你和敖靈如期而遇，她裙擺隨步伐微微搖曳，氣質清冷如高嶺之花，卻在與你對視時，眼底掠過一絲不易察覺的柔和。",
        "gal_map_text_206100003=短暫寒暄後，你們並肩走入人流，她指尖輕搭包帶，目光平視前方，語氣清淡卻藏著期待。",
        "gal_map_text_206100004=商業街人流湧動卻不擁擠，空氣中夾雜著淡淡的香水味和街邊甜品店的甜香，櫥窗裡的陳設錯落有致，遠處的店鋪招牌在陽光下泛著暖光。",
        "gal_map_text_206100005=今天天氣剛好，商業街比平時更熱鬧些，你平時會喜歡來這邊嗎？",
        "gal_map_text_206100006=偶爾會來買些書，這裡的氛圍不算嘈雜。你應該已經想好要去的地方了吧？",
        "gal_map_text_206100007=你深知敖靈外冷內熱，既偏愛契合心性的場景，又渴望能有靈魂共鳴的互動。三個地點各有側重，選擇既要貼合她 '高嶺之花' 的氣質，又要為 '知音' 般的默契埋下伏筆 —— 你的選擇將直接決定她的回應方式。",
        "gal_map_text_206100008=「貓嶼」咖啡書店",
        "gal_map_text_206100009=「異度迷城」密室",
        "gal_map_text_206100010=「食客尋味」市集",
        "gal_map_text_206100011=那裡的靜謐配得上你的書卷氣，或許能找到你鍾愛的絕版詩集。",
        "gal_map_text_206100012=抬手整理耳邊碎發，指尖帶著笑意，身體不自覺向書店方向傾斜",
        "gal_map_text_206100013=「貓嶼」的古籍區我一直想去，聽說最近到了一批私藏本。",
        "gal_map_text_206100014=主動拉了拉你的衣袖，動作輕快卻不失分寸，眼底滿是雀躍，呼吸都帶著一絲急促",
        "gal_map_text_206100015=立刻停下腳步轉向你，嘴角揚起明顯弧度：'真的嗎？我找那本詩集好久了！我們現在就過去吧？",
        "gal_map_text_206100016=（目光轉向書店方向，指尖輕輕摩挲包帶，神色清冷卻不抗拒，腳步自然往前行進",
        "gal_map_text_206100017=安靜的地方挺好，不會打亂思緒。",
        "gal_map_text_206100018=雙手依舊插在口袋裡，卻放慢步伐等你，清冷中透著默許，沒有多餘表情卻未偏離方向",
        "gal_map_text_206100019=嗯，只要不吵鬧就行。",
        "gal_map_text_206100020=解謎需心意相通，想試無需多言的默契。",
        "gal_map_text_206100021=指尖輕輕拍了下你的胳膊，語氣雀躍，身體跟著節奏微微晃動。",
        "gal_map_text_206100022=密室呀！我之前看朋友玩過，據說邏輯題超有意思～",
        "gal_map_text_206100023=裙擺隨著奔跑的動作飛揚，眼底閃爍著興奮的光芒，語氣急促卻充滿期待。",
        "gal_map_text_206100024=哇！我早就想試這家密室了！聽說有星空主題的！快走快走！",
        "gal_map_text_206100025=指尖輕輕搭在包帶上，眼神專注地看著你，神色沉穩卻藏著好奇",
        "gal_map_text_206100026=先別急，密室規則和難度大概是什麼樣？有沒有需要注意的禁忌？",
        "gal_map_text_206100027=在你解釋時微微頷首時，指尖輕輕敲擊掌心，暗自記下關鍵資訊",
        "gal_map_text_206100028=邏輯謎題我可以試試，但如果有恐怖元素，需要提前告知。",
        "gal_map_text_206100029=煙火氣藏生活真味，共探未知風味",
        "gal_map_text_206100030=指尖指向遠處的指示牌，觀察細緻，語氣帶著認可，腳步沒有停頓",
        "gal_map_text_206100031=市集人多但攤位規整，應該不會太雜亂。",
        "gal_map_text_206100032=指尖輕輕點了點太陽穴，觀察入微，甚至注意到你沒提及的細節，嘴角露出一絲淺笑",
        "gal_map_text_206100033=我看到有小眾食材攤位，還有無辣標識，考慮得挺周全",
        "gal_map_text_206100034=眼神有些茫然地跟著你的目光，反應慢了半拍，指尖輕輕撓了撓臉頰，帶著一絲不確定",
        "gal_map_text_206100035=市集呀…… 聽起來人會很多？",
        "gal_map_text_206100036=語氣平淡，沒有明顯情緒，直到你邁步才跟上腳步，注意力還在周圍的景物上",
        "gal_map_text_206100037=哦，只要有能吃的就行。",
        "gal_map_text_206100038=我提前問過店員，那本詩集剛好在架，我們慢慢走，不著急。",
        "gal_map_text_206100039=謝謝你記得我提過的話。",
        "gal_map_text_206100040=腳步放緩，偶爾會和你聊起喜歡的作家，清冷語氣中多了幾分鬆弛，指尖不再緊繃地攥著包帶",
        "gal_map_text_206100041=密室燈光不會太暗，謎題側重邏輯而非恐怖，你要是覺得不適我們隨時可以暫停，店員也會全程關注。",
        "gal_map_text_206100042=微微頷首，指尖鬆開攥緊的包帶",
        "gal_map_text_206100043=邏輯謎題我還挺感興趣的，那就試試吧。",
        "gal_map_text_206100044=市集有不少小眾攤位，還有無辣選項，不會讓你覺得為難。我們可以慢慢逛，遇到喜歡的再停下來，不著急趕時間。",
        "gal_map_text_206100045=也好，偶爾體驗下煙火氣也不錯。",
        "gal_map_text_206100046=語氣依舊清淡，卻沒有拒絕的意思，腳步逐漸加快，目光開始留意沿途的攤位",
        "gal_map_text_206100047=你們朝著選定的方向走去，陽光透過樹葉在地面投下斑駁光影。她走在你身側半步，偶爾回應你提起的話題 —— 選擇咖啡書店的她多了幾分書卷氣的鬆弛，選擇密室的她藏著對未知的好奇，選擇市集的她漸漸融入煙火氣。",
        "gal_map_text_206100048=高嶺之花的清冷氣質中，都透出一絲對接下來相處的期待，這場充滿攻防感的約會正式拉開序幕。",
        "gal_map_text_206100049=你們推開「貓嶼」的木質大門，濃郁的咖啡香與紙張的油墨味交織撲面而來。敖靈徑直走向臨窗卡座，將隨身的精裝書放在桌角，點了一杯無糖拿鐵後正低頭整理物品。",
        "gal_map_text_206100050=就在這時，一隻好奇心旺盛的白色小貓悄悄溜到桌旁，爪子試探性地扒拉著她的書本，她伸手去拿咖啡杯時，手肘不經意碰到手提包，鋼筆、便簽本和小巧的皮質書簽瞬間散落一地。",
        "gal_map_text_206100051=暖黃色燈光透過百葉窗斜射在淺棕色亞麻桌布上，投下條紋光斑，桌面擺放著小巧的綠植盆栽。",
        "gal_map_text_206100052=周圍客人輕聲交談，只有翻書聲和咖啡機的輕微嗡鳴，白色小貓歪著頭盯著地上的書簽，粉色鼻尖輕輕抽動，氛圍靜謐卻因突發狀況多了一絲緊張。",
        "gal_map_text_206100053=別急，我來收拾，你坐著別動，小心被小貓碰到。",
        "gal_map_text_206100054=麻煩你了，這只貓突然跑過來，我都沒注意包沒關好。",
        "gal_map_text_206100055=你看著敖靈既想保護書本又不忍驅趕小貓的模樣，深知此刻既要穩妥處理突發狀況，又要照顧到她愛書的心思和對小動物的柔軟 —— 這是拉近距離、展現高情商的關鍵，也是這場約會攻防戰的第一個重要節點，你的選擇將直接影響她的好感度走向。",
        "gal_map_text_206100056=輕聲引貓 + 溫柔拾物",
        "gal_map_text_206100057=快速拾物 + 呼叫店員",
        "gal_map_text_206100058=直接抱貓 + 快速整理",
        "gal_map_text_206100059=我用書簽引它到沙發，你護好書本，我慢慢撿。",
        "gal_map_text_206100060=敖靈眼睛一亮，立刻點頭。身體往後退了退，給你留出充足空間，指尖輕輕點了點沙發扶手，示意你引貓過去。",
        "gal_map_text_206100061=這個辦法好！既不嚇到小貓，也能保護書本。",
        "gal_map_text_206100062=語氣乾脆，指尖捏著書簽輕輕晃動，主動配合你的動作，眼底帶著俐落，身體微微前傾做好準備",
        "gal_map_text_206100063=我來幫你引它！你專心撿東西，咱們分工合作。",
        "gal_map_text_206100064=身體微微側向你，方便你行動，目光帶著感激，指尖悄悄將桌角的咖啡杯往內側挪了挪，避免被碰到",
        "gal_map_text_206100065=這樣會不會太麻煩你？小貓看起來也沒有惡意。",
        "gal_map_text_206100066=語氣帶著一絲客氣，卻在你彎腰拾物時，悄悄用腳擋住了滾向遠處的便簽本，動作隱晦且貼心。",
        "gal_map_text_206100067=其實…… 我可以慢慢等它自己走開的，不用特意為我費心。",
        "gal_map_text_206100068=來，小傢伙，跟我到這邊來，這裡有更好玩的。",
        "gal_map_text_206100069=你對小動物好有耐心，剛才我都沒想到可以這樣。謝謝你，沒讓我的東西弄髒，也沒嚇到小貓。",
        "gal_map_text_206100070=看著你輕柔引導小貓的模樣，眼神柔和了許多，耳尖的紅暈未散。",
        "gal_map_text_206100071=先收好物品，呼叫店員安置小貓，不耽誤你看書。",
        "gal_map_text_206100072=抬手將散落的書簽先攏到一起，方便你後續整理，語氣帶著感激，眼神裡滿是認可。",
        "gal_map_text_206100073=這樣既穩妥又貼心，店員肯定有專門安置小貓的地方。",
        "gal_map_text_206100074=立刻起身，語氣帶著關切。",
        "gal_map_text_206100075=我去叫店員更快！你在這裡看好書本和東西，別讓小貓搗亂。小心別碰到地上的鋼筆尖，別劃傷手。",
        "gal_map_text_206100076=雙手放在膝蓋上，目光跟著你移動，神色平靜卻專注，在你拾物時留意著小貓的動向，避免它突然搗亂。",
        "gal_map_text_206100077=可以，這樣不會浪費太多時間。",
        "gal_map_text_206100078=在你收拾物品時，主動用手掌護住了桌角的精裝書，防止小貓突然撲過來，動作清冷卻貼心，沒有多餘的言語。",
        "gal_map_text_206100079=麻煩了。",
        "gal_map_text_206100080=你看好這些東西，我去叫店員把小貓帶到專門的寵物區，這樣你也能安心看書。",
        "gal_map_text_206100081=喝點水吧，剛才跑太快了。",
        "gal_map_text_206100082=看著你忙碌的身影，眼神柔和了幾分，等你回來時主動遞過一杯溫水。語氣依舊清淡，卻帶著不易察覺的關心，手指觸碰杯壁時特意確認了水溫",
        "gal_map_text_206100083=我抱走小貓，你趁機收拾更高效。",
        "gal_map_text_206100084=腳尖輕輕踮起，語氣輕快，眼神裡滿是期待，既擔心你又覺得有趣",
        "gal_map_text_206100085=哇，你膽子挺大呀！它看起來挺活潑的，小心別被它抓傷～",
        "gal_map_text_206100086=手指微微繃緊，眼神專注，主動上前半步做好配合的準備，語氣急促卻充滿信任",
        "gal_map_text_206100087=我來按住它的爪子！你趁機抱走，這樣更安全。",
        "gal_map_text_206100088=伸手輕輕按住小貓的後背，動作輕柔卻穩定，眼神專注地觀察小貓的反應，神色沉穩。",
        "gal_map_text_206100089=別急，先觀察下它的情緒，避免被它反抗抓傷。",
        "gal_map_text_206100090=語氣沒有起伏，卻精准指出關鍵動作，目光專注地盯著小貓，隨時準備應對突發情況。",
        "gal_map_text_206100091=抱的時候托住它的腹部，別拽尾巴，它不會輕易反抗。",
        "gal_map_text_206100092=搞定，這樣既不耽誤時間，也不會讓書受損。",
        "gal_map_text_206100093=沒想到你這麼果斷，還挺會照顧小動物的。",
        "gal_map_text_206100094=接過整理好的物品，輕聲道謝，指尖摩挲著鋼筆，語氣比之前柔和了許多。",
        "gal_map_text_206100095=小貓被妥善安置後，桌面恢復了整潔。敖靈將精裝書輕輕放在桌角，指尖摩挲著書脊，眼神裡的慌亂漸漸褪去，取而代之的是一絲安心與信賴。",
        "gal_map_text_206100096=敖靈抬頭看向你，嘴角勾起一抹淺淺的弧度，高嶺之花的清冷氣質中多了幾分柔和：'剛才真的謝謝你，要不是你，我都不知道該怎麼辦才好。'",
        "gal_map_text_206100097=陽光透過窗戶落在她的發梢，鍍上一層溫暖的光暈，你們之間的氛圍悄然變得親近，好感度在不經意的互動中穩步提升，為下一階段的相處埋下了更好的伏筆。",
        "gal_map_text_206100098=你們跟隨工作人員走入昏暗的接待區，空氣中彌漫著淡淡的舊木頭和熏香氣息。工作人員將你們帶到密室入口。",
        "gal_map_text_206100099=身著復古服飾的 NPC 上前說明規則：'本次主題僅有一次嘗試機會，若未能在規定時間內解開謎題，需要接受‘懲罰’—— 在黑暗中合作完成一道額外的默契考驗。'",
        "gal_map_text_206100100=敖靈聞言，指尖輕輕攥緊了包帶，眼神裡閃過一絲警惕。",
        "gal_map_text_206100101=別擔心，懲罰聽起來更像互動遊戲，不是恐怖類型。如果中途覺得不適，我們可以隨時示意工作人員暫停。",
        "gal_map_text_206100102=我不害怕黑暗，只是討厭毫無準備的未知。邏輯謎題我可以應對，但需要我們配合默契，你擅長觀察還是推理？",
        "gal_map_text_206100103=NPC 已經打開了密室大門，裡面傳來輕微的機關轉動聲。敖靈看似沉穩，實則對 '失敗懲罰' 有著隱秘的抵觸，此刻需要既展現自己的能力，又給予她足夠的安全感，讓她相信你們的默契足以應對挑戰 —— 你的選擇將決定她是否願意完全信任你。",
        "gal_map_text_206100104=分工協作 + 主導推理",
        "gal_map_text_206100105=詢問偏好 + 靈活配合",
        "gal_map_text_206100106=主動承擔 + 承諾兜底",
        "gal_map_text_206100107=你負責觀察細節，我來梳理邏輯，我們互補。",
        "gal_map_text_206100108=指尖輕輕按在門框上，身體微微前傾，已經進入觀察狀態，語氣自信",
        "gal_map_text_206100109=沒問題，我對細節很敏感，符號和痕跡都逃不過我的眼睛。",
        "gal_map_text_206100110=敖靈腳步輕快卻不慌亂，目光快速掃視四周，瞬間捕捉到關鍵資訊，語氣帶著掌控感",
        "gal_map_text_206100111=我已經看到門後牆上有星圖標記，你負責推導規律，我來找隱藏線索。",
        "gal_map_text_206100112=眼神有些茫然地環顧四周，指尖輕輕撓了撓臉頰，帶著一絲不確定，卻努力集中注意力",
        "gal_map_text_206100113=觀察細節嗎？我…… 我儘量留意周圍的東西。",
        "gal_map_text_206100114=語氣平淡，只注意到最顯眼的物體，沒有主動尋找線索的意識，卻乖乖跟在你身邊",
        "gal_map_text_206100115=哦，我看到有很多鏡子，還有踏板。",
        "gal_map_text_206100116=就知道你觀察力超強，我剛才也注意到星圖，等下我們先匯總線索再推導。",
        "gal_map_text_206100117=好，我會把看到的都告訴你。你放心，細節方面我不會出錯，不會拖你後腿。",
        "gal_map_text_206100118=敖靈耳尖微紅，卻沒有避開你的眼神觸碰。轉身時指尖不經意碰到你的手背，快速收回卻帶著溫度",
        "gal_map_text_206100119=你更擅長哪部分？我配合你的節奏。",
        "gal_map_text_206100120=指尖輕輕拍了下你的肩膀，帶著信賴的笑意，腳步不自覺向你靠近半步",
        "gal_map_text_206100121=我擅長找隱藏線索！你負責推理，我們肯定能很快解開謎題～",
        "gal_map_text_206100122=敖靈立刻拉住你的手腕往裡走。裙擺隨著動作輕輕晃動，眼底滿是雀躍，語氣裡充滿對合作的期待。",
        "gal_map_text_206100123=我超會找機關！之前玩密室都是我找線索隊友推理，我們絕對默契滿分！",
        "gal_map_text_206100124=敖靈目光轉向密室內部，神色專注卻不疏離，指尖輕輕敲擊掌心，已經開始思考可能的謎題類型",
        "gal_map_text_206100125=我擅長邏輯推理，你負責收集線索即可。",
        "gal_map_text_206100126=敖靈主動站在你身側，目光掃過四周，看似隨意卻在默默留意線索，用行動配合你",
        "gal_map_text_206100127=隨便，我都可以。",
        "gal_map_text_206100128=那我們就按你擅長的來，你找線索時注意安全，別碰尖銳的東西。",
        "gal_map_text_206100129=嗯，我會注意的。謝謝你願意配合我，其實…… 和你一起合作感覺還挺安心的。",
        "gal_map_text_206100130=敖靈輕輕點頭，語氣比之前柔和。轉頭看了你一眼，眼底帶著一絲不易察覺的感激",
        "gal_map_text_206100131=放心交給我，失敗我來扛懲罰",
        "gal_map_text_206100132=敖靈腳尖輕輕踮起，眼神裡滿是信任，沒有絲毫擔心失敗的模樣",
        "gal_map_text_206100133=哇，你好有擔當！那我就放心啦，專心找線索就好～",
        "gal_map_text_206100134=敖靈立刻拉著你往密室深處走。裙擺飛揚，眼底閃爍著興奮的光芒，完全信任你的能力，主動配合你的節奏",
        "gal_map_text_206100135=有你在我什麼都不怕！我們趕緊找線索，爭取一次通過，不用接受懲罰～",
        "gal_map_text_206100136=敖靈指尖輕輕攥著你的胳膊，帶著堅定的神色，既不依賴也不逞強",
        "gal_map_text_206100137=懲罰未必是壞事，但我們還是儘量一次通過。我會盡力找線索，不會讓你一個人承擔。",
        "gal_map_text_206100138=敖靈語氣沒有起伏，卻在走入密室後，主動承擔起觀察四周的任務，用行動證明自己不會拖後腿，神色專注而認真。",
        "gal_map_text_206100139=我的字典裡沒有失敗。",
        "gal_map_text_206100140=有你一起，我也有信心一次通過。我們一起努力，就算真的遇到意外，我也會保護好你，不會讓你覺得為難。",
        "gal_map_text_206100141=嗯。",
        "gal_map_text_206100142=敖靈耳尖微紅，眼神閃爍了一下。沒有多說什麼，卻在後續的行動中，主動與你分享發現的線索，配合變得愈發默契，清冷的氣質中多了一絲溫度",
        "gal_map_text_206100143=你們並肩走入密室深處，機關轉動的聲音在黑暗中格外清晰。敖靈的緊張漸漸褪去，取而代之的是專注與信賴，她會主動與你分享線索，甚至在你思考時輕輕提醒關鍵細節。",
        "gal_map_text_206100144=你們的腳步配合默契，眼神偶爾交匯時，能看到彼此眼底的認真與一絲不易察覺的曖昧。",
        "gal_map_text_206100145=這場看似考驗默契的密室挑戰，悄然拉近了你們的距離，好感度在並肩作戰中穩步提升，為接下來的互動埋下了更深的羈絆。",
        "gal_map_text_206100146=你們站在「食客尋味」市集流光溢彩的入口，各種食物的香氣撲面而來，烤肉的焦香、甜品的甜香、香料的辛香交織在一起，令人食指大動。",
        "gal_map_text_206100147=敖靈看著眼前鱗次櫛比的攤位和眼花繚亂的美食，臉上露出了既興奮又有點選擇困難的笑容，指尖輕輕撓了撓臉頰，眼神裡滿是糾結。",
        "gal_map_text_206100148=市集入口掛滿了彩色燈籠和串燈，光影流轉間照亮了各個攤位的招牌。攤位前人頭攢動卻秩序井然，攤主們熱情地吆喝著，展示著自家的特色美食。",
        "gal_map_text_206100149=空氣中彌漫著濃郁的食物香氣，遠處傳來輕快的民俗音樂，煙火氣十足卻不雜亂。",
        "gal_map_text_206100150=這裡的美食確實很多，容易挑花眼。你平時喜歡吃甜口還是鹹口？有沒有忌口的食材？",
        "gal_map_text_206100151=我其實都挺喜歡的，甜口鹹口都不排斥，就是太多選擇了，不知道從哪開始嘗試。",
        "gal_map_text_206100152=你看著她眼底閃爍的期待與一絲顧慮，深知她既想體驗新鮮風味，又擔心嘗試未知食材的風險。作為高情商的男主，此刻需要既幫她化解選擇困難，又照顧到她的口味偏好，同時創造自然的親近機會 —— 你的選擇將直接讓她感受到你的細心與體貼。",
        "gal_map_text_206100153=篩選推薦 + 試吃分擔",
        "gal_map_text_206100154=鎖定偏好 + 精准推薦",
        "gal_map_text_206100155=主動試吃 + 替她排雷",
        "gal_map_text_206100156=我選 3 款小眾不踩雷的，我們分著嘗。",
        "gal_map_text_206100157=敖靈輕輕拍了下你的胳膊，語氣乾脆俐落，腳步不自覺向你靠近半步，眼底滿是認可。",
        "gal_map_text_206100158=這個主意好！分著嘗能吃到更多種類，還不怕浪費。",
        "gal_map_text_206100159=敖靈拉著你的手腕走向攤位。裙擺隨著動作輕輕晃動，語氣急促卻充滿期待，主動規劃路線，完全信任你的選擇",
        "gal_map_text_206100160=那我們趕緊去！我看到前面有手工霜淇淋和烤肉，先從這兩個開始怎麼樣？",
        "gal_map_text_206100161=敖靈身體微微側向你，目光帶著感激，指尖悄悄整理了一下裙擺，帶著一絲不好意思",
        "gal_map_text_206100162=這樣會不會太麻煩你？還要特意為我篩選，我其實隨便吃點也可以。",
        "gal_map_text_206100163=敖靈語氣帶著一絲客氣，卻在你走向攤位時默默跟上，腳步輕快了許多，顯然內心充滿期待",
        "gal_map_text_206100164=其實…… 我吃什麼都可以，不用特意為我費心挑選的。",
        "gal_map_text_206100165=就知道你會喜歡，我剛才已經留意了幾個口碑好的攤位，都是小眾但不踩雷的。等下我們先買手工霜淇淋，你選口味，我來買單，然後再去嘗烤肉，分著吃剛好能嘗到兩種風味。",
        "gal_map_text_206100166=好，聽你的安排。謝謝你這麼細心，還特意為我篩選，其實…… 和你一起分著吃東西，感覺還挺特別的。",
        "gal_map_text_206100167=轉身時指尖不經意碰到你的手腕，快速收回卻帶著溫度。",
        "gal_map_text_206100168=看你盯甜品攤很久，先從甜口開始",
        "gal_map_text_206100169=敖靈眼神閃過一絲驚訝，立刻點頭。手指指向甜品攤的方向，語氣帶著一絲驚喜，沒想到被你精准察覺，眼底滿是笑意",
        "gal_map_text_206100170=你居然看出來了！我剛才確實一直在留意甜品攤，想試試手工馬卡龍。",
        "gal_map_text_206100171=敖靈腳步輕快卻不慌亂，目光快速掃視甜品櫃，瞬間鎖定目標，語氣帶著掌控感，顯然早就有了心儀的選擇",
        "gal_map_text_206100172=我還看中了他們家的星空慕斯，看起來顏值超高，味道肯定也不錯。",
        "gal_map_text_206100173=眼神有些茫然地看向甜品攤，指尖輕輕撓了撓臉頰，帶著一絲不確定，卻努力回想自己剛才的目光落點",
        "gal_map_text_206100174=啊？我剛才有盯甜品攤嗎？可能是覺得看起來挺好看的吧。",
        "gal_map_text_206100175=敖靈語氣平淡，沒有意識到你觀察到了她的偏好，卻乖乖跟在你身邊，看著甜品櫃時眼神亮了一下",
        "gal_map_text_206100176=甜品嗎？看起來挺甜的，應該會好吃吧。",
        "gal_map_text_206100177=我剛才看到你好幾次看向甜品攤，眼神都亮了，就知道你對甜口感興趣。",
        "gal_map_text_206100178=謝謝你這麼留意我，我自己都沒發現剛才看了那麼多次。味道真的很不錯，甜度剛好，你也嘗嘗？",
        "gal_map_text_206100179=敖靈輕輕咬了一口，眼底露出滿足的笑容。抬手將馬卡龍遞到你嘴邊，眼神帶著期待，動作自然親密",
        "gal_map_text_206100180=我先嘗所有新品，好吃再給你。",
        "gal_map_text_206100181=敖靈眼神裡滿是信任，完全依賴你的判斷，嘴角帶著甜甜的笑容。",
        "gal_map_text_206100182=哇，你好貼心！有你替我排雷，我就放心啦，不用害怕吃到奇怪的味道了。",
        "gal_map_text_206100183=敖靈立刻拉著你走向各個攤位。裙擺飛揚，眼底閃爍著興奮的光芒，既期待又好奇，完全信任你的試吃判斷。",
        "gal_map_text_206100184=那我們趕緊去！我看到前面有怪味霜淇淋和辣椒巧克力，你先嘗嘗，好吃我再吃～",
        "gal_map_text_206100185=敖靈輕輕攥著你的胳膊，帶著堅定的神色，既不想讓你辛苦，又想和你一起體驗，語氣認真。",
        "gal_map_text_206100186=不用這麼麻煩，我們可以一起嘗試，遇到不好吃的就放下，不用特意為我試吃。",
        "gal_map_text_206100187=敖靈語氣沒有起伏，卻在你試吃霜淇淋時悄悄觀察你的表情，眼神專注，顯然還是在意你的判斷。",
        "gal_map_text_206100188=不用特意替我排雷，我可以自己嘗試，就算不好吃也沒關係。",
        "gal_map_text_206100189=沒事，我來試吃剛好，你平時肯定很少嘗試這些奇特的食材，我替你排雷，你就能吃到好吃的了。",
        "gal_map_text_206100190=謝謝你，其實你不用這麼辛苦的。其實…… 就算吃到不好吃的，和你一起體驗，好像也挺有意思的。",
        "gal_map_text_206100191=敖靈看著你誇張的表情，忍不住笑了出來，清冷的氣質瞬間柔和了許多",
        "gal_map_text_206100192=你們在各個攤位間穿梭，分著嘗遍了各種美食，從手工霜淇淋到烤肉，再到小眾甜品，每一種風味都成為彼此靠近的契機。",
        "gal_map_text_206100193=敖靈的笑容越來越多，清冷的氣質漸漸被煙火氣融化，偶爾會主動為你遞上食物，指尖不經意的觸碰帶著曖昧的溫度。",
        "gal_map_text_206100194=夕陽的餘暉灑在她的發梢，鍍上一層溫暖的光暈，你們之間的氛圍愈發親近，好感度在分享美食的互動中穩步提升，為下一階段的親密相處奠定了堅實的基礎。",
        "gal_map_text_206100195=小貓被引到沙發後仍心有不甘，輕盈一躍跳到你們身前的矮茶几上，毛茸茸的尾巴高高翹起，像充滿好奇的探測器，直接掃向敖靈那杯喝了一半、還冒著熱氣的咖啡。咖啡杯微微晃動，熱氣順著杯沿氤氳而上，眼看就要灑出來。",
        "gal_map_text_206100196=暖黃色燈光依舊柔和，矮茶几上的綠植盆栽被小貓碰得輕輕晃動，咖啡杯裡的液體隨著尾巴的掃動泛起漣漪，熱氣模糊了周圍的光影。",
        "gal_map_text_206100197=周圍客人的交談聲依舊輕柔，只有小貓的尾巴掃過桌面的輕微聲響，氣氛瞬間變得緊張。",
        "gal_map_text_206100198=小心！這杯咖啡還挺燙的，別灑到你身上。",
        "gal_map_text_206100199=謝謝你反應這麼快！這小貓也太調皮了，居然還惦記著我的咖啡。",
        "gal_map_text_206100200=小貓還在茶几上打轉，尾巴時不時掃過杯沿，咖啡杯依舊有傾倒的風險。你知道敖靈既喜歡小動物又怕咖啡灑到身上或書本上，此刻需要既溫柔安撫小貓，又保護好她和周圍環境，同時創造更自然的親近機會 —— 你的選擇將讓她感受到你的細心與可靠。",
        "gal_map_text_206100201=抱貓移位 + 護杯擋濺",
        "gal_map_text_206100202=遞貓零食 + 引導離桌",
        "gal_map_text_206100203=輕趕小貓 + 快速移杯",
        "gal_map_text_206100204=抱它去寵物區，你護好咖啡，小心別濺到。",
        "gal_map_text_206100205=語氣乾脆俐落，身體微微前傾護住桌面，眼神專注地盯著咖啡杯，隨時準備配合",
        "gal_map_text_206100206=好！你抱它的時候小心點，別被它抓傷~",
        "gal_map_text_206100207=敖靈甚至主動伸手按住小貓的後背。動作果斷卻輕柔，完全信任你的處理方式，眼底滿是認可",
        "gal_map_text_206100208=我幫你按住它，你趁機抱起來！這樣更穩妥，別讓它再搗亂了。",
        "gal_map_text_206100209=敖靈身體微微側向你，目光帶著感激，指尖輕輕整理了一下裙擺，帶著一絲不好意思",
        "gal_map_text_206100210=這樣會不會太麻煩你？還要特意抱它去寵物區，其實我把咖啡移開也可以。",
        "gal_map_text_206100211=敖靈語氣帶著一絲客氣，卻在你抱貓時悄悄將咖啡杯往內側挪了挪，動作隱晦卻貼心",
        "gal_map_text_206100212=其實…… 不用特意為我費心，我小心點就好，小貓也挺可愛的。",
        "gal_map_text_206100213=放心，我會小心的。等我回來，我們再好好看書，不讓小貓打擾我們。",
        "gal_map_text_206100214=謝謝你，總是這麼細心。喝點水吧，剛才抱小貓應該挺費力的。",
        "gal_map_text_206100215=敖靈看著你抱著小貓的背影，眼神柔和了許多，耳尖的紅暈未散。等你回來時，主動為你遞過一杯溫水。",
        "gal_map_text_206100216=用零食引它離開，既安全又溫柔。",
        "gal_map_text_206100217=敖靈語氣輕快，腳步俐落，主動承擔任務，眼底滿是期待，完全信任你的想法",
        "gal_map_text_206100218=我去問店員要貓零食！你在這裡看好小貓和咖啡，別讓它再搗蛋了。",
        "gal_map_text_206100219=敖靈裙擺隨著動作輕輕晃動，語氣急促卻充滿默契，主動配合你的節奏",
        "gal_map_text_206100220=我們一起去拿零食！這樣更快，拿到後趕緊引它離開，別讓它再搗蛋了。",
        "gal_map_text_206100221=敖靈雙手放在膝蓋上，目光跟著你移動，神色平靜卻專注，在你拿零食時留意著小貓的動向。",
        "gal_map_text_206100222=可以，這樣不會傷害到小貓，也能解決問題。",
        "gal_map_text_206100223=在你用零食引小貓時，敖靈主動用手掌護住咖啡杯，防止小貓突然撲過來，動作清冷卻貼心，沒有多餘的言語",
        "gal_map_text_206100224=麻煩了。",
        "gal_map_text_206100225=來，小傢伙，吃點零食，別再搗亂了。搞定，現在沒人打擾我們了，你可以安心看書了。",
        "gal_map_text_206100226=沒想到你這麼有辦法，既照顧到了小貓，又保護了我的咖啡。其實…… 和你在一起，總是很安心。",
        "gal_map_text_206100227=敖靈看著你溫柔引導小貓的模樣，眼神裡多了幾分認可",
        "gal_map_text_206100228=我趕它走，你把咖啡移開。",
        "gal_map_text_206100229=敖靈腳尖輕輕踮起，語氣輕快，眼神裡滿是期待，既擔心小貓又想快點解決問題。",
        "gal_map_text_206100230=好！你趕它的時候溫柔點，別嚇到它，我趕緊把咖啡移開。",
        "gal_map_text_206100231=敖靈動作迅速卻不慌亂，語氣急促卻充滿信任，主動配合你的行動",
        "gal_map_text_206100232=我現在就把咖啡移到旁邊的桌子上！你趕緊趕它走，別讓它再過來了。",
        "gal_map_text_206100233=敖靈帶著堅定的神色，既不急躁也不拖延，語氣認真",
        "gal_map_text_206100234=別急，先輕輕趕它，別太用力，免得它反抗打翻咖啡。我慢慢把咖啡移開，我們配合默契點。",
        "gal_map_text_206100235=敖靈語氣沒有起伏，卻精准規劃好動作，目光專注地盯著小貓和咖啡杯，隨時準備行動",
        "gal_map_text_206100236=你從左邊趕它，我從右邊移杯，動作同步，避免意外。",
        "gal_map_text_206100237=小傢伙，快去那邊玩，別在這裡搗亂了。我們配合得真默契，沒有讓咖啡灑出來。",
        "gal_map_text_206100238=還好有你，反應這麼快。其實…… 和你一起應對這些小意外，感覺還挺有意思的。",
        "gal_map_text_206100239=敖靈指尖摩挲著咖啡杯的杯壁，語氣比之前柔和了許多",
        "gal_map_text_206100240=小貓被成功引導離開後，桌面恢復了寧靜。敖靈將咖啡杯放在安全位置，重新拿起精裝書，卻沒有立刻翻開，而是抬頭看向你，嘴角勾起一抹淺淺的弧度。",
        "gal_map_text_206100241=陽光透過窗戶落在她的發梢，鍍上一層溫暖的光暈，你們之間的氛圍愈發曖昧，指尖不經意的觸碰、眼神的交匯，都讓好感度持續升溫，為接下來的相處埋下了更深的羈絆。",
        "gal_map_text_206100242=你迅速而體貼地幫她收拾好散落的物品，氣氛即將回歸平靜時，旁邊卡座來了幾個年輕人，聲音有些嘈雜，時不時發出大笑聲，打破了這個角落原有的寧靜。",
        "gal_map_text_206100243=敖靈不易察覺地微微蹙了下眉，但很快又舒展眉頭，將目光重新投向書本，顯然她的閱讀節奏被打斷了，卻不好意思主動提出換位置。",
        "gal_map_text_206100244=暖黃色燈光依舊柔和，旁邊卡座的年輕人圍坐在一起，大聲交談著，偶爾發出刺耳的笑聲，與書店的靜謐氛圍格格不入。",
        "gal_map_text_206100245=敖靈的眉頭微蹙，指尖輕輕攥著書本的頁角，眼神有些游離，顯然無法集中注意力閱讀。周圍其他客人也紛紛側目，卻沒人主動上前提醒。",
        "gal_map_text_206100246=旁邊太吵了，影響你看書了吧？如果覺得不舒服，我們可以換個角落，或者我去跟他們說一聲，讓他們小聲點。",
        "gal_map_text_206100247=有點吵，不過沒關係，他們可能只是太開心了。換位置會不會太麻煩了？去提醒他們又怕顯得太苛刻。",
        "gal_map_text_206100248=旁邊的嘈雜聲越來越大，敖靈的閱讀節奏被徹底打亂，卻因為性格內斂不好意思主動解決。作為高情商的男主，此刻需要既照顧到她的感受，又避免讓她陷入尷尬，同時展現自己的擔當 —— 你的選擇將直接讓她感受到你的體貼與可靠。",
        "gal_map_text_206100249=主動換座 + 貼心安置",
        "gal_map_text_206100250=委婉提醒 + 保持禮貌",
        "gal_map_text_206100251=忍耐適應 + 轉移注意力",
        "gal_map_text_206100252=我們換安靜角落，我幫你拎包搬書",
        "gal_map_text_206100253=敖靈立刻點頭，起身收拾書本。語氣乾脆俐落，動作迅速卻不慌亂，主動將書本和咖啡杯整理好，眼底滿是認",
        "gal_map_text_206100254=好！換個安靜的地方確實能更好地看書，謝謝你替我著想。",
        "gal_map_text_206100255=敖靈拉著你的手腕走向遠處角落。裙擺隨著動作輕輕晃動，語氣急促卻充滿期待，完全信任你的選擇",
        "gal_map_text_206100256=我看到那邊有個靠窗的位置，又安靜又舒服，我們趕緊過去！別讓他們再打擾我們了。",
        "gal_map_text_206100257=敖靈嘴角露出一絲淺笑，聲音柔和。身體微微側向你，目光帶著感激，指尖輕輕整理了一下裙擺，帶著一絲不好意思",
        "gal_map_text_206100258=這樣會不會太麻煩你？還要特意幫我拎包搬書，我自己也可以的。",
        "gal_map_text_206100259=敖靈眼神低垂，指尖輕輕摩挲衣角。語氣帶著一絲客氣，卻在你拎起她的包時默默跟上，腳步輕快了許多，顯然內心渴望安靜",
        "gal_map_text_206100260=其實…… 我忍忍也可以的，不用特意為我換位置，免得麻煩。",
        "gal_map_text_206100261=沒事，能讓你安心看書就不麻煩。這個位置靠窗，陽光也好，你肯定會喜歡的。坐吧，這次不會有人打擾我們了。",
        "gal_map_text_206100262=謝謝你，總是這麼細心體貼。吃點東西吧，剛才搬東西應該挺辛苦的。",
        "gal_map_text_206100263=敖靈看著你忙碌的身影，眼神柔和了許多，耳尖的紅暈未散。坐下後，主動為你遞過一塊餅乾。",
        "gal_map_text_206100264=我去禮貌提醒，讓他們小聲點。",
        "gal_map_text_206100265=敖靈眼睛亮了亮，立刻點頭說到：",
        "gal_map_text_206100266=好！你去提醒的時候注意語氣，別跟他們起衝突，禮貌一點就好。",
        "gal_map_text_206100267=敖靈起身跟在你身後，裙擺隨著動作輕輕晃動，語氣急促卻充滿默契，主動配合你的行動。",
        "gal_map_text_206100268=我跟你一起去！兩個人去提醒更有說服力，而且我也想跟他們說一聲，希望他們能理解。",
        "gal_map_text_206100269=敖靈微微頷首，語氣平靜，雙手放在膝蓋上，目光跟著你移動，神色平靜。",
        "gal_map_text_206100270=可以，注意分寸，別讓場面太尷尬。",
        "gal_map_text_206100271=在你回來時，主動為你遞過一杯溫水，眼神裡帶著一絲不易察覺的關心，沒有多餘的言語。",
        "gal_map_text_206100272=麻煩了。",
        "gal_map_text_206100273=搞定了，他們答應會小聲點，不會再打擾我們了。還好他們挺通情達理的，你現在可以安心看書了。",
        "gal_map_text_206100274=沒想到你這麼會溝通，既解決了問題，又沒讓場面尷尬。其實…… 和你在一起，總是很有安全感。",
        "gal_map_text_206100275=敖靈指尖摩挲著書本的封面，語氣比之前柔和了許多，眼神裡多了幾分認可。",
        "gal_map_text_206100276=我們忍忍，我給你讀一段書。",
        "gal_map_text_206100277=敖靈雙手托腮看著你。腳尖輕輕踮起，語氣輕快，眼神裡滿是期待，瞬間忘記了周圍的嘈雜。",
        "gal_map_text_206100278=好呀好呀！你讀哪一段？我最喜歡這本書的第三章，寫得超級精彩～",
        "gal_map_text_206100279=敖靈立刻將書本推到你面前。身體微微前傾，眼底閃爍著興奮的光芒，完全信任你的選擇，主動配合你的行動。",
        "gal_map_text_206100280=那你快讀！我耳朵都準備好了，一定要用溫柔的語氣讀哦～",
        "gal_map_text_206100281=敖靈拉住你的手，指尖輕輕攥著你的胳膊，帶著堅定的神色，既不希望你費心，又想滿足你的心意。",
        "gal_map_text_206100282=其實不用這麼麻煩，等他們聊夠了自然會安靜下來。如果你想讀，我也會認真聽的。",
        "gal_map_text_206100283=敖靈指尖輕輕敲了敲桌面。語氣沒有起伏，在你讀書時微微頷首，眼神專注地看著你，顯然在認真聆聽",
        "gal_map_text_206100284=也好，讀書能轉移注意力，你讀的時候聲音可以稍微大一點，我能聽清楚。",
        "gal_map_text_206100285=那我就從這裡開始讀，你認真聽，有喜歡的句子我們可以一起討論。",
        "gal_map_text_206100286=你讀得真好聽，把文字裡的情感都讀出來了。其實…… 聽你讀書，比自己看更有感覺。",
        "gal_map_text_206100287=敖靈看著你認真讀書的模樣，眼神裡多了幾分溫柔。",
        "gal_map_text_206100288=嘈雜聲得到解決後，書店恢復了往日的靜謐。敖靈重新沉浸在書本的世界裡，偶爾會抬頭與你對視，眼神裡帶著一絲不易察覺的依賴與曖昧。",
        "gal_map_text_206100289=她輕輕翻看書頁，指尖偶爾會碰到你的手背，快速收回卻留下淡淡的溫度。",
        "gal_map_text_206100290=陽光透過窗戶落在你們身上，氛圍愈發溫馨，好感度在安靜的陪伴中持續升溫，為接下來的相處埋下了更深的羈絆。",
        "gal_map_text_206100291=之前的小插曲似乎留下了一絲微妙的隔閡，氣氛稍顯冷卻。就在此時，書店的背景音樂切換成一首旋律優美且略帶感傷的爵士樂，鋼琴聲輕柔流淌，夾雜著淡淡的薩克斯風。",
        "gal_map_text_206100292=敖靈原本有些低垂的目光忽然亮了一下，輕輕抬起頭，閉著眼睛專注地聆聽，嘴角不自覺勾起一抹淺淺的弧度。",
        "gal_map_text_206100293=暖黃色燈光柔和地灑在桌面上，爵士樂的旋律在空氣中彌漫，鋼琴聲清脆悠揚，薩克斯風帶著一絲感傷，與書店的靜謐氛圍完美融合。",
        "gal_map_text_206100294=敖靈閉著眼睛，長長的睫毛輕輕顫動，指尖隨著旋律輕輕敲擊桌面，神色溫柔而沉醉。周圍客人也紛紛放緩了動作，沉浸在音樂的世界裡，氛圍格外溫馨。",
        "gal_map_text_206100295=這首曲子很好聽，旋律很動人，你喜歡爵士樂？",
        "gal_map_text_206100296=嗯，我很喜歡這首曲子，叫《Welcome To The Sprawl》，每次聽到都會覺得很放鬆。沒想到書店會放這首曲子，還挺意外的。",
        "gal_map_text_206100297=爵士樂的旋律依舊流淌，氛圍溫馨而曖昧。你知道敖靈看似清冷，實則內心細膩敏感，對音樂有著獨特的熱愛。此刻需要抓住這個契機，拉近彼此的距離，分享共同的興趣愛好，讓微妙的隔閡煙消雲散 —— 你的選擇將直接決定她是否願意向你敞開心扉。",
        "gal_map_text_206100298=分享共鳴 + 聊音樂偏好",
        "gal_map_text_206100299=輕聲哼唱 + 配合節奏",
        "gal_map_text_206100300=安靜陪伴 + 默默傾聽",
        "gal_map_text_206100301=我也愛這首，你還喜歡哪些爵士曲目？",
        "gal_map_text_206100302=敖靈指尖輕輕敲擊桌面，跟著旋律打節拍，語氣自信而興奮，眼底滿是找到知音的喜悅。",
        "gal_map_text_206100303=我還喜歡《Much Ado About Necromorphs》和《Rest In Pieces》，節奏鮮明又富有情感，你也喜歡嗎？",
        "gal_map_text_206100304=敖靈氣息促卻充滿熱情，瞬間打開話匣子，完全沉浸在音樂的話題中。",
        "gal_map_text_206100305=這首曲子獨奏部分超精彩，還有薩克斯風的演繹，簡直絕了！你有沒有注意到裡面的節奏變化？",
        "gal_map_text_206100306=敖靈眼神有些茫然地看著你，指尖輕輕撓了撓臉頰，帶著一絲不確定，卻努力想參與話題。",
        "gal_map_text_206100307=我…… 我不太清楚具體的曲目名稱，就是覺得好聽，比較放鬆。",
        "gal_map_text_206100308=敖靈語氣平淡，沒有明顯情緒，卻在你聊起曲目時微微頷首，努力跟上你的節奏。",
        "gal_map_text_206100309=哦，爵士樂都挺好聽的，比較安靜，適合看書。",
        "gal_map_text_206100310=我也超喜歡《Much Ado About Necromorphs》！裡面的節奏變化太巧妙了，每次聽都有新的感受。沒想到我們的音樂品味這麼相似，以後可以一起分享喜歡的曲目。",
        "gal_map_text_206100311=真的嗎？我身邊很少有人喜歡爵士樂，沒想到你也喜歡。其實…… 能找到志同道合的人，感覺還挺特別的。",
        "gal_map_text_206100312=敖靈耳尖微紅，卻沒有避開你的目光。指尖輕輕摩挲著書本的封面，語氣比之前柔和了許多。",
        "gal_map_text_206100313=我跟著旋律哼，你幫我打節拍？",
        "gal_map_text_206100314=敖靈眼睛亮了亮，立刻點頭。指尖輕輕敲擊桌面，跟著旋律打節拍，語氣輕快，眼底滿是期待。",
        "gal_map_text_206100315=好呀好呀！我來打節拍，你盡情哼唱，這首曲子的旋律超適合哼唱的～",
        "gal_map_text_206100316=敖靈拉著你的手一起打節拍。攥著你的手，語氣急促卻充滿興奮，主動創造親近機會，眼底閃爍著光芒。",
        "gal_map_text_206100317=我們一起配合！我打節拍你哼唱，這樣更有默契，肯定會很好聽～",
        "gal_map_text_206100318=敖靈雙手放在膝蓋上，指尖輕輕敲擊，神色平靜卻專注，在你哼唱時認真配合，沒有多餘的言語",
        "gal_map_text_206100319=可以，我會儘量配合你的節奏，別唱跑調了就行。",
        "gal_map_text_206100320=敖靈指尖輕輕跟著旋律晃動，雖然沒有明顯的動作，卻在用行動配合你，眼神裡帶著一絲不易察覺的溫柔",
        "gal_map_text_206100321=隨便。",
        "gal_map_text_206100322=你打節拍的節奏真准，跟你配合太默契了。這首曲子因為有你的節拍，變得更有感覺了。",
        "gal_map_text_206100323=你唱得真好聽，把曲子裡的感傷都唱出來了。其實…… 和你一起配合，感覺還挺開心的。",
        "gal_map_text_206100324=耳尖微紅，輕輕地抽回自己的手，嘴角帶笑。",
        "gal_map_text_206100325=我們靜靜聽完整首。",
        "gal_map_text_206100326=敖靈雙手托腮看著你，嘴角帶笑。眼神裡滿是享受，完全沉浸在音樂的氛圍中",
        "gal_map_text_206100327=好呀！我們一起靜靜聆聽，這首曲子真的太動人了，閉上眼睛聽更有感覺～",
        "gal_map_text_206100328=身體微微前傾，語氣急促卻充滿期待，主動配合你的決定，眼底閃爍著光芒",
        "gal_map_text_206100329=那我們趕緊聽，別說話打擾到別人，也別錯過精彩的部分～",
        "gal_map_text_206100330=敖靈拉住你的手，語氣平和。輕輕攥著你的手，帶著堅定的神色，既享受音樂又珍惜此刻的陪伴。",
        "gal_map_text_206100331=其實音樂需要用心感受，靜靜聆聽確實是最好的方式。我們一起聽，有什麼感受之後再分享。",
        "gal_map_text_206100332=敖靈語氣沒有起伏，在你閉上眼睛時也輕輕閉上，眼神專注而平靜，顯然在認真感受音樂",
        "gal_map_text_206100333=也好，安靜聆聽能更好地感受旋律和情感，不被外界打擾。",
        "gal_map_text_206100334=這首曲子的旋律真的太動人了，每次聽都能讓人放鬆下來。你剛才有沒有想起什麼特別的事情？我聽的時候想起了秋天的落葉。",
        "gal_map_text_206100335=我想起了小時候和外婆一起聽爵士樂的時光，很溫馨。其實…… 和你一起靜靜聆聽，感覺還挺安心的。",
        "gal_map_text_206100336=敖靈指尖輕輕摩挲著衣角，語氣比之前柔和了許多。",
        "gal_map_text_206100337=爵士樂的旋律漸漸結束，書店恢復了往日的寧靜，但你們之間的氛圍卻變得格外曖昧。敖靈的眼神裡多了幾分溫柔與依賴，偶爾會主動與你分享音樂心得，指尖不經意的觸碰帶著淡淡的溫度。",
        "gal_map_text_206100338=敖靈抬頭看向你，嘴角勾起一抹淺淺的弧度：'今天真的謝謝你，不僅讓我聽到了喜歡的曲子，還能和你一起分享，感覺特別開心。'",
        "gal_map_text_206100339=陽光透過窗戶落在她的發梢，鍍上一層溫暖的光暈，好感度在音樂的共鳴中持續升溫，為接下來的相處奠定了堅實的基礎。",
        "gal_map_text_206100340=你們進入了一間古老的圖書館，牆壁上擺滿了泛黃的書籍，空氣中彌漫著舊紙張和墨香的氣息。",
        "gal_map_text_206100341=正中央的桌子上，一個精緻的 '雙星儀' 正在緩緩運轉，儀器上有兩個晶瑩剔透的星球模型，旁邊的提示牌寫著：'默契配合，讓雙星同時到達終點，即可開啟下一扇門。' 敖靈看著雙星儀，眼神裡充滿了好奇與專注。",
        "gal_map_text_206100342=圖書館光線昏暗，只有桌案上的燭臺散發著微弱的光芒，照亮了雙星儀的輪廓。雙星儀的齒輪輕輕轉動，發出輕微的聲響，兩個星球模型沿著軌道緩緩移動，軌道上有許多凸起的機關，顯然需要精准操作才能通過。",
        "gal_map_text_206100343=牆壁上的書籍整齊排列，偶爾有書頁被風吹得輕輕翻動，營造出神秘而古老的氛圍。",
        "gal_map_text_206100344=看起來需要我們同時操作兩個星球，避開機關，讓它們同時到達終點。你負責左邊的星球，我負責右邊的，我們同步行動，怎麼樣？",
        "gal_map_text_206100345=沒問題，我已經觀察到軌道上的機關規律了，每隔三秒會有一次凸起，我們需要在間隙中推進。",
        "gal_map_text_206100346=雙星儀的齒輪依舊在緩緩轉動，機關凸起的頻率越來越快，需要你們高度默契的配合才能成功。你知道敖靈擅長觀察細節，而你擅長梳理邏輯，此刻需要既展現自己的節奏把控能力，又給予她足夠的信任，讓她感受到你們的默契 —— 你的選擇將直接決定挑戰的成敗，也影響著你們之間的信任度。",
        "gal_map_text_206100347=喊拍同步 + 精准配合",
        "gal_map_text_206100348=詢問節奏 + 靈活調整",
        "gal_map_text_206100349=主導節奏 + 指令操作",
        "gal_map_text_206100350=我喊 123，我們同時推進，避開機關。",
        "gal_map_text_206100351=敖靈立刻點頭，指尖輕輕按住操作按鈕。語氣自信，眼神專注地盯著軌道，身體微微前傾，已經進入準備狀態。",
        "gal_map_text_206100352=沒問題！我已經摸清機關規律了，你喊節奏，我肯定能精准配合。",
        "gal_map_text_206100353=敖靈的眼神快速掃視軌道，瞬間捕捉到關鍵資訊，語氣帶著掌控感",
        "gal_map_text_206100354=我已經準備好了，你隨時可以喊拍，機關間隙只有兩秒，我們必須精准同步。",
        "gal_map_text_206100355=敖靈愣了一下才反應過來，眼神有些茫然地看著軌道，指尖輕輕放在按鈕上，帶著一絲不確定，卻努力集中注意力。",
        "gal_map_text_206100356=哦…… 好，我會跟著你的節奏，你喊 123 我就推，儘量不拖你後腿。",
        "gal_map_text_206100357=敖靈語氣平淡，沒有明顯情緒，卻在你喊拍時努力跟上，眼神專注地看著你的嘴唇",
        "gal_map_text_206100358=哦，我知道了，你喊節奏我就推，應該不難吧。",
        "gal_map_text_206100359=好，我們準備開始！1——2——3—— 推！很好！再來一次，1——2——3—— 推！",
        "gal_map_text_206100360=太默契了！我們成功了！你喊節奏的時機剛剛好，再堅持幾次我們就能成功了。",
        "gal_map_text_206100361=敖靈跟著你的節奏精准按下按鈕，眼神裡滿是興奮。轉頭看向你，嘴角揚起燦爛的笑容，耳尖微紅。",
        "gal_map_text_206100362=你適應什麼節奏？我們調整同步。",
        "gal_map_text_206100363=敖靈語氣輕快，指尖輕輕敲擊按鈕，跟著自己的節奏嘗試，眼底滿是期待，完全信任你的調整能力。",
        "gal_map_text_206100364=我適應快節奏！每隔兩秒推一次，我們試試這個節奏怎麼樣？",
        "gal_map_text_206100365=敖靈拉著你的手放在操作按鈕上指尖輕輕攥著你的手，語氣急促卻充滿興奮，主動創造親近機會，眼底閃爍著光芒。",
        "gal_map_text_206100366=我們先試一次找找感覺！你感受一下我的節奏，然後我們同步，肯定能很快找到默契～",
        "gal_map_text_206100367=敖靈雙手放在膝蓋上，指尖輕輕敲擊，神色平靜卻專注，在你調整節奏時認真配合，沒有多餘的言語",
        "gal_map_text_206100368=適應中速節奏，三秒一次比較穩妥，不容易出錯。",
        "gal_map_text_206100369=敖靈在你嘗試節奏時，指尖輕輕跟著晃動，雖然沒有明顯的動作，卻在用行動配合你，眼神裡帶著一絲不易察覺的認真",
        "gal_map_text_206100370=隨便，我都可以適應。",
        "gal_map_text_206100371=這個節奏確實很穩妥，我們就按三秒一次來！你調整節奏的能力真強，我們現在越來越默契了。",
        "gal_map_text_206100372=其實是你配合得好，願意遷就我的節奏。其實…… 和你一起合作，感覺還挺開心的。",
        "gal_map_text_206100373=敖靈耳尖微紅，卻沒有避開你的目光。指尖輕輕摩挲著操作按鈕，語氣比之前柔和了許多。",
        "gal_map_text_206100374=聽我的指令，我讓你推再推。",
        "gal_map_text_206100375=敖靈看著你，嘴角帶笑。語氣輕快，眼神裡滿是信任，完全依賴你的節奏把控能力。",
        "gal_map_text_206100376=好呀好呀！我完全聽你的指令，你讓我推我就推，絕對不會出錯～",
        "gal_map_text_206100377=敖靈身體微微前傾，語氣急促卻充滿期待，主動配合你的指揮，眼底閃爍著光芒",
        "gal_map_text_206100378=快下達指令吧！我已經準備好了，隨時可以行動，我們趕緊完成挑戰～",
        "gal_map_text_206100379=敖靈帶著堅定的神色，既信任你的指揮又提出合理建議，語氣認真",
        "gal_map_text_206100380=指令要清晰明確，提前一秒喊準備，這樣我能更好地配合你。我們先試一次，找找感覺。",
        "gal_map_text_206100381=敖靈語氣沒有起伏，卻在你喊指令時眼神專注地看著你，指尖快速按下按鈕，顯然在認真配合",
        "gal_map_text_206100382=可以，你下達指令吧，我會精准執行，不會拖你後腿。",
        "gal_map_text_206100383=準備！倒計時三秒，3——2——1—— 推！很好！再來一次，3——2——1—— 推！",
        "gal_map_text_206100384=你的指令很清晰，我能準確把握時機。我們已經成功一半了，再加把勁就能開啟下一扇門了。",
        "gal_map_text_206100385=敖靈跟著你的指令精准按下按鈕，眼神裡多了幾分認可。轉頭看向你，嘴角勾起一抹淺淺的笑容",
        "gal_map_text_206100386=在你們的默契配合下，雙星儀的兩個星球模型同時到達了終點，桌案下傳來輕微的機關轉動聲，圖書館的一面牆壁緩緩打開，露出了通往下一關卡的通道。",
        "gal_map_text_206100387=敖靈看著打開的通道，眼神裡滿是興奮與成就感，轉頭看向你時，眼底帶著一絲不易察覺的依賴：'我們成功了！真沒想到我們的默契這麼好。'",
        "gal_map_text_206100388=燭臺的光芒照亮了她的臉龐，氛圍愈發曖昧，好感度在並肩作戰中持續升溫，為接下來的挑戰埋下了更深的羈絆。",
        "gal_map_text_206100389=你們進入了一間鏡屋，牆壁、地面甚至天花板都鑲嵌著鏡子，反射出無數個你們的身影，讓人有些眼花繚亂。",
        "gal_map_text_206100390=房間中央有一個踏板，前方是一條僅容一人通過的、懸在虛空中的狹窄石橋，橋的對面是出口。",
        "gal_map_text_206100391=旁邊的提示牌寫著：'一人蒙眼，一人指揮，默契抵達出口，即可通關。' 敖靈看著狹窄的石橋，眼神裡閃過一絲猶豫。鏡屋光線明亮，無數面鏡子反射出刺眼的光芒，讓人難以分辨真實與虛幻。",
        "gal_map_text_206100392=狹窄的石橋懸在半空中，下方是漆黑的深淵，只能看到微弱的光影。石橋寬度僅夠一人通過，兩側沒有任何防護措施，看起來格外危險。踏板位於石橋入口處，顯然是用來激活通關程式的。",
        "gal_map_text_206100393=別擔心，石橋看起來危險，其實很穩固。如果你害怕蒙眼，我來蒙眼，你指揮我；如果你想嘗試，我來指揮你，都聽你的。",
        "gal_map_text_206100394=我不害怕蒙眼，只是擔心指揮不好你，讓你掉下去。你相信我的指揮能力嗎？如果我蒙眼，你能準確指揮我避開障礙嗎？",
        "gal_map_text_206100395=鏡屋的鏡子反射出無數個身影，讓人有些眩暈，狹窄的石橋更增添了幾分緊張感。你知道敖靈看似勇敢，實則對 '被指揮' 或 '指揮他人' 都有著隱秘的顧慮，此刻需要既展現自己的能力，又給予她足夠的信任，讓她相信你們的默契足以應對挑戰 —— 你的選擇將決定她是否願意完全交付信任。",
        "gal_map_text_206100396=主動蒙眼 + 信任指揮",
        "gal_map_text_206100397=鼓勵嘗試 + 承諾兜底",
        "gal_map_text_206100398=石頭剪刀布 + 公平決定",
        "gal_map_text_206100399=我蒙眼，你指揮，我完全信任你。",
        "gal_map_text_206100400=敖靈眼睛亮了亮，立刻點頭。語氣輕快，眼神專注地觀察著石橋的路況，已經進入指揮狀態，眼底滿是自信與信任。",
        "gal_map_text_206100401=好！你放心，我會精准指揮你，絕對不會讓你掉下去的～",
        "gal_map_text_206100402=敖靈輕輕攥著你的手，語氣急促卻充滿興奮，主動創造親近機會，眼底閃爍著光芒。",
        "gal_map_text_206100403=我們趕緊開始吧！我已經觀察好路線了，左邊三步，右邊兩步，跟著我的指令走就行～",
        "gal_map_text_206100404=敖靈雙手放在膝蓋上，指尖輕輕敲擊，神色平靜卻專注，在你蒙眼時認真觀察路況，沒有多餘的言語",
        "gal_map_text_206100405=我會認真指揮，你跟著我的指令走，不要擅自行動。",
        "gal_map_text_206100406=敖靈在你蒙眼時，指尖輕輕扶了扶你的胳膊，動作清冷卻貼心，眼神裡帶著一絲不易察覺的關心",
        "gal_map_text_206100407=放心，我不會出錯。",
        "gal_map_text_206100408=好了，我已經蒙眼了，接下來全靠你指揮了。你說往哪走我就往哪走，絕對服從你的指令。",
        "gal_map_text_206100409=好，我們開始！先往前邁兩步，小心左邊的凸起…… 對，就是這樣，再往右邊挪一點。你真勇敢，完全信任我，我們馬上就要到出口了。",
        "gal_map_text_206100410=敖靈感受到你的信任，語氣裡帶了幾分堅定。",
        "gal_map_text_206100411=你蒙眼，我指揮，掉下來我接住。",
        "gal_map_text_206100412=敖靈語氣輕快，眼神裡滿是信任，完全不擔心會掉下去。",
        "gal_map_text_206100413=真的嗎？你會接住我？那我就放心啦，我來蒙眼！",
        "gal_map_text_206100414=敖靈立刻點頭，主動拿起蒙眼布。動作迅速地蒙好眼睛，語氣急促卻充滿期待。",
        "gal_map_text_206100415=好！我現在就蒙眼，你一定要指揮好我，我相信你肯定不會讓我掉下去的～",
        "gal_map_text_206100416=敖靈輕輕攥著你的手，帶著堅定的神色，既信任你的指揮又保持著冷靜，語氣認真。",
        "gal_map_text_206100417=不用這麼誇張，我會小心跟著你的指令走，你指揮清晰就行。我們先試走兩步，找找感覺。",
        "gal_map_text_206100418=敖靈語氣沒有起伏，卻在蒙眼時微微握緊了你的手，顯然在尋求安全感，眼神專注地聽著你的指令",
        "gal_map_text_206100419=可以，我蒙眼，你指揮。指令要簡潔明瞭，我會快速回應。",
        "gal_map_text_206100420=放心吧，有我在，絕對不會讓你掉下去。我們開始！往前邁一步，對，很好，再往右邊挪一點，避開前面的障礙。",
        "gal_map_text_206100421=你的指揮真清晰，我完全能感受到方向。有你在身邊，我一點都不害怕，反而覺得很安心。",
        "gal_map_text_206100422=敖靈語氣比之前柔和了許多，耳尖微紅",
        "gal_map_text_206100423=猜拳決定，輸的人蒙眼。",
        "gal_map_text_206100424=敖靈立刻點頭，伸出手。語氣乾脆俐落，眼神專注地看著你的手，已經做好了猜拳的準備，眼底滿是好勝心。",
        "gal_map_text_206100425=好！石頭剪刀布，輸的人蒙眼，公平公正，我可不會讓著你哦～",
        "gal_map_text_206100426=敖靈拉著你的手開始猜拳。輕輕攥著你的手，語氣急促卻充滿興奮，主動發起挑戰，眼底閃爍著光芒。",
        "gal_map_text_206100427=我們趕緊來！一局定勝負，輸的人馬上蒙眼，別耽誤時間～",
        "gal_map_text_206100428=敖靈嘴角露出一絲淺笑，聲音柔和。身體微微側向你，目光帶著笑意，整理了一下裙擺，帶著一絲不好意思。",
        "gal_map_text_206100429=這樣會不會太隨意了？其實誰蒙眼都一樣，我無所謂的。",
        "gal_map_text_206100430=敖靈眼神低垂，指尖輕輕摩挲衣角。語氣帶著一絲客氣，卻在你提出猜拳時伸出了手，努力配合你的決定。",
        "gal_map_text_206100431=其實…… 我都可以，你決定就好，不用猜拳這麼麻煩。",
        "gal_map_text_206100432=好！一局定勝負，輸的人可不許耍賴哦～石頭 —— 剪刀 —— 布！哈哈，我贏了，你蒙眼～",
        "gal_map_text_206100433=好吧，我輸了，我來蒙眼。你可一定要指揮好我，不然我就跟你沒完～",
        "gal_map_text_206100434=敖靈假裝懊惱地跺了跺腳，嘴角卻帶著笑。拿起蒙眼布蒙好眼睛，語氣比之前柔和了許多。",
        "gal_map_text_206100435=在你們的默契配合下，成功通過了狹窄的石橋，抵達了鏡屋的出口。敖靈摘下蒙眼布，眼神裡滿是興奮與成就感，轉頭看向你時，眼底帶著一絲不易察覺的依賴與曖昧。",
        "gal_map_text_206100436=她輕輕鬆開攥著你的手，耳尖微紅：'我們成功了！真沒想到我們的默契這麼好。'",
        "gal_map_text_206100437=鏡屋的光芒照亮了她的臉龐，氛圍愈發溫馨，好感度在相互信任中持續升溫，為接下來的挑戰埋下了更深的羈絆。",
        "gal_map_text_206100438=你們進入了一間天文臺，屋頂是璀璨的星空投影，無數星星閃爍著微弱的光芒，仿佛置身於浩瀚的宇宙中。房間中央有一個石碑，上面刻著一段古老的星座諺語：'當獵戶座指向北方，雙子座交匯于銀河，獅子座的光芒照亮大地，星門自會開啟。'",
        "gal_map_text_206100439=旁邊散落著幾張星圖碎片，顯然需要拼湊完整並解開諺語中的謎題，才能開啟下一扇門。天文臺光線昏暗，屋頂的星空投影格外逼真，星星閃爍著微弱的光芒，銀河如一條銀色的絲帶橫跨天際。",
        "gal_map_text_206100440=石碑通體黝黑，上面的古老文字閃爍著淡淡的金光，星圖碎片散落在石碑周圍的地面上，碎片上畫著不同的星座圖案。空氣中彌漫著淡淡的金屬氣息，偶爾能聽到輕微的機關轉動聲，營造出神秘而浩瀚的氛圍。",
        "gal_map_text_206100441=這段諺語應該是解開謎題的關鍵，獵戶座、雙子座、獅子座，這三個星座肯定有著特殊的聯繫。你對星座有瞭解嗎？我們可以一起拼湊星圖，解開謎題。",
        "gal_map_text_206100442=我對星座有一點瞭解，獵戶座位于天球赤道，雙子座在銀河西岸。星圖碎片需要拼湊完整，才能找到星座的準確位置，我們分工合作吧。",
        "gal_map_text_206100443=屋頂的星空投影緩緩轉動，星座的位置也在不斷變化，石碑上的文字閃爍著神秘的光芒。你知道敖靈對星座有一定的瞭解，而你擅長邏輯推理，此刻需要既發揮她的知識優勢，又展現自己的推理能力，讓她感受到你們的互補與默契 —— 你的選擇將直接決定謎題的破解速度，也影響著你們之間的親近度。",
        "gal_map_text_206100444=分工拼圖 + 共同推理",
        "gal_map_text_206100445=一起拼圖 + 同步推理",
        "gal_map_text_206100446=獨立拼圖 + 各自推理",
        "gal_map_text_206100447=你拼星圖，我推邏輯，我們互補。",
        "gal_map_text_206100448=敖靈立刻點頭，指尖快速拿起星圖碎片。語氣自信，眼神專注地看著碎片，身體微微前傾，已經進入拼圖狀態，眼底滿是認真。",
        "gal_map_text_206100449=沒問題！我對圖案很敏感，很快就能拼好星圖，你專心推理諺語的含義。",
        "gal_map_text_206100450=敖靈甚至沒等你說完就開始拼圖。手指迅速移動，動作麻利卻不慌亂，瞬間投入拼圖中。",
        "gal_map_text_206100451=我已經看到碎片上的星座邊緣了，獵戶座的腰帶圖案很明顯，我先把它拼出來，你趕緊推理。",
        "gal_map_text_206100452=敖靈眼神有些茫然地看著碎片，手指輕輕拿起一塊，帶著一絲不確定，卻努力集中注意力。",
        "gal_map_text_206100453=哦…… 好，我來拼星圖，你推理。我儘量快點拼好，不拖你後腿。",
        "gal_map_text_206100454=敖靈語氣平淡，沒有明顯情緒，卻在拼圖時認真對比圖案，努力尋找契合點，眼神專注。",
        "gal_map_text_206100455=哦，星圖看起來挺複雜的，我慢慢拼，你別急。",
        "gal_map_text_206100456=好！你專心拼圖，我來分析諺語。'獵戶座指向北方'，應該是讓獵戶座的腰帶指向北極星；'雙子座交匯于銀河'，可能是讓雙子座的兩顆主星位於銀河兩側。",
        "gal_map_text_206100457=我已經拼好獵戶座和雙子座了！你看，這樣擺放對嗎？還有獅子座的碎片沒找到，你再等等，我很快就能拼好。",
        "gal_map_text_206100458=敖靈快速拼接著星圖，時不時抬頭看向你。將拼好的星圖轉向你，指尖輕輕點在星座上，耳尖微紅。",
        "gal_map_text_206100459=我們一起拼圖，邊拼邊分析謎題。",
        "gal_map_text_206100460=敖靈眼睛亮了亮，立刻點頭。語氣輕快，輕輕拿起一塊碎片，主動遞給你，眼底滿是期待，完全信任你的推理能力",
        "gal_map_text_206100461=好呀好呀！我們一起拼圖，邊拼邊分析，這樣更有默契，肯定能很快解開謎題～",
        "gal_map_text_206100462=敖靈攥著你的手，語氣急促卻充滿興奮，主動創造親近機會，眼底閃爍著光芒。",
        "gal_map_text_206100463=我們挨著坐，一起找碎片的契合點！你看這塊碎片上的銀河圖案，應該和那塊能拼在一起～",
        "gal_map_text_206100464=敖靈輕輕拿起一塊碎片，神色平靜卻專注，在拼圖時認真配合你的節奏，沒有多餘的言語。",
        "gal_map_text_206100465=可以，一起拼圖效率更高，遇到不懂的地方我們再討論。",
        "gal_map_text_206100466=敖靈在你尋找碎片時，主動將身邊的碎片遞給你，動作清冷卻貼心，眼神裡帶著一絲不易察覺的認真",
        "gal_map_text_206100467=隨便。",
        "gal_map_text_206100468=這塊碎片確實能和我手裡的拼在一起！你看，這是獅子座的頭部圖案。諺語裡說 '獅子座的光芒照亮大地'，可能是讓獅子座位於星圖的正中央。",
        "gal_map_text_206100469=對！我也這麼覺得。我們的想法不謀而合，看來我們的默契真的很好，很快就能解開謎題了。",
        "gal_map_text_206100470=敖靈感受到你的靠近，耳尖微紅，卻沒有避開。手指輕輕點在拼圖上，語氣比之前柔和了許多。",
        "gal_map_text_206100471=我們分開拼圖，誰先好誰推理。",
        "gal_map_text_206100472=敖靈腳尖輕輕踮起，語氣輕快，眼神裡滿是好勝心，完全享受比賽的氛圍。",
        "gal_map_text_206100473=好呀！我們來比賽，看誰先拼好星圖，誰先推理出謎題，輸的人要答應對方一個要求～",
        "gal_map_text_206100474=敖靈立刻點頭，拿起一堆碎片。動作迅速地拿起碎片開始拼圖，語氣急促卻充滿興奮，主動發起挑戰，眼底閃爍著光芒",
        "gal_map_text_206100475=我肯定能贏！我拼圖很快的，推理也不差，你等著認輸吧～",
        "gal_map_text_206100476=敖靈輕輕攥著你的手，帶著堅定的神色，既享受比賽又注重合作，語氣認真。",
        "gal_map_text_206100477=比賽可以，但不要太較真，解開謎題才是最重要的。我們盡力就好，不用太在意輸贏。",
        "gal_map_text_206100478=敖靈輕輕敲了敲桌面，語氣沒有起伏，在拿起碎片時眼神專注，顯然在認真對待比賽，努力爭取勝利。",
        "gal_map_text_206100479=可以，比賽能提高效率。我們開始吧，誰先完成誰先說答案。",
        "gal_map_text_206100480=好！比賽開始！我可不會輕易認輸哦～我已經拼好一半了，你怎麼樣？要不要認輸呀？",
        "gal_map_text_206100481=才不要！我也拼好很多了，推理也有頭緒了。不過…… 就算我輸了，也不會讓你提太過分的要求～",
        "gal_map_text_206100482=敖靈假裝生氣地瞪了你一眼，嘴角卻帶著笑。",
        "gal_map_text_206100483=在你們的默契配合下，星圖被成功拼湊完整，謎題也順利解開。當你們按照諺語的指示擺放好星座位置後，石碑緩緩移開，露出了通往下一關卡的星門。",
        "gal_map_text_206100484=敖靈看著打開的星門，眼神裡滿是興奮與成就感，轉頭看向你時，眼底帶著一絲不易察覺的依賴與曖昧。",
        "gal_map_text_206100485=敖靈輕輕拍了拍你的肩膀：'我們成功了！真沒想到我們的默契這麼好。' 屋頂的星空投影照亮了她的臉龐，氛圍愈發溫馨，好感度在互補合作中持續升溫，為接下來的挑戰埋下了更深的羈絆。",
        "gal_map_text_206100486=隊伍比想像中更長，移動緩慢。人潮的喧鬧和食物的香氣包裹著你們，這是一個難得的近距離相處和交談的機會。敖靈站在你身前半步，時不時回過頭跟你說話，髮絲偶爾會拂過你的手臂，帶來一陣輕微的癢意。周圍的攤主熱情地吆喝著，食物的香氣愈發濃郁，讓人垂涎欲滴",
        "gal_map_text_206100487=市集人流湧動，隊伍蜿蜒曲折，移動速度緩慢。周圍的攤位擺滿了各種美食，烤肉的焦香、甜品的甜香、香料的辛香交織在一起，令人食指大動。",
        "gal_map_text_206100488=敖靈的髮絲被風吹得輕輕飄動，偶爾拂過你的手臂，她身上淡淡的香水味混合著食物的香氣，格外迷人。周圍的喧鬧聲、吆喝聲、笑聲交織在一起，營造出熱鬧而溫馨的氛圍。",
        "gal_map_text_206100489=隊伍移動得真慢，不過這樣也好，能多陪你聊一會兒。你平時喜歡吃市集這種熱鬧的地方，還是更偏愛安靜的餐廳？",
        "gal_map_text_206100490=我其實都挺喜歡的，熱鬧的地方有煙火氣，安靜的餐廳能好好聊天。不過和你一起，不管在哪裡，感覺都挺開心的。",
        "gal_map_text_206100491=隊伍依舊緩慢移動，周圍的喧鬧聲和食物的香氣包裹著你們，近距離的相處讓氛圍愈發曖昧。你知道敖靈既享受市集的煙火氣，又珍惜此刻的獨處時光，此刻需要既抓住機會拉近彼此的距離，又照顧到她的感受，創造自然而溫馨的互動 —— 你的選擇將直接讓她感受到你的細心與體貼。",
        "gal_map_text_206100492=輕撩髮絲 + 貼心交談",
        "gal_map_text_206100493=分享回憶 + 拉近距離",
        "gal_map_text_206100494=觀察攤位 + 轉移話題",
        "gal_map_text_206100495=你的髮絲吹到我了，我幫你理到耳後吧？",
        "gal_map_text_206100496=敖靈身體微微一僵，隨即點頭，耳尖泛紅。眼神微微閃躲，卻主動湊近半步，方便你幫忙整理，指尖輕輕攥著衣角，帶著一絲緊張。",
        "gal_map_text_206100497=好…… 謝謝你，風太大了，總把頭髮吹亂。",
        "gal_map_text_206100498=敖靈主動側過臉，配合你的動作。語氣帶著一絲嬌嗔，眼神專注地看著你，眼底滿是自然的親近。",
        "gal_map_text_206100499=快幫我別好！這頭髮太礙事了，說話都不方便。",
        "gal_map_text_206100500=敖靈嘴角露出一絲淺笑，聲音柔和。伸手想自己整理，卻因為站在人流中不好動作，身體微微側向你，帶著一絲不好意思。",
        "gal_map_text_206100501=不用麻煩你了，我自己來就好，其實也不影響的。",
        "gal_map_text_206100502=眼神低垂，臉頰微紅。語氣帶著一絲羞澀，卻沒有躲開你的手，指尖輕輕摩挲著裙擺，身體微微緊繃。",
        "gal_map_text_206100503=謝謝…… 不用特意這樣的，我沒關係。",
        "gal_map_text_206100504=好了，這樣就不會再吹到了。其實你散著頭髮很好看，就是風大的時候有點麻煩。",
        "gal_map_text_206100505=謝謝你…… 剛才髮絲掃到你，沒打擾到你吧？和你站得這麼近，感覺…… 還挺特別的。",
        "gal_map_text_206100506=敖靈感受到耳尖的觸感，臉頰更紅了，微微低頭。抬頭時眼神與你交匯，快速移開，指尖輕輕觸碰被你別過的頭髮，語氣比之前更柔和。",
        "gal_map_text_206100507=我小時候常逛市集，你有難忘的回憶嗎？",
        "gal_map_text_206100508=敖靈語氣輕快，眼神裡滿是回憶的笑意，主動分享細節，完全打開話匣子。",
        "gal_map_text_206100509=我小時候也常跟媽媽逛市集！最喜歡吃棉花糖，每次都吃到滿臉都是。",
        "gal_map_text_206100510=敖靈拉著你的手腕，語氣急促卻興奮。輕輕攥著你的手，身體微微靠近，眼底閃爍著分享的喜悅",
        "gal_map_text_206100511=我還記得有個老爺爺賣糖畫，每次都給我畫小兔子！你小時候逛市集喜歡吃什麼？快跟我說說～",
        "gal_map_text_206100512=敖靈雙手放在膝蓋上，神色平靜卻專注，在你分享時認真傾聽，沒有多餘的言語。",
        "gal_map_text_206100513=小時候偶爾會去，沒什麼特別難忘的，就是覺得人多熱鬧。",
        "gal_map_text_206100514=敖靈在你說起童年趣事時，嘴角微微勾起一絲不易察覺的弧度，眼神裡帶著一絲好奇，沒有打斷你的話，",
        "gal_map_text_206100515=不太記得了，沒什麼印象。",
        "gal_map_text_206100516=哈哈，我小時候最喜歡吃烤腸，每次都要吃兩根，還搶不過隔壁家的小孩。沒想到我們都有市集回憶，以後可以常來逛，彌補小時候的遺憾。",
        "gal_map_text_206100517=那下次我們一起來吃棉花糖和烤腸！其實…… 和你分享這些回憶，感覺還挺開心的，好像一下子拉近了距離。",
        "gal_map_text_206100518=敖靈指尖輕輕點在你的手臂上，語氣比之前更活潑。",
        "gal_map_text_206100519=前面好像有新攤位，我們看看是什麼？",
        "gal_map_text_206100520=敖靈順著你的目光看去，眼睛亮了亮。眼神裡滿是期待，完全被新攤位吸引。",
        "gal_map_text_206100521=真的嗎？是什麼新攤位？會不會是我想吃的章魚小丸子？",
        "gal_map_text_206100522=敖靈拉著你的手往前湊，語氣急促卻興奮，主動拉著你往前走，眼底閃爍著好奇。",
        "gal_map_text_206100523=我們趕緊看看！如果是好吃的，我們就排隊買，正好隊伍移動這麼慢～",
        "gal_map_text_206100524=敖靈攥著你的胳膊，帶著堅定的神色，既不被打擾又想繼續深入聊天。",
        "gal_map_text_206100525=別急，隊伍還在移動，等我們排到前面再看也不遲。先聊完剛才的話題，你還沒說喜歡安靜餐廳還是熱鬧市集呢。",
        "gal_map_text_206100526=敖靈的語氣沒有起伏，卻在你看向新攤位時，主動幫你留意情況，眼神專注地觀察著。",
        "gal_map_text_206100527=前面人太多了，擠過去不方便。等隊伍往前挪挪再看，先耐心排隊吧。",
        "gal_map_text_206100528=好，等隊伍移動到前面我們再看。不過說真的，我覺得和你一起排隊也挺有意思的，雖然慢，但能和你聊天。",
        "gal_map_text_206100529=嗯，確實挺有意思的。其實…… 不管看什麼攤位，只要和你一起，感覺都挺開心的。",
        "gal_map_text_206100530=敖靈耳尖微紅，輕輕點頭。摩挲著衣角，語氣比之前柔和了許多",
        "gal_map_text_206100531=隊伍終於移動到了攤位前，你們買到了心儀的美食。敖靈拿著分好的食物，時不時偷偷看向你，耳尖的紅暈還未散去。",
        "gal_map_text_206100532=她輕輕咬了一口烤肉，嘴角揚起滿足的笑容：'今天真的謝謝你，不僅吃到了好吃的，還聊了很多開心的事情。'",
        "gal_map_text_206100533=夕陽的餘暉灑在她的發梢，食物的香氣混合著她身上的香水味，氛圍愈發曖昧，指尖不經意的觸碰、眼神的交匯，都讓好感度持續升溫，為接下來的相處埋下了更深的羈絆。",
        "gal_map_text_206100534=你們站在那個裝飾奇特的 '怪味實驗室' 攤位前，你買下了一份香菜霜淇淋和一份辣椒巧克力。你們找了個稍微安靜的角落，準備開始這場味蕾冒險。",
        "gal_map_text_206100535=角落的長椅鋪著柔軟的坐墊，周圍的喧鬧聲被隔絕了大半，只剩下偶爾傳來的攤主吆喝聲。香菜霜淇淋的綠色與辣椒巧克力的紅色形成鮮明對比，散發著奇特卻誘人的香氣。",
        "gal_map_text_206100536=敖靈的勺子還沾著霜淇淋的涼意，遞到你面前時，眼神裡滿是期待與好奇，嘴角還沾著一絲綠色的醬料，格外可愛。",
        "gal_map_text_206100537=真有這麼奇妙？我來試試，不過你可別騙我，要是太難吃，我可要讓你負責。",
        "gal_map_text_206100538=放心，絕對讓你印象深刻！趕緊嘗嘗，然後告訴我你的感受，不許撒謊哦～",
        "gal_map_text_206100539=勺子遞到面前，霜淇淋的涼意混合著香菜的獨特氣味撲面而來。你知道敖靈此刻充滿了分享的熱情，既想讓你體驗她覺得有趣的味道，又期待得到你的共鳴。此刻需要既配合她的熱情，又創造自然的親近機會，讓氛圍更加曖昧 —— 你的選擇將直接讓她感受到你的在意與默契。",
        "gal_map_text_206100540=共用勺子 + 反喂回去",
        "gal_map_text_206100541=認真評價 + 分享感受",
        "gal_map_text_206100542=假裝嫌棄 + 調侃互動",
        "gal_map_text_206100543=那我嘗完，你也得嘗嘗我這份巧克力。",
        "gal_map_text_206100544=敖靈耳尖泛紅，卻立刻點頭，眼神明亮。語氣帶著一絲調皮，主動拿起你的辣椒巧克力，舀了一勺遞到你嘴邊，完全不介意間接接觸。",
        "gal_map_text_206100545=好！不過你不許用我的勺子直接舀，要像我這樣喂你。",
        "gal_map_text_206100546=敖靈直接湊到你面前，語氣興奮。身體微微靠近，鼻尖幾乎碰到你的臉頰，眼神專注地看著你，完全沒有距離感。",
        "gal_map_text_206100547=快嘗快嘗！嘗完我就吃你的巧克力，我們交換著吃才有意思～",
        "gal_map_text_206100548=敖靈嘴角露出一絲淺笑，聲音柔和。身體微微後仰，卻沒有拒絕，指尖輕輕拿著勺子，帶著一絲不好意思。",
        "gal_map_text_206100549=這樣會不會太親密了？其實用紙巾擦一下勺子也可以的。",
        "gal_map_text_206100550=敖靈帶著一絲羞澀，在你喂她時微微張開嘴，身體微微緊繃，卻沒有躲開。",
        "gal_map_text_206100551=好…… 聽你的。",
        "gal_map_text_206100552=味道確實很奇妙，香菜的清新混合著霜淇淋的甜，居然意外好吃。現在換你嘗我的，小心有點辣哦。",
        "gal_map_text_206100553=哇，有點辣但又很甜，太特別了！我們這樣交換著吃，感覺好像…… 情侶呢。",
        "gal_map_text_206100554=敖靈輕輕吃下你喂來的巧克力，臉頰瞬間染上紅暈，眼神裡滿是驚喜。伸手輕輕擦了擦嘴角，耳尖泛紅。",
        "gal_map_text_206100555=味道很特別！香菜味很清新，你覺得呢？",
        "gal_map_text_206100556=敖靈眼睛亮了亮，立刻點頭。眼神裡滿是找到共鳴的喜悅，主動分享自己的感受，完全打開話匣子。",
        "gal_map_text_206100557=我就說吧！香菜味一點都不奇怪，反而很解膩，和霜淇淋太配了。",
        "gal_map_text_206100558=敖靈拉著你的手，語氣急促卻興奮，身體微微靠近，眼底閃爍著分享的熱情。",
        "gal_map_text_206100559=對吧對吧！我就知道你會喜歡，還有這個辣椒巧克力，你再嘗嘗，辣中帶甜，超級上頭～",
        "gal_map_text_206100560=敖靈神色平靜卻專注，在你分享時認真傾聽，偶爾點頭回應。",
        "gal_map_text_206100561=確實挺特別的，香菜味不突兀，巧克力的辣度也剛好。",
        "gal_map_text_206100562=敖靈在你繼續評價時，主動舀了一勺霜淇淋遞給你，眼神裡帶著一絲不易察覺的溫柔，沒有多餘的言語。",
        "gal_map_text_206100563=還行，不難吃。",
        "gal_map_text_206100564=真的很特別，以前從來沒吃過這樣的組合，多虧了你推薦。你是不是經常嘗試這種新奇的食物？感覺你很有冒險精神。",
        "gal_map_text_206100565=其實我也很少嘗試，不過和你一起，就想試試不一樣的。而且能和你分享感受，感覺比自己吃更開心。",
        "gal_map_text_206100566=敖靈耳尖微紅，沒有避開你的目光。輕輕摩挲著勺子，語氣比之前更柔和。",
        "gal_map_text_206100567=哇，這味道太奇特了，你居然喜歡？",
        "gal_map_text_206100568=敖靈假裝生氣地瞪了你一眼，嘴角卻帶著笑。伸手舀了一大勺霜淇淋遞到你嘴邊，語氣帶著調侃，眼底滿是笑意。",
        "gal_map_text_206100569=什麼嘛！這味道明明很特別，你居然嫌棄，我偏要讓你多吃幾口～",
        "gal_map_text_206100570=敖靈搶過你手裡的巧克力，語氣調皮。神裡滿是狡黠，完全享受這種互動的樂趣。",
        "gal_map_text_206100571=既然你嫌棄我的霜淇淋，那你的巧克力就歸我了！我一個人吃，不給你留～",
        "gal_map_text_206100572=敖靈拉住你的手，帶著堅定的神色，既配合你的調侃又不較真。",
        "gal_map_text_206100573=別假裝嫌棄了，我看你吃得挺香的。其實這種新奇的味道，偶爾嘗試一下也挺好的。",
        "gal_map_text_206100574=喜歡與否因人而異，不過你既然覺得奇特，我就不強迫你吃了。",
        "gal_map_text_206100575=敖靈在你說完後，主動舀了一勺巧克力放進自己嘴裡，眼神專注地看著你，想知道你的真實感受。",
        "gal_map_text_206100576=好吧好吧，我認輸，其實味道還挺不錯的，就是有點意外。不過你得補償我，再喂我一口霜淇淋，我就原諒你搶我的巧克力。",
        "gal_map_text_206100577=你真幼稚！不過看在你認錯的份上，我就喂你吧。其實…… 和你這樣打打鬧鬧，感覺還挺有意思的。",
        "gal_map_text_206100578=敖靈吃下你喂來的巧克力，忍不住笑了出來。慢慢地舀了一勺霜淇淋遞到你嘴邊，臉頰微紅。",
        "gal_map_text_206100579=你們交換著吃完了兩份怪味美食，嘴角都沾著些許醬料，相視一笑時，氛圍格外曖昧。",
        "gal_map_text_206100580=敖靈拿出紙巾，輕輕幫你擦了擦嘴角，動作自然而溫柔：'今天真的謝謝你，陪我嘗試這麼奇特的味道，還聊了這麼多開心的事情。'",
        "gal_map_text_206100581=夕陽的餘暉灑在你們身上，食物的香氣混合著彼此的笑聲，好感度在輕鬆的互動中持續升溫，為接下來的相處奠定了堅實的基礎。",
        "gal_map_text_206100582=你們在約定的休息區成功匯合。你買來了香氣撲鼻的戰斧烤肉，而她則端著一份精緻的法式可麗餅。桌子上，兩種風格迥異的美食並排放在一起，烤肉的焦香與可麗餅的甜香交織在一起，令人垂涎欲滴。",
        "gal_map_text_206100583=敖靈看著桌上的美食，眼神裡滿是期待，嘴角揚起淺淺的笑容。休息區的木質桌椅乾淨整潔，周圍種植著幾盆綠植，遮擋了部分陽光，營造出陰涼舒適的氛圍。",
        "gal_map_text_206100584=戰斧烤肉色澤金黃，表面還在滋滋作響，滴著誘人的油脂；法式可麗餅點綴著新鮮的草莓和奶油，顏值極高。敖靈的指尖輕輕放在可麗餅的包裝盒上，眼神在烤肉和可麗餅之間來回移動，顯然兩種都想嘗試",
        "gal_map_text_206100585=我的烤肉分給你一半，看起來分量挺足的，我一個人吃不完。你的可麗餅看起來好精緻，草莓也是我喜歡的，能不能分我一小塊嘗嘗？",
        "gal_map_text_206100586=好呀好呀！我正想嘗嘗你的烤肉，看起來就超級香。給你，這個奶油一點都不膩，草莓也很甜，你肯定會喜歡。",
        "gal_map_text_206100587=桌上的美食散發著誘人的香氣，彼此分享的氛圍溫馨而自然。你知道敖靈既想吃烤肉的鹹香，又捨不得可麗餅的甜膩，此刻需要既滿足她的口味，又創造更親密的互動機會，讓氛圍更加曖昧 —— 你的選擇將直接讓她感受到你的細心與體貼。",
        "gal_map_text_206100588=喂她吃肉 + 共嘗甜點",
        "gal_map_text_206100589=混合搭配 + 分享感受",
        "gal_map_text_206100590=各自品嘗 + 偶爾交流",
        "gal_map_text_206100591=我喂你吃烤肉，你喂我吃可麗餅，怎麼樣？",
        "gal_map_text_206100592=敖靈主動湊近你，完全不介意這種親密的互動，指尖輕輕攥著衣角，帶著一絲緊張。",
        "gal_map_text_206100593=好！不過你喂我的時候小心點，烤肉有點燙。",
        "gal_map_text_206100594=敖靈直接張開嘴，語氣興奮。身體微微靠近，眼神專注地看著你，完全信任你的動作，眼底滿是自然的親近。",
        "gal_map_text_206100595=快喂我快喂我！我已經等不及想嘗嘗了，你可別燙到我～",
        "gal_map_text_206100596=敖靈嘴角露出一絲淺笑，聲音柔和。沒有拒絕，指尖輕輕拿著勺子，帶著一絲不好意思。",
        "gal_map_text_206100597=這樣會不會太親密了？其實我自己也可以吃的，不用麻煩你。",
        "gal_map_text_206100598=敖靈語氣帶著一絲羞澀，在你喂她時微微張開嘴，身體微微緊繃，卻沒有躲開。",
        "gal_map_text_206100599=好…… 聽你的。",
        "gal_map_text_206100600=小心燙，慢慢吃~~怎麼樣？味道還不錯吧？現在換你喂我吃可麗餅了。",
        "gal_map_text_206100601=哇，太好吃了！外焦裡嫩，一點都不膩。給你，這個草莓超級甜，你嘗嘗看。",
        "gal_map_text_206100602=敖靈吃下烤肉，臉頰瞬間染上紅暈，眼神裡滿是驚喜。拿起勺子舀了一塊可麗餅，遞到你嘴邊，語氣比之前更柔和",
        "gal_map_text_206100603=我們試試烤肉配可麗餅，會不會有驚喜？",
        "gal_map_text_206100604=敖靈動拿起一小塊烤肉放在可麗餅上，遞到你面前，眼底滿是期待。",
        "gal_map_text_206100605=這個主意好！烤肉的鹹香配可麗餅的甜膩，肯定很奇妙，我們趕緊試試～",
        "gal_map_text_206100606=敖靈拉著你的手，語氣急促卻興奮。身體微微靠近，眼底閃爍著分享的喜悅。",
        "gal_map_text_206100607=我們一起吃！我拿著可麗餅，你夾烤肉，這樣搭配肯定超級好吃～",
        "gal_map_text_206100608=敖靈神色平靜卻專注，在你搭配時認真配合，沒有多餘的言語。",
        "gal_map_text_206100609=可以試試，這種搭配確實挺新奇的，說不定會有意外的驚喜。",
        "gal_map_text_206100610=敖靈在你遞來搭配好的食物時，主動張開嘴吃下，眼神裡帶著一絲不易察覺的好奇，沒有拒絕你的提議。",
        "gal_map_text_206100611=隨便。",
        "gal_map_text_206100612=真的很奇妙！烤肉的咸香中和了可麗餅的甜膩，口感超級豐富。沒想到我們的想法這麼合拍，以後可以多嘗試這種新奇的搭配。",
        "gal_map_text_206100613=敖靈耳尖微紅，沒有避開你的目光。",
        "gal_map_text_206100614=我也覺得超級好吃！以前從來沒這麼搭配過，多虧了你提議。其實…… 和你一起分享美食，感覺比自己吃更開心。",
        "gal_map_text_206100615=我們先各自嘗嘗，等下再交換意見？",
        "gal_map_text_206100616=敖靈立刻點頭，拿起勺子舀了一塊可麗餅放進嘴裡，語氣輕快",
        "gal_map_text_206100617=好！我們先各自品嘗，等下比比誰的食物更好吃～",
        "gal_map_text_206100618=敖靈快速吃了一口烤肉，語氣調皮。眼神裡滿是狡黠，完全沉浸在比賽的樂趣中。",
        "gal_map_text_206100619=我的可麗餅超級好吃，你肯定比不過我！等下你可不許耍賴～",
        "gal_map_text_206100620=敖靈帶著堅定的神色，既享受美食又珍惜此刻的陪伴。",
        "gal_map_text_206100621=好，我們先慢慢品嘗，仔細感受味道，等下再好好交流。美食需要慢慢品味，不用著急。",
        "gal_map_text_206100622=敖靈輕輕敲了敲桌面，語氣沒有起伏，卻在你品嘗時悄悄觀察你的表情，眼神專注地看著你，想知道你的真實感受。",
        "gal_map_text_206100623=可以，我們開始吧。吃完後各自說說感受，客觀評價一下。",
        "gal_map_text_206100624=我的烤肉味道很不錯，外焦裡嫩，調味也剛剛好。你的可麗餅看起來也很好吃，現在可以交換意見了，你覺得怎麼樣？",
        "gal_map_text_206100625=的可麗餅也很好吃，草莓很甜，奶油也不膩。其實…… 不管誰的更好吃，和你一起品嘗，感覺都挺開心的。",
        "gal_map_text_206100626=敖靈輕輕放下勺子，耳尖微紅，眼神裡滿是笑意。",
        "gal_map_text_206100627=你們吃完了桌上的美食，彼此的臉上都帶著滿足的笑容。敖靈輕輕擦了擦嘴角，眼神裡滿是溫柔與依賴，主動拿起你剩下的一小塊烤肉，放進嘴裡：'今天真的謝謝你，不僅吃到了好吃的，還和你一起度過了這麼開心的時光。'",
        "gal_map_text_206100628=陽的餘暉灑在你們身上，美食的香氣混合著彼此的笑聲，氛圍愈發曖昧，指尖不經意的觸碰、眼神的交匯，都讓好感度持續升溫，為接下來的告白或下一次約會埋下了完美的伏筆。",
        "gal_map_text_206100629=店員友好提醒後，敖靈握著印滿 '愛' 之插畫與短詩的書，眼神閃爍地看向你：'雙人閱讀角…… 聽起來很安靜，要不要去看看？'",
        "gal_map_text_206100630=高大書架環抱的半開放式空間裡，雙人沙發間距極近，燈光柔和如薄紗，私密性足以讓彼此的呼吸都清晰可聞。",
        "gal_map_text_206100631=深棕色書架隔絕外界聲響，沙發柔軟得讓人陷進去，並肩而坐時手臂必然相互觸碰，傳遞著淡淡溫度。",
        "gal_map_text_206100632=插畫書攤開在小茶几上，'陪伴是無聲的告白''靠近是心的試探' 等短詩直白又戳人，暖黃色燈光落在書頁上，也映紅了敖靈微微泛紅的耳尖。",
        "gal_map_text_206100633=和你坐得這麼近看書，連空氣都變得不一樣了。這些關於 '愛' 的文字，有沒有說到你心裡去？",
        "gal_map_text_206100634=文字很細膩…… 有點不好意思細看，總覺得像在說我們現在的狀態。",
        "gal_map_text_206100635=店員離開後，房間裡只剩下翻書的輕響和彼此的呼吸聲。青龍指尖無意識地劃過書頁邊緣，目光在短詩上停留片刻，又快速移開，耳尖的紅暈順著脖頸悄悄蔓延。她嘗試往沙發內側挪了挪，想拉開一點距離，卻不小心讓肩膀更緊地貼住你的胳膊，瞬間僵住動作，連呼吸都放輕了幾分。插畫書上的文字像在精准戳中此刻的心境，讓空氣裡的曖昧因數愈發濃烈，此刻需要一個自然的舉動打破這份羞澀，讓互動順理成章。",
        "gal_map_text_206100636=指尖點詩 + 輕聲共鳴",
        "gal_map_text_206100637=側靠肩膀 + 共讀短詩",
        "gal_map_text_206100638=分享感悟 + 問她想法",
        "gal_map_text_206100639=輕合書本 + 聊插畫意",
        "gal_map_text_206100640=安靜陪伴 + 遞溫水",
        "gal_map_text_206100641=你看這句‘心近何須言’，像不像我們？",
        "gal_map_text_206100642=敖靈目光瞬間鎖定詩句，指尖精准點在相同位置，語氣清亮。",
        "gal_map_text_206100643=確實像！你看我們現在的狀態，一個眼神就懂彼此，和詩句裡寫的一模一樣。",
        "gal_map_text_206100644=敖靈愣了一下，低頭反復看詩句，語氣遲疑。",
        "gal_map_text_206100645=啊…… 是這樣嗎？我再看看…… 好像是有點像我們現在的感覺？",
        "gal_map_text_206100646=敖靈盯著詩句兩秒，轉頭看向你眼神雀躍。",
        "gal_map_text_206100647=我剛才就注意到這句了！還在想你會不會提，沒想到我們想到一塊兒去了，這默契也太絕了吧！",
        "gal_map_text_206100648=敖靈眼神茫然地看著詩句，沒捕捉到深層含義，單純認同你的觀點。",
        "gal_map_text_206100649=嗯？沒太懂…… 不過你這麼說，應該是吧",
        "gal_map_text_206100650=不管你有沒有立刻 get 到，只要你覺得像就好。和你在一起，就算反應慢一點，也覺得很可愛。",
        "gal_map_text_206100651=我也是…… 和你在一起，就算沒立刻明白你的意思，也覺得很安心。以後你可以多跟我說說這種感覺。",
        "gal_map_text_206100652=敖靈耳尖發燙，輕輕點頭。",
        "gal_map_text_206100653=靠我近點，我們一起讀這一段。",
        "gal_map_text_206100654=敖靈眼神充滿期待。興奮地往你身邊靠，腳尖輕點地面。",
        "gal_map_text_206100655=好呀好呀！這樣看得更清楚～ 你快讀，我已經準備好認真聽了，你的聲音讀詩肯定很好聽！",
        "gal_map_text_206100656=敖靈直接把頭靠在你肩膀上，拉著你的手晃了晃，完全卸下防備，依賴感拉滿。",
        "gal_map_text_206100657=太好啦！這樣更舒服～ 快讀快讀，讀完我們再找其他好聽的詩句，一起讀個夠！",
        "gal_map_text_206100658=敖靈不張揚卻主動配合，眼神專注地落在書頁上。",
        "gal_map_text_206100659=好。你讀吧，我聽著。",
        "gal_map_text_206100660=敖靈微微頷首，身體保持輕微距離，語氣平靜。情緒毫無波瀾，保持克制，僅禮貌配合著你。",
        "gal_map_text_206100661=可以。開始吧，我會認真聽的。",
        "gal_map_text_206100662=陪伴是最長情的告白，守護是最沉默的溫柔……不管你是活潑還是安靜，在我身邊就好。",
        "gal_map_text_206100663=嗯…… 你讀得很好聽。和你這樣一起讀詩，感覺很特別。",
        "gal_map_text_206100664=敖靈眼神軟化，輕聲回應，臉頰微紅。",
        "gal_map_text_206100665=你對哪句最有共鳴？說說你的理解。",
        "gal_map_text_206100666=敖靈翻到某一頁，指尖點在詩句上，語氣熱烈，主動與你分享感受。",
        "gal_map_text_206100667=我最認同‘真心藏在細節裡’！就像你之前幫我擋小貓、收拾東西，這些小事都特別打動人～",
        "gal_map_text_206100668=敖靈拉著你的手翻書，語氣急切又興奮。",
        "gal_map_text_206100669=我覺得‘默契是心的共鳴’最有道理！我們之前配合得那麼好，不就是最好的證明嗎？快跟我說說你最喜歡哪句！",
        "gal_map_text_206100670=敖靈淡淡頷首，眼神掠過詩句，無過多情緒，僅簡單表達觀點。",
        "gal_map_text_206100671=還行，有點道理。我對‘安靜的陪伴’比較有感覺。",
        "gal_map_text_206100672=敖靈眼神落在書頁上，輕聲道。",
        "gal_map_text_206100673=沒什麼特別的感覺。隨便哪句都可以。",
        "gal_map_text_206100674=不管你是熱情還是平靜，你的真實感受最重要。和你聊天，總能感受到你的真誠。",
        "gal_map_text_206100675=嗯…… 和你聊天，不用刻意偽裝，感覺很舒服。",
        "gal_map_text_206100676=敖靈耳尖微紅，輕輕點頭。摩挲著衣角，語氣比之前柔和了許多。",
        "gal_map_text_206100677=插畫比文字更動人，你覺得呢？",
        "gal_map_text_206100678=敖靈眼睛一亮，立刻點頭，眼睛一亮，指尖點在插畫上。",
        "gal_map_text_206100679=我覺得這幅相擁的插畫最動人！比文字更有衝擊力，一看就懂，特別浪漫。",
        "gal_map_text_206100680=敖靈把書往你面前推了推，語氣急切主動詢問你的想法。",
        "gal_map_text_206100681=你看這幅星空牽手圖！是不是超級浪漫？我以後也想和喜歡的人這樣散步，你覺得呢？",
        "gal_map_text_206100682=敖靈嘴角勾起淺笑，聲音柔和。",
        "gal_map_text_206100683=我覺得這幅安靜看書的插畫很美好，氛圍和我們現在很像，很溫馨。",
        "gal_map_text_206100684=敖靈眼神低垂，指尖輕蹭插畫，僅用模糊表述暗示，依賴你理解。",
        "gal_map_text_206100685=這幅光影交錯的畫…… 感覺很貼合現在的心情。",
        "gal_map_text_206100686=你說得對，好的插畫總能直擊人心。不過我覺得，有你在身邊，比任何插畫都更動人。",
        "gal_map_text_206100687=謝謝你…… 和你一起看畫，感覺更有意義了。",
        "gal_map_text_206100688=敖靈臉頰微紅，耳尖泛紅，快速移開目光。",
        "gal_map_text_206100689=不說話也挺好，喝口水慢慢看。",
        "gal_map_text_206100690=敖靈立刻接過水杯，語氣爽朗，熱情回應，主動延續氛圍。",
        "gal_map_text_206100691=好呀！謝謝你，正好有點渴了～ 我們慢慢看，不用著急，這樣的氛圍真好。",
        "gal_map_text_206100692=敖靈接過水杯喝了一口，拉著你的手。",
        "gal_map_text_206100693=還是你貼心！正好緩解一下看直白詩句的小尷尬～ 我們繼續慢慢看，有喜歡的就跟我說！",
        "gal_map_text_206100694=敖靈淡淡接過水杯，無多餘互動，喝完放在一邊繼續看書。",
        "gal_map_text_206100695=謝謝。",
        "gal_map_text_206100696=敖靈微微頷首，伸手接過水杯，沒有說話，喝完放在茶几上，目光重新落在書頁上。",
        "gal_map_text_206100697=...",
        "gal_map_text_206100698=不用客氣，慢慢看，不用著急。其實這樣安靜地陪著你，也很舒服。",
        "gal_map_text_206100699=...",
        "gal_map_text_206100700=輕輕點頭，沒有說話，卻悄悄往你身邊挪了挪",
        "gal_map_text_206100701=夕陽透過書架的縫隙灑進閱讀角，在你們身上鍍上一層溫暖的光暈。敖靈合上書，轉頭看向你，嘴角帶著淺淺的笑意：'今天在這裡待得很開心，謝謝你陪我讀這麼特別的書。'",
        "gal_map_text_206100702=敖靈的眼神裡滿是溫柔與依賴，肩膀依舊輕輕貼著你的肩膀，彼此的氣息交織在一起，曖昧的氛圍愈發濃厚。",
        "gal_map_text_206100703=你們沒有說破心意，卻在沉默的陪伴與互動中，讓心與心的距離更近了一步，為後續的相處埋下了更深的羈絆。",
        "gal_map_text_206100704=推開古堡最深處的大門，眼前沒有金銀財寶，只有一面雕刻著複雜符文的巨大落地鏡。鏡面光滑如冰，隱約能映照出你們的身影，卻又帶著一絲神秘的模糊感。",
        "gal_map_text_206100705=NPC 的聲音從暗處傳來：'這面鏡子能映照內心的真實，你們可以選擇共同面對，也可以獨自接受考驗。' 敖靈看著鏡子裡的倒影，眼神裡閃過一絲好奇與猶豫。藏寶室光線昏暗，只有鏡面反射出淡淡的微光，照亮了周圍牆壁上的古老壁畫。",
        "gal_map_text_206100706=落地鏡邊框的符文閃爍著微弱的金光，鏡面如同一潭深水，映照出你們的身影，卻似乎還藏著更深層的影像。空氣中彌漫著淡淡的神秘氣息，偶爾能聽到符文輕輕跳動的細微聲響，營造出既神聖又曖昧的氛圍。",
        "gal_map_text_206100707=看起來是考驗彼此信任的環節，你想共同面對，還是我先試試？不管你選什麼，我都陪著你。",
        "gal_map_text_206100708=我不想獨自面對，總覺得和你一起，不管看到什麼都更有勇氣。只是…… 有點擔心，鏡子會映照出什麼意想不到的東西。",
        "gal_map_text_206100709=NPC 的聲音消散後，房間裡陷入短暫的寂靜。青龍盯著鏡中彼此的倒影，指尖悄悄攥緊了包帶，指節微微泛白。她轉頭看向你，眼神裡帶著好奇卻又有些猶豫，腳步往前挪了半步，又下意識後退，顯然既想知道鏡子的秘密，又對'映照內心真實'有些忐忑。鏡面反射的微光映在她臉上，讓她眼底的糾結愈發明顯，此刻需要你的主動引領，幫她打消顧慮，共同面對這份未知。",
        "gal_map_text_206100710=牽手並肩 + 共同凝視",
        "gal_map_text_206100711=擁抱打氣 + 同步上前",
        "gal_map_text_206100712=詢問顧慮 + 耐心安撫",
        "gal_map_text_206100713=輕拍肩膀 + 鼓勵前行",
        "gal_map_text_206100714=先探虛實 + 再邀同行",
        "gal_map_text_206100715=牽著我的手，我們一起面對。",
        "gal_map_text_206100716=敖靈眼睛一亮，立刻伸出手握住你的手，微微用力，充滿好奇。",
        "gal_map_text_206100717=好呀好呀！牽著你的手，我就不害怕了～ 我們一起上前，看看鏡子裡到底藏著什麼秘密！",
        "gal_map_text_206100718=敖靈雙手緊緊攥住你的手腕，語氣興奮到幾乎蹦起來。",
        "gal_map_text_206100719=快牽緊我！我們一起沖！我倒要看看鏡子能映照出什麼，有你在我什麼都不怕～",
        "gal_map_text_206100720=敖靈輕輕伸出手握住你的手，語氣平和卻堅定，信任你的陪伴。",
        "gal_map_text_206100721=好。牽著你，我就有勇氣了。我們慢慢走，一起面對。",
        "gal_map_text_206100722=敖靈緩緩伸出手，指尖與你相觸，語氣平靜。",
        "gal_map_text_206100723=嗯。走吧，一起看看。",
        "gal_map_text_206100724=別緊張，不管鏡子裡映照出什麼，我都會陪著你。你看，鏡子裡的我們，是不是很默契？",
        "gal_map_text_206100725=嗯…… 很默契。有你在身邊，就算面對真實的自己，也覺得很安心。",
        "gal_map_text_206100726=敖靈看著鏡中牽手的身影，耳尖發燙",
        "gal_map_text_206100727=先抱一下攢勇氣，再一起看。",
        "gal_map_text_206100728=敖靈愣了一下，隨即張開雙臂抱住你，沒有一點忸怩。",
        "gal_map_text_206100729=好！抱一下攢夠勇氣，我們一起面對。",
        "gal_map_text_206100730=敖靈主動撲進你的懷裡，手臂緊緊環住你的腰。",
        "gal_map_text_206100731=這個主意太棒了！抱得緊一點，勇氣多一點～ 我們趕緊去看鏡子，我已經迫不及待了！",
        "gal_map_text_206100732=敖靈嘴角帶笑，猶豫片刻後輕輕抱住你，聲音柔和。",
        "gal_map_text_206100733=謝謝你…… 這樣真的感覺更有勇氣了。",
        "gal_map_text_206100734=敖靈眼神閃爍，輕輕靠近你，身體貼住你的手臂，沒有主動伸手，卻默許了你的擁抱，耳尖泛紅。",
        "gal_map_text_206100735=...",
        "gal_map_text_206100736=感受到勇氣了嗎？不管鏡子裡是什麼，有我陪著你。鬆開擁抱後，牽起她的手走向鏡子：你看，鏡子裡的我們，笑容都很安心。",
        "gal_map_text_206100737=嗯…… 有你這個 '勇氣 buff'，什麼都不怕了。和你並肩面對的感覺，真的很好。",
        "gal_map_text_206100738=敖靈看著鏡中彼此的身影，臉頰微紅。",
        "gal_map_text_206100739=你擔心映照出什麼？我陪你克服。",
        "gal_map_text_206100740=敖靈帶著堅定的神色，既不急躁也不拖延，語氣認真。",
        "gal_map_text_206100741=我有點擔心映照出我內心的小脆弱！平時總裝作很堅強，其實有時候也會害怕孤單。不過有你陪我，我就敢面對了～",
        "gal_map_text_206100742=敖靈拉著你的手晃了晃，語氣急切，渴望得到你的回應。",
        "gal_map_text_206100743=我怕鏡子照出我對你的依賴！其實跟你在一起後，我越來越不想獨自面對事情了，你會不會覺得我很黏人？",
        "gal_map_text_206100744=敖靈語氣平淡，不分享真實顧慮，保持距離。",
        "gal_map_text_206100745=沒什麼特別擔心的，就是覺得有點神秘。不管照出什麼，面對就好。",
        "gal_map_text_206100746=敖靈眼神掠過鏡子，刻意保持冷漠，輕聲道：",
        "gal_map_text_206100747=無所謂。照什麼都一樣，我沒什麼好怕的。",
        "gal_map_text_206100748=不管你是脆弱還是依賴，都是最真實的你，我都喜歡。有我在，不用假裝堅強，也不用怕黏人。",
        "gal_map_text_206100749=謝謝你…… 和你在一起，我好像可以不用一直偽裝自己了。",
        "gal_map_text_206100750=耳尖微紅，輕輕點頭",
        "gal_map_text_206100751=有我在，不管看到什麼都不怕。",
        "gal_map_text_206100752=敖靈立刻捕捉到你的語氣堅定，眼神亮了亮。",
        "gal_map_text_206100753=好！我相信你。其實我剛才注意到鏡子邊框的符文在發光，說不定沒那麼可怕，我們一起慢慢看。",
        "gal_map_text_206100754=敖靈盯著你的眼睛看了兩秒，語氣雀躍。",
        "gal_map_text_206100755=我就知道你會這麼說！你剛才的眼神特別堅定，讓我一下子就不害怕了～ 我們一起上前，我倒要看看它能照出什麼！",
        "gal_map_text_206100756=敖靈愣了一下，語氣遲疑。",
        "gal_map_text_206100757=真的嗎？可是鏡子看起來好神秘…… 那…… 那我們一起去看看吧，你可別騙我。",
        "gal_map_text_206100758=敖靈眼神茫然地看著你，單純跟隨你的決定。",
        "gal_map_text_206100759=哦…… 好。你說不怕就不怕吧，我跟著你走就好。",
        "gal_map_text_206100760=放心，我不會騙你。不管鏡子裡是什麼，我都會第一時間保護你。我們慢慢走，不用著急。",
        "gal_map_text_206100761=嗯…… 有你在，我就覺得很安心。",
        "gal_map_text_206100762=敖靈輕輕點頭，緊緊跟在你身邊",
        "gal_map_text_206100763=我先看一眼，安全了我們再一起。",
        "gal_map_text_206100764=敖靈立刻點頭，不拖泥帶水，信任你的判斷。",
        "gal_map_text_206100765=好！你先探探虛實，我在這裡等你。如果安全了，記得叫我一起過去。",
        "gal_map_text_206100766=敖靈拉住你的手，語氣急切，極度反對你的決定，堅持要共同面對。",
        "gal_map_text_206100767=不行不行！我不想在這裡等你，我要跟你一起去！就算有危險，我們也要一起面對，不能讓你一個人冒險！",
        "gal_map_text_206100768=敖靈嘴角帶笑，聲音柔和，希望你改變主意。",
        "gal_map_text_206100769=這樣…… 會不會太危險了？其實我們可以一起慢慢看，不用急著先探虛實。",
        "gal_map_text_206100770=敖靈眼神低垂，輕聲的說。",
        "gal_map_text_206100771=我…… 我不想一個人在這裡等。有點害怕。",
        "gal_map_text_206100772=好，聽你的，我們一起去。其實我也不想讓你一個人在這裡等，不管有什麼危險，我們都一起面對",
        "gal_map_text_206100773=嗯…… 和你一起，就算有危險，也覺得沒那麼可怕了。",
        "gal_map_text_206100774=敖靈耳尖泛紅，輕輕點頭。",
        "gal_map_text_206100775=你們並肩走到鏡子前，鏡面泛起淡淡的金光，映照出的不是什麼可怕的秘密，而是你們並肩而立、彼此凝望的身影，眼神裡滿是信任與溫柔。",
        "gal_map_text_206100776=NPC 的聲音再次傳來：'真正的勇氣，是願意與他人坦誠相對；真正的寶藏，是彼此的羈絆。' 敖靈看著鏡中與你相握的手，臉頰微紅，指尖輕輕用力：'謝謝你願意陪我一起面對。和你在一起，我好像變得更勇敢了。'",
        "gal_map_text_206100777=你們沒有說破心意，卻在彼此的眼神中看到了深深的羈絆，曖昧的氛圍愈發濃厚，為後續的相處埋下了完美的伏筆。",
        "gal_map_text_206100778=你們心滿意足地準備離開美食市集，路過一個賣特色特調飲品的攤位時，敖靈被一款造型夢幻的 '星空蘇打' 吸引了。",
        "gal_map_text_206100779=她轉身想跟你分享，卻不小心撞到了攤位邊緣，手中深藍色的飲料瞬間傾灑出來，大半都潑在了你的衣服上。敖靈的臉色瞬間變得慌張，眼神裡滿是歉意。",
        "gal_map_text_206100780=市集的燈光柔和，攤位上的各色飲品散發著誘人的香氣，周圍偶爾傳來遊客的歡聲笑語。深藍色的星空蘇打順著你的衣角滴落，在衣服上留下一片片夢幻的痕跡，帶著淡淡的甜味。",
        "gal_map_text_206100781=敖靈的臉頰漲得通紅，手足無措地看著你，眼神裡滿是愧疚，雙手下意識地想幫你擦拭，卻又怕弄巧成拙。",
        "gal_map_text_206100782=沒事沒事，別著急。就是一件衣服而已，洗乾淨就好了。你沒撞到自己吧？",
        "gal_map_text_206100783=對不起對不起！我太不小心了，光顧著看飲料，轉身沒注意到你…… 你的衣服都髒了，怎麼辦呀？",
        "gal_map_text_206100784=敖靈眼神裡滿是歉意，聲音帶著一絲顫抖。",
        "gal_map_text_206100785=輕拍肩膀 + 調侃化解",
        "gal_map_text_206100786=主動擁抱 + 安撫情緒",
        "gal_map_text_206100787=提議清洗 + 轉移話題",
        "gal_map_text_206100788=調侃飲料 + 拉近距離",
        "gal_map_text_206100789=淡定回應 + 續逛市集",
        "gal_map_text_206100790=你看，衣服都染上星空了，還挺特別。",
        "gal_map_text_206100791=敖靈愣了一下，隨即破涕為笑，被你的調侃帶動，瞬間放鬆。",
        "gal_map_text_206100792=真的！染上星空的痕跡還挺好看的～ 對不起呀，我剛才太慌張了，都沒注意到這麼特別的效果！",
        "gal_map_text_206100793=敖靈拉著你的手晃了晃，語氣興奮，極度熱情地想彌補。",
        "gal_map_text_206100794=對呀對呀！太特別了，簡直是獨一無二的‘星空衣服’！為了賠罪，我再去給你買一杯同款飲料，我們一起喝～",
        "gal_map_text_206100795=敖靈輕輕點頭，語氣平和卻帶著歉意。",
        "gal_map_text_206100796=確實挺特別的。不過還是對不起，讓你的衣服髒了。我去給你買包紙巾，你先擦擦吧。",
        "gal_map_text_206100797=敖靈冷靜地尋找解決方案，眼神平靜地看著衣服上的痕跡。",
        "gal_map_text_206100798=還好不算太髒。我去附近的便利店給你買瓶清潔劑，應該能擦掉。",
        "gal_map_text_206100799=你看，換個角度想，這還是意外的驚喜呢。不用特意彌補，你沒事就好。",
        "gal_map_text_206100800=嗯…… 謝謝你不怪我。和你在一起，再尷尬的事情都能變得很有趣。",
        "gal_map_text_206100801=敖靈耳尖微紅，輕輕點頭。",
        "gal_map_text_206100802=別自責了，抱一下就當賠罪啦。",
        "gal_map_text_206100803=敖靈愣了一下，隨即張開雙臂抱住你，沒有一點忸怩。",
        "gal_map_text_206100804=好！那我就抱一下賠罪啦～ 對不起，我剛才太不小心了。",
        "gal_map_text_206100805=敖靈主動撲進你的懷裡，手臂緊緊環住你的腰，語氣帶著一絲撒嬌。",
        "gal_map_text_206100806=對不起對不起！我真的不是故意的～ 抱久一點，你可不許再生氣啦！",
        "gal_map_text_206100807=敖靈嘴角帶笑，身體微微緊繃，帶著一絲羞澀，猶豫片刻後輕輕抱住你。",
        "gal_map_text_206100808=謝謝你不怪我…… 這樣抱一下，就當我賠罪了。",
        "gal_map_text_206100809=敖靈眼神閃爍，輕輕靠近你，身體貼住你的手臂，沒有主動伸手，卻用臉頰輕輕蹭了蹭你的肩膀。",
        "gal_map_text_206100810=對不起。",
        "gal_map_text_206100811=我從來就沒生氣過。能被你這樣抱著賠罪，就算衣服髒十次也願意。",
        "gal_map_text_206100812=你別這麼說…… 我以後會更小心的。不過，這樣抱著你，感覺很安心。",
        "gal_map_text_206100813=敖靈臉頰微紅，聲音悶悶的。",
        "gal_map_text_206100814=沒事，附近有洗手間，我去擦擦。",
        "gal_map_text_206100815=敖靈立刻點頭，主動陪同。",
        "gal_map_text_206100816=好！我跟你一起去！正好附近有便利店，我給你買包濕紙巾，再買瓶水，肯定能擦乾淨～",
        "gal_map_text_206100817=敖靈拉著你的手就往洗手間方向跑，迫切想彌補。",
        "gal_map_text_206100818=快走快走！我知道附近有個洗手間，裡面很乾淨～ 我幫你擦，一定能把衣服擦乾淨，不留下痕跡！",
        "gal_map_text_206100819=敖靈語氣平淡，不主動陪同，禮貌回應。",
        "gal_map_text_206100820=好。那你先去擦擦，我在這裡等你。擦完我們再走。",
        "gal_map_text_206100821=敖靈眼神掠過你的衣服，無任何關心，僅簡單回應。",
        "gal_map_text_206100822=嗯。去吧，我在這邊等你。",
        "gal_map_text_206100823=不用這麼麻煩，我自己去擦就好。你在這裡等我，別亂跑，我很快就回來。",
        "gal_map_text_206100824=嗯…… 對不起，給你添麻煩了。我會在這裡等你，不會亂跑的。",
        "gal_map_text_206100825=敖靈臉頰微紅，耳尖泛紅，輕輕點頭。",
        "gal_map_text_206100826=這飲料還挺黏，你幫我吹吹？",
        "gal_map_text_206100827=敖靈快速捕捉細節，立刻注意到你衣服上的飲料黏黏的，眼神亮了亮。",
        "gal_map_text_206100828=好！你別動，我幫你吹吹～ 這飲料確實挺黏的，吹一吹應該能快點幹。",
        "gal_map_text_206100829=敖靈盯著你衣服上的痕跡看了兩秒，語氣雀躍。",
        "gal_map_text_206100830=我就知道你會這麼說！這飲料黏糊糊的肯定不舒服，我幫你吹，再給你扇扇風，很快就幹了～",
        "gal_map_text_206100831=敖靈反應稍慢，不確定是否有用，卻還是願意幫忙，語氣遲疑。",
        "gal_map_text_206100832=吹一吹？有用嗎？那…… 那我幫你吹吹吧，希望能快點幹。",
        "gal_map_text_206100833=敖靈眼神茫然地看著你，完全沒明白為什麼要吹，卻還是乖乖地對著你的衣服吹了起來。",
        "gal_map_text_206100834=哦…… 好。",
        "gal_map_text_206100835=謝謝你，這樣吹一吹確實舒服多了。其實就算不幹也沒關係，能讓你這樣幫我吹吹，我已經很開心了。",
        "gal_map_text_206100836=不用謝…… 是我不小心把你的衣服弄髒的。能幫到你，我也很開心。",
        "gal_map_text_206100837=敖靈耳尖發燙，輕輕點頭。",
        "gal_map_text_206100838=小事而已，我們繼續逛逛？",
        "gal_map_text_206100839=敖靈立刻點頭，坦然表達歉意。",
        "gal_map_text_206100840=好！不過還是對不起，把你的衣服弄髒了。我們繼續逛逛，我再給你買個好吃的賠罪！",
        "gal_map_text_206100841=敖靈拉著你的手就往前逛，想用美食彌補。",
        "gal_map_text_206100842=好呀好呀！我們繼續逛～ 前面還有個賣烤紅薯的攤位，我給你買個最大的，超級甜，就當賠罪啦！",
        "gal_map_text_206100843=敖靈委婉回應，尊重你的決定，帶著一絲愧疚。",
        "gal_map_text_206100844=好…… 不過真的很對不起，你的衣服都髒了。我們慢慢逛，如果你想先回去洗衣服，我們也可以現在走。",
        "gal_map_text_206100845=敖靈完全尊重你的決定，不主動表達想法，帶著愧疚。",
        "gal_map_text_206100846=嗯…… 都聽你的。如果你覺得不舒服，我們可以現在回去。",
        "gal_map_text_206100847=我真的不介意衣服髒了。能和你繼續逛逛市集，比什麼都重要。我們慢慢走，看看還有什麼好吃的。",
        "gal_map_text_206100848=嗯…… 謝謝你。和你在一起，就算犯了錯誤，也覺得很安心。",
        "gal_map_text_206100849=敖靈臉頰微紅，耳尖泛紅，快速移開目光。",
        "gal_map_text_206100850=你們繼續在市集裡閒逛，衣服上的星空痕跡漸漸變幹，卻成了彼此心照不宣的小秘密。敖靈時不時偷偷看向你，眼神裡滿是溫柔與歉意，偶爾會主動拉著你的手，帶你去看她覺得有趣的攤位。",
        "gal_map_text_206100851=夕陽西下，市集的燈光愈發溫暖，你們並肩走在回家的路上，彼此的身影被拉得很長。敖靈輕聲道：'今天真的很開心，謝謝你一直包容我。和你在一起，不管發生什麼意外，都覺得很幸福。",
        "gal_map_text_206100852=你們沒有說破心意，卻在並肩而行的腳步中，感受到了彼此越來越近的心，曖昧的羈絆愈發深厚，為後續的階段鋪墊了完美的情感基礎。",
        "gal_map_text_206100853=暖黃燈光溫柔地灑在皮質封面的空白筆記本上，燙金 '故事的開端' 字樣在光線下格外亮眼，邊緣還點綴著細膩的壓紋。兩支墨藍鋼筆並排擺放在筆記本旁，筆帽上刻著簡約的枝葉花紋，筆身泛著啞光質感。",
        "gal_map_text_206100854=周圍是輕柔的翻書聲與濃郁的咖啡香交織，店員退開後，這個靠窗的私密角落只剩下彼此的呼吸聲，氛圍曖昧而靜謐，連窗外的落葉都仿佛放慢了飄落的速度。",
        "gal_map_text_206100855=友善的店員端著託盤走來，輕輕放下筆記本和鋼筆，微笑著說：'這是我們為有緣的客人準備的‘故事的開端’筆記本，兩位有興趣，成為新故事的共同作者嗎？'",
        "gal_map_text_206100856=說完便貼心地轉身離開，留下你們對視一笑，空氣中滿是心照不宣的悸動，連指尖都忍不住微微發麻。",
        "gal_map_text_206100857=故事的開端'，這個名字太懂氛圍了。你想寫點藏在心裡的心事，還是畫點屬於我們的小默契？不管你選什麼，我都陪著你一起完成。",
        "gal_map_text_206100858=我也覺得這個筆記本很有意義…… 只是有點不好意思下筆，畢竟是‘共同作者’，怕寫得太直白破壞了這份溫柔的感覺，畫畫又沒什麼天賦，怕畫不好。不如你先提議，我跟著你的節奏來？",
        "gal_map_text_206100859=你看著她微微猶豫、眼神裡帶著期待與羞澀的模樣，指尖不經意間碰到了敖靈放在桌沿的手背。敖靈的身體下意識蜷縮了一下，卻沒有躲開，反而輕輕繃緊了指尖，像是在期待更多的觸碰。空白的筆記本就像一張待填的心動答卷，每一筆、每一畫都將成為彼此心照不宣的秘密，此刻需要用溫柔的選擇打破這份羞澀，讓共同創作成為拉近彼此距離的羈絆催化劑。",
        "gal_map_text_206100860=寫雙向心意短句",
        "gal_map_text_206100861=畫默契雙人剪影",
        "gal_map_text_206100862=貼共同回憶貼紙",
        "gal_map_text_206100863=我們各自寫一句想對彼此說的心裡話，不用太長，真誠就好，怎麼樣？",
        "gal_map_text_206100864=敖靈筆尖在紙上快速滑動，寫完後故意把本子往你面前推了推，耳尖泛紅得更明顯了，眼神卻帶著坦蕩的期待。",
        "gal_map_text_206100865=好！這個主意好，直接又真誠，我喜歡！我先來寫，你可不許偷偷看我的內容！",
        "gal_map_text_206100866=敖靈毫不猶豫地低頭寫完句子，甚至沒等墨水完全幹透就立刻推到你面前，眼神亮晶晶的。",
        "gal_map_text_206100867=我寫完啦！該你了該你了，快點寫，我已經迫不及待想知道你想對我說什麼了！",
        "gal_map_text_206100868=敖靈嘴角帶著淺淺的笑意，筆尖懸在紙上猶豫了幾秒，寫完後快速合上筆記本，指尖按住封面，不敢與你對視，臉頰卻悄悄發燙。",
        "gal_map_text_206100869=這樣會不會太直白了？萬一…… 萬一我們寫的心意不一樣怎麼辦？不過…… 確實很有意義，我儘量寫得含蓄一點，希望你能懂。",
        "gal_map_text_206100870=敖靈眼神一直低垂著，盯著筆記本的空白頁面，臉頰泛著薄紅，把本子推給你時，指尖輕輕顫抖了一下，快速收回手，放在身後悄悄攥緊了衣角。",
        "gal_map_text_206100871=好…… 那我寫得簡單一點，就幾個字。希望你能明白我的意思，不要誤會就好。",
        "gal_map_text_206100872=遇見你是意外的美好驚喜'，和我心裡想的一模一樣。我寫的是'和你相處的每一刻，都值得好好珍藏'",
        "gal_map_text_206100873=原來你也這麼想…… 我還以為只有我一個人有這種感覺。其實我還有很多話，沒好意思寫下來，感覺寫多了會太貪心。",
        "gal_map_text_206100874=敖靈看著你寫下的句子，臉頰發燙得更厲害了，眼神裡滿是欣喜與羞澀。",
        "gal_map_text_206100875=不如我們畫彼此的側影，不用任何言語，讓剪影代替心意，這樣更浪漫也更含蓄。",
        "gal_map_text_206100876=敖靈立刻點頭，拿起筆在紙上輕輕比劃了一下，眼神快速捕捉你的側臉輪廓，筆尖流暢地勾勒起來，時不時抬頭看你兩眼，眼神專注又認真。",
        "gal_map_text_206100877=沒問題！我剛才就注意到你的側影很好看，下頜線很清晰，一定能畫得很像。你也可以仔細觀察我的輪廓，不用怕畫錯，有偏差才更有專屬感。",
        "gal_map_text_206100878=敖靈甚至沒等你完全回應就已經開始動筆，筆尖在紙上沙沙作響，眼神緊緊盯著你的輪廓，下筆果斷，嘴角還帶著藏不住的笑意。",
        "gal_map_text_206100879=我已經在腦海裡有畫面了！你別動，保持這個姿勢，我畫你的側臉，你畫我的正臉，這樣我們的剪影就能面對面，更有默契～",
        "gal_map_text_206100880=敖靈愣了一下，拿著筆在紙上輕輕畫了幾道橫線，有些不好意思地撓了撓頭，筆尖猶豫地移動著，時不時抬頭偷看你的側臉，又快速低下頭修改，眼神裡滿是緊張。",
        "gal_map_text_206100881=畫剪影啊…… 我不太會畫畫，平時連簡筆劃都畫不好，只能儘量勾勒大概的輪廓，你可別笑話我畫得醜。",
        "gal_map_text_206100882=敖靈眼神茫然地看著你，又低頭看了看筆記本，說話時帶著一絲依賴，眼神裡滿是無措，完全需要你的引導。",
        "gal_map_text_206100883=我從來沒畫過剪影…… 完全不知道該從哪裡下手。要不我們對著旁邊的窗戶玻璃，看著影子畫？這樣能看得清楚一點，不容易出錯。",
        "gal_map_text_206100884=你畫的我很傳神，尤其是眼神的輪廓，雖然只是簡單的線條，卻好像能看出我的情緒，太懂我了。我畫的你，帶著淺淺的微笑，和我心裡記住的樣子一模一樣。",
        "gal_map_text_206100885=我們畫得好像情侶剪影…… 其實我故意把你的剪影畫得離我近了一點，幾乎要靠在一起，希望你別介意我的小小心思。",
        "gal_map_text_206100886=敖靈看著筆記本上兩幅依偎在一起的剪影，臉頰泛起淡淡的紅暈，眼神裡滿是溫柔。",
        "gal_map_text_206100887=我口袋裡帶了幾張小貼紙，有今天見過的小貓、咖啡杯圖案，我們一起貼出今天的時光軌跡，把回憶定格在本子裡？",
        "gal_map_text_206100888=敖靈眼睛亮晶晶地看著你，語氣裡滿是興奮，身體不自覺地湊近。",
        "gal_map_text_206100889=好呀好呀！我最喜歡貼貼紙了～ 快拿出來看看，有沒有我喜歡的小貓圖案！我們一起貼出今天的路線，從見面到喝咖啡，再到現在一起寫筆記本，把每一個瞬間都記錄下來！",
        "gal_map_text_206100890=敖靈直接拉著你的手翻找你口袋裡的貼紙，語氣興奮得像個孩子。",
        "gal_map_text_206100891=太好啦！我就知道你會帶這些小驚喜～ 快拿出來快拿出來！我們貼小貓、貼咖啡杯、貼書店的書架，把這一頁都貼滿我們的回憶，以後翻開就能想起今天的快樂！",
        "gal_map_text_206100892=敖靈動拿起一張咖啡圖案的貼紙，眼神專注地看著筆記本，慢慢擺放位置",
        "gal_map_text_206100893=這個主意很溫馨。我們慢慢貼，邊貼邊回憶今天發生的趣事，比如剛才那只調皮的小貓跳到你身上，還有你幫我遞紙巾的樣子，這樣也挺好的。",
        "gal_map_text_206100894=敖靈情緒毫無波瀾，只是在貼貼紙時，會悄悄把代表自己的貼紙和你的貼得近一點，動作很細微卻很認真。",
        "gal_map_text_206100895=可以。貼紙能讓回憶更具體，看到圖案就能想起當時的場景，貼完後我們各自簽名紀念就好，不用太複雜。",
        "gal_map_text_206100896=這個小貓貼紙代表剛才搗亂的小傢伙，也代表我們的相遇充滿了這樣的小驚喜。你貼的咖啡貼紙，顏色和你今天喝的拿鐵一樣，和你這個人一樣甜。",
        "gal_map_text_206100897=我把所有貼紙都貼得很近，就像我們今天一直待在一起一樣…… 以後看到這個筆記本，就能想起今天的溫暖和輕鬆，還有你說過的每一句話。",
        "gal_map_text_206100898=敖靈耳尖泛紅，輕輕點頭，指尖輕輕按壓貼紙邊緣。",
        "gal_map_text_206100899=筆記本上的字跡或剪影、貼紙靜靜躺在頁面上，一剛一柔、一明一暗，相映成趣。你們並肩坐著，一起看著彼此共同完成的 '作品'，沒有多言，卻在眼神交匯的瞬間讀懂了所有未盡之語。",
        "gal_map_text_206100900=敖靈輕輕合上筆記本，小心翼翼地放進自己的包中，指尖摩挲著封面說：'我會好好保存這個筆記本，這是我們一起寫下的第一個故事，以後還要一起補充更多內容。'",
        "gal_map_text_206100901=暖光落在她的發梢，映出一層柔和的光暈，曖昧的氛圍在沉默中愈發濃厚，心與心的距離又拉近了一大步。",
        "gal_map_text_206100902=文創貨架前，一款名為 '我們的記憶' 的文創拼圖格外顯眼。拼圖的包裝盒精緻典雅，封面印著世界名畫《彼此的彼此》，畫面中一對身影並肩凝望，背景是暖色調的星空，與你們此刻的氛圍格外契合。",
        "gal_map_text_206100903=拼圖的片數不多，剛好適合雙人合作完成，盒身上還印著一行小字：'拼湊共同的記憶，定格心動的瞬間'，仿佛為你們量身定制一般。周圍的文創產品琳琅滿目，卻都不及這副拼圖讓人心動，店鋪的暖光映在盒面上，反射出柔和的光暈。",
        "gal_map_text_206100904=你們並肩逛著文創區，敖靈的目光突然被貨架上的拼圖吸引，腳步不自覺地停下，指尖輕輕劃過包裝盒上的畫作，眼神裡滿是喜愛與嚮往。",
        "gal_map_text_206100905=敖靈轉頭看向你，嘴角帶著淺淺的笑意，卻又帶著一絲猶豫：'這幅畫…… 叫《彼此的彼此》，畫面好溫暖，感覺特別有意義。' 語氣裡藏著想要嘗試的期待，卻又不好意思主動開口提議。",
        "gal_map_text_206100906=這幅拼圖的名字和圖案都像為我們量身定做的一樣，《彼此的彼此》，剛好契合我們現在的狀態。要不要一起拼完它？拼好後可以放在家裡的雙人閱讀角，每次看到都能想起今天的時光。",
        "gal_map_text_206100907=我真的很喜歡這幅拼圖…… 只是拼拼圖需要靠得很近，怕打擾到你，也怕自己太笨拙，拼得很慢拖你的後腿，影響你的體驗。",
        "gal_map_text_206100908=你看著敖靈眼底藏不住的喜愛與一絲猶豫，伸手輕輕拿起拼圖盒，指尖不經意間碰到了她的手背。敖靈沒有躲開，反而輕輕攥了攥你的袖子，指尖帶著一絲緊張的溫度。拼圖就像你們此刻的心意，零散卻又有著內在的聯繫，需要彼此默契配合才能拼湊完整，每一片拼圖的契合，都是心動的證明。此刻需要用溫柔的行動打消她的顧慮，讓雙人合作拼圖成為彼此親密互動的絕佳藉口。",
        "gal_map_text_206100909=寫未來約會約定",
        "gal_map_text_206100910=抄心動詩句互贈",
        "gal_map_text_206100911=畫手心秘密符號",
        "gal_map_text_206100912=留空白共同簽名",
        "gal_map_text_206100913=我們把下次約會的地點寫在拼圖背面，拼完之後一起揭曉，當作彼此的約定怎麼樣？",
        "gal_map_text_206100914=敖靈語氣輕快，主動拿起筆，眼神裡滿是期待，已經開始在腦海裡構思約會地點。",
        "gal_map_text_206100915=好呀好呀！這個想法太有儀式感了～ 我們把下次約會的地點寫在拼圖背面，拼完之後一起翻開看，想想都覺得很浪漫！",
        "gal_map_text_206100916=敖靈甚至拉著你的手翻看拼圖背面，語氣急促又雀躍。",
        "gal_map_text_206100917=快寫快寫！我們約定下次去市中心的印象派畫展怎麼樣？我早就想去看了，只是一直沒找到合適的人一起，和你一起肯定更開心～",
        "gal_map_text_206100918=敖靈神色平靜，卻主動將拼圖背面朝向你，方便你書寫，指尖還輕輕撫平了背面的褶皺。",
        "gal_map_text_206100919=可以，這樣也算給下次見面一個明確的理由。我沒什麼意見，你定地點就好，我都可以配合。",
        "gal_map_text_206100920=敖靈在你寫完後，認真地拿起筆，簽下自己的名字，字跡工整有力，沒有多餘的言語，卻在簽名時停頓了兩秒，似乎在確認約會地點。",
        "gal_map_text_206100921=隨便。",
        "gal_map_text_206100922=我寫的是'下次一起去看印象派畫展'，上次聊天時你提過喜歡莫内的作品，我一直記在心裡。你的名字簽得真好看，和你這個人一樣，乾淨又有氣質。",
        "gal_map_text_206100923=原來你記得我隨口提過的話…… 我真的很想去看這場畫展，只是一直沒好意思說。等拼完拼圖，我們就把這個約定記在心裡，到時候不見不散。",
        "gal_map_text_206100924=敖靈看著你寫的約定，耳尖泛起淡淡的紅暈，眼神裡滿是驚喜與感動。",
        "gal_map_text_206100925=我們各自摘抄一句喜歡的心動詩句，寫在拼圖的邊緣，當作送給彼此的小禮物，你覺得可以嗎？",
        "gal_map_text_206100926=敖靈立刻點頭，拿起筆，眼神裡滿是篤定。快速回憶詩句，筆尖流暢地在拼圖邊緣書寫，眼神專注又認真。",
        "gal_map_text_206100927=沒問題！我剛好記得一句很喜歡的詩句，和這幅拼圖的氛圍超級配，我現在就寫給你，你肯定也會喜歡。",
        "gal_map_text_206100928=敖靈甚至沒等你反應就已經開始動筆，語氣裡帶著一絲小得意。",
        "gal_map_text_206100929=我知道你也喜歡葉芝的詩，我抄'多少人愛你青春歡暢的時辰'，你抄下一句'愛慕你的美麗，假意或真心'，怎麼樣？這樣我們的詩句就能湊成一對，特別有意義！",
        "gal_map_text_206100930=敖靈筆尖猶豫地移動著，時不時抬頭看向你，想從你的眼神裡尋求一點建議。",
        "gal_map_text_206100931=摘抄詩句啊…… 我得好好想想哪句合適，既要貼合現在的氛圍，又不能太直白，你別著急，我慢慢想。",
        "gal_map_text_206100932=敖靈完全不知道如何下手，語氣裡帶著一絲依賴，眼神裡滿是無措。",
        "gal_map_text_206100933=我不太記得具體的詩句了，平時很少摘抄…… 要不你先抄，我照著你的風格選一句，儘量和你呼應？",
        "gal_map_text_206100934=我抄的是'我將永遠愛你，用我的靈魂'，和你在一起的每一刻，都讓我覺得這句話格外貼切，這份心意是發自內心的。你的字跡真清秀，和你給人的感覺一樣，溫柔又細膩。",
        "gal_map_text_206100935=這句詩也是我很喜歡的，只是一直沒機會和別人分享…… 原來我們的喜好這麼相似，感覺又多了一點默契。以後每次看到這幅拼圖，就能想起這首詩，想起今天的溫柔與心動。",
        "gal_map_text_206100936=敖靈看著你抄的詩句，臉頰泛起淡淡的紅暈，眼神裡滿是動容。",
        "gal_map_text_206100937=我們先在彼此的手心畫一個只有我們知道的秘密符號，然後把符號記在拼圖的角落，作為專屬標記？",
        "gal_map_text_206100938=敖靈立刻點頭，毫不猶豫地伸出手心，掌心向上對著你，眼神裡滿是期待，掌心微微發熱。",
        "gal_map_text_206100939=好！這個主意很特別，我們在彼此的手心畫符號，然後記在拼圖上，以後看到這個符號就知道是我們的秘密，別人都不懂。",
        "gal_map_text_206100940=敖靈身體緊緊靠近你，直接伸手握住你的手，在你手心輕輕畫了起來，手心的溫度相互傳遞，眼神裡滿是雀躍，語氣興奮不已。",
        "gal_map_text_206100941=我畫的是星星符號，代表今天的心情就像星星一樣明亮！你快畫你的秘密符號，我們趕緊記在拼圖上，以後這就是我們的專屬暗號～",
        "gal_map_text_206100942=敖靈嘴角帶著淺淺的笑意，猶豫片刻後慢慢伸出手心，聲音柔和得像輕聲呢喃。",
        "gal_map_text_206100943=這樣會不會太親密了？手心是很私密的地方…… 不過…… 確實很有意義，能留下專屬我們的秘密。我畫得簡單一點，你別笑話我畫得不好看。",
        "gal_map_text_206100944=敖靈手心微微出汗，畫符號時快速閉上眼，不敢直視你，臉頰卻紅得像熟透的蘋果。",
        "gal_map_text_206100945=好…… 聽你的安排。只是手心有點敏感，可能會有點緊張，你畫的時候輕一點。",
        "gal_map_text_206100946=我畫的是月亮符號，和你畫的星星很配，星星月亮永遠不會分離，就像我們現在這樣。我們把這兩個符號一起畫在拼圖的角落，作為我們之間的秘密標記，以後看到就想起今天的手心相觸。",
        "gal_map_text_206100947=星星配月亮，真的很搭…… 這個秘密符號，只有我們兩個人知道，是屬於我們的小默契。以後不管過多久，看到它，就會想起今天手心相觸的溫度和心跳的感覺。",
        "gal_map_text_206100948=敖靈感受著手心殘留的觸感，臉頰發燙得厲害，眼神裡滿是羞澀與歡喜",
        "gal_map_text_206100949=我們先在拼圖上簽下彼此的名字，剩下的空白留給未來，以後每次見面都補充一點故事，慢慢把它填滿？",
        "gal_map_text_206100950=敖靈情緒高漲，主動拿起筆，快速簽下自己的名字，字跡圓潤可愛。",
        "gal_map_text_206100951=好呀好呀！我們先在拼圖上簽下彼此的名字，把名字挨在一起，以後每次想起今天，都能補一點小故事上去，慢慢把這片空白填滿，讓它成為我們的回憶合集～",
        "gal_map_text_206100952=敖靈身體緊緊依賴著你，筆尖同時落在拼圖上，留下兩個挨得極近的名字。",
        "gal_map_text_206100953=快簽快簽！我們的名字要寫得近一點，緊緊挨著，就像我們今天一直待在一起一樣～ 以後補故事的時候，我要寫滿和你有關的趣事，比如你剛才幫我撿筆的樣子，還有喂小貓的溫柔模樣！",
        "gal_map_text_206100954=敖靈認真地簽下自己的名字，眼神專注地看著筆尖，動作緩慢而鄭重。",
        "gal_map_text_206100955=這個主意不錯，留點空白給未來，不用一下子填滿，慢慢積累回憶才更有意義。簽名就好，不用太複雜，簡單的紀念反而更長久。",
        "gal_map_text_206100956=敖靈情緒毫無波瀾，簽下名字後，將拼圖放在一邊，卻悄悄記住了簽名的位置，指尖還輕輕碰了碰你的名字。",
        "gal_map_text_206100957=可以。簽名作為紀念就足夠了，以後要不要補故事都無所謂，重要的是當下的陪伴。",
        "gal_map_text_206100958=我們的名字挨在一起，真的很般配，就像天生就該放在一起一樣。以後不管什麼時候，看到這個簽名，就能想起今天一起拼拼圖的時光，安靜又美好。",
        "gal_map_text_206100959=嗯…… 這是我們共同的紀念，是屬於我們的小秘密。以後就算過很久，看到它，也會想起今天的陽光、咖啡香，還有和你在一起的溫柔與默契。",
        "gal_map_text_206100960=敖靈看著拼圖上挨在一起的名字，耳尖泛紅，眼神裡滿是溫柔。",
        "gal_map_text_206100961=在你們的默契配合下，拼圖漸漸成型，《彼此的彼此》的圖案在暖光下愈發清晰，畫面中並肩凝望的身影，仿佛就是你們此刻的寫照。拼圖背面的約定、邊緣的詩句、角落的秘密符號或挨在一起的簽名，都成為了你們專屬的甜蜜印記。",
        "gal_map_text_206100962=敖靈看著完整的拼圖，轉頭看向你，嘴角揚起淺淺的笑意，眼神裡滿是溫柔：'拼完拼圖的感覺真好，就像我們的心意，從零散到完整，慢慢拼湊在一起。'",
        "gal_map_text_206100963=暖光落在拼圖上，也落在你們相觸的指尖，曖昧的氛圍在沉默中愈發濃厚，為接下來的階段埋下了深深的羈絆。",
        "gal_map_text_206100964=魔鏡的光芒漸漸消散後，你們瞬間置身於一座懸於空中的花園。腳下是柔軟得像雲朵一樣的青草，踩上去毫無壓力，周圍點綴著許多不知名的發光花朵，花瓣散發著淡淡的藍綠色光暈，照亮了周圍的環境。遠處是雲霧繚繞的虛空，仿佛一腳踏空就會墜入無盡深淵，卻又因為身邊有彼此而感到安心。",
        "gal_map_text_206100965=花園中央躺著一個古樸的寶箱，箱體由深色木材製成，上面刻著複雜的藤蔓花紋，花紋縫隙中還鑲嵌著細小的發光晶石。寶箱沒有任何鎖孔，只有兩個清晰的掌印，大小剛好適配你們的手掌，掌印周圍泛著柔和的微光。",
        "gal_map_text_206100966=魔鏡的聲音在虛空中響起，帶著一絲神秘的韻味：'寶箱的秘密需要兩顆真誠的心共同開啟，掌印相合，心意相通，方能見其真容。若心意不齊，便只能空手而歸。'",
        "gal_map_text_206100967=敖靈看著寶箱上的掌印，眼神裡滿是好奇與猶豫，下意識地看向你，似乎在尋求勇氣與確認，指尖緊緊攥著衣角，帶著一絲緊張。",
        "gal_map_text_206100968=心意相通才能開啟，聽起來很浪漫，也很有意義。我們一起試試？不管裡面藏著什麼寶貝，或者只是一個普通的道具，只要有你在身邊，這段經歷就很珍貴。",
        "gal_map_text_206100969=嗯…… 我也想知道裡面藏著什麼秘密，只是有點擔心，我們的心意真的能相通嗎？畢竟我們認識的時間還不算太長，會不會達不到要求？",
        "gal_map_text_206100970=你看著敖靈微微猶豫、眼神裡滿是信任與依賴的模樣，伸手輕輕握住敖靈的手腕。敖靈的身體微微一顫，卻沒有躲開，反而輕輕放鬆了緊繃的肌肉，指尖甚至悄悄勾了勾你的手心。寶箱上的掌印在發光花朵的映照下泛著柔和的微光，仿佛在催促你們靠近、嘗試。",
        "gal_map_text_206100971=掌心相對 + 同步按印",
        "gal_map_text_206100972=輕聲告白 + 按印",
        "gal_map_text_206100973=數節奏 + 默契按印",
        "gal_map_text_206100974=我們先掌心相對，感受彼此的溫度與心意，然後一起將手掌按在掌印上，同步發力，怎麼樣？",
        "gal_map_text_206100975=敖靈立刻點頭，毫不猶豫地掌心向上對著你，眼神裡滿是坦蕩。",
        "gal_map_text_206100976=好！我們掌心相對，這樣就能直接感受到彼此的溫度和心意，心意相通肯定能開啟寶箱。我已經準備好了，我們現在就開始吧！",
        "gal_map_text_206100977=敖靈直接將掌心緊緊貼在你的掌心，手指還輕輕扣住了你的手指，語氣興奮不已。",
        "gal_map_text_206100978=快貼緊一點！讓我們的心意通過掌心完全傳遞給彼此，也傳遞給寶箱！我們一起按下去，看看裡面到底藏著什麼寶貝～ 我已經等不及了！",
        "gal_map_text_206100979=敖靈嘴角帶著淺淺的笑意，猶豫片刻後慢慢伸出掌心，聲音柔和得像輕聲細語。",
        "gal_map_text_206100980=這樣會不會太親密了？畢竟我們還沒有那麼熟悉…… 不過…… 為了開啟寶箱，也為了驗證我們的心意，試試也沒關係。",
        "gal_map_text_206100981=敖靈眼神一直低垂著，不敢看你，慢慢伸出掌心，指尖微微顫抖。",
        "gal_map_text_206100982=好…… 聽你的安排。只是掌心相觸會有點緊張，你別介意我手心出汗。",
        "gal_map_text_206100983=你的掌心好暖，和你的人一樣，讓人覺得安心又舒服。我們一起慢慢按下去，不管結果如何，能和你一起體驗這個過程就很滿足了。",
        "gal_map_text_206100984=你的掌心也很暖，很有力量…… 好像真的有心意在我們之間傳遞，讓我覺得很安心。希望我們的心意能被寶箱感受到，順利開啟它的秘密。",
        "gal_map_text_206100985=敖靈感受著你掌心的溫度和力度，臉頰發燙，心跳加速",
        "gal_map_text_206100986=在按下去之前，我想對你說幾句心裡話，這些話都藏在我的掌心裡，等下一起傳遞給寶箱，也傳遞給你。",
        "gal_map_text_206100987=敖靈語氣輕快活潑，主動將掌心放在寶箱的掌印旁，身體微微前傾，專注地看著你。",
        "gal_map_text_206100988=好呀好呀！我也有很多心裡話想對你說，正好借著這個機會告訴你，讓寶箱一起見證我們的心意！我已經準備好了，你先說，我聽著！",
        "gal_map_text_206100989=敖靈身體緊緊挨著你，眼神發亮地看著你，眼底的期待幾乎要溢出來。",
        "gal_map_text_206100990=快說快說！我已經迫不及待想知道你心裡想對我說什麼了～ 不管你說什麼，我都很開心！說完我們一起按下去，開啟屬於我們的秘密寶箱！",
        "gal_map_text_206100991=敖靈神色平靜，卻主動將身體向你靠近了一點，方便聽你說話，指尖還輕輕摩挲著寶箱的邊緣。",
        "gal_map_text_206100992=可以，有話就說吧，我會認真聽的。說完我們就一起按印，看看寶箱的秘密到底是什麼。",
        "gal_map_text_206100993=敖靈在你準備說話時，認真地抬起頭看著你的眼睛，眼神專注而認真，沒有任何多餘的動作，卻讓人感受到她的重視。",
        "gal_map_text_206100994=嗯。",
        "gal_map_text_206100995=和你在一起的每一刻，都讓我覺得很安心、很快樂。不管是一起逛書店、拼拼圖，還是現在一起挑戰密室，只要有你在身邊，平凡的時光都變得特別有意義。我希望以後能有更多這樣的時光，和你一起探索更多未知的美好。現在，我們一起按下去吧。",
        "gal_map_text_206100996=我也是…… 和你在一起的每一天都很開心，你總能注意到我的小喜好，給我很多驚喜和溫暖。謝謝你願意對我說出心裡話，這些話我也一直想對你說。我們一起按下去，開啟寶箱的秘密。",
        "gal_map_text_206100997=敖靈聽著你的告白，耳尖泛紅，臉頰發燙，眼神裡滿是動容與歡喜。",
        "gal_map_text_206100998=我們不用想太多，我數 1、2、3，數到 3 的時候我們一起將手掌按下去，相信我們的默契，一定能成功。",
        "gal_map_text_206100999=敖靈情緒高漲，掌心輕輕放在寶箱的掌印旁，身體微微繃緊，專注地等待你的指令。",
        "gal_map_text_206101000=好呀好呀！數節奏按印太有意思了，肯定能考驗我們的默契～ 你快數，我已經準備好了，保證和你同步按下去，不會出錯的！",
        "gal_map_text_206101001=敖靈拉著你的手一起放在寶箱的掌印旁，指尖輕輕晃動，語氣興奮不已。",
        "gal_map_text_206101002=快數快數！1、2、3 我們一起按下去，我相信我們的默契肯定能成功開啟寶箱！我已經等不及想知道裡面藏著什麼驚喜了～ 快點開始吧！",
        "gal_map_text_206101003=敖靈情緒穩定，掌心穩穩地放在寶箱的掌印旁，眼神專注地看著你，等待你的指令，沒有一絲慌亂。",
        "gal_map_text_206101004=好。數節奏能讓我們更默契，也能減少緊張感。你數慢一點，我們同步按下去，不用著急，慢慢來。",
        "gal_map_text_206101005=敖靈微微頷首，語氣平靜無波，眼神裡滿是篤定。",
        "gal_map_text_206101006=可以。你數節奏，我會精准配合你的動作，不會出現任何偏差，放心吧。",
        "gal_map_text_206101007=好，我們準備開始！1——2——3—— 按！....我們配合得真默契，就像心有靈犀一樣，沒有一點偏差。",
        "gal_map_text_206101008=是啊，我們的默契真的很好～ 不用多說就能明白彼此的想法和節奏。希望寶箱能感受到我們的默契與心意，順利開啟它的秘密。",
        "gal_map_text_206101009=敖靈感受著寶箱傳來的輕微震動，臉頰泛起淡淡的紅暈，眼神裡滿是欣喜。",
        "gal_map_text_206101010=你們的掌心同時按在寶箱的掌印上，掌心傳來寶箱溫潤的觸感。下一秒，寶箱發出柔和的金色光芒，箱體上的藤蔓花紋漸漸亮起，順著花紋流淌出溫暖的光暈。",
        "gal_map_text_206101011=片刻後，箱體緩緩打開，裡面並沒有金銀財寶，也沒有複雜的道具，只有一對小巧精緻的銀色手鏈，手鏈的鏈條是細膩的編織紋理，吊墜是彼此名字的首字母，在光芒下泛著柔和的光澤。",
        "gal_map_text_206101012=敖靈看著手鏈，眼神裡滿是驚喜與感動：'原來這就是寶箱的秘密，是屬於我們兩個人的專屬紀念。' 你們沒有立刻拿起手鏈，卻在掌心相觸的瞬間，感受到了彼此越來越近的心意，曖昧的氛圍在空氣中愈發濃厚，心跳也變得愈發清晰。",
        "gal_map_text_206101013=魔鏡的光芒驟然變強，將你們包裹其中，再次睜開眼時，已經身處一個圓形房間。房間的穹頂是璀璨的星空投影，無數星星閃爍著柔和的微光，仿佛置身於浩瀚無垠的宇宙之中，讓人忍不住心生敬畏。",
        "gal_map_text_206101014=房間中央擺放著一個複雜的星辰羅盤，羅盤的盤面由深色金屬製成，上面刻著密密麻麻的星辰刻度和符號，指標在盤面中央緩慢轉動，發出輕微的 '哢噠' 聲。房間的穹頂正在以肉眼可見的速度緩慢閉合，星空投影的光芒也隨之逐漸暗淡，留給你們破解謎題的時間已經不多了，緊迫感撲面而來。",
        "gal_map_text_206101015=魔鏡的聲音再次在房間中響起，帶著一絲急促的意味：'星辰羅盤藏著時空的秘密，唯有心意相通者，方能根據彼此的羈絆找到正確的星辰方向，讓指標停止轉動，開啟生路。若在穹頂完全閉合前未能破解，便會被困在此地。'",
        "gal_map_text_206101016=敖靈看著緩緩閉合的穹頂，眼神裡滿是緊張與堅定，轉頭看向你，緊緊拉住了你的袖子：'我們必須儘快破解謎題，一起出去。我相信你，我們一定可以的！'",
        "gal_map_text_206101017=別擔心，有我在，我們一定能破解這個謎題，一起出去。星辰羅盤需要我們的默契和羈絆，我們一起想辦法，分工合作，肯定能找到正確的方向。",
        "gal_map_text_206101018=嗯…… 我相信你，完全相信你。我們怎麼分工？你說我做，我一定會好好配合你，儘快找到指標的正確方向，不能被困在這裡。",
        "gal_map_text_206101019=穹頂閉合的速度越來越快，星空投影的光芒愈發暗淡，房間裡的溫度似乎也降低了幾分。你看著星辰羅盤上複雜的刻度和不斷轉動的指標，又看向身邊的敖靈，她的眼神裡滿是信任與依賴，緊緊攥著你的袖子，指尖因為用力而微微泛白。此刻沒有多餘的時間猶豫，需要用默契的配合和堅定的判斷破解謎題，讓星辰羅盤成為彼此心意與羈絆的見證，也讓她感受到你的可靠與擔當。",
        "gal_map_text_206101020=按生日星座定位",
        "gal_map_text_206101021=回憶過往找線索",
        "gal_map_text_206101022=掌心貼羅盤感應",
        "gal_map_text_206101023=按默契選星辰",
        "gal_map_text_206101024=我們的生日星座一定是彼此的羈絆，不如試試按我們的生日星座找對應的星辰方向，讓指針對準它們？",
        "gal_map_text_206101025=敖靈立刻點頭，眼神快速掃過羅盤盤面，尋找星座標識。",
        "gal_map_text_206101026=好！這個辦法可行！我記得你的生日星座是獅子座，我的是處女座，這兩個星座肯定是我們的羈絆！我們趕緊找找羅盤上對應的星辰位置，一起調整指針！",
        "gal_map_text_206101027=敖靈眼神專注地盯著羅盤上的星座標識，指尖輕輕轉動指標，動作快速而精准。",
        "gal_map_text_206101028=我已經看到獅子座和處女座的星辰標識了！就在羅盤的東北方向和東南方向，我們一起調整指標，精准對準這兩個星座的中心位置，肯定能開啟生路～ 快，我們動作快點，穹頂快閉合了！",
        "gal_map_text_206101029=敖靈豫地移動著，時不時抬頭看向你，想尋求你的確認和幫助，眼神裡滿是緊張。",
        "gal_map_text_206101030=按生日星座啊…… 我得先想想我的處女座對應的星辰標識是什麼樣子的，還有你的獅子座，我不太確定哪個是…… 你別著急，我慢慢找，肯定能找到的。",
        "gal_map_text_206101031=敖靈完全不知道如何下手，語氣裡帶著濃濃的依賴，眼神裡滿是無措，只能緊緊跟著你的節奏。",
        "gal_map_text_206101032=我不太記得星座對應的星辰標識長什麼樣了，平時也不怎麼關注這些…… 要不你先找到你的獅子座，然後我再跟著找我的處女座？我相信你能找到的。",
        "gal_map_text_206101033=我找到獅子座了，就在這個位置，你看這個帶著鬃毛圖案的標識就是。你的處女座在它的旁邊，那個帶著麥穗圖案的就是，我們一起調整指標，精准對準這兩個星座的中心。相信我們的生日星座，一定能指引我們找到生路。",
        "gal_map_text_206101034=原來在這裡…… 我之前一直沒認出來。我們一起慢慢調整指標，一定要對準中心位置。真沒想到，我們的生日星座也能成為破解謎題的關鍵，這就是我們之間的羈絆吧。",
        "gal_map_text_206101035=敖靈看著你找到的星座位置，松了一口氣，眼神裡滿是欣喜與信任。",
        "gal_map_text_206101036=我們一起回憶之前約會的細節，比如第一次見面的咖啡書店、一起拼過的拼圖，這些美好回憶肯定藏著線索，對應羅盤上的星辰標識？",
        "gal_map_text_206101037=敖靈語氣輕快活潑，快速回憶著過往的細節，眼神裡滿是興奮，指尖還輕輕敲擊著羅盤邊緣。",
        "gal_map_text_206101038=好呀好呀！這個辦法太有意義了！我們一起回憶第一次約會的咖啡書店、一起拼過的《彼此的彼此》拼圖、一起喂過的小貓，這些美好回憶肯定藏著線索，對應羅盤上的星辰標識！我記得我們第一次見面的咖啡書店，應該和‘星書’星辰對應！",
        "gal_map_text_206101039=敖靈身體緊緊挨著你，指尖快速劃過羅盤上的星辰標識，眼神發亮地看著你，期待你的認同。",
        "gal_map_text_206101040=快想快想！我們一起做過手工、調過香水，這些都可能對應不同的星辰標識～ 我找到‘匠心’星辰了，這個肯定對應我們一起做手工的時光！還有那個‘香韻’星辰，對應我們一起調香水的柑橘雪松味！我們趕緊調整指標，對準這些星辰！",
        "gal_map_text_206101041=敖靈微微頷首，語氣依舊平靜，卻認真地回憶著過往。",
        "gal_map_text_206101042=可以，回憶過往的細節也是個不錯的辦法，那些共同經歷的時光確實是我們的羈絆。我沒什麼意見，你想起什麼細節就說出來，我們一起在羅盤上找對應的星辰標識，慢慢嘗試。",
        "gal_map_text_206101043=敖靈在你回憶過往細節時，認真地聽著，時不時輕輕點頭，眼神裡帶著一絲不易察覺的溫柔，指尖還會在羅盤上找到對應的標識，悄悄指給你看。",
        "gal_map_text_206101044=嗯。",
        "gal_map_text_206101045=我想起我們一起調香水時，你喜歡的柑橘雪松味，這個味道清新又溫柔，應該對應‘香韻’星辰；我們一起做手工時的默契配合，對應‘匠心’星辰；還有我們一起喂過的小貓，對應‘星寵’星辰。我們一起調整指標，對準這三個星辰的中心位置。",
        "gal_map_text_206101046=原來你記得這麼多我們一起做過的小事，每一個細節都記得清清楚楚…… 這些細節都是我們之間最珍貴的羈絆。我們一起慢慢調整指標，希望能借著這些美好的回憶，開啟生路，一起出去。",
        "gal_map_text_206101047=敖靈聽著你回憶的細節，臉頰泛起淡淡的紅暈，眼神裡滿是動容與歡喜。",
        "gal_map_text_206101048=星辰羅盤需要心意相通，我們一起將掌心貼在羅盤中央，閉上眼睛用心感應，讓彼此的心意引導指標找到正確方向？",
        "gal_map_text_206101049=敖靈語氣乾脆俐落，掌心緊緊貼在羅盤中央，閉上眼睛，表情專注而認真。",
        "gal_map_text_206101050=好！星辰羅盤需要心意相通，我們一起將掌心貼在羅盤上，閉上眼睛用心感應，讓我們的心意和羈絆引導指標找到正確方向。我已經準備好了，我們現在就開始吧！",
        "gal_map_text_206101051=敖靈將掌心貼在你的掌心，然後一起貼在羅盤中央，手指還輕輕扣住了你的手指，語氣興奮不已。",
        "gal_map_text_206101052=快貼緊一點！讓我們的心意通過掌心完全傳遞給彼此，也傳遞給星辰羅盤！閉上眼睛，用心感受彼此的心跳和心意，一起引導指標找到正確方向～ 我相信我們一定能成功！",
        "gal_map_text_206101053=敖靈嘴角帶著淺淺的笑意，猶豫片刻後慢慢將掌心貼在羅盤中央，聲音柔和得像輕聲細語。",
        "gal_map_text_206101054=這樣會不會太唯心了？不過…… 現在也沒有其他更好的辦法了，試試也沒關係。畢竟星辰羅盤需要心意相通，或許只有這樣才能找到正確方向。",
        "gal_map_text_206101055=敖靈掌心微微出汗，貼在羅盤上時快速閉上眼，長長的睫毛輕輕顫動，臉頰紅得像蘋果，語氣裡帶著一絲依賴。",
        "gal_map_text_206101056=好…… 聽你的安排。只是閉上眼睛用心感應會有點緊張，你能不能稍微握緊我的手，給我一點力量？",
        "gal_map_text_206101057=我能感受到羅盤的輕微震動，也能感受到你的心跳和心意，好像真的有一股力量在引導我們。我們一起靜下心來，不要想太多，讓彼此的心意自然流動，相信它會引導指標找到正確的方向。不管結果如何，能和你一起這樣用心感受彼此，我都覺得很珍貴。",
        "gal_map_text_206101058=我也感受到了…… 好像真的有心意在我們之間傳遞，也在傳遞給羅盤。你的手很有力量，讓我覺得很安心。希望我們的心意能被羅盤感受到，引導指標找到正確方向，一起出去。",
        "gal_map_text_206101059=敖靈感受著羅盤的震動、你的溫度和力量，臉頰發燙，心跳加速。",
        "gal_map_text_206101060=不用想太多複雜的線索，憑我們之間的默契直接選擇一顆彼此都覺得有感覺的星辰，相信我們的直覺和默契？",
        "gal_map_text_206101061=敖靈情緒高漲，眼神裡滿是信任，主動將選擇權交給你，指尖還輕輕指向羅盤中央的 '同心' 星辰。",
        "gal_map_text_206101062=好呀好呀！憑我們之間的默契，肯定能選對正確的星辰～ 我相信你，也相信我們這麼久以來的默契！我覺得羅盤中央那顆最亮的‘同心’星辰肯定是正確的，代表我們同心協力，一起克服困難！",
        "gal_map_text_206101063=敖靈身體緊緊挨著你，眼神發亮地看著你，手指緊緊握著你的手指，語氣裡滿是篤定。",
        "gal_map_text_206101064=我覺得這顆‘同心’星辰肯定是正確的！憑我們的默契，選它一定沒錯～ 我們一起按下去，讓指標對準它！不管結果如何，我都相信我們的默契，相信你！",
        "gal_map_text_206101065=敖靈情緒穩定，眼神專注地看著羅盤上的星辰標識，認真思考著，時不時看向你，尋求你的意見。",
        "gal_map_text_206101066=好。憑默契選也是一種不錯的辦法，過多的思考反而會影響判斷。我們一起商量一下，選一顆彼此都覺得有感覺、有羈絆的星辰，不用太糾結，跟著直覺走就好。",
        "gal_map_text_206101067=敖靈情緒毫無波瀾，眼神專注地看著你，完全將選擇權交給你，沒有一絲猶豫和懷疑。",
        "gal_map_text_206101068=可以。憑默契選，我沒意見，你選就好，我完全相信你的判斷和我們之間的默契。不管你選哪顆星辰，我都支持你，一起配合你。",
        "gal_map_text_206101069=我也覺得這顆‘同心’星辰是正確的，它代表我們同心協力、心意相通，和我們現在的狀態完美契合。我們一起按下去，讓指標對準它，相信我們的默契和羈絆，一定能引導我們找到生路。",
        "gal_map_text_206101070=我也覺得這顆星辰很對，和我們之間的羈絆很契合～ 我們一起按下去，希望能順利開啟生路。和你一起憑默契做選擇，感覺很安心，也很有意義，這就是我們之間的羈絆吧。",
        "gal_map_text_206101071=敖靈看著你選擇的 '同心' 星辰，又看向你堅定的眼神，臉頰泛起淡淡的紅暈，眼神裡滿是信任與歡喜。",
        "gal_map_text_206101072=你們按照選擇認真調整著星辰羅盤的指標，每一次輕微的轉動，都伴隨著穹頂閉合的 '哢嚓' 聲。當指標精准對準正確的星辰方向時，羅盤突然發出耀眼的光芒，光芒順著刻度流淌，照亮了整個房間。下一秒，房間中央緩緩出現一道石門，石門上刻著 '同心者生' 四個大字，緩緩向兩側打開。",
        "gal_map_text_206101073=穹頂停止了閉合，星空投影的光芒愈發璀璨，仿佛在為你們慶祝。敖靈看著打開的石門，眼神裡滿是興奮與成就感，緊緊拉住你的手：'我們成功了！真沒想到，我們的默契和羈絆這麼深，竟然真的破解了謎題！' 你們並肩走向石門，彼此的身影在星空投影下交織在一起，曖昧的氛圍愈發濃厚，心意在共同破解謎題的過程中愈發堅定。",
        "gal_map_text_206101074=美食市集深處，藏著一個被暖黃串燈和翠綠綠植環繞的安靜角落。暖黃的串燈纏繞在綠植的枝葉間，閃爍著柔和的光芒，像星星一樣點綴著這個小空間，遮擋了外界的喧囂與人群的擁擠。",
        "gal_map_text_206101075=周圍的綠植枝葉繁茂，散發著淡淡的草木清香，與美食的香氣交織在一起，讓人感到格外放鬆。幾張舒適的籐椅整齊地擺放在角落中央，旁邊的小桌上放著你們剛買的各種甜點和飲品，有精緻的馬卡龍、綿密的提拉米蘇，還有兩杯冒著熱氣的拿鐵。敖靈拿起一塊你剛才稱讚過的提拉米蘇，輕輕遞到你嘴邊，眼神裡滿是期待與羞澀。",
        "gal_map_text_206101076=你們並肩坐在籐椅上，周圍只有串燈的微光、輕柔的背景音樂，還有偶爾傳來的遠處人群的低語聲，氛圍溫馨而私密。",
        "gal_map_text_206101077=敖靈看著你，嘴角揚起淺淺的笑意，將手中的提拉米蘇輕輕遞到你嘴邊，聲音柔和得像羽毛：'你剛才說這款提拉米蘇很好吃，口感綿密、甜而不膩，我幫你再嘗嘗，是不是真的像你說的那麼美味。' 語氣裡藏著一絲小調皮，也藏著想要親近的期待。",
        "gal_map_text_206101078=你還記得我剛才隨口說的話，真的很細心。不過，應該我喂你吃才對，你也嘗嘗這款提拉米蘇，它的口感真的很驚豔，和你一樣讓人覺得甜蜜。",
        "gal_map_text_206101079=沒關係，我先喂你吃，你嘗完之後再喂我吃，這樣互相餵食更有意義，也更甜蜜。快嘗嘗看，告訴我是不是和你剛才吃的一樣美味。",
        "gal_map_text_206101080=你看著她遞來的提拉米蘇，感受著甜點的香甜氣息撲面而來，再看看她眼底藏不住的期待與羞澀。暖黃的串燈光芒落在她的臉上，映得她的臉頰微微泛紅，長長的睫毛輕輕顫動，像蝴蝶的翅膀。氛圍曖昧而溫馨，每一秒都讓人感到心動。此刻需要用溫柔的回應回應她的心意，讓互相餵食成為彼此親近的絕佳契機，拉近心與心的距離。",
        "gal_map_text_206101081=張口吃下 + 反喂",
        "gal_map_text_206101082=咬一口留一半分享",
        "gal_map_text_206101083=輕捏她臉頰再吃下",
        "gal_map_text_206101084=好啊，那我就不客氣啦～ 等我嘗完，立刻反喂你，讓你也嘗嘗這份甜蜜，怎麼樣？",
        "gal_map_text_206101085=敖靈穩穩托著提拉米蘇，身體微微前傾，呼吸帶著淡淡的甜香，眼神緊緊盯著你的嘴唇。",
        "gal_map_text_206101086=快吃快吃！我特意挑了最大的一塊，保證口感最好～ 吃完趕緊反喂我，我已經等著嘗這份‘甜蜜接力’啦！",
        "gal_map_text_206101087=敖靈微微踮起腳尖，將甜點湊得更近，語氣急促又雀躍，身體幾乎貼在你身前，指尖因為緊張微微繃緊，耳尖卻泛紅得厲害。",
        "gal_map_text_206101088=啊 —— 張嘴！快點吃掉它，我已經迫不及待想讓你反喂我了！不許咬到我的手哦，不然我可要懲罰你多喂我一塊！",
        "gal_map_text_206101089=敖靈眼神一直低垂著，不敢看你的嘴唇，臉頰卻像熟透的櫻桃，指尖輕輕摩挲著甜點的邊緣。",
        "gal_map_text_206101090=那…… 你小心點吃，別弄灑了可哥粉。我…… 我已經準備好了，等你吃完就換我啦。",
        "gal_map_text_206101091=敖靈閉上眼睛，長長的睫毛劇烈顫動，身體僵硬地保持著遞甜點的姿勢，連呼吸都變得小心翼翼。",
        "gal_map_text_206101092=你…… 你快吃吧，我…… 我等著。",
        "gal_map_text_206101093=真的太甜了，比我剛才吃的那塊甜十倍 —— 因為是你喂的呀。現在換我啦，張嘴～",
        "gal_map_text_206101094=確實…… 確實更甜了…… 你的指尖好暖，托著我的下巴的時候，我心跳都快停了。原來互相餵食真的這麼甜蜜，比甜點本身還讓人難忘。",
        "gal_map_text_206101095=敖靈被你托住下巴的瞬間身體微微一顫，乖乖張嘴吃下甜點，臉頰燙得能煮熟雞蛋，眼神裡滿是羞澀與歡喜，",
        "gal_map_text_206101096=不如我們分著吃這一塊？我咬一口，剩下的給你，這樣算不算另一種‘間接親吻’，更浪漫一點？",
        "gal_map_text_206101097=敖靈立刻反應過來你的意思，眼睛瞬間亮了起來，語氣帶著一絲小調皮。",
        "gal_map_text_206101098=哇～ 間接親吻？這個主意太浪漫了！那你可要咬小一點，給我留多一點，不然我可不依～",
        "gal_map_text_206101099=敖靈主動將甜點往你嘴邊送了送，語氣興奮不已。",
        "gal_map_text_206101100=好呀好呀！我早就想試試這種分享方式了！你咬完之後我立刻吃，這樣我們就相當於…… 嗯！快點咬，我已經等不及了！",
        "gal_map_text_206101101=敖靈愣了一下才反應過來，臉頰慢慢泛起紅暈，語氣有些無措。",
        "gal_map_text_206101102=間…… 間接親吻？這樣會不會太親密了？不過…… 確實很浪漫，那…… 那你輕輕咬一口就好，別咬太多，給我留一半。",
        "gal_map_text_206101103=敖靈說完快速低下頭，不敢看你，指尖緊緊攥著甜點，身體僵硬地站在原地，連呼吸都變得有些急促。",
        "gal_map_text_206101104=哦…… 好。那你咬吧，我…… 我不介意。",
        "gal_map_text_206101105=味道果然不一樣，帶著你的氣息更甜了。來，剩下的一半給你，這是屬於我們的專屬分享方式。",
        "gal_map_text_206101106=真的…… 真的很特別。你的齒痕還留在上面，感覺就像…… 就像我們真的間接親吻了一樣。這種分享方式，我一輩子都不會忘記，太浪漫了。",
        "gal_map_text_206101107=敖靈受到你指尖的觸碰，身體微微一顫，小心翼翼地咬下剩下的甜點，臉頰紅得像火燒，眼神裡滿是羞澀與心動。",
        "gal_map_text_206101108=你遞過來的甜點肯定更甜～ 讓我先捏捏你可愛的臉頰，再乖乖吃下這份心意，好不好？",
        "gal_map_text_206101109=敖靈臉頰微微鼓起，像個可愛的小包子，眼神裡滿是期待，身體不自覺地向你靠近。",
        "gal_map_text_206101110=好呀好呀！捏吧捏吧，我的臉頰很軟的～ 不過捏完之後要趕緊吃下甜點，還要記得喂我，不能說話不算數哦！",
        "gal_map_text_206101111=敖靈頰緊緊貼著你的手心，身體緊緊挨著你，眼神裡滿是雀躍與依賴。",
        "gal_map_text_206101112=快捏快捏！用力一點也沒關係，我不怕疼～ 捏完我們就一起吃甜點，互相餵食，想想都覺得好開心！",
        "gal_map_text_206101113=敖靈主動將臉頰湊到你手邊，眼神裡滿是溫柔與包容，身體保持著輕微的距離，卻不抗拒你的觸碰。",
        "gal_map_text_206101114=可以啊，不過你輕點捏，我的臉頰有點敏感。捏完之後我們就趕緊吃甜點，別讓可哥粉掉了。",
        "gal_map_text_206101115=敖靈眼神一直看著你，情緒沒有太大波動，只是在你捏臉頰時，睫毛輕輕顫動了一下，指尖悄悄攥緊了衣角，卻沒有躲開。",
        "gal_map_text_206101116=嗯。你捏吧，我沒意見。",
        "gal_map_text_206101117=你的臉頰真的好軟，像棉花糖一樣，讓人忍不住想多捏一會兒。好了，不逗你了，我先吃甜點，然後立刻喂你。",
        "gal_map_text_206101118=你的手好暖，捏得我臉頰癢癢的，心跳都變快了。原來被你捏臉頰是這種感覺，有點害羞卻又很開心。我們趕緊互相餵食吧，我已經等著嘗這份甜蜜了。",
        "gal_map_text_206101119=敖靈被你捏臉頰時身體微微一顫，臉頰泛起淡淡的紅暈。",
        "gal_map_text_206101120=暖黃的串燈光芒下，你們互相餵食的身影被拉得很長，甜點的香甜氣息與彼此的呼吸交織在一起，氛圍曖昧得讓人窒息。",
        "gal_map_text_206101121=敖靈輕輕舔了舔嘴角殘留的可哥粉，眼神裡滿是甜蜜與羞澀，主動將頭輕輕靠在你的肩膀上：'今天的甜點是我吃過最甜的，不僅因為味道好，更因為是和你一起分享、互相餵食。這種感覺真的很幸福，希望以後每次吃甜點都能和你一起。'",
        "gal_map_text_206101122=你的肩膀感受到她髮絲的柔軟觸感和輕微的呼吸，心跳不自覺地加快，輕輕將手放在她的肩膀上，輕輕拍了拍。周圍的串燈依舊閃爍，綠植散發著淡淡的清香，這一刻的甜蜜與溫馨，成為了彼此心中最珍貴的回憶。",
        "gal_map_text_206101123=美食市集的中心區域，煙火氣十足的小吃攤位前擠滿了人，各種美食的香氣撲面而來，讓人垂涎欲滴。攤位上擺滿了各種特色小吃，有滋滋作響的烤串、熱氣騰騰的關東煮、金黃酥脆的炸物，還有各種色彩鮮豔的特色甜品。",
        "gal_map_text_206101124=攤主熱情地吆喝著，周圍的人群熙熙攘攘，充滿了熱鬧的氛圍。敖靈被攤位上的烤串吸引，眼神裡滿是喜愛與嚮往，卻因為人群擁擠而有些猶豫，下意識地拉住了你的袖子，指尖帶著一絲緊張的溫度。",
        "gal_map_text_206101125=你們並肩站在小吃攤位前，周圍是熱鬧的人群和各種美食的香氣，敖靈看著攤位上滋滋作響的烤串，咽了咽口水，眼神裡滿是喜愛，卻又有些為難地說：'這家烤串看起來好好吃，香味太誘人了，可是人好多，擠進去好麻煩，還怕被烤串的油濺到。'",
        "gal_map_text_206101126=語氣裡藏著想要嘗試的期待，卻又因為環境的原因有些猶豫，緊緊拉著你的袖子，像是在尋求你的保護與幫助。",
        "gal_map_text_206101127=沒關係，有我在，我帶你擠進去。你想吃什麼口味的烤串？我幫你點，保證讓你吃到最正宗、最美味的烤串，不會讓你被油濺到，也不會讓你受委屈。",
        "gal_map_text_206101128=真的嗎？那太好了！我想吃蜜汁雞翅、烤魷魚，還有烤玉米，都是你之前說過好吃的口味。只是…… 人群這麼擁擠，你一定要小心一點，別擠到自己，也別讓我撞到別人。",
        "gal_map_text_206101129=你看著她眼底滿是信任與依賴的模樣，又看了看擁擠的人群，下意識地將她往自己身邊拉了拉，讓她緊緊貼著你的胳膊，避免被周圍的人群撞到。她的身體微微一顫，卻沒有躲開，反而輕輕抓住了你的胳膊，指尖用力攥著你的衣袖，臉頰泛起淡淡的紅暈。攤位上的烤串滋滋作響，香氣愈發濃郁，周圍的人群依舊熱鬧，此刻需要用溫柔而堅定的行動保護她，讓她在擁擠的環境中感受到你的可靠與溫暖，同時讓美食成為拉近彼此距離的催化劑。",
        "gal_map_text_206101130=護著她擠入人群",
        "gal_map_text_206101131=代買後找安靜處分享",
        "gal_map_text_206101132=喂她吃避免弄髒手",
        "gal_map_text_206101133=分工合作快速購買",
        "gal_map_text_206101134=你緊緊跟著我，抓住我的胳膊，我護著你擠進去，保證不讓任何人撞到你，也不讓油濺到你身上。",
        "gal_map_text_206101135=敖靈身體緊緊貼著你的胳膊，眼神裡滿是興奮，卻又帶著一絲緊張，指尖用力攥著你的衣袖。",
        "gal_map_text_206101136=好呀好呀！我會緊緊抓住你的胳膊，寸步不離地跟著你，不會給你添麻煩的！你一定要護好我，我已經迫不及待想吃烤串了！",
        "gal_map_text_206101137=敖靈直接抱住你的胳膊，將臉頰輕輕靠在你的肩膀上，語氣急促又雀躍。",
        "gal_map_text_206101138=快走吧快走吧！我已經準備好了，緊緊抱著你的胳膊，肯定不會被擠到！我們趕緊擠進去，早點吃到美味的烤串，我已經快流口水了！",
        "gal_map_text_206101139=敖靈微微頷首，語氣依舊平靜，卻主動抓住了你的胳膊，指尖輕輕攥著你的衣袖。",
        "gal_map_text_206101140=嗯，我會跟著你，不會亂跑。你小心一點，不用著急，慢慢擠進去就好，我不著急吃。",
        "gal_map_text_206101141=敖靈在你開始擠入人群時，緊緊抓住了你的胳膊，手掌因為用力而微微泛白，身體僵硬地跟著你，眼神裡滿是警惕，卻沒有鬆開你的胳膊。",
        "gal_map_text_206101142=好。",
        "gal_map_text_206101143=別害怕，有我在，沒人能撞到你。你看，馬上就到我們了，我已經看到攤主了，這就幫你點蜜汁雞翅、烤魷魚和烤玉米，都是你想吃的口味。",
        "gal_map_text_206101144=謝謝你…… 有你在身邊真的很安心，周圍這麼擁擠，我卻一點都不害怕。你一定要小心一點，別讓自己被擠到，也別被烤串的油濺到。能吃到你護著我買來的烤串，肯定會格外美味。",
        "gal_map_text_206101145=敖靈感受著你用身體為她擋住人群，心裡滿是安全感，臉頰泛起淡淡的紅暈。",
        "gal_map_text_206101146=你在這裡找個安全的地方等著，我擠進去幫你買所有想吃的烤串，買完之後我們找個安靜的角落一起分享，怎麼樣？",
        "gal_map_text_206101147=敖靈立刻點頭，眼神快速掃視周圍，尋找安全的位置，語氣裡滿是篤定。",
        "gal_map_text_206101148=好呀好呀！我就在那邊的長椅上等著，你放心去吧，我會照顧好自己，不會亂跑，也不會讓別人撞到我。你買完之後趕緊來找我，我們一起分享美味的烤串！",
        "gal_map_text_206101149=敖靈眼神緊緊盯著你，直到你融入人群才坐下，身體坐得筆直，雙手放在膝蓋上，時刻準備著迎接你回來。",
        "gal_map_text_206101150=我就在這裡等你，你快點去買，記得買蜜汁雞翅、烤魷魚和烤玉米，都是我想吃的口味！買完之後趕緊回來，我已經等不及想和你一起分享了！",
        "gal_map_text_206101151=敖靈眼神裡滿是緊張與依賴，身體坐得很拘謹，時不時看向攤位的方向，生怕你走丟。",
        "gal_map_text_206101152=那…… 那你一定要小心一點，擠進去的時候別被別人撞到，買完之後趕緊回來，我一個人在這裡等著有點害怕。你記得買我想吃的口味，不要買錯了。",
        "gal_map_text_206101153=敖靈雙手緊緊放在膝蓋上，身體僵硬地坐著，眼神裡滿是無措，只有在你轉身走向攤位時，才悄悄抬起頭看了一眼你的背影。",
        "gal_map_text_206101154=嗯，我在這裡等你，你快點回來。",
        "gal_map_text_206101155=我回來啦！買了你想吃的所有烤串，蜜汁雞翅、烤魷魚、烤玉米，都還是熱乎的，我們趕緊嘗嘗，看看是不是你喜歡的口味。",
        "gal_map_text_206101156=你回來啦！辛苦你了，擠了這麼久，還買了這麼多我想吃的烤串。看著這些烤串，我已經流口水了，我們趕緊一起分享吧，有你在身邊，和你一起吃烤串，感覺肯定格外美味。",
        "gal_map_text_206101157=敖靈看著你安全回來，手裡拿著滿滿的烤串，眼神裡滿是欣喜與感動，臉頰泛起淡淡的紅暈。",
        "gal_map_text_206101158=擠進去之後，我先幫你把烤串吹涼，然後直接喂你吃，這樣你就不用動手，也不用擔心弄髒手，更不會被油濺到，好不好？",
        "gal_map_text_206101159=敖靈主動湊近你，嘴巴微微張開，眼神裡滿是期待，像個等待投喂的小饞貓。",
        "gal_map_text_206101160=好呀好呀！這樣太方便了，我就不用動手，也不用擔心弄髒手，更不會被油濺到了！你一定要先幫我吹涼，別燙到我的嘴，然後慢慢喂我吃，我已經等不及想嘗嘗了！",
        "gal_map_text_206101161=敖靈眼神裡滿是雀躍與期待，臉頰泛起淡淡的紅暈，卻毫不羞澀。",
        "gal_map_text_206101162=啊 —— 快吹涼一點喂我吃！我已經快流口水了，先喂我吃蜜汁雞翅，我最喜歡這個口味了！你喂我的時候要小心一點，別燙到我，也別弄到我的臉上！",
        "gal_map_text_206101163=敖靈嘴角帶著淺淺的笑意，身體微微向後縮了縮，聲音柔得像棉花。",
        "gal_map_text_206101164=這樣…… 這樣會不會太親密了？不過…… 確實很方便，那…… 那你就先幫我吹涼，然後慢慢喂我吃，謝謝你。",
        "gal_map_text_206101165=敖靈說完快速閉上眼睛，長長的睫毛劇烈顫動，嘴巴微微張開，身體緊繃得像塊石頭，連呼吸都變得小心翼翼。",
        "gal_map_text_206101166=好…… 好的，麻煩你了。你…… 你吹涼一點，慢慢喂我，別…… 別弄到我的臉上。",
        "gal_map_text_206101167=吹涼了，張嘴～ 這個蜜汁雞翅烤得外焦裡嫩，甜度剛剛好，和你一樣甜。慢慢吃，別著急，不夠我們再買，我會一直喂你，直到你吃飽為止。",
        "gal_map_text_206101168=真的…… 真的太好吃了！比我想像中還要美味，而且被你喂著吃，感覺更甜了。你的指尖好暖，托著烤串的樣子好溫柔，我心跳都快停了。原來被你喂著吃烤串是這種感覺，既害羞又幸福。",
        "gal_map_text_206101169=敖靈乖乖張嘴吃下烤串，感受著外焦裡嫩的口感和濃郁的蜜汁香味，臉頰燙得能煮熟雞蛋。",
        "gal_map_text_206101170=我們分工合作，我負責擠進去點單付款，你負責在攤位邊緣找個安全的位置等著，拿到烤串後我們立刻離開，這樣又快又安全，不會耽誤太多時間。",
        "gal_map_text_206101171=敖靈眼睛亮晶晶地看著你，語氣裡滿是雀躍與期待。",
        "gal_map_text_206101172=好呀好呀！分工合作效率高，我們趕緊行動起來！我在這裡等著，你負責擠進去點單付款，拿到烤串後我們立刻離開，找個安靜的地方一起分享，怎麼樣？",
        "gal_map_text_206101173=敖靈身體蹦蹦跳跳的，眼神發亮地看著你，嘴角帶著藏不住的笑意。",
        "gal_map_text_206101174=快去吧快去吧！我在這裡等你，一定不要買錯口味，要蜜汁雞翅、烤魷魚和烤玉米，都是我想吃的！我們趕緊買完趕緊走，早點吃到美味的烤串，我已經快流口水了！",
        "gal_map_text_206101175=敖靈輕輕點頭，語氣平和而溫柔。",
        "gal_map_text_206101176=好。分工合作確實是個好辦法，既快速又安全。你小心一點擠進去，不用著急，慢慢點單付款，我在這裡等你，不會亂跑。拿到烤串後我們就找個安靜的地方慢慢吃，不用著急。",
        "gal_map_text_206101177=敖靈情緒毫無波瀾，身體筆直地站在原地，眼神平靜地看著你擠入人群，沒有多餘的動作和言語，卻讓人感受到她的耐心與信任。",
        "gal_map_text_206101178=可以。你去吧，我在這裡等你。記得買蜜汁雞翅、烤魷魚和烤玉米，不要遺漏。拿到烤串後我們就離開，找個安靜的地方分享。",
        "gal_map_text_206101179=搞定！買了你想吃的所有烤串，都是熱乎的，我們現在就找個安靜的角落一起分享。分工合作就是快，沒有耽誤太多時間，也沒有讓你等太久。",
        "gal_map_text_206101180=嗯，分工合作確實很有效率，沒有讓我等太久，也沒有讓你太辛苦。這些烤串看起來就很美味，我們趕緊找個安靜的地方一起分享吧。和你一起分工合作做一件事，感覺很默契，也很開心。",
        "gal_map_text_206101181=敖靈接過烤串，感受著溫熱的觸感和濃郁的香氣，眼神裡滿是欣喜與溫柔。",
        "gal_map_text_206101182=你們拿著熱氣騰騰的烤串，找了個安靜的角落並肩坐下，周圍的煙火氣漸漸遠去，只剩下彼此的呼吸聲和烤串的香氣。",
        "gal_map_text_206101183=敖靈輕輕咬了一口蜜汁雞翅，嘴角沾了一點蜜汁，眼神裡滿是滿足與幸福，主動將烤魷魚遞到你嘴邊：'這個烤魷魚很好吃，外焦裡嫩，很有嚼勁，你也嘗嘗。和你一起吃烤串，感覺比平時自己吃美味多了，不僅因為烤串本身好吃，更因為身邊有你。'",
        "gal_map_text_206101184=你張嘴吃下她遞來的烤魷魚，感受著濃郁的香味和她指尖傳來的溫度，下意識地幫她擦掉嘴角的蜜汁。她的身體微微一顫，臉頰泛起淡淡的紅暈，眼神裡滿是羞澀與歡喜。",
        "gal_map_text_206101185=這一刻，煙火氣與甜蜜交織在一起，成為了彼此心中最珍貴的回憶，心與心的距離在美食的催化下愈發靠近。",
        "gal_map_text_206101186=閉店音樂的最後一個音符消散在晚風裡，你們並肩走出「貓嶼」咖啡書店。夜晚的商業街被霓虹燈染成暖橙色，車流裹挾著淡淡的城市氣息掠過，櫥窗裡的燈光倒映在石板路上，形成斑駁的光影。",
        "gal_map_text_206101187=你們手中還提著書店的文創袋，裡面裝著共同完成的 '故事的開端' 筆記本和拼圖，袋口露出的貼紙邊角在風裡輕輕晃動，像未說出口的心動。",
        "gal_map_text_206101188=敖靈放慢腳步，轉頭看向你，眼底映著路燈的光暈，語氣裡帶著明顯的不舍。相處的時光過得太快，從午後的安靜共讀，到一起貼貼紙、拼拼圖，那些細碎的瞬間像串起的珍珠，在心裡閃著溫柔的光。此刻站在喧鬧的商業街，反而讓你們之間的氛圍變得更加私密，那些沒說出口的心意，在空氣裡悄悄醞釀。",
        "gal_map_text_206101189=和你在一起的每一刻都覺得很珍貴。閉店不代表結束，反而像我們筆記本裡寫的，是‘故事的開端’。我其實一直想把心裡的感受告訴你，只是怕太唐突。",
        "gal_map_text_206101190=嗯…… 我也覺得。只是現在站在這裡，突然想把心裡的話告訴你，卻又不知道該怎麼說才不會破壞這份美好。",
        "gal_map_text_206101191=晚風輕輕吹動她的發梢，帶著書店殘留的咖啡香。商業街的喧囂成了背景音，此刻你們之間的空氣裡，滿是心照不宣的悸動。你看著她欲言又止的模樣，睫毛在路燈下投下淺淺的陰影，那些相處時的心動細節 —— 她認真貼貼紙的側臉、對視時慌忙移開的眼神、分享零食時的笑容，一一在腦海裡閃過。此刻，你知道該把藏在心裡的感受坦誠地說出來，不是唐突的告白，而是對這段時光、對她這個人最真誠的傾訴。",
        "gal_map_text_206101192=細節共鳴・心動瞬間",
        "gal_map_text_206101193=默契告白・靈魂契合",
        "gal_map_text_206101194=未來期許・時光延續",
        "gal_map_text_206101195=主動靠近・心意升溫",
        "gal_map_text_206101196=安心陪伴・氛圍珍視",
        "gal_map_text_206101197=吸引瞬間・直白傾訴",
        "gal_map_text_206101198=和你一起寫筆記本、貼貼紙時，你認真的側臉、貼歪貼紙時慌張的樣子，還有對視時慌忙移開的眼神，每一個細節都讓我心動，越來越在意你。",
        "gal_map_text_206101199=敖靈指尖下意識攥緊文創袋提手，耳尖泛紅得更明顯，抬頭時眼神亮晶晶。",
        "gal_map_text_206101200=原來你也注意到這些細節！我貼歪貼紙時超緊張，怕你覺得我笨，沒想到你都記在心裡。",
        "gal_map_text_206101201=敖靈抬手捋了捋耳邊碎發，指尖帶著輕微顫抖。",
        "gal_map_text_206101202=我早就發現你偷偷看我了！每次你盯著我筆記本，我都假裝沒察覺，手指卻會悄悄蜷縮起來。",
        "gal_map_text_206101203=敖靈雙手放在身前輕輕絞著衣角，臉頰慢慢泛起紅暈，眼神有些無措地飄向一側。",
        "gal_map_text_206101204=被你這麼一說，好像和你在一起的每一刻，確實都很特別，我也很在意你。",
        "gal_map_text_206101205=敖靈雙手自然垂在身側，手指輕輕敲擊大腿，眼神茫然地看著你。",
        "gal_map_text_206101206=聽你這麼說，我很開心。和你一起做的這些小事，我也覺得很珍貴，很想一直這樣。",
        "gal_map_text_206101207=些細節我都捨不得忘，以後還要把更多和你有關的小瞬間記下來，寫成隻屬於我們的故事。",
        "gal_map_text_206101208=那我也要一起寫！還要把貼歪的貼紙、慌亂的小表情都畫進去，讓我們的故事裡全是甜甜的細節。",
        "gal_map_text_206101209=敖靈低頭翻出筆記本，指尖點在之前貼歪的貼紙處，眼底滿是笑意",
        "gal_map_text_206101210=畫剪影、拼拼圖時，我們不用多說就能懂彼此的想法，你遞工具的時機剛好是我需要的時候，這種默契太難得，我想一直靠近你，瞭解你更多。",
        "gal_map_text_206101211=敖靈雙手用力抓住你的胳膊，身體輕輕搖晃，眼神裡滿是雀躍。",
        "gal_map_text_206101212=我也是！拼拼圖時我正想找那塊藍色的，你就遞過來了，這種默契太神奇了！我早就想告訴你，我很在意你，想和你待在一起更久。",
        "gal_map_text_206101213=敖靈踮起腳尖湊近你，呼吸帶著淡淡的咖啡香，眼底閃著光，手指緊緊扣住你的胳膊。",
        "gal_map_text_206101214=對呀對呀！我早就想說我們超有默契的！不管做什麼都很順暢。真的很喜歡和你在一起，想一直瞭解你更多，永遠不分開！",
        "gal_map_text_206101215=敖靈雙手依舊放在膝蓋上，指尖輕輕摩挲，眼神平靜卻專注地看著你。",
        "gal_map_text_206101216=嗯，和你相處確實很舒服，很多事不用刻意解釋你就懂。這種默契很難得，我很珍惜，也很在意你。",
        "gal_map_text_206101217=敖靈雙手交叉放在身前，眼神沒有起伏，卻緩緩向你邁出一小步。指尖輕輕碰了碰你的文創袋，動作短暫卻清晰。",
        "gal_map_text_206101218=我也覺得我們挺合拍的。這種不用多說的契合感很好，我願意繼續和你走下去，瞭解更多彼此的事。",
        "gal_map_text_206101219=這種不用多說的默契，我想一直珍藏下去。以後不管做什麼，都想和你這樣心意相通。",
        "gal_map_text_206101220=我也是！以後我們還要一起拼更多拼圖、畫更多剪影。讓我們的默契越來越深，一直這樣懂彼此。",
        "gal_map_text_206101221=敖靈指尖回握，力道漸漸加重，眼神明亮而堅定。",
        "gal_map_text_206101222=今天的時光太美好了，我開始期待以後能有更多這樣的日子 —— 和你一起發現美好，一起記錄屬於我們的小瞬間，一起把平淡時光變得特別。",
        "gal_map_text_206101223=敖靈雙手握拳放在胸前，身體輕輕蹦跳了一下，眼神裡滿是期待。拉住你的手腕，指尖帶著溫熱的溫度。",
        "gal_map_text_206101224=我也是我也是！我早就開始期待了！想和你一起逛遍所有小眾書店。",
        "gal_map_text_206101225=敖靈拽著你的手往前走了兩步，語氣興奮到幾乎蹦起來。轉頭時馬尾辮輕輕掃過你的胳膊，眼神發亮。",
        "gal_map_text_206101226=哇！和我想的一模一樣！我還怕你不想有這麼多後續呢！以後我們要一起看日出、逛書店、嘗美食，把所有日子都過得像今天這麼甜！",
        "gal_map_text_206101227=敖靈雙手放在身側，指尖自然下垂，眼神溫柔而平靜，嘴角勾起淺淺的弧度。",
        "gal_map_text_206101228=謝謝你，我也很期待未來能有更多這樣的時光。今天的回憶很珍貴，我不想只停留在過去，想和你創造更多專屬我們的瞬間。",
        "gal_map_text_206101229=敖靈雙手交疊放在小腹前，身體站得筆直，眼神裡滿是篤定，緩緩點頭，腳步向你靠近半步。",
        "gal_map_text_206101230=嗯，我也有同樣的期待。和你在一起的時光很踏實，不管是安靜陪伴還是一起探索，我都願意參與你的未來。",
        "gal_map_text_206101231=那我們就從明天開始規劃，先去打卡你提過的那家小眾書店，把期待變成現實。",
        "gal_map_text_206101232=好呀好呀！我還要提前列好書單。和你一起在書店泡一下午，把平淡的日子過成我們喜歡的樣子。",
        "gal_map_text_206101233=敖靈眼睛一亮，主動挽住他的胳膊，手指輕輕勾住你的衣袖。",
        "gal_map_text_206101234=我越來越想靠近你，想瞭解你的更多喜好，想知道你平時喜歡聽什麼歌、看什麼電影，想參與你的更多時光，這種心情越來越強烈。",
        "gal_map_text_206101235=敖靈抬手拍了拍你的肩膀，雙手自然張開，身體微微前傾，眼神坦蕩又明亮。",
        "gal_map_text_206101236=也是！我早就想瞭解你的更多事情了，想知道你喜歡的歌、喜歡的電影。能聽到你這麼說我太開心了！",
        "gal_map_text_206101237=敖靈身體湊近你，額頭幾乎要碰到你的肩膀。伸手抓住你的雙手，指尖緊緊包裹住你的指節，語氣興奮不已。",
        "gal_map_text_206101238=太好了！我還以為只有我一個人這麼想呢！我早就想和你分享我的一切，也想知道你的所有小秘密，想一直這樣靠近你！",
        "gal_map_text_206101239=敖靈雙手放在身前輕輕絞著衣角，臉頰泛紅，眼神低垂。",
        "gal_map_text_206101240=謝謝你…… 我也很想讓你瞭解我更多，也想瞭解你的喜好。這種互相靠近的感覺很美好，我很珍惜，也期待我們越來越熟悉。",
        "gal_map_text_206101241=敖靈聲音細若蚊蚋，身體卻悄悄向你挪動。",
        "gal_map_text_206101242=我…… 我也是。我也很想靠近你，想知道你的更多事情。和你在一起很安心，我想一直這樣下去。",
        "gal_map_text_206101243=那我現在就想知道，你最近最喜歡聽的歌是什麼？我想把它設成我們的專屬鈴聲",
        "gal_map_text_206101244=我告訴你哦，但你也要告訴我你的喜好！以後我們的歌單要互相關聯，讓每首歌都藏著我們的回憶。",
        "gal_map_text_206101245=敖靈頭輕笑，耳尖泛紅，手指在手機螢幕上快速滑動。指尖點在歌曲播放介面。",
        "gal_map_text_206101246=和你在一起時總覺得特別安心，不管是安靜看書還是一起完成小事，這種踏實放鬆的感覺很久沒體會過了，我很珍惜這份氛圍。",
        "gal_map_text_206101247=敖靈用力點頭，輕輕拍了拍你的胳膊。",
        "gal_map_text_206101248=我也是！和你在一起時特別放鬆，不用刻意偽裝自己。這種踏實的感覺很難得，我很珍惜和你相處的氛圍，也很在意你！",
        "gal_map_text_206101249=敖靈伸手抱住你的胳膊，臉頰貼在你的衣袖上，語氣軟糯。抬頭時眼底閃著光，手指緊緊扣住你的衣袖。",
        "gal_map_text_206101250=對呀對呀！不管和你做什麼都覺得特別安心。哪怕只是安靜坐著看書都很舒服，我真的很喜歡這種感覺，也很喜歡和你待在一起！",
        "gal_map_text_206101251=敖靈手放在身側，指尖自然下垂，眼神平靜無波。",
        "gal_map_text_206101252=嗯，和你相處很安心，不用刻意找話題，不用害怕說錯話。這種氛圍很難得，我很珍惜，也感謝你能給我這種感覺。",
        "gal_map_text_206101253=敖靈眼神沒有起伏，卻緩緩點頭。手指輕輕碰了碰你的手臂，動作短暫卻清晰。",
        "gal_map_text_206101254=我…… 我也是。和你在一起時很踏實、很放鬆，這種感覺很溫暖，也讓我很在意你。",
        "gal_map_text_206101255=以後想安靜看書或者做小事的時候，隨時可以找我，我永遠是能讓你踏實放鬆的人。",
        "gal_map_text_206101256=嗯，我也是。以後你累了、想放鬆的時候，我也會陪著你，一起守護這份安心的氛圍。",
        "gal_map_text_206101257=敖靈嘴角微揚，眼神柔和，雙手自然垂在身側。抬頭看了看身邊的書店櫥窗，又轉頭看向你。",
        "gal_map_text_206101258=從你第一次害羞擋著筆記本不讓我看，到後來主動靠近貼貼紙，再到剛才不舍的眼神，每一個瞬間都讓我覺得你很可愛，深深被你吸引。",
        "gal_map_text_206101259=敖靈手叉腰，身體微微挺胸，眼神坦蕩又明亮。抬手捋了捋頭髮，指尖劃過臉頰。",
        "gal_map_text_206101260=真的嗎？原來你這麼關注我！其實我也很在意你，你認真做事的樣子、溫柔說話的語氣，都讓我覺得很吸引，總忍不住想多看你幾眼。",
        "gal_map_text_206101261=敖靈直接伸手抓住你的手腕，身體湊近你，眼神緊緊鎖住你的眼睛。指尖用力，語氣興奮不已。",
        "gal_map_text_206101262=我也是！我早就被你吸引了！你幫我貼貼紙、認真看筆記本的樣子都讓我特別心動，能聽到你這麼說，我太開心了，想一直和你這樣下去！",
        "gal_map_text_206101263=敖靈身前輕輕絞著衣角，臉頰泛紅，眼神低垂。抬頭飛快看了你一眼，又迅速低下頭。",
        "gal_map_text_206101264=謝謝你…… 沒想到你會注意到這些瞬間。其實我也很在意你，你的很多樣子都讓我覺得很特別，也很吸引我，我很珍惜這份感覺。",
        "gal_map_text_206101265=敖靈雙手緊緊攥著衣角，指尖泛白，眼神躲閃著不敢看你。聲音細若蚊蚋，身體卻悄悄向你挪動。",
        "gal_map_text_206101266=我…… 我也是。你也很吸引我，和你在一起時很開心。能聽到你這麼說，我真的很滿足，也很在意你。",
        "gal_map_text_206101267=以後我還要收集更多你的可愛瞬間，把它們都藏在心裡，當成最珍貴的寶藏。",
        "gal_map_text_206101268=不許偷偷記！要記的話，也要讓我知道，我們一起把這些瞬間變成甜甜的回憶。",
        "gal_map_text_206101269=敖靈臉頰泛紅，輕輕推開他的手，卻帶著笑意，抬手捂住你的眼睛，指尖帶著溫熱的溫度。",
        "gal_map_text_206101270=你們並肩走在華燈之下，腳步放慢，彼此的距離不自覺地拉近，肩膀偶爾輕輕碰撞，都帶著心照不宣的溫柔。",
        "gal_map_text_206101271=晚風裡，她的發梢偶爾拂過你的手臂，帶著淡淡的清香。走到街角的路燈下，你們停下腳步，相視一笑，眼裡的溫柔與悸動，比霓虹燈更耀眼。",
        "gal_map_text_206101272=這一刻，無需更多言語，時光已經為你們定格了最珍貴的瞬間，那些未說出口的心意，早已在空氣裡悄悄蔓延，預示著更多美好時光的到來。",
        "gal_map_text_206101273=溫暖的燈光灑在休息區的沙發上，你們面前的果汁冒著淡淡的果香，杯壁凝結的水珠順著杯身緩緩滑落，在桌面上暈開小小的水痕。經歷了密室裡的緊張協作與心意相通，此刻的寧靜顯得格外珍貴。",
        "gal_map_text_206101274=休息區裡人不多，輕柔的背景音樂在空氣中流淌，混合著果汁的清甜，營造出愜意又私密的氛圍。",
        "gal_map_text_206101275=剛從密室出來時的興奮還未完全褪去，敖靈的臉頰帶著淡淡的紅暈，眼底閃著未散的光芒。想起剛才在密室裡的種種 —— 一起破解機關時的專注、遇到難題時的互相鼓勵、成功通關後的雀躍擁抱，那些緊張又甜蜜的瞬間，像電影片段一樣在腦海裡重播。",
        "gal_map_text_206101276=此刻坐在一起，沒有了機關的束縛，沒有了時間的壓力，反而讓你們更能靜下心來，感受彼此的心意。",
        "gal_map_text_206101277=今天真的很刺激，謝謝你帶我體驗這麼有趣的冒險。和你一起破解謎題的時候，我一點都不害怕，甚至覺得很安心，總覺得不管遇到什麼難題，你都能想到辦法。",
        "gal_map_text_206101278=我也覺得很開心，有你一起合作，再難的謎題都變得簡單了。其實我一開始也有點擔心你會害怕，沒想到你這麼勇敢，破解那個星辰羅盤的時候，你的思路比我還清晰。你的信任，比任何線索都重要。",
        "gal_map_text_206101279=你看著敖靈真誠的眼神，眼底映著燈光的柔光，想起密室裡敖靈緊緊攥著你袖子的模樣、掌心相觸時的溫度、破解謎題後敖靈撲進你懷裡的雀躍 —— 這些瞬間像碎片一樣拼湊起來，變成了心裡最柔軟的觸動。休息區的背景音樂輕柔舒緩，果汁的清甜氣息縈繞鼻尖，此刻的氛圍恰到好處，你想把這份因敖靈而起的安心與在意，坦誠地告訴敖靈，讓敖靈知道，敖靈的信任與依賴，同樣溫暖了你的心。",
        "gal_map_text_206101280=細節捕捉・冒險心動",
        "gal_map_text_206101281=默契共鳴・並肩告白",
        "gal_map_text_206101282=冒險延續・未來期許",
        "gal_map_text_206101283=主動守護・心意升溫",
        "gal_map_text_206101284=安心同行・氛圍珍視",
        "gal_map_text_206101285=心動瞬間・直白傾訴",
        "gal_map_text_206101286=破解機關時，你掌心的溫度、緊張時攥著我袖子的力度，還有通關後雀躍擁抱我的模樣，每一個細節都讓我心動，和你冒險的每一秒都值得珍藏。",
        "gal_map_text_206101287=敖靈手捂住胸口，手指都能感受到胸腔的起伏。只是假裝興奮掩飾慌亂，你掌心的溫度、護著我的樣子，我都悄悄記在心裡，特別心動。",
        "gal_map_text_206101288=原來你也記得這些細節！剛才擁抱你時我心跳得好快。",
        "gal_map_text_206101289=敖靈身體湊近你，額頭幾乎碰到你的肩膀。伸手抓住你的手腕，指尖緊緊包裹住你的指節，眼神發亮。",
        "gal_map_text_206101290=早就發現你在關注我了！你護著我擠過人群的時候，我就覺得特別有安全感。也特別心動，和你一起冒險的每一刻都很珍貴！",
        "gal_map_text_206101291=敖靈抬頭飛快看了你一眼又低下頭，手指蹭了蹭褲子。雙手放在腿上輕輕絞著衣角，臉頰慢慢泛起紅暈，眼神有些無措地飄向一側。",
        "gal_map_text_206101292=啊…… 這些小細節你都記得？我都沒太在意。不過被你這麼一說，和你一起冒險的時光確實很特別，我也很在意你。",
        "gal_map_text_206101293=敖靈嘴角微微上揚，腳步不自覺向你靠近半步。雙手自然垂在身側，手指輕輕敲擊大腿，眼神茫然地看著你。",
        "gal_map_text_206101294=我…… 我都沒發現你這麼關注我。不過聽你這麼說，我很開心，和你一起冒險很安心，想一直這樣和你同行。",
        "gal_map_text_206101295=這些冒險裡的小細節，都是我最珍貴的回憶。以後不管再去什麼地方冒險，我都會把你的每一個樣子都記牢。",
        "gal_map_text_206101296=我也會！你護著我的樣子、認真破解謎題的樣子，我都記在心裡了。以後的冒險，我只想和你一起去。",
        "gal_map_text_206101297=敖靈眼神發燙，主動抓住他的手腕，拉著你的手放在自己的胸口。",
        "gal_map_text_206101298=調整星辰羅盤、破解密碼鎖時，我們不用多說就能懂彼此的思路，你說出的下一步剛好是我想到的，這種默契太難得，想和你經歷更多。",
        "gal_map_text_206101299=敖靈雙手用力抓住你的胳膊，身體輕輕搖晃，眼神裡滿是雀躍，起腳尖湊近你，呼吸帶著淡淡的果汁香。",
        "gal_map_text_206101300=我也是！破解密碼鎖時我正想告訴你我的思路，你就先說出來了。這種心意相通的默契太難得，我早就很在意你，想和你一直在一起！",
        "gal_map_text_206101301=敖靈直接伸手抱住你的胳膊，臉頰貼在你的衣袖上，語氣急促又雀躍。抬頭時眼底閃著光，手指緊緊扣住你的胳膊。",
        "gal_map_text_206101302=對呀對呀！我早就想說我們超有默契的！和你一起破解謎題完全不用費口舌。這種感覺太好，我真的很喜歡和你待在一起，想瞭解你更多！",
        "gal_map_text_206101303=敖靈身體微微向你傾斜，距離拉近了些許。",
        "gal_map_text_206101304=嗯，和你相處確實很有默契，很多事不用刻意說明你就懂。這種感覺很美好，我很珍惜，也很在意和你有關的每一個瞬間。",
        "gal_map_text_206101305=敖靈雙手交叉放在身前，眼神沒有起伏，卻緩緩向你邁出一小步。",
        "gal_map_text_206101306=我也覺得我們挺合拍的。這種默契很難得，和你一起面對挑戰很舒服，我願意繼續和你走下去。",
        "gal_map_text_206101307=這種並肩作戰的默契太難得，以後不管是冒險還是生活裡的難題，我都想和你一起面對。",
        "gal_map_text_206101308=我也是！以後我們就是最佳搭檔。不管遇到什麼都不用怕，只要我們一起，就能解決所有問題。",
        "gal_map_text_206101309=敖靈嘴角上揚，眼神堅定，抬手拍了拍你的肩膀，指尖帶著輕微的力。",
        "gal_map_text_206101310=今天的冒險太難忘了，我開始期待以後能有更多這樣的時光，不管是刺激挑戰還是平淡日常，都想和你一起面對，創造更多珍貴回憶。",
        "gal_map_text_206101311=敖靈手握拳放在胸前，身體輕輕蹦跳了一下。抓住你的手腕，指尖帶著溫熱的溫度。",
        "gal_map_text_206101312=我也是我也是！我早就開始期待了！想和你一起體驗更多冒險。一起面對更多未知，把所有難忘的瞬間都和你分享，能聽到你這麼說我太開心了！",
        "gal_map_text_206101313=敖靈直接拽著你的手往前走了兩步，語氣興奮到幾乎蹦起來。轉頭時馬尾辮輕輕掃過你的胳膊，眼神發亮。",
        "gal_map_text_206101314=哇！這簡直和我想的一模一樣！我還怕你不想和我一起逛更多地方呢！以後我們不僅要逛市集，還要一起學做手工糖果、一起打卡甜品店，把所有日子都過得像今天這麼甜！",
        "gal_map_text_206101315=敖靈輕輕點頭，嘴角勾起淺淺的弧度。",
        "gal_map_text_206101316=謝謝你，我也很期待未來能有更多這樣的時光。今天的甜蜜回憶很珍貴，我不想只停留在當下，想和你創造更多專屬我們的甜蜜瞬間。",
        "gal_map_text_206101317=敖靈緩緩點頭，腳步向你靠近半步。雙手交疊放在小腹前，身體站得筆直，眼神裡滿是篤定。",
        "gal_map_text_206101318=嗯，我也有同樣的期待。和你在一起的時光很踏實、很甜蜜，不管是逛市集還是日常相處，我都願意參與你的未來，延續這份美好。",
        "gal_map_text_206101319=那我們就把冒險列成清單，從溫和的露營開始，再去挑戰更有趣的專案，把每一次相處都變成難忘的經歷。",
        "gal_map_text_206101320=好！我現在就開始查攻略做清單！以後的每一次冒險，都要有你在身邊，這樣才夠開心。",
        "gal_map_text_206101321=敖靈用力點頭，眼神發亮，手指在手機上快速滑動。把手機螢幕轉向你，指尖點在清單介面。",
        "gal_map_text_206101322=我越來越想靠近你，想保護你不被人群撞到，想在你緊張時給你安心，想瞭解你更多不為人知的小秘密，這種心意越來越強烈。",
        "gal_map_text_206101323=敖靈雙手自然張開，抬手拍了拍你的肩膀，動作乾脆。身體微微前傾，眼神坦蕩又明亮。",
        "gal_map_text_206101324=我也是！我早就想讓你靠近我，想讓你瞭解我的更多事情。想在你身邊感受更多安心。能聽到你這麼說，我太開心了，也很想靠近你！",
        "gal_map_text_206101325=敖靈直接伸手抓住你的雙手，指尖緊緊包裹住你的指節，額頭幾乎要碰到你的肩膀，語氣興奮不已。",
        "gal_map_text_206101326=太好了！我還以為只有我一個人這麼想呢！我早就想讓你多瞭解我，也想多瞭解你！以後不管遇到什麼，我都想第一時間告訴你，不想再有任何小秘密！",
        "gal_map_text_206101327=敖靈的手放在身前輕輕絞著衣角，臉頰泛紅，眼神低垂。",
        "gal_map_text_206101328=謝謝你…… 我也很期待我們能靠得更近一點。在你身邊我總是很安心，我也想慢慢讓你瞭解我更多，珍惜這份彼此在意的感覺。",
        "gal_map_text_206101329=敖靈雙手緊緊攥著衣角，指尖泛白，眼神躲閃著不敢看你。",
        "gal_map_text_206101330=我…… 我也是。能被你這樣在意，我很開心。我也想靠近你，只是不太會表達…… 希望你能慢慢瞭解我。",
        "gal_map_text_206101331=不管你會不會表達，我都會慢慢瞭解你。以後我會一直在你身邊，做你最堅實的依靠。",
        "gal_map_text_206101332=嗯…… 我也會努力學著表達自己。有你在身邊，我什麼都不怕。",
        "gal_map_text_206101333=敖靈臉頰微紅，輕輕點頭，握住你的手，將兩人相握的手舉到身前。",
        "gal_map_text_206101334=和你並肩面對未知時，我第一次覺得這麼踏實，不用獨自思考所有難題，不用偽裝堅強，這種有人同行的安心感，是你帶給我的，我很珍惜。",
        "gal_map_text_206101335=敖靈雙手輕輕搭在你的胳膊上，身體微微前傾，眼神裡滿是真誠，指尖輕輕拍了拍你的胳膊。",
        "gal_map_text_206101336=我也是！和你並肩面對未知的時候，我一點都不害怕。因為我知道你會在我身邊。這種安心感太難得，我真的很珍惜，也很在意你！",
        "gal_map_text_206101337=敖靈抬頭時眼底閃著光，手指緊緊扣住你的衣袖。",
        "gal_map_text_206101338=對呀對呀！有你在身邊，再難的謎題都覺得不可怕了！和你一起冒險超級開心，我真的很喜歡這種有人同行的感覺，也超級喜歡和你待在一起！",
        "gal_map_text_206101339=敖靈身體微微向你傾斜，距離拉近些許。",
        "gal_map_text_206101340=嗯，和你一起的時候很安心，不用獨自面對所有困難。這種踏實的感覺很難得，我很珍惜，也感謝你一直陪著我。",
        "gal_map_text_206101341=敖靈輕輕碰了碰你的手臂，動作短暫卻清晰。",
        "gal_map_text_206101342=我…… 我也是。有你在身邊，我覺得很踏實。這種有人同行的感覺很好，我很在意你。",
        "gal_map_text_206101343=以後不管是冒險還是生活中的難題，我都會陪著你，不會讓你獨自面對。",
        "gal_map_text_206101344=嗯，我也會陪著你。以後我們就這樣互相陪伴，一起面對所有未知的挑戰。",
        "gal_map_text_206101345=敖靈抬頭看了看休息區的燈光，又轉頭看向你。",
        "gal_map_text_206101346=你破解謎題時的堅定、害怕時的小聲依賴、成功後的燦爛笑容，每一個瞬間都深深吸引著我，讓我覺得你特別可愛，越來越想靠近你。",
        "gal_map_text_206101347=敖靈手叉腰，身體微微挺胸，眼神坦蕩。",
        "gal_map_text_206101348=真的嗎？原來你這麼關注我！其實我也很在意你，你認真破解謎題的樣子、緊張時保護我的樣子，都讓我覺得很有安全感，也很心動！",
        "gal_map_text_206101349=敖靈身體湊近你，眼神緊緊鎖住你的眼睛。",
        "gal_map_text_206101350=我也是！我早就被你吸引了！你專注的樣子超級有魅力，剛才害怕的時候靠在你身邊，我心跳得好快！能聽到你這麼說，我太開心了！",
        "gal_map_text_206101351=敖靈抬頭飛快看了你一眼，又迅速低下頭。",
        "gal_map_text_206101352=謝謝你…… 沒想到你會注意到這些瞬間。其實我也很在意你，和你在一起的時候很安心，你的很多樣子都讓我覺得很特別。",
        "gal_map_text_206101353=敖靈雙手緊緊攥著衣角，指尖泛白，眼神躲閃著不敢看你。",
        "gal_map_text_206101354=我…… 我也是。你也很吸引我，和你一起冒險很開心。能被你這樣在意，我真的很滿足。",
        "gal_map_text_206101355=你害怕時依賴我的樣子也很可愛，我很喜歡。以後不管什麼時候，我都會在你身邊保護你。",
        "gal_map_text_206101356=嗯…… 我也會一直在你身邊支持你。以後我們還要一起創造更多開心的回憶。",
        "gal_map_text_206101357=敖靈頰泛紅，輕輕低下頭，雙手放在身前，抬頭時眼底閃著光。",
        "gal_map_text_206101358=休息區的燈光依舊柔和，果汁的清甜氣息縈繞在身邊。你們並肩坐在沙發上，肩膀輕輕挨著，彼此的眼神裡滿是溫柔與悸動。",
        "gal_map_text_206101359=偶爾對視一笑，無需更多言語，心意早已相通。輕柔的背景音樂在空氣中流淌，為這份寧靜又甜蜜的氛圍增添了幾分浪漫。",
        "gal_map_text_206101360=這一刻，密室的緊張早已消散，只剩下彼此陪伴的溫暖，那些未說出口的在意，在空氣裡悄悄蔓延，預示著更多美好時光的到來。",
        "gal_map_text_206101361=手工糖果鋪的櫥窗裡，五彩斑斕的糖果被做成花朵、星星、小動物的模樣，在暖黃的燈光下熠熠生輝，散發著濃郁的甜香。",
        "gal_map_text_206101362=市集的煙火氣漸漸褪去，周圍的人群變得稀疏，只剩下零星的腳步聲和糖果鋪老闆溫柔的吆喝聲，營造出甜蜜又私密的氛圍。",
        "gal_map_text_206101363=敖靈拉著你的手，眼底閃著純真的喜悅，像個發現寶藏的孩子。想起剛才在市集裡的種種 —— 互相餵食提拉米蘇的甜蜜、擠在人群中她緊緊抓著你胳膊的依賴、分享烤串時的滿足，那些充滿煙火氣的甜蜜瞬間，像裹著糖衣的回憶，在心裡慢慢融化。",
        "gal_map_text_206101364=此刻站在糖果鋪前，甜香縈繞鼻尖，讓你們之間的氛圍變得更加甜蜜，那些未說出口的心意，也變得愈發清晰。",
        "gal_map_text_206101365=快看！這些糖果做得像藝術品一樣，好漂亮啊！和你一起逛市集、吃小吃，比糖果還要甜。我現在還能想起提拉米蘇的味道，還有你喂我吃烤串時的樣子。",
        "gal_map_text_206101366=是啊，和你在一起，連普通的小吃都變得格外美味。你為糖果雀躍的樣子、吃烤串時嘴角沾著蜜汁的模樣，都比櫥窗裡的糖果還要甜，讓我忍不住想一直看著你。",
        "gal_map_text_206101367=糖果鋪的甜香撲面而來，混合著市集殘留的煙火氣，格外治癒。你看著她為糖果心動的模樣，想起剛才互相餵食時她臉頰的紅暈、擠在人群中她依賴的眼神、分享小吃時她滿足的笑容 —— 這些瞬間像電影片段一樣在腦海裡重播，變成了心裡最柔軟的觸動。此刻的氛圍甜蜜又恰到好處，你想把這份因她而起的甜蜜與在意，坦誠地告訴她，讓她知道，和她在一起的每一刻，都像糖果一樣甜。",
        "gal_map_text_206101368=細節捕捉・甜蜜瞬間",
        "gal_map_text_206101369=默契共鳴・美食告白",
        "gal_map_text_206101370=甜蜜延續・未來期許",
        "gal_map_text_206101371=主動靠近・甜蜜升溫",
        "gal_map_text_206101372=安心陪伴・煙火珍視",
        "gal_map_text_206101373=心動瞬間・直白傾訴",
        "gal_map_text_206101374=喂你吃提拉米蘇時你臉頰的紅暈、吃烤串時嘴角沾著蜜汁的模樣，還有現在為糖果雀躍的眼神，每一個細節都讓我心動，和你在一起的每一秒都像糖果一樣甜。",
        "gal_map_text_206101375=敖靈雙手撐在糖果鋪的櫥窗邊，身體微微前傾，指尖輕輕劃過玻璃。",
        "gal_map_text_206101376=原來你也記得這些細節！被你喂著吃提拉米蘇時我心跳得好快。覺得比任何糖果都甜，你幫我擦嘴角蜜汁的動作、牽著我的手的溫度，我都記在心裡，特別心動。",
        "gal_map_text_206101377=敖靈伸手抓住你的手腕，指尖緊緊包裹住你的指節，眼神發亮。",
        "gal_map_text_206101378=我早就發現你在偷偷關注我了！你喂我吃提拉米蘇時眼神超溫柔。幫我擦嘴角時的動作也很輕，我都假裝沒察覺，心裡卻甜得像蜜一樣。和你在一起的每一刻都很珍貴，我也早就心動啦！",
        "gal_map_text_206101379=敖靈臉頰慢慢泛起紅暈，眼神有些無措地飄向一側。",
        "gal_map_text_206101380=啊…… 這些小細節你都記得這麼清楚？我都沒太留意。不過被你這麼一說，好像和你一起吃美食的時光真的特別甜，我也很在意你。",
        "gal_map_text_206101381=敖靈嘴角微微上揚，腳步不自覺向你靠近半步。",
        "gal_map_text_206101382=我…… 我都沒發現你在關注我這些。不過聽你這麼說，我很開心。和你一起逛市集、吃美食的感覺很好，想一直這樣和你在一起。",
        "gal_map_text_206101383=你嘴角沾著蜜汁的樣子、為糖果雀躍的眼神，我都拍下來存成秘密相冊了。以後每一次和你吃美食，我都要這樣記錄。",
        "gal_map_text_206101384=不許偷偷拍照！要拍的話我們一起拍合照！把所有甜甜的瞬間都做成相冊，以後老了一起看。",
        "gal_map_text_206101385=敖靈臉頰泛紅，伸手去搶你的手機。敖靈抓住你的手腕，身體微微前傾。",
        "gal_map_text_206101386=剛才逛市集時，我正想給你買烤串你就說想吃，我想找地方坐下分享你就找到了長椅，這種不用多說的默契很甜蜜，我越來越在意你。",
        "gal_map_text_206101387=敖靈踮起腳尖湊近你，呼吸帶著淡淡的食物香氣。",
        "gal_map_text_206101388=我也是我也是！剛才我正想跟你說想吃烤串，你就主動要去買。找座位的時候也是，我心裡想的和你做的剛好一樣，這種默契太神奇了！我早就很在意你，想和你一直這樣甜甜蜜蜜下去！",
        "gal_map_text_206101389=敖靈伸手抱住你的胳膊，臉頰貼在你的衣袖上，語氣急促又雀躍。",
        "gal_map_text_206101390=對呀對呀！我們的默契也太好了吧！不管是想吃的東西還是想做的事都能想到一起。和你在一起逛市集真的超開心！我好喜歡和你待在一起，想瞭解你更多，永遠不分開！",
        "gal_map_text_206101391=敖靈身體微微向你傾斜，距離拉近了些許。",
        "gal_map_text_206101392=嗯，和你相處確實很有默契，很多事不用刻意說你就懂。這種甜蜜又舒服的感覺很難得，我很珍惜，也很在意你。",
        "gal_map_text_206101393=敖靈雙手交叉放在身前，眼神沒有起伏，卻緩緩向你邁出一小步。指尖輕輕碰了碰你的衣角，動作短暫卻清晰。",
        "gal_map_text_206101394=我也覺得我們挺合拍的。這種不用多言的默契很好，和你一起逛市集、分享美食很舒服，我願意繼續和你走下去。",
        "gal_map_text_206101395=這種心有靈犀的甜蜜，我想一直延續下去。以後逛市集，我不用問就知道你想吃什麼、想去哪裡。",
        "gal_map_text_206101396=我也是！以後我也會牢牢記住你的喜好，你想吃的東西我都幫你留意，我們一起把每一次逛市集都過得甜甜的。",
        "gal_map_text_206101397=敖靈抬頭看了看糖果鋪的櫥窗，又轉頭看向你。",
        "gal_map_text_206101398=今天的市集太甜蜜了，我開始期待以後能和你一起逛更多市集，吃更多美食，把所有甜蜜瞬間都和你分享，讓這份甜一直延續下去。",
        "gal_map_text_206101399=敖靈身體輕輕蹦跳了一下，住你的手腕，指尖帶著溫熱的溫度。",
        "gal_map_text_206101400=我也是我也是！我早就開始期待了！想和你一起逛遍所有美食市集。嘗遍天下所有好吃的，把每一次甜蜜的瞬間都記錄下來，能聽到你這麼說我太開心了！",
        "gal_map_text_206101401=敖靈拽著你的手往前走了兩步，語氣興奮到幾乎蹦起來。",
        "gal_map_text_206101402=哇！這簡直和我想的一模一樣！我還怕你不想和我一起逛更多市集呢！以後我們不僅要逛市集，還要一起學做手工糖果、一起打卡甜品店，把所有日子都過得像今天這麼甜！",
        "gal_map_text_206101403=敖靈輕輕點頭，嘴角勾起淺淺的弧度。",
        "gal_map_text_206101404=謝謝你，我也很期待未來能有更多這樣的時光。今天的甜蜜回憶很珍貴，我不想只停留在當下，想和你創造更多專屬我們的甜蜜瞬間。",
        "gal_map_text_206101405=敖靈身體站得筆直，眼神裡滿是篤定，緩緩點頭，腳步向你靠近半步。",
        "gal_map_text_206101406=嗯，我也有同樣的期待。和你在一起的時光很踏實、很甜蜜，不管是逛市集還是日常相處，我都願意參與你的未來，延續這份美好。",
        "gal_map_text_206101407=這盒糖果就當我們的約定信物，以後每逛一個市集，就收集一種特色糖果，把甜蜜攢起來。",
        "gal_map_text_206101408=好呀！我還要專門準備一個盒子裝這些糖果。每一顆都寫上我們逛市集的日期，讓甜蜜有跡可循。",
        "gal_map_text_206101409=敖靈低頭看著糖果盒，指尖輕輕撫摸盒身。",
        "gal_map_text_206101410=我越來越想靠近你，想一直牽著你的手，想在你想吃美食時立刻為你買來，想在你開心時陪著你一起笑，這種心意越來越強烈。",
        "gal_map_text_206101411=敖靈拍了拍你的肩膀，動作乾脆。",
        "gal_map_text_206101412=也是！我早就想讓你一直牽著我的手，想讓你多瞭解我的喜好。想在你身邊分享所有開心的事。能聽到你這麼說，我太開心了，也很想一直靠近你！",
        "gal_map_text_206101413=敖靈身體湊近你，額頭幾乎要碰到你的肩膀。",
        "gal_map_text_206101414=太好了！我還以為只有我一個人這麼想呢！我早就想和你分享我所有喜歡的美食，也想知道你喜歡吃什麼，想一直這樣牽著你的手，永遠和你在一起！",
        "gal_map_text_206101415=敖靈雙手放在身前輕輕絞著衣角，臉頰泛紅，眼神低垂。然後抬頭飛快看了你一眼，又迅速低下頭",
        "gal_map_text_206101416=謝謝你…… 我也很想讓我們之間的距離更近一點。想和你互相分享喜好，珍惜這種甜蜜又溫暖的感覺，期待我們越來越熟悉。",
        "gal_map_text_206101417=敖靈緊緊攥著衣角，指尖泛白，眼神躲閃著不敢看你。",
        "gal_map_text_206101418=我…… 我也是。我也很想讓你靠近我，想和你分享更多關於我的事。和你在一起很安心、很甜蜜，我想一直這樣下去。",
        "gal_map_text_206101419=那我現在就牽著你的手，帶你去嘗前面那家超火的甜品。以後不管去哪裡，我的手都為你留著。",
        "gal_map_text_206101420=嗯！我也會牢牢牽著你的手，不鬆開。以後我們要一起吃到老，玩到老。",
        "gal_map_text_206101421=敖靈看了看前方的甜品店，又轉頭看向你。",
        "gal_map_text_206101422=和你一起逛市集、分享美食時總覺得特別安心，不用刻意找話題，不用害怕尷尬，這種熱熱鬧鬧又甜蜜的氛圍，是你帶給我的，我很珍惜。",
        "gal_map_text_206101423=敖靈用力點頭，指尖輕輕拍了拍你的胳膊。",
        "gal_map_text_206101424=我也是！和你一起逛市集、分享美食的時候特別放鬆。不用刻意找話題，哪怕只是安靜地吃著東西都很舒服，這種踏實又甜蜜的氛圍我很珍惜，也很在意你！",
        "gal_map_text_206101425=敖靈抬頭時眼底閃著光，手指緊緊扣住你的衣袖。",
        "gal_map_text_206101426=對呀對呀！不管和你做什麼都覺得特別安心、特別甜。哪怕只是一起排隊買糖果都很開心！我真的很喜歡這種感覺，也超級喜歡和你待在一起！",
        "gal_map_text_206101427=敖靈手放在身側，指尖自然下垂，眼神平靜無波。",
        "gal_map_text_206101428=嗯，和你相處很安心，不用害怕尷尬，不用刻意偽裝自己。這種熱熱鬧鬧又舒服的氛圍很難得，我很珍惜，也感謝你帶給我這種感覺。",
        "gal_map_text_206101429=敖靈指尖輕輕碰了碰你的手臂，動作短暫卻清晰。",
        "gal_map_text_206101430=我…… 我也是。和你在一起時很踏實、很放鬆，這種甜蜜的氛圍很溫暖，也讓我很在意你。",
        "gal_map_text_206101431=以後想逛市集、想放鬆的時候，隨時叫我。我喜歡和你一起感受這種熱熱鬧鬧的煙火氣。",
        "gal_map_text_206101432=嗯，我也是。和你一起逛市集的感覺很舒服，以後我們經常這樣，一起感受生活裡的小甜蜜。",
        "gal_map_text_206101433=敖靈轉頭看了看周圍的攤位，又把頭靠回你的肩膀。",
        "gal_map_text_206101434=你拉著我跑向糖果鋪的雀躍、吃美食時滿足的笑容、害羞時耳尖的紅暈，每一個瞬間都深深吸引著我，讓我覺得你特別可愛，越來越想靠近你。",
        "gal_map_text_206101435=敖靈抬手捋了捋頭髮，指尖劃過臉頰。",
        "gal_map_text_206101436=真的嗎？原來你這麼關注我！其實我也很在意你，你幫我排隊買糖果的樣子、喂我吃美食時的溫柔、看著我笑時的眼神，都讓我覺得很吸引，總忍不住想多看你幾眼。",
        "gal_map_text_206101437=敖靈身體湊近你，眼神緊緊鎖住你的眼睛。",
        "gal_map_text_206101438=我也是！我早就被你吸引了！你認真幫我挑糖果的樣子、記得我不吃辣的喜好、溫柔擦我嘴角的動作，都讓我特別心動，能聽到你這麼說我太開心了，想一直和你這樣甜下去！",
        "gal_map_text_206101439=敖靈雙手放在身前輕輕絞著衣角，臉頰泛紅，眼神低垂。",
        "gal_map_text_206101440=謝謝你…… 沒想到你會注意到這些瞬間。其實我也很在意你，你的很多樣子都讓我覺得很特別，也很吸引我，我很珍惜這份甜蜜的感覺。",
        "gal_map_text_206101441=敖靈聲細若蚊蚋，身體卻悄悄向你挪動。",
        "gal_map_text_206101442=我…… 我也是。你也很吸引我，和你在一起時很開心、很甜蜜。能聽到你這麼說，我真的很滿足，也很在意你。",
        "gal_map_text_206101443=你開心的樣子最可愛，以後我要讓你每天都像現在這樣甜。想吃什麼、想做什麼，都告訴我。",
        "gal_map_text_206101444=嗯！有你在我就很開心了。以後我們還要一起發現更多好吃的、好玩的，把每一天都過得甜甜的。",
        "gal_map_text_206101445=敖靈含著糖果，臉頰泛紅，抬手拍了拍你的手背。",
        "gal_map_text_206101446=糖果鋪的甜香依舊縈繞在身邊，你們並肩站在櫥窗前，手緊緊牽在一起，彼此的指尖傳遞著溫暖與悸動。",
        "gal_map_text_206101447=晚風輕輕吹過，帶著市集的煙火氣與糖果的甜香，將你們的影子拉得很長，交織在一起。偶爾轉頭對視，眼裡的溫柔與歡喜，比櫥窗裡的糖果更耀眼。",
        "gal_map_text_206101448=這一刻，無需更多言語，時光已經為你們定格了最甜蜜的瞬間，那些未說出口的心意，早已在空氣裡悄悄蔓延，預示著更多甜蜜時光的到來。",
        "gal_map_text_206101449=敖靈忽然輕輕拉住了你的袖口，眼神帶著一絲羞澀卻格外認真。'等等…… 還有一件東西，我覺得現在給你，比任何時候都合適。' 敖靈轉過身，從隨身的帆布袋裡取出一個用素麻布仔細包裹的長方形物體。",
        "gal_map_text_206101450=揭開麻布，裡面是一本定制的手工皮革書衣。書衣由深棕色植鞣革縫製，表面有溫潤的自然紋理和手工敲打的細膩痕跡。書衣的正面，用極細的銀線，繡著一行幾乎看不見的斜體小字：'Once upon a time, in a purrfect corner…'（很久以前，在一個完美的角落…）。",
        "gal_map_text_206101451=書衣內側，貼著一張小小的卡紙，上面是敖靈清秀的字跡：'願我們的故事，像好書一樣，越讀越暖。'",
        "gal_map_text_206101452=接過書衣，指尖觸到溫潤的皮革，心中滿是感動。",
        "gal_map_text_206101453=這太珍貴了，我一定會好好珍藏，以後我的每一本常讀書，都會用它包裹。",
        "gal_map_text_206101454=敖靈臉頰微紅，嘴角帶著笑意。",
        "gal_map_text_206101455=我知道你喜歡讀書，所以特意找手工店定制的。植鞣革會隨著時間變得更溫潤，就像我們的關係一樣。",
        "gal_map_text_206101456=敖靈，我想和你一起，把這個‘完美的角落’裡的故事，一直續寫下去。你願意做我的女朋友嗎？",
        "gal_map_text_206101457=敖靈用力點頭，眼裡閃著光。",
        "gal_map_text_206101458=我願意！從和你一起貼貼紙的那一刻起，我就希望能和你有更多以後。",
        "gal_map_text_206101459=你將書衣小心翼翼地放進文創袋，伸手輕輕牽住敖靈的手。晚風裡，你們的影子在路燈下交織在一起，書店的暖光為你們見證，彼此的心意在信物的聯結下，變得格外堅定。",
        "gal_map_text_206101460=離別時分，敖靈從包裡拿出一個精緻的皮質書簽，流蘇是手工編織的淺棕色棉線，與書店的氛圍格外契合。敖靈將書簽遞到你面前，眼神裡帶著些許不好意思，卻難掩期待。",
        "gal_map_text_206101461=你接過書簽，觸感柔軟細膩，皮質的正面用燙金的小字印著 '從認識的每一秒開始都是期待。'，背面是一個小小的、用鐳射雕刻的書本圖案，邊緣還有細微的打磨痕跡，能看出是精心製作的。",
        "gal_map_text_206101462=敖靈聲音輕輕的。",
        "gal_map_text_206101463=這個送給你。是我之前自己做著玩的，選了最耐磨損的牛皮材質。今天和你一起看了那麼多書，覺得它應該有個更好的主人。",
        "gal_map_text_206101464=心中一動，認真地看著敖靈。",
        "gal_map_text_206101465=這將是我未來閱讀的每一本書裡，最珍貴的一頁。敖靈，我想和你一起探索更多未知的故事，你願意做我的女朋友嗎？",
        "gal_map_text_206101466=臉頰泛紅，用力點頭",
        "gal_map_text_206101467=我願意！其實我早就期待著這一刻了，和你在一起，不管做什麼都覺得很開心。",
        "gal_map_text_206101468=你將書簽放進貼身的口袋，伸手輕輕擁抱了敖靈一下。書店門口的燈光溫柔地籠罩著你們，書簽上的燙金字在光線下閃爍，像是在訴說著剛剛開始的甜蜜故事。",
        "gal_map_text_206101469=敖靈看著你，眼神溫柔而不舍，沒有拿出任何禮物，卻主動上前一步，輕輕握住了你的手。敖靈的指尖微涼，卻帶著堅定的力量。",
        "gal_map_text_206101470=今天真的太開心了，和你在一起的時光總是過得特別快。我不想就這麼結束，你下次有空的時候，我們還能來這家書店嗎？我想和你一起讀完上次沒看完的那本書。",
        "gal_map_text_206101471=你握緊敖靈的手，心中滿是暖意。",
        "gal_map_text_206101472=我當然願意！其實我還有很多話想對你說，敖靈，你願意做我的女朋友嗎？讓我們一起把更多的空閒時光，都變成這樣美好的回憶。",
        "gal_map_text_206101473=敖靈眼睛亮了起來，用力點頭。",
        "gal_map_text_206101474=我願意！我一直都很在意你，以後我們可以一起逛遍所有喜歡的書店。",
        "gal_map_text_206101475=你們約定了下次見面的時間，在書店門口互道再見。看著敖靈轉身離開的背影，心中滿是對未來的期待，彼此的心意已經明確，甜蜜的篇章即將開啟。",
        "gal_map_text_206101476=敖靈站在原地，看著你，嘴角帶著溫柔的笑意，沒有多餘的動作，卻用眼神傳遞著所有的心意。晚風輕輕吹起敖靈的發梢，氛圍寧靜而美好。",
        "gal_map_text_206101477=今天的一切，我都會好好記在心裡。和你相處的感覺真的很好，踏實又安心。",
        "gal_map_text_206101478=你認真地看著敖靈，語氣堅定",
        "gal_map_text_206101479=敖靈，和你在一起的每一秒，我都覺得很珍貴。我不想只做你的朋友，我想做能一直陪伴你的人。你願意做我的女朋友嗎？",
        "gal_map_text_206101480=敖靈臉頰微紅，輕輕點頭，眼裡滿是幸福",
        "gal_map_text_206101481=我願意。以後不管是開心還是難過，我都想和你一起分享。",
        "gal_map_text_206101482=那我送你回家吧，以後不會再讓你一個人走夜路了。",
        "gal_map_text_206101483=你陪著敖靈慢慢走向回家的方向，路燈將你們的影子拉得很長，彼此的腳步默契一致，無聲地訴說著剛剛確立的親密關係。",
        "gal_map_text_206101484=在成功逃離密室、心跳尚未完全平息的出口處，敖靈深吸一口氣，從貼身的口袋裡取出一個冰冷、沉重、泛著啞光金屬色澤的立方體。敖靈將立方體遞到你面前，眼神裡帶著一絲期待與驕傲。",
        "gal_map_text_206101485=它約莫掌心大小，由不知名的暗色合金鑄造，表面沒有任何裝飾，只有六個面上各有一個精密複雜的機械轉盤鎖，每個轉盤上都刻著不同的神秘符號 —— 正是密室中星辰羅盤、密碼鎖上出現的符號體系。",
        "gal_map_text_206101486=立方體本身嚴絲合縫，仿佛一個絕對不可侵入的金屬塊，拿在手裡分量十足，帶著些許涼意。",
        "gal_map_text_206101487=這個是我特意找工匠定制的，上面的符號都是按照密室的設計圖還原的。我覺得，能一起破解這麼多難題的我們，應該有一個專屬的‘默契信物’。",
        "gal_map_text_206101488=敖靈仔細端詳著立方體，感受著上面的符號紋理，心中滿是震撼",
        "gal_map_text_206101489=這太特別了，每個符號都讓我想起剛才和你一起破解謎題的瞬間。我會好好收藏它，以後每次看到，都會想起今天的冒險。",
        "gal_map_text_206101490=其實…… 我想說的是，和你一起冒險的時光，比任何挑戰都更有意義。我想和你一起面對更多未知，你願意做我的女朋友嗎？",
        "gal_map_text_206101491=你用力點頭，將立方體握緊在手中",
        "gal_map_text_206101492=我願意！以後不管是密室冒險，還是生活中的挑戰，我都會像今天一樣，和你並肩作戰。",
        "gal_map_text_206101493=你將合金立方體放進包裡，伸手輕輕牽住敖靈的手。霓虹燈的光芒映在你們臉上，那些並肩破解謎題的瞬間，都化作了此刻的心動與堅定，彼此的關係在信物的見證下，正式確立。",
        "gal_map_text_206101494=商業街的出口，敖靈低頭從包裡拿出一個小巧的絲絨袋，輕輕打開，裡面是一塊被精心鑲嵌在銀色掛墜中的、閃爍著微光的藍色琉璃碎片，形狀不規則，卻有種獨特的美感，像是從密室的某個機關上取下的紀念品。",
        "gal_map_text_206101495=琉璃碎片泛著淡淡的藍光，在燈光下折射出細碎的光芒，銀色掛墜的邊緣打磨得十分光滑，背面刻著一個小小的 '契' 字。",
        "gal_map_text_206101496=敖靈將掛墜從絲絨袋中取出，遞到你面前，眼神裡帶著溫柔的笑意。",
        "gal_map_text_206101497=一份見證過我們攜手努力的信物，也是我們故事的第一個書簽。琉璃碎片代表著我們一起破解的難題，銀色掛墜象徵著我們的默契，希望你能喜歡。",
        "gal_map_text_206101498=你接過掛墜，指尖觸到微涼的琉璃和溫潤的銀飾，心中滿是感動",
        "gal_map_text_206101499=我很喜歡，這是我收到過最有意義的禮物。每次看到它，我都會想起今天和你一起並肩作戰的時光。",
        "gal_map_text_206101500=其實我早就很在意你了，和你在一起的每一刻都很安心。你願意做我的女朋友嗎？",
        "gal_map_text_206101501=我願意！以後我們可以一起挑戰更多的密室，創造更多屬於我們的回憶。",
        "gal_map_text_206101502=掛墜在胸前微微晃動，藍光閃爍，像是在見證著你們的約定。你們並肩走向商業街的盡頭，彼此的腳步格外默契，心中滿是對未來的期待。",
        "gal_map_text_206101503=敖靈看著你，眼神裡滿是興奮與不舍，沒有拿出任何禮物，卻主動說起了剛才的冒險細節，語氣裡帶著掩飾不住的開心。",
        "gal_map_text_206101504=剛才破解那個密碼鎖的時候，我真的以為我們要被困住了，還好有你想到了符號的規律。和你一起冒險真的太有意思了，我還想和你一起挑戰下一個主題密室，可以嗎？",
        "gal_map_text_206101505=當然可以！其實我還有句話想對你說，敖靈，和你在一起的時光，不管是緊張的冒險還是安靜的相處，都讓我覺得很特別。你願意做我的女朋友嗎？",
        "gal_map_text_206101506=我願意！我一直都很想告訴你，我很在意你。以後我們可以一起探索更多有趣的密室，一起經歷更多難忘的瞬間。",
        "gal_map_text_206101507=你們約定了下次挑戰的密室主題，在出口處互道再見。看著敖靈轉身離開的背影，心中滿是對下一次見面的期待，彼此的心意已經明確，甜蜜的冒險即將繼續",
        "gal_map_text_206101508=敖靈站在原地，看著密室出口的霓虹燈，眼神裡滿是回味，忽然轉頭看向你，嘴角帶著溫柔的笑意，語氣裡帶著一絲認真。",
        "gal_map_text_206101509=今天的冒險真的很難忘，和你一起破解謎題的感覺，是我從未有過的。我很珍惜和你相處的時光。",
        "gal_map_text_206101510=我也是，和你在一起的每一秒都很珍貴。敖靈，我不想只做你的冒險夥伴，我想做能一直陪伴你的人。你願意做我的女朋友嗎？",
        "gal_map_text_206101511=我願意。其實從我們一起走進密室的那一刻起，我就覺得你是一個很可靠的人。以後不管是冒險還是生活，我都想和你一起面對。",
        "gal_map_text_206101512=你們並肩走在回家的路上，聊著剛才冒險中的趣事，彼此的笑聲在夜空中回蕩。雖然沒有信物的聯結，但彼此的心意已經相通，甜蜜的關係正式確立。",
        "gal_map_text_206101513=在市集喧囂漸散、彼此手中還留著食物餘香的出口，敖靈從隨身大包裡，捧出一個厚重、精緻、仿佛古籍般的硬殼標本冊。敖靈將標本冊輕輕放在你手中，眼神裡帶著期待與溫柔。",
        "gal_map_text_206101514=標本冊的封面是深藍色的天鵝絨，燙金標題寫著：'Gustatory Cartography: Vol. 1'（味覺繪圖學：第一卷）。標題下方，是你們今天的日期，以及一行小字：'Initiates: [你的名字] & [敖靈的名字]'。",
        "gal_map_text_206101515=敖靈小心翼翼地打開厚重的封面，裡面不是照片或文字，而是一頁頁特製的、帶有透明收納夾層的厚卡紙。每一頁的夾層裡，都封裝著一小撮真實的、來自今晚市集的香料或食材 —— 烤串的孜然、提拉米蘇的可哥粉、手工糖果的薄荷碎，並被精心擺成抽象的圖案或地圖的輪廓。",
        "gal_map_text_206101516=我想把今天我們一起吃過的美食，都做成‘味覺標本’，讓這份甜蜜能一直留存下來。",
        "gal_map_text_206101517=敖靈指著其中一頁",
        "gal_map_text_206101518=這一頁是孜然和辣椒面，代表我們一起吃的烤串；這一頁是可哥粉和糖霜，是我們分享的提拉米蘇。",
        "gal_map_text_206101519=和你一起分享美食的時光，是我最珍貴的回憶。我想和你一起探索更多美食，一起填滿這本標本冊的後續篇章。你願意做我的女朋友嗎？",
        "gal_map_text_206101520=我願意！以後不管是市集、餐廳，還是家常便飯，我都想和你一起分享，讓我們的‘味覺繪圖學’，一直延續下去。",
        "gal_map_text_206101521=你抱著厚重的標本冊，伸手輕輕牽住敖靈的手。晚風裡，糖果的甜香與標本冊裡的香料氣息交織在一起，像是在訴說著剛剛確立的甜蜜關係，彼此的心意在這份獨特的信物聯結下，變得格外堅定。",
        "gal_map_text_206101522=在你們即將離開市集時，敖靈忽然在一個還未收攤的手工餐具攤位前停下。敖靈仔細挑選了一番，最後拿起一雙用櫻桃木精心製作、尾端刻有簡單雲紋的筷子，轉頭看向你，臉上帶著溫柔的微笑。",
        "gal_map_text_206101523=筷子的木質溫潤，紋理清晰，尾端的雲紋雕刻細膩，手感順滑，沒有多餘的裝飾，卻透著質樸的美感。敖靈將筷子遞給你，眼神裡帶著些許羞澀，卻難掩期待。",
        "gal_map_text_206101524=這個，送給你。' 敖靈聲音輕輕的，'‘食客尋味’，最重要的是要有好的‘食伴’。這雙筷子是手工製作的，櫻桃木很耐用，希望以後不管是一起在外覓食，還是在家做飯，我們都能一起分享美食。",
        "gal_map_text_206101525=你接過筷子，指尖觸到溫潤的木質。",
        "gal_map_text_206101526=我很喜歡，這雙筷子對我來說意義非凡。以後每次用它吃飯，我都會想起今天和你一起逛市集的甜蜜時光，想起你說的‘好食伴’。",
        "gal_map_text_206101527=其實我早就很在意你了，和你在一起的每一刻都很開心。你願意做我的女朋友嗎？讓我們一起做彼此永遠的‘好食伴’",
        "gal_map_text_206101528=我願意！以後不管是山珍海味還是粗茶淡飯，我都想和你一起分享，一起度過每一個三餐四季。",
        "gal_map_text_206101529=你們並肩走出市集，手中的筷子仿佛成了彼此心意的紐帶，晚風帶著美食的香氣，為這份剛確立的關係，增添了幾分溫馨與甜蜜。",
        "gal_map_text_206101530=敖靈看著你，眼神裡滿是不舍與期待，沒有拿出任何禮物，卻主動說起了剛才吃過的美食，語氣裡帶著掩飾不住的開心。",
        "gal_map_text_206101531=剛才那個手工糖果真的太甜了，還有那家的提拉米蘇，口感特別細膩。我還知道幾家小眾的美食店，想和你一起去探店，可以嗎？",
        "gal_map_text_206101532=你看著敖靈興奮的樣子，心中快樂隨之也被帶動了起來。",
        "gal_map_text_206101533=當然可以！其實我還有句話想對你說，敖靈，和你一起分享美食的時光，是我最幸福的事。你願意做我的女朋友嗎？讓我們一起探索更多美食，一起度過更多甜蜜的時光。",
        "gal_map_text_206101534=敖靈眼睛亮了起來，用力點頭。",
        "gal_map_text_206101535=我願意！我一直都很想告訴你，我很在意你。以後我們可以一起逛遍所有美食街，一起打卡所有想吃的餐廳，把每一次吃飯都變成甜蜜的約會。",
        "gal_map_text_206101536=你們約定了下次探店的時間和地點，在市集出口處互道再見。看著敖靈轉身離開的背影，心中滿是對下一次見面的期待，彼此的心意已經明確，甜蜜的美食之旅即將繼續。",
        "gal_map_text_206101537=敖靈站在原地，看著市集裡還亮著燈的攤位，眼神裡滿是回味，忽然轉頭看向你，嘴角帶著溫柔的笑意，語氣裡帶著一絲認真。",
        "gal_map_text_206101538=今天的市集真的太難忘了，和你一起分享美食的感覺，是我從未有過的。不管是甜的、鹹的，只要和你一起吃，都覺得格外美味。",
        "gal_map_text_206101539=你認真地看著敖靈，語氣堅定。",
        "gal_map_text_206101540=我也是，和你在一起的每一秒都很珍貴。敖靈，我不想只做你的美食搭子，我想做能一直陪伴你的人。你願意做我的女朋友嗎？",
        "gal_map_text_206101541=臉頰微紅，輕輕點頭，眼裡滿是幸福。",
        "gal_map_text_206101542=我願意。其實從我們一起分享第一口提拉米蘇的時候，我就覺得你是一個很溫柔的人。以後不管是美食還是生活，我都想和你一起分享，一起面對。",
        "gal_map_text_206101543=你們並肩走在回家的路上，聊著剛才吃過的美食，彼此的笑聲在夜空中回蕩。雖然沒有信物的聯結，但彼此的心意已經相通，甜蜜的關係正式確立。",
        "gal_map_text_206101544=當日的最後一縷霞光落在城市的天際線上，你們並肩走在河邊的步道上，手中提著裝有 4 個信物的袋子 —— 深棕色植鞣革書衣、神秘合金立方體、'味覺繪圖學' 標本冊、櫻桃木雲紋筷子。晚風輕輕吹過，帶著河水的濕潤氣息，路燈漸漸亮起，暖黃的燈光將你們的影子拉得很長。",
        "gal_map_text_206101545=集齊所有信物後，彼此的眼神裡多了幾分堅定與默契。敖靈停下腳步，從包裡拿出一個小小的盒子，裡面裝著一枚小巧的銀質圓環，上面刻著三個場景的標誌性符號 —— 書本、羅盤、筷子。敖靈將盒子打開，遞到你面前，眼神裡滿是溫柔與認真。",
        "gal_map_text_206101546=敖靈看著你，語氣溫柔而堅定。",
        "gal_map_text_206101547=從書店的初遇默契，到密室的並肩作戰，再到市集的甜蜜分享，這四個信物，見證了我們一路走來的每一步。其實在準備這些信物的時候，我就一直在想，我希望我們的關係，能像這些信物一樣，經得起時間的考驗。",
        "gal_map_text_206101548=你心中滿是感動，緊緊握住敖靈的手。",
        "gal_map_text_206101549=敖靈，和你在一起的每一天，都充滿了驚喜與甜蜜。這些信物，不僅是你對我的心意，更是我們愛情的見證。我一直都很感謝你，出現在我的生命裡。",
        "gal_map_text_206101550=敖靈眼眶微紅，嘴角帶著幸福的笑意。",
        "gal_map_text_206101551=我也是。其實我還有一個小小的心願，想讓這四個信物的意義，變得更加完整。這個銀環上的符號，代表著我們一起經歷的三個場景，也代表著我對你的心意。",
        "gal_map_text_206101552=你認真地看著敖靈，語氣堅定。",
        "gal_map_text_206101553=敖靈，不管未來有多少未知，我都想和你一起面對。你願意和我一起，把我們的故事，一直續寫下去嗎？",
        "gal_map_text_206101554=敖靈用力點頭，眼裡閃著淚光。",
        "gal_map_text_206101555=我願意！從和你一起貼貼紙、破解謎題、分享美食的那一刻起，我就知道，你是我想一直陪伴的人。",
        "gal_map_text_206101556=你接過銀環，將它戴在自己的手腕上，然後伸手輕輕將敖靈擁入懷中。晚風裡，四個信物的氣息交織在一起，銀環上的符號在燈光下閃爍，像是在訴說著你們的愛情故事。",
        "gal_map_text_206101557=信物為契，情定終身，未來的每一個日子，都將因為彼此的陪伴，變得格外美好與珍貴。",
        "gal_map_text_207100000=週末傍晚，商業街的燈火次第亮起。街角復古郵筒旁，墨茗捧著熱奶茶，呼出的氣息在微涼空氣裡凝成白霧。暖黃路燈勾勒出她靈動的眉眼，指尖無意識摩挲著奶茶杯壁，眼神裡藏著期待與一絲狡黠。",
        "gal_map_text_207100001=你們碰面後沿著人行道緩步前行，兩側店鋪的霓虹在地面投下流動的光影。她小口啜飲著奶茶，時不時側頭打量路過的櫥窗，腳步輕快得像只雀躍的小鹿。",
        "gal_map_text_207100002=晚上好呀，那麼今晚的城市漫步，我們先往哪個方向拐彎？我可是藏了好多期待呢。",
        "gal_map_text_207100003=決定權交給你更合適，但我查了三個超合你心意的地方，要不要聽聽看？",
        "gal_map_text_207100004=墨茗停下腳步，將喝到一半的奶茶舉到胸前，身體微微前傾，眼裡閃著好奇的光。晚風拂起墨茗的髮絲，墨茗下意識抬手將碎發別到耳後，指尖劃過耳廓的弧度輕柔又自然。",
        "gal_map_text_207100005=游趣方舟遊戲店",
        "gal_map_text_207100006=時光修補鋪",
        "gal_map_text_207100007=字間旅行書店",
        "gal_map_text_207100008=聽說裡面有雙人解謎遊戲，正好能試試我們的默契，而且燈光很柔和，不會讓你覺得吵。",
        "gal_map_text_207100009=墨茗雙手叉腰，眼神堅定，腳尖輕輕點地。",
        "gal_map_text_207100010=哇！解謎遊戲超考驗配合的，我可不會拖後腿，肯定能幫你找到關鍵線索。",
        "gal_map_text_207100011=墨茗挑眉一笑，手指輕輕敲了敲奶茶杯，語氣帶著小驕傲。",
        "gal_map_text_207100012=正好，我最近剛看了好多解謎技巧，這次換我帶節奏，你跟著我的思路來就好。",
        "gal_map_text_207100013=墨茗微微歪頭，眼神軟下來，指尖輕輕拉了拉你的袖口。",
        "gal_map_text_207100014=解謎啊…… 我有時候會鑽牛角尖，到時候你可一定要提醒我呀，不能讓我一個人卡住。",
        "gal_map_text_207100015=墨茗眼睛睜得圓圓的，語氣帶著點依賴，身體不自覺向你靠近半步。",
        "gal_map_text_207100016=會不會很難呀？我對複雜的線索有點遲鈍，你要多擔待，全程帶著我一起好不好？",
        "gal_map_text_207100017=裡面可以體驗舊物修復，安靜又有意義，而且老師傅很有耐心，不會讓你覺得手忙腳亂。",
        "gal_map_text_207100018=墨茗點點頭，眼神認真，手指輕輕梳理著髮絲。",
        "gal_map_text_207100019=舊物修復需要邏輯和耐心，正好可以靜下心來做件事，還能學到小技巧，挺實用的。",
        "gal_map_text_207100020=墨茗語氣條理清晰，眼神裡帶著分析的光芒，身體微微站直。",
        "gal_map_text_207100021=修復過程應該有固定步驟吧？先清潔再打磨最後養護，我們可以分工合作提高效率。",
        "gal_map_text_207100022=墨茗眼睛亮晶晶的，語氣輕柔，指尖輕輕觸碰路過的牆面。",
        "gal_map_text_207100023=每個舊物都有故事，修復它們就像在續寫回憶，想想就覺得很溫暖呢。",
        "gal_map_text_207100024=墨茗嘴角帶著溫柔的笑意，眼神柔和，腳步也放慢了些。",
        "gal_map_text_207100025=會不會觸碰到很多人的回憶呀？感覺修復的時候，都能感受到物件主人的心情，有點治癒。",
        "gal_map_text_207100026=裡面有很多獨立雜誌和畫冊，氛圍特別安靜，還能喝到免費的檸檬水，適合慢慢逛。",
        "gal_map_text_207100027=墨茗語氣輕快，眼睛四處張望，腳步蹦蹦跳跳。",
        "gal_map_text_207100028=安靜的書店也不錯呀！可以邊逛邊分享看到的有趣內容，說不定還能發現小眾寶藏雜誌呢。",
        "gal_map_text_207100029=墨茗雙手握拳放在胸前，眼神興奮，身體微微晃動。",
        "gal_map_text_207100030=雖然安靜，但找本有趣的畫冊一起看也很有意思呀！我們可以比賽誰先找到最奇特的封面。",
        "gal_map_text_207100031=墨茗語氣平和，眼神沉靜，腳步平穩而從容。",
        "gal_map_text_207100032=安靜的環境能讓人靜下心來，正好可以好好看看書，放鬆一下心情。",
        "gal_map_text_207100033=墨茗微微點頭，語氣淡然，手指輕輕搭在下巴上。",
        "gal_map_text_207100034=這種氛圍很適合沉澱思緒，慢慢翻閱雜誌，看看別人的故事和視角，挺有收穫的。",
        "gal_map_text_207100035=放心，不管你是想主導還是想跟著我，我都會配合你，實在解不開還有提示卡呢。",
        "gal_map_text_207100036=那快走快走！我已經開始好奇裡面有什麼謎題在等著我們了。",
        "gal_map_text_207100037=墨茗抬手挽住你的胳膊，指尖不經意間蹭過你的手腕。",
        "gal_map_text_207100038=我查過，裡面有簡單的體驗項目，不會太複雜，而且可以一起完成，很有成就感。",
        "gal_map_text_207100039=那太好了！我一直想試試這種手工活，就是怕自己做不好，有你一起就放心多了。",
        "gal_map_text_207100040=墨茗側身時肩膀輕輕碰到你的胳膊，笑容靦腆。",
        "gal_map_text_207100041=逛久了可能會口渴，我帶了紙巾，等下到店裡我們去拿檸檬水，坐下來慢慢看。",
        "gal_map_text_207100042=你想得真周到！那我們慢慢逛，遇到喜歡的內容就停下來分享，怎麼樣？",
        "gal_map_text_207100043=墨茗接過紙巾攥在手裡。轉頭對你笑，眼角彎彎，輕輕捏著紙巾。",
        "gal_map_text_207100044=你們朝著選定的方向走去，路燈將兩人的影子拉得忽長忽短，偶爾交匯在一起。墨茗的腳步時而輕快時而放緩，嘴裡偶爾哼著不成調的小曲，氣氛輕鬆又愜意，曖昧的因數在空氣中悄悄滋生。",
        "gal_map_text_207100045=沿著商業街走了約莫十分鐘，目標場館的招牌在燈火中逐漸清晰。推開店門的瞬間，獨特的氣息撲面而來，與外面的喧囂隔絕，仿佛進入了一個專屬你們的小世界。",
        "gal_map_text_207100046=推開玻璃門，一股混合著舊紙張、新塑膠和淡淡木質的獨特氣味撲面而來。兩面牆的木質貨架擺滿了色彩斑斕的桌遊和獨立遊戲盒子，柔和的暖光燈下，幾張小桌邊傳來低低的笑語和卡牌翻動的清脆聲響。",
        "gal_map_text_207100047=墨茗眼睛一下子亮了，像小孩子走進玩具店，輕輕 “哇” 了一聲，快步走到合作類桌遊貨架前，指尖劃過一個個精美的盒子封面，神情專注又興奮。",
        "gal_map_text_207100048=這裡簡直像個寶庫，感覺每個盒子裡都藏著一個世界，我們選哪個玩好呀？",
        "gal_map_text_207100049=你想玩解謎類還是歡樂類？我都可以，主要看你喜歡，要是不確定我們可以問問店員推薦。",
        "gal_map_text_207100050=墨茗正低頭看著一款解謎遊戲的封面，手指剛要碰到盒子，突然 “呀” 了一聲，往後退了半步。原來貨架最上層的一個遊戲盒子沒放穩，正微微晃動，眼看就要掉下來。墨茗下意識抬手護住頭，身體微微蜷縮起來。",
        "gal_map_text_207100051=迅速擋在墨茗身前",
        "gal_map_text_207100052=幫墨茗整理貨架",
        "gal_map_text_207100053=遞上溫水安撫",
        "gal_map_text_207100054=小心！還好沒砸到你，嚇我一跳。",
        "gal_map_text_207100055=墨茗拍了拍胸口，眼神裡帶著後怕，卻還是挺直腰板。",
        "gal_map_text_207100056=哇！你反應好快，謝謝你呀。還好有你，不然這個盒子砸下來肯定很疼。",
        "gal_map_text_207100057=墨茗深吸一口氣，語氣恢復鎮定，抬手拍了拍你的肩膀。",
        "gal_map_text_207100058=還好你接住了，剛才我都沒反應過來。不過下次我會更小心的，不會再讓這種情況發生。",
        "gal_map_text_207100059=墨茗身體還微微發顫，眼神裡帶著依賴，下意識抓住你的胳膊。",
        "gal_map_text_207100060=嚇死我了！剛才我都懵了，還好你在。要是沒有你，我都不知道該怎麼辦。",
        "gal_map_text_207100061=墨茗眼睛紅紅的，語氣帶著點委屈，緊緊拉住你的手不肯鬆開。",
        "gal_map_text_207100062=嗚嗚，剛才差點被砸到，好嚇人。你剛才擋在我前面的時候，真的，好有安全感。",
        "gal_map_text_207100063=沒事了沒事了，以後逛貨架的時候，離高處的盒子遠一點，有我在呢。",
        "gal_map_text_207100064=嗯！有你在身邊就是不一樣，那我們趕緊選個遊戲，開始我們的合作闖關吧。",
        "gal_map_text_207100065=墨茗嘴角慢慢揚起，眼神柔和。",
        "gal_map_text_207100066=別慌，我來處理。這樣就安全了，剛才沒嚇到你吧？",
        "gal_map_text_207100067=墨茗點點頭，眼神認真。",
        "gal_map_text_207100068=還好你及時整理了，不然不僅我可能被砸到，後面來的人也有危險。考慮得真周到，做事也很穩妥。",
        "gal_map_text_207100069=墨茗眼神裡帶著認可。",
        "gal_map_text_207100070=貨架擺放不穩固是安全隱患，這樣整理好之後就沒問題了。我們選遊戲的時候，也注意別碰到上層的盒子。",
        "gal_map_text_207100071=墨茗眼睛亮晶晶的，語氣帶著暖意。",
        "gal_map_text_207100072=你不僅保護了我，還想到了後面的人，真的好溫柔呀。看著你認真整理貨架的樣子，覺得很可靠。",
        "gal_map_text_207100073=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100074=剛才真的有點嚇到，但是看到你有條不紊地整理貨架，瞬間就安心了。你總是能給人滿滿的安全感。",
        "gal_map_text_207100075=現在安全了，你看這款怎麼樣？評價很好，解謎難度適中，還能互動。",
        "gal_map_text_207100076=好呀好呀！就選這個了，我們趕緊找個位置坐下開始吧，我已經迫不及待了。",
        "gal_map_text_207100077=墨茗接過遊戲盒子，拉著你的手走向靠窗的小桌。",
        "gal_map_text_207100078=沒事吧？是不是嚇到了？先喝口水緩一緩，別著急選遊戲。",
        "gal_map_text_207100079=墨茗接過水杯喝了一口，恢復了鎮靜。",
        "gal_map_text_207100080=還好還好，就是嚇了一跳！過有你遞水安撫，瞬間就沒事了，我們趕緊選遊戲吧。",
        "gal_map_text_207100081=墨茗喝了一大口水，語氣興奮。",
        "gal_map_text_207100082=哇，你居然還帶了溫水！太貼心了吧。現在完全不害怕了，我們去選個最刺激的解謎遊戲挑戰一下！",
        "gal_map_text_207100083=墨茗慢慢喝著水，眼神逐漸平靜。",
        "gal_map_text_207100084=謝謝你，喝口水好多了。剛才確實有點突然，不過現在沒事了，我們慢慢選遊戲就好。",
        "gal_map_text_207100085=墨茗語氣平和，喝了口水。",
        "gal_map_text_207100086=還好有你在，不然可能真的會慌。我們選個難度適中的遊戲，慢慢玩，不用著急。",
        "gal_map_text_207100087=這款雙人合作遊戲口碑很好，裡面的謎題設計很巧妙，而且有提示系統，不會太難也不會太簡單。",
        "gal_map_text_207100088=聽起來很不錯！就選這個了，我們趕緊找個安靜的位置，開始我們的解謎之旅。",
        "gal_map_text_207100089=墨茗眼睛一亮，點頭同意，側身時肩膀輕輕靠在你的胳膊上。",
        "gal_map_text_207100090=你們坐在靠窗的小桌旁，打開遊戲盒子，裡面的道具和謎題卡整齊排列。暖黃的燈光映在墨茗專注的側臉上，墨茗時不時抬頭與你對視，眼裡帶著笑意，空氣中彌漫著輕鬆愉快的氛圍，好感在不知不覺中悄悄升溫。",
        "gal_map_text_207100091=推開沉重的木門，一股混合著陳舊皮革、木蠟油和淡淡金屬氣味的溫暖氣息撲面而來。牆上掛著修好的皮包、老式相機，玻璃櫃裡陳列著煥然一新的腕表，暖黃的檯燈下，老師傅正專注地處理著懷錶機芯，發出細微的 “哢噠” 聲。",
        "gal_map_text_207100092=墨茗輕手輕腳地走近工作臺，好奇地看著那些閃閃發光的工具和等待修復的舊物，眼神裡滿是驚歎與好奇，生怕打擾到老師傅的工作。",
        "gal_map_text_207100093=哇，這裡好像時間的急診室，每樣東西都有自己的故事，然後在這裡被小心地續寫，太有意思了。",
        "gal_map_text_207100094=是啊，我聽說可以體驗簡單的修復項目，要不要問問老師傅有沒有適合我們的？我陪著你一起做。",
        "gal_map_text_207100095=老師傅笑著起身，給你們介紹體驗項目，順手遞來一枚有劃痕的黃銅徽章和修復工具。墨茗接過徽章，剛要嘗試打磨，卻不小心將桌上的金屬拋光膏碰倒，膏體濺到了墨茗的袖口，還沾到了徽章上。墨茗瞬間慌了神，手忙腳亂地想去擦拭，卻越擦越髒。",
        "gal_map_text_207100096=主動接手清潔",
        "gal_map_text_207100097=詢問清潔方法",
        "gal_map_text_207100098=遞上備用紙巾",
        "gal_map_text_207100099=別慌，交給我來。拋光膏沾到布料上不能亂擦，我來處理，你先看看工具怎麼用。",
        "gal_map_text_207100100=墨茗皺了皺眉頭，語氣帶著自責。",
        "gal_map_text_207100101=哎呀，都怪我不小心。不過謝謝你幫我，我去拿點溫水來，我們一起清潔吧。",
        "gal_map_text_207100102=墨茗輕輕拍了下自己的額頭，然後認真看著你。",
        "gal_map_text_207100103=怎麼這麼不小心！你教我怎麼清潔，下次我就能自己處理了，不能總麻煩你。",
        "gal_map_text_207100104=墨茗眼神慌亂，語氣帶著點無助，緊緊抓住你的胳膊。",
        "gal_map_text_207100105=怎麼辦怎麼辦，我把東西弄髒了。還好有你在，不然我都不知道該怎麼收拾。",
        "gal_map_text_207100106=墨茗眼眶有點紅，語氣委屈。",
        "gal_map_text_207100107=嗚嗚，我太笨了，居然把拋光膏弄灑了。你快幫幫我，我實在不知道該怎麼清潔，全靠你了。",
        "gal_map_text_207100108=沒事，這種膏體不難清潔，輕輕擦就能掉，徽章上的我用鹿皮巾處理就好。",
        "gal_map_text_207100109=你真的好厲害，什麼都懂。等下我一定小心點，絕對不添亂。",
        "gal_map_text_207100110=墨茗看著你認真清潔的樣子，嘴角慢慢揚起。",
        "gal_map_text_207100111=別著急，我們問問老師傅怎麼清潔。師傅，拋光膏沾到衣服和徽章上了，有沒有什麼好的清潔方法？",
        "gal_map_text_207100112=墨茗點點頭，眼神認真。",
        "gal_map_text_207100113=對，先問專業人士最靠譜，這樣不會損壞衣服和徽章。還好你想到問老師傅，不然我可能會用錯方法。",
        "gal_map_text_207100114=墨茗的語氣條理清晰。",
        "gal_map_text_207100115=不同的材質需要不同的清潔方式，盲目擦拭可能會造成二次損壞。我們按照老師傅說的步驟來，肯定能清潔乾淨。",
        "gal_map_text_207100116=墨茗眼神柔和，語氣帶著感激。",
        "gal_map_text_207100117=老師傅人真好，肯定會耐心教我們的。剛才都怪我太著急了，還好有你冷靜處理。",
        "gal_map_text_207100118=墨茗嘴角帶著歉意的笑容。",
        "gal_map_text_207100119=感覺自己好莽撞，還好你及時拉住我，沒有讓情況變得更糟。有你在身邊，總能想到周全的辦法。",
        "gal_map_text_207100120=老師傅說用這個清潔劑輕輕擦就行，不會傷衣服，徽章用軟布蘸一點就能擦掉。",
        "gal_map_text_207100121=好，我來試試清潔衣服，徽章就交給你了，我們分工合作，肯定很快就能搞定。",
        "gal_map_text_207100122=墨茗接過清潔劑，小心翼翼地嘗試。抬頭對你笑，眼裡帶著信任。",
        "gal_map_text_207100123=別慌，先拿紙巾吸幹多餘的膏體。先別擦拭，吸幹之後再處理，不然會擴散。",
        "gal_map_text_207100124=墨茗立刻接過紙巾，動作麻利地吸幹膏體。",
        "gal_map_text_207100125=好嘞！謝謝你的紙巾，我馬上吸幹。還好有你提醒，不然我肯定越擦越糟，現在好多了，我們趕緊清潔徽章吧。",
        "gal_map_text_207100126=墨茗看著快速吸幹膏體，語氣興奮。",
        "gal_map_text_207100127=哇，你居然還帶了備用紙巾！太貼心了吧。現在膏體不擴散了，我們一起想想怎麼清潔徽章，爭取快點開始修復體驗。",
        "gal_map_text_207100128=墨茗看著慢慢吸幹膏體，眼神逐漸平靜，慌張的情緒稍微緩解了下來。",
        "gal_map_text_207100129=謝謝你，這個方法很管用。剛才確實有點慌，還好有你提醒，現在我們一步步來，先清潔乾淨再開始。",
        "gal_map_text_207100130=墨茗語氣平和，看著慢慢吸幹的膏體。",
        "gal_map_text_207100131=還好有你在，不然我可能會亂了陣腳。我們先把表面的膏體處理掉，再慢慢清潔殘留的部分，不用著急。",
        "gal_map_text_207100132=我帶了溫和的濕巾，不會損傷徽章，你袖口的殘留用這個擦也可以，試試？",
        "gal_map_text_207100133=太謝謝你了，你準備得也太周全了吧。",
        "gal_map_text_207100134=墨茗接過濕巾，小心翼翼地擦拭袖口。擦拭時指尖偶爾碰到你的手，她的臉頰微微泛紅。",
        "gal_map_text_207100135=你們終於清理乾淨了膏體，在老師傅的指導下開始嘗試修復黃銅徽章。墨茗專注地握著鹿皮巾打磨，睫毛在暖黃燈光下投下淺淺的陰影，偶爾抬頭與你對視，眼裡帶著認真與笑意，指尖的溫度透過工具悄悄傳遞，曖昧的氛圍在安靜的店裡慢慢蔓延。",
        "gal_map_text_207100136=推開掛著清脆風鈴的玻璃門，仿佛瞬間跌入紙張與油墨構築的靜謐宇宙。空氣中飄散著舊書頁特有的乾燥香氣，混合著淡淡的咖啡豆味道，四面牆的書架擺滿了獨立雜誌、藝術畫冊和柔和的背景爵士樂流淌，幾張深色木桌旁，有人正低頭沉浸在紙頁裡。",
        "gal_map_text_207100137=墨茗眼睛亮晶晶地掃過那些色彩各異的封面，腳步放得很輕，生怕打破這份寧靜。墨茗走到美食雜誌區，指尖輕輕劃過一本和果子畫冊，臉上露出驚喜的神情。",
        "gal_map_text_207100138=天啊，這裡簡直是好奇心黑洞，每個封面都在說 “快來看我”，尤其是這本和果子畫冊，圖片也太誘人了吧。",
        "gal_map_text_207100139=我聽說這裡的雜誌很多都是外面少見的，你要是喜歡，我們可以找個位置坐下慢慢看，店裡還提供免費檸檬水。",
        "gal_map_text_207100140=墨茗正踮腳想拿書架上層的一本旅行雜誌，腳下不小心一滑，身體微微晃動，手裡的檸檬水也灑了一小片在雜誌封面和自己的手背上。墨茗驚呼一聲，趕緊扶住書架穩住身體，看著濕掉的雜誌，臉上露出慌張又愧疚的表情。",
        "gal_map_text_207100141=主動擦拭道歉",
        "gal_map_text_207100142=找店員處理",
        "gal_map_text_207100143=遞上幹毛巾",
        "gal_map_text_207100144=小心！別慌，我來處理，你先站穩，有沒有摔疼？",
        "gal_map_text_207100145=墨茗皺了皺眉頭，語氣帶著自責。",
        "gal_map_text_207100146=哎呀，都怪我不小心。還好你扶住我了，雜誌我來擦吧，是我不小心弄濕的，應該我來處理。",
        "gal_map_text_207100147=墨茗輕輕拍了下自己的額頭，然後接過紙巾。",
        "gal_map_text_207100148=怎麼這麼莽撞！你扶我就好，雜誌我來擦，下次我會注意腳下，不會再這麼不小心了。",
        "gal_map_text_207100149=墨茗眼神慌亂，語氣帶著點無助，緊緊抓住你的胳膊。",
        "gal_map_text_207100150=嚇死我了，差點摔倒。還好有你扶住我，不然我不僅會摔倒，還會把雜誌弄得更濕，謝謝你。",
        "gal_map_text_207100151=墨茗眼眶有點紅，語氣委屈。",
        "gal_map_text_207100152=嗚嗚，我太笨了，居然踮腳不看路。你不僅扶住我，還幫我擦雜誌，真的太感謝了，沒有你我都不知道該怎麼辦。",
        "gal_map_text_207100153=沒事就好，雜誌只是輕微濕了點，已經擦乾了，你喝點水緩一緩，以後想拿高處的書告訴我，我來幫你。",
        "gal_map_text_207100154=你真的太好了，總是這麼照顧我。",
        "gal_map_text_207100155=墨茗接過溫水，指尖碰到你的手指。低頭喝水時嘴角帶著笑意，身體不自覺向你靠近了些。",
        "gal_map_text_207100156=別著急，我先扶你站穩。雜誌濕了沒關係，我們找店員說明情況，看看有沒有清潔工具，或者能不能賠償，別擔心。",
        "gal_map_text_207100157=墨茗點點頭，眼神認真。",
        "gal_map_text_207100158=對，先找店員溝通最穩妥，這樣既不會損壞雜誌，也能妥善解決問題。還好你想到找店員，不然我可能會一直慌神。",
        "gal_map_text_207100159=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100160=店員應該有專門清潔紙張的工具，我們先說明情況，主動承擔責任，再配合他們處理就好。",
        "gal_map_text_207100161=墨茗眼神柔和，語氣帶著歉意。",
        "gal_map_text_207100162=店員肯定不會怪我的吧？不過還是有點愧疚，畢竟是我不小心弄濕的。還好有你陪著我，不然我一個人都不敢找店員。",
        "gal_map_text_207100163=墨茗嘴角帶著愧疚的笑容，眼神柔和。",
        "gal_map_text_207100164=感覺自己給店員添麻煩了。不過有你在身邊，一起去溝通，我就沒那麼緊張了，謝謝你。",
        "gal_map_text_207100165=店員人很好，我剛才進門的時候留意到他們很友善，我們如實說明情況就好，不用太擔心。",
        "gal_map_text_207100166=嗯，有你在我就放心多了。等下我來跟店員道歉，畢竟是我的責任。",
        "gal_map_text_207100167=墨茗緊緊跟著你，語氣感激。",
        "gal_map_text_207100168=沒事吧？有沒有摔疼？先把雜誌上的水擦乾，別讓水滲進去，我扶你到旁邊坐下休息。",
        "gal_map_text_207100169=墨茗接過毛巾快速擦乾雜誌。",
        "gal_map_text_207100170=還好還好，就是嚇了一跳！過你居然帶了幹毛巾，也太貼心了吧，現在沒事了，我們趕緊找本喜歡的雜誌坐下看。",
        "gal_map_text_207100171=墨茗擦乾雜誌後，語氣興奮。",
        "gal_map_text_207100172=哇，你準備得也太充分了吧！現在完全不慌了，我們去那邊的閱讀區坐下，一起看這本和果子畫冊，看起來超有趣的。",
        "gal_map_text_207100173=墨茗慢慢擦乾雜誌，眼神逐漸平靜。",
        "gal_map_text_207100174=謝謝你，我沒事。不過現在好了，我們找個位置坐下，慢慢翻閱雜誌就好。",
        "gal_map_text_207100175=墨茗語氣平，慢慢地開始擦乾雜誌。",
        "gal_map_text_207100176=還好有你在，不然我可能會不知所措。我們選個安靜的角落坐下，慢慢看，不用著急，享受這個氛圍就好。",
        "gal_map_text_207100177=你先坐下休息，我去拿兩杯檸檬水，等下我們一起看這本和果子畫冊，看起來確實很誘人。",
        "gal_map_text_207100178=好呀，謝謝你。",
        "gal_map_text_207100179=墨茗坐下後抬頭對你笑。雙手放在桌上，指尖輕輕摩挲著雜誌封面，眼神裡帶著期待。",
        "gal_map_text_207100180=你們坐在閱讀區的軟椅上，面前放著檸檬水和幾本挑選好的雜誌。墨茗專注地翻看著畫冊，時不時輕聲和你分享看到的有趣內容，肩膀偶爾碰到你的胳膊，眼神交匯時帶著淡淡的笑意，好感在安靜的氛圍中悄然累積。",
        "gal_map_text_207100181=隨著約會的推進，你們之間的距離漸漸拉近，互動也變得更加自然親密。無論是共同解謎、專注修復，還是靜靜翻閱雜誌，空氣中都彌漫著越來越濃的曖昧氣息，每一個細微的動作都在悄悄拉近距離。",
        "gal_map_text_207100182=你們坐在靠窗的小桌旁，面前攤開雙人解謎遊戲的道具和謎題卡。窗外的霓虹透過玻璃灑進來，與店內的暖光交織，照亮了桌上的拼圖和線索，營造出專注又曖昧的氛圍。",
        "gal_map_text_207100183=遊戲進行到中途，你們各自專注於手頭的線索，墨茗托著下巴盯著謎題卡，眉頭微蹙，你則擺弄著幾個形狀奇特的木塊。就在你嘗試一種組合時，墨茗忽然眼睛一亮，伸手過來指向你手中的木塊，指尖不經意間碰到了你的手背，溫熱的觸感讓兩人都微微一頓。",
        "gal_map_text_207100184=等一下！你看這個符號，是不是應該對應那個轉盤的缺口？剛才碰到你了，不好意思呀。",
        "gal_map_text_207100185=沒關係，你說得對，我剛才都沒注意到這個細節，你的觀察力也太敏銳了，快說說你的思路。",
        "gal_map_text_207100186=墨茗接過木塊，指尖還殘留著剛才觸碰的溫熱感，低頭認真比對謎題卡和木塊上的符號。墨茗的頭髮垂落在臉頰旁，你下意識抬手幫墨茗將碎發別到耳後，指尖輕輕劃過墨茗的耳廓。墨茗身體一僵，抬頭看向你，眼裡帶著驚訝與羞澀，呼吸也微微急促了些。",
        "gal_map_text_207100187=順著思路共解",
        "gal_map_text_207100188=調侃墨茗的敏銳",
        "gal_map_text_207100189=調侃墨茗的害羞",
        "gal_map_text_207100190=我們一起試試這個組合，說不定能解開下一個關卡。你負責觀察符號，我來轉動轉盤，我們分工合作。",
        "gal_map_text_207100191=墨茗挺直腰板，眼神堅定，指尖輕輕點著謎題卡。",
        "gal_map_text_207100192=好！我肯定能快速找出所有對應符號，不會拖你後腿的。我們一起加油，儘快通關。",
        "gal_map_text_207100193=墨茗語氣自信，眼神專注，手指準確指向線索。",
        "gal_map_text_207100194=沒問題，我已經發現幾個關鍵符號了，你按照我說的方向轉動轉盤。這次我們一定能順利解開。",
        "gal_map_text_207100195=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100196=嗯！有你在身邊，我就有信心多了。等下我要是沒看清，你可一定要提醒我呀。",
        "gal_map_text_207100197=墨茗眼睛睜得圓圓的，語氣帶著點依賴。",
        "gal_map_text_207100198=我有點緊張，怕自己找錯符號。你一定要仔細看著，要是我錯了，趕緊告訴我，全靠你了。",
        "gal_map_text_207100199=放心，不管是你主導還是我們配合，我都會跟著你的節奏，我們一起找出答案。",
        "gal_map_text_207100200=嗯！你轉動的時候慢一點，我好仔細觀察，爭取一次成功。",
        "gal_map_text_207100201=墨茗專注地看著轉盤，手指偶爾碰到你的手，身體微微前傾，距離你更近了些。",
        "gal_map_text_207100202=你居然能注意到這麼細微的符號，也太厲害了吧，我剛才看了半天都沒發現。快說說你是怎麼想到的？",
        "gal_map_text_207100203=墨茗點點頭，眼神認真，手指輕輕梳理著髮絲。",
        "gal_map_text_207100204=其實很簡單，根據前面的線索推導，這個符號肯定和轉盤有關，只是你剛才太專注於木塊組合了。",
        "gal_map_text_207100205=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100206=我是按照邏輯順序分析的，先排除無關符號，再比對剩餘的可能性，很快就鎖定了這個線索。",
        "gal_map_text_207100207=墨茗眼睛亮晶晶的，語氣輕柔。",
        "gal_map_text_207100208=就是突然靈光一閃呀，看到這個符號就覺得和轉盤很配，可能是我們的默契吧。",
        "gal_map_text_207100209=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100210=我也說不清楚，就是覺得這個符號很特別，好像在暗示什麼，沒想到真的對應上了。",
        "gal_map_text_207100211=不管是邏輯推導還是靈光一閃，你都太厲害了，有你在，這個遊戲肯定能很快通關。",
        "gal_map_text_207100212=其實也有你的功勞呀，要不是你一直在嘗試木塊組合，我也不會注意到這個符號。",
        "gal_map_text_207100213=墨茗抬頭對你笑，眼裡帶著感激。",
        "gal_map_text_207100214=剛才碰到我的手，是不是嚇到你了？你的臉頰都紅了。其實我剛才也有點緊張。",
        "gal_map_text_207100215=墨茗臉頰更紅了，眼神四處張望。",
        "gal_map_text_207100216=才沒有呢！就是有點突然而已。我們趕緊繼續解謎吧，別浪費時間了。",
        "gal_map_text_207100217=墨茗輕輕捶了捶你的胳膊。",
        "gal_map_text_207100218=哎呀，你別調侃我了！不過說真的，剛才確實有點小緊張，現在好了，我們趕緊加油通關。",
        "gal_map_text_207100219=墨茗眼神沉靜，手指輕輕搭在下巴上。",
        "gal_map_text_207100220=有一點，畢竟太突然了。我們還是繼續解謎吧，專注一點能更快通關。",
        "gal_map_text_207100221=墨茗微微點頭，語氣淡然，眼神平靜地看著謎題卡。",
        "gal_map_text_207100222=還好，就是有點意外。我們繼續吧，爭取早點解開這個關卡。",
        "gal_map_text_207100223=好，我們繼續解謎，不過說真的，和你一起玩遊戲真的很開心。",
        "gal_map_text_207100224=我也是，和你一起解謎很有成就感，而且一點都不覺得無聊。",
        "gal_map_text_207100225=墨茗低頭看著謎題卡，嘴角帶著笑意。",
        "gal_map_text_207100226=在你們的默契配合下，成功解開了這個關卡。墨茗興奮地舉起雙手，眼裡閃著光芒，下意識抱住了你的胳膊。意識到自己的動作後，墨茗臉頰微紅，快速鬆開手，卻還是忍不住偷偷看向你，眼裡的笑意藏不住，曖昧的氛圍愈發濃厚。",
        "gal_map_text_207100227=你們坐在中央的遊戲桌旁，桌上擺滿了歡樂聚會遊戲的卡牌和道具。店內其他客人的笑聲偶爾傳來，與你們的互動交織，營造出輕鬆愉快的氛圍，暖黃的燈光照亮了墨茗臉上的笑容。",
        "gal_map_text_207100228=輪到你描述抽到的離譜卡牌時，你急中生智編了個半真半假的說法。墨茗盯著你的眼睛，試圖找出破綻，忽然眯起眼睛笑了，手指輕輕指著你的眉毛：“你在撒謊對不對？你每次說這種話的時候，右邊眉毛會動一下。” 你心裡一驚，下意識想摸眉毛，卻看到墨茗笑得像只得意的小狐狸。",
        "gal_map_text_207100229=詐你的啦！不過你剛才確實猶豫了，肯定在撒謊，快老實交代卡牌上到底是什麼？",
        "gal_map_text_207100230=居然被你發現了，看來什麼都瞞不過你。不過你觀察得也太仔細了，連我眉毛動都能注意到。",
        "gal_map_text_207100231=墨茗湊過來仔細看著你手中的卡牌，身體幾乎貼近你，鼻尖離你的臉頰只有幾釐米，溫熱的氣息拂過你的皮膚。墨茗的頭髮輕輕掃過你的肩膀，帶著淡淡的清香，你下意識抬手幫墨茗攏了攏頭髮，指尖輕輕劃過墨茗的發梢。墨茗身體微微一僵，抬頭看向你，眼裡帶著驚訝與羞澀。",
        "gal_map_text_207100232=順勢反擊調侃",
        "gal_map_text_207100233=認輸請教技巧",
        "gal_map_text_207100234=轉移話題玩新局",
        "gal_map_text_207100235=既然你觀察這麼仔細，那我也發現你的小秘密了。你撒謊的時候，耳朵會悄悄變紅哦。",
        "gal_map_text_207100236=墨茗雙手叉腰，眼神堅定，臉頰卻微微泛紅。",
        "gal_map_text_207100237=才沒有呢！你別胡說，我撒謊才不會耳朵紅。不信我們再來一局，我肯定不會輸你。",
        "gal_map_text_207100238=墨茗挑眉一笑，手指輕輕敲了敲桌子。",
        "gal_map_text_207100239=哼，想反擊我？沒那麼容易。其實我早就知道你會這麼說，我才不會上當呢。",
        "gal_map_text_207100240=墨茗下意識抬手摸了摸自己的耳朵，眼神軟下來。",
        "gal_map_text_207100241=真的嗎？我撒謊的時候耳朵會紅？那我剛才有沒有露餡？你可一定要幫我保密呀。",
        "gal_map_text_207100242=墨茗眼神慌亂，語氣中帶著點依賴。",
        "gal_map_text_207100243=啊？不會吧！我都沒注意到。以後我撒謊的時候，你可一定要提醒我，不然被別人發現就太尷尬了。",
        "gal_map_text_207100244=騙你的啦，你撒謊的時候特別認真，根本看不出來。不過剛才湊近看，你的耳朵確實很可愛。",
        "gal_map_text_207100245=討厭！居然騙我。不過…… 算你有眼光。",
        "gal_map_text_207100246=墨茗臉頰爆紅，抽回手輕輕捶了你一下。嘴角卻忍不住上揚，身體微微向你傾斜，距離更近了些。",
        "gal_map_text_207100247=看來我還是太嫩了，居然被你一眼看穿。快教教我，怎麼才能像你一樣，一眼就看出別人在撒謊？",
        "gal_map_text_207100248=墨茗點點頭，眼神認真，手指輕輕點了點桌子。",
        "gal_map_text_207100249=其實很簡單，觀察細節就好。比如說話時的眼神、語氣變化，還有不自覺的小動作，都能暴露真相。",
        "gal_map_text_207100250=墨茗語氣條理清晰，眼神裡帶著分析的光芒，還順手拿出紙筆簡單記錄。",
        "gal_map_text_207100251=我總結了幾個關鍵點，首先看眼神是否閃躲，其次聽語氣是否連貫，最後觀察是否有多餘的肢體動作。",
        "gal_map_text_207100252=墨茗眼睛亮晶晶的，語氣輕柔，手指輕輕觸碰你的手背。",
        "gal_map_text_207100253=就是憑感覺呀，和人相處久了，自然能感受到對方情緒的變化。可能是我們今天相處得很愉快，所以我對你的小細節特別敏感。",
        "gal_map_text_207100254=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100255=我也說不清楚具體方法，就是覺得你剛才說話的時候，情緒有點不自然。可能是因為我很在意你說的話，所以才會格外關注吧。",
        "gal_map_text_207100256=原來還有這麼多門道，看來我得好好向你學習。以後有機會，我們多玩幾次這個遊戲，讓我也練練觀察力。",
        "gal_map_text_207100257=好呀！不過你可要做好準備，我可不會手下留情。過要是你實在學不會，我也可以一直 “拆穿” 你呀。",
        "gal_map_text_207100258=墨茗指尖輕輕劃過你記錄的紙張，留下淡淡的痕跡。",
        "gal_map_text_207100259=好吧，被你打敗了。我們換個遊戲玩怎麼樣？剛才看到一款角色扮演的，看起來很有趣。",
        "gal_map_text_207100260=墨茗立刻興奮地拍手。",
        "gal_map_text_207100261=好呀好呀！角色扮演我最拿手了。我們趕緊換遊戲，我要選個最有趣的角色，肯定能贏你。",
        "gal_map_text_207100262=墨茗快速收拾好桌上的卡牌。",
        "gal_map_text_207100263=哇！角色扮演？太有意思了。我已經想好要扮演什麼了，絕對讓你大吃一驚，我們趕緊開始吧。",
        "gal_map_text_207100264=墨茗語氣平和，眼神沉靜，慢慢收拾著道具。",
        "gal_map_text_207100265=可以呀，換個遊戲也不錯。角色扮演能體驗不同的身份，也挺有意思的，我們慢慢玩。",
        "gal_map_text_207100266=墨茗微微點頭，語氣淡然，眼神平靜地看著新遊戲盒子。",
        "gal_map_text_207100267=也好，一直玩一個遊戲確實會膩。角色扮演需要配合，我們好好分工，爭取玩得開心。",
        "gal_map_text_207100268=你先選角色，喜歡哪個就拿哪個，我都可以配合你。",
        "gal_map_text_207100269=那我選這個公主角色啦，你就當騎士保護我。",
        "gal_map_text_207100270=墨茗眼裡帶著期待，認真挑選著角色卡，指尖偶爾碰到你的手。",
        "gal_map_text_207100271=你們換上角色扮演遊戲，墨茗很快代入角色，語氣和動作都變得生動起來。玩到興起時，墨茗會下意識抓住你的胳膊，或者靠在你身邊討論劇情，溫熱的氣息拂過你的皮膚，眼神交匯時帶著濃濃的笑意，曖昧的氛圍在歡樂的互動中不斷升溫。",
        "gal_map_text_207100272=你們坐在角落的小桌旁，面前的螢幕上顯示著敘事遊戲的關鍵抉擇介面。暖黃的燈光映在螢幕上，將兩人的影子投射在牆上，形成親密相依的輪廓。遊戲背景音輕柔舒緩，營造出沉浸式的氛圍。",
        "gal_map_text_207100273=遊戲進行到關鍵處，螢幕上出現兩個選項：一個是安全但平淡的路線，另一個是風險更高但可能揭示更多真相的路線。墨茗轉頭看向你，眼裡帶著猶豫，手指輕輕點著螢幕，糾結不已。",
        "gal_map_text_207100274=選哪個？選安全的，感覺有點無聊；選危險的，又怕搞砸了之前的進度，好難抉擇呀。",
        "gal_map_text_207100275=別著急，慢慢想。不管選哪個，我都陪著你一起承擔後果，而且遊戲嘛，最重要的是體驗過程，不是結果。",
        "gal_map_text_207100276=墨茗低頭認真思考著，眉頭微蹙，手指無意識地劃過你的手背。你順勢握住墨茗的手，指尖輕輕摩挲著墨茗的掌心，試圖緩解墨茗的糾結。墨茗身體微微一僵，抬頭看向你，眼裡帶著驚訝與羞澀，臉頰泛起淡淡的紅暈，呼吸也變得有些急促。",
        "gal_map_text_207100277=陪墨茗挑戰高風險",
        "gal_map_text_207100278=分析利弊再決定",
        "gal_map_text_207100279=尊重墨茗的決定",
        "gal_map_text_207100280=我們選高風險的吧，我相信你的判斷。就算搞砸了也沒關係，我們可以重新開始，而且說不定能解鎖隱藏劇情，更有意義。",
        "gal_map_text_207100281=墨茗眼神瞬間變得堅定，挺直腰板。",
        "gal_map_text_207100282=好！那我們就挑戰高風險的。我肯定能找出關鍵線索，不會讓這次挑戰失敗的，我們一起加油。",
        "gal_map_text_207100283=墨茗挑眉一笑，語氣自信。",
        "gal_map_text_207100284=沒問題！我早就想選這個了，就是怕你不敢。有我在，肯定能順利解鎖隱藏劇情，你跟著我就好。",
        "gal_map_text_207100285=墨茗眼神軟下來，緊緊握住你的手。",
        "gal_map_text_207100286=真的可以嗎？我還是有點擔心。不過有你陪著我，我就有勇氣嘗試了，你可一定要幫我呀。",
        "gal_map_text_207100287=墨茗語氣帶著點依賴，身體微微靠近你",
        "gal_map_text_207100288=會不會太危險了？我好怕搞砸。你一定要全程指導我，要是遇到困難，可不能丟下我一個人。",
        "gal_map_text_207100289=放心，不管遇到什麼困難，我們都一起面對。而且有你這麼聰明的搭檔，肯定能順利通關。",
        "gal_map_text_207100290=嗯！我們一起努力，就算失敗了，也是一次難忘的體驗。",
        "gal_map_text_207100291=墨茗專注地看著，手指緊緊握住你的手。",
        "gal_map_text_207100292=我們來分析一下吧。安全路線雖然平淡，但能順利推進劇情；高風險路線雖然有挑戰，但可能有意外收穫，你更傾向於哪種體驗？",
        "gal_map_text_207100293=墨茗點點頭，眼神認真。",
        "gal_map_text_207100294=你分析得很有道理。我覺得高風險路線的收穫更大，雖然有挑戰，但值得一試，我們就選這個吧。",
        "gal_map_text_207100295=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100296=根據你的分析，高風險路線的性價比更高。而且隱藏劇情能豐富遊戲體驗，我們選高風險的，我已經想好應對策略了。",
        "gal_map_text_207100297=墨茗眼睛亮晶晶的，語氣輕柔。",
        "gal_map_text_207100298=聽你這麼一說，我更想選高風險的了。就算失敗了，和你一起重新開始也很有意思，我相信我們的默契。",
        "gal_map_text_207100299=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100300=我本來就有點想選高風險的，被你這麼一說，更堅定了我的想法。和你一起分析的過程很開心，不管選哪個，我都覺得很有意義。",
        "gal_map_text_207100301=既然你也傾向于高風險，那我們就大膽嘗試。不管結果如何，這段分析的過程都很開心，而且有你在，我覺得一定能成功。",
        "gal_map_text_207100302=嗯！我們一起努力，爭取解鎖隱藏劇情。",
        "gal_map_text_207100303=墨茗指尖輕輕劃過螢幕，眼神專注。",
        "gal_map_text_207100304=其實選哪個都好，主要看你想體驗哪種。如果你想挑戰，我就陪你冒險；如果你想穩妥，我們就選安全路線，我都聽你的。",
        "gal_map_text_207100305=墨茗立刻興奮地拍手。",
        "gal_map_text_207100306=那我們選高風險的！我就喜歡挑戰，而且有你陪著我，肯定沒問題，我們趕緊開始吧。",
        "gal_map_text_207100307=墨茗語氣興奮，身體微微晃動。",
        "gal_map_text_207100308=哇！你居然都聽我的？太好啦。那我們選高風險的，我要解鎖隱藏劇情，讓這次遊戲變得更有趣。",
        "gal_map_text_207100309=墨茗語氣平和，眼神沉靜。",
        "gal_map_text_207100310=那我選高風險的吧。雖然有點擔心，但也想嘗試一下，體驗不同的劇情，我們慢慢玩。",
        "gal_map_text_207100311=墨茗微點頭，語氣淡然。",
        "gal_map_text_207100312=我選高風險的。挑戰一下也不錯，就算失敗了，也能積累經驗，我們一起應對就好。",
        "gal_map_text_207100313=好，聽你的。不管遇到什麼情況，我都會陪著你，一起面對挑戰。",
        "gal_map_text_207100314=謝謝你這麼尊重我的決定。有你在身邊，我覺得不管什麼挑戰，都能順利克服。",
        "gal_map_text_207100315=墨茗抬頭對你笑，眼裡帶著感激。手指輕輕握住你的手。",
        "gal_map_text_207100316=你們選擇了高風險路線，遊戲劇情果然變得更加精彩。墨茗專注地看著螢幕，時不時和你討論策略，手指緊緊握著你的手，身體偶爾靠在你的肩膀上。當成功解鎖隱藏劇情時，墨茗興奮地抱住你的胳膊，眼裡閃著光芒，曖昧的氛圍在共同挑戰成功的喜悅中達到頂峰",
        "gal_map_text_207100317=你們坐在靠窗的小工作臺旁，暖黃的檯燈照亮了面前的黃銅徽章和修復工具。窗外的夜色漸濃，燈光透過玻璃灑進來，與店內的暖光交織，營造出安靜又專注的氛圍。空氣中彌漫著金屬拋光膏的淡淡氣味，混合著木蠟油的溫暖氣息。",
        "gal_map_text_207100318=你們學著老師傅的樣子，小心翼翼地將拋光膏塗在徽章表面，用鹿皮包裹著進行打磨。一開始有些笨拙，但很快找到了節奏。安靜的店裡，只有偶爾傳來的工具碰撞聲，以及你們這邊極其細微的摩擦聲，氛圍溫馨又曖昧。",
        "gal_map_text_207100319=沒想到打磨徽章這麼考驗耐心，不過看著劃痕一點點消失，還挺有成就感的。",
        "gal_map_text_207100320=是啊，這種慢節奏的手工活能讓人靜下心來。你打磨得很認真，比我打磨得好多了，要不要教教我技巧？",
        "gal_map_text_207100321=墨茗低頭打磨著徽章，頭髮垂落在臉頰旁，你下意識抬手幫墨茗將碎發別到耳後，指尖輕輕劃過墨茗的耳廓。墨茗身體一僵，手裡的動作停了下來，抬頭看向你，眼裡帶著驚訝與羞澀，臉頰泛起淡淡的紅暈，呼吸也變得有些急促。",
        "gal_map_text_207100322=請教打磨技巧",
        "gal_map_text_207100323=誇讚墨茗的耐心",
        "gal_map_text_207100324=分享手工體驗",
        "gal_map_text_207100325=你打磨得這麼好，能不能教教我？我總是掌握不好力度，劃痕消得很慢，你肯定有什麼秘訣。",
        "gal_map_text_207100326=墨茗挺直腰板，眼神堅定，主動靠近你。",
        "gal_map_text_207100327=其實很簡單，我教你。就是要保持力度均勻，以小圓圈的方式打磨，我給你示範一下。",
        "gal_map_text_207100328=墨茗挑眉一笑，語氣自信，直接拿起你的手調整姿勢。",
        "gal_map_text_207100329=沒問題，看你磨得這麼費勁，我就勉為其難教教你。記住這個力度和角度，跟著我的節奏來。",
        "gal_map_text_207100330=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100331=其實我也是剛學會的，可能說得不好。不過我可以試著教教你，要是有不對的地方，你可別笑話我。",
        "gal_map_text_207100332=墨茗語氣帶著點依賴，身體微微靠近你。",
        "gal_map_text_207100333=我也不知道算不算秘訣，就是慢慢磨。我們一起琢磨吧，說不定能找到更好的方法，你可要多擔待。",
        "gal_map_text_207100334=原來如此，難怪你打磨得這麼好。有你這麼厲害的老師，我肯定很快就能學會。",
        "gal_map_text_207100335=其實你學得很快，稍微注意一下力度就好。我們一起打磨，爭取讓徽章變得煥然一新。",
        "gal_map_text_207100336=墨茗手把手教你打磨，手腕輕輕包裹著你的手，身體幾乎貼近你，溫熱的氣息拂過你的皮膚。",
        "gal_map_text_207100337=你真的太有耐心了，換做是我，肯定早就放棄了。能這麼專注地做一件事，真的很讓人佩服。",
        "gal_map_text_207100338=墨茗點點頭，眼神認真，手指輕輕梳理著髮絲。",
        "gal_map_text_207100339=其實耐心都是慢慢培養的。做手工活就是這樣，急不得，慢慢打磨才能出效果。",
        "gal_map_text_207100340=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100341=我覺得做任何事都需要耐心和專注。打磨徽章和解決問題一樣，只要找對方法，堅持下去就能成功。",
        "gal_map_text_207100342=墨茗眼睛亮晶晶的，語氣輕柔，手指輕輕觸碰你的手背。",
        "gal_map_text_207100343=就是覺得打磨的過程很治癒。看著徽章一點點變亮，心裡也會變得很溫暖，而且和你一起做，更有動力了。",
        "gal_map_text_207100344=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100345=我也不知道自己居然這麼有耐心。可能是因為這個徽章很特別，而且有你陪著我，所以才會這麼專注吧。",
        "gal_map_text_207100346=能和你一起做這麼有意義的事，真的很開心。你的耐心也感染了我，讓我覺得慢慢打磨也是一種享受。",
        "gal_map_text_207100347=其實我也很開心，和你一起做手工活，感覺時間過得很快。而且有你在身邊，就算打磨很久，也不會覺得無聊。",
        "gal_map_text_207100348=墨茗抬頭對你笑，眼裡帶著感激。",
        "gal_map_text_207100349=我以前很少做手工活，這次和你一起打磨徽章，感覺很新鮮。你平時是不是經常做這種手工？",
        "gal_map_text_207100350=墨茗興奮地拍手。",
        "gal_map_text_207100351=我偶爾會做一些！手工活很有意思，能做出獨一無二的東西，以後有機會我教你做更多好玩的。",
        "gal_map_text_207100352=墨茗語氣興奮。",
        "gal_map_text_207100353=哇！你居然很少做手工？太可惜了。手工活超級有趣的，等我們打磨完徽章，我再給你推薦幾個簡單又好玩的手工項目。",
        "gal_map_text_207100354=墨茗語氣平和，眼神沉靜，手裡的動作不停。",
        "gal_map_text_207100355=我有時候會做一些手工放鬆自己。做手工能讓人靜下心來，遠離喧囂，挺不錯的。",
        "gal_map_text_207100356=墨茗語氣淡然，眼神平靜地看著徽章。",
        "gal_map_text_207100357=我偶爾會嘗試一些簡單的手工。做手工需要專注，能鍛煉耐心，和你一起做，感覺更有意義。",
        "gal_map_text_207100358=那以後有機會，一定要教我做。和你一起做手工，感覺很溫馨，而且能學到新東西。",
        "gal_map_text_207100359=好呀！等我們打磨完這個徽章，我就給你介紹幾個適合新手的手工項目。不過到時候你可不能嫌麻煩哦。",
        "gal_map_text_207100360=墨茗低頭打磨著徽章，嘴角帶著笑意。",
        "gal_map_text_207100361=在你們的共同努力下，黃銅徽章漸漸變得光亮如新，劃痕完全消失，在燈光下泛著溫潤的金屬光澤。墨茗捧著徽章仔細端詳，眼裡閃著滿足的光芒，下意識將頭靠在你的肩膀上。意識到自己的動作後，墨茗臉頰微紅，卻沒有移開，只是輕聲說：“我們做得真好，這個徽章就像新的一樣。” 你的肩膀能感受到墨茗髮絲的柔軟和身體的溫熱，曖昧的氛圍在安靜的店裡愈發濃厚。",
        "gal_map_text_207100362=你們坐在工作臺旁，面前放著黃銅鑰匙扣和修復工具。暖黃的檯燈照亮了鑰匙扣表面的銅銹和毛刺，也照亮了墨茗專注的側臉。店內安靜得只剩下細微的打磨聲和偶爾傳來的工具碰撞聲，氛圍溫馨又專注。",
        "gal_map_text_207100363=墨茗先拿起砂紙，小心地打磨掉鑰匙扣表面的污漬和毛刺，神情專注得像個精密作業的工匠。輪到你用棉簽蘸取溶劑清理縫隙時，手指不可避免地碰到了墨茗剛剛握過的地方，那裡還殘留著墨茗指尖的溫度。墨茗身體微微一頓，抬頭看向你，眼裡帶著一絲驚訝，嘴角卻忍不住微微上揚。",
        "gal_map_text_207100364=這個鑰匙扣的銅銹還挺頑固的，不過慢慢打磨應該能清理乾淨。你清理縫隙的時候要小心，別碰到旁邊的光滑表面。",
        "gal_map_text_207100365=放心，我會很小心的。你打磨得很仔細，表面已經光滑多了，比我厲害多了，要不要休息一下？",
        "gal_map_text_207100366=墨茗放下砂紙，伸手想接過你手裡的鑰匙扣看看清理情況，指尖卻不小心碰到了你的手指。溫熱的觸感讓兩人都頓了一下，墨茗沒有收回手，反而順勢握住了鑰匙扣的另一端，你們的手指在鑰匙扣上輕輕交疊。墨茗的指尖微微發燙，眼神低垂，臉頰泛起淡淡的紅暈，呼吸也變得有些輕柔。",
        "gal_map_text_207100367=順勢一起清理",
        "gal_map_text_207100368=誇讚墨茗的細緻",
        "gal_map_text_207100369=分享手工感受",
        "gal_map_text_207100370=我們一起清理最後一點縫隙吧。你扶著鑰匙扣，我來擦拭，這樣更穩妥，也能快點完成。",
        "gal_map_text_207100371=墨茗眼神堅定，指尖緊緊扶住鑰匙扣。",
        "gal_map_text_207100372=好！我扶穩了，你放心擦。我們一起加油，把它清理得乾乾淨淨。",
        "gal_map_text_207100373=墨茗語氣自信，手指牢牢固定住鑰匙扣，眼神專注。",
        "gal_map_text_207100374=沒問題，我會扶得很穩，你只管專注擦拭就好。有我配合你，肯定能很快完成。",
        "gal_map_text_207100375=墨茗眼神軟下來，指尖輕輕搭在鑰匙扣上。",
        "gal_map_text_207100376=嗯！有你在我就放心多了。我扶著的時候可能會有點抖，你可一定要小心呀。",
        "gal_map_text_207100377=墨茗語氣帶著點依賴，身體微微向你靠近。",
        "gal_map_text_207100378=我有點擔心扶不穩。你擦拭的時候慢一點，我會盡力扶穩，全靠你了。",
        "gal_map_text_207100379=放心，我會很慢的，你扶得很穩。我們這樣配合，很快就能清理乾淨，到時候上一層蜂蠟就完美了。",
        "gal_map_text_207100380=嗯！你擦得真乾淨，縫隙裡的銅銹都清理掉了。我們馬上就能完成了，真開心。",
        "gal_map_text_207100381=墨茗專注地看著你擦拭，身體微微前傾，溫熱的氣息拂過你的手腕。",
        "gal_map_text_207100382=你打磨得也太細緻了，表面變得這麼光滑，我都不用再額外處理了。能這麼專注地做一件事，真的很讓人佩服。",
        "gal_map_text_207100383=墨茗點點頭，眼神認真，手指輕輕梳理著髮絲。",
        "gal_map_text_207100384=其實做手工就是要細緻，一點一點打磨才能出效果。這個鑰匙扣材質不錯，清理乾淨後肯定會很好看。",
        "gal_map_text_207100385=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100386=我覺得打磨和清理都需要邏輯順序，先粗磨再細磨，先清理表面再處理縫隙。我們按照步驟來，效率很高。",
        "gal_map_text_207100387=墨茗眼睛亮晶晶的，語氣輕柔。",
        "gal_map_text_207100388=就是覺得慢慢打磨的過程很治癒。看著鑰匙扣一點點變乾淨，心裡也會變得很舒服，而且和你一起做，更有動力了。",
        "gal_map_text_207100389=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100390=我也沒想到自己能這麼細緻。可能是因為這個鑰匙扣很特別，而且有你陪著我，所以才會這麼專注吧。",
        "gal_map_text_207100391=能和你一起做這麼有意義的事，真的很開心。你的細緻也感染了我，讓我清理縫隙的時候也變得更認真了。",
        "gal_map_text_207100392=其實我也很開心，和你一起做手工活，感覺時間過得很快。而且有你在身邊，就算做得久一點，也不會覺得無聊。",
        "gal_map_text_207100393=墨茗抬頭對你笑，眼裡帶著感激。",
        "gal_map_text_207100394=我以前很少做這種精細的手工活，這次和你一起清理鑰匙扣，感覺很新鮮。你平時是不是很喜歡做手工？",
        "gal_map_text_207100395=墨茗立刻興奮地拍手，眼神亮晶晶的。",
        "gal_map_text_207100396=我超級喜歡做手工！手工活能做出獨一無二的東西，而且很有成就感，以後有機會我教你做更多好玩的。",
        "gal_map_text_207100397=墨茗語氣興奮，身體微微晃動。",
        "gal_map_text_207100398=哇！你居然很少做手工？太可惜了。手工活超級有趣的，等我們做完這個鑰匙扣，我再給你推薦幾個簡單又好玩的手工項目。",
        "gal_map_text_207100399=墨茗語氣平和，眼神沉靜，手裡的動作不停。",
        "gal_map_text_207100400=我有時候會做一些手工放鬆自己。做手工能讓人靜下心來，遠離喧囂，挺不錯的。",
        "gal_map_text_207100401=墨茗微微點頭，語氣淡然，眼神平靜地看著鑰匙扣。",
        "gal_map_text_207100402=我偶爾會嘗試一些簡單的手工。做手工需要耐心和專注，能鍛煉心性，和你一起做，感覺更有意義。",
        "gal_map_text_207100403=那以後有機會，一定要教我做。和你一起做手工，感覺很溫馨，而且能學到新東西。",
        "gal_map_text_207100404=好呀！等我們做完這個鑰匙扣，我就給你介紹幾個適合新手的手工項目。不過到時候你可不能嫌麻煩哦。",
        "gal_map_text_207100405=墨茗低頭看著鑰匙扣，嘴角帶著笑意。",
        "gal_map_text_207100406=你們一起給鑰匙扣上了蜂蠟，完成了最後的養護。鑰匙扣在燈光下泛著溫潤的光澤，變得煥然一新。墨茗興奮地舉起鑰匙扣，眼裡閃著光芒，下意識握住了你的手。兩人的手指緊緊相握，能感受到彼此的溫度和心跳，曖昧的氛圍在成功的喜悅中不斷升溫。",
        "gal_map_text_207100407=你們蹲在工作臺旁，面前放著打開底蓋的音樂盒，裡面的金屬機芯小巧而複雜。暖黃的檯燈照亮了生銹的發條和歪斜的齒輪，也照亮了墨茗專注的眉眼。店內安靜得只剩下兩人輕輕的呼吸聲和偶爾傳來的工具碰撞聲，氛圍緊張又專注。",
        "gal_map_text_207100408=你們分工合作，你負責用專用小刷子清理灰塵和鏽跡，墨茗則拿著小鑷子，在老師傅的指導下嘗試將歪斜的齒輪撥回原位。空間狹小，你們的頭幾乎要碰在一起，呼吸都放得很輕。墨茗屏住呼吸做完調整，長長舒了口氣，抬頭看你，鼻尖幾乎擦過你的下巴。清脆的音符流淌而出，墨茗眼裡閃著驚喜的光芒。",
        "gal_map_text_207100409=太好了！齒輪歸位了，還發出了聲音。你清理得很乾淨，沒有殘留的灰塵，不然肯定不會這麼順利。",
        "gal_map_text_207100410=主要是你調整得很精准，我只是幫了點小忙。這個機芯比想像中複雜，你居然能一次就調整好，太厲害了。",
        "gal_map_text_207100411=墨茗低頭想看看發條的狀態，頭髮垂落在你的肩膀上，帶著淡淡的清香。你下意識抬手幫墨茗攏了攏頭髮，指尖輕輕劃過墨茗的發梢。墨茗身體微微一僵，抬頭看向你，眼裡帶著驚訝與羞澀，臉頰泛起淡淡的紅暈，呼吸也變得有些急促。",
        "gal_map_text_207100412=一起檢查機芯",
        "gal_map_text_207100413=誇讚墨茗的精准",
        "gal_map_text_207100414=分享修復感受",
        "gal_map_text_207100415=我們一起檢查一下其他齒輪有沒有問題吧。你負責觀察齒輪轉動，我來輕輕轉動發條，確保每個部件都正常。",
        "gal_map_text_207100416=墨茗眼神堅定，身體微微靠近你，指尖輕輕點著機芯。",
        "gal_map_text_207100417=好！我會仔細觀察的，不會放過任何細節。我們一起加油，讓音樂盒恢復完整的聲音。",
        "gal_map_text_207100418=墨茗語氣自信，眼神專注，手指準確指向齒輪。",
        "gal_map_text_207100419=沒問題，我觀察得很仔細，任何小問題都逃不過我的眼睛。你慢慢轉動發條，我來指揮。",
        "gal_map_text_207100420=墨茗眼神軟下來，指尖輕輕拉了拉你的袖口。",
        "gal_map_text_207100421=嗯！有你在我就有信心多了。我要是沒看清，你可一定要提醒我呀，別讓我們的努力白費。",
        "gal_map_text_207100422=墨茗語氣帶著點依賴，身體微微靠近你。",
        "gal_map_text_207100423=我有點緊張，怕自己看漏了。你一定要仔細檢查，要是有問題，趕緊告訴我，全靠你了。",
        "gal_map_text_207100424=放心，我們一起配合，肯定能找出所有問題。你觀察得很仔細，有你在，我很放心。",
        "gal_map_text_207100425=嗯！你轉動的時候慢一點，我好仔細觀察每個齒輪的狀態。我們一定能讓音樂盒重新完整地播放音樂。",
        "gal_map_text_207100426=墨茗專注地看著齒輪轉動，手指偶爾碰到你的手。她身體幾乎貼近你，溫熱的氣息拂過你的皮膚。",
        "gal_map_text_207100427=你調整齒輪的動作也太精准了，一次就成功了，我都沒想到會這麼順利。能這麼冷靜地處理這麼精細的工作，真的很讓人佩服。",
        "gal_map_text_207100428=墨茗點點頭，眼神認真，手指輕輕梳理著髮絲。",
        "gal_map_text_207100429=其實調整齒輪就是要找對角度，稍微有點偏差就不行。我也是慢慢嘗試才找到感覺的，還好沒有出錯。",
        "gal_map_text_207100430=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100431=我是按照齒輪的咬合規律調整的，先確定基準位置，再輕輕撥動，這樣成功率很高。只要掌握了方法，就不會有問題。",
        "gal_map_text_207100432=墨茗眼睛亮晶晶的，語氣輕柔，指尖輕輕觸碰你的手背。",
        "gal_map_text_207100433=就是突然找到感覺了，可能是我們的默契吧。看到齒輪歸位的那一刻，真的很開心，而且有你在身邊，更有底氣了。",
        "gal_map_text_207100434=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100435=我也沒想到自己能這麼精准。可能是因為這個音樂盒很特別，而且我很想聽到它完整的聲音，所以才會這麼專注吧。",
        "gal_map_text_207100436=能和你一起完成這麼有挑戰性的修復工作，真的很開心。你的精准和冷靜也感染了我，讓我清理的時候也變得更認真了。",
        "gal_map_text_207100437=其實我也很開心，和你一起修復音樂盒，感覺很有成就感。而且有你在身邊，就算遇到困難，也覺得能克服。",
        "gal_map_text_207100438=墨茗抬頭對你笑，眼裡帶著感激。",
        "gal_map_text_207100439=我以前從來沒嘗試過修復這麼精密的東西，這次和你一起修復音樂盒，感覺很新鮮也很有成就感。你平時是不是經常做這種精細的手工？",
        "gal_map_text_207100440=墨茗立刻興奮地拍手，眼神亮晶晶的。",
        "gal_map_text_207100441=我偶爾會做一些！精細的手工雖然難，但完成後的成就感超強，以後有機會我教你做更多好玩的。",
        "gal_map_text_207100442=墨茗語氣興奮。",
        "gal_map_text_207100443=哇！你居然沒嘗試過？太可惜了。精細手工超級有趣的，等我們修復完這個音樂盒，我再給你推薦幾個簡單又好玩的項目。",
        "gal_map_text_207100444=墨茗語氣平和，眼神沉靜，手裡的動作不停。",
        "gal_map_text_207100445=我有時候會做一些精細手工放鬆自己。精細手工能讓人靜下心來，鍛煉專注力，挺不錯的。",
        "gal_map_text_207100446=墨茗微微點頭，語氣淡然，眼神平靜地看著音樂盒。",
        "gal_map_text_207100447=我偶爾會嘗試一些簡單的精細手工。精細手工需要耐心和專注，能讓人沉澱下來，和你一起做，感覺更有意義。",
        "gal_map_text_207100448=那以後有機會，一定要教我做。和你一起做手工，感覺很溫馨，而且能學到新東西。",
        "gal_map_text_207100449=好呀！等我們修復完這個音樂盒，我就給你介紹幾個適合新手的精細手工項目。不過到時候你可不能嫌麻煩哦。",
        "gal_map_text_207100450=墨茗低頭看著音樂盒，嘴角帶著笑意。",
        "gal_map_text_207100451=在你們的共同努力下，音樂盒終於恢復了完整的聲音，清脆悅耳的旋律在安靜的店裡流淌。墨茗閉上眼睛，靜靜聆聽著旋律，嘴角帶著溫柔的笑意，身體不自覺地靠在你的肩膀上。你能感受到墨茗身體的溫熱和呼吸的輕柔，旋律、燈光與曖昧的氛圍交織在一起，讓人沉醉。",
        "gal_map_text_207100452=你們坐在閱讀區的軟椅上，面前攤開一本精緻的美食雜誌，其中幾頁專門介紹京都百年和果子老鋪。暖黃燈光透過雜誌銅版紙反射出柔和光暈，空氣中混合著舊書頁香氣與淡淡的咖啡香，背景爵士樂節奏舒緩，營造出靜謐又治癒的氛圍。雜誌上的和果子圖片色彩鮮亮，抹茶蕨餅的軟糯、夏柑糖的剔透、栗子大福的飽滿，每一張都極具視覺衝擊力，讓人忍不住心生嚮往。",
        "gal_map_text_207100453=墨茗指尖輕輕劃過和果子圖片，眼神裡滿是沉醉，呼吸都放得很輕。墨茗翻到一頁介紹抹茶蕨餅製作工藝的內容時，忍不住側身靠近你，聲音壓得極低：“你看這個抹茶蕨餅，看起來也太軟糯了吧，感覺一口下去全是茶香，一點都不會膩。” 墨茗的肩膀輕輕貼著你的胳膊，髮絲偶爾掃過你的手腕，帶著淡淡的清香，語氣裡滿是嚮往。",
        "gal_map_text_207100454=你平時喜歡吃甜食嗎？我超級喜歡抹茶味的一切，尤其是這種看起來就很精緻的和果子，光看著心情就變好。",
        "gal_map_text_207100455=我也挺喜歡的，不過平時很少有機會吃到這麼正宗的。這家京都老鋪看起來很有名，據說很多人專門飛過去打卡。",
        "gal_map_text_207100456=墨茗低頭想翻看下一頁，頭髮垂落在你的手臂上，帶著淡淡的清香。你下意識抬手幫墨茗將碎發別到耳後，指尖輕輕劃過墨茗的耳廓。墨茗身體微微一僵，抬頭看向你，眼裡帶著驚訝與羞澀，臉頰泛起淡淡的紅暈，呼吸也變得有些急促，握著雜誌的手指不自覺收緊。",
        "gal_map_text_207100457=約定未來品嘗",
        "gal_map_text_207100458=分享美食體驗",
        "gal_map_text_207100459=調侃甜食誘惑",
        "gal_map_text_207100460=我們以後一起去京都吧，專門打卡這些老鋪，嘗嘗正宗和果子。",
        "gal_map_text_207100461=墨茗眼神堅定，挺直腰板，手指輕輕拍了拍美食雜誌。",
        "gal_map_text_207100462=好！一言為定。我現在就開始做攻略，把京都的和果子店、景點都整理出來，保證行程不踩雷，到時候我們一起玩個痛快。",
        "gal_map_text_207100463=墨茗挑眉一笑，語氣自信。",
        "gal_map_text_207100464=沒問題！我早就想去京都深度游了，正好和你一起。攻略我全包了，你只需要負責跟著我，我會帶你吃遍最地道的和果子，看最美的風景。",
        "gal_map_text_207100465=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100466=真的嗎？太好了！我從來沒去過京都，也不會做攻略，到時候你可一定要多照顧我，別讓我走丟了，拍照也拜託你啦。",
        "gal_map_text_207100467=墨茗語氣帶著點依賴，身體微微靠近你，肩膀輕輕貼住你的胳膊。",
        "gal_map_text_207100468=哇！真的可以一起去嗎？我有點路癡，還怕生，到時候你一定要一直牽著我，不管吃什麼玩什麼，都要陪著我呀。",
        "gal_map_text_207100469=我已經記下這家店的名字了。我們還可以一起列個‘京都必吃清單’，把想吃的和果子都寫上，等忙完這段時間就定機票酒店，怎麼樣？",
        "gal_map_text_207100470=好呀好呀！ 我還要吃抹茶蕨餅、夏柑糖、栗子大福，到時候我們一定要每樣都嘗嘗。",
        "gal_map_text_207100471=墨茗湊過來看手機，手指不小心碰到你的手背，臉頰更紅了",
        "gal_map_text_207100472=我之前吃過類似的抹茶蕨餅，口感很細膩，不過肯定沒京都的正宗。",
        "gal_map_text_207100473=墨茗點點頭，眼神認真，手指輕輕梳理著髮絲。",
        "gal_map_text_207100474=我還挺喜歡吃甜食的，不過會控制量，畢竟吃太多對牙齒不好。抹茶味的甜食我尤其喜歡，口感清爽，不會太齁，和這本畫冊上的和果子很搭。",
        "gal_map_text_207100475=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100476=我對甜食的接受度有明確標準，甜度低於 60%、口感細膩無顆粒感的我會喜歡。從畫冊描述來看，京都和果子的甜度應該符合我的要求，而且原料天然，相對健康。",
        "gal_map_text_207100477=墨茗眼睛亮晶晶的，語氣輕柔，手指輕輕碰了碰你的手背。",
        "gal_map_text_207100478=我超級喜歡吃甜食！甜食能讓人心情變好，尤其是這種長得這麼精緻的和果子，光看著就很開心了，更別說吃了。",
        "gal_map_text_207100479=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100480=我真的太愛甜食了，每次不開心的時候，吃一塊甜甜的點心，所有煩惱都沒了。看到這些和果子，我已經開始期待了，要是能和你一起吃，肯定會更甜。",
        "gal_map_text_207100481=喜歡吃就好，那我們以後去京都就更有動力了。其實除了和果子，京都的懷石料理也很有名，清淡又精緻，到時候我們也可以試試。",
        "gal_map_text_207100482=謝謝，我之前在雜誌上看到過懷石料理的介紹，擺盤像藝術品一樣，特別吸引人。沒想到你也喜歡這些，我們的口味還挺像的。",
        "gal_map_text_207100483=墨茗輕聲說道。",
        "gal_map_text_207100484=看你這眼神，都快把雜誌看穿了，是不是已經在想味道了？",
        "gal_map_text_207100485=墨茗臉頰微紅，輕輕捶了捶你的胳膊，語氣輕快。",
        "gal_map_text_207100486=才沒有呢！不過確實有點饞了，這些和果子看起來也太誘人了，真想現在就吃到。我們趕緊看完這本，再找找有沒有其他美食雜誌。",
        "gal_map_text_207100487=墨茗眼睛瞪得圓圓的，語氣興奮，身體微微晃動。",
        "gal_map_text_207100488=哎呀，你別調侃我了！不過說真的，我已經開始流口水了，這些和果子也太精緻了吧。等下我們去網上搜搜，看看有沒有代購，先解解饞再說。",
        "gal_map_text_207100489=墨茗氣平和，眼神沉靜，手指輕輕搭在畫冊上。",
        "gal_map_text_207100490=有一點吧，確實挺想吃的。不過也不用著急，以後有機會去京都再吃也不遲。我們繼續看畫冊吧，還有很多有趣的美食沒看完呢。",
        "gal_map_text_207100491=墨茗微微點頭，語氣淡然，眼神平靜地看著雜誌。",
        "gal_map_text_207100492=確實有點期待。不過美食需要慢慢等待，這樣吃到的時候才更有意義。我們慢慢翻閱，看看還有哪些值得嘗試的和果子，提前做個瞭解。",
        "gal_map_text_207100493=好好好，不調侃你了。其實我也有點饞了，等下我們看完雜誌，去附近找家甜品店，吃點小蛋糕怎麼樣？就當提前體驗甜食的快樂。",
        "gal_map_text_207100494=好呀！我知道附近有家抹茶甜品店，口碑很好，我們等下就去那裡吧，嘗嘗他們家的抹茶蛋糕。",
        "gal_map_text_207100495=墨茗抬頭對你笑，眼裡帶著驚喜。",
        "gal_map_text_207100496=你們繼續翻閱美食雜誌，時不時分享彼此喜歡的美食，討論著未來的京都之行。墨茗的肩膀偶爾碰到你的胳膊，手指不經意間的觸碰讓兩人都微微心動。聊到盡興時，墨茗下意識靠在你的肩膀上，指著畫冊上的和果子輕聲說：“真希望快點去京都呀。” 你能感受到墨茗髮絲的柔軟和身體的溫熱，曖昧的氛圍在溫馨的聊天中不斷升溫。",
        "gal_map_text_207100497=你們坐在靠窗的閱讀區，面前攤開一本封面印著冰島極光的旅行雜誌。窗外的夕陽透過玻璃灑進來，在書頁上投下暖金色的光斑，混合著店內的舊書香氣與爵士樂，營造出靜謐又浪漫的氛圍。雜誌內頁的圖文極具衝擊力 —— 藍紫色的極光劃破黑夜，黑沙灘上的海浪泛著白沫，苔原上的馴鹿抬頭望向鏡頭，每一頁都像在召喚人奔赴遠方。",
        "gal_map_text_207100498=墨茗手指輕輕劃過極光的圖片，眼神裡滿是嚮往，呼吸都放得很輕。墨茗翻到冰島藍湖溫泉的頁面時，忍不住小聲驚歎，身體微微前傾，肩膀不自覺地靠向你。“你看這裡的溫泉，在雪地裡冒著熱氣，也太浪漫了吧。” 墨茗轉頭看向你，眼裡閃著星光，鼻尖離你的臉頰只有一拳距離，語氣裡滿是憧憬。",
        "gal_map_text_207100499=我一直想去看極光，感覺就像闖進了童話世界。只是冰島太遠了，而且聽說冬天特別冷，我有點怕凍，但又真的很想去體驗。",
        "gal_map_text_207100500=其實冰島的冬天雖然冷，但看到極光的概率最高。我朋友去年去過，說看到極光的那一刻，所有寒冷都值得了。你平時喜歡旅行嗎？更偏愛自然風景還是城市人文？",
        "gal_map_text_207100501=墨茗低頭想翻看下一頁的冰島攻略，頭髮隨著動作垂落在你的手臂上，帶著淡淡的洗髮水清香。你下意識抬手幫墨茗將碎發別到耳後，手指不經意間劃過墨茗的耳廓，溫熱的觸感讓墨茗身體微微一僵。墨茗抬頭看向你，眼裡帶著驚訝與羞澀，臉頰泛起淡淡的紅暈，原本輕聲的呼吸也變得有些急促。",
        "gal_map_text_207100502=約定一起出發",
        "gal_map_text_207100503=分析旅行攻略",
        "gal_map_text_207100504=分享旅行經歷",
        "gal_map_text_207100505=那我們以後一起去冰島看極光吧，我來做攻略訂裝備。",
        "gal_map_text_207100506=墨茗眼神瞬間亮起來，挺直腰板，手指輕輕拍了拍雜誌。",
        "gal_map_text_207100507=好！一言為定。我也會提前做功課，查冰島的天氣、必去景點，還會學幾句簡單的冰島語，絕對不會拖你後腿。",
        "gal_map_text_207100508=墨茗挑眉一笑，語氣自信。",
        "gal_map_text_207100509=沒問題！我早就想攻略冰島了，正好有人搭伴。攻略我們可以分工，我負責交通和民宿，你負責美食和小眾景點，保證行程又省心又精彩。",
        "gal_map_text_207100510=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100511=真的可以嗎？我從來沒去過這麼遠的地方，而且很怕黑，到時候晚上看極光，你可一定要緊緊牽著我，別讓我走丟了。",
        "gal_map_text_207100512=墨茗語氣帶著點依賴，身體微微向你靠近，肩膀貼住你的胳膊。",
        "gal_map_text_207100513=哇！真的能一起去嗎？我怕冷又怕累，還路癡，到時候你一定要全程照顧我，不管去哪裡都要陪著我，不能讓我一個人待著。",
        "gal_map_text_207100514=你看，我們現在就可以列想做的事。極光、泡藍湖溫泉、去黑沙灘、喂馴鹿，還有你想吃的冰島美食，都可以寫上去，等我們都有空了就定機票，怎麼樣？",
        "gal_map_text_207100515=好呀好呀！我還要在溫泉裡拍照片，去看冰川徒步，嘗嘗冰島的羊肉湯。對了，我們還要提前買情侶款保暖圍巾，拍照肯定很好看。",
        "gal_map_text_207100516=墨茗過來看手機，手指不小心碰到你的手背，臉頰更紅了。",
        "gal_map_text_207100517=去冰島看極光有很多技巧，最佳時間和裝備都有講究。",
        "gal_map_text_207100518=墨茗點點頭，眼神認真，手指輕輕梳理著髮絲。",
        "gal_map_text_207100519=你分析得很全面。我覺得可以先確定出行時間，避開節假日高峰，這樣機票和民宿會更划算。而且冰川徒步需要專業嚮導，我們還要提前預約，確保安全。",
        "gal_map_text_207100520=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100521=根據攻略資料，11 月到 1 月的極光出現概率高達 80%，但氣溫最低可達 -20℃。我們可以提前 3 個月訂機票，選中轉時間短的航班，民宿優先選含早餐和接送的。",
        "gal_map_text_207100522=墨茗眼睛亮晶晶的，語氣輕柔，手指輕輕碰了碰你的手背。",
        "gal_map_text_207100523=哇，原來有這麼多講究！不過只要能看到極光，再冷我也能忍。一想到能和你一起站在雪地裡看極光，就覺得好浪漫。",
        "gal_map_text_207100524=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100525=聽你這麼一說，我更想去了。攻略什麼的你說了算就好，我只要跟著你就行。一想到能和喜歡的人一起看這麼美的風景，就覺得心裡暖暖的。",
        "gal_map_text_207100526=其實攻略可以慢慢做，最重要的是和你一起去。除了冰島，我還知道幾個小眾極光觀測地，比如挪威的特羅姆瑟，也可以列入備選，你更想去哪裡？",
        "gal_map_text_207100527=我還是更想去冰島！黑沙灘和藍湖溫泉真的太吸引人了，而且你說的觀測點聽起來就很專業，我相信你的選擇。",
        "gal_map_text_207100528=墨茗手指碰到你的手指，輕聲說。",
        "gal_map_text_207100529=我以前去過挪威，峽灣的風景和冰島一樣讓人印象深刻。",
        "gal_map_text_207100530=墨茗立刻興奮地拍手，語氣輕快。",
        "gal_map_text_207100531=哇！挪威峽灣聽起來也好好玩。你有沒有拍照片？快給我看看。其實我去過雲南，那裡的雪山和湖泊也很美，以後有機會我們也可以去雲南呀。",
        "gal_map_text_207100532=墨茗語氣興奮，身體微微晃動。",
        "gal_map_text_207100533=天呐！你居然去過挪威？也太厲害了吧。快給我講講那裡的美食、風土人情，還有有沒有遇到什麼有趣的事。我也好想多去幾個國家，把世界美景都看遍。",
        "gal_map_text_207100534=墨茗語氣平和，眼神沉靜，手指輕輕搭在雜誌上。",
        "gal_map_text_207100535=挪威峽灣確實很有名。我去過青海湖，和你說的峽灣一樣，都是很治癒的自然風景。旅行的意義大概就是見識不同風景，放鬆心情吧。",
        "gal_map_text_207100536=墨茗微微點頭，語氣淡然，眼神平靜地看著雜誌。",
        "gal_map_text_207100537=能去挪威看看也挺好的。我平時很少長途旅行，只去過周邊古鎮，節奏很慢，也很舒服。冰島這種遠方，雖然嚮往，但需要足夠時間準備。",
        "gal_map_text_207100538=看，這是清晨的峽灣，還有當地的三文魚，超級新鮮。其實旅行不用趕節奏，雲南、青海湖、冰島，我們可以一個個去，慢慢體驗。",
        "gal_map_text_207100539=哇，真的好美！三文魚看起來也好好吃。以後不管去什麼地方，只要和你一起，我都覺得很開心，哪怕只是周邊小鎮也沒關係。",
        "gal_map_text_207100540=墨茗專注地看著照片，手指輕輕劃過手機螢幕。",
        "gal_map_text_207100541=你們繼續翻閱旅行雜誌，從冰島聊到挪威，從國內古鎮聊到國外小眾景點，分享著各自的旅行經歷和嚮往之地。墨茗的肩膀偶爾碰到你的胳膊，手指不經意間的觸碰讓兩人都微微心動。聊到盡興時，墨茗下意識靠在你的肩膀上，指著雜誌上的極光圖片輕聲說：“真希望這一天能快點來呀。” 你能感受到墨茗髮絲的柔軟和身體的溫熱，夕陽的光斑落在你們身上，曖昧的氛圍在溫馨的聊天中不斷升溫。",
        "gal_map_text_207100542=你們坐在藝術畫冊區的軟椅上，面前攤開一本印象派大師的作品集。暖黃的燈光透過畫冊的銅版紙反射出柔和的光暈，空氣中舊書香氣與淡淡的松節油氣息交織，背景爵士樂的節奏放緩，營造出靜謐又富有格調的氛圍。畫冊內頁的畫作色彩濃烈卻不失溫柔 —— 莫内的睡蓮在光影中浮動，雷諾瓦的舞會場景洋溢著慵懶的浪漫，每一筆色彩都像在訴說著細膩的情緒。",
        "gal_map_text_207100543=墨茗手指輕輕劃過莫内《睡蓮》的畫面，眼神裡滿是沉醉，呼吸都放得很輕。墨茗翻到一幅描繪黃昏海岸的畫作時，忍不住側身靠近你，聲音壓得極低：“你看這片海的顏色，像不像把橘子汽水和天空揉在了一起？太溫柔了。” 墨茗的肩膀輕輕貼著你的胳膊，髮絲偶爾掃過你的手腕，帶著淡淡的清香，語氣裡滿是讚歎。",
        "gal_map_text_207100544=我一直很喜歡印象派的畫。不追求寫實，卻能把情緒和光影捕捉得恰到好處。尤其是莫内的畫，每次看都覺得心裡軟軟的，好像走進了畫裡的世界。",
        "gal_map_text_207100545=我也很喜歡這種風格。印象派最妙的地方就是“捕捉瞬間”，比如光影變化、風吹過的痕跡，比寫實畫作多了很多想像空間。你平時會去美術館看展嗎？",
        "gal_map_text_207100546=墨茗低頭想翻看下一頁的《盧昂大教堂》系列，頭髮隨著動作垂落在畫冊上，遮住了部分畫面。你下意識抬手幫墨茗將碎發別到耳後，手指不經意間劃過墨茗的臉頰，溫熱的觸感讓墨茗身體微微一僵。墨茗抬頭看向你，眼裡帶著驚訝與羞澀，臉頰泛起淡淡的紅暈，原本輕柔的呼吸也變得有些急促。",
        "gal_map_text_207100547=約定看展約會",
        "gal_map_text_207100548=分析畫作細節",
        "gal_map_text_207100549=分享審美感受",
        "gal_map_text_207100550=市中心美術館下個月有印象派特展，我們一起去看好不好？",
        "gal_map_text_207100551=墨茗眼神瞬間亮起來，挺直腰板，手指輕輕拍了拍畫冊。",
        "gal_map_text_207100552=好！一言為定。我現在就去查特展的展品清單，提前做些功課，到時候我們可以一起討論，不會只看熱鬧。",
        "gal_map_text_207100553=墨茗挑眉一笑，語氣自信。",
        "gal_map_text_207100554=沒問題！我早就關注這個特展了，正愁沒人一起去。門票我來搶，我還知道美術館附近一家超贊的小眾咖啡館，看完展我們直接去，保證不踩雷。",
        "gal_map_text_207100555=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100556=真的可以嗎？我對藝術史不太懂，到時候你可一定要多給我講講，別讓我像個外行一樣，而且美術館人多，你要牽著我，別讓我走丟了。",
        "gal_map_text_207100557=墨茗語氣帶著點依賴，身體微微向你靠近，肩膀緊緊貼住你的胳膊。",
        "gal_map_text_207100558=哇！真的能一起去嗎？我怕自己看不懂畫，也不知道該說什麼，到時候你要一直陪著我，給我講解每幅畫的故事，不能丟下我一個人呀。",
        "gal_map_text_207100559=你看，特展資訊在這裡。有莫内的《睡蓮》系列和雷諾瓦的《煎餅磨坊的舞會》真跡。我們訂週末的票，看完展去咖啡館，點你喜歡的拿鐵和甜點，怎麼樣？",
        "gal_map_text_207100560=好呀好呀！我早就想看《煎餅磨坊的舞會》了，畫裡的氛圍太有感染力了。到時候我們還要在美術館門口拍張合照。",
        "gal_map_text_207100561=墨茗湊過來，手指不小心碰到你的手背，臉頰更紅了。",
        "gal_map_text_207100562=這幅《睡蓮》的色彩層次很妙，莫内用了大量藍紫色調打底。",
        "gal_map_text_207100563=墨茗點點頭，眼神認真，手指輕輕梳理著髮絲。",
        "gal_map_text_207100564=你分析得很到位。我注意到水面的倒影和睡蓮本身的色彩呼應得很好，藍紫色調讓人覺得很寧靜，這就是色彩心理學的作用吧。",
        "gal_map_text_207100565=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100566=根據藝術史資料，莫内晚年確實患有白內障，導致他對色彩的感知發生變化。這幅《睡蓮》是他晚年作品，藍紫色調強化的是他對光影的主觀感受。",
        "gal_map_text_207100567=墨茗眼睛亮晶晶的，語氣輕柔，手指輕輕碰了碰你的手背。",
        "gal_map_text_207100568=哇，原來還有這麼多門道！我只是覺得這幅畫很溫柔，聽你這麼一說，更能感受到莫内想表達的情緒了，太動人了。",
        "gal_map_text_207100569=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100570=聽你這麼講解，我好像更懂這幅畫了。原來筆觸裡都藏著故事，莫内晚年看不清還堅持創作，真的很讓人感動。和你一起分享這種感受，心裡暖暖的。",
        "gal_map_text_207100571=其實藝術欣賞沒有標準答案，你感受到的溫柔就是最珍貴的體驗。除了莫内，你還喜歡哪位畫家？我們可以提前瞭解，到時候特展上遇到能一起討論。",
        "gal_map_text_207100572=我還喜歡梵古！他的《向日葵》太有生命力了，雖然色彩濃烈，卻讓人覺得充滿希望，希望特展上也能看到。",
        "gal_map_text_207100573=墨茗輕聲說道。",
        "gal_map_text_207100574=我第一次看莫内的畫是在大學美術館，那種感覺太奇妙了。",
        "gal_map_text_207100575=墨茗立刻興奮地拍手，語氣輕快。",
        "gal_map_text_207100576=哇！這種體驗也太神奇了吧。我第一次看印象派的畫是在美術課本上，當時就覺得顏色好好看。以後我們要多去美術館，體驗這種奇妙的感覺。",
        "gal_map_text_207100577=墨茗語氣興奮，身體微微晃動。",
        "gal_map_text_207100578=天呐！你居然見過《盧昂大教堂》的真跡？也太幸運了吧。快給我講講當時的細節，陽光灑進來是什麼樣子？畫的質感怎麼樣？我太好奇了。",
        "gal_map_text_207100579=墨茗語氣平和，眼神沉靜，手指輕輕搭在畫冊上。",
        "gal_map_text_207100580=這種沉浸式的體驗確實很難得。我第一次被藝術打動是看達芬奇的《蒙娜麗莎》畫冊，藝術的魅力大概就是能讓人產生共鳴吧。",
        "gal_map_text_207100581=墨茗墨茗微微點頭，語氣淡然，眼神平靜地看著畫冊。",
        "gal_map_text_207100582=能有這樣的體驗也挺好的。我平時很少看展，但看這本畫冊的時候，也能感受到畫裡的情緒。藝術不需要刻意理解，靜靜感受就好。",
        "gal_map_text_207100583=你看，這是當時拍的美術館內部。陽光透過彩色玻璃真的很美。特展的體驗會更好，真跡的筆觸和色彩衝擊力比畫冊強太多了。",
        "gal_map_text_207100584=哇，真的好美！我已經開始期待特展了，不管是畫本身，還是和你一起看展的時光，都覺得很珍貴。以後我們還要一起看更多展。",
        "gal_map_text_207100585=墨茗專注地看著你。",
        "gal_map_text_207100586=你們繼續翻閱藝術畫冊，從莫内聊到梵古，從色彩筆觸聊到創作背景，分享著各自對藝術的理解與感受。墨茗的肩膀始終輕輕靠著你，手指偶爾不經意地碰到你的手，眼神交匯時帶著濃濃的默契與笑意。夕陽的餘暉透過窗戶灑進來，在畫冊上投下暖金色的光斑，曖昧的氛圍在靜謐的交流中不斷升溫，仿佛時間都放慢了腳步。",
        "gal_map_text_207100587=小眾遊戲集成店內，柔和的燈光籠罩著靠窗的高腳椅區域，桌上放著兩杯店主推薦的無酒精特調 ——“勇者的藍藥水”（淡藍色氣泡水）和 “精靈的晨露”（淺粉色果茶）。窗外是商業街流動的夜景，行人、車燈、霓虹交織成生動畫卷，窗玻璃隔絕了喧囂，店內只剩令人安心的溫暖與輕聲笑語。",
        "gal_map_text_207100588=你們剛結束一輪雙人解謎遊戲，收拾好道具後，並肩坐在高腳椅上稍作休息。玩遊戲時的興奮勁兒還未完全褪去，墨茗臉上帶著鬆弛又滿足的紅暈，雙手捧著杯子小口啜飲，目光偶爾飄向窗外，又快速落回你身上，眼裡閃著未盡的興致。",
        "gal_map_text_207100589=剛才最後那個密碼鎖，我還以為要卡很久，沒想到你一下就猜到是 ‘我們玩過的遊戲關卡數’，也太默契了吧！",
        "gal_map_text_207100590=因為你之前提過喜歡 ‘按時間線找線索’，而且我們剛好玩了 3 個關卡，順著你的思路一想就通了。你剛才觀察道具上的刻痕時，也很認真呀。",
        "gal_map_text_207100591=墨茗被你誇得臉頰微紅，低頭抿了口 “精靈的晨露”，抬眼時眼神亮晶晶的，身體微微向你傾斜，肩膀離你的距離更近了些，輕聲說：“和你一起玩遊戲，總覺得時間過得特別快，一點都不覺得累。”",
        "gal_map_text_207100592=同頻闖關邀約",
        "gal_map_text_207100593=專注瞬間誇讚",
        "gal_map_text_207100594=暖光氛圍續坐",
        "gal_map_text_207100595=雙人賽約備戰",
        "gal_map_text_207100596=護眼暖心照料",
        "gal_map_text_207100597=我也是，這種不用刻意解釋就能 get 到對方思路的感覺，真的很難得。這家店還有幾款雙人合作的懸疑遊戲，要不要記下來，下次再來挑戰？",
        "gal_map_text_207100598=墨茗眼睛亮起來，手指輕輕點了點桌子。",
        "gal_map_text_207100599=好啊！下次我要提前查攻略，把懸疑遊戲的常見線索類型記下來，肯定能比這次更快通關。不過到時候你可不許讓著我，要拿出真本事較量！",
        "gal_map_text_207100600=墨茗語氣自信，抬手輕輕拍了拍你的胳膊。",
        "gal_map_text_207100601=必須記！我已經在想下次要玩《密室逃脫：暗夜古堡》了，據說難度更高，劇情也更精彩。下次我來主導解謎，保證讓你刮目相看。",
        "gal_map_text_207100602=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100603=嗯！有你一起，再難的關卡我都不怕。下次你還要像這次一樣，多提醒我線索方向，我對懸疑類的敏感度沒你高。",
        "gal_map_text_207100604=墨茗語氣帶著依賴，臉頰微紅。",
        "gal_map_text_207100605=太好啦！我一個人可不敢玩懸疑遊戲，總覺得怕怕的，有你陪著就安心多了。下次全靠你帶節奏，我跟著你聽指揮就行。",
        "gal_map_text_207100606=你看，已經記下店名了，我們把想玩的遊戲都列上去，下次來直接照著玩。你最想先試哪款？",
        "gal_map_text_207100607=我想先玩《星空探索者》！剛才店員說這款需要兩個人配合找星座線索，聽起來就很有意思。",
        "gal_map_text_207100608=墨茗湊過來看你，手指不小心碰到你的手背，臉頰更紅了。",
        "gal_map_text_207100609=真的，你剛才觀察道具刻痕的樣子特別認真，連我都沒注意到的 ‘小太陽’ 標記，你一眼就指出來了，反應超快。而且你總能順著線索推導，邏輯感比我還強。",
        "gal_map_text_207100610=墨茗點點頭，語氣平和，手指輕輕梳理著髮絲。",
        "gal_map_text_207100611=其實就是順著 ‘’道具關聯劇情‘’ 的邏輯推導而已，你剛才聯想到關卡數的思路也很靈活呀。我們配合得還挺默契的，互補又高效。",
        "gal_map_text_207100612=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100613=這是基於 ‘’線索具象化‘’ 的基本邏輯，排除無效資訊後，刻痕和關卡數的關聯是唯一合理答案。不過你的聯想能力比我強，剛好彌補了我思維的局限。",
        "gal_map_text_207100614=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100615=可能是和你一起玩，所以才更有靈感吧。而且你剛才沒有打斷我的思路，還一直鼓勵我，讓我更敢大膽推導了，這種感覺特別好。",
        "gal_map_text_207100616=墨茗臉頰微紅，眼神躲閃了一下又看向你。",
        "gal_map_text_207100617=被你這麼誇，有點不好意思啦。其實我也很緊張，怕自己想錯耽誤時間，還好有你一直陪著我、相信我，給了我很多信心。",
        "gal_map_text_207100618=不用緊張呀，就算想錯了也沒關係，一起重新推導就好。你平時是不是很喜歡玩這類需要觀察的遊戲？",
        "gal_map_text_207100619=對呀，我平時很喜歡玩拼圖、解謎類的遊戲，覺得一點點找出答案的過程很有成就感。不過和你一起玩，比自己玩開心多了。",
        "gal_map_text_207100620=墨茗墨茗越說越興奮，身體不自覺地向你靠近。",
        "gal_map_text_207100621=這家店的氛圍真的很好，暖黃的燈光、輕柔的背景音樂，再加上和你一起玩遊戲，感覺時間過得特別快，一點都不覺得枯燥。要不要再坐一會兒，喝點東西再走？",
        "gal_map_text_207100622=墨茗語氣輕快，眼睛亮晶晶地看向吧台方向。",
        "gal_map_text_207100623=好呀好呀！我還想嘗嘗他們家的芒果氣泡水，剛才看別人點的好像很不錯。我們再聊聊天，說說你平時玩遊戲有沒有遇到過什麼有趣的事？",
        "gal_map_text_207100624=墨茗興奮地抬手招呼店員，轉頭對你笑。",
        "gal_map_text_207100625=贊同！這裡的氛圍太舒服了，不想這麼快離開。我平時玩遊戲遇到過很多搞笑的隊友，今天可以慢慢講給你聽，你也一定要分享你的趣事呀！",
        "gal_map_text_207100626=墨茗語氣平和，眼神沉靜地看著窗外。",
        "gal_map_text_207100627=嗯，再坐一會兒也挺好。這裡很安靜，適合慢慢聊天，剛才玩遊戲太投入，都沒好好和你說說話。",
        "gal_map_text_207100628=墨茗微微點頭，語氣淡然，手指輕輕搭在杯沿。",
        "gal_map_text_207100629=可以，不急著走。坐下來慢慢聊，看看窗外的夜景也不錯，這種放鬆的感覺很難得。",
        "gal_map_text_207100630=好啊，我之前玩多人連線遊戲，隊友把 “敵人”’ 當成 “隊友” 帶了一路，最後還一起慶祝“勝利” ，特別搞笑。",
        "gal_map_text_207100631=我遇到過！有一次玩解謎遊戲，隊友把道具往錯誤的地方塞了十幾次，最後發現是自己看錯了提示，我們笑了好久。來你也遇到過這麼搞笑的事，太有共鳴了。",
        "gal_map_text_207100632=墨茗聽到趣事忍不住笑出聲，眼角彎成月牙。",
        "gal_map_text_207100633=其實這家店下個月會舉辦雙人遊戲挑戰賽，據說冠軍能獲得定制遊戲周邊。要不要約著一起報名？就當是我們下次的 “默契特訓”，說不定還能拿個獎品回來。",
        "gal_map_text_207100634=墨茗眼神堅定，挺直腰板。",
        "gal_map_text_207100635=好呀！那我這幾天就惡補雙人遊戲技巧，到時候我們一起衝刺冠軍。不過你也別偷懶，我們各自努力，一起爭取好成績！",
        "gal_map_text_207100636=墨茗語氣自信，抬手拍了拍你的肩膀。",
        "gal_map_text_207100637=必須約！我早就想參加這種挑戰賽了，正好有人組隊。放心，有我在，冠軍肯定跑不了，你跟著我的節奏來就行。",
        "gal_map_text_207100638=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100639=真的可以嗎？我有點擔心拖你後腿。不過有你陪著，我就有信心了，你到時候一定要多指導我。",
        "gal_map_text_207100640=墨茗語氣帶著依賴，身體微微靠近你。",
        "gal_map_text_207100641=哇，挑戰賽聽起來好有意思！我對比賽沒什麼經驗，全靠你帶了，你一定要好好準備，帶著我一起拿獎品。",
        "gal_map_text_207100642=我已經查好比賽規則了，主要是考驗雙人配合，我們平時玩的幾款遊戲都能用到。我們每週抽兩個晚上練手，提前熟悉比賽流程，怎麼樣？",
        "gal_map_text_207100643=好呀好呀！我這就把時間空出來，我們一定要好好準備，爭取拿個定制周邊回來，作為我們的 “默契紀念”。",
        "gal_map_text_207100644=墨茗眼裡滿是期待。",
        "gal_map_text_207100645=玩了這麼久遊戲，眼睛會不會累？我帶了蒸汽眼罩，你戴上休息一會兒，我去幫你拿杯熱飲，緩解一下眼睛疲勞。",
        "gal_map_text_207100646=墨茗接過蒸汽眼罩，語氣輕快。",
        "gal_map_text_207100647=還好啦，不過謝謝你這麼貼心！那我就不客氣啦，你快去快回，回來我們再聊聊接下來要玩的遊戲。",
        "gal_map_text_207100648=墨茗興奮地眨了眨眼，立刻戴上眼罩。",
        "gal_map_text_207100649=哇，你居然還帶了蒸汽眼罩！太細心了吧。正好眼睛有點乾澀，謝謝你呀，熱飲就麻煩你啦，我要一杯熱可哥。",
        "gal_map_text_207100650=墨茗語氣平和，慢慢戴上眼罩。",
        "gal_map_text_207100651=謝謝你，確實有點累了。不用麻煩你特意去拿熱飲，我休息一會兒就好，你也坐下來歇歇吧。",
        "gal_map_text_207100652=墨茗微微點頭，語氣淡然。",
        "gal_map_text_207100653=還好，不算太累。不過還是謝謝你的關心，你有心了。我們都休息一下，再繼續接下來的行程。",
        "gal_map_text_207100654=熱可哥來了，慢慢喝。蒸汽眼罩敷個10分鐘就好，等下我們可以去逛逛遊戲周邊區，看看有沒有你喜歡的小物件。",
        "gal_map_text_207100655=謝謝。有你這麼照顧我，真的很安心。逛周邊區的時候，我們可以看看有沒有適合雙人遊戲的小道具，以後玩遊戲的時候能用得上。",
        "gal_map_text_207100656=墨茗摘下眼罩，眼裡帶著暖意。",
        "gal_map_text_207100657=你們在遊戲店的互動漸漸接近尾聲，暖黃燈光將兩人的影子在地面上拉得很長，偶爾交匯重疊。從一起列遊戲清單、分享遊戲趣事，到互贈小掛件、約定線上組隊，每一個細節都讓彼此的距離不斷拉近。",
        "gal_map_text_207100658=離開時，墨茗主動挽住你的胳膊，腳步輕快地與你並肩走在霓虹閃爍的街邊，嘴裡還念叨著下次要挑戰的遊戲關卡，眼裡閃著藏不住的興奮與期待。晚風輕輕吹過，帶著遊戲店的淡淡氣息，兩人手心傳遞的溫度與默契的沉默，讓好感在夜色中悄悄沉澱，為後續的情感升溫埋下伏筆。",
        "gal_map_text_207100659=舊物修復與個性化定制小店的後院天井，鋪著青石板，牆角種著茂盛的薄荷和幾盆多肉植物。中央放著一張老舊木桌和兩張籐椅，桌上擺著粗陶茶壺和兩個杯子，淡淡的草藥香氣在微涼的空氣中飄散。抬頭能看到一小片被屋簷切割出的深藍色夜空，安靜得只剩下偶爾的風聲和遠處隱約的車流，樸素而寧靜，只屬於你們兩人。",
        "gal_map_text_207100660=你們剛和老師傅一起完成黃銅徽章的修復，將打磨得發亮的徽章收好後，跟著老師傅來到後院休息。墨茗手裡攥著修復好的徽章，手指輕輕摩挲著光滑的表面，臉上帶著完成手工後的滿足感，眼神柔和地打量著天井裡的綠植。",
        "gal_map_text_207100661=嘗嘗這個，老師傅說能清心明目，剛才打磨徽章費了不少眼，喝點潤潤。",
        "gal_map_text_207100662=謝謝。味道很清新，帶著點薄荷的香氣，挺好喝的。剛才要不是你提醒我 ‘力度輕一點’，我可能都把徽章磨花了，你怎麼知道要控制力度呀？",
        "gal_map_text_207100663=你解釋完 “之前瞭解過金屬修復的基礎技巧” 後，墨茗眼神裡滿是認可，身體微微向你傾斜，肩膀輕輕碰到你的胳膊，輕聲說：“和你一起做手工，感覺特別安心，就算是第一次嘗試，也不覺得緊張。”",
        "gal_map_text_207100664=天井靜謐享時",
        "gal_map_text_207100665=專屬銀飾共制",
        "gal_map_text_207100666=晚風輕拂守護",
        "gal_map_text_207100667=手工搭檔續航",
        "gal_map_text_207100668=匠心細節認可",
        "gal_map_text_207100669=我也覺得這裡很舒服，安靜又愜意，遠離了城市的喧囂，再加上和你一起做手工、喝草藥茶，感覺時間都變慢了。平時工作太忙，很少有機會這樣靜下心來享受時光。",
        "gal_map_text_207100670=墨茗語氣輕快，眼神亮晶晶地看著天井裡的多肉。",
        "gal_map_text_207100671=是啊是啊！我平時也很少有機會這麼放鬆，每天都忙忙碌碌的。這裡的綠植好可愛，薄荷長得好茂盛，要不要摘一片聞聞香味？",
        "gal_map_text_207100672=墨茗興奮地站起身，湊近薄荷叢，轉頭對你笑。",
        "gal_map_text_207100673=太贊同了！這裡簡直是 “治癒小天地”，草藥香、綠植、夜空，再加上和你一起，太完美了。我摘一片薄荷給你，你聞聞，特別清新！",
        "gal_map_text_207100674=墨茗語氣平和，眼神沉靜地看著你。",
        "gal_map_text_207100675=嗯，這裡的氛圍確實很好。安靜的環境能讓人靜下心來，和你一起做手工、聊天，感覺很放鬆，也很有意義。",
        "gal_map_text_207100676=墨茗微微點頭，語氣淡然，手指輕輕搭在杯沿。",
        "gal_map_text_207100677=確實，這種寧靜很難得。平時很少有機會放慢腳步，在這裡待著，再加上你的陪伴，感覺所有的煩惱都暫時消失了。",
        "gal_map_text_207100678=真的很清新，和草藥茶的味道很搭。你平時是不是也喜歡這種安靜的環境？",
        "gal_map_text_207100679=對呀，我平時有點怕吵，喜歡待在安靜的地方看看書、做點手工。這裡比我想像中還要好，尤其是和你一起，更覺得愜意了。",
        "gal_map_text_207100680=墨茗坐在籐椅，身體靠近你，輕聲道。",
        "gal_map_text_207100681=其實你很有手工天賦，剛才打磨徽章的時候，手穩又有耐心，老師傅都在旁邊誇你呢。這家店下次會推出 ‘定制銀飾’ 體驗，要不要約個時間一起來試試？我想和你一起做一對專屬小飾品。",
        "gal_map_text_207100682=墨茗眼神瞬間亮起來，挺直腰板。",
        "gal_map_text_207100683=好啊！我現在就去查銀飾定制的基礎技巧，提前做功課，到時候爭取做得比這次更好，我們可以比賽誰的手工更精緻。",
        "gal_map_text_207100684=墨茗語氣自信，抬手輕輕拍了拍你的胳膊。",
        "gal_map_text_207100685=必須約！我早就想嘗試銀飾定制了，正好有人一起搭伴。下次我來選款式，保證選一個既好看又有意義的，到時候我們一起設計專屬圖案。",
        "gal_map_text_207100686=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100687=真的可以嗎？我對銀飾定制一點都不瞭解，到時候你可一定要多指導我，別讓我搞砸了，我相信你的眼光。",
        "gal_map_text_207100688=墨茗語氣帶著點依賴，身體微微向你靠近。",
        "gal_map_text_207100689=哇！真的能一起做專屬飾品嗎？我手有點笨，怕做不好，到時候你一定要全程帶著我，一步一步教我，不能讓我一個人摸索呀。",
        "gal_map_text_207100690=你看，這是店鋪預告的銀飾款式，有手鏈、吊墜、戒指，我們可以選一對吊墜，刻上彼此名字的首字母，怎麼樣？",
        "gal_map_text_207100691=好呀好呀！我喜歡這個星星形狀的，刻上首字母肯定很好看。我們什麼時候來？我想早點體驗！",
        "gal_map_text_207100692=墨茗湊過來看你的手機，手指不小心碰到你的手背，臉頰更紅了。",
        "gal_map_text_207100693=夜色有點涼了，你要不要把外套穿上？剛才修復徽章的時候一直低著頭，脖子會不會酸？我幫你按一下，或者我們再坐一會兒歇歇？",
        "gal_map_text_207100694=墨茗語氣輕快，抬手攏了攏衣領。",
        "gal_map_text_207100695=還好啦，不怎麼涼！脖子有一點點酸，不過沒關係，活動一下就好啦。我們再走一走唄，剛才看到附近有一家文創店，去看看有沒有適合徽章的掛繩？",
        "gal_map_text_207100696=墨茗興奮地眨了眨眼，順手穿上外套。",
        "gal_map_text_207100697=哇，你也太細心了吧！脖子確實有點酸，不過不用麻煩你啦，我自己揉一揉就行。剛才師傅說附近有一家手工店，我們去看看有沒有好看的配飾，給徽章裝飾一下？",
        "gal_map_text_207100698=墨茗語氣平和，慢慢穿上外套。",
        "gal_map_text_207100699=謝謝你，確實有點涼。脖子還好，不算太酸，不過還是謝謝你的關心。我們慢慢走，前面有個小廣場，正好可以坐下來歇歇。",
        "gal_map_text_207100700=墨茗微微點頭，語氣淡然，輕輕活動了一下脖子。",
        "gal_map_text_207100701=還好，不冷。你有心了，不過不用按，我自己調整一下就好。能一起走走，感覺也挺好的。",
        "gal_map_text_207100702=好啊，正好我也想給徽章配個掛繩，掛在包上肯定很好看。你喜歡什麼風格的？簡約的還是帶點裝飾的？",
        "gal_map_text_207100703=我喜歡簡約一點的，比如皮質的或者棉繩的，太花哨的反而不好看。你覺得哪種材質更耐用呀？我聽你的建議。",
        "gal_map_text_207100704=墨茗轉頭對你笑，手指輕輕碰了碰你的手腕。",
        "gal_map_text_207100705=剛才修復徽章的時候，我發現我們配合得特別默契，你打磨的時候我清理，你遇到問題我剛好能想到解決辦法。其實手工製作最講究搭檔，要不要以後定期來這裡做手工？每次嘗試一種新物件，慢慢攢成我們的 “手工合集”。",
        "gal_map_text_207100706=墨茗眼神堅定，手指輕輕點了點桌子。",
        "gal_map_text_207100707=好呀！我也覺得我們配合得很默契。以後我們可以輪流選項目，這次你選銀飾，下次我選皮具，一起挑戰不同的手工，積累更多經驗。",
        "gal_map_text_207100708=墨茗語氣自信，抬手拍了拍你的肩膀。",
        "gal_map_text_207100709=必須的！有我這麼厲害的搭檔，肯定能做出很多好看的手工。下次我來選項目，保證選一個既有趣又有難度的，讓我們的 ‘手工合集’ 更有含金量。",
        "gal_map_text_207100710=墨茗眼神軟下來，輕輕拉了拉你的袖口。",
        "gal_map_text_207100711=嗯！有你一起，我就敢嘗試更多手工了。我平時很少做手工，以後選項目就靠你了，你選什麼我就做什麼，相信你的眼光。",
        "gal_map_text_207100712=墨茗語氣帶著依賴，身體微微靠近你。",
        "gal_map_text_207100713=太好啦！我一個人可不敢嘗試這麼多手工。以後全靠你帶節奏，選項目、找技巧都拜託你了，我跟著你一起做就好。",
        "gal_map_text_207100714=我已經在手機上建了“手工待做清單” ，把想嘗試的項目都列上去了。你看看有沒有喜歡的，我們可以優先安排，下次就來做這個皮質鑰匙扣怎麼樣？",
        "gal_map_text_207100715=好呀好呀！皮質鑰匙扣看起來很有意思。我們把喜歡的項目都標出來，一個個完成，以後看到這些手工製品，就能想起我們一起製作的時光。",
        "gal_map_text_207100716=墨茗眼裡滿是期待。",
        "gal_map_text_207100717=說真的，你剛才處理徽章劃痕的時候，手法特別細膩，力度控制得剛剛好，連老師傅都誇你有天賦。而且你遇到問題不慌不忙，還會主動想辦法，這種耐心和冷靜真的很讓人佩服。",
        "gal_map_text_207100718=墨茗點點頭，語氣平和，手指輕輕梳理著髮絲。",
        "gal_map_text_207100719=其實就是跟著老師傅的指導慢慢嘗試，多注意細節就好。你清理徽章縫隙的時候也很認真，沒有留下一點灰塵，我們配合得很默契。",
        "gal_map_text_207100720=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100721=我是按照 “先粗磨再細” 的步驟來的，每個環節都控制好力度和時間。做手工就像解邏輯題，只要找對方法，就能做出好效果。",
        "gal_map_text_207100722=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100723=被你這麼誇，有點不好意思啦。其實我也很緊張，不過有你在旁邊鼓勵我，我就有信心了。能得到你的認可，真的很開心。",
        "gal_map_text_207100724=墨茗臉頰微紅，眼神裡滿是驚喜。",
        "gal_map_text_207100725=哇，連老師傅都誇我了嗎？我平時做事情都有點毛躁，這次能做好，全靠你一直在旁邊提醒我。謝謝你的肯定，我以後會更認真做手工的。",
        "gal_map_text_207100726=不用不好意思，你的努力和天賦都是實實在在的。以後做手工，我們可以互相學習，你教我打磨技巧，我教你清理方法，一起進步。",
        "gal_map_text_207100727=好呀！你一起做手工，不僅能做出好看的東西，還能學到新技巧，真的很有意義。以後我會更認真，不辜負你的認可。",
        "gal_map_text_207100728=墨茗手指碰到你的手指，輕聲說 。",
        "gal_map_text_207100729=天井裡的薄荷香與草藥茶的清香交織，你們坐在籐椅上，聊著手工製作的技巧與未來想嘗試的項目，從銀飾定制到皮具打磨，話題不斷延伸。離開時，你們手裡攥著老師傅贈送的預約小布袋，並肩走回店內，再一同踏入夜色。",
        "gal_map_text_207100730=墨茗的肩膀偶爾輕輕靠在你的胳膊上，輕聲說著對下次手工約會的期待，指尖還殘留著打磨金屬的細微觸感。街邊的路燈映照著兩人的身影，安靜的陪伴與彼此的認可，讓曖昧的氛圍愈發濃厚，好感在溫柔的夜色中穩步升溫。",
        "gal_map_text_207100731=藏在老街巷裡的獨立書店，二樓靠窗區域鋪著柔軟的地毯，擺放著兩張懶人沙發和一張小茶几，茶几上放著一壺溫熱的桂花烏龍和兩個白瓷杯。落地窗外是老街的青瓦屋頂，夜色中點綴著幾盞暖黃的燈籠，店內播放著舒緩的古典鋼琴曲，混合著紙張的油墨香和桂花的清甜，靜謐而治癒，仿佛與世隔絕的小天地。",
        "gal_map_text_207100732=你們剛看完一本旅行畫冊和幾本藝術雜誌，將書籍放回書架後，回到二樓靠窗的懶人沙發區域休息。墨茗蜷在沙發上，懷裡抱著一個柔軟的抱枕，臉上帶著精神被填充後的滿足感，眼神清澈地看著窗外的夜景，偶爾轉頭看向你，眼裡帶著溫柔的笑意。",
        "gal_map_text_207100733=剛才那本冰島旅行畫冊真的太驚豔了，極光的照片看得我都想去實地看看，你說我們以後真的能去冰島看極光嗎？",
        "gal_map_text_207100734=當然可以呀，只要我們提前規劃好路線和時間，總有一天能去的。你剛才說喜歡畫冊裡 ‘藍湖溫泉’ 的描述，我剛好收藏了一篇詳細的攻略，回頭發給你？",
        "gal_map_text_207100735=墨茗接過你遞過來的茶杯，手指感受著杯壁的溫熱，抬頭對你笑時，眼睛亮晶晶的，身體微微向你傾斜，兩人之間的距離拉近了許多，墨茗輕聲說：“和你一起看書、分享喜歡的故事，感覺特別舒服，好像所有的煩惱都能暫時忘記。”",
        "gal_map_text_207100736=漫遊分享誇讚",
        "gal_map_text_207100737=特展同行之約",
        "gal_map_text_207100738=書香同好續讀",
        "gal_map_text_207100739=靜謐書海沉浸",
        "gal_map_text_207100740=花園漫步照料",
        "gal_map_text_207100741=說真的，你剛才分享旅行故事的時候，眼睛裡有光，那種對生活的熱愛和對遠方的嚮往，真的很吸引人。而且你對文字的敏感度很高，總能發現畫冊裡那些細膩的描述，解讀得也很有想法。",
        "gal_map_text_207100742=墨茗點頭，語氣平和，手指輕輕梳理著髮絲。",
        "gal_map_text_207100743=其實就是順著作者的文字聯想而已，你剛才分析藝術雜誌裡 ‘莫内筆觸’ 的思路也很獨特呀。我們分享的觀點剛好互補，聊得很投機。",
        "gal_map_text_207100744=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100745=這是基於對文字意象的拆解和情感共鳴的推導，作者用 ‘極光如絲綢’ 的比喻，本質是想傳遞極光的柔和與絢爛。不過你的感性解讀很有溫度，剛好彌補了我過於理性的局限。",
        "gal_map_text_207100746=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100747=可能是因為這本畫冊真的太動人了，再加上和你一起分享，所以才更有感觸吧。你願意認真聽我說話，還能接住我的話題，這種被認可的感覺特別好。",
        "gal_map_text_207100748=墨茗臉頰微紅，眼神躲閃了一下又看向你。",
        "gal_map_text_207100749=被你這麼誇，有點不好意思啦。其實我平時很少主動和別人分享這些，不過和你在一起，感覺可以放心地說出自己的想法，謝謝你願意聽我說這麼多。",
        "gal_map_text_207100750=不用不好意思呀，你的分享很有意義，讓我對冰島和藝術都有了新的認識。你平時是不是很喜歡收集這類旅行畫冊和藝術雜誌？",
        "gal_map_text_207100751=對呀，我家裡收藏了很多旅行類和藝術類的書籍，沒事的時候就翻一翻，感覺像自己也去了遠方一樣。不過和你一起分享，比自己一個人看更有樂趣。",
        "gal_map_text_207100752=墨茗抿了口自己的桂花烏龍，輕聲說。",
        "gal_map_text_207100753=其實你對藝術和旅行的見解很獨特，我剛好知道市中心美術館下個月有印象派特展，據說有莫内的真跡展出，還有很多小眾旅行攝影師的作品。要不要約個時間一起去看？看完展還可以去旁邊的咖啡館，繼續分享我們喜歡的故事。",
        "gal_map_text_207100754=墨茗手指輕輕點了點茶几，輕聲說。",
        "gal_map_text_207100755=我現在就去查特展的展品清單，提前瞭解每幅作品的創作背景，到時候就能更好地欣賞了。我們可以分工合作，你負責查交通路線，我負責整理展品資料。",
        "gal_map_text_207100756=墨茗語氣自信，抬手輕輕拍了拍你的胳膊。",
        "gal_map_text_207100757=必須約！我早就關注這個特展了，一直想找個志同道合的人一起去。下次我來主導行程，保證規劃得妥妥當當，讓你既能看好展，又能喝到好喝的咖啡。",
        "gal_map_text_207100758=墨茗手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100759=真的可以嗎？我對藝術作品的瞭解不多，到時候你可一定要多給我講講，別讓我看得一頭霧水，我相信你的眼光。",
        "gal_map_text_207100760=墨茗語氣帶著依賴，身體微微向你靠近。",
        "gal_map_text_207100761=哇！真的能去看莫内的真跡嗎？我對藝術一竅不通，到時候你一定要全程帶著我，一步一步給我講解，不能讓我一個人落在後面呀。",
        "gal_map_text_207100762=你看，這是特展的預告，除了莫内的《睡蓮》，還有很多冰島、挪威的旅行攝影作品，正好是你喜歡的類型。我們選週末去吧，時間更充裕。",
        "gal_map_text_207100763=好呀好呀！我太喜歡這幅《極光下的峽灣》了，一定要近距離看看。我們約週六下午怎麼樣？看完展還能一起吃個晚飯。",
        "gal_map_text_207100764=墨茗手指不小心碰到你的手背，臉頰更紅了。",
        "gal_map_text_207100765=我也是，這種不用刻意找話題、就能自然分享彼此喜歡的事物的感覺，真的很難得。這家書店還有很多小眾的旅行書籍和藝術雜誌，要不要記下來，下次一起來慢慢看？順便把今天沒聊完的故事繼續分享。",
        "gal_map_text_207100766=墨茗眼睛亮起來，手指輕輕點了點桌子。",
        "gal_map_text_207100767=好啊！下次我要提前做功課，找出幾本超贊的小眾旅行書，和你一起分享。不過到時候我們可以互相推薦，看看誰選的書更有意思。",
        "gal_map_text_207100768=墨茗語氣自信，抬手輕輕拍了拍你的胳膊。",
        "gal_map_text_207100769=必須記！我已經在想下次要帶哪本私藏的藝術雜誌來了，裡面有很多不為人知的藝術家故事，保證讓你眼前一亮。下次我來主導選書，保證讓你看得過癮。",
        "gal_map_text_207100770=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100771=嗯！有你一起，就算是看枯燥的藝術雜誌，也覺得很有意思。下次你還要像這次一樣，多給我推薦好書，我相信你的品味。",
        "gal_map_text_207100772=墨茗語氣帶著依賴，臉頰微紅。",
        "gal_map_text_207100773=太好啦！我一個人來書店總不知道選什麼書，有你陪著就安心多了。下次全靠你推薦，你選什麼我就看什麼，跟著你准沒錯。",
        "gal_map_text_207100774=你看，已經記下書店名字了，我們把想讀的書都列上去，下次來直接找。你最想先讀哪本？",
        "gal_map_text_207100775=我想先讀《世界盡頭的咖啡館》！剛才在書架上看到了，簡介說得特別吸引人，我們下次一起來讀怎麼樣？",
        "gal_map_text_207100776=墨茗語氣帶著依賴，身體微微向你靠近，臉頰更紅了。",
        "gal_map_text_207100777=這家書店的氛圍真的太治癒了，暖黃的燈光、舒緩的音樂、淡淡的書香，再加上和你一起看書聊天，感覺所有的壓力都消失了。要不要再坐一會兒，多享受一下這份安靜，聊聊我們最喜歡的旅行目的地？",
        "gal_map_text_207100778=墨茗語氣輕快，眼睛亮晶晶的。",
        "gal_map_text_207100779=好呀好呀！我還不想這麼快離開。我最喜歡的旅行目的地是京都，不僅有好吃的和果子，還有很多古建築，我們可以多聊聊各自想去的地方，以後慢慢實現。",
        "gal_map_text_207100780=墨茗興奮地身體微微晃動。",
        "gal_map_text_207100781=贊同！這裡的氛圍太舒服了，想一直待下去。我想去的地方可多了，冰島、挪威、雲南…… 我們一個個聊，說不定還能一起規劃行程，早點把這些地方都打卡一遍！",
        "gal_map_text_207100782=墨茗語氣平和，眼神沉靜地看著窗外。",
        "gal_map_text_207100783=嗯，再坐一會兒也挺好。安靜的環境能讓人更好地交流，我最喜歡的旅行目的地是青海湖，那裡的風景很治癒，和這裡的氛圍很像。",
        "gal_map_text_207100784=墨茗微微點頭，語氣淡然。",
        "gal_map_text_207100785=可以，不急著走。這種放鬆的氛圍很難得，我平時很少有機會這麼靜下心來聊天。我想去的地方不多，古鎮就挺好，節奏慢，能好好感受生活。",
        "gal_map_text_207100786=我最喜歡的旅行目的地是冰島，和你一樣。那裡的極光、黑沙灘、藍湖溫泉，每一個都很吸引人，我們可以把冰島作為第一個共同打卡的地方，慢慢做攻略。",
        "gal_map_text_207100787=太好了！我們居然喜歡同一個地方。們可以把想去的地方都列出來，按優先順序排序，一個個實現。能和你一起規劃旅行，感覺更有動力了，真希望早點出發。",
        "gal_map_text_207100788=墨茗眼裡滿是驚喜。",
        "gal_map_text_207100789=坐了這麼久，要不要活動一下？我看到樓下有個小花園，我們可以去散散步，呼吸點新鮮空氣。你抱著抱枕累不累？我幫你拿著吧。",
        "gal_map_text_207100790=墨茗語氣輕快，把抱枕遞給你。",
        "gal_map_text_207100791=好呀好呀！正好活動一下筋骨。抱著抱枕是有點累，謝謝你啦。我們趕緊去小花園逛逛，看看有沒有好看的花，順便再聊聊剛才沒聊完的旅行話題。",
        "gal_map_text_207100792=墨茗興奮地站起身。",
        "gal_map_text_207100793=哇，還有小花園？太好了！抱著抱枕確實有點沉，謝謝你幫我拿。我們快去吧，說不定還能在小花園裡發現驚喜，拍幾張好看的照片留念。",
        "gal_map_text_207100794=墨茗語氣平和，慢慢站起身。",
        "gal_map_text_207100795=謝謝你，不用了，我自己拿著就好。活動一下也好，坐久了確實有點僵硬。小花園聽起來不錯，我們慢慢走，不用著急。",
        "gal_map_text_207100796=墨茗微微點頭，語氣淡然。",
        "gal_map_text_207100797=好，活動一下也好。謝謝你的關心，抱枕不重，我自己拿著就行。小花園的氛圍應該不錯，正好可以放鬆一下，繼續聊聊我們的行程規劃。",
        "gal_map_text_207100798=小花園就在書店旁邊，不遠。裡面種了很多綠植，還有幾張長椅，我們可以在那裡坐一會兒，吹吹晚風，繼續聊我們的冰島攻略，怎麼樣？",
        "gal_map_text_207100799=好呀！吹吹晚風、聊聊天，感覺很愜意。有你這麼照顧我，真的很安心，不管是逛書店還是散步，都覺得很舒服。",
        "gal_map_text_207100800=墨茗眼裡帶著溫柔的笑意。",
        "gal_map_text_207100801=書店的桂花烏龍香氣與舊書頁的油墨香縈繞不散，你們從冰島旅行聊到印象派特展，從美食雜誌分享到小花園散步，每一次眼神交匯都帶著淡淡的笑意。離開時，墨茗主動牽住你的手腕，腳步放緩，沿著老街的石板路慢慢前行。",
        "gal_map_text_207100802=她偶爾抬頭看向你，眼裡帶著溫柔的光芒，輕聲說“和你在一起真的很安心”。老街的燈籠暖光映在兩人身上，指尖的觸碰與輕聲的交談，讓好感在靜謐的氛圍中不斷發酵，為後續的心意傳遞做好了鋪墊。",
        "gal_map_text_207100803=遊戲店一角的“新品試玩台”被柔和射燈籠罩，兩台顯示器並排放置，配套的白色耳機整齊擺放在桌面。試玩的獨立遊戲畫面是溫暖治癒的童話風格，深色背景中點綴著螢光藍的植物和淡黃色的光球，背景音樂是輕柔的鋼琴旋律，氛圍安靜而專注。",
        "gal_map_text_207100804=墨茗好奇地湊到試玩台旁，看著螢幕上的遊戲介紹，眼睛亮了起來。你們並肩坐下，戴上耳機，進入遊戲介面。遊戲需要兩人配合傳遞光球，照亮黑暗的童話森林，你的角色負責開闢道路，墨茗的角色負責維持光球亮度，一旦配合失誤，光球就會變暗，森林裡的“迷霧怪物”就會靠近。",
        "gal_map_text_207100805=哇，畫面好溫柔！我的角色手裡的光球好像小燈籠，你那邊能看清道路嗎？",
        "gal_map_text_207100806=能看清，不過需要你把光球往左邊遞一點，我這邊有個隱藏通道，只有足夠亮才能打開。你控制光球的手感怎麼樣？",
        "gal_map_text_207100807=遊戲進行到關鍵關卡，你的角色被困在懸崖邊，需要墨茗的光球照亮下方的藤蔓才能攀爬。墨茗的角色小心翼翼地走到懸崖邊緣，手指微微顫抖，生怕光球掉落。“我慢慢遞過去，你一定要接住呀！” 墨茗輕聲說，眼神專注地盯著螢幕，肩膀不自覺地向你靠近，耳機線輕輕纏繞在一起。",
        "gal_map_text_207100808=默契遞球",
        "gal_map_text_207100809=約定手勢",
        "gal_map_text_207100810=聊遊戲細節",
        "gal_map_text_207100811=放心，我盯著呢！你往我角色的左手邊遞，我提前預判位置，一定接住。我們之前玩解謎遊戲的默契，這次肯定也能用得上，相信我！",
        "gal_map_text_207100812=墨茗深吸一口氣，手指穩定地移動滑鼠。",
        "gal_map_text_207100813=好！我相信我們的配合。我數到三就遞過去，一、二、三！接住啦！你快順著藤蔓爬上來，我幫你照亮後面的路。",
        "gal_map_text_207100814=墨茗眼神專注，操作果斷。",
        "gal_map_text_207100815=沒問題，看我的精准傳遞！我已經算好距離了，保證光球剛好落在你手裡，你別拖後腿就行，趕緊爬上來繼續前進。",
        "gal_map_text_207100816=墨茗眼神緊張地看著螢幕。",
        "gal_map_text_207100817=嗯！我相信你。遞過去啦，你接住了嗎？要不要我再調整一下位置？你爬的時候小心點，我一直幫你照亮。",
        "gal_map_text_207100818=墨茗語氣帶著緊張，身體微微向你傾斜。",
        "gal_map_text_207100819=好…… 我有點怕掉下去。遞過去啦，你一定要接住呀！你爬的時候慢一點，我跟著你移動光球，不會讓你陷入黑暗的。",
        "gal_map_text_207100820=完美配合！你遞光球的時機剛剛好，再晚一點我就被迷霧困住了。前面好像有個寶箱，需要我們一起點亮周圍的螢光植物才能打開。",
        "gal_map_text_207100821=太好了！我就知道我們能行。你往左邊走，我往右邊，我們同時點亮兩邊的植物，應該就能觸發寶箱了。",
        "gal_map_text_207100822=墨茗操控角色跟上你的步伐，眼裡帶著笑意。",
        "gal_map_text_207100823=其實我們可以換種配合方式！你專注維持光球亮度，我開闢道路時提前給你手勢信號，這樣同步率更高，說不定能觸發隱藏互動。",
        "gal_map_text_207100824=墨茗挺直腰板，眼神堅定。",
        "gal_map_text_207100825=這個主意好！我專注力超棒，肯定能精准配合你的信號。我們現在就試試，你先給個簡單手勢，我馬上調整光球角度。",
        "gal_map_text_207100826=墨茗語氣自信，抬手比出簡單手勢。",
        "gal_map_text_207100827=沒問題，信號要簡潔明瞭，別太複雜。我先適應一下節奏，等下換我主導信號，保證效率翻倍。",
        "gal_map_text_207100828=墨茗眼神軟下來，輕輕拉了拉你的袖口。",
        "gal_map_text_207100829=聽起來有點難，但有你指導應該沒問題。你信號給慢一點，我反應有點慢，別嫌我拖後腿呀。",
        "gal_map_text_207100830=墨茗語氣帶著依賴，身體微微靠近你。",
        "gal_map_text_207100831=哇，還能這樣配合！我完全聽你指揮，你怎麼說我就怎麼做，一定好好配合。",
        "gal_map_text_207100832=就這麼定！我比“向上”手勢你就抬高光球，比“向左”你就移動方向，我們先試三次適應節奏。",
        "gal_map_text_207100833=好！我記住了。第一次配合就這麼順利，太有成就感了，我們繼續保持這個節奏！",
        "gal_map_text_207100834=墨茗專注看著你的手勢，快速調整光球。",
        "gal_map_text_207100835=你有沒有發現，這個遊戲的光球傳遞手感很特別？不像其他遊戲那樣僵硬，反而有種“溫柔傳遞”的感覺。而且背景音樂的節奏，和我們傳遞光球的頻率剛好契合，製作人應該很懂‘配合’的精髓吧？",
        "gal_map_text_207100836=墨茗點點頭，語氣平和。",
        "gal_map_text_207100837=我也發現了！光球的慣性設置很真實，傳遞時需要提前預判，而且背景音樂的鋼琴旋律，每小節的重音剛好對應光球的亮度變化。製作人確實很用心，把‘配合’的細節做得很到位。",
        "gal_map_text_207100838=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100839=這是典型的“沉浸式互動設計”，通過操作手感、音效、畫面的三重呼應，強化玩家的配合感。光球的亮度衰減曲線和背景音樂的音量變化完全同步，是刻意設計的心理學暗示。",
        "gal_map_text_207100840=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100841=對呀！我剛才遞光球的時候，感覺像是真的在把溫暖傳遞給你。尤其是光球照亮你角色的時候，背景音樂剛好響起高音，感覺心裡都暖暖的，特別有共鳴。",
        "gal_map_text_207100842=墨茗臉頰微紅，眼神專注地看著你。",
        "gal_map_text_207100843=我也有這種感覺！傳遞光球的時候，好像我們的心意也跟著傳遞過去了。背景音樂輕輕的，畫面又很溫柔，讓我覺得和你之間的距離更近了。",
        "gal_map_text_207100844=沒想到你也注意到這些細節了，我還以為只有我一個人覺得特別。你平時玩遊戲，也會關注這些設計嗎？",
        "gal_map_text_207100845=會呀，我覺得細節才是最打動人的。這個遊戲讓我覺得，‘配合’不只是操作上的同步，更是心意上的呼應。就像我們剛才那樣，不用多說就能明白對方的想法。",
        "gal_map_text_207100846=墨茗抬頭對你笑。",
        "gal_map_text_207100847=你們成功解鎖遊戲隱藏結局，彼此眼裡都帶著未褪去的興奮與默契。墨茗指尖不經意觸碰到你的手腕，停留兩秒才收回，臉頰微紅地說著對遊戲設計的共鳴。試玩台旁的射燈映在她臉上，溫柔的光暈讓她的眼神更顯柔軟。你們並肩起身，她主動幫你整理了被耳機線纏繞的袖口，輕聲提議下次還要嘗試更多雙人新遊，語氣裡滿是藏不住的期待，好感度在深度互動中達到頂峰，距離告白只剩一步之遙。",
        "gal_map_text_207100848=遊戲店深處的“玩家攻略牆”被彩色射燈照亮，牆上貼滿了各種顏色的便利貼，有的寫著遊戲攻略，有的畫著可愛的塗鴉，還有的留著簡短的留言。便利貼之間偶爾夾雜著玩家們的合影和小貼紙，氛圍活潑而溫暖。牆旁的桌子上放著空白便利貼、彩色馬克筆和固體膠，方便玩家留下自己的“通關指南”。",
        "gal_map_text_207100849=墨茗被這面色彩斑斕的牆吸引，湊過去仔細看著，時不時發出輕笑。墨茗拿起一張寫著“跳關秘笈：在第三關開始時原地轉三圈”的便利貼，笑著說：“這個也太搞笑了，真的有人會試嗎？” 看了一會兒，墨茗從桌子上拿過兩張空白便利貼和一支粉色馬克筆，遞給你一張，眼睛彎成月牙：“我們也來留個‘通關指南’怎麼樣？就寫今晚的‘通關之路’。”",
        "gal_map_text_207100850=我想寫點和我們今晚玩的遊戲有關的，你覺得寫什麼好？是寫解謎遊戲的攻略，還是寫剛才試玩遊戲的心得？",
        "gal_map_text_207100851=不如寫點專屬我們的“通關密碼”？比如‘和墨茗一起玩，所有關卡都能通關’，或者畫個我們遊戲角色的小塗鴉，以後再來的時候就能看到了。",
        "gal_map_text_207100852=墨茗低頭思考著，筆尖在便利貼上輕輕點著，畫出一個個小小的圓點。墨茗的肩膀離你很近，頭髮上的清香飄進你的鼻腔。“我想到了！” 墨茗眼睛一亮，開始在便利貼上寫字，寫完後又畫了一個小小的光球圖案。墨茗寫完後沒有立刻貼上去，而是轉頭看向你，眼神裡帶著期待：“你寫好了嗎？我們一起貼上去吧，貼在同一個位置。”",
        "gal_map_text_207100853=共貼便簽",
        "gal_map_text_207100854=幫貼便簽",
        "gal_map_text_207100855=說心意",
        "gal_map_text_207100856=一起合照",
        "gal_map_text_207100857=我寫的是專屬通關約定：下次一起解鎖所有雙人遊戲隱藏結局’，旁邊畫了兩個牽手的遊戲角色。我們把便利貼貼在一起，就像這個約定一樣，以後每次來都兌現一個小目標。",
        "gal_map_text_207100858=墨茗眼睛亮起來，舉起自己的便利貼。",
        "gal_map_text_207100859=好呀！這個約定太有意義了。我寫的是搭檔認證：和男主一起，通關無壓力，我們趕緊貼在最顯眼的位置，以後來打卡。",
        "gal_map_text_207100860=墨茗語氣自信，拉著你的手走向攻略牆。",
        "gal_map_text_207100861=沒問題！約定好的事可不能反悔。下次來我們先檢查約定，再玩新遊戲，保證每次都有新進展。",
        "gal_map_text_207100862=墨茗眼神軟下來，輕輕拉了拉你的袖口。",
        "gal_map_text_207100863=你寫得真好，我都沒想到這麼有儀式感。貼的時候你幫我扶一下，我怕貼歪了，以後不好找。",
        "gal_map_text_207100864=墨茗語氣帶著溫柔，身體微微向你靠近。",
        "gal_map_text_207100865=哇，還有專屬約定！我會一直記得這個約定，下次來的時候提醒你，我們一定要說到做到。",
        "gal_map_text_207100866=就貼在這裡吧，正好在粉色便利貼區域，和你的馬克筆顏色很配。我們拍張照存下來，下次來對比進度。",
        "gal_map_text_207100867=好呀！以後看到這張便利貼，就能想起我們的約定，太有紀念意義了。",
        "gal_map_text_207100868=墨茗用固體膠把便利貼貼在牆上，手指輕輕按壓。",
        "gal_map_text_207100869=我寫好了！我們把便利貼貼在一起吧，就貼在那片粉色便利貼旁邊，這樣以後找起來也方便。",
        "gal_map_text_207100870=墨茗眼睛亮起來，舉起自己的便利貼。",
        "gal_map_text_207100871=哇，你寫得好甜！我寫的是‘光球傳遞的不只是光亮，還有心意’，旁邊畫的是我們剛才試玩遊戲裡的光球。我們趕緊貼上去，讓它成為攻略牆的一部分！",
        "gal_map_text_207100872=墨茗興奮地拉著你的手走向攻略牆。",
        "gal_map_text_207100873=可以呀！我要把我們的便利貼貼在最顯眼的位置，讓所有玩家都能看到。以後我們再來，就帶著朋友來炫耀，說“看，這是我們留的攻略”！",
        "gal_map_text_207100874=墨茗眼神軟下來，輕輕拉了拉你的袖口。",
        "gal_map_text_207100875=你寫得真好。我們貼在那個小熊塗鴉旁邊吧，我覺得很可愛。貼的時候你幫我扶一下，我怕貼歪了。",
        "gal_map_text_207100876=墨茗語氣帶著溫柔，身體微微向你靠近。",
        "gal_map_text_207100877=哇，你寫的這句話好暖心。我們貼在一起，這樣它們就不會孤單了。你幫我選個位置，我相信你的眼光，貼在哪裡都好看。",
        "gal_map_text_207100878=貼在這裡吧，正好在小熊塗鴉的上方，很顯眼。我們的便利貼靠得近一點，就像我們現在這樣。",
        "gal_map_text_207100879=好呀！這樣以後再來，我們就能一眼看到了。說不定以後還有其他玩家看到，會好奇我們的“通關秘訣”呢。",
        "gal_map_text_207100880=墨茗用固體膠把便利貼貼在牆上，手指輕輕按壓。",
        "gal_map_text_207100881=我寫的是今晚的通關目標：“讓墨茗開心”。其實對我來說，今晚最開心的不是玩遊戲，而是和你一起體驗這些有趣的事。這張便利貼就像我們的“心意憑證”，貼在牆上，記錄下今晚的快樂。",
        "gal_map_text_207100882=墨茗臉頰微紅，抬手輕輕拍了拍你的胳膊。",
        "gal_map_text_207100883=你這麼說，我有點不好意思啦。其實我也很開心，和你一起玩遊戲、留攻略，都是很特別的體驗。我寫的是‘和你一起，每天都像通關一樣快樂’，希望我們以後能有更多這樣的時光。",
        "gal_map_text_207100884=墨茗語氣自信，嘴角帶著笑意。",
        "gal_map_text_207100885=算你有眼光！能讓我開心的人可不多，你算是一個。我寫的是攻略牆認證：你是最佳遊戲搭檔。以後你就是我的專屬隊友了，不許反悔。",
        "gal_map_text_207100886=墨茗眼神軟下來，手指輕輕拉了拉你的袖口。",
        "gal_map_text_207100887=你這麼說，我真的很感動。其實我今晚也超級開心，有你陪著我，做什麼都覺得很有意義。我寫的是‘有你的地方，就是通關終點’，希望我們以後能一直這樣。",
        "gal_map_text_207100888=墨茗語氣帶著溫柔，身體微微向你靠近。",
        "gal_map_text_207100889=哇，你這麼暖心，我都要哭了。我今晚真的太開心了，從來沒有這麼投入地玩過遊戲、留過言。我寫的是‘我會一直跟著你，一起通關所有人生關卡’，你可不能丟下我。",
        "gal_map_text_207100890=傻瓜，我怎麼會丟下你呢。以後不管是遊戲關卡，還是生活中的“關卡”，我都會陪著你一起面對。我們的便利貼貼在一起，就像我們的心意永遠在一起。",
        "gal_map_text_207100891=嗯！我相信你。以後我們每個月都來一次這裡，看看我們的便利貼，再留一張新的，記錄我們的“通關之路”。",
        "gal_map_text_207100892=墨茗抬頭對你笑，眼裡帶著淚光。",
        "gal_map_text_207100893=我們把今晚的回憶定格在這裡吧！我拍一張我們和便利貼的合照，再拍一張遊戲角色塗鴉，以後看到照片就能想起今晚的快樂時光。",
        "gal_map_text_207100894=墨茗興奮地站在便利貼旁，比出剪刀手。",
        "gal_map_text_207100895=好呀好呀！我要和我們的留言拍好多張，存到專屬相冊裡，以後想起來就翻看。",
        "gal_map_text_207100896=墨茗拉著你的手湊近便利貼，對著鏡頭比心。",
        "gal_map_text_207100897=太有心了。我們拍一張親密一點的，以後翻看相冊的時候，就能想起今晚的甜蜜時光。",
        "gal_map_text_207100898=墨茗語氣平和，站在你身邊，自然微笑。",
        "gal_map_text_207100899=這個主意不錯。拍張合照留作紀念，以後看到就能想起這份輕鬆的氛圍。",
        "gal_map_text_207100900=墨茗微微點頭，語氣淡然，眼神柔和。",
        "gal_map_text_207100901=可以，挺有意義的。照片能留住當下的心情，以後翻看也是一種回憶。",
        "gal_map_text_207100902=你站近一點，我們一起看著便利貼笑，這樣拍出來更自然。你看，照片裡的你笑得真好看，和便利貼的粉色很配。",
        "gal_map_text_207100903=哇，拍得真不錯！我們把照片發給我一份，我要和今晚的遊戲截圖放在一起，做個“通關回憶冊”。",
        "gal_map_text_207100904=墨茗湊過來看，臉頰微紅。",
        "gal_map_text_207100905=你們貼好便利貼、拍完合照，墨茗把照片小心翼翼存進專屬相冊，還特意命名為“通關約定第一站”。離開攻略牆時，她主動挽住你的胳膊，語氣裡帶著對下次約會的期許，偶爾分享著牆上其他玩家的搞笑留言。遊戲店的暖光透過玻璃窗灑在兩人身上，影子在地面緊緊相依，溫柔的互動與專屬約定讓好感穩步升溫，為後續心意傳遞做好了鋪墊。",
        "gal_map_text_207100906=舊物修復店的核心區域，暖黃的檯燈將滿牆懸掛的修復工具 —— 各種型號的鉗子、鑷子、銼刀、小巧的錘子 —— 投射出長長的、交錯的影子，像一幅沉默的機械森林壁畫。工具表面泛著金屬的冷光，卻在暖光的映襯下顯得格外溫柔。地面鋪著深色木質地板，腳步聲被吸收，氛圍安靜而專注。",
        "gal_map_text_207100907=短暫休息後，你們回到店內，老師傅已經去里間忙了。店內只剩下你們兩人，墨茗站在工具牆前，手指虛虛拂過那些冰冷而精密的金屬輪廓，眼神溫柔而專注。墨茗轉過身，背靠著工具牆，面對著站在不遠處的你。燈光從墨茗側後方打來，勾勒出墨茗的身形，而那些工具的影子仿佛成了墨茗背景裡奇異又貼合的翅膀。",
        "gal_map_text_207100908=每一樣工具，都是為了修復某個特定的“問題”而存在的…… 感覺好專注，又好溫柔。就像…… 就像有人專門為了解決你的“不完美”而來。",
        "gal_map_text_207100909=我覺得更像是‘陪伴’。工具不會說話，但能陪著修復師一點點把破損的東西變好。就像我們現在這樣，不用多說，只要待在一起，就覺得很安心。你有沒有特別想試試的工具？",
        "gal_map_text_207100910=你從牆上取下那把小巧的銼刀，遞到墨茗手裡。墨茗的手指碰到冰冷的金屬刀柄，微微一頓，然後握緊了它。墨茗學著師傅的樣子，輕輕比劃著打磨的動作，眼神專注而認真。燈光映在墨茗的臉上，工具牆的影子在墨茗身後輕輕晃動，氛圍溫柔而曖昧。“好像…… 有點難掌握力度。” 墨茗輕聲說，抬頭看向你，眼裡帶著一絲求助的意味。",
        "gal_map_text_207100911=牽手教打磨",
        "gal_map_text_207100912=一起做情侶鑰匙扣",
        "gal_map_text_207100913=聊工具",
        "gal_map_text_207100914=我們配合著來！你扶著邊角料，我握著你的手控制銼刀，順著紋理慢慢打磨，這樣既穩又不會出錯。",
        "gal_map_text_207100915=墨茗眼神堅定，雙手輕輕扶住邊角料。",
        "gal_map_text_207100916=好！我扶穩了，你放心教我。我會跟著你的節奏，絕對不會亂動，我們一起把它打磨光滑。",
        "gal_map_text_207100917=墨茗語氣自信，身體微微靠近你。",
        "gal_map_text_207100918=沒問題，我學習能力很強。你先示範一次，我記住力度和角度，下次就能自己操作了。",
        "gal_map_text_207100919=墨茗眼神軟下來，輕輕拉了拉你的袖口。",
        "gal_map_text_207100920=嗯！有你陪著我就放心了。我有點怕劃傷手，你一定要握緊我的手，別讓我出錯呀。",
        "gal_map_text_207100921=墨茗手心微微出汗，緊緊握住銼刀。",
        "gal_map_text_207100922=好…… 我有點緊張。有你在身邊指導，我就覺得有安全感多了，你慢慢教我。",
        "gal_map_text_207100923=對，就是這樣，力度輕一點，順著木紋走。你感受一下這個節奏，多試幾次就熟練了。",
        "gal_map_text_207100924=嗯！我好像找到感覺了。和你一起配合，感覺一點都不難，反而很有意思。",
        "gal_map_text_207100925=墨茗專注地看著打磨的地方，手指偶爾碰到你的手。",
        "gal_map_text_207100926=我來教你！打磨的時候，要順著金屬的紋理，力度要輕，像撫摸一樣。你感受一下，這樣慢慢移動，就能把邊角磨光滑了。我們可以試著打磨一小塊邊角料，做個小小的鑰匙扣怎麼樣？",
        "gal_map_text_207100927=墨茗深吸一口氣，跟著你的動作慢慢移動銼刀。",
        "gal_map_text_207100928=好！我試試。感覺有點意思！原來力度這麼重要，輕一點就不會磨出劃痕。我們做個星星形狀的鑰匙扣吧，我來畫草圖，你幫我打磨。",
        "gal_map_text_207100929=墨茗眼神專注，跟著你的動作調整力度。",
        "gal_map_text_207100930=沒問題，看我的！我很快就能學會，等會兒我自己打磨，你在旁邊看著就行。我們做一對鑰匙扣，一個刻上“修”修，一個刻上“補”，象徵“互補”。",
        "gal_map_text_207100931=墨茗身體微微向你靠近，語氣帶著依賴。",
        "gal_map_text_207100932=嗯！有你教我，我就放心多了。你的手好穩，跟著你移動，我就不怕出錯了。我們做個簡單的圓形鑰匙扣吧，我怕複雜的形狀會搞砸。",
        "gal_map_text_207100933=墨茗手心微微出汗，緊緊握住銼刀。",
        "gal_map_text_207100934=好…… 我有點緊張。有你握著我的手，我就覺得有安全感多了。你慢慢教我，我會認真學的，我們一起做個好看的鑰匙扣。",
        "gal_map_text_207100935=對，就是這樣，力度再輕一點，順著紋理走。你看，這塊邊角料的邊緣已經變光滑了，再打磨一會兒，就能做鑰匙扣的雛形了。你想在上面刻點什麼圖案嗎？",
        "gal_map_text_207100936=我想刻個小小的齒輪圖案，剛才看到師傅那裡有齒輪配件，覺得很特別。就像我們現在這樣，互相配合，才能“運轉”得更好。",
        "gal_map_text_207100937=墨茗臉頰微紅，輕聲說。",
        "gal_map_text_207100938=你有沒有發現，這些工具雖然冰冷，但每一件都有自己的“使命”？比如這把小銼刀，專門用來打磨細小的邊角；那把鑷子，能精准夾起微小的零件，就像我們剛才配合修復徽章一樣，各有分工又互相成就。",
        "gal_map_text_207100939=墨茗點點頭，眼神認真。",
        "gal_map_text_207100940=你說得很有道理。工具的設計都很有針對性，就像我們做手工一樣，需要精准和配合，才能做出好的成品。",
        "gal_map_text_207100941=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207100942=這是典型的“功能適配設計”，每款工具的形狀、大小都對應特定的修復需求。就像我們剛才修復徽章，銼刀負責打磨，棉簽負責清理，分工明確才能提高效率。",
        "gal_map_text_207100943=墨茗嘴角帶著溫柔的笑意，眼神柔和。",
        "gal_map_text_207100944=對呀！我剛才握著銼刀的時候，就覺得它好像在幫我完成“讓徽章變完美”的心願。這種互相配合的感覺，就像我們現在這樣，雖然分工不同，但目標一致，很有成就感",
        "gal_map_text_207100945=墨茗臉頰微紅，眼神專注地看著你。",
        "gal_map_text_207100946=我也有這種感覺！每一件工具都在默默付出，就像你一直在旁邊幫我、指導我一樣，讓人覺得很溫暖。",
        "gal_map_text_207100947=其實做手工和相處是一樣的，都需要“精准”和“配合”，不能太用力，也不能太敷衍。你剛才打磨徽章的時候，力度就掌握得很好，既耐心又認真。",
        "gal_map_text_207100948=謝謝你的認可。其實我也是跟著你的節奏來的，有你在旁邊提醒我，我才不會出錯。和你一起做手工，真的很安心。",
        "gal_map_text_207100949=墨茗臉頰微紅，眼神專注地看著你。",
        "gal_map_text_207100950=你們要麼默契配合打磨完邊角料，要麼敲定了情侶鑰匙扣的設計，要麼聊透了工具背後的陪伴意義。墨茗的肩膀輕輕靠在你的胳膊上，呼吸溫熱地拂過你的手腕，眼神裡滿是認可與依賴。她主動把銼刀掛回牆上時，指尖不經意觸碰到你的手指，停留片刻才收回，輕聲說“和你一起做手工真的很安心”。暖黃的燈光將兩人的影子疊在工具牆上，曖昧的氛圍愈發濃厚，好感度在深度共鳴中快速升溫，即將觸及告白臨界點。",
        "gal_map_text_207100951=時光修補鋪的角落，堆放著各種等待被使用的修補材料：不同顏色和質地的皮革邊角料、各種木料的小方塊、五顏六色的縫線、還有一小盒一小盒的復古紐扣和五金件。材料架旁有一張小小的工作臺，上面放著剪刀、膠水、尺子等基礎工具，暖黃的燈光照亮了這些“故事的素材”，氛圍溫馨而有創造力。",
        "gal_map_text_207100952=墨茗蹲在材料架前，拿起一塊深棕色的植鞣革摸了摸，又撿起一塊有著漂亮木紋的櫻桃木。“這些…… 就像故事的‘素材’一樣。破損的地方需要找到合適的‘補丁’。” 墨茗挑出一小塊溫潤的鹿皮和一枚簡潔的銅扣，在手裡比劃了一下，然後站起身，轉向你，眼裡帶著點靈光一現的雀躍。",
        "gal_map_text_207100953=你看，這塊鹿皮很柔軟，這個銅扣很簡潔，它們搭配在一起，是不是很適合做一個小小的鑰匙扣？剛才在工具牆前，我們不是說要做鑰匙扣嗎？用這些材料，應該能做出獨一無二的款式。",
        "gal_map_text_207100954=確實很合適！鹿皮柔軟，銅扣復古，搭配起來很有質感。我們可以用剪刀把鹿皮剪成喜歡的形狀，然後用縫線把銅扣固定在上面，再用銼刀打磨一下邊緣，一個專屬鑰匙扣就做好了。你想剪什麼形狀？",
        "gal_map_text_207100955=你拿出尺子和筆，在鹿皮上輕輕畫出“補丁”的形狀，墨茗蹲在旁邊，認真地看著你的動作。墨茗的頭髮垂下來，拂過工作臺，你下意識地幫墨茗理了理，手指不經意間觸碰到墨茗的臉頰，兩人同時頓了頓。“對不起，” 你輕聲說，墨茗的臉頰微紅，搖搖頭說 “沒關係”，眼神卻更加溫柔了。你們一起拿著剪刀，準備裁剪鹿皮，氛圍曖昧而有創造力。",
        "gal_map_text_207100956=做情侶鑰匙扣",
        "gal_map_text_207100957=扶料指導",
        "gal_map_text_207100958=說選料用心",
        "gal_map_text_207100959=拍製作過程",
        "gal_map_text_207100960=“補丁”形狀很有意義！我們可以做一對鑰匙扣，一個用鹿皮，一個用櫻桃木，都配上同款銅扣。鹿皮代表溫柔，櫻桃木代表堅定，就像我們的性格互補。以後你用鹿皮的，我用櫻桃木的，作為我們的“專屬信物”。",
        "gal_map_text_207100961=墨茗眼睛亮起來，拿起櫻桃木比劃著。",
        "gal_map_text_207100962=好呀！我來裁剪櫻桃木，你裁剪鹿皮，我們分工合作。等做好了，我們再在上面刻上彼此的名字首字母，這樣就更專屬了。",
        "gal_map_text_207100963=墨茗語氣自信，拿起剪刀開始裁剪櫻桃木。",
        "gal_map_text_207100964=沒問題！我裁剪的技術很好，保證和你的鹿皮鑰匙扣形狀一模一樣。以後我們出門都帶著，讓別人知道我們是“最佳搭檔”。",
        "gal_map_text_207100965=墨茗眼神軟下來，輕輕拉了拉你的袖口。",
        "gal_map_text_207100966=嗯！這個主意太好了。我裁剪鹿皮的時候可能會有點手抖，你幫我看著點，別讓我剪歪了。刻名字首字母的時候，你也幫我刻，我相信你能刻得很好。",
        "gal_map_text_207100967=墨茗語氣帶著依賴，身體微微向你靠近。",
        "gal_map_text_207100968=做一對專屬鑰匙扣，感覺好幸福。我來幫你遞工具，你負責裁剪和刻字，我相信你能做出最好看的鑰匙扣。",
        "gal_map_text_207100969=我選了淡棕色的絲線，和鹿皮顏色很配，繡在裡面不會顯眼，只有我們自己知道。你看，我已經穿好線了，現在開始繡“時光相伴”，每一針都代表我對你的心意。",
        "gal_map_text_207100970=哇，你居然會繡字！我來幫你扶著鹿皮，你慢慢繡，別紮到手。等你繡完，我來刻櫻桃木上的字，雖然我刻得不好，但一定很認真。",
        "gal_map_text_207100971=墨茗湊過來看你繡字，頭髮垂下來拂過你的手背，輕聲說。",
        "gal_map_text_207100972=小心剪刀，別剪到手指。鹿皮比較軟，裁剪的時候慢慢用力，我幫你扶著邊緣，這樣更穩。",
        "gal_map_text_207100973=墨茗語氣輕快，手裡的剪刀慢慢移動。",
        "gal_map_text_207100974=知道啦，謝謝你關心！有你幫我扶著，我就放心多了，我們趕緊裁剪好，早點開始下一步製作。",
        "gal_map_text_207100975=墨茗興奮地眨了眨眼，嘴角帶著笑意。",
        "gal_map_text_207100976=哇，你也太細心了吧！我會小心的，你放心。等做好鑰匙扣，我們再做個小掛繩，搭配起來肯定更好看。",
        "gal_map_text_207100977=墨茗語氣平和，眼神沉靜地看著鹿皮。",
        "gal_map_text_207100978=謝謝你，我會注意的。慢慢裁剪才能保證形狀好看，我們不用著急，慢慢做。",
        "gal_map_text_207100979=墨茗微微點頭，語氣淡然。",
        "gal_map_text_207100980=嗯，謝謝你的提醒。有你在旁邊看著，我就更安心了，我們一步一步來，保證成品好看。",
        "gal_map_text_207100981=對，就是這樣，沿著線條慢慢剪，別著急。剪完我們用砂紙打磨一下邊緣，讓它更光滑。",
        "gal_map_text_207100982=好！有你在旁邊幫忙，感覺製作過程都順利多了，和你一起做手工真的很開心。",
        "gal_map_text_207100983=墨茗注地裁剪著，手指偶爾碰到你的手。",
        "gal_map_text_207100984=其實我早就想和你一起做一對專屬物件了。這塊鹿皮是我剛才特意挑選的，顏色和你的氣質很配，銅扣也是復古款，希望你能喜歡。以後看到這個鑰匙扣，就能想起我們一起做手工的時光。",
        "gal_map_text_207100985=墨茗臉頰微紅，抬手輕輕拍了拍你的胳膊。",
        "gal_map_text_207100986=你這麼說，我有點不好意思啦。其實我也很喜歡這些材料，和你一起做專屬鑰匙扣，感覺很有意義。我會好好珍藏的。",
        "gal_map_text_207100987=墨茗語氣自信，嘴角帶著笑意。",
        "gal_map_text_207100988=算你有眼光！這個款式我很喜歡，以後出門都會帶著，向別人炫耀我的專屬鑰匙扣。",
        "gal_map_text_207100989=墨茗眼神軟下來，輕輕拉了拉你的袖口。",
        "gal_map_text_207100990=你這麼用心，我真的很感動。我從來沒有收到過別人親手做的禮物，這個鑰匙扣對我來說很珍貴，我會一直帶著。",
        "gal_map_text_207100991=墨茗語氣帶著溫柔，身體微微向你靠近。",
        "gal_map_text_207100992=哇，你居然特意為我挑選材料！我太喜歡了，以後不管去哪裡，都會帶著這個鑰匙扣，就像你在我身邊一樣。",
        "gal_map_text_207100993=只要你喜歡就好。我們在鑰匙扣上刻上彼此的名字首字母，這樣就更專屬了，只有我們知道它的意義。",
        "gal_map_text_207100994=好呀！刻完後我們再用蜂蠟保養一下，讓它更耐用，能陪伴我們更久。",
        "gal_map_text_207100995=墨茗眼裡滿是期待，輕聲說。",
        "gal_map_text_207100996=我們拍張照片記錄一下吧！拍下我們一起製作鑰匙扣的過程，再拍一張材料和工具的合照，以後看到照片就能想起今天的時光。",
        "gal_map_text_207100997=墨茗興奮地舉起手裡的鹿皮，對著鏡頭笑。",
        "gal_map_text_207100998=好呀好呀！我們多拍幾張，存到專屬相冊裡，以後想起來就翻看。",
        "gal_map_text_207100999=墨茗拉著你的手湊近工作臺，對著鏡頭比耶。",
        "gal_map_text_207101000=太有心了！我們拍一張親密一點的，再拍一張製作過程的特寫，做成一個小視頻紀念。",
        "gal_map_text_207101001=墨茗語氣平和，自然地站在你身邊。",
        "gal_map_text_207101002=可以，拍張照留作紀念挺好的。記錄下這個過程，以後看到就能想起這份安靜的時光。",
        "gal_map_text_207101003=墨茗微微點頭，語氣淡然。",
        "gal_map_text_207101004=嗯，挺有意義的。照片能留住當下的心情，以後翻看也是一種回憶。",
        "gal_map_text_207101005=你拿著鹿皮，我拿著剪刀，我們對著鏡頭笑一笑。拍好了！你看，照片裡的我們都很認真，氛圍真好。",
        "gal_map_text_207101006=哇，拍得真不錯！我要把照片發給我一份，再配一段文字，記錄下今天的手工時光。",
        "gal_map_text_207101007=墨茗湊過來看手機，臉頰微紅。",
        "gal_map_text_207101008=你們要麼做好鑰匙扣雛形、繡好隱藏心意，要麼整理完工具、拍好製作過程照片。墨茗把鑰匙扣小心放進包裡，時不時拿出來翻看，嘴角帶著滿足的笑意。離開材料架時，她主動牽住你的手，手心的溫度傳遞著濃濃的羈絆，輕聲說著下次想嘗試的手工項目。時光修補鋪的木蠟油香氣縈繞不散，平淡卻溫暖的互動讓好感慢慢沉澱，為後續的心意表達埋下伏筆。",
        "gal_map_text_207101009=書店更深處的隱蔽角落，被暖黃落地燈籠罩。一張復古木質小書桌靠牆擺放，桌上放著一台墨藍色老式打字機、幾本空白筆記本和插著鉛筆的陶瓷筆筒。牆面貼滿讀者留言和塗鴉，有簡短的詩句、旅行感悟，還有可愛的小人畫，氛圍靜謐而富有詩意。桌旁小牌子寫著“靈感暫駐處 —— 留下你的故事”，空氣中混合著紙張油墨香和淡淡的木質香氣。",
        "gal_map_text_207101010=休息片刻後，墨茗拉著你悄悄走向這個隱蔽角落，手指輕輕按住嘴唇做“噓”的動作。墨茗蹲在書桌前，看著打字機眼裡閃著光，拿起一支鉛筆在空白紙上輕輕畫了兩個小人並肩坐在飛機窗邊的側影。畫完後，墨茗放下筆，沒有署名，轉頭看你時，笑容裡帶著做了件小壞事的甜蜜。",
        "gal_map_text_207101011=這裡好像秘密基地，能偷偷寫下只屬於我們的故事。你看我畫的，像不像我們以後去冰島看極光時的樣子？坐在飛機上，一起期待遠方的風景。",
        "gal_map_text_207101012=太像了！你畫的小人連神態都很傳神，尤其是你眼裡的期待，和現在一模一樣。我們可以在這裡寫一段‘旅行序言’，記錄下今晚的相遇和對未來的期待，怎麼樣？",
        "gal_map_text_207101013=你坐在書桌前，打開打字機的蓋子，手指輕輕敲擊鍵盤，發出清脆的“嗒嗒”聲。墨茗湊在你身邊，肩膀幾乎貼著你的肩膀，好奇地看著按鍵。“這個按鍵好像有點重，” 墨茗輕聲說，伸手想觸碰按鍵，卻不小心碰到你的手指。兩人同時頓了頓，墨茗的臉頰微紅，收回手時輕聲說“對不起”，眼神卻更加溫柔。落地燈的光映在畫紙上，兩人的影子在牆上交疊，氛圍曖昧而富有詩意。",
        "gal_map_text_207101014=牽手教打字",
        "gal_map_text_207101015=定專屬暗號",
        "gal_map_text_207101016=聊留言細節",
        "gal_map_text_207101017=我教你！打字的時候要稍微用力一點，跟著節奏來，“嗒嗒”的聲音就像音樂一樣。我們分工合作，你負責打“故事開頭”，我負責在旁邊用鉛筆補充細節，比如在文字旁邊畫極光、飛機，讓故事更生動。",
        "gal_map_text_207101018=墨茗深吸一口氣，跟著你的節奏敲擊按鍵。",
        "gal_map_text_207101019=好！我試試。哇，真的發出聲音了！我來打“在一個滿是書香的夜晚，我們許下了去冰島的約定”，你幫我在旁邊畫一束極光，好不好？",
        "gal_map_text_207101020=墨茗眼神專注，很快掌握敲擊節奏。",
        "gal_map_text_207101021=沒問題，看我的！這種操作難不倒我，我要把我們的‘旅行序言’打得又快又好。你負責畫細節的時候，要畫得精緻一點，別拖後腿哦。",
        "gal_map_text_207101022=墨茗身體微微向你靠近，語氣帶著依賴。",
        "gal_map_text_207101023=嗯！有你握著我的手，我就放心多了。你的手好穩，跟著你敲擊鍵盤，我就不怕出錯了。我打得慢一點，你別著急，我們一起把故事寫好。",
        "gal_map_text_207101024=墨茗手心微微出汗，握緊你的手。",
        "gal_map_text_207101025=好…… 我有點緊張，怕按錯鍵。有你陪著我、教我，我就覺得有安全感多了。你慢慢引導我，我們一起打出最浪漫的“旅行序言”。",
        "gal_map_text_207101026=別著急，我們慢慢打，打字機的樂趣就是這種‘慢節奏的儀式感’。你看，這句話打得很整齊，再打一句“我們會一起走過老街，看過畫展，把每一次相遇都寫成故事”，我在旁邊畫兩個牽手的小人。",
        "gal_map_text_207101027=嗯！我喜歡這種慢慢記錄的感覺，就像我們的感情一樣，不需要太快，慢慢沉澱才更長久。等我們寫完，把這張紙夾在最喜歡的書裡，下次來的時候再翻看，肯定很有意義。",
        "gal_map_text_207101028=墨茗抬頭對你笑。",
        "gal_map_text_207101029=我們來創造一個“專屬暗號”吧！比如用“冰島的極光”代表“我想你”，用“書店的打字機”代表“我想和你聊天”，以後不管是發消息還是見面，只要提到這些暗號，就知道彼此的心意。我們還可以把暗號寫在紙上，藏在書店的某本書裡，下次來的時候找出來，看看對方有沒有留下新的回應。",
        "gal_map_text_207101030=墨茗點點頭，語氣平和。",
        "gal_map_text_207101031=這個主意很有創意！我們可以把暗號整理成一張“秘密手冊”，寫清楚每個暗號的含義，再畫一些對應的小圖示，方便記憶。藏書的時候，我們可以選彼此喜歡的旅行類書籍，下次來的時候一起找，既有趣又有意義。",
        "gal_map_text_207101032=墨茗語氣條理清晰，眼神帶著分析的光芒。",
        "gal_map_text_207101033=我已經構思好幾個暗號了！“桂花烏龍“代表”想和你一起喝茶“，”莫内的睡蓮“代表”想和你一起看展“，每個暗號都對應我們的共同經歷。我們現在就把暗號寫下來，藏在《世界旅行圖鑒》的第 52 頁，這個頁數是我們第一次見面的日期數字。",
        "gal_map_text_207101034=墨茗眼睛亮晶晶的，語氣輕柔，手指輕輕碰了碰你的手背。",
        "gal_map_text_207101035=哇，好浪漫！每個暗號都藏著我們的回憶，以後提到”冰島的極光“，我就會想起今晚在書店的時光。我們把暗號寫在彩色紙上，折成星星的形狀藏在書裡，就像藏起了一個個小秘密。",
        "gal_map_text_207101036=墨茗臉頰微紅，眼裡滿是期待。",
        "gal_map_text_207101037=真的太有意義了！以後不管我們在哪裡，只要提到這些暗號，就像彼此在身邊一樣。我們把暗號寫在紙上，再畫一個小小的愛心，藏在最裡面的書架上，讓它成為我們專屬的秘密。",
        "gal_map_text_207101038=我們每人寫三個暗號，然後交換補充。你看，我寫了”打字機的嗒嗒聲“代表”想和你一起記錄故事“，”老街的燈籠“代表”想和你一起散步“，”文創店的掛繩“代表”想和你一起挑選小物件“。",
        "gal_map_text_207101039=我寫了“旅行畫冊的極光”代表“想和你一起看風景”，“桂花烏龍的香氣”代表“想和你一起放鬆”，“便利貼的留言”代表“想和你一起分享心情”。我們把這張紙折成紙飛機，藏在《冰島旅行指南》裡，下次來的時候讓它“飛”到彼此面前。",
        "gal_map_text_207101040=墨茗頭對你笑。",
        "gal_map_text_207101041=你有沒有發現，這裡的每一條留言都藏著不同的故事？比如這條”和喜歡的人一起看書，連空氣都是甜的“，和我們現在的感覺一模一樣。還有這台打字機，按鍵上的磨損痕跡，好像在訴說著無數人的心事，這種有溫度的細節，真的很打動人。",
        "gal_map_text_207101042=墨茗點點頭，眼神認真。",
        "gal_map_text_207101043=對呀，這些細節都很有深意。留言的筆跡、打字機的磨損，都帶著時間的痕跡，就像我們今晚的相遇，雖然短暫，卻很有意義。",
        "gal_map_text_207101044=墨茗語氣條理清晰，眼神裡帶著分析的光芒。",
        "gal_map_text_207101045=這是典型的”場景情感共鳴“，通過環境中的細節觸發人們的共同感受。打字機的磨損代表”時光沉澱“，留言代表”情感表達“，這些細節共同營造了浪漫的氛圍。",
        "gal_map_text_207101046=墨茗語氣輕快，抬手點了點牆上的留言。",
        "gal_map_text_207101047=對呀對呀！我還看到一條”書店的燈光，是城市裡最溫柔的星光“，說得真好。這台打字機的磨損痕跡也很有感覺，就像它見證了很多人的浪漫故事，現在又要見證我們的。",
        "gal_map_text_207101048=墨茗臉頰微紅，眼神柔和。",
        "gal_map_text_207101049=我也有這種感覺！每一條留言、每一處磨損，都藏著真實的情緒，讓人覺得很溫暖。和你一起發現這些細節，真的很幸福。",
        "gal_map_text_207101050=其實好的相遇就像這些細節一樣，不需要刻意，卻能讓人印象深刻。我們把剛才的共鳴寫在筆記本裡吧，你寫牆上留言給你的感受，我寫打字機帶給我的觸動。",
        "gal_map_text_207101051=好呀！我要把”和你一起發現細節的美好，是今晚最開心的事“寫下來，以後翻看就能想起現在的感覺。",
        "gal_map_text_207101052=墨茗接過筆記本，手指輕輕摩挲著封面。",
        "gal_map_text_207101053=你們要麼一起打完“旅行序言”，要麼定下專屬暗號並藏好紙飛機，要麼在筆記本上寫下彼此的共鳴。墨茗小心翼翼把寫滿心意的紙張折好放進隨身筆記本，主動幫你合上打字機蓋子時，指尖不經意觸碰到你的手指，輕聲提議以後每個月都來這裡記錄故事。落地燈的暖光映在牆上，兩人的影子親密交疊，細節裡的情感共鳴讓好感度愈發濃厚，距離告白只剩一層窗戶紙。",
        "gal_map_text_207101054=書店收銀台旁的小展架被暖黃燈光照亮，上面擺放著各種文創小物：印著書店 logo 的帆布包、木質書簽、復古鋼筆，還有與獨立出版物合作的限量款徽章。其中一套“旅行主題”迷你徽章格外顯眼，上面是飛機、郵票、指南針、舊相機等小巧圖案，金屬表面泛著溫潤的光澤，氛圍可愛而治癒。",
        "gal_map_text_207101055=準備離開前，墨茗被這套“旅行主題”迷你徽章吸引，蹲在展架前仔細看著，手指輕輕觸碰徽章表面。“好可愛…… 像是把今晚的‘旅行’濃縮成小徽章了。” 墨茗拿起一枚指南針徽章，在手裡比劃著，轉頭看向你時，眼裡帶著靈光一現的雀躍。",
        "gal_map_text_207101056=你看這個指南針徽章，指標永遠指向南方，就像我們不管走多遠，都能找到彼此。還有這個飛機徽章，代表著我們想去冰島的約定。我們要不要各選一枚，作為今晚的“旅行紀念”？",
        "gal_map_text_207101057=這個主意太好了！每枚徽章都有特殊意義，我們選一對互補的，比如你選指南針，代表“你是我的方向”，我選飛機，代表“我會帶你去遠方”。以後戴著徽章，就像彼此在身邊一樣。你還喜歡哪枚？",
        "gal_map_text_207101058=你拿起指南針徽章和郵票徽章，放在手心給墨茗看：“指南針代表未來的約定，郵票代表今晚的回憶，都很有意義。” 墨茗湊過來看，頭髮垂下來拂過你的手心，你下意識地幫墨茗把頭髮別到耳後。墨茗的臉頰微紅，抬頭看你時，眼神溫柔得像水。展架的燈光照亮墨茗專注的臉龐，徽章在手心泛著微光，氛圍曖昧而治癒。",
        "gal_map_text_207101059=徽章定約定",
        "gal_map_text_207101060=幫選徽章",
        "gal_map_text_207101061=徽章傳心意",
        "gal_map_text_207101062=徽章合照",
        "gal_map_text_207101063=我們給徽章加個專屬約定吧。這枚指南針指標永遠指向南方，我們約定，以後不管遇到什麼事，不管走多遠，只要看到這枚徽章，就想起今晚的心意 —— 你是我的方向，我會永遠向你靠近。我們在徽章背面刻上今天的日期，再各自刻下對方的名字首字母，作為我們之間的秘密約定。",
        "gal_map_text_207101064=墨茗眼睛亮起來，接過指南針徽章仔細端詳，眼裡滿是期待。",
        "gal_map_text_207101065=好呀！這個約定太有意義了！我來刻你的名字首字母，你刻我的，雖然我刻字技術一般，但一定會很認真。以後看到這枚徽章，就想起我們今晚的約定，想起彼此的心意。",
        "gal_map_text_207101066=墨茗語氣自信，拿起細小的刻刀，眼神專注。",
        "gal_map_text_207101067=沒問題！刻字這種小事難不倒我，我會把字母刻得工整又精緻。我們還要約定，以後每次見面都要戴著這枚徽章，讓它成為我們的專屬標識，向所有人宣告我們的羈絆。",
        "gal_map_text_207101068=墨茗眼神軟下來，輕輕拉著你的袖口，聲音帶著依賴。",
        "gal_map_text_207101069=嗯！這個約定太美好了。我有點怕刻不好，你幫我刻我的名字首字母吧，我在旁邊看著你操作。以後我要一直戴著這枚徽章，就像你一直在我身邊，給我指引方向。",
        "gal_map_text_207101070=墨茗語氣帶著依賴，身體微微向你靠近，眼裡滿是憧憬。",
        "gal_map_text_207101071=哇，好期待！有專屬約定的徽章，感覺更珍貴了。我什麼都聽你的，你刻字、你保管約定，我只要跟著你就好。以後不管去哪裡，我都戴著這枚徽章，記住我們的約定。",
        "gal_map_text_207101072=刻的時候要輕一點，慢慢劃，別把徽章表面刮花了。我們刻得小一點，藏在邊緣，只有我們自己知道它的意義。刻完後，我們互相為對方戴上徽章，算是完成約定的儀式。",
        "gal_map_text_207101073=好呀！你刻得真認真，以後每次看到這枚徽章上的字母，就想起你今晚為我刻字的樣子。這個約定，我會永遠記住。",
        "gal_map_text_207101074=墨茗湊過來看你刻字，頭髮垂下來拂過你的手背，輕聲說。",
        "gal_map_text_207101075=別蹲太久，腿會麻的。喜歡哪枚就告訴我，我幫你拿，展架有點高，小心碰到其他文創。",
        "gal_map_text_207101076=墨茗語氣輕快，站起身活動了一下腿。",
        "gal_map_text_207101077=知道啦，謝謝你關心！我還在糾結選指南針還是飛機，都很喜歡，你幫我拿個主意吧。",
        "gal_map_text_207101078=墨茗興奮地眨了眨眼，嘴角帶著笑意。",
        "gal_map_text_207101079=哇，你也太細心了吧！我沒事，蹲一會兒沒關係。其實我覺得每枚都很好看，要不我們多買幾枚，以後慢慢收集？",
        "gal_map_text_207101080=墨茗語氣平和，眼神沉靜地看著徽章。",
        "gal_map_text_207101081=謝謝你，我沒事。我再看看，慢慢選，不用著急。",
        "gal_map_text_207101082=墨茗微微點頭，語氣淡然。",
        "gal_map_text_207101083=嗯，謝謝你的提醒。蹲久了確實有點麻，站起來活動一下就好。我們慢慢選，選一枚最有紀念意義的。",
        "gal_map_text_207101084=我覺得指南針徽章更有意義，代表“無論走多遠都能找到彼此”。而且和我們想去冰島的約定很搭，以後看到它就能想起今晚的時光。",
        "gal_map_text_207101085=好呀！就選指南針。你說得對，這個意義很好，我會好好珍藏的。以後看到它，就想起你今晚的陪伴。",
        "gal_map_text_207101086=墨茗眼裡帶著笑意，接過徽章。",
        "gal_map_text_207101087=其實我覺得，我們可以一起選一枚徽章，然後在背面刻上彼此的名字首字母，作為專屬我們的“羈絆信物”。比如選這枚指南針徽章，刻上我們的名字首字母，代表“你是我人生的方向，我會永遠追隨你”。這枚徽章不僅是今晚的紀念，更是我們未來的約定。",
        "gal_map_text_207101088=墨茗臉頰微紅，抬手輕輕拍了拍你的胳膊。",
        "gal_map_text_207101089=你這麼說，我有點不好意思啦。其實我也想選指南針徽章，刻上我們的名字首字母，代表“我們一起走向未來”。我們現在就去問店員能不能刻字，我想親手把字母刻上去，更有意義。",
        "gal_map_text_207101090=墨茗語氣自信，嘴角帶著笑意。",
        "gal_map_text_207101091=算你有眼光！就選指南針徽章，刻上我們的名字首字母，以後戴著它，向所有人宣告我們的約定。刻字的時候我來操作，我手工很好，保證刻得又工整又好看。",
        "gal_map_text_207101092=墨茗眼神軟下來，輕輕拉了拉你的袖口。",
        "gal_map_text_207101093=你這麼說，我真的很感動。我也喜歡指南針徽章，有你的名字首字母在上面，就像你一直在我身邊一樣。刻字的時候你幫我刻吧，我相信你能刻得很精緻，我負責幫你遞工具。",
        "gal_map_text_207101094=墨茗語氣帶著溫柔，身體微微向你靠近。",
        "gal_map_text_207101095=哇，你這麼暖心，我都要哭了。這枚徽章太有意義了，刻上我們的名字首字母，就像我們永遠在一起。我什麼都聽你的，你選徽章、刻字，我只要跟著你就好。",
        "gal_map_text_207101096=店員說可以免費刻字，我們現在就去刻。我刻你的名字首字母，你刻我的，這樣我們的心意就永遠刻在徽章上了。以後不管遇到什麼事，看到徽章，就想起我們今晚的約定。",
        "gal_map_text_207101097=嗯！我要把你的名字首字母刻得小一點、精緻一點，藏在徽章背面，作為我們的秘密。等刻好了，我們互相為對方戴上徽章，讓它成為我們的專屬羈絆。",
        "gal_map_text_207101098=墨茗跟在你身後，輕聲說。",
        "gal_map_text_207101099=我們拍張照紀念一下吧！戴著這枚徽章在書店門口拍張合照，以後看到照片就能想起今晚的時光，想起我們的約定。",
        "gal_map_text_207101100=墨茗興奮地站在書店門口，比出剪刀手。",
        "gal_map_text_207101101=好呀好呀！我們多拍幾張，選一張最好看的作為手機壁紙，以後想起來就翻看。",
        "gal_map_text_207101102=墨茗拉著你的手靠近自己，對著鏡頭比心。",
        "gal_map_text_207101103=太有心了！我們拍一張親密一點的，再拍一張單獨戴徽章的，做成一個小相冊，記錄今晚的心動時刻。",
        "gal_map_text_207101104=墨茗語氣平和，自然地站在你身邊。",
        "gal_map_text_207101105=可以，拍張照留作紀念挺好的。簡單拍一張就好，記錄下這個瞬間。",
        "gal_map_text_207101106=墨茗微微點頭，語氣淡然。",
        "gal_map_text_207101107=嗯，挺有意義的。照片能留住當下的心情，以後翻看也是一種回憶。",
        "gal_map_text_207101108=你站近一點，我們對著鏡頭笑一笑。讓徽章在鏡頭裡清晰一點，以後看到就能想起它的意義。",
        "gal_map_text_207101109=好呀！拍好了嗎？我想看看照片，是不是很好看。",
        "gal_map_text_207101110=墨茗主動靠近你，肩膀貼著肩膀",
        "gal_map_text_207101111=你們要麼刻好徽章約定、互相戴好，要麼選好心儀徽章、拍好合照。墨茗把徽章別在衣服上，時不時低頭看看，眼裡滿是珍視。離開文創區時，書店閉店音樂輕輕響起，她主動挽住你的胳膊，腳步放慢，輕聲說“這個徽章我會一直戴著”。老街的燈籠暖光灑在兩人身上，溫柔的互動與心意傳遞讓好感穩步提升，為後續的告白鋪墊好溫柔氛圍。",
        "gal_map_text_207101112=夜色漸深，遊戲店裡的人慢慢少了，背景音樂也調得更輕柔。你們在靠近門口的展示架旁停下，這裡正好是溫暖的店內與微涼夜色的交界。展示架上擺著幾個等待售出的、封繪精美的遊戲盒子。",
        "gal_map_text_207101113=墨茗拿起一個雙人合作遊戲的盒子，仔細看著背面的簡介，手指輕輕撫過上面“共同冒險”的字樣，然後轉頭看向你，臉上帶著玩盡興後的淡淡紅暈和一絲意猶未盡。",
        "gal_map_text_207101114=感覺像是……玩了一個超長的、有很多小關卡的試玩版。到了該退出，看看要不要購買正式版的時候了。",
        "gal_map_text_207101115=試玩版的每一關都很盡興，不管是解謎時的默契，還是闖關後的喜悅，都比任何遊戲本身更珍貴。如果正式版是和你一起，我想立刻“付款”鎖定終身許可權。",
        "gal_map_text_207101116=墨茗被你說得臉頰微紅，指尖輕輕劃過展示架上的遊戲盒封面，身體微微向你傾斜，肩膀離你的距離更近了些。店內的暖光映在墨茗臉上，勾勒出柔和的輪廓，墨茗眼裡閃著期待與忐忑，輕聲說：“正式版的‘劇情’，會不會比試玩版更精彩？”",
        "gal_map_text_207101117=羈絆證明",
        "gal_map_text_207101118=回憶共鳴",
        "gal_map_text_207101119=未來約定",
        "gal_map_text_207101120=墨茗，從你遞光球時的專注，到攻略牆留名時的默契，我早就把你當成最特別的“終身隊友”。這是我特意定制的，和你遊戲角色一模一樣，上面刻著“共同冒險永不退場”。我不想只和你玩一時的遊戲，想和你解鎖一輩子的“人生關卡”—— 以後的日子，不管是開心的“獎勵關”還是難走的“挑戰關”，我都想和你一起面對。",
        "gal_map_text_207101121=墨茗眼睛亮起來，緊緊握住你的手。",
        "gal_map_text_207101122=其實我早就想和你說，你是我最合拍的隊友。以後不管是新遊戲還是生活裡的“關卡”，我都想和你一起闖，做你永遠的“最佳搭檔”。",
        "gal_map_text_207101123=墨茗嘴角上揚，主動握住你的手。",
        "gal_map_text_207101124=算你有眼光！能讓我認可的隊友不多，你是第一個。這個鑰匙扣我收下了，以後我們一起挑戰所有“高難度關卡”，讓別人都羡慕我們的默契。",
        "gal_map_text_207101125=墨茗眼眶微紅，身體微微靠向你。",
        "gal_map_text_207101126=我願意……從你擋在我身前接盒子開始，我就覺得很安心。以後不管遇到什麼，我都想跟著你，做你的專屬隊友，永遠不退出。",
        "gal_map_text_207101127=墨茗緊緊抱住你的胳膊。",
        "gal_map_text_207101128=我從來沒有這麼開心過，有你在身邊，我什麼都不怕。以後你走到哪裡，我就跟到哪裡，做你一輩子的“專屬輔助”。",
        "gal_map_text_207101129=這個鑰匙扣是“綁定道具”，一旦戴上就不能解綁啦。以後不管是線上連線還是線下同行，它都是我們的“羈絆證明”。",
        "gal_map_text_207101130=太好了！我要一直戴著它。以後看到它，就想起我們一起闖過的每一關，還有這個“終身綁定”的約定。",
        "gal_map_text_207101131=墨茗輕輕撫摸鑰匙扣上的刻字。",
        "gal_map_text_207101132=墨茗，你還記得我們一起破解的第一個密碼鎖嗎？你認真分析線索的樣子，我一下子就記在了心裡。後來一起試玩獨立遊戲、在攻略牆貼便利貼，每一個瞬間都像珍貴的遊戲存檔，我想把這些存檔永久保存，還要續寫更多新的篇章。我喜歡和你在一起的感覺，喜歡這種不用多說就能明白彼此的默契。",
        "gal_map_text_207101133=墨茗臉頰微紅，嘴角帶笑。",
        "gal_map_text_207101134=我記得！我也喜歡和你在一起的感覺，和你一起玩遊戲、闖難關，不管多難都覺得很有趣。我想和你一起創造更多“存檔”，做彼此最合拍的人。",
        "gal_map_text_207101135=墨茗笑著調侃你。",
        "gal_map_text_207101136=當然記得，你當時還差點把拼圖放反了呢。說真的，我早就喜歡你了。以後我們一起挑戰更多遊戲，一起解鎖更多隱藏結局，讓我們的‘劇情’越來越精彩。",
        "gal_map_text_207101137=墨茗輕輕拉你的袖口。",
        "gal_map_text_207101138=我記得……我一直都很依賴你，有你在身邊就覺得很安心。我喜歡你，想和你一直這樣，把每一個平凡的日子都過成“精彩關卡”。",
        "gal_map_text_207101139=墨茗眼裡泛著淚光。",
        "gal_map_text_207101140=我當然記得！從第一次和你說話開始，我就覺得你很溫柔。我喜歡你，想和你一起走過以後的每一天，永遠做你的“小跟班”，跟著你解鎖所有美好。",
        "gal_map_text_207101141=我們現在就去攻略牆再留一張便利貼，寫下“正式版開啟，終身合作”。以後每次來，都要新增一個“劇情存檔”。",
        "gal_map_text_207101142=好呀！我要寫“最佳隊友已綁定，終身有效”，讓這面牆見證我們的約定。",
        "gal_map_text_207101143=墨茗興奮地拿起筆。",
        "gal_map_text_207101144=墨茗，今晚的每一個瞬間都太美好了，我忍不住開始期待未來的“正式版劇情”。想和你一起去參加遊戲展會，一起解鎖所有雙人遊戲的隱藏結局，一起把我們的“情侶帳號”綁定一輩子。我喜歡你，想和你約定，以後不管是開心的“獎勵”還是困難的“阻礙”，都一起分享、一起面對，讓我們的未來像今晚的遊戲一樣，溫暖而圓滿。",
        "gal_map_text_207101145=墨茗眼神堅定。",
        "gal_map_text_207101146=我願意。和你相處的過程中，我能感受到你的真誠。我也喜歡你，願意和你一起規劃未來的“劇情線”，一起實現所有約定，把每一天都過得很精彩。",
        "gal_map_text_207101147=墨茗語氣條理清晰。",
        "gal_map_text_207101148=我願意。從相處的細節來看，我們很合拍。我們可以一起制定“情侶打卡計畫”，先從周邊的遊戲店開始，逐步解鎖更多“地圖”。",
        "gal_map_text_207101149=墨茗臉頰微紅，眼裡滿是溫柔。",
        "gal_map_text_207101150=我願意……我一直期待能有一個人陪我做喜歡的事，你就是那個人。我喜歡你，想和你一起奔赴未來，把每一個約定都變成現實裡的“精彩劇情”。",
        "gal_map_text_207101151=墨茗主動抱住你。",
        "gal_map_text_207101152=我願意！我好感動，你知道嗎？我一直都喜歡你，也一直想和你一起做很多事。以後有你陪著我，不管什麼“關卡”都不怕了。",
        "gal_map_text_207101153=我們現在就創建“未來約定”備忘錄，把想去的展會、想玩的遊戲都列上去。第一個約定，就是下週末再一起來解鎖新遊戲。",
        "gal_map_text_207101154=好呀好呀！我還要加上“一起cos遊戲角色”一起收藏限定周邊’，讓我們的“劇情”越來越豐富。",
        "gal_map_text_207101155=墨茗",
        "gal_map_text_207101156=遊戲店的背景音樂切換成溫柔的鋼琴曲，暖黃燈光將兩人的影子緊緊交疊。唐笑笑主動挽住你的胳膊，指尖傳來溫熱的觸感，她抬頭對你笑時，眼裡閃著藏不住的甜蜜。",
        "gal_map_text_207101157=你們並肩走出店門，手牽著手融入夜色，街道上的霓虹映在彼此臉上，那些關於遊戲、默契與未來的約定，都化作此刻無需言說的心意。從這一刻起，你們正式成為情侶，每一個共同經歷的“關卡”，都成為彼此羈絆中最珍貴的印記。",
        "gal_map_text_207101158=夜色漸深，遊戲店裡的人慢慢少了，背景音樂也調得更輕柔。你們在靠近門口的展示架旁停下，這裡正好是溫暖的店內與微涼夜色的交界。展示架上擺著幾個等待售出的、封繪精美的遊戲盒子。",
        "gal_map_text_207101159=墨茗拿起一個雙人合作遊戲的盒子，仔細看著背面的簡介，手指輕輕撫過上面“共同冒險”的字樣，然後轉頭看向你，臉上帶著玩盡興後的淡淡紅暈和一絲意猶未盡。",
        "gal_map_text_207101160=感覺像是……玩了一個超長的、有很多小關卡的試玩版。到了該退出，看看要不要購買正式版的時候了。",
        "gal_map_text_207101161=試玩版的每一關都很盡興，不管是解謎時的默契，還是闖關後的喜悅，都比任何遊戲本身更珍貴。如果正式版是和你一起，我想立刻“付款”鎖定終身許可權。",
        "gal_map_text_207101162=墨茗被你說得臉頰微紅，指尖輕輕劃過展示架上的遊戲盒封面，身體微微向你傾斜，肩膀離你的距離更近了些。店內的暖光映在墨茗臉上，勾勒出柔和的輪廓，墨茗眼裡閃著期待與忐忑，輕聲說：“正式版的‘劇情’，會不會比試玩版更精彩？”",
        "gal_map_text_207101163=溫柔心意",
        "gal_map_text_207101164=氛圍告白",
        "gal_map_text_207101165=默契同行",
        "gal_map_text_207101166=墨茗，從見到你的第一眼開始，我就覺得你很可愛。今晚和你一起玩遊戲、留留言、拍合照，每一刻都讓我很開心。我發現自己喜歡上你了，很真誠地喜歡你。我不想只和你做“遊戲搭子”，想做那個能一直陪著你的人，讓你每天都開開心心的，把生活過成你喜歡的“輕鬆模式”。",
        "gal_map_text_207101167=墨茗臉頰微紅，抬頭對你笑。",
        "gal_map_text_207101168=謝謝你的喜歡，我也喜歡你。我願意和你在一起，以後我們可以經常來這裡玩遊戲，一起創造更多開心的時光，解鎖更多“快樂關卡”。",
        "gal_map_text_207101169=墨茗主動握住你的手。",
        "gal_map_text_207101170=我願意！能被你喜歡，我很開心。我也喜歡你，以後我們就是情侶了，要一起體驗更多有趣的事，一起解鎖更多生活裡的“隱藏驚喜”。",
        "gal_map_text_207101171=墨茗眼神軟下來。",
        "gal_map_text_207101172=我…… 我願意。我也喜歡你，和你在一起我覺得很安心。以後有你陪著我，不管什麼“難題”都能變成“簡單關卡”，我就很開心了。",
        "gal_map_text_207101173=墨茗身體微微向你靠近。",
        "gal_map_text_207101174=我願意！我一直都很喜歡你，只是不敢說。你喜歡我，我真的太開心了，我願意做你的女朋友，一直跟著你“闖關”。",
        "gal_map_text_207101175=以後不管是玩遊戲還是過日子，我都會讓著你，把最好的“裝備”和最多的“關愛”都給你。週末我們就來解鎖那款你一直想看的新遊戲，怎麼樣？",
        "gal_map_text_207101176=太好了！我已經開始期待了，和你在一起，不管做什麼都覺得很開心。",
        "gal_map_text_207101177=墨茗眼裡閃著光芒。",
        "gal_map_text_207101178=墨茗，你看這遊戲店的燈光，還有我們一起通關的畫面，都讓我覺得很溫暖。在這樣的氛圍裡，我想告訴你：我喜歡你。和你在一起的感覺很美好，不管是玩遊戲還是聊天，都讓我覺得很舒服。我想和你一直這樣，做彼此最親近的人，把每一個相處的瞬間都變成“珍貴存檔”。",
        "gal_map_text_207101179=墨茗眼睛亮起來。",
        "gal_map_text_207101180=我願意！我也喜歡你！這裡的氛圍真的很溫暖，就像你給我的感覺一樣。以後我們要在這裡留下更多回憶，讓遊戲店見證我們的每一個“甜蜜關卡”。",
        "gal_map_text_207101181=墨茗拉著你的手比心。",
        "gal_map_text_207101182=我願意！願意！願意！太開心了！我們趕緊拍張合照，發朋友圈宣告我們在一起啦。以後每次來這裡，都要紀念一下我們的“戀愛紀念日”，解鎖更多情侶專屬“成就”。”",
        "gal_map_text_207101183=墨茗輕輕靠向你。",
        "gal_map_text_207101184=我願意……我也喜歡你。在這樣溫暖的氛圍裡，能聽到你的告白，我真的很幸福。以後我想一直和你在一起，永遠不分開，一起把日子過成“輕鬆愉快模式”。",
        "gal_map_text_207101185=墨茗語氣帶著哽咽。",
        "gal_map_text_207101186=我願意！我好開心，這裡的一切都很美好，和你在一起的感覺更美好。我願意做你的女朋友，永遠陪著你，跟著你體驗所有美好。",
        "gal_map_text_207101187=我們在遊戲店門口拍張合照吧，就以這排遊戲盒為背景，紀念我們“正式版”的開啟。以後看到這張照片，就能想起今晚的心動瞬間。",
        "gal_map_text_207101188=好呀！我們比個遊戲勝利的手勢，象徵我們的愛情“闖關成功”！",
        "gal_map_text_207101189=墨茗主動靠近你，肩膀貼著肩膀。",
        "gal_map_text_207101190=墨茗，今晚的“試玩”讓我明白，最珍貴的不是遊戲本身，而是和你並肩的默契。我們好像天生就該一起“冒險”，不用多說就能明白彼此的想法。我想把這份默契延續下去，不止今晚，以後的每一天都想和你這樣同行，做彼此最合拍的人，一起解鎖人生的所有“地圖”。",
        "gal_map_text_207101191=墨茗低頭淺笑。",
        "gal_map_text_207101192=我也有同感。和你一起玩遊戲的時候，我從來沒有這麼放鬆過。我願意和你在一起，一起玩更多遊戲、解鎖更多結局，讓我們的羈絆越來越深，成為最好的“戰友”和伴侶。",
        "gal_map_text_207101193=墨茗語氣自信。",
        "gal_map_text_207101194=當然！能和我這麼有默契的人不多，你算一個。我願意和你在一起，以後我們一起挑戰更多有難度的遊戲和生活難題，一起成為別人羡慕的情侶。",
        "gal_map_text_207101195=墨茗手指輕輕摩挲你的手背。",
        "gal_map_text_207101196=我願意……我一直都很依賴你，有你在身邊，不管遇到什麼難關都覺得能過去。我願意和你一起同行，永遠跟著你，一起“闖關”、一起成長。",
        "gal_map_text_207101197=墨茗緊緊拉住你的手。",
        "gal_map_text_207101198=我願意！我也覺得和你很有默契，和你在一起我很安心。我願意和你一起走以後的路，永遠不分開，做你一輩子的“小跟班”。",
        "gal_map_text_207101199=以後不管是玩遊戲還是過日子，我們都保持這份默契，互相配合、互相支持。週末我們就來解鎖那款雙人合作新遊戲，繼續我們的“默契冒險”。",
        "gal_map_text_207101200=好呀！我相信我們不管遇到什麼，都能像今晚一樣默契配合，順利“闖關”。",
        "gal_map_text_207101201=墨茗眼裡帶著期待。",
        "gal_map_text_207101202=遊戲店的背景音樂切換成溫柔的鋼琴曲，暖黃燈光將兩人的影子緊緊交疊。唐笑笑主動挽住你的胳膊，指尖傳來溫熱的觸感，她抬頭對你笑時，眼裡閃著藏不住的甜蜜。",
        "gal_map_text_207101203=你們並肩走出店門，手牽著手融入夜色，街道上的霓虹映在彼此臉上，那些關於遊戲、默契與未來的約定，都化作此刻無需言說的心意。從這一刻起，你們正式成為情侶，每一個共同經歷的“關卡”，都成為彼此羈絆中最珍貴的印記。",
        "gal_map_text_207101204=夜色已深，「時光修補鋪」裡只剩下一盞為你們留著的暖黃壁燈。老師傅早已微笑著道別，將店鋪暫時交給這份安靜。你們站在店鋪的裡門門廊下，前方是通往街道的短巷，身後是滿載著時光與故事的溫暖空間。",
        "gal_map_text_207101205=空氣中還隱約殘留著皮革、木蠟和金屬的氣息。墨茗手裡拿著你們共同修復的黃銅徽章，指尖輕輕摩挲著光滑的表面，臉上帶著完成作品後的滿足。墨茗沒有立刻推門走入夜色，而是轉過身，背靠著厚重的木門，面對著你。",
        "gal_map_text_207101206=壁燈的光從側面映亮墨茗的臉，一半在光裡，一半在溫柔的陰影中。感覺完成了一件很珍貴的事，不僅是修復了這個徽章，還…… 收穫了更珍貴的陪伴。",
        "gal_map_text_207101207=和你一起打磨時光的感覺，比任何修復好的物件都更有意義。這枚徽章記錄著我們的默契與耐心，就像我們的關係，在慢慢打磨中越來越溫潤。",
        "gal_map_text_207101208=墨茗被你說得臉頰微紅，指尖輕輕將徽章握得更緊，身體微微向前傾，距離你更近了些。壁燈的暖光映在徽章上，反射出柔和的光澤，墨茗眼裡閃著眷戀與期待，輕聲說：“這樣溫暖的時光，真希望能一直延續下去。”",
        "gal_map_text_207101209=羈絆與專屬",
        "gal_map_text_207101210=回憶共鳴",
        "gal_map_text_207101211=未來約定",
        "gal_map_text_207101212=墨茗，這是我特意做的，封面的齒輪和我們修復的徽章元素一模一樣，裡面夾著我們打磨時掉的銅屑。我不想只和你做一時的手工搭檔，想和你一起“修復”一輩子的時光—— 以後的日子，不管是手工製作還是生活瑣事，我都想和你一起完成，把每一個平凡的日子都打磨得閃閃發光",
        "gal_map_text_207101213=墨茗眼睛亮起來，緊緊握住筆記本。",
        "gal_map_text_207101214=我願意！其實我早就想和你說，你是我最合拍的搭檔。以後不管是銀飾定制還是舊物修復，我都想和你一起做，做你永遠的“手工夥伴”，一起創造更多有溫度的物件。",
        "gal_map_text_207101215=墨茗嘴角上揚，主動握住你的手。",
        "gal_map_text_207101216=算你有心！能讓我認可的人不多，你是第一個。這個筆記本我收下了，以後我們一起做更多專屬手工，讓每一件作品都見證我們的感情，成為時光裡的珍貴紀念。",
        "gal_map_text_207101217=墨茗眼眶微紅，身體微微靠向你。",
        "gal_map_text_207101218=我願意……從你教我用銼刀開始，我就覺得很安心。以後不管遇到什麼，我都想跟著你，做你的專屬搭檔，永遠不分開，一起打磨屬於我們的幸福。",
        "gal_map_text_207101219=墨茗緊緊抱住你的胳膊。",
        "gal_map_text_207101220=我願意！我願意！我從來沒有這麼開心過，有你在身邊，我什麼都不怕。以後你做手工的時候，我都想陪著你，做你一輩子的“小助手”，跟著你學習、跟著你成長。",
        "gal_map_text_207101221=這個筆記本是“時光載體”，以後我們把一起做手工的過程、遇到的趣事都寫進去。第一頁就記錄下這枚徽章的修復故事，作為我們羈絆的起點。",
        "gal_map_text_207101222=太好了！我還要在裡面貼上我們做手工的照片，讓它成為我們的“專屬回憶冊”。以後看到它，就想起我們一起打磨時光的溫暖。",
        "gal_map_text_207101223=墨茗指尖輕輕撫摸筆記本封面的齒輪。",
        "gal_map_text_207101224=墨茗，。以後一起打磨徽章、討論鑰匙扣設計，每一個瞬間都讓我覺得很幸福。我喜歡和你在一起的感覺，喜歡這種安靜而踏實的氛圍。我想把這份幸福延續下去，不止今晚，以後的每一天都想和你這樣，一起面對生活的“粗糙”，打磨出屬於我們的“溫潤”。",
        "gal_map_text_207101225=墨茗臉頰微紅，嘴角帶笑。",
        "gal_map_text_207101226=我記得！我也喜歡和你在一起的感覺，和你一起做手工，不管多繁瑣的步驟都覺得很有趣。我想和你一起創造更多回憶，做彼此最親近的人，一起把生活過得有滋有味。",
        "gal_map_text_207101227=墨茗笑著調侃你。",
        "gal_map_text_207101228=當然記得，你當時還幫我擦袖口的膏體呢。說真的，我早就喜歡你了。以後我們一起挑戰更多手工製作，一起解鎖更多生活樂趣，讓我們的感情像手工製品一樣，越來越牢固。",
        "gal_map_text_207101229=墨茗眼神軟下來，輕輕拉你的袖口。",
        "gal_map_text_207101230=我記得……我一直都很依賴你，有你在身邊就覺得很安心。我喜歡你，想和你一直這樣，永遠不分開，一起面對生活裡的所有“小意外”。",
        "gal_map_text_207101231=墨茗眼裡泛著淚光。",
        "gal_map_text_207101232=我當然記得！從你第一次幫我整理頭髮開始，我就覺得你很溫柔。我喜歡你，想和你一起走過以後的每一天，永遠做你的“小跟班”，跟著你體驗所有美好。",
        "gal_map_text_207101233=我們現在就去工作臺前，把這枚徽章放在一起，作為我們“正式在一起”的紀念。以後每次來，都要做一件新的手工，記錄我們的感情軌跡。",
        "gal_map_text_207101234=好呀！我要在旁邊放一張小紙條，寫下“我們的故事，從這裡開始”。",
        "gal_map_text_207101235=墨茗小心翼翼地把徽章放在工作臺中央。",
        "gal_map_text_207101236=墨茗，我想和你一起完成未做完的鑰匙扣，一起嘗試銀飾定制，一起把我們做的每一件手工都珍藏起來。我喜歡你，想和你約定，以後不管是開心的事還是困難的事，都一起分享、一起面對，讓我們的未來像手工製品一樣，獨一無二、充滿溫度，經得起時光的打磨。",
        "gal_map_text_207101237=墨茗眼神堅定。",
        "gal_map_text_207101238=我願意。和你相處的過程中，我能感受到你的真誠。我也喜歡你，願意和你一起規劃未來，一起實現所有約定，把每一天都過得很精彩，讓我們的感情越來越深厚。",
        "gal_map_text_207101239=墨茗語氣條理清晰。",
        "gal_map_text_207101240=我願意。從相處的細節來看，我們很合拍。我們可以一起制定“手工打卡計畫”，先從銀飾定制開始，逐步實現更多目標，讓我們的感情在共同體驗中不斷升溫。",
        "gal_map_text_207101241=墨茗臉頰微紅，眼裡滿是溫柔。",
        "gal_map_text_207101242=我願意……我一直期待能有一個人陪我做喜歡的事，你就是那個人。我喜歡你，想和你一起奔赴未來，把每一個約定都變成現實，讓每一段時光都充滿溫度。",
        "gal_map_text_207101243=墨茗主動抱住你。",
        "gal_map_text_207101244=我願意！我好感動，你知道嗎？我一直都喜歡你，也一直想和你一起做很多事。以後有你陪著我，不管什麼困難都能克服，一起把生活過得像手工製品一樣精緻。",
        "gal_map_text_207101245=我們現在就創建“未來手工約定”備忘錄，把想做的手工項目、想嘗試的工藝都列上去。第一個約定，就是下週末一起來完成那對情侶鑰匙扣。",
        "gal_map_text_207101246=好呀好呀！我還要加上“一起學習皮具製作”“一起修復舊照片”，讓我們的未來充滿更多有意義的體驗。",
        "gal_map_text_207101247=墨茗湊過來看手機，眼裡滿是期待。",
        "gal_map_text_207101248=壁燈的暖光將兩人的影子緊緊疊在木門上，空氣中殘留的皮革與木蠟香氣愈發溫潤。唐笑笑主動挽住你的胳膊，將那枚共同修復的徽章輕輕放進你的手心，指尖與你相觸時帶著微微的暖意。",
        "gal_map_text_207101249=你們並肩走出修補鋪，踏入短巷的夜色中，她的肩膀偶爾輕輕靠向你，輕聲說著對未來手工時光的期待。從這一刻起，你們正式成為情侶，那些一起打磨的時光、一起完成的作品，都成為彼此感情中最珍貴的印記。",
        "gal_map_text_207101250=夜色已深，「時光修補鋪」裡只剩下一盞為你們留著的暖黃壁燈。老師傅早已微笑著道別，將店鋪暫時交給這份安靜。你們站在店鋪的裡門門廊下，前方是通往街道的短巷，身後是滿載著時光與故事的溫暖空間。",
        "gal_map_text_207101251=空氣中還隱約殘留著皮革、木蠟和金屬的氣息。墨茗手裡拿著你們共同修復的黃銅徽章，指尖輕輕摩挲著光滑的表面，臉上帶著完成作品後的滿足。墨茗沒有立刻推門走入夜色，而是轉過身，背靠著厚重的木門，面對著你。",
        "gal_map_text_207101252=壁燈的光從側面映亮墨茗的臉，一半在光裡，一半在溫柔的陰影中。感覺完成了一件很珍貴的事，不僅是修復了這個徽章，還…… 收穫了更珍貴的陪伴。",
        "gal_map_text_207101253=和你一起打磨時光的感覺，比任何修復好的物件都更有意義。這枚徽章記錄著我們的默契與耐心，就像我們的關係，在慢慢打磨中越來越溫潤。",
        "gal_map_text_207101254=墨茗被你說得臉頰微紅，指尖輕輕將徽章握得更緊，身體微微向前傾，距離你更近了些。壁燈的暖光映在徽章上，反射出柔和的光澤，墨茗眼裡閃著眷戀與期待，輕聲說：“這樣溫暖的時光，真希望能一直延續下去。”",
        "gal_map_text_207101255=溫柔心意",
        "gal_map_text_207101256=溫暖氛圍",
        "gal_map_text_207101257=新的旅程",
        "gal_map_text_207101258=墨茗，從見到你的第一眼開始，我就覺得你很溫柔。今晚和你一起選材料、做手工、聊心意，每一刻都讓我很開心。我發現自己喜歡上你了，很真誠地喜歡你。我不想只和你做朋友，想做那個能一直陪著你的人，讓你每天都開開心心的，一起把生活過得像手工製品一樣溫暖。",
        "gal_map_text_207101259=墨茗臉頰微紅，抬頭對你笑。",
        "gal_map_text_207101260=謝謝你的喜歡，我也喜歡你。我願意和你在一起，以後我們可以經常來這裡做手工，一起創造更多開心的時光，一起製作更多有溫度的物件。",
        "gal_map_text_207101261=墨茗主動握住你的手。",
        "gal_map_text_207101262=我願意！能被你喜歡，我很開心。我也喜歡你，以後我們就是情侶了，要一起體驗更多有趣的手工，一起解鎖更多生活技能，一起變得更好。",
        "gal_map_text_207101263=墨茗眼神軟下來。",
        "gal_map_text_207101264=我…… 我願意。我也喜歡你，和你在一起我覺得很安心。以後有你陪著我，不管做什麼手工都覺得很有底氣，生活也會變得更美好。",
        "gal_map_text_207101265=墨茗身體微微向你靠近。",
        "gal_map_text_207101266=我願意！我一直都很喜歡你，只是不敢說。你喜歡我，我真的太開心了，我願意做你的女朋友，一直跟著你做手工、過生活。",
        "gal_map_text_207101267=以後不管是做手工還是過日子，我都會好好照顧你，尊重你的想法，和你一起面對所有事情。週末我們就來嘗試做你一直想看的銀飾吊墜，怎麼樣？",
        "gal_map_text_207101268=太好了！我已經開始期待了，和你在一起，不管做什麼都覺得很有意義。",
        "gal_map_text_207101269=墨茗眼裡閃著光芒。",
        "gal_map_text_207101270=墨茗，在這樣的氛圍裡，我想告訴你：我喜歡你。和你在一起的感覺很美好，不管是做手工還是聊天，都讓我覺得很舒服。我想和你一直這樣，做彼此最親近的人，把每一個相處的瞬間都變成珍貴的回憶。",
        "gal_map_text_207101271=墨茗眼睛亮起來。",
        "gal_map_text_207101272=我願意！我也喜歡你！這裡的氛圍真的很溫暖，就像你給我的感覺一樣。以後我們要在這裡留下更多回憶，讓修補鋪見證我們的每一個甜蜜瞬間，製作更多情侶專屬物件。",
        "gal_map_text_207101273=墨茗拉著你的手比心。",
        "gal_map_text_207101274=我願意願意願意！太開心了！我們趕緊拍張合照，發朋友圈宣告我們在一起啦。以後每次來這裡，都要紀念一下我們的戀愛紀念日，做一件有紀念意義的手工。",
        "gal_map_text_207101275=墨茗輕輕靠向你。",
        "gal_map_text_207101276=我願意……我也喜歡你。在這樣溫暖的氛圍裡，能聽到你的告白，我真的很幸福。以後我想一直和你在一起，永遠不分開，一起把日子過得像手工製品一樣溫潤。",
        "gal_map_text_207101277=墨茗語氣帶著哽咽。",
        "gal_map_text_207101278=我願意！我好開心，這裡的一切都很美好，和你在一起的感覺更美好。我願意做你的女朋友，永遠陪著你，一起體驗手工與生活的美好。",
        "gal_map_text_207101279=我們在修補鋪門口拍張合照吧，就以這扇木門為背景，紀念我們的心動時刻。以後看到這張照片，就能想起今晚的溫暖與幸福。",
        "gal_map_text_207101280=好呀！讓徽章也一起入鏡，見證我們的愛情。",
        "gal_map_text_207101281=墨茗主動靠近你，手裡舉著那枚共同修復的徽章。",
        "gal_map_text_207101282=墨茗，看著你專注製作的樣子，聽著你聊工具、聊材料的聲音，都讓我覺得格外安心。我想把這份默契延續下去，不止今晚，以後的每一天都想和你這樣同行，做彼此最合拍的人，一起把生活“打磨”得更加美好。",
        "gal_map_text_207101283=墨茗低頭淺笑。",
        "gal_map_text_207101284=我也有同感。和你一起做手工的時候，我從來沒有這麼放鬆過。我願意和你在一起，一起做更多手工、探索更多樂趣，讓我們的羈絆越來越深，成為最好的伴侶。",
        "gal_map_text_207101285=墨茗語氣自信。",
        "gal_map_text_207101286=當然！能和我這麼有默契的人不多，你算一個。我願意和你在一起，以後我們一起挑戰更多有難度的手工，一起面對生活的挑戰，一起成為別人羡慕的情侶。",
        "gal_map_text_207101287=墨茗手指輕輕摩挲你的手背。",
        "gal_map_text_207101288=我願意……我一直都很依賴你，有你在身邊，不管遇到什麼難關都覺得能過去。我願意和你一起同行，永遠跟著你，一起“打磨”幸福的生活。",
        "gal_map_text_207101289=墨茗緊緊拉住你的手。",
        "gal_map_text_207101290=我願意！我也覺得和你很有默契，和你在一起我很安心。我願意和你一起走以後的路，永遠不分開，做你一輩子的“小跟班”，一起體驗所有美好。",
        "gal_map_text_207101291=以後不管是做手工還是過日子，我們都保持這份默契，互相配合、互相支持，一起把每一件事都做好。週末我們就來解鎖那款皮具鑰匙扣，繼續我們的手工之旅。",
        "gal_map_text_207101292=好呀！我相信我們不管遇到什麼，都能像今晚一樣默契配合，把生活過得越來越美好。",
        "gal_map_text_207101293=墨茗眼裡帶著期待。",
        "gal_map_text_207101294=壁燈的暖光將兩人的影子緊緊疊在木門上，空氣中殘留的皮革與木蠟香氣愈發溫潤。唐笑笑主動挽住你的胳膊，將那枚共同修復的徽章輕輕放進你的手心，指尖與你相觸時帶著微微的暖意。",
        "gal_map_text_207101295=你們並肩走出修補鋪，踏入短巷的夜色中，她的肩膀偶爾輕輕靠向你，輕聲說著對未來手工時光的期待。從這一刻起，你們正式成為情侶，那些一起打磨的時光、一起完成的作品，都成為彼此感情中最珍貴的印記。",
        "gal_map_text_207101296=書店的閉店音樂輕柔地響起，店員開始整理書架。你們在滿室書香中走到門口，推開那扇掛著小風鈴的玻璃門，夜晚微涼的空氣撲面而來，與室內的溫暖形成鮮明對比。",
        "gal_map_text_207101297=墨茗沒有立刻走入夜色，而是在門廊下的燈光裡轉過身，背靠著店門旁的磚牆。身後是即將沉入寂靜的書店宇宙，面前是流動的城市夜晚。墨茗手裡捏著那枚小小的指南針徽章，指尖輕輕摩挲著表面。",
        "gal_map_text_207101298=感覺像是……從一場很長很深的夢裡，慢慢浮上來。夢裡有好多別人的故事和風景……但牽著我的手，帶我逛遍這個夢的人，是你。",
        "gal_map_text_207101299=這場“夢境”因為有你才更珍貴。和你一起分享書籍、討論風景、暢想未來，比任何故事都更動人，我想把這場“夢”變成一輩子的現實。",
        "gal_map_text_207101300=墨茗被你說得臉頰微紅，指尖輕輕將徽章握得更緊，身體微微向你靠近，距離你只有半步之遙。門廊的燈光映在墨茗臉上，勾勒出柔和的輪廓，墨茗眼裡閃著溫柔與期待，輕聲說：“現實會不會比夢境更美好？”",
        "gal_map_text_207101301=旅行告白",
        "gal_map_text_207101302=浪漫氛圍",
        "gal_map_text_207101303=未來期待",
        "gal_map_text_207101304=墨茗，這是我特意做的，裡面的卡片印著“待訪之地”“共同記憶”，和我們聊的冰島旅行一模一樣。我不想只和你做一時的讀書夥伴，想和你一起“閱讀”一輩子的生活—— 以後的日子，不管是逛書店還是看世界，我都想和你一起完成，把每一個精彩瞬間都記錄在這些卡片上。",
        "gal_map_text_207101305=墨茗眼睛亮起來，緊緊握住索引卡盒。",
        "gal_map_text_207101306=我願意！其實我早就想和你說，你是我最合拍的夥伴。以後不管是看展還是旅行，我都想和你一起去，做你永遠的“旅行搭檔”，一起解鎖更多風景與故事。",
        "gal_map_text_207101307=墨茗嘴角上揚，主動握住你的手。",
        "gal_map_text_207101308=算你懂我！能讓我認可的人不多，你是第一個。這個索引卡盒我收下了，以後我們一起列“旅行清單”，一起解鎖更多風景，讓每一次出行都見證我們的感情。",
        "gal_map_text_207101309=墨茗眼眶微紅，身體微微靠向你。",
        "gal_map_text_207101310=我願意……從你幫我拿高處的書開始，我就覺得很安心。以後不管遇到什麼，我都想跟著你，做你的專屬搭檔，永遠不分開，一起體驗所有美好。",
        "gal_map_text_207101311=墨茗緊緊抱住你的胳膊。",
        "gal_map_text_207101312=我願意！我願意！我從來沒有這麼開心過，有你在身邊，我什麼都不怕。以後你旅行的時候，我都想陪著你，做你一輩子的“小跟班”，跟著你看遍世界風景。",
        "gal_map_text_207101313=這個索引卡盒是“時光膠囊”，以後我們把想去的地方、想做的事都寫在卡片上，一個個去實現。第一張小卡片，就寫“一起去冰島看極光”，作為我們的第一個共同目標。",
        "gal_map_text_207101314=太好了！我還要在卡片上畫小小的極光圖案。以後每實現一個目標，就在卡片上打個勾，讓它成為我們幸福的見證。",
        "gal_map_text_207101315=墨茗指尖輕輕撫摸索引卡盒。",
        "gal_map_text_207101316=墨茗，你還記得我們一起用打字機寫“旅行序言”嗎？你不小心碰到我手指時害羞的樣子，我一下子就記在了心裡。後來一起討論冰島攻略、分享藝術畫冊，每一個瞬間都讓我覺得很幸福。我喜歡和你在一起的感覺，喜歡這種安靜而浪漫的氛圍。我想把這份幸福延續下去，不止今晚，以後的每一天都想和你這樣，一起分享書籍、分享心情、分享生活的所有美好。",
        "gal_map_text_207101317=墨茗臉頰微紅，嘴角帶笑。",
        "gal_map_text_207101318=我記得！我也喜歡和你在一起的感覺，和你一起逛書店，不管多厚的書都覺得很有趣。我想和你一起創造更多回憶，做彼此最親近的人，一起把生活過得像好書一樣精彩。",
        "gal_map_text_207101319=墨茗笑著調侃你。",
        "gal_map_text_207101320=當然記得，你當時還幫我整理頭髮呢。說真的，我早就喜歡你了。以後我們一起逛更多書店、看更多展，一起解鎖更多生活樂趣，讓我們的感情像好書一樣，越讀越有味道。",
        "gal_map_text_207101321=墨茗輕輕拉你的袖口。",
        "gal_map_text_207101322=我記得……我一直都很依賴你，有你在身邊就覺得很安心。我喜歡你，想和你一直這樣，永遠不分開，一起分享每一本好書、每一份心情。",
        "gal_map_text_207101323=墨茗眼裡泛著淚光。",
        "gal_map_text_207101324=我當然記得！從你第一次幫我擦雜誌上的水漬開始，我就覺得你很溫柔。我喜歡你，想和你一起走過以後的每一天，永遠做你的“小跟班”，跟著你體驗所有美好。",
        "gal_map_text_207101325=我們現在就去書架前，把那張“旅行序言”紙飛機找出來，在後面加上“故事未完，餘生繼續”。以後每次來書店，都要留下一張新的“故事片段”。",
        "gal_map_text_207101326=好呀！我還要在上面畫兩個牽手的小人，象徵我們永遠在一起。",
        "gal_map_text_207101327=墨茗興奮地走向書架。",
        "gal_map_text_207101328=墨茗，今晚一起分享書籍的過程，讓我對未來有了很多期待。我想和你一起去冰島看極光，一起逛遍所有獨立書店，一起把我們喜歡的句子都記在索引卡上。我喜歡你，想和你約定，以後不管是開心的事還是困難的事，都一起分享、一起面對，讓我們的未來像好書一樣，越讀越有味道，越品越醇厚。",
        "gal_map_text_207101329=墨茗眼神堅定。",
        "gal_map_text_207101330=我願意。和你相處的過程中，我能感受到你的真誠。我也喜歡你，願意和你一起規劃未來，一起實現所有約定，把每一天都過得很精彩，讓我們的感情越來越深厚。",
        "gal_map_text_207101331=墨茗臉頰微紅，輕聲說。",
        "gal_map_text_207101332=我願意。從相處的細節來看，我們很合拍。我們可以一起制定“旅行讀書計畫”，先從周邊的獨立書店開始，逐步實現更多目標，讓我們的感情在共同體驗中不斷升溫。",
        "gal_map_text_207101333=墨茗臉頰微紅，眼裡滿是溫柔。",
        "gal_map_text_207101334=我願意……我一直期待能有一個人陪我做喜歡的事，你就是那個人。我喜歡你，想和你一起奔赴未來，把每一個約定都變成現實，讓每一段時光都充滿書香與浪漫。",
        "gal_map_text_207101335=墨茗主動抱住你。",
        "gal_map_text_207101336=我願意！我好感動，你知道嗎？我一直都喜歡你，也一直想和你一起做很多事。以後有你陪著我，不管什麼困難都能克服，一起把生活過得像好書一樣，內容豐富而溫暖。",
        "gal_map_text_207101337=我們現在就創建“未來旅行讀書約定”備忘錄，把想讀的書、想去的地方都列上去。第一個約定，就是下週末一起來逛這家書店的新書區，再去打卡那家小眾咖啡館。",
        "gal_map_text_207101338=好呀！好呀！我還要加上“一起參加讀書分享會”“一起收藏喜歡的畫冊”，讓我們的未來充滿更多有意義的體驗。",
        "gal_map_text_207101339=墨茗看著你，眼裡滿是期待。",
        "gal_map_text_207101340=書店的風鈴輕輕作響，閉店音樂漸漸淡去在夜色中。唐笑笑主動挽住你的胳膊，將那枚指南針徽章別在你的衣襟上，指尖在你胸口輕輕停留片刻，抬頭對你笑時，眼裡閃著溫柔的光。",
        "gal_map_text_207101341=你們並肩走出門廊，踏入微涼的夜色，街道上的霓虹與書店的暖光交織在彼此身上。從這一刻起，你們正式成為情侶，那些關於書籍、旅行與共鳴的約定，都化作此刻緊緊相挽的溫度。",
        "gal_map_text_207101342=書店的閉店音樂輕柔地響起，店員開始整理書架。你們在滿室書香中走到門口，推開那扇掛著小風鈴的玻璃門，夜晚微涼的空氣撲面而來，與室內的溫暖形成鮮明對比。",
        "gal_map_text_207101343=墨茗沒有立刻走入夜色，而是在門廊下的燈光裡轉過身，背靠著店門旁的磚牆。身後是即將沉入寂靜的書店宇宙，面前是流動的城市夜晚。墨茗手裡捏著那枚小小的指南針徽章，指尖輕輕摩挲著表面。",
        "gal_map_text_207101344=感覺像是……從一場很長很深的夢裡，慢慢浮上來。夢裡有好多別人的故事和風景……但牽著我的手，帶我逛遍這個夢的人，是你。",
        "gal_map_text_207101345=這場“夢境”因為有你才更珍貴。和你一起分享書籍、討論風景、暢想未來，比任何故事都更動人，我想把這場“夢”變成一輩子的現實。",
        "gal_map_text_207101346=墨茗被你說得臉頰微紅，指尖輕輕將徽章握得更緊，身體微微向你靠近，距離你只有半步之遙。門廊的燈光映在墨茗臉上，勾勒出柔和的輪廓，墨茗眼裡閃著溫柔與期待，輕聲說：“現實會不會比夢境更美好？”",
        "gal_map_text_207101347=旅行序言",
        "gal_map_text_207101348=珍貴回憶",
        "gal_map_text_207101349=默契延續",
        "gal_map_text_207101350=墨茗，今晚和你一起逛書店、分享書籍、寫“旅行序言”，每一刻都讓我很開心。我發現自己喜歡上你了，很真誠地喜歡你。我不想只和你做朋友，想做那個能一直陪著你的人，讓你每天都開開心心的，一起把生活過得像好書一樣，溫柔而浪漫。",
        "gal_map_text_207101351=墨茗臉頰微紅，抬頭對你笑。",
        "gal_map_text_207101352=謝謝你的喜歡，我也喜歡你。我願意和你在一起，以後我們可以經常來這裡逛書店，一起創造更多開心的時光，一起分享更多好書與故事。",
        "gal_map_text_207101353=墨茗主動握住你的手。",
        "gal_map_text_207101354=我願意！能被你喜歡，我很開心。我也喜歡你，以後我們就是情侶了，要一起體驗更多有趣的事，一起逛遍更多書店，一起解鎖更多生活樂趣。",
        "gal_map_text_207101355=墨茗眼神軟下來。",
        "gal_map_text_207101356=我…… 我願意。我也喜歡你，和你在一起我覺得很安心。以後有你陪著我，不管是逛書店還是分享心情，都覺得很有底氣，生活也會變得更美好。",
        "gal_map_text_207101357=墨茗身體微微向你靠近。",
        "gal_map_text_207101358=我願意！我一直都很喜歡你，只是不敢說。你喜歡我，我真的太開心了，我願意做你的女朋友，一直跟著你逛書店、讀好書、過生活。",
        "gal_map_text_207101359=以後不管是讀什麼書，我都會第一時間和你分享感悟；不管去哪裡旅行，都會給你帶當地的特色書籍。週末我們就來解鎖這家書店的藝術畫冊區，怎麼樣？",
        "gal_map_text_207101360=太好了！我已經開始期待了，和你在一起，不管做什麼都覺得很有意義。",
        "gal_map_text_207101361=墨茗輕輕握住你的手，眼裡閃著光芒。",
        "gal_map_text_207101362=墨茗，在這樣的氛圍裡，我想告訴你：我喜歡你。和你在一起的感覺很美好，不管是逛書店還是聊天，都讓我覺得很舒服。我想和你一直這樣，做彼此最親近的人，把每一個相處的瞬間都變成珍貴的回憶。",
        "gal_map_text_207101363=墨茗眼睛亮起來。",
        "gal_map_text_207101364=我願意！我也喜歡你！這裡的氛圍真的很浪漫，就像你給我的感覺一樣。以後我們要在這裡留下更多回憶，讓書店見證我們的每一個甜蜜瞬間，一起分享更多好書。",
        "gal_map_text_207101365=墨茗拉著你的手比心。",
        "gal_map_text_207101366=我願意~願意~願意！太開心了！太開心了！我們趕緊拍張合照，發朋友圈宣告我們在一起啦。以後每次來這裡，都要紀念一下我們的戀愛紀念日，一起讀一本情侶專屬好書。",
        "gal_map_text_207101367=墨茗輕輕靠向你。",
        "gal_map_text_207101368=我也喜歡你。在這樣浪漫的氛圍裡，能聽到你的告白，我真的很幸福。以後我想一直和你在一起，永遠不分開，一起把日子過得像好書一樣溫柔浪漫。我願意……",
        "gal_map_text_207101369=墨茗語氣帶著哽咽。",
        "gal_map_text_207101370=我願意！我好開心，這裡的一切都很美好，和你在一起的感覺更美好。我願意做你的女朋友，永遠陪著你，一起體驗書店與生活的浪漫。",
        "gal_map_text_207101371=我們在書店門口拍張合照吧，就以這扇風鈴門為背景，紀念我們的心動時刻。以後看到這張照片，就能想起今晚的浪漫與幸福。",
        "gal_map_text_207101372=好呀！讓徽章也一起入鏡，見證我們的愛情。",
        "gal_map_text_207101373=墨茗主動靠近你，手裡舉著那枚指南針徽章。",
        "gal_map_text_207101374=墨茗，聽著你分享旅行故事、解讀藝術畫冊的聲音，都讓我覺得格外投緣。我想把這份默契延續下去，不止今晚，以後的每一天都想和你這樣同行，做彼此最合拍的人，一起逛遍更多書店、分享更多故事，一起把生活過得更有意義。",
        "gal_map_text_207101375=墨茗低頭淺笑。",
        "gal_map_text_207101376=我也有同感。和你一起逛書店的時候，我從來沒有這麼放鬆過。我願意和你在一起，一起逛更多書店、分享更多故事，讓我們的羈絆越來越深，成為最好的伴侶。",
        "gal_map_text_207101377=墨茗語氣自信。",
        "gal_map_text_207101378=當然！能和我這麼有默契的人不多，你算一個。我願意和你在一起，以後我們一起看更多展、讀更多書，一起成為別人羡慕的情侶。",
        "gal_map_text_207101379=墨茗臉頰輕輕摩挲你的手背。",
        "gal_map_text_207101380=我願意……我一直都很依賴你，有你在身邊，不管遇到什麼難關都覺得能過去。我願意和你一起同行，永遠跟著你，一起分享好書、體驗生活。",
        "gal_map_text_207101381=墨茗緊緊拉住你的手。",
        "gal_map_text_207101382=我願意！我也覺得和你很有默契，和你在一起我很安心。我願意和你一起走以後的路，永遠不分開，做你一輩子的“小跟班”，一起體驗所有美好。",
        "gal_map_text_207101383=以後不管是讀什麼書還是去哪裡旅行，我們都保持這份默契，互相分享、互相支持，一起把每一件事都做好。週末我們就來解鎖這家書店的旅行書籍區，一起規劃我們的第一次旅行。",
        "gal_map_text_207101384=好呀！我相信我們不管遇到什麼，都能像今晚一樣默契配合，把生活過得越來越美好。",
        "gal_map_text_207101385=墨茗輕輕握住你的手，眼裡帶著期待。",
        "gal_map_text_207101386=書店的風鈴輕輕作響，閉店音樂漸漸淡去在夜色中。唐笑笑主動挽住你的胳膊，將那枚指南針徽章別在你的衣襟上，指尖在你胸口輕輕停留片刻，抬頭對你笑時，眼裡閃著溫柔的光。",
        "gal_map_text_207101387=你們並肩走出門廊，踏入微涼的夜色，街道上的霓虹與書店的暖光交織在彼此身上。從這一刻起，你們正式成為情侶，那些關於書籍、旅行與共鳴的約定，都化作此刻緊緊相挽的溫度。",
        "gal_map_text_207101388=你們手牽著手走到店門口，正要踏入夜色，墨茗忽然輕輕 “啊” 了一聲，拉住了你的手腕。“等一下…… 有東西，差點忘了給你。” 墨茗眼裡閃著狡黠的光，示意你在門口的長椅上稍坐，自己轉身快步跑回店內深處。",
        "gal_map_text_207101389=幾分鐘後，墨茗捧著一個扁平的深灰色硬殼盒子回來，在你身邊坐下，小心翼翼地將盒子放在你膝上。“之前和你聊起喜歡沉浸式遊戲音效，你說普通耳機還原度不夠，” 墨茗輕聲解釋，手指輕輕點了點盒子，“這個是我托朋友找的專業級開放式監聽耳機，音質很准，不管是玩遊戲還是聽音樂，都能感受到最真實的聲音。”",
        "gal_map_text_207101390=你打開盒子，一副深色金屬與皮質結合的耳機靜靜躺在裡面，保養得極好，泛著溫潤的光澤。當你的手指觸碰到耳罩內側時，才發現上面用極細的銀色絲線繡著兩個幾乎看不見的字母 —— 是你們名字的縮寫，緊緊交織在一起。",
        "gal_map_text_207101391=墨茗臉頰微紅。",
        "gal_map_text_207101392=繡得很隱蔽，只有我們自己知道，就像我們的默契，不用張揚，卻一直都在。以後不管你玩什麼遊戲，聽什麼歌，都能想起我在你身邊陪著你。",
        "gal_map_text_207101393=你拿起耳機輕輕戴上，仿佛能聽到墨茗心跳的溫柔旋律。",
        "gal_map_text_207101394=墨茗靠在你的肩膀上，看著夜色中的路燈，輕聲說。",
        "gal_map_text_207101395=以後我們的‘共同冒險’，不止有遊戲，還有耳機裡的每一段旋律，和身邊的每一個瞬間。",
        "gal_map_text_207101396=兩人並肩坐在長椅上，耳機的溫度與掌心的溫度相互傳遞，成為彼此最珍貴的羈絆。",
        "gal_map_text_207101397=你們並肩走出遊戲店，來到明亮的街道上。墨茗讓你在路邊稍等，轉身跑進旁邊一家還亮著燈的遊戲周邊小店，很快就提著一個印有圖元風格圖案的小紙袋跑了回來，臉上帶著燦爛的笑容。“給，補給包！” 墨茗把紙袋塞進你手裡，語氣裡滿是雀躍。",
        "gal_map_text_207101398=你打開紙袋，裡面是一個定制雕刻的胡桃木機械鍵盤腕托，弧度貼合手掌，打磨得光滑細膩，清晰的木紋透著自然的質感。腕托正面，用鐳射雕刻著一行簡潔的英文：“Press Any Key to Continue…”（按下任意鍵繼續…），而在句子末尾，一個小小的圖元愛心代替了句號，格外可愛。",
        "gal_map_text_207101399=墨茗撓了撓頭，有些羞澀地說。",
        "gal_map_text_207101400=之前看你玩遊戲的時候，手腕總是沒地方放，這個腕托戴著很舒服，而且……“按下任意鍵繼續”，就像我們的故事，才剛剛開始，以後還有好多好多章節要一起解鎖。",
        "gal_map_text_207101401=墨茗的手指輕輕劃過那個圖元愛心。",
        "gal_map_text_207101402=這個愛心是我特意加的，代表不管遇到什麼，只要我們在一起，就能一直‘繼續’下去。",
        "gal_map_text_207101403=你握住腕托，胡桃木的溫潤觸感從手指傳來。你輕輕把墨茗拉到身邊，讓墨茗靠在你的懷裡，輕聲說",
        "gal_map_text_207101404=以後我的每一次‘按鍵’，都是為了和你一起繼續我們的故事。",
        "gal_map_text_207101405=兩人在路燈下相視一笑，腕托上的圖元愛心在燈光下仿佛活了過來，見證著這份剛剛開始的情侶羈絆。",
        "gal_map_text_207101406=你們手牽著手走出遊戲店，晚風輕輕吹過，帶著夜晚的清涼氣息。墨茗沒有拿出任何信物，只是緊緊握著你的手，腳步放慢，沿著街道慢慢散步。",
        "gal_map_text_207101407=墨茗抬頭看著你，眼裡滿是溫柔。",
        "gal_map_text_207101408=今晚真的很開心，從試玩台的配合到現在，感覺時間過得好快，但每一個瞬間都很珍貴。",
        "gal_map_text_207101409=墨茗靠在你的肩膀上，看著遠處遊戲店的燈光。",
        "gal_map_text_207101410=以後我們可以經常來這裡，玩新出的雙人遊戲，解鎖更多隱藏結局，也可以只是像現在這樣，安靜地坐著聊天。",
        "gal_map_text_207101411=你輕輕撫摸著墨茗的頭髮，輕聲回應",
        "gal_map_text_207101412=管是玩遊戲還是聊天，只要和你在一起，就很有意義。",
        "gal_map_text_207101413=墨茗抬起頭，對你露出一個甜蜜的笑容，主動湊近你，額頭輕輕碰了碰你的額頭。",
        "gal_map_text_207101414=以後的每一天，都想和你這樣，簡單而快樂。",
        "gal_map_text_207101415=墨茗輕聲說。",
        "gal_map_text_207101416=我們的“共同冒險”，才剛剛開始呢。",
        "gal_map_text_207101417=兩人在長椅上依偎著，感受著彼此的體溫與心跳，夜色中的燈光將他們的影子拉得很長，成為情侶間最純粹的美好回憶。",
        "gal_map_text_207101418=你們走出時光修補鋪，夜色漸濃，街邊的路燈亮起暖黃的光，空氣中還殘留著木蠟油和皮革的溫潤氣息。墨茗沒有拿出任何信物，只是和你並肩走在青石板路上，手指偶爾碰在一起，帶來細微的暖意。",
        "gal_map_text_207101419=墨茗輕聲說，腳步放慢。",
        "gal_map_text_207101420=其實手工的意義，不在於做出多完美的成品，而在於一起打磨時光的過程呀。",
        "gal_map_text_207101421=以後我們不用每次都來店裡做手工，在家也可以嘗試簡單的項目。週末一起網購材料包，做個小相框、打磨個木勺，哪怕做得不完美也沒關係，重要的是一起專注做事的感覺。",
        "gal_map_text_207101422=你點頭附和。",
        "gal_map_text_207101423=我也覺得。和你一起研究工具、討論步驟，哪怕不小心弄灑拋光膏、磨錯邊角，都是很珍貴的回憶。",
        "gal_map_text_207101424=墨茗笑著停下腳步，轉身面對你。",
        "gal_map_text_207101425=以後我們做彼此的“手工合夥人”，不用追求複雜的工藝，就從簡單的小事開始。做完的小物件不用特意珍藏，放在家裡當擺設，每次看到都能想起一起製作的時光，這就夠了。",
        "gal_map_text_207101426=兩人並肩走在夜色中，聊著以後想嘗試的手工項目，從皮革掛件到木質書簽，沒有宏大的規劃，只有對平淡日常的期待。沒有專屬的手工信物，卻有想一起度過的慢時光，這種細水長流的陪伴，最是動人。",
        "gal_map_text_207101427=你們站在時光修補鋪的門廊下，正要推開厚重的木門走入夜色，墨茗忽然輕輕拉住了你的衣袖。",
        "gal_map_text_207101428=墨茗眼裡帶著溫柔的笑意，示意你稍等，轉身快步走回店內那片暖黃的光暈中。",
        "gal_map_text_207101429=等等…… 我差點忘了。",
        "gal_map_text_207101430=墨茗捧著一個用深藍色亞麻布仔細包裹的物件回來，亞麻布層層展開，一個定制的老式活頁筆記本封面映入眼簾。深棕色的植鞣革手工縫製而成，邊緣有細緻的敲邊痕跡，皮革表面帶著天然的紋理和溫潤光澤，摸起來厚實而有質感。",
        "gal_map_text_207101431=封面正中，沒有任何多餘的花紋或 Logo，只有一個用黃銅螺絲和精密合頁牢固鑲嵌的復古黃銅齒輪。墨茗用手指輕輕撥動齒輪，齒輪緩緩轉動，發出極其細微、令人愉悅的 “哢噠” 聲。",
        "gal_map_text_207101432=墨茗輕聲說。",
        "gal_map_text_207101433=之前和你一起打磨材料的時候，你說喜歡齒輪轉動的聲音，覺得那是時光的聲音，這個齒輪是可以一直轉動的，就像我們的關係，會在時光裡慢慢沉澱，越來越牢固。",
        "gal_map_text_207101434=墨茗拿起你的手，讓你觸摸那個轉動的齒輪。",
        "gal_map_text_207101435=植鞣革會隨著使用慢慢變色，就像我們一起經歷的日子，會留下專屬的痕跡。以後我們可以給它加活頁紙，記錄下每一個值得珍藏的瞬間，讓這個封面，裝滿我們的故事。",
        "gal_map_text_207101436=你握緊這個帶著溫度的筆記本封面，齒輪還在手指輕輕轉動。你把墨茗擁入懷中，輕聲說",
        "gal_map_text_207101437=以後我們的每一個故事，都要寫在這上面，讓時光和齒輪一起，見證我們的美好。",
        "gal_map_text_207101438=墨茗靠在你的懷裡，聽著齒輪的 “哢噠” 聲，臉上滿是幸福的笑容。",
        "gal_map_text_207101439=你們走出時光修補鋪，來到清冷的街道上。墨茗讓你在路燈下稍等，自己小跑著去了街角一家還在營業的文創小店，回來時手裡拿著一個印著店鋪 Logo 的小紙袋，笑著遞給你：“給，補給品。”",
        "gal_map_text_207101440=你打開紙袋，一個復古鐵盒映入眼簾，打開鐵盒，裡面是一套高品質的 “迷你工具套裝”—— 一把帶多種可換刀頭的精密螺絲刀、一把多功能小鉗子、一枚放大鏡，還有幾個不同尺寸的戒指調整棒。工具都是迷你尺寸，做工精良，閃著金屬的冷光，小巧得可以輕鬆放進隨身口袋。",
        "gal_map_text_207101441=墨茗解釋道，眼裡滿是體貼。",
        "gal_map_text_207101442=之前和你一起做手工，發現你總愛琢磨小物件，而且平時也總遇到眼鏡松了、飾品需要調整的小問題，這個套裝很實用，以後不管你在哪裡，遇到這些小麻煩，都能自己解決。",
        "gal_map_text_207101443=墨茗調皮地眨了眨眼。",
        "gal_map_text_207101444=也可以用來幫我修東西，就像我們一起打磨材料那樣，互相幫忙，互相守護。",
        "gal_map_text_207101445=你拿起那把精密螺絲刀，手指能感受到它的質感。你輕輕握住墨茗的手，把鐵盒放進墨茗的手心。",
        "gal_map_text_207101446=以後我們一起用這套工具，不僅修理小物件，還一起‘修理’生活裡的小不開心，一起守護我們的小幸福。",
        "gal_map_text_207101447=兩人在路燈下相視一笑，鐵盒裡的工具仿佛也成為了彼此羈絆的見證。",
        "gal_map_text_207101448=你們手牽著手走出時光修補鋪，空氣中還殘留著皮革和木蠟的香氣。墨茗沒有拿出信物，只是放慢腳步，和你一起在夜色中散步，手指還殘留著打磨材料後的微熱觸感。",
        "gal_map_text_207101449=墨茗輕聲說，轉頭看著你，眼裡滿是滿足。",
        "gal_map_text_207101450=和你一起製作手工的時光，真的很治癒。",
        "gal_map_text_207101451=墨茗頭靠在你的肩膀上。",
        "gal_map_text_207101452=那種慢慢打磨、慢慢拼湊的感覺，就像我們的關係，雖然平淡，卻很踏實。以後我們可以經常來這裡，做更多的手工，嘗試不同的材料，把生活裡的小美好都“打磨”成專屬我們的回憶。",
        "gal_map_text_207101453=你輕輕撫摸著墨茗的頭髮，感受著墨茗的體溫",
        "gal_map_text_207101454=我喜歡這種踏實的感覺，和你在一起，不管做什麼都覺得很安心。以後不管是製作手工，還是面對生活裡的小事，我都想和你一起，慢慢走，慢慢感受。",
        "gal_map_text_207101455=墨茗抬起頭，對你露出一個溫柔的笑容，主動握住你的手，掌心的溫度相互傳遞。兩人在長椅上依偎著，夜色中的暖黃燈光將他們的影子疊在一起，就像他們一起製作的手工製品，充滿了時光的溫度與專屬的美好。",
        "gal_map_text_207101456=你們走出時光修補鋪，夜色漸濃，街邊的路燈亮起暖黃的光，空氣中還殘留著木蠟油和皮革的溫潤氣息。墨茗沒有拿出任何信物，只是和你並肩走在青石板路上，手指偶爾碰在一起，帶來細微的暖意。",
        "gal_map_text_207101457=墨茗輕聲說，腳步放慢。",
        "gal_map_text_207101458=其實手工的意義，不在於做出多完美的成品，而在於一起打磨時光的過程呀。",
        "gal_map_text_207101459=以後我們不用每次都來店裡做手工，在家也可以嘗試簡單的項目。週末一起網購材料包，做個小相框、打磨個木勺，哪怕做得不完美也沒關係，重要的是一起專注做事的感覺。",
        "gal_map_text_207101460=你點頭附和。",
        "gal_map_text_207101461=我也覺得。和你一起研究工具、討論步驟，哪怕不小心弄灑拋光膏、磨錯邊角，都是很珍貴的回憶。",
        "gal_map_text_207101462=墨茗笑著停下腳步，轉身面對你",
        "gal_map_text_207101463=以後我們做彼此的“手工合夥人”，不用追求複雜的工藝，就從簡單的小事開始。做完的小物件不用特意珍藏，放在家裡當擺設，每次看到都能想起一起製作的時光，這就夠了。",
        "gal_map_text_207101464=兩人並肩走在夜色中，聊著以後想嘗試的手工項目，從皮革掛件到木質書簽，沒有宏大的規劃，只有對平淡日常的期待。沒有專屬的手工信物，卻有想一起度過的慢時光，這種細水長流的陪伴，最是動人。",
        "gal_map_text_207101465=你們站在書店門廊下，閉店音樂已經停止，店員也已經下班。墨茗從隨身的大帆布包裡拿出一個用深灰色再生紙仔細包裹的扁平包裹，眼裡帶著期待的光芒：“這個，是給你的。”",
        "gal_map_text_207101466=你拆開再生紙，一個實木材質的老式圖書館索引卡抽屜盒出現在眼前。表面塗著啞光清漆，能觸摸到細膩的木紋，大小正好可以放進大衣口袋或隨身包。你滑開盒蓋，裡面整齊排列著數十張質感極佳的米白色索引卡片，每張卡片頂端都印著不同的分類標籤 ——“靈感碎片”、“待訪之地”、“值得重讀的句子”、“想與你分享的風景”、“共同記憶的頁碼”……",
        "gal_map_text_207101467=墨茗輕聲說，手指輕輕劃過卡片上的標籤.",
        "gal_map_text_207101468=之前和你在書店裡聊起喜歡記錄生活，這個盒子可以用來裝我們的”故事碎片”。你讀到喜歡的句子可以寫在”值得重讀的句子”裡，想到想去的地方可以記在”待訪之地”裡，我們一起經歷的事情，就寫在”共同記憶的頁碼”裡。",
        "gal_map_text_207101469=你翻開盒蓋內側，上面用鐳射雕刻著一行清晰的小字：“To be continued…”（未完待續…），下方還有一行更小的字：“Vol. 1: Our First Chapter.”（第一卷：我們的第一章）。",
        "gal_map_text_207101470=墨茗臉頰微紅。",
        "gal_map_text_207101471=這只是第一卷，以後我們還會有第二卷、第三卷，裝滿更多的卡片，更多的故事。",
        "gal_map_text_207101472=你握緊這個小巧的索引盒，仿佛握住了你們未來的無數可能。你把墨茗拉到身邊，輕聲說。",
        "gal_map_text_207101473=以後我們的每一個故事，每一個瞬間，都要記在這些卡片上，讓這個盒子，裝滿我們的一輩子。",
        "gal_map_text_207101474=墨茗靠在你的懷裡，聽著晚風的聲音，眼裡滿是對未來的憧憬。",
        "gal_map_text_207101475=你們走出書店，墨茗從隨身的紙袋裡拿出一個小巧的物件，遞到你面前：“這個，送給你。”",
        "gal_map_text_207101476=那是一個黃銅材質的復古風格 “已閱” 日期印章，手柄打磨得光滑溫潤，底部雕刻著精緻的書本與羽毛筆圖案。旁邊還放著一小盒可更換的日期字釘和一小罐印泥。",
        "gal_map_text_207101477=墨茗笑著解釋，拿起印章在手心輕輕按了一下，留下一個清晰的 “書本” 圖案和空白的日期欄。",
        "gal_map_text_207101478=之前和你聊起看書的時候，總想來個”心動標記”這個是真的可以蓋的，以後你讀到喜歡的句子，看到心動的地方，或者…… 經歷了任何想標記為”重要一天”的日子，就給它蓋上。",
        "gal_map_text_207101479=墨茗拿起日期字釘，認真地說。",
        "gal_map_text_207101480=日期可以自己換，就像我們的故事，每一天都值得被標記，被珍藏。以後我們一起看書，一起經歷更多值得紀念的日子，就用這個印章，把它們都“蓋”在記憶裡。",
        "gal_map_text_207101481=黃銅印章在路燈下泛著溫潤的光，就像你們之間的感情，細膩而長久。",
        "gal_map_text_207101482=你接過印章，手指能感受到黃銅的質感與溫度。你輕輕把墨茗擁入懷中說。",
        "gal_map_text_207101483=以後每一個和你有關的日子，都是值得被標記的“重要一天”。我會用這個印章，把我們的幸福，一一記錄下來。",
        "gal_map_text_207101484=墨茗靠在你的懷裡，臉上滿是甜蜜的笑容，晚風輕輕吹過，帶著書香與幸福的氣息。",
        "gal_map_text_207101485=你們手牽著手走出書店，夜晚微涼的空氣撲面而來，帶著淡淡的書香。墨茗沒有拿出信物，只是緊緊握著你的手，和你一起在街道上慢慢散步。",
        "gal_map_text_207101486=墨茗輕聲說，呼出的氣息在燈光下化作一小團白霧。",
        "gal_map_text_207101487=今晚就像一場美好的夢。夢裡有書，有故事，還有你。",
        "gal_map_text_207101488=墨茗靠在你的肩膀上。",
        "gal_map_text_207101489=以後我們可以一起逛更多的書店，讀更多的書，分享更多的故事。我想讓書香，一直陪伴著我們的感情。",
        "gal_map_text_207101490=你輕輕撫摸著墨茗的頭髮，輕聲回應。",
        "gal_map_text_207101491=我喜歡和你一起逛書店的感覺，喜歡聽你分享讀書心得，喜歡這種安靜而浪漫的氛圍。以後不管是逛書店，還是分享心事，我都想和你一起，讓我們的感情像好書一樣，越讀越有味道。",
        "gal_map_text_207101492=墨茗抬起頭，對你露出一個溫柔的笑容，主動湊近你，嘴唇輕輕碰了碰你的臉頰。兩人在長椅上依偎著，感受著彼此的心跳與呼吸，夜色中的書香仿佛也為這份感情增添了幾分浪漫與長久，成為情侶間最純粹的美好。",
        "gal_map_text_207101493=你們走出書店，晚風帶著舊書頁的清香，街邊的燈籠亮著暖黃的光，營造出靜謐的氛圍。墨茗沒有拿出任何信物，只是和你並肩走在老街的石板路上，手裡還捧著今晚挑選的兩本書。",
        "gal_map_text_207101494=墨茗輕聲說，翻開手裡的書，指著其中一頁",
        "gal_map_text_207101495=其實最好的紀念，不是某件具體的東西，而是想一直和你分享的心情。",
        "gal_map_text_207101496=以後我們不用特意來書店打卡，在家也可以一起讀書。週末的下午，泡兩杯熱茶，各自看自己喜歡的書，偶爾分享看到的有趣句子，不用刻意找話題，安靜的陪伴就很好。",
        "gal_map_text_207101497=你看著墨茗認真的側臉，心裡滿是暖意",
        "gal_map_text_207101498=我也喜歡這種感覺。和你一起逛書店、分享書籍，讓我覺得讀書不再是孤單的事。以後我們可以建一個“共讀清單”，一起讀同一本書，交流讀後感，或者各自推薦喜歡的作品，讓彼此的世界變得更豐富。",
        "gal_map_text_207101499=墨茗笑著點頭。",
        "gal_map_text_207101500=以後不管是開心還是難過，都可以通過書籍分享心情。你推薦的書，我一定認真讀；我喜歡的句子，也想第一個告訴你。這種字裡行間的陪伴，不用轟轟烈烈，卻能長久溫暖。",
        "gal_map_text_207101501=兩人並肩走在石板路上，偶爾停下腳步翻看手裡的書，分享看到的精彩片段。老街的燈籠將兩人的影子映在地面上，緊緊相依。沒有華麗的文創信物，卻有想一起分享的每一本書、每一份心情，這種融入日常的陪伴，最是長久。",
        "gal_map_text_207101502=唐笑笑忽然從隨身包裡拿出一個小小的、印有 “時光集章” 字樣的皮質小冊子，笑著遞給你。",
        "gal_map_text_207101503=“其實，還有一個‘隱藏驚喜’。”",
        "gal_map_text_207101504=你打開小冊子，裡面是 6 個空白的集章頁，每個頁面都印著對應信物的簡約圖案（耳機、腕托、筆記本封面、工具套裝、索引盒、印章）。",
        "gal_map_text_207101505=“之前每個信物都有一個對應的‘集章碼’，你收集到的每一個信物，都能在這裡蓋上專屬印章。”",
        "gal_map_text_207101506=她解釋道，指尖輕輕點了點頁面。從包裡拿出一個迷你印章，在你收集到的信物對應的頁面上一一蓋章，每蓋一個，頁面上的圖案就會浮現出對應的文字說明。當蓋完第 4 個印章時，小冊子最後一頁自動展開，上面印著一段文字。",
        "gal_map_text_207101507=“集齊 4 枚信物，解鎖‘餘生序章’—— 我們的故事，不止於此刻，不止於信物，而是每一個並肩的日子，每一次心動的瞬間，每一份彼此的守護。”",
        "gal_map_text_207101508=小冊子旁邊還放著一張小小的卡片，上面寫著一站：一起去實現索引卡裡的‘待訪之地’，用耳機聽遍喜歡的旋律，用筆記本記錄每一個手工時光，讓所有的信物，都成為我們餘生的見證。",
        "gal_map_text_207101509=“信物只是載體，真正珍貴的是我們在一起的時光。但這些信物，會像一個個座標，標記著我們感情裡的每一個重要節點。以後我們還會收集更多的‘座標’，一起走完這漫長的餘生。”",
        "gal_map_text_207101510=你握緊手中的集章冊和信物，感受著她的體溫與心意。兩人在夜色中相視一笑，所有的信物都在燈光下泛著溫潤的光，見證著這份圓滿的感情，也開啟了屬於你們的 “餘生序章”。",
        "gal_map_text_205100000=週末傍晚的商業街，霓虹初上，人流如織，空氣裡飄蕩著各種美食與活力的氣息。卡通雕塑噴泉前水花四濺，周圍是店鋪的燈光與人群的歡聲笑語，暖黃與霓虹交織，營造出熱鬧又浪漫的氛圍。",
        "gal_map_text_205100001=你和唐笑笑在約定的卡通雕塑噴泉前順利碰面。唐笑笑剛跑過來，額角帶著細密的汗珠，臉上卻掛著燦爛的笑容，眼神亮晶晶的，像藏著星星。短暫的寒暄後，唐笑笑轉頭打量著周圍令人眼花繚亂的店鋪和燈光，手指不自覺地拽了拽背包帶子，語氣裡滿是興奮又帶著點選擇困難：“這裡比我想像的還要熱鬧呢，感覺每個地方都想去看看。我們是先去…… 哪裡好呢？”",
        "gal_map_text_205100002=跑過來沒累著吧？先喘口氣，不急著做決定。你平時更愛動手體驗的項目，還是安靜點的地方？我都可以陪你。",
        "gal_map_text_205100003=好啦，這點路不算什麼！我其實都挺感興趣的，不過動手做東西好像更有意思，但屋頂農場聽起來也很特別。",
        "gal_map_text_205100004=唐笑笑踮起腳尖，視線在三個方向來回掃視，嘴裡小聲嘀咕著：“甜品實驗聽起來甜甜的，扭蛋店肯定超有趣，屋頂農場能看夜景…… 選擇困難症要犯啦！” 唐笑笑轉頭看向你，眼裡帶著期待，雙手不自覺地攥著背包帶，身體微微前傾，等著你的提議。",
        "gal_map_text_205100005=甜夢研究所-創意甜品",
        "gal_map_text_205100006=奇趣膠囊-迷你扭蛋",
        "gal_map_text_205100007=星光露臺-屋頂農場",
        "gal_map_text_205100008=看你剛才提到甜品時眼睛都亮了，我們先去甜夢研究所吧，親手做甜品應該會很有成就感，做完還能一起分享。",
        "gal_map_text_205100009=唐笑笑抬手拍了拍你的肩膀，眼神堅定，腳步輕快地率先往前走。",
        "gal_map_text_205100010=就喜歡動手做東西！我要自己設計口味，你可以給建議但不許干涉我的創意～",
        "gal_map_text_205100011=唐笑笑一把拽住你的胳膊往甜品店方向跑，發梢翻飛。",
        "gal_map_text_205100012=太對我胃口了！早就想試試創意甜品了，放心我全程不拖後腿，說不定最後我的作品比你還驚豔！",
        "gal_map_text_205100013=唐笑笑微微低頭，手指輕輕勾住你的袖口，聲音帶著點軟糯。",
        "gal_map_text_205100014=甜品店好像挺有意思的，不過我動手能力不太好，你要多幫我呀，全程不許嫌我笨。",
        "gal_map_text_205100015=唐笑笑仰頭看著你，眼睛亮晶晶的，身體不自覺地靠近你。",
        "gal_map_text_205100016=我都聽你的，你選的地方肯定都好～ 我對做甜品一竅不通，等下全靠你指導，你可別丟下我一個人。",
        "gal_map_text_205100017=扭蛋店的燈光看著就很吸引人，而且能收集小物件，說不定能抽到隱藏款，我們去試試手氣？",
        "gal_map_text_205100018=唐笑笑眼睛一亮，主動拉住你的手腕往扭蛋店方向走，腳步輕快。",
        "gal_map_text_205100019=扭蛋店也太有意思了吧！我們比賽誰抽到的款式更特別，輸的人要請喝奶茶哦～",
        "gal_map_text_205100020=唐笑笑蹦蹦跳跳地拽著你跑，語氣雀躍。",
        "gal_map_text_205100021=哇塞太好啦！我超喜歡收集扭蛋，聽說這家有隱藏款，我們趕緊去試試手氣，一定要抽到隱藏款！",
        "gal_map_text_205100022=唐笑笑輕輕點點頭，拉著你的手慢慢走，語氣平靜。",
        "gal_map_text_205100023=扭蛋店確實挺合適的，不會太吵鬧還能放鬆。我們慢慢逛，不用著急，抽到什麼都是緣分。",
        "gal_map_text_205100024=唐笑笑依舊拉著你的手，腳步平穩，眼神卻帶著期待。",
        "gal_map_text_205100025=嗯，這個選擇不錯。扭蛋收集挺有紀念意義，而且節奏舒緩，不會太趕，就選這個了。",
        "gal_map_text_205100026=屋頂農場人應該少點，能安靜看夜景，不過如果你更想去熱鬧的地方，我們可以換。",
        "gal_map_text_205100027=唐笑笑立刻拉著你的手往屋頂農場方向走，語氣乾脆。",
        "gal_map_text_205100028=屋頂農場挺好的！能看夜景還能體驗採摘，安靜又有氛圍，比擠在人多的地方舒服多了。",
        "gal_map_text_205100029=唐笑笑拽著你大步流星地走，臉上笑容燦爛。",
        "gal_map_text_205100030=太懂我了！我就想找個清淨點的地方，人多的地方太鬧了。等下採摘我肯定比你摘得多，我們比比看！",
        "gal_map_text_205100031=唐笑笑輕輕拉著你的手，腳步放緩，語氣溫柔。",
        "gal_map_text_205100032=屋頂農場好像挺浪漫的，我有點怕人多擁擠，安靜的地方更自在些。",
        "gal_map_text_205100033=唐笑笑微微低頭，耳尖泛紅，手指輕輕勾著你的手。",
        "gal_map_text_205100034=謝謝你選這個，其實我不太喜歡熱鬧的環境。屋頂農場聽起來很安心，麻煩你等下多照顧我，我有點怕高。",
        "gal_map_text_205100035=放心，我只給建議絕不插手你的創意，不過要是遇到搞不定的步驟，隨時喊我，我來搭把手。",
        "gal_map_text_205100036=這還差不多！等下我要做一款獨一無二的甜品，讓你嘗嘗我的厲害，不過…… 要是調不好比例，你可不許笑我。",
        "gal_map_text_205100037=唐笑笑轉頭對你做了個鬼臉，腳步卻沒放慢。",
        "gal_map_text_205100038=行啊，比賽就比賽，我可不會手下留情。不過要是你抽到隱藏款，奶茶我請也沒關係，就當沾沾你的好運。",
        "gal_map_text_205100039=才不用你讓呢！我運氣超好的，肯定能抽到隱藏款，到時候你可別忘了請我喝全糖奶茶。",
        "gal_map_text_205100040=唐笑笑轉頭對你揚起下巴，眼裡滿是鬥志。",
        "gal_map_text_205100041=怕高的話不用勉強靠近欄杆，我們找個安全的地方坐著看夜景就好。採摘的話也不急，慢慢逛，喜歡哪顆摘哪顆。",
        "gal_map_text_205100042=嗯！有你在我就放心多了。聽說屋頂的草莓特別甜，等下我們一起找找最紅的那顆，摘下來一起分享。",
        "gal_map_text_205100043=唐笑笑抬頭看向你，眼裡滿是安心的笑意。",
        "gal_map_text_205100044=你根據唐笑笑的選擇確定了目的地，唐笑笑立刻興奮地拉著你往場館方向走，腳步輕快得像只雀躍的小鹿。路過擁擠的人群時，唐笑笑會下意識地拉緊你的手，把你往內側拉，自己走在靠近人流的一邊。偶爾遇到街頭表演，唐笑笑會停下腳步看得入神，還會拉著你一起鼓掌，臉上的笑容比霓虹還要耀眼。",
        "gal_map_text_205100045=走到場館門口時，唐笑笑轉頭對你眨眨眼：“希望這裡不會讓我失望呀，要是不好玩，可是要罰你再陪我去下一個地方的！”",
        "gal_map_text_205100046=跟著唐笑笑的腳步，你們踏入了選定的場館。獨特的氛圍瞬間包裹住兩人，熱鬧的互動專案讓人眼花繚亂，而一場突如其來的小意外，正悄悄拉近你們的距離，成為你展現高情商的絕佳契機。",
        "gal_map_text_205100047=走進甜夢研究所，馬卡龍色的牆面搭配燒杯造型的桌椅，燈光柔和得像實驗室頂燈，空氣中彌漫著奶油與水果的香甜氣息。服務員遞上兩件印著卡通燒瓶圖案的迷你實驗服圍裙，穿上後更添了幾分趣味。",
        "gal_map_text_205100048=你們選好座位坐下，桌上擺滿了各種顏色的 “試劑” 和 “配料”，像真正的實驗台。服務員介紹完製作流程後，唐笑笑立刻躍躍欲試，拿起滴管就要往奶油基底里加 “星空藍莓爆爆珠”。",
        "gal_map_text_205100049=唐笑笑手一抖，幾滴藍色的爆爆珠不僅沒滴進碗裡，反而濺到了唐笑笑的圍裙上，還有幾顆滾落到了操作臺上。唐笑笑愣了一下，隨即皺起眉頭，有點懊惱地跺腳：“哎呀，怎麼這麼不小心！”",
        "gal_map_text_205100050=別急別急，圍裙髒了沒關係，我幫你擦一下。操作臺上的爆爆珠也別浪費，我們撿起來用小盒子裝著，等下可以點綴在成品上。",
        "gal_map_text_205100051=唐笑笑：都怪我手太笨了，本來想做個完美的甜品呢。",
        "gal_map_text_205100052=唐笑笑蹲下身撿爆爆珠時，頭髮垂了下來，擋住了視線，幾次都差點碰到操作臺。你看著唐笑笑有些狼狽又倔強的樣子，忍不住想幫唐笑笑一把。唐笑笑察覺到你的目光，抬頭看你，眼裡帶著點委屈又不服輸的神色：“我能自己撿起來，不用你幫忙！” 可話音剛落，唐笑笑就因為沒看清，手指碰到了一顆黏糊糊的爆爆珠，下意識地縮回手，皺起了鼻子。",
        "gal_map_text_205100053=幫唐笑笑遞工具",
        "gal_map_text_205100054=提議換方案補救",
        "gal_map_text_205100055=調侃唐笑笑笨手笨腳",
        "gal_map_text_205100056=頭髮擋著視線呢，我幫你把頭髮別到耳後，再給你個小鑷子，撿起來會方便很多。",
        "gal_map_text_205100057=唐笑笑眼睛亮晶晶的，主動湊近你，讓你幫唐笑笑整理頭髮，嘴角掛著燦爛的笑容。",
        "gal_map_text_205100058=哇你也太細心了！謝謝你幫我攏頭髮，有了鑷子果然方便多了！",
        "gal_map_text_205100059=唐笑笑身體緊緊靠向你，腦袋輕輕蹭過你的肩膀。",
        "gal_map_text_205100060=太靠譜了吧！你居然注意到我頭髮擋視線，有你在真的太省心了～ 等下做好甜品我分你一大半！",
        "gal_map_text_205100061=唐笑笑表情依舊有些冷淡，但還是接過了鑷子，低頭繼續撿爆爆珠。",
        "gal_map_text_205100062=不用麻煩你，我自己也能弄。不過…… 謝謝你的鑷子，確實方便些。",
        "gal_map_text_205100063=唐笑笑皺起眉頭，推開你的手，自己用手指笨拙地把頭髮別到耳後，語氣帶著點不耐煩。",
        "gal_map_text_205100064=我都說了不用你幫忙，你這樣反而讓我有點不自在。",
        "gal_map_text_205100065=能幫到你就好，我們一起加油，肯定能做出超棒的甜品。等下做好了，我先嘗一口，給你打分。",
        "gal_map_text_205100066=那你可要手下留情，打分太低我可不依！",
        "gal_map_text_205100067=唐笑笑拿起勺子舀起奶油，小心翼翼地鋪在杯底，時不時側頭看你，嘴角帶著笑意。",
        "gal_map_text_205100068=其實我們可以換個思路，把爆爆珠鋪在杯壁上，做個 “星空杯” 效果，說不定比原本的設計更特別。",
        "gal_map_text_205100069=唐笑笑興奮地拍手，拿起鑷子開始撿爆爆珠，動作比之前熟練了不少。",
        "gal_map_text_205100070=這個想法也太妙了吧！“星空杯” 聽起來就超浪漫，我們趕緊試試，肯定能做出最特別的甜品！",
        "gal_map_text_205100071=唐笑笑蹦蹦跳跳地配合你，眼裡滿是雀躍。",
        "gal_map_text_205100072=哇塞太有創意了！原來還能這麼做，你也太聰明了吧～ 我們趕緊動手，做完一定要拍好多照片發朋友圈！",
        "gal_map_text_205100073=唐笑笑輕輕點頭，拿起爆爆珠往杯壁上貼，語氣平靜。",
        "gal_map_text_205100074=這個補救方案挺穩妥的，比硬撿起來靠譜。我們慢慢弄，不用著急，成品應該會不錯。",
        "gal_map_text_205100075=唐笑笑依舊專注操作，語氣平淡，卻悄悄加快了手上的動作。",
        "gal_map_text_205100076=嗯，這個思路可行。爆爆珠散落也不是壞事，換個呈現方式反而更有特色。",
        "gal_map_text_205100077=能幫到你就好，我們一起加油，肯定能做出超棒的甜品。等下做好了，我先嘗一口，給你打分。",
        "gal_map_text_205100078=放心吧，有我的創意加你的技術，肯定能拿滿分！",
        "gal_map_text_205100079=唐笑笑興奮地攪拌著配料，偶爾會舀一勺遞到你嘴邊，讓你試味。",
        "gal_map_text_205100080=看來你果然不是做手工的料，要不還是我來主導，你在旁邊看著就行？",
        "gal_map_text_205100081=唐笑笑撅起嘴巴，不服氣地瞪著你，手裡的動作卻更認真了。",
        "gal_map_text_205100082=哼，你才笨呢！我只是不小心而已，等下做出來肯定比你做的好吃！",
        "gal_map_text_205100083=唐笑笑伸手輕輕捶了捶你的胳膊，臉上卻帶著點委屈。",
        "gal_map_text_205100084=討厭！不許嘲笑我！我只是第一次做沒經驗，再給我一次機會，肯定能做好！",
        "gal_map_text_205100085=唐笑笑紅臉低頭，聲音輕輕，手指攥著衣角。",
        "gal_map_text_205100086=我…… 我確實有點手笨，不過我會努力學的。你要是不想讓我幫忙，我在旁邊看著就好。",
        "gal_map_text_205100087=唐笑笑聲音帶著點委屈，頭埋得更低，差點哭出來。",
        "gal_map_text_205100088=對不起，我是不是給你添麻煩了？我真的不是故意的，我會儘量不拖你後腿。",
        "gal_map_text_205100089=能幫到你就好，我們一起加油，肯定能做出超棒的甜品。等下做好了，我先嘗一口，給你打分。",
        "gal_map_text_205100090=不用你看，我自己能做好。",
        "gal_map_text_205100091=唐笑笑埋頭專注於操作，不再理你，只是操作不順而小聲歎氣。",
        "gal_map_text_205100092=唐笑笑看著成品，臉上露出了滿意的笑容，主動拿起勺子舀了一勺遞給你：“嘗嘗看，還不錯吧？” 你嘗了一口，甜而不膩，口感豐富。唐笑笑緊張地看著你的表情，眼裡滿是期待。你誇讚唐笑笑做得好，唐笑笑立刻得意地揚起下巴：“那當然，我可是很有天賦的！” 離開甜夢研究所時，唐笑笑手裡還拿著打包的甜品，時不時會喂你一口，腳步輕快，心情明顯好了很多。",
        "gal_map_text_205100093=走進奇趣膠囊，整面牆的扭蛋機閃爍著各色燈光，從動漫角色到呆萌動物，再到神秘化石、迷你樂器，千奇百怪的小玩意讓人眼花繚亂。空氣裡彌漫著塑膠蛋殼的輕微氣味和人們扭動旋鈕時的期待感，耳邊是此起彼伏的歡呼與惋惜聲。",
        "gal_map_text_205100094=唐笑笑立刻被 “天空之城” 系列扭蛋吸引，拉著你跑到對應的扭蛋機前，眼裡滿是興奮：“我要抽這個藍色飛行石，看起來超酷的！” 唐笑笑從錢包裡拿出硬幣，用力塞進扭蛋機，可硬幣卻彈了出來，掉在地上滾到了機器底下。唐笑笑彎腰去撿，卻因為機器太低，怎麼也夠不著，急得臉頰通紅，嘴裡小聲嘟囔：“討厭，怎麼偏偏掉進去了！”",
        "gal_map_text_205100095=別著急，我來幫你撿，你蹲在旁邊小心點，別碰到頭。",
        "gal_map_text_205100096=都怪我太用力了，硬幣才會彈出去。你小心點，不行就算了，我再換個硬幣。",
        "gal_map_text_205100097=你費了點勁終於把硬幣撿了出來，遞給唐笑笑。唐笑笑接過硬幣，剛想再次塞進扭蛋機，卻發現機器的投幣口好像有點卡住了，硬幣怎麼也塞不進去。唐笑笑試了好幾次，手指都被磨紅了，還是沒成功，氣得跺腳：“什麼破機器，關鍵時刻掉鏈子！” 周圍有幾個人看了過來，唐笑笑的臉頰更紅了，有些不好意思地低下頭。",
        "gal_map_text_205100098=找工作人員維修",
        "gal_map_text_205100099=換機器幫唐笑笑抽獎",
        "gal_map_text_205100100=吐槽機器品質差",
        "gal_map_text_205100101=別硬塞了，手都紅了，我去叫工作人員來看看，你在這裡等著，別再碰了。",
        "gal_map_text_205100102=唐笑笑興奮地跳起來，拉住你的胳膊，眼神裡滿是期待。",
        "gal_map_text_205100103=謝謝你呀，你真是太靠譜了！我就知道你能幫我解決問題，等下抽到飛行石我們一起拍照！",
        "gal_map_text_205100104=唐笑笑緊緊抱住你的胳膊，身體幾乎貼在你身上。",
        "gal_map_text_205100105=哇塞你也太好了吧！不僅幫我撿硬幣還幫我叫工作人員，等下抽到獎品我分你一半，不，全部給你都行！",
        "gal_map_text_205100106=唐笑笑表情平靜，但眼神裡帶著感激，輕輕揉了揉發紅的手指。",
        "gal_map_text_205100107=麻煩你了，我在這裡等著。其實換個機器也可以，不用太執著於這一台。",
        "gal_map_text_205100108=唐笑笑語氣平淡，卻下意識地吹了吹發紅的手指。",
        "gal_map_text_205100109=不用這麼麻煩，換個機器就行，沒必要叫工作人員。不過…… 謝謝你關心我的手。",
        "gal_map_text_205100110=放心吧，一定幫你抽到想要的。你先找個地方坐下休息，我處理好就來找你。",
        "gal_map_text_205100111=好呀，我在這邊等你，你快點回來！",
        "gal_map_text_205100112=唐笑笑找了個座位坐下，眼睛一直盯著你和工作人員的方向，手裡攥著手機準備拍照。",
        "gal_map_text_205100113=這台機器可能壞了，旁邊還有一台同款的，我幫你去抽，肯定能抽到你想要的藍色飛行石。",
        "gal_map_text_205100114=唐笑笑笑著點頭，跟在你身邊，時不時拍一下扭蛋機，像是在給你加油。",
        "gal_map_text_205100115=好呀好呀！你一定要幫我抽到藍色飛行石，抽到了我請你喝奶茶！",
        "gal_map_text_205100116=唐笑笑嘴裡還哼著歌。",
        "gal_map_text_205100117=太好啦！我就知道你運氣好，肯定能抽到我想要的！等下抽到了我們要拍好多合照，還要發朋友圈炫耀！",
        "gal_map_text_205100118=唐笑笑平靜地站在一旁，眼神卻緊緊盯著扭蛋機的出口。",
        "gal_map_text_205100119=換機器是個明智的選擇，這台確實可能故障了。你慢慢抽，不用著急，抽到什麼都可以。",
        "gal_map_text_205100120=唐笑笑語氣平淡，卻悄悄往你身邊挪了挪，方便看清操作。",
        "gal_map_text_205100121=嗯，換台機器效率更高。辛苦你跑一趟，不管結果怎麼樣，都謝謝你。",
        "gal_map_text_205100122=放心吧，一定幫你抽到想要的。你先找個地方坐下休息，我處理好就來找你。",
        "gal_map_text_205100123=那我跟你一起去，給你加油打氣！說不定我的好運能傳染給你呢。",
        "gal_map_text_205100124=唐笑笑緊緊跟在你身邊，腳步輕快，嘴裡還哼著歌。",
        "gal_map_text_205100125=這機器品質也太差了，早知道就不該來這家店，浪費時間。",
        "gal_map_text_205100126=唐笑笑拉著你的手往回走，語氣帶著點勸說。",
        "gal_map_text_205100127=別這麼說嘛，可能只是偶爾故障而已，再試試別的機器說不定就行。",
        "gal_map_text_205100128=唐笑笑拽著你走向旁邊的扭蛋機，怒氣衝衝卻帶著期待。",
        "gal_map_text_205100129=就是！這破機器太耽誤事了，早知道就換一家了！不過既然來了，再試試旁邊的，說不定能抽到更好的！",
        "gal_map_text_205100130=唐笑笑小聲勸說，眼神裡帶著點不舍。",
        "gal_map_text_205100131=其實…… 也不用這麼生氣，可能只是暫時卡住了。我們再耐心試試，實在不行再走也不遲。",
        "gal_map_text_205100132=唐笑笑聲音帶著點懇求，拉著你的衣角輕輕晃動。",
        "gal_map_text_205100133=我覺得…… 再試試也沒關係，我真的很想要那個藍色飛行石。如果實在不行，我們再離開好不好？",
        "gal_map_text_205100134=別不高興呀，其實前面還有一家扭蛋店，聽說款式更多，我們去那裡試試，肯定能抽到更好的。",
        "gal_map_text_205100135=真的嗎？那我們快去看看，希望能抽到喜歡的款式。",
        "gal_map_text_205100136=唐笑笑眼神裡重新燃起希望，拉著你的手快步往外走，腳步比之前輕快了不少。",
        "gal_map_text_205100137=最終你成功幫唐笑笑抽到了想要的藍色飛行石，唐笑笑拿到手後興奮地跳了起來，緊緊攥著扭蛋，臉上的笑容燦爛得像陽光。唐笑笑小心翼翼地打開扭蛋，拿出藍色飛行石，仔細端詳著，然後轉頭對你眨眨眼：“都是你的功勞，謝謝你！” 唐笑笑主動把飛行石遞到你面前，讓你一起欣賞，手指不經意間碰到你的手，停留了幾秒才縮回。離開奇趣膠囊時，唐笑笑把飛行石放進背包裡，時不時會拿出來看看，嘴裡還小聲嘀咕：“這是今天最棒的收穫！”",
        "gal_map_text_205100138=乘坐觀光電梯緩緩升至商業街建築的頂層，“叮” 的一聲，門開了。推開門，一陣混合著泥土、青草和隱約花香的清新空氣撲面而來，瞬間將樓下的喧囂隔絕。木質步道穿梭在種植箱之間，高高的藤架下掛著星星燈，草莓像紅寶石般點綴在綠葉中，小番茄沉甸甸地壓彎了枝頭。",
        "gal_map_text_205100139=遠處，城市的輪廓在漸暗的天色中亮起點點燈火，與露臺上暖黃色的燈光交織在一起，浪漫又靜謐。你們沿著木質步道往前走，唐笑笑被路邊的草莓田吸引，蹲下身想要採摘。唐笑笑拿起農場提供的小剪刀，小心翼翼地對準一顆又大又紅的草莓，可剛要剪下去，卻不小心剪到了自己的手指，雖然沒有流血，但手指立刻紅了一片。唐笑笑皺起眉頭，吸了口氣：“嘶，好痛！”",
        "gal_map_text_205100140=怎麼這麼不小心，快讓我看看。",
        "gal_map_text_205100141=都怪我太心急了，想摘那顆最大的草莓，結果反而剪到了手。",
        "gal_map_text_205100142=唐笑笑貼好創可貼後，看著那顆誘人的草莓，眼裡滿是不甘，又想伸手去摘。你擔心唐笑笑再次受傷，想阻止唐笑笑，可唐笑笑卻倔強地搖搖頭：“我一定要摘到那顆草莓，不能白受傷。” 唐笑笑再次拿起剪刀，因為手指有點疼，動作變得更加笨拙，剪刀在草莓梗上晃來晃去，就是剪不下去。",
        "gal_map_text_205100143=手把手教唐笑笑採摘",
        "gal_map_text_205100144=幫唐笑笑摘送專屬草莓",
        "gal_map_text_205100145=阻止唐笑笑放棄採摘",
        "gal_map_text_205100146=別硬來，我手把手教你，左手扶著草莓，右手拿著剪刀對準梗的根部，輕輕一剪就好了。",
        "gal_map_text_205100147=唐笑笑身體微微僵硬了一下，隨即放鬆下來，跟著你的動作一起剪草莓，臉頰泛紅。",
        "gal_map_text_205100148=哇你靠得好近！不過這樣確實好操作，謝謝你教我，我終於學會怎麼摘草莓了！",
        "gal_map_text_205100149=唐笑笑緊緊靠在你懷裡，跟著你的動作操作，聲音雀躍。",
        "gal_map_text_205100150=太幸福了吧！你手把手教我也太溫柔了～ 學會了學會了，我現在要自己摘好多好多，都分給你吃！",
        "gal_map_text_205100151=唐笑笑身體保持一定距離，卻認真跟著你的動作，語氣平淡。",
        "gal_map_text_205100152=不用靠這麼近，我自己看著也能學。不過…… 謝謝你教我，確實比我自己瞎試強。",
        "gal_map_text_205100153=唐笑笑輕輕掙了掙，想自己操作，語氣帶著點抗拒。",
        "gal_map_text_205100154=我自己也能學會，不用你這樣手把手教，有點不自在。",
        "gal_map_text_205100155=馬上就好，保證摘到讓你滿意的草莓。你要是喜歡，以後我們可以經常來，我陪你一起採摘。",
        "gal_map_text_205100156=好呀好呀，以後一定要經常來！你教得真不錯，我已經學會怎麼摘草莓了。",
        "gal_map_text_205100157=唐笑笑興奮地拍手，拿起剪刀自己試著摘了一顆小草莓，遞到你嘴邊。",
        "gal_map_text_205100158=你在這裡等著，我幫你把那顆草莓摘下來，再挑幾顆更大更紅的，給你做一個專屬草莓花束。",
        "gal_map_text_205100159=唐笑笑興奮地拍手，坐在旁邊的小凳子上，眼睛一直盯著你摘草莓的動作。",
        "gal_map_text_205100160=哇塞太好啦！你真好，還願意幫我摘草莓，等下我要把最大的那顆吃掉！",
        "gal_map_text_205100161=唐笑笑蹦蹦跳跳地圍著你轉，眼裡滿是期待。",
        "gal_map_text_205100162=救命！這也太浪漫了吧！專屬草莓花束，我一定要拍照發朋友圈，讓所有人都羡慕我！",
        "gal_map_text_205100163=唐笑笑平靜地接過草莓花束，輕輕放在手裡，語氣溫和。",
        "gal_map_text_205100164=謝謝你特意幫我摘，其實不用這麼麻煩，一顆就夠了。不過還是很感謝你的心意。",
        "gal_map_text_205100165=唐笑笑認真地接過草莓花束，眼神裡帶著一絲感激，語氣平淡。",
        "gal_map_text_205100166=辛苦你了，麻煩你跑一趟。草莓很漂亮，我很喜歡，謝謝你。",
        "gal_map_text_205100167=馬上就好，保證摘到讓你滿意的草莓。你要是喜歡，以後我們可以經常來，我陪你一起採摘。",
        "gal_map_text_205100168=哇，這顆草莓好大！謝謝你，這個草莓花束我要好好保存。",
        "gal_map_text_205100169=接過你遞來的草莓花束，小心翼翼地捧在手裡，臉上滿是笑容。",
        "gal_map_text_205100170=別摘了，都已經受傷了，萬一再剪到怎麼辦？草莓哪裡都能買到，沒必要在這裡冒險。",
        "gal_map_text_205100171=唐笑笑奪回剪刀，繼續嘗試採摘，語氣倔強。",
        "gal_map_text_205100172=我才不要放棄！就差一點點了，我肯定能摘到的，你別阻止我！",
        "gal_map_text_205100173=唐笑笑固執地再次拿起剪刀，眼神堅定。",
        "gal_map_text_205100174=你別管我！我一定要摘到那顆草莓，不然我今天就不走了！",
        "gal_map_text_205100175=唐笑笑聲音帶著點委屈，拉著你的衣角輕輕晃動。",
        "gal_map_text_205100176=我…… 我真的很想要那顆草莓，它看起來真的很好吃。我會小心的，不會再受傷了，再給我一次機會好不好？",
        "gal_map_text_205100177=唐笑笑聲音帶著點失落，慢慢放下剪刀。",
        "gal_map_text_205100178=對不起，我是不是太執著了？可是我真的很想要那顆草莓。如果實在不行，那我就不摘了，我們去看別的吧。",
        "gal_map_text_205100179=抱歉，我不是故意凶你，就是擔心你再次受傷。那邊有現成的草莓禮盒，我們買一盒，裡面的草莓都很大很新鮮。",
        "gal_map_text_205100180=好吧，那我們去買禮盒。其實只要是和你一起，不管做什麼都挺開心的。",
        "gal_map_text_205100181=唐笑笑嘴角露出一絲笑容，拉著你的手往禮品區走，腳步輕快了不少。",
        "gal_map_text_205100182=你們最終摘到了那顆誘人的草莓，唐笑笑小心翼翼地捧著草莓花束，臉上滿是滿足的笑容。唐笑笑拿起一顆草莓，輕輕咬了一口，甜汁四溢，唐笑笑眼睛一亮：“真甜！你也嘗嘗。” 唐笑笑拿起一顆最大的草莓，遞到你嘴邊，眼神裡滿是期待。你咬了一口，確實香甜可口。離開草莓田時，唐笑笑把草莓花束放進背包裡，時不時會拿出來看看，嘴裡還小聲嘀咕：“這是我吃過最甜的草莓。” 你們沿著木質步道繼續往前走，唐笑笑的手偶爾會碰到你的手，每次碰到都會停留幾秒，氣氛變得越來越曖昧。",
        "gal_map_text_205100183=小意外過後，你們的關係變得更加親近。場館內的互動項目成為了感情升溫的催化劑，每一次靠近、每一次對視，都讓曖昧的氛圍在空氣中悄然彌漫。唐笑笑的活潑外向依舊，但偶爾流露出的羞澀與依賴，讓這場愛情攻防戰變得更加有趣。",
        "gal_map_text_205100184=氣氛變得輕鬆而微妙，你們決定製作 “雙子星奶昔”，一人負責一半，調配不同風味再組合。唐笑笑拿著滴管添加 “星空藍莓爆爆珠” 時，再次手抖，幾顆藍色的 “星星” 滾落到操作臺面上。唐笑笑皺起眉頭，有些懊惱地說：“怎麼又掉了，真是太不爭氣了！”",
        "gal_map_text_205100185=沒關係，掉了正好，我們來玩個遊戲，誰先把爆爆珠撿起來放進小杯子裡，誰就贏，輸的人要答應對方一個小要求。",
        "gal_map_text_205100186=好啊，誰怕誰！我肯定能贏你。",
        "gal_map_text_205100187=你們蹲在地上撿爆爆珠，距離越來越近，肩膀時不時會碰到一起。唐笑笑因為著急，頭髮再次垂了下來，擋住了視線，唐笑笑下意識地用手撥開，卻不小心碰到了你的手。你們同時頓了一下，唐笑笑的臉頰瞬間泛紅，卻沒有停下撿爆爆珠的動作，反而加快了速度：“我快贏了！",
        "gal_map_text_205100188=故意讓唐笑笑贏，提出擁抱要求",
        "gal_map_text_205100189=贏了要求喂唐笑笑喝奶昔",
        "gal_map_text_205100190=平手提議，擊掌約定",
        "gal_map_text_205100191=哇，你好厲害，我認輸！我的要求是，讓我抱你一下，就一下。",
        "gal_map_text_205100192=唐笑笑挺直腰板，臉上帶著得意的笑容，主動上前輕輕抱了你一下，很快就鬆開。",
        "gal_map_text_205100193=贏你還不簡單！不過…… 抱一下也可以，就當是獎勵你陪我做甜品。",
        "gal_map_text_205100194=唐笑笑抬手拍了拍你的肩膀，嘴角揚起，主動湊近你抱了一下",
        "gal_map_text_205100195=哼，算你識相！不過別以為這樣就能討好我，下次我可不會讓著你了。",
        "gal_map_text_205100196=唐笑笑微微低頭，臉頰泛紅，小心翼翼地靠近你，輕輕抱了抱你的胳膊",
        "gal_map_text_205100197=哇，我贏啦！抱一下就抱一下，不過你要輕輕的，不許趁機佔便宜哦。",
        "gal_map_text_205100198=唐笑笑聲音帶著點軟糯，主動抱住你的腰，腦袋輕輕靠在你的肩膀上。",
        "gal_map_text_205100199=謝謝你讓著我…… 其實我剛才有點慌，還好你沒贏我。",
        "gal_map_text_205100200=你的擁抱真溫暖，這是我今天收到的最好的獎勵。我們繼續做奶昔，爭取做出最特別的雙子星奶昔。",
        "gal_map_text_205100201=那當然，我做的奶昔肯定超好喝！不過你剛才抱我的時候，我心跳都加速了。",
        "gal_map_text_205100202=唐笑笑臉頰泛紅，拿起勺子攪拌著奶昔，時不時側頭看你。",
        "gal_map_text_205100203=哈哈，我贏了！我的要求是，讓我喂你喝一口我做的奶昔，嘗嘗我的手藝。",
        "gal_map_text_205100204=唐笑笑撅起嘴巴，輕輕喝了一口你遞來的奶昔，眼睛一亮。",
        "gal_map_text_205100205=哼，算你厲害！不過你的奶昔看起來還不錯，我就勉強嘗一口。",
        "gal_map_text_205100206=唐笑笑興奮地湊到你身邊，主動張嘴等著你來喂。",
        "gal_map_text_205100207=哇塞，好好喝！再來一口再來一口！沒想到你手藝這麼好，以後做甜品都要你負責調味！",
        "gal_map_text_205100208=唐笑笑輕輕喝了一口，語氣平靜，卻主動舀了一勺自己做的奶昔遞到你嘴邊。",
        "gal_map_text_205100209=謝謝。你也嘗嘗，味道應該還可以。",
        "gal_map_text_205100210=唐笑笑喝完後微微點頭，拿起勺子攪拌自己的奶昔，眼神卻悄悄瞟向你。",
        "gal_map_text_205100211=味道不錯，比我想像中好。",
        "gal_map_text_205100212=怎麼樣，我的手藝還不錯吧？你做的奶昔也讓我嘗嘗，我要給你打分。",
        "gal_map_text_205100213=確實挺不錯的，比我做的還好喝。不過你要給我打滿分，不然我可不依。",
        "gal_map_text_205100214=唐笑笑笑著把自己做的奶昔遞到你嘴邊，眼神裡滿是期待。",
        "gal_map_text_205100215=剛好同時撿完，算平手！我們擊掌約定，下次再來這裡製作甜品，分個高低。",
        "gal_map_text_205100216=唐笑笑伸出手和你擊掌，手掌用力拍了拍你的手。",
        "gal_map_text_205100217=平手就平手！不過下次我肯定能贏你，到時候你可不許耍賴。",
        "gal_map_text_205100218=唐笑笑興奮地和你擊掌，還額外拍了拍你的胳膊。",
        "gal_map_text_205100219=好！擊掌為定！下次我們不僅要比撿爆爆珠，還要比誰做的甜品更好吃，輸的人要請喝奶茶！",
        "gal_map_text_205100220=唐笑笑輕輕和你擊掌，聲音帶著點羞澀。",
        "gal_map_text_205100221=好呀，那我們就約定下次再分高低。其實…… 剛才我差點就輸了，多虧你放慢了速度。",
        "gal_map_text_205100222=唐笑笑小心翼翼地伸出手，輕輕碰了碰你的手掌。",
        "gal_map_text_205100223=嗯，擊掌約定。如果下次你贏了，我…… 我可以答應你一個不太難的要求。",
        "gal_map_text_205100224=好，下次一定讓著你。不過你做的奶昔看起來很誘人，我們交換著喝怎麼樣？",
        "gal_map_text_205100225=好呀，交換著喝。其實和你一起做甜品真的很開心，下次還要來。",
        "gal_map_text_205100226=唐笑笑拿起你做的奶昔，輕輕喝了一口，臉上露出滿足的笑容。",
        "gal_map_text_205100227=你們順利完成了雙子星奶昔，兩杯奶昔放在一起，藍色和粉色的爆爆珠在燈光下閃爍，像兩顆依偎在一起的星星。唐笑笑看著成品，臉上滿是成就感：“我們真是太厲害了！” 唐笑笑拿起自己的奶昔，喝了一口，然後遞到你嘴邊：“你也嘗嘗我的，看看好不好喝。” 你喝了一口，甜而不膩，口感豐富。",
        "gal_map_text_205100228=唐笑笑緊張地看著你的表情，眼裡滿是期待。你誇讚唐笑笑做得好，唐笑笑立刻得意地揚起下巴：“那當然，我可是很有天賦的！” 離開操作臺時，唐笑笑的手不小心碰到了你的手，兩人都沒有縮回，而是緊緊握在了一起，氣氛變得越來越曖昧。",
        "gal_map_text_205100229=你們選定霜淇淋基底，決定挑戰一個複雜的組合，操作臺上擺滿了各種顏色的 “試劑” 和 “配料”，像真正的實驗台。唐笑笑拿起一個小勺子，想要把巧克力碎末撒在霜淇淋上，可唐笑笑手一抖，巧克力碎末撒多了，鋪滿了整個霜淇淋表面。唐笑笑愣了一下，隨即皺起眉頭：“哎呀，撒太多了，這下怎麼辦？”",
        "gal_map_text_205100230=輪到你描述抽到的離譜卡牌時，你急中生智編了個半真半假的說法。墨茗盯著你的眼睛，試圖找出破綻，忽然眯起眼睛笑了，手指輕輕指著你的眉毛：“你在撒謊對不對？你每次說這種話的時候，右邊眉毛會動一下。” 你心裡一驚，下意識想摸眉毛，卻看到墨茗笑得像只得意的小狐狸。",
        "gal_map_text_205100231=沒關係，撒多了反而更有味道。我們可以再加點奶油，把巧克力碎末蓋住一部分，再點綴幾顆草莓，看起來會更漂亮。",
        "gal_map_text_205100232=真的可以嗎？可是這樣會不會太甜了？我本來想做一個顏值高的霜淇淋，結果搞砸了。",
        "gal_map_text_205100233=你幫著唐笑笑往霜淇淋上擠奶油，唐笑笑站在旁邊，手裡拿著草莓，想要遞給你，可因為距離太近，唐笑笑的手臂不小心碰到了你的手臂，草莓掉在了操作臺上。唐笑笑彎腰去撿，頭髮垂了下來，剛好碰到你的肩膀。唐笑笑立刻直起身，臉頰通紅，有些不好意思地說：“對不起，我不是故意的。”",
        "gal_map_text_205100234=順勢幫唐笑笑攏發",
        "gal_map_text_205100235=提議換造型補救",
        "gal_map_text_205100236=吐槽造型難看",
        "gal_map_text_205100237=沒關係，你的頭髮碰到我了，我幫你把頭髮別到耳後，這樣做事更方便。",
        "gal_map_text_205100238=唐笑笑眼睛亮晶晶的，主動靠近你，讓你幫唐笑笑整理頭髮，身體微微前傾。",
        "gal_map_text_205100239=哇你好細心！謝謝你幫我攏頭髮，你的手指好溫柔。我們一起改造霜淇淋，肯定能做出超棒的造型。",
        "gal_map_text_205100240=唐笑笑身體緊緊靠向你，腦袋輕輕蹭過你的肩膀。",
        "gal_map_text_205100241=靠譜了吧！你居然注意到我頭髮擋視線，有你在真的太省心了～ 等下做好霜淇淋我分你一大半，不，全部給你都行！",
        "gal_map_text_205100242=唐笑笑表情依舊有些冷淡，但還是配合你整理頭髮，低頭繼續操作。",
        "gal_map_text_205100243=不用麻煩你，我自己也能弄。不過…… 謝謝你的幫忙，確實方便些。",
        "gal_map_text_205100244=唐笑笑皺起眉頭，輕輕推開你的手，自己把頭髮別到耳後。",
        "gal_map_text_205100245=我都說了不用你多管閒事，你這樣反而讓我覺得不自在。",
        "gal_map_text_205100246=能幫到你就好，我們一起加油，肯定能做出超棒的霜淇淋。等下做好了，我們一起拍照留念。",
        "gal_map_text_205100247=好呀好呀，一定要拍很多照片！你幫我攏頭髮的時候，我心跳都加速了。",
        "gal_map_text_205100248=唐笑笑興奮地拍手，拿起手機準備拍照，臉頰泛紅。",
        "gal_map_text_205100249=我們可以把這個霜淇淋改造成 “巧克力草莓火山”，把草莓放在中間，周圍撒上巧克力碎末，看起來會很特別。",
        "gal_map_text_205100250=唐笑笑興奮地拍手，拿起巧克力碎末往霜淇淋周圍撒。",
        "gal_map_text_205100251=這個想法也太妙了吧！“巧克力草莓火山” 聽起來就超酷，我們趕緊試試，肯定能成為店裡最特別的霜淇淋！",
        "gal_map_text_205100252=唐笑笑蹦蹦跳跳地配合你，眼裡滿是雀躍。",
        "gal_map_text_205100253=哇塞太有創意了！你也太聰明了吧～ 我們快點動手，做完一定要拍好多照片發朋友圈，讓大家都羡慕我！",
        "gal_map_text_205100254=唐笑笑輕輕點頭，拿起草莓往霜淇淋中間放，語氣平靜。",
        "gal_map_text_205100255=這個補救方案挺穩妥的，比硬撿起來靠譜。我們慢慢弄，不用著急，成品應該會不錯。",
        "gal_map_text_205100256=唐笑笑專注地調整草莓的位置，語氣平淡，卻悄悄加快了手上的動作。",
        "gal_map_text_205100257=嗯，這個思路可行。巧克力碎末多了也不是壞事，換個呈現方式反而更有特色。",
        "gal_map_text_205100258=能幫到你就好，我們一起加油，肯定能做出超棒的霜淇淋。等下做好了，我們一起拍照留念。",
        "gal_map_text_205100259=放心吧，有我的創意加你的技術，肯定能做出超美的霜淇淋。",
        "gal_map_text_205100260=唐笑笑拿起勺子舀起一點霜淇淋，遞到你嘴邊，讓你試味。",
        "gal_map_text_205100261=現在看起來確實有點難看，要不我們重新做一個吧，這次我來主導，你在旁邊看著。",
        "gal_map_text_205100262=唐笑笑撅起嘴巴，不服氣地瞪著你，手裡的動作卻更認真了。",
        "gal_map_text_205100263=哼，你才難看呢！我只是不小心撒多了，等下改造完肯定比你做的好看多了！",
        "gal_map_text_205100264=唐笑笑伸手輕輕捶了捶你的胳膊，臉上帶著點委屈。",
        "gal_map_text_205100265=討厭！不許嘲笑我！我只是第一次做這麼複雜的造型，再給我一次機會，肯定能做好，到時候讓你刮目相看！",
        "gal_map_text_205100266=唐笑笑紅臉低頭，聲音輕輕，手指攥著衣角。",
        "gal_map_text_205100267=我…… 我確實有點手笨，不過我會努力改的。如果你不想讓我幫忙，我在旁邊看著就好，不打擾你。",
        "gal_map_text_205100268=唐笑笑聲音帶著點哽咽，頭埋得更低。",
        "gal_map_text_205100269=對不起，我是不是給你添麻煩了？我真的不是故意的，我會儘量不拖你後腿，你別生氣好不好？",
        "gal_map_text_205100270=抱歉，我不是故意吐槽你，就是想讓成品更完美。這次我們一起做，我聽你的意見。",
        "gal_map_text_205100271=好吧，那我們一起做。其實我也不想搞砸，就是有點手忙腳亂，我會努力跟上你的節奏。",
        "gal_map_text_205100272=唐笑笑語氣緩和下來，拿起巧克力碎末，開始認真地操作。",
        "gal_map_text_205100273=你們最終成功將霜淇淋改造成了 “巧克力草莓火山”，造型獨特，顏值超高。唐笑笑看著成品，臉上滿是成就感：“我們真是太有創意了！” 唐笑笑拿起手機，對著霜淇淋拍了好幾張照片，然後拉著你一起合拍，身體緊緊靠在你身邊，手臂挽著你的胳膊。",
        "gal_map_text_205100274=拍照時，唐笑笑還故意湊近你，臉頰幾乎碰到你的臉，嘴角帶著燦爛的笑容。離開操作臺時，唐笑笑拿起霜淇淋，喂了你一口：“怎麼樣，是不是很好吃？” 你點了點頭，唐笑笑立刻得意地揚起下巴：“那當然，我可是很有天賦的！” 你們一邊吃著霜淇淋，一邊往門口走，氣氛變得越來越曖昧。",
        "gal_map_text_205100275=在你務實的建議下，唐笑笑選擇了穩妥的草莓霜淇淋基底，並謹慎地添加了幾種看起來安全的配料。整個過程平穩有序，如同完成一項普通的點單。可就在唐笑笑準備把霜淇淋裝進杯子裡時，不小心碰倒了旁邊的果醬瓶，紅色的草莓果醬灑在了操作臺上，還濺到了唐笑笑的手上。唐笑笑愣了一下，隨即皺起眉頭：“哎呀，怎麼這麼不小心！”",
        "gal_map_text_205100276=你幫著唐笑笑用果醬裝飾杯子，唐笑笑站在旁邊，手裡拿著勺子，想要幫忙，可因為緊張，手指微微顫抖，勺子差點掉在地上。你下意識地伸手接住，手指碰到了唐笑笑的手指，兩人同時頓了一下。唐笑笑的臉頰瞬間泛紅，眼神有些閃躲，卻沒有縮回手：“謝謝你幫我接住勺子。”",
        "gal_map_text_205100277=別急別急，我幫你擦乾淨。果醬灑了沒關係，我們可以用它來裝飾杯子，讓霜淇淋看起來更有食欲。",
        "gal_map_text_205100278=都怪我太馬虎了，本來想安安穩穩做個霜淇淋，結果還是搞砸了。",
        "gal_map_text_205100279=你幫著唐笑笑用果醬裝飾杯子，唐笑笑站在旁邊，手裡拿著勺子，想要幫忙，可因為緊張，手指微微顫抖，勺子差點掉在地上。你下意識地伸手接住，手指碰到了唐笑笑的手指，兩人同時頓了一下。唐笑笑的臉頰瞬間泛紅，眼神有些閃躲，卻沒有縮回手：“謝謝你幫我接住勺子。”",
        "gal_map_text_205100280=喂唐笑笑嘗果醬",
        "gal_map_text_205100281=提議用果醬做圖案",
        "gal_map_text_205100282=拿紙巾擦掉果醬",
        "gal_map_text_205100283=沒關係，你的手指好軟。這個果醬看起來很甜，你嘗嘗看。",
        "gal_map_text_205100284=唐笑笑眼睛亮晶晶的，主動湊到你身邊，手指蘸起一點果醬遞到你嘴邊。",
        "gal_map_text_205100285=哇你好會撩！這個果醬真的好甜，比草莓還甜。謝謝你喂我，我也喂你嘗一口好不好？",
        "gal_map_text_205100286=唐笑笑身體緊緊靠在你身上，腦袋輕輕蹭著你的肩膀。",
        "gal_map_text_205100287=太甜了吧！不僅果醬甜，你喂我的樣子更甜～ 以後做甜品都要這樣互動，太有意思了！",
        "gal_map_text_205100288=唐笑笑微微張嘴吃掉果醬，語氣平靜，卻下意識地舔了舔嘴唇，臉頰泛起淺紅。",
        "gal_map_text_205100289=謝謝。",
        "gal_map_text_205100290=唐笑笑眼神有些閃躲，輕輕往後退了半步，保持距離。",
        "gal_map_text_205100291=不用這樣，我自己也能嘗。不過…… 謝謝你的好意，果醬確實挺甜的。",
        "gal_map_text_205100292=你的笑容比果醬還甜，這個笑臉霜淇淋真的很特別，我們一定要拍照留念。",
        "gal_map_text_205100293=好呀好呀，我們要拍很多照片！你剛才喂我果醬的時候，我心跳都加速了。",
        "gal_map_text_205100294=唐笑笑興奮地拍手，身體緊緊靠在你身邊，手臂挽著你的胳膊。",
        "gal_map_text_205100295=我們可以用果醬在霜淇淋上畫一個笑臉，讓它變得更可愛。我來畫眼睛，你畫嘴巴怎麼樣？",
        "gal_map_text_205100296=唐笑笑笑著拿起勺子，蘸了一點果醬，在霜淇淋上畫了一個大大的嘴巴。",
        "gal_map_text_205100297=這個主意不錯！我來畫嘴巴，要畫一個大大的笑臉，讓霜淇淋看起來超開心～",
        "gal_map_text_205100298=唐笑笑興奮地拿起果醬瓶，想要往霜淇淋上添加更多圖案。",
        "gal_map_text_205100299=哇塞太可愛了！我們再加點小愛心和星星，把霜淇淋裝飾得漂漂亮亮的，拍照片肯定超好看！",
        "gal_map_text_205100300=唐笑笑輕輕點頭，拿起勺子，幫你補全眼睛的輪廓，語氣平靜。",
        "gal_map_text_205100301=畫笑臉挺有意思的，簡單又可愛。我們慢慢畫，不用太複雜，好看又好吃最重要。",
        "gal_map_text_205100302=唐笑笑專注地看著霜淇淋，提醒你控制果醬的用量。",
        "gal_map_text_205100303=嗯，這樣裝飾確實比單調的霜淇淋好看。不過別畫太多，以免影響口感。",
        "gal_map_text_205100304=你的笑容比果醬還甜，這個笑臉霜淇淋真的很特別，我們一定要拍照留念。",
        "gal_map_text_205100305=放心吧，這個笑臉霜淇淋肯定會很好看。你看，我們合作得多默契。",
        "gal_map_text_205100306=唐笑笑笑著把霜淇淋遞到你嘴邊，讓你先嘗一口。",
        "gal_map_text_205100307=果醬沾在手上不舒服，我幫你擦掉。我們還是快點把霜淇淋裝起來，別再出什麼意外了。",
        "gal_map_text_205100308=唐笑笑搶過你手裡的紙巾，自己輕輕擦拭手上的果醬。",
        "gal_map_text_205100309=不用這麼用力擦啦，我的手都快被你擦紅了！我自己來就好，你別瞎忙活了。",
        "gal_map_text_205100310=唐笑笑皺起眉頭，有些生氣地瞪著你，自己小心翼翼地擦拭。",
        "gal_map_text_205100311=你怎麼這麼粗魯！擦個果醬而已，用這麼大勁幹嘛，想把我手擦破嗎？",
        "gal_map_text_205100312=唐笑笑輕聲勸說，接過你手裡的紙巾，輕輕擦拭。",
        "gal_map_text_205100313=謝謝你幫我擦果醬，不過不用這麼用力，我自己來就好，你先去裝霜淇淋吧。",
        "gal_map_text_205100314=唐笑笑聲音帶著點不好意思，自己慢慢擦拭手上的果醬。",
        "gal_map_text_205100315=我知道你是為我好，不過我自己能處理。麻煩你了，我們快點把霜淇淋裝起來吧，別再出意外了。",
        "gal_map_text_205100316=抱歉，我不是故意催你，就是擔心霜淇淋融化了。其實你做的霜淇淋已經很好看了，不用太在意細節。",
        "gal_map_text_205100317=好吧，那我們快點裝起來。其實和你一起做霜淇淋真的很開心，下次還要來嘗試其他口味。",
        "gal_map_text_205100318=唐笑笑嘴角露出一絲笑容，拿起杯子，小心翼翼地把霜淇淋裝進去。",
        "gal_map_text_205100319=你們最終做出了一個可愛的笑臉霜淇淋，唐笑笑看著成品，臉上滿是滿足的笑容。唐笑笑拿起手機，對著霜淇淋拍了好幾張照片，然後拉著你一起合拍，身體緊緊靠在你身邊，頭輕輕靠在你的肩膀上。",
        "gal_map_text_205100320=拍照時，唐笑笑還故意對著鏡頭做鬼臉，可愛又俏皮。離開甜夢研究所時，唐笑笑手裡拿著霜淇淋，時不時會喂你一口，嘴裡還小聲嘀咕：“這是我吃過最特別的霜淇淋。” 你們沿著商業街往前走，唐笑笑的手偶爾會碰到你的手，每次碰到都會停留幾秒，氣氛變得越來越曖昧。",
        "gal_map_text_205100321=被你封為 “幸運星”，唐笑笑臉上的笑容更甜了。唐笑笑接過遊戲幣，認真地在幾台機器前徘徊，最後停在 “天空之城” 系列前，深吸一口氣，扭動了旋鈕。扭蛋滾了出來，唐笑笑緊張地打開，裡面是一顆漂亮的藍色飛行石，和唐笑笑之前想要的一模一樣。唐笑笑興奮地跳起來：“哇，我抽到了！太幸運了！",
        "gal_map_text_205100322=我就說你是幸運星吧，果然沒讓我失望。這個藍色飛行石真漂亮，和你很配。",
        "gal_map_text_205100323=都是你的功勞，要不是你鼓勵我，我可能都不敢嘗試。這個飛行石我要好好保存，作為今天的紀念。",
        "gal_map_text_205100324=唐笑笑拿著飛行石，興奮地在扭蛋機前轉來轉去，突然被另一台 “星座系列” 扭蛋機吸引。唐笑笑停下腳步，眼神裡滿是好奇：“這個星座扭蛋看起來也很有趣，不知道能不能抽到我的星座。” 唐笑笑轉頭看向你，眼裡帶著期待，雙手不自覺地攥著背包帶：“我們再抽一次好不好？我想抽到我的星座。”",
        "gal_map_text_205100325=陪唐笑笑許願星座",
        "gal_map_text_205100326=幫唐笑笑抽專屬驚喜",
        "gal_map_text_205100327=勸唐笑笑別浪費，理性消費",
        "gal_map_text_205100328=好呀，我們一起抽，我許願抽到和你一樣的星座，這樣我們就有情侶款了。",
        "gal_map_text_205100329=唐笑笑興奮地拍手，拿起遊戲幣，和你一起扭動旋鈕，眼神裡滿是鬥志。",
        "gal_map_text_205100330=好呀好呀，我們一起抽！不過我可不會讓你輕易抽到我的星座，我要自己抽到，證明我的運氣比你好",
        "gal_map_text_205100331=唐笑笑緊緊握著遊戲幣，用力扭動旋鈕，臉上滿是不服輸的神情。",
        "gal_map_text_205100332=哼，想和我抽一樣的星座，沒那麼容易！我一定要先抽到我的星座，讓你羡慕我！",
        "gal_map_text_205100333=唐笑笑雙手合十，閉上眼睛許願，身體微微靠近你。",
        "gal_map_text_205100334=哇，情侶款聽起來好浪漫！我相信你一定能抽到和我一樣的星座，我們一起許願，肯定能實現。",
        "gal_map_text_205100335=唐笑笑微微低頭，臉頰泛紅，聲音帶著點軟糯。",
        "gal_map_text_205100336=其實我也不是一定要抽到，就是覺得和你一起抽扭蛋很開心。不管抽到什麼，只要和你在一起，我都很喜歡。",
        "gal_map_text_205100337=放心吧，一定不會讓你失望。不管抽到什麼，都是我們一起的回憶，我會好好保存。",
        "gal_map_text_205100338=好呀好呀，我們一起許願！希望我們能抽到一樣的星座，這樣就有情侶款了。",
        "gal_map_text_205100339=唐笑笑興奮地閉上眼睛，雙手合十，身體緊緊靠在你身邊。",
        "gal_map_text_205100340=你在這裡等著，我幫你抽，一定幫你抽到你的星座。如果抽到了，就當是給你的驚喜。",
        "gal_map_text_205100341=唐笑笑笑著點頭，跟在你身邊，時不時拍一下扭蛋機，像是在給你加油。",
        "gal_map_text_205100342=好呀好呀！你一定要幫我抽到我的星座，抽到了我請你喝奶茶，還要和你拍好多合照！",
        "gal_map_text_205100343=唐笑笑蹦蹦跳跳地跟著你，嘴裡還哼著歌。",
        "gal_map_text_205100344=太好啦！我就知道你運氣好，肯定能抽到我想要的！等下抽到了我們要發朋友圈炫耀，讓所有人都知道你有多厲害！",
        "gal_map_text_205100345=唐笑笑平靜地站在一旁，眼神卻緊緊盯著扭蛋機的出口。",
        "gal_map_text_205100346=麻煩你了，其實抽不到也沒關係，我就是有點好奇。你慢慢抽，不用著急，重在參與。",
        "gal_map_text_205100347=唐笑笑語氣平淡，卻悄悄往你身邊挪了挪，方便看清操作。",
        "gal_map_text_205100348=辛苦你跑一趟，不管結果怎麼樣，都謝謝你願意幫我。其實有沒有抽到我的星座都無所謂，我已經有飛行石了。",
        "gal_map_text_205100349=放心吧，一定不會讓你失望。不管抽到什麼，都是我們一起的回憶，我會好好保存。",
        "gal_map_text_205100350=哇，你真的抽到了我的星座！太厲害了，謝謝你給我的驚喜。",
        "gal_map_text_205100351=唐笑笑接過你遞來的扭蛋，興奮地打開，臉上滿是笑容。",
        "gal_map_text_205100352=已經抽到喜歡的飛行石了，沒必要再抽了，扭蛋機都是概率問題，很容易浪費錢。",
        "gal_map_text_205100353=唐笑笑拉著你的手往回走，語氣帶著點勸說。",
        "gal_map_text_205100354=別這麼說嘛，抽扭蛋本來就是圖個開心，浪費什麼錢呀。我就想再抽一次，說不定就能抽到我的星座了！",
        "gal_map_text_205100355=唐笑笑拽著你走向扭蛋機，怒氣衝衝卻帶著期待。",
        "gal_map_text_205100356=就是！抽扭蛋就是為了開心，錢算什麼！我今天一定要抽到我的星座，不然我就不走了！",
        "gal_map_text_205100357=唐笑笑小聲勸說，眼神裡帶著點不舍。",
        "gal_map_text_205100358=其實…… 我真的很想要那個星座扭蛋，就再抽一次，就一次好不好？如果沒抽到，我就再也不抽了。",
        "gal_map_text_205100359=唐笑笑聲音帶著點懇求，拉著你的衣角輕輕晃動。",
        "gal_map_text_205100360=我知道你是為我好，不想讓我亂花錢。可是我真的很喜歡那個星座扭蛋，能不能再給我一次機會？",
        "gal_map_text_205100361=抱歉，我不是故意掃你的興，就是覺得沒必要花冤枉錢。如果你真的很想要，我們可以買一個現成的星座模型。",
        "gal_map_text_205100362=好吧，那我們去買模型。其實只要是和你一起，不管做什麼都挺開心的，謝謝你願意遷就我。",
        "gal_map_text_205100363=唐笑笑嘴角露出一絲笑容，拉著你的手往禮品區走，腳步輕快了不少。",
        "gal_map_text_205100364=你們最終抽到了一樣的星座扭蛋，唐笑笑興奮地把兩個扭蛋放在一起，臉上滿是成就感：“我們真是太有緣分了！” 唐笑笑小心翼翼地把扭蛋放進背包裡，和之前抽到的藍色飛行石放在一起。",
        "gal_map_text_205100365=唐笑笑轉頭對你眨眨眼：“這是我們的情侶款，以後不管去哪裡，我都要帶著它。” 離開扭蛋機前，唐笑笑主動拉著你的手，一起在扭蛋機前合拍了一張照片，身體緊緊靠在你身邊，手臂挽著你的胳膊。你們沿著扭蛋店的走廊繼續往前走，唐笑笑的手一直緊緊握著你的手，手心傳來微微的暖意，氣氛變得越來越曖昧。",
        "gal_map_text_205100366=你的 “比賽” 提議讓唐笑笑躍躍欲試。唐笑笑選擇了 “天空之城” 系列，而你選擇了 “復古遊戲機” 系列。兩人同時扭動旋鈕，兩枚扭蛋幾乎同時滾出。唐笑笑緊張地打開 —— 是顆漂亮的藍色飛行石。你打開你的 —— 是一個圖元風格的紅白機小模型。唐笑笑對比著兩件物品，眼睛發亮，之前的比賽心思似乎被看到彼此收穫的喜悅沖淡了：“它們風格完全不一樣，但都好好哦。”",
        "gal_map_text_205100367=確實都很特別，你的藍色飛行石很漂亮，我的紅白機模型也很有年代感。我們來交換著欣賞一下吧，我想看看你的飛行石，你也可以看看我的模型。",
        "gal_map_text_205100368=好呀好呀，你的紅白機模型真可愛！我小時候也玩過類似的遊戲機，真懷念。",
        "gal_map_text_205100369=你們交換著欣賞彼此的扭蛋，距離越來越近，唐笑笑的頭髮垂了下來，剛好碰到你的手臂。唐笑笑立刻直起身，臉頰泛紅，有些不好意思地說：“對不起，我的頭髮碰到你了。” 唐笑笑伸手想要把頭髮別到耳後，卻不小心把紅白機模型掉在了地上。唐笑笑驚呼一聲，立刻蹲下身去撿：“哎呀，對不起，我不是故意的。”",
        "gal_map_text_205100370=揉唐笑笑頭髮",
        "gal_map_text_205100371=提議再比賽",
        "gal_map_text_205100372=責備唐笑笑不小心",
        "gal_map_text_205100373=沒關係，模型沒壞。你的頭髮有點亂，我幫你揉一揉，順順頭髮。",
        "gal_map_text_205100374=唐笑笑興奮地跳起來，拉著你的手走向扭蛋機，身體緊緊靠在你身邊。",
        "gal_map_text_205100375=哇你揉我頭髮的時候好溫柔！模型沒壞就好，我們再比賽一次，這次我一定不會輸，要讓你輸得心服口服！",
        "gal_map_text_205100376=唐笑笑緊緊抱住你的胳膊，身體幾乎貼在你身上。",
        "gal_map_text_205100377=太幸福了吧！你不僅幫我撿模型，還幫我揉頭髮，也太寵我了～ 我們再比賽一次，不管輸贏，我都要和你拍合照！",
        "gal_map_text_205100378=唐笑笑表情依舊有些冷淡，但臉頰泛起淺紅，語氣柔和了些許。",
        "gal_map_text_205100379=我知道了，以後我會小心的。不過謝謝你幫我撿模型，也謝謝你幫我揉頭髮。",
        "gal_map_text_205100380=唐笑笑輕輕掙了掙，想要自己操作，語氣帶著點抗拒。",
        "gal_map_text_205100381=不用這麼麻煩，我自己也能撿，也能整理頭髮。不過…… 謝謝你的好意。",
        "gal_map_text_205100382=好呀，這次我讓著你，不過你要是輸了，可不能耍賴。我們一起抽，看看誰的運氣更好。",
        "gal_map_text_205100383=好呀好呀，你可不許耍賴！不過就算我輸了，你也要答應我一個要求，不許反悔！",
        "gal_map_text_205100384=唐笑笑興奮地拍手，身體緊緊靠在你身邊，眼睛緊緊盯著扭蛋機。",
        "gal_map_text_205100385=看來你還是不敵我，這次算你輸了！我們再比賽一次，誰抽到的扭蛋更特別，輸的人要答應對方一個小要求。",
        "gal_map_text_205100386=唐笑笑笑著拿起遊戲幣，和你一起扭動旋鈕，眼神裡滿是鬥志。",
        "gal_map_text_205100387=哼，這次不算，我們再比一次！不過你要是輸了，可要答應我一個要求，不許耍賴！",
        "gal_map_text_205100388=唐笑笑蹦蹦跳跳地跟著你，手裡緊緊攥著遊戲幣。",
        "gal_map_text_205100389=好呀好呀！我才不會輸呢，這次我一定要抽到比你更特別的扭蛋，讓你知道我的厲害！",
        "gal_map_text_205100390=唐笑笑平靜地拿起遊戲幣，走向扭蛋機，語氣平淡。",
        "gal_map_text_205100391=再比賽一次也可以，不過只是娛樂，不用太較真。我們慢慢抽，享受過程就好。",
        "gal_map_text_205100392=唐笑笑拿起遊戲幣，輕輕扭動旋鈕，專注地看著扭蛋機。",
        "gal_map_text_205100393=比賽可以，不過輸了也別太在意。友誼第一，比賽第二，開心最重要。",
        "gal_map_text_205100394=好呀，這次我讓著你，不過你要是輸了，可不能耍賴。我們一起抽，看看誰的運氣更好。",
        "gal_map_text_205100395=放心吧，我才不會耍賴！這次我一定要抽到比你更特別的扭蛋，讓你輸得心服口服。",
        "gal_map_text_205100396=唐笑笑笑著扭動旋鈕，手裡攥著拳頭，眼神裡滿是期待。",
        "gal_map_text_205100397=你怎麼這麼不小心，還好模型沒壞，要是壞了多可惜。以後拿東西一定要小心點。",
        "gal_map_text_205100398=唐笑笑撅起嘴巴，有些委屈地看著你。",
        "gal_map_text_205100399=我也不是故意的，只是不小心而已，你別這麼凶嘛。我以後會小心的，我們再比賽一次好不好？",
        "gal_map_text_205100400=唐笑笑眼眶微微泛紅，聲音帶著點委屈和生氣。",
        "gal_map_text_205100401=我都說了我不是故意的，你為什麼還要責備我？不就是一個模型嗎，至於這麼生氣嗎？",
        "gal_map_text_205100402=唐笑笑小聲道歉，眼神裡帶著點自責。",
        "gal_map_text_205100403=對不起，我下次會注意的，不會再不小心了。你別生氣了，我們繼續往前走吧，別因為這個影響心情。",
        "gal_map_text_205100404=唐笑笑聲音帶著點哽咽，頭埋得更低。",
        "gal_map_text_205100405=我知道我錯了，不該這麼不小心。你別生氣了，我以後拿東西一定會格外小心，不會再給你添麻煩了。",
        "gal_map_text_205100406=抱歉，我不是故意責備你，就是有點心疼模型。其實你也不是故意的，我不該對你發脾氣。",
        "gal_map_text_205100407=我知道你不是故意的，其實我也很心疼模型。我們繼續往前走吧，看看還有沒有其他有趣的東西，別因為這個不開心了。",
        "gal_map_text_205100408=唐笑笑語氣緩和下來，拉著你的手，腳步輕快了不少。",
        "gal_map_text_205100409=你們最終又抽了一次扭蛋，唐笑笑抽到了一個可愛的迷你盆栽小世界，你抽到了一個神秘的未知生物骨骼標本。唐笑笑看著你的標本，眼睛一亮：“這個標本好特別！我們交換著保存好不好？我用我的盆栽換你的標本。” 你點了點頭，唐笑笑立刻興奮地把盆栽遞給你，接過你的標本，小心翼翼地放進背包裡。",
        "gal_map_text_205100410=離開扭蛋店時，唐笑笑的手一直緊緊握著你的手，時不時會轉頭看你，嘴角帶著燦爛的笑容。你們沿著商業街往前走，氣氛變得越來越曖昧，偶爾的肢體接觸讓彼此的心跳都加速了不少。",
        "gal_map_text_205100411=在你的理性建議下，唐笑笑謹慎地選擇了 “天空之城” 系列，並成功扭出了那顆藍色飛行石。唐笑笑看起來挺滿意，但也只是尋常的開心：“嗯，和展示窗裡的樣品一樣，挺好的。” 唐笑笑微笑著說，把玩著模型。",
        "gal_map_text_205100412=這時，你決定也去扭一個，選擇了唐笑笑剛才也看過但沒選的 “迷你盆栽小世界” 系列。扭蛋打開，裡面是一個透明立方體，封存著一棵微型的、栩栩如生的多肉植物，底下還有模擬的小砂石。",
        "gal_map_text_205100413=這個迷你盆栽真可愛，和你的藍色飛行石很配，我們可以當作情侶款保存。",
        "gal_map_text_205100414=哇，這個盆栽真的好可愛！確實和我的飛行石很配，那我們就當作情侶款吧。",
        "gal_map_text_205100415=唐笑笑拿著迷你盆栽，興奮地在手裡轉來轉去，突然不小心把盆栽掉在了地上。透明立方體沒有摔壞，但裡面的小砂石卻灑了出來。唐笑笑驚呼一聲，立刻蹲下身去撿：“哎呀，對不起，我不是故意的。” 你也蹲下身幫唐笑笑一起撿，唐笑笑的手指不小心碰到了你的手指，兩人同時頓了一下。唐笑笑的臉頰瞬間泛紅，眼神有些閃躲，卻沒有縮回手：“謝謝你幫我。”",
        "gal_map_text_205100416=手指相觸，幫唐笑笑復原",
        "gal_map_text_205100417=提議做專屬裝飾",
        "gal_map_text_205100418=吐槽唐笑笑，笨手笨腳",
        "gal_map_text_205100419=沒關係，你的手指好軟。我們一起把小砂石裝回去，我幫你扶住立方體，你往裡裝。",
        "gal_map_text_205100420=唐笑笑興奮地拍手，身體緊緊靠在你身邊，手指和你的手指一起往立方體裡裝砂石。",
        "gal_map_text_205100421=哇你靠得好近！你的手指好溫柔，我們一起裝砂石，一定要把它復原得和原來一樣漂亮。",
        "gal_map_text_205100422=唐笑笑緊緊靠在你懷裡，跟著你的動作操作，聲音雀躍。",
        "gal_map_text_205100423=太甜了吧！你不僅幫我撿砂石，還幫我扶住立方體，也太細心了～ 我們一定要把它復原得更漂亮，以後當作我們的定情信物！",
        "gal_map_text_205100424=唐笑笑身體保持一定距離，卻認真跟著你的動作，語氣平淡。",
        "gal_map_text_205100425=不用靠這麼近，我自己看著也能學。不過…… 謝謝你幫我，確實比我自己瞎試強。",
        "gal_map_text_205100426=唐笑笑輕輕掙了掙，想自己操作，語氣帶著點抗拒。",
        "gal_map_text_205100427=我自己也能學會，不用你這樣手把手教，有點不自在。",
        "gal_map_text_205100428=能幫到你就好，我們一起加油，肯定能把它復原得更漂亮。等下做好了，我們一起拍照留念。",
        "gal_map_text_205100429=好呀好呀，我們要拍很多照片！你靠在我身邊的時候，我心跳都加速了。",
        "gal_map_text_205100430=唐笑笑興奮地拍手，身體緊緊靠在你身邊，手臂挽著你的胳膊。",
        "gal_map_text_205100431=我們可以在小砂石里加點彩色的亮片，讓它變得更特別。我去旁邊的文創店買一點，你在這裡等著。",
        "gal_map_text_205100432=唐笑笑笑著點頭，坐在旁邊的椅子上，眼睛緊緊盯著你離開的方向。",
        "gal_map_text_205100433=這個主意不錯，加亮片肯定會更漂亮！你快去快回，我在這裡等你，一定要選最閃亮的亮片！",
        "gal_map_text_205100434=唐笑笑蹦蹦跳跳地圍著你轉，眼裡滿是期待。",
        "gal_map_text_205100435=哇塞太有創意了！加亮片之後肯定會更特別，我已經迫不及待想看到成品了！你快去快回，別讓我等太久～",
        "gal_map_text_205100436=唐笑笑平靜地坐在旁邊，看著散落的砂石，語氣溫和。",
        "gal_map_text_205100437=加亮片是個好主意，不過不用太複雜，簡單點綴一下就好。你去吧，我在這裡看著盆栽，等你回來。",
        "gal_map_text_205100438=唐笑笑語氣平淡，坐在椅子上，眼神專注地看著盆栽。",
        "gal_map_text_205100439=可以加亮片，但別太多，以免影響盆栽的整體美感。你去吧，我會在這裡等你，不會亂動的。",
        "gal_map_text_205100440=能幫到你就好，我們一起加油，肯定能把它復原得更漂亮。等下做好了，我們一起拍照留念。",
        "gal_map_text_205100441=我們一起加亮片，肯定能把它變得更漂亮。你快去快回，我等你。",
        "gal_map_text_205100442=唐笑笑笑著對你揮揮手，眼神裡滿是期待。",
        "gal_map_text_205100443=你怎麼這麼不小心，還好立方體沒摔壞。以後拿東西一定要小心點，別再這麼毛手毛腳了。（",
        "gal_map_text_205100444=唐笑笑撅起嘴巴，有些委屈地看著你。",
        "gal_map_text_205100445=我也不是故意的，只是不小心而已，你別這麼說我嘛。我以後會小心的，我們一起把砂石裝回去好不好？",
        "gal_map_text_205100446=唐笑笑眼眶微微泛紅，聲音帶著點生氣和委屈。",
        "gal_map_text_205100447=你憑什麼說我笨手笨腳！我只是不小心掉了而已，你至於這麼嘲笑我嗎？",
        "gal_map_text_205100448=唐笑笑小聲道歉，拿起砂石往立方體裡裝。",
        "gal_map_text_205100449=對不起，我下次會注意的，不會再這麼不小心了。我們一起把砂石裝回去吧，別因為這個影響心情。",
        "gal_map_text_205100450=唐笑笑聲音帶著點哽咽，慢慢往立方體裡裝砂石。",
        "gal_map_text_205100451=我知道我很笨，總是添麻煩。對不起，我會慢慢裝，不會再出錯了，你別再指責我了好不好？",
        "gal_map_text_205100452=抱歉，我不是故意吐槽你，就是有點擔心立方體摔壞。其實你也不是故意的，我不該對你發脾氣。",
        "gal_map_text_205100453=沒關係，我知道你是為我好。這個盆栽真的很可愛，我會好好保存的。",
        "gal_map_text_205100454=唐笑笑嘴角露出一絲笑容，把盆栽放進背包裡，和你的藍色飛行石放在一起。",
        "gal_map_text_205100455=們最終成功復原了迷你盆栽，還加了一些彩色亮片，看起來比原來更漂亮了。唐笑笑看著成品，臉上滿是滿足的笑容：“我們真是太厲害了！” 唐笑笑拿起手機，對著盆栽和飛行石拍了好幾張照片，然後拉著你一起合拍，身體緊緊靠在你身邊，頭輕輕靠在你的肩膀上。",
        "gal_map_text_205100456=離開扭蛋店時，唐笑笑把盆栽和飛行石放進背包裡，時不時會拿出來看看，嘴裡還小聲嘀咕：“這是我們的情侶款，我要好好保存。” 你們沿著商業街往前走，唐笑笑的手偶爾會碰到你的手，每次碰到都會停留幾秒，氣氛變得越來越曖昧。",
        "gal_map_text_205100457=你們一起走到那片草莓田邊，唐笑笑小心地撥開葉子，手指在幾顆熟透的草莓上方徘徊，最後選中了一顆又大又紅的。唐笑笑拿起小剪刀，想要剪下來，可因為手指有點疼（之前剪到過），動作變得有些猶豫。你看著唐笑笑小心翼翼的樣子，忍不住想幫唐笑笑一把：“我來幫你吧，你指給我看哪顆。”",
        "gal_map_text_205100458=就是這顆嗎？我幫你剪下來，你小心點，別碰到葉子上的刺。",
        "gal_map_text_205100459=對，就是這顆！謝謝你，我的手指還有點疼，不太敢用力。",
        "gal_map_text_205100460=你剪草莓的時候，唐笑笑的手不小心碰到了你的手，兩人同時頓了一下。唐笑笑的臉頰瞬間泛紅，眼神有些閃躲，卻沒有縮回手：“對不起，我不是故意的。” 你剪完草莓，遞給唐笑笑，唐笑笑接過草莓，輕輕咬了一口，甜汁四溢，唐笑笑眼睛一亮：“真甜！你也嘗嘗。” 唐笑笑拿起一顆草莓，遞到你嘴邊，手指再次碰到了你的嘴唇。",
        "gal_map_text_205100461=含住草莓",
        "gal_map_text_205100462=咬一半，分享給唐笑笑",
        "gal_map_text_205100463=接過草莓，自己吃",
        "gal_map_text_205100464=真甜，謝謝你喂我。你的手指好軟，碰到我嘴唇的時候，我心跳都加速了。",
        "gal_map_text_205100465=唐笑笑眼睛亮晶晶的，主動湊近你，臉頰泛紅。",
        "gal_map_text_205100466=哇你好會撩！被你碰到嘴唇的時候，我心跳也加速了。這顆草莓真甜，我們再摘幾顆，一起分享好不好？",
        "gal_map_text_205100467=唐笑笑緊緊握住你的手，拿起一顆草莓，慢慢遞到你嘴邊。",
        "gal_map_text_205100468=太甜了吧！不僅草莓甜，你喂我的樣子更甜～ 我也要喂你吃，讓你也感受一下這種甜甜的感覺！",
        "gal_map_text_205100469=唐笑笑微微張嘴，讓你含住草莓，臉頰泛起淺紅，語氣平靜卻帶著一絲羞澀。",
        "gal_map_text_205100470=謝謝。",
        "gal_map_text_205100471=唐笑笑眼神有些閃躲，輕輕往後退了半步。",
        "gal_map_text_205100472=不用這樣，我自己也能吃。不過…… 謝謝你的好意，草莓確實挺甜的。",
        "gal_map_text_205100473=和你在一起，不管做什麼都很甜蜜。我們再摘幾顆草莓，回去做草莓醬，以後可以一起吃。",
        "gal_map_text_205100474=好呀好呀，我們一起做草莓醬！不過你還沒回答我的問題，剛才碰到我嘴唇的時候，你是不是心動了？",
        "gal_map_text_205100475=唐笑笑興奮地拍手，身體緊緊靠在你身邊，眼神裡滿是期待。",
        "gal_map_text_205100476=真甜！我們一人一半，分享這份甜蜜。",
        "gal_map_text_205100477=唐笑笑興奮地拍手，拿起小剪刀，開始摘草莓，動作比之前快了不少。",
        "gal_map_text_205100478=好呀好呀！分享的草莓更甜了～ 我們再摘很多很多草莓，一起分享，把甜蜜傳遞下去！",
        "gal_map_text_205100479=唐笑笑蹦蹦跳跳地摘草莓，嘴裡還哼著歌。",
        "gal_map_text_205100480=哇塞太浪漫了！分享草莓這種事也太甜了吧～ 我們以後不管吃什麼，都要一起分享，做彼此的專屬分享夥伴！",
        "gal_map_text_205100481=唐笑笑平靜地拿起草莓，咬了一口，語氣柔和。",
        "gal_map_text_205100482=分享確實是一件很美好的事。這顆草莓很甜，我們再摘幾顆，慢慢品嘗。",
        "gal_map_text_205100483=唐笑笑拿起小剪刀，輕輕剪下一顆草莓，專注地看著草莓田。",
        "gal_map_text_205100484=嗯，分享能讓快樂加倍。這顆草莓味道不錯，我們繼續摘，不用著急，慢慢享受採摘的過程。",
        "gal_map_text_205100485=和你在一起，不管做什麼都很甜蜜。我們再摘幾顆草莓，回去做草莓醬，以後可以一起吃。",
        "gal_map_text_205100486=好主意！草莓醬肯定很好吃，我們摘多點，回去一起做。",
        "gal_map_text_205100487=唐笑笑笑著點頭，拿起剪刀，自己試著摘了一顆草莓，遞到你嘴邊。",
        "gal_map_text_205100488=謝謝，我自己吃就好。這顆草莓確實很甜，你也多吃幾顆。",
        "gal_map_text_205100489=唐笑笑撅起嘴巴，有些委屈地看著你。",
        "gal_map_text_205100490=你怎麼自己吃了呀，我還想和你分享呢！不過沒關係，我們再摘幾顆，這次你一定要和我分享好不好？",
        "gal_map_text_205100491=唐笑笑有些生氣地瞪著你，拿起一顆草莓，自己咬了一大口。",
        "gal_map_text_205100492=你也太不夠意思了吧！我好心喂你，你居然自己吃了，都不分享給我！",
        "gal_map_text_205100493=唐笑笑小聲說，拿起小剪刀，開始摘草莓。",
        "gal_map_text_205100494=沒關係，你自己吃吧，我再摘一顆就好。其實分享不分享都無所謂，只要能和你一起摘草莓就很開心了。",
        "gal_map_text_205100495=唐笑笑聲音帶著點失落，慢慢走到另一邊，開始摘草莓。",
        "gal_map_text_205100496=我知道你可能不太喜歡分享，沒關係，我理解。我自己摘草莓就好，不會打擾你的。",
        "gal_map_text_205100497=抱歉，我剛才有點太直接了。其實和你一起摘草莓真的很開心，以後我們可以經常來。",
        "gal_map_text_205100498=沒關係，我知道你可能還沒準備好。不過只要能和你一起，不管做什麼都挺開心的。",
        "gal_map_text_205100499=唐笑笑嘴角露出一絲笑容，拿起草莓，輕輕咬了一口。",
        "gal_map_text_205100500=你們摘了很多草莓，唐笑笑小心翼翼地把草莓放進竹籃裡，臉上滿是滿足的笑容。唐笑笑拿起一顆最大的草莓，遞到你嘴邊：“這顆草莓最甜，給你吃。” 你咬了一口，確實香甜可口。",
        "gal_map_text_205100501=離開草莓田時，唐笑笑的手一直緊緊握著你的手，兩人的手指交織在一起，手心傳來微微的暖意。你們沿著木質步道繼續往前走，唐笑笑的頭偶爾會靠在你的肩膀上，氣氛變得越來越曖昧。遠處的城市夜景燈火璀璨，露臺上的星星燈閃爍著，為這場約會增添了幾分浪漫。",
        "gal_map_text_205100502=你發起的 “友誼賽” 讓唐笑笑鬥志滿滿。你們各自選定一排草莓開始 “搜尋”。唐笑笑非常認真，蹲著身子仔細甄選，嘴裡還小聲嘀咕：“這顆形狀完美，這顆顏色贏定了。” 你看著唐笑笑認真的樣子，忍不住想逗逗唐笑笑：“小心點，別光顧著找草莓，摔了可不划算。”",
        "gal_map_text_205100503=你找到幾顆了？我已經找到五顆又大又紅的草莓了，你肯定比不過我。",
        "gal_map_text_205100504=哼，別得意太早！我已經找到六顆了，比你多一顆。你肯定贏不過我，我才是最後的贏家。",
        "gal_map_text_205100505=比賽進行到一半，唐笑笑因為蹲得太久，腿有點麻，站起來的時候踉蹌了一下，差點摔倒。你下意識地伸手扶住唐笑笑，唐笑笑的身體緊緊靠在你的懷裡，頭髮垂了下來，剛好碰到你的臉頰。唐笑笑立刻直起身，臉頰通紅，有些不好意思地說：“謝謝你，我腿有點麻。” 唐笑笑的手還緊緊抓著你的胳膊，身體微微顫抖。",
        "gal_map_text_205100506=扶唐笑笑坐下 揉腿",
        "gal_map_text_205100507=提議暫停比賽 休息",
        "gal_map_text_205100508=調侃唐笑笑 體力不行",
        "gal_map_text_205100509=腿麻了就別站著了，我扶你到旁邊的凳子上坐下，我幫你揉揉腿，緩解一下。",
        "gal_map_text_205100510=唐笑笑興奮地拍手，身體緊緊靠在你身邊，眼神裡滿是鬥志。",
        "gal_map_text_205100511=哇你好溫柔！謝謝你幫我揉腿，感覺好多了。我們休息一會兒再繼續比賽，這次我一定不會輸，要讓你知道我的厲害！",
        "gal_map_text_205100512=唐笑笑緊緊抱住你的胳膊，身體幾乎貼在你身上。",
        "gal_map_text_205100513=太幸福了吧！你不僅扶我坐下，還幫我揉腿，也太寵我了～ 就算這次比賽輸了，我也心甘情願！",
        "gal_map_text_205100514=唐笑笑表情依舊有些冷淡，但臉頰泛起淺紅，語氣柔和了些許。",
        "gal_map_text_205100515=不用麻煩你，我自己也能揉。不過…… 謝謝你的關心，感覺好多了。",
        "gal_map_text_205100516=唐笑笑輕輕掙了掙，想要自己揉腿，語氣帶著點抗拒。",
        "gal_map_text_205100517=不用這麼照顧我，我自己能處理。不過還是謝謝你，腿確實舒服多了。",
        "gal_map_text_205100518=放心吧，我不會趁機作弊的。你的腿還沒好，我們再休息一會兒，等你腿不麻了再繼續。",
        "gal_map_text_205100519=好呀好呀，你真好！這顆草莓真甜，謝謝你。我們休息好了就繼續比賽，我一定要贏。",
        "gal_map_text_205100520=唐笑笑興奮地拍手，張開嘴巴吃掉你遞來的草莓，臉頰泛紅。",
        "gal_map_text_205100521=比賽先暫停，我們休息一會兒再繼續。腿麻了可不能逞強，身體最重要。",
        "gal_map_text_205100522=唐笑笑笑著接過水壺，喝了一口，眼睛緊緊盯著你的竹籃。",
        "gal_map_text_205100523=好吧，那我們休息一會兒再繼續。不過你可不許趁機多摘草莓，不然我可不依！",
        "gal_map_text_205100524=唐笑笑蹦蹦跳跳地接過水壺，大口喝了起來。",
        "gal_map_text_205100525=好呀好呀！休息一下也好，等下我精力充沛，肯定能贏你！我們先喝口水，補充一下能量～",
        "gal_map_text_205100526=唐笑笑平靜地坐在唐笑笑身邊，眼神裡滿是關心。",
        "gal_map_text_205100527=暫停比賽是個明智的選擇，身體最重要。我們休息一會兒，等你腿不麻了再繼續。",
        "gal_map_text_205100528=唐笑笑語氣平淡，拿起一顆草莓，慢慢吃了起來。",
        "gal_map_text_205100529=嗯，比賽可以暫停，身體不能逞強。我們慢慢休息，不用著急，比賽什麼時候都能繼續。",
        "gal_map_text_205100530=放心吧，我不會趁機作弊的。你的腿還沒好，我們再休息一會兒，等你腿不麻了再繼續。",
        "gal_map_text_205100531=好吧，那我們再休息一會兒。不過你可不許騙我，要是讓我發現你作弊，我可不依。",
        "gal_map_text_205100532=唐笑笑，笑著點頭，拿起一顆草莓，自己咬了一口",
        "gal_map_text_205100533=才蹲這麼一會兒就腿麻了，看來你的體力還不如我。這場比賽你肯定贏不了，不如直接認輸吧。",
        "gal_map_text_205100534=唐笑笑撅起嘴巴，有些不服氣地瞪著你。",
        "gal_map_text_205100535=我體力才不差呢！只是蹲太久腿麻了而已，休息一下就能恢復。等下比賽我肯定能贏你，讓你刮目相看！",
        "gal_map_text_205100536=唐笑笑眼眶微微泛紅，聲音帶著點生氣和委屈。",
        "gal_map_text_205100537=你憑什麼說我體力不行！我只是腿麻了，又不是體力不支，你別在這裡嘲笑我！",
        "gal_map_text_205100538=唐笑笑小聲說，慢慢站起來，準備繼續比賽。",
        "gal_map_text_205100539=我承認我體力確實不太好，不過休息一下就能恢復。我們繼續比賽吧，我不會輕易認輸的。",
        "gal_map_text_205100540=唐笑笑聲音帶著點哽咽，慢慢站起來，眼神裡滿是自責。",
        "gal_map_text_205100541=我知道我體力不好，總是拖後腿。對不起，我會努力跟上你的節奏，不會再讓你失望了。",
        "gal_map_text_205100542=抱歉，我不是故意調侃你，就是想逗逗你。你的腿還沒好，別逞強，我們休息一會兒再比賽。",
        "gal_map_text_205100543=沒關係，我知道你是故意逗我的。我的腿已經好多了，我們繼續比賽吧。",
        "gal_map_text_205100544=唐笑笑嘴角露出一絲笑容，拿起剪刀，準備繼續摘草莓。",
        "gal_map_text_205100545=你們最終決定不再比賽，而是一起摘草莓，享受採摘的樂趣。唐笑笑的腿完全好了，唐笑笑興奮地在草莓田裡穿梭，時不時會摘一顆草莓遞到你嘴邊：“你嘗嘗這顆，很甜！” 你咬了一口，確實香甜可口。",
        "gal_map_text_205100546=離開草莓田時，你們的竹籃裡都裝滿了草莓，唐笑笑看著滿滿的收穫，臉上滿是成就感：“今天真是太開心了，摘了這麼多草莓。” 唐笑笑主動拉著你的手，一起往休息區走，兩人的手指交織在一起，氣氛變得越來越曖昧。遠處的城市夜景燈火璀璨，露臺上的星星燈閃爍著，為這場約會增添了幾分浪漫。",
        "gal_map_text_205100547=你們並排蹲在草莓田邊，安靜地挑選和採摘。一開始有點沉默，只有剪刀的輕微哢嚓聲和遠處模糊的車流聲。過了一會兒，唐笑笑摘下一顆小小的、但形狀很可愛的草莓，托在手裡看了又看，忽然輕聲開口：“感覺這樣安安靜靜地一起做點小事，也挺好的。不用特地找話題。”",
        "gal_map_text_205100548=我也這麼覺得。和你在一起，就算不說話，也不會覺得尷尬。這顆草莓很可愛，和你一樣。",
        "gal_map_text_205100549=真的嗎？你也覺得這顆草莓很可愛？其實我覺得和你在一起，不管做什麼都挺開心的，就算不說話也很默契。",
        "gal_map_text_205100550=唐笑笑把那顆可愛的草莓放進竹籃裡，然後繼續採摘。你看著唐笑笑認真的樣子，忍不住想幫唐笑笑摘幾顆大草莓。你站起身，伸手去摘旁邊一顆又大又紅的草莓，卻因為夠不著，身體微微前傾。唐笑笑察覺到你的困難，也站起身，想要幫你，卻不小心撞到了你的後背。唐笑笑驚呼一聲，立刻道歉：“對不起，我不是故意的。”",
        "gal_map_text_205100551=順勢轉身擁抱",
        "gal_map_text_205100552=開玩笑一起摘",
        "gal_map_text_205100553=吐槽唐笑笑笨手笨腳",
        "gal_map_text_205100554=沒關係，這樣剛好。我其實早就想抱抱你了，和你在一起的感覺真的很好。",
        "gal_map_text_205100555=唐笑笑興奮地拍手，身體緊緊靠在你懷裡，手臂環繞著你的脖子。",
        "gal_map_text_205100556=哇你居然抱我！你的懷抱好溫暖，我心跳都加速了。我們一起摘草莓，肯定能摘到很多又大又紅的。",
        "gal_map_text_205100557=唐笑笑緊緊抱住你的腰，腦袋輕輕靠在你的肩膀上。",
        "gal_map_text_205100558=太幸福了吧！我其實也很想抱抱你，只是一直沒敢說～ 被你抱著的感覺真好，我都不想鬆開了！",
        "gal_map_text_205100559=唐笑笑表情平靜，但眼神裡帶著溫柔，輕輕靠在你的懷裡。",
        "gal_map_text_205100560=謝謝你的擁抱，我也很喜歡和你在一起的感覺。我們繼續摘草莓吧，爭取摘更多。",
        "gal_map_text_205100561=唐笑笑微微低頭，臉頰泛紅，聲音帶著點軟糯，手臂輕輕環繞著你的腰。",
        "gal_map_text_205100562=其實我也很想抱抱你，只是一直沒敢說。和你在一起，我真的很開心。",
        "gal_map_text_205100563=和你在一起，不管做什麼都很開心。我們摘完草莓，去休息區嘗嘗我們的成果，肯定很甜。",
        "gal_map_text_205100564=好呀好呀，我們一定要嘗嘗自己摘的草莓。你的懷抱真的很溫暖，我不想鬆開了。",
        "gal_map_text_205100565=唐笑笑興奮地拍手，身體緊緊靠在你懷裡，臉頰泛紅。",
        "gal_map_text_205100566=這麼同步。我們一起摘這顆草莓，肯定能摘到。",
        "gal_map_text_205100567=唐笑笑笑著點頭，和你一起伸手去摘那顆草莓，手指碰到你的手。",
        "gal_map_text_205100568=哼，算你識相！我們一起摘草莓，肯定能摘到很多。不過你抱我的時候，我確實有點心跳加速。",
        "gal_map_text_205100569=唐笑笑蹦蹦跳跳地和你一起摘草莓，眼裡滿是興奮。",
        "gal_map_text_205100570=哇塞太有默契了！連撞一下都這麼同步，我們果然是天造地設的一對～ 我們一起摘很多草莓，回去做草莓大餐！",
        "gal_map_text_205100571=唐笑笑平靜地和你一起伸手去摘草莓，語氣柔和。",
        "gal_map_text_205100572=確實挺有默契的。我們一起摘這顆草莓，慢慢享受採摘的過程。",
        "gal_map_text_205100573=唐笑笑語氣平淡，和你一起摘草莓，眼神專注。",
        "gal_map_text_205100574=嗯，默契是慢慢培養的。我們一起摘草莓，不用著急，享受當下就好。",
        "gal_map_text_205100575=和你在一起，不管做什麼都很開心。我們摘完草莓，去休息區嘗嘗我們的成果，肯定很甜。",
        "gal_map_text_205100576=放心吧，自己摘的草莓肯定很甜。我們一起摘多點，回去也可以分享給朋友。",
        "gal_map_text_205100577=唐笑笑笑著點頭，和你一起摘著草莓，手指偶爾碰到你的手。",
        "gal_map_text_205100578=你怎麼這麼不小心，差點把我撞倒。摘個草莓都這麼毛手毛腳，真是服了你了。",
        "gal_map_text_205100579=唐笑笑撅起嘴巴，有些委屈地看著你。",
        "gal_map_text_205100580=我也不是故意的，只是不小心而已，你別這麼說我嘛。我們一起摘草莓吧，別因為這個影響心情。",
        "gal_map_text_205100581=唐笑笑眼眶微微泛紅，聲音帶著點生氣和委屈。",
        "gal_map_text_205100582=你憑什麼說我笨手笨腳！我只是不小心撞到你了，又不是故意的，你至於這麼生氣嗎？",
        "gal_map_text_205100583=唐笑笑小聲道歉，拿起剪刀，開始摘草莓。",
        "gal_map_text_205100584=對不起，我下次會注意的，不會再這麼不小心了。我們一起摘草莓吧，別因為這個不開心了。",
        "gal_map_text_205100585=唐笑笑聲音帶著點哽咽，慢慢往竹籃裡放草莓。",
        "gal_map_text_205100586=我知道我很笨，總是添麻煩。對不起，我會慢慢摘，不會再出錯了，你別再指責我了好不好？",
        "gal_map_text_205100587=抱歉，我不是故意吐槽你，就是有點嚇到了。這顆草莓很大，給你吃。",
        "gal_map_text_205100588=沒關係，我知道你不是故意的。這顆草莓真的很大，謝謝你。我們繼續摘草莓吧，爭取摘更多。",
        "gal_map_text_205100589=唐笑笑嘴角露出一絲笑容，拿起草莓，輕輕咬了一口。",
        "gal_map_text_205100590=你們摘了很多草莓，唐笑笑小心翼翼地把草莓放進竹籃裡，臉上滿是滿足的笑容。唐笑笑拿起一顆草莓，輕輕咬了一口，甜汁四溢，唐笑笑眼睛一亮：“真甜！你也嘗嘗。” 唐笑笑拿起一顆最大的草莓，遞到你嘴邊，眼神裡滿是期待。",
        "gal_map_text_205100591=你咬了一口，確實香甜可口。離開草莓田時，唐笑笑主動拉著你的手，一起往休息區走，兩人的手指交織在一起，手心傳來微微的暖意。你們坐在休息區的長椅上，一起品嘗著自己摘的草莓，偶爾會對視一笑，氣氛變得越來越曖昧。遠處的城市夜景燈火璀璨，露臺上的星星燈閃爍著，為這場約會增添了幾分浪漫。",
        "gal_map_text_205100592=享用完甜品，你們帶著滿足的心情走出甜夢研究所，重新匯入商業街夜晚的人流。在一個相對安靜的街角，你們遇到了一個賣手工氦氣氣球的老爺爺。他的氣球不是普通的卡通形象，而是各種造型奇特的半透明發光體 —— 有的像緩慢旋轉的星系雲團，有的像包裹著星屑的水母，有的像內部有流沙般光點在遊動的抽象花朵，在夜色中散發著柔和夢幻的光暈，美得不真實。",
        "gal_map_text_205100593=這些氣球真漂亮，你喜歡哪一個？我買給你。",
        "gal_map_text_205100594=哇，這些氣球真的好特別！我都好喜歡，不知道選哪一個。那個星系雲團的看起來好浪漫，水母的也很可愛。",
        "gal_map_text_205100595=唐笑笑糾結了半天，還是沒做出決定。老爺爺笑著說：“小姑娘，讓你男朋友幫你選一個吧，男孩子的眼光都不錯。” 唐笑笑轉頭看向你，眼裡帶著期待，雙手不自覺地攥著你的胳膊：“那你幫我選一個吧，我相信你的眼光。” 你的手指不經意間碰到了唐笑笑的手，兩人同時頓了一下，唐笑笑的臉頰瞬間泛紅，卻沒有縮回手。",
        "gal_map_text_205100596=選星系雲團 系手腕",
        "gal_map_text_205100597=選抽象花朵 拍合照",
        "gal_map_text_205100598=調侃唐笑笑 選擇困難",
        "gal_map_text_205100599=勸唐笑笑 別買浪費",
        "gal_map_text_205100600=選水母氣球 並肩走",
        "gal_map_text_205100601=這個星系雲團的氣球和你很配，浪漫又夢幻。我幫你系在手腕上，這樣就不會弄丟了。",
        "gal_map_text_205100602=唐笑笑接過氣球熟練系在手腕，抬頭挑眉，帶著小驕傲。",
        "gal_map_text_205100603=星系雲團確實好看，但我自己能系！你站旁邊看著就行，別想插手我的“專屬裝飾”。不過算你有眼光，這個顏色我很喜歡。",
        "gal_map_text_205100604=唐笑笑轉動手腕欣賞，拉著你的手往廣場走，腳步輕快。",
        "gal_map_text_205100605=謝啦，眼光還不錯～ 系在手腕上挺合適的，我們趕緊去廣場拍照，這麼好看的氣球可不能浪費了。",
        "gal_map_text_205100606=唐笑笑興奮拍手，身體緊緊靠在你身邊，手腕輕輕晃動展示。",
        "gal_map_text_205100607=哇，這個氣球也太浪漫了吧！你系得好認真，我都捨不得動了。以後出門都要帶著它，向別人炫耀是你選的。",
        "gal_map_text_205100608=唐笑笑微微低頭，聲音軟糯，拉著你的手慢慢走。",
        "gal_map_text_205100609=不管你選什麼我都喜歡，被你系手腕的時候心跳都加速了。有你在真安心，以後選東西都聽你的，你選的肯定都好。",
        "gal_map_text_205100610=這樣就不會掉了，星系雲團的光暈和你今天的裙子顏色很搭。前面廣場有燈光秀，拿著氣球拍照肯定能拍出氛圍感，我們慢慢走過去？",
        "gal_map_text_205100611=真的很配！你系得也太結實了，剛才還擔心會松呢。燈光秀什麼時候開始呀？我想站在第一排，把氣球和燈光都拍清楚。",
        "gal_map_text_205100612=唐笑笑轉動手腕欣賞氣球，臉頰泛紅。",
        "gal_map_text_205100613=這個抽象花朵的氣球拍照超出片，我們拿著它拍幾張合照。我扶著你肩膀，靠近一點，把夜景和氣球的光都拍進去。",
        "gal_map_text_205100614=唐笑笑興奮地挽住你的胳膊，身體貼緊你，眼睛亮晶晶。",
        "gal_map_text_205100615=照太棒了！我們要貼緊一點，我比愛心你配合，拍完還要發朋友圈，配文都想好了——“和笨蛋闖進夢幻氣球世界”！",
        "gal_map_text_205100616=唐笑笑笑著靠近你，配合調整站位，手指偶爾碰氣球繩子。",
        "gal_map_text_205100617=這個氣球拍出來肯定好看，我們多拍幾張不同風格的。你舉手機穩一點，別把我拍醜了，不然罰你重新拍。",
        "gal_map_text_205100618=唐笑笑乖乖站在你身邊，保持適當距離，眼神盯著手機螢幕。",
        "gal_map_text_205100619=拍一張就行，別靠太近。影子連在一起的創意還行，拍的時候記得把光影調好看點，別把我拍醜了。",
        "gal_map_text_205100620=唐笑笑語氣平淡，站在你指定位置，身體不自覺靠近一點方便拍照。",
        "gal_map_text_205100621=既然你想拍就拍，不用拍太久，選一個角度拍好就行，重點是留紀念，不用太糾結細節。",
        "gal_map_text_205100622=這裡燈光剛好，能把氣球的花瓣紋理拍清楚。你靠近我一點，我扶著你的肩，這樣拍出來的影子也會連在一起，更有情侶感。",
        "gal_map_text_205100623=好呀好呀！你舉手機穩一點，別把我拍醜了。拍完這張我們再拍幾張搞怪的，換不同姿勢，多留幾張紀念。",
        "gal_map_text_205100624=唐笑笑主動往你身邊靠，比出半心手勢。",
        "gal_map_text_205100625=真是個選擇困難症患者，這麼多氣球都選不出來。我隨便幫你選一個，不許再糾結了。",
        "gal_map_text_205100626=唐笑笑興奮地拉著你的手往前走，腳步輕快，時不時晃動氣球。",
        "gal_map_text_205100627=水母氣球也太可愛了吧！和我超配～ 我們並肩走的時候可以稍微跑一跑，讓氣球跟著飄，肯定很引人注目！",
        "gal_map_text_205100628=唐笑笑笑著點頭，和你並肩走，手指偶爾碰氣球繩子，語氣自然。",
        "gal_map_text_205100629=這個選擇真不錯，水母氣球很靈動。我們慢慢走，欣賞夜景，路過小吃攤我要吃烤腸，你請客呀。",
        "gal_map_text_205100630=唐笑笑表情平靜，腳步平穩，偶爾轉頭看你，眼神溫和。",
        "gal_map_text_205100631=並肩走挺好的，氣球很特別，不會太張揚。我們慢慢逛，不用著急，享受當下就好。",
        "gal_map_text_205100632=唐笑笑語氣平淡，雙手輕輕握氣球繩子，眼神看向遠方夜景。",
        "gal_map_text_205100633=氣球挺好看的，並肩走也合適。不用刻意找話題，這樣安靜走一會兒也挺好。",
        "gal_map_text_205100634=水母的光點跟著風飄的樣子好靈動，和你的性格一模一樣。前面有小吃攤，要不要買串烤腸？正好補充點能量，等下還能多逛會兒。",
        "gal_map_text_205100635=好呀好呀！我早就想吃烤腸了，你幫我選個辣一點的。這個氣球真的好特別，好多人都在看呢，太有意思了。",
        "gal_map_text_205100636=唐笑笑眼睛一亮，拉著你往小吃攤方向走。",
        "gal_map_text_205100637=這些氣球很快就會癟掉，沒必要浪費錢。我們去前面的文創店看看，有更實用的紀念物。",
        "gal_map_text_205100638=唐笑笑撅起嘴巴，不服氣地瞪你，卻把氣球抱在懷裡。",
        "gal_map_text_205100639=你才選擇困難呢！我只是想選個最特別的，不像你這麼敷衍。不過看在氣球還不錯的份上，不跟你計較了，下次再調侃我就不理你了！",
        "gal_map_text_205100640=唐笑笑笑著點頭，把氣球系在手腕，腳步輕快。",
        "gal_map_text_205100641=好吧，我確實有點選擇困難，但你也不用這麼說我呀。不過這個氣球我挺喜歡的，下次不許調侃我了，不然罰你重新給我選一個。",
        "gal_map_text_205100642=唐笑笑微微低頭，手指攥著你的衣角，聲音輕輕。",
        "gal_map_text_205100643=對不起，我就是有點糾結，想選個最合心意的。謝謝你幫我做決定，這個氣球我很喜歡，以後我會快點做選擇的。",
        "gal_map_text_205100644=唐笑笑聲音帶著點委屈，拉著你的手慢慢走。",
        "gal_map_text_205100645=我知道我有選擇困難，給你添麻煩了。謝謝你幫我選的氣球，我很喜歡。以後不管選什麼，我都聽你的，你別嫌棄我。",
        "gal_map_text_205100646=剛才糾結了十分鐘，現在拿到氣球滿意了吧？其實不管選哪個，你拿著都好看。不過下次再這麼糾結，我可就隨機幫你選了。",
        "gal_map_text_205100647=討厭，不許說我選擇困難！不過這個氣球我確實很喜歡，算你有點眼光。下次再選東西，你可以給我提建議，但最終決定權還在我手裡。",
        "gal_map_text_205100648=唐笑笑撅起嘴巴輕輕捶了你一下。",
        "gal_map_text_205100649=這個水母氣球和你的性格很像，可愛又靈動。我們一人握一半繩子，並肩往前走，肯定很引人注目。",
        "gal_map_text_205100650=唐笑笑皺起眉頭，從錢包掏錢，卻忍不住回頭看你，希望你改變主意。",
        "gal_map_text_205100651=才不浪費呢！氣球這麼特別，就算癟了也是美好的回憶～ 我自己買，不用你出錢，你別想阻止我！",
        "gal_map_text_205100652=唐笑笑氣緩和，拉著你的手往文創店走，眼神裡帶著不舍。",
        "gal_map_text_205100653=其實我真的很喜歡這個氣球，不會覺得浪費。不過我尊重你的想法，我們去文創店看看也行，但如果沒喜歡的，你可得陪我回來買。",
        "gal_map_text_205100654=唐笑笑表情平靜，順從地跟著你走，語氣平和。",
        "gal_map_text_205100655=你說得對，晚上買氣球確實不太實用。我們去文創店選個紀念物也挺好，只要和你一起，不管做什麼都開心。",
        "gal_map_text_205100656=唐笑笑語氣平淡，跟著你的腳步，眼神裡沒有情緒。",
        "gal_map_text_205100657=無所謂，去哪都可以。你覺得浪費就不買，我沒意見。其實我也不是非買不可，只是覺得挺特別的。",
        "gal_map_text_205100658=其實我不是不想給你買，就是覺得氣球放幾天就癟了，有點可惜。前面文創店有同款氣球造型的鑰匙扣，能一直保存，我們去看看？",
        "gal_map_text_205100659=真的嗎？鑰匙扣也很可愛呀，還能一直帶著。其實我也不是非要買氣球，就是覺得它好看，鑰匙扣更實用，謝謝你替我著想。",
        "gal_map_text_205100660=唐笑笑眼神瞬間亮起來，拉著你的手往文創店走。",
        "gal_map_text_205100661=你們手牽手走向前面的廣場，氣球的光暈在夜色中溫柔閃爍，照亮了腳下的路。路過熱鬧的小吃攤時，唐笑笑會停下腳步，眼神亮晶晶地看著你：“要不要嘗嘗那個烤腸？聞起來好香！” 你點頭後，唐笑笑會興奮地拉著你擠進去，還會主動幫你擦乾淨嘴角的醬汁。",
        "gal_map_text_205100662=走到廣場中央，唐笑笑會鬆開你的手，拿著氣球轉一圈，裙擺隨動作揚起，笑容比氣球的光更耀眼。唐笑笑轉頭看向你，眼裡滿是笑意：“今天真的太開心了，謝謝你陪我做甜品、買氣球。” 唐笑笑主動靠近你，氣球的光暈落在唐笑笑臉上，曖昧氛圍悄然彌漫，你能清晰聽到唐笑笑微微加速的心跳聲。",
        "gal_map_text_205100663=帶著情侶款扭蛋，你們在扭蛋博物館內部閒逛時，一個互動燈光藝術裝置瞬間吸引了兩人的目光。那是一條不算長的 “光影隧道”，由半透明材料和鏡面拼接而成，內部不斷流淌著柔和的色彩 —— 從夢幻的粉紫漸變到靜謐的湖藍，再到溫暖的橘黃，牆面和地面還投射著緩慢旋轉的扭蛋圖案，有情侶款、卡通款、復古款，與光影交織成一片迷離的幻境。",
        "gal_map_text_205100664=走進隧道，人影被鏡面反射拉長、變形，仿佛置身於流動的萬花筒中。舒緩的純電子音在空間裡輕輕回蕩，音量剛好蓋過外界的嘈雜，卻不影響彼此交流。隧道裡人不多，只有兩三對情侶分散在各處，或輕聲交談，或駐足拍照。唐笑笑放慢腳步，好奇地抬起手，看著彩色光影在掌心流動、變幻，又轉頭看向你 —— 光影模糊了你的輪廓，讓平時熟悉的側臉多了幾分不真切的溫柔。",
        "gal_map_text_205100665=這裡也太特別了吧，光影流動的樣子像在做夢。你看，我們的情侶扭蛋圖案剛好投射在前面的牆上。",
        "gal_map_text_205100666=好像走進了一個萬花筒裡面，連旁邊的人…… 都變得有點不一樣了。",
        "gal_map_text_205100667=你們往前走了幾步，隧道中央的光影突然變得密集起來，形成一片 “星光扭蛋區”—— 無數微小的扭蛋光點從地面升起，仿佛踩在星河裡。唐笑笑下意識地停下腳步，眼裡閃著亮晶晶的光，雙手不自覺地攥了攥你的胳膊：“這裡也太美了！我們要不要在這裡拍幾張照片？或者…… 試著伸手碰一碰那些光點？” 你的手臂碰到唐笑笑的肩膀，光影在兩人相觸的地方形成一道柔和的光暈，唐笑笑的臉頰瞬間泛起與光影同色的紅暈，卻沒有移開肩膀。",
        "gal_map_text_205100668=牽手拍光影合照",
        "gal_map_text_205100669=追光影扭蛋",
        "gal_map_text_205100670=借鏡面，拍情侶倒影",
        "gal_map_text_205100671=調侃唐笑笑影子變形",
        "gal_map_text_205100672=勸唐笑笑快走，別耽誤",
        "gal_map_text_205100673=當然要拍！我們牽手站在這裡，讓光影把我們裹在一起。我扶著你的肩，你靠過來一點，這樣拍出來的照片肯定很有紀念意義。",
        "gal_map_text_205100674=唐笑笑興奮地主動牽住你的手，身體貼緊你，臉上滿是期待。",
        "gal_map_text_205100675=好呀好呀！我們要貼得緊緊的，讓光影把我們裹在一起，我比愛心你扶著我，拍完發朋友圈炫耀！",
        "gal_map_text_205100676=唐笑笑笑著靠近你，肩膀貼緊你，配合調整站位。",
        "gal_map_text_205100677=這個合照肯定很有紀念意義！謝謝你想到這麼好的主意，靠在你身邊感覺挺安心的。我們多拍幾張，換不同姿勢。",
        "gal_map_text_205100678=唐笑笑乖乖站在你身邊，微微靠近，眼神盯著手機螢幕。",
        "gal_map_text_205100679=拍合照可以，但別靠太近，保持一點距離。影子連在一起的創意還行，拍的時候記得把光影調好看點，別把我拍醜了。",
        "gal_map_text_205100680=唐笑笑語氣平淡，放慢腳步站在你指定位置，身體不自覺靠近一點。",
        "gal_map_text_205100681=既然你想拍就拍，不用拍太久，選一個角度拍好就行，重點是留紀念，不用太糾結細節。",
        "gal_map_text_205100682=你看鏡頭裡，我們的影子被光暈裹在一起，像分不開一樣。我把這張設成手機壁紙，以後打開手機就能想起今天的光影隧道。",
        "gal_map_text_205100683=真的好有氛圍感！你拍的時候別手抖，一定要把影子拍完整。拍完我們再拍幾張不同角度的，我要存到專屬相冊裡。",
        "gal_map_text_205100684=唐笑笑臉頰貼向你，聲音軟軟的。",
        "gal_map_text_205100685=我們來追那些扭蛋光點吧！一起伸手碰情侶款光點，接住了就算“光影戰利品”，回去給現實扭蛋也拍合照。",
        "gal_map_text_205100686=唐笑笑拉著你的手輕快跑，頭髮飛揚，眼裡滿是笑意。",
        "gal_map_text_205100687=追光點也太有意思了！我們一定要接住情侶款的，這樣我們的扭蛋就有‘光影分身’了。你跑慢一點，別把我弄丟了！",
        "gal_map_text_205100688=唐笑笑拉著你的手跟著光影移動，腳步輕快，偶爾側頭看你。",
        "gal_map_text_205100689=這個互動好特別，我們一起加油接住光點！你跟著我的節奏，我眼神比你好，看到情侶款就喊你。",
        "gal_map_text_205100690=唐笑笑平靜地跟著你走，緊緊握你的手，避免走散。",
        "gal_map_text_205100691=追光點還行，不過別跑太快，注意安全。接住了也不用太興奮，留個紀念就好，其實接不接住都無所謂。",
        "gal_map_text_205100692=唐笑笑語氣平淡，跟著你的腳步，眼神偶爾落在光影上。",
        "gal_map_text_205100693=既然你想玩就陪你，不過別玩太久，差不多就走。我跟著你跑，你別跑太快，我有點跟不上。",
        "gal_map_text_205100694=快看前面那對情侶款光點，我們一起伸手碰它！接住了就算“光影戰利品”，回去給我們的情侶扭蛋也拍張合照，湊成一套紀念。",
        "gal_map_text_205100695=好耶！我看到了，就在前面！你跑慢一點，別把我弄丟了。要是接住了，我們等下去文創區買個小盒子，把扭蛋和照片都裝起來。",
        "gal_map_text_205100696=唐笑笑腳步輕快地跟著你跑，頭髮飛揚。",
        "gal_map_text_205100697=隧道的鏡面反射好特別，我們拍倒影合照吧。光影把影子連在一起，像分不開一樣，我舉手機，你湊近一點。",
        "gal_map_text_205100698=唐笑笑主動調整站位，擺出各種造型，讓你調整角度。",
        "gal_map_text_205100699=拍倒影可以，但姿勢得聽我的！我來設計造型，你只負責按快門，不許亂指揮。不過鏡面反射確實特別，算你有想法。",
        "gal_map_text_205100700=唐笑笑笑著靠近你，配合調整站位，手指偶爾碰你的手臂。",
        "gal_map_text_205100701=這個倒影合照挺有創意的，我們多拍幾張不同角度的。你舉手機穩一點，別把影子拍斷了，不然罰你重新拍。",
        "gal_map_text_205100702=唐笑笑興奮地挽住你的胳膊，身體貼緊你，眼睛亮晶晶。",
        "gal_map_text_205100703=哇，倒影合照好浪漫！我們要把影子拍得緊緊連在一起，你一定要拍好呀，我相信你的拍照技術。",
        "gal_map_text_205100704=唐笑笑微微低頭，臉頰泛紅，乖乖站在你身邊。",
        "gal_map_text_205100705=我都聽你的，你說怎麼拍就怎麼拍。和你一起拍照，就算不上鏡也開心。你別嫌我動作僵硬，我會努力配合的。",
        "gal_map_text_205100706=鏡面反射把光影拉長了，我們稍微彎腰，讓影子的肩膀靠在一起。這樣拍出來的合照，比正面拍更有創意，別人肯定沒拍過。",
        "gal_map_text_205100707=好呀，我要不要比個愛心？還是自然一點就好？你舉手機穩一點，別把影子拍斷了，不然就要重新拍了。",
        "gal_map_text_205100708=唐笑笑乖乖靠近你，調整姿勢。",
        "gal_map_text_205100709=你看鏡面裡你的影子，被拉得好長像小外星人。要不要拍張“影子醜照”留紀念，以後逗你玩。",
        "gal_map_text_205100710=唐笑笑撅起嘴巴，卻忍不住笑，主動靠近你拍合照。",
        "gal_map_text_205100711=你的影子才像外星人呢！不過看在你覺得可愛的份上，允許你拍正常合照，但醜照絕對不行，不然我撓你癢癢！",
        "gal_map_text_205100712=唐笑笑笑著瞪你一眼，配合拍合照，臉頰泛紅。",
        "gal_map_text_205100713=討厭，不許調侃我！我的影子只是被拉長了而已，一點都不好笑。不過看在你笑得開心的份上，不跟你計較了，趕緊拍正常合照。",
        "gal_map_text_205100714=唐笑笑小聲說，站在你身邊配合拍照，眼神裡沒有波瀾。",
        "gal_map_text_205100715=影子變形也挺正常的，要拍就拍吧，別耽誤時間。拍完我們趕緊去文創區，我想給扭蛋買掛繩。",
        "gal_map_text_205100716=唐笑笑聲音輕輕，眼神有些閃躲，站在原地不動。",
        "gal_map_text_205100717=我不覺得好笑，也不想拍醜照。如果你想拍合照就拍，不想拍我們就走。調侃別人也不太禮貌，希望你以後別這樣。",
        "gal_map_text_205100718=你看你的影子，腿被拉得比我還長，像小外星人一樣。不過還挺可愛的，要不要拍張“影子醜照”留紀念，以後逗你玩？",
        "gal_map_text_205100719=你的影子才像外星人呢！不過拍一張也可以，但是要拍我好看的角度。拍完我們趕緊去文創區買扭蛋掛繩，別光顧著笑了。",
        "gal_map_text_205100720=唐笑笑不服氣地瞪你一眼，卻忍不住笑。",
        "gal_map_text_205100721=隧道逛得差不多了，光影看久了眼睛累。我們去文創區買扭蛋掛繩，比在這裡一直站著有意思。",
        "gal_map_text_205100722=唐笑笑撒嬌拉著你的胳膊，眼神裡滿是期待。",
        "gal_map_text_205100723=再逛一會兒嘛！光影還沒看夠呢，文創區什麼時候去都行，難得遇到這麼特別的隧道。就5分鐘，拍完照片就走，好不好嘛～",
        "gal_map_text_205100724=唐笑笑溫和反駁，拉著你往光影密集處走。",
        "gal_map_text_205100725=別急著走呀，我們再拍幾張照片就走。這裡真的很特別，不多待一會兒太可惜了。你看別人都在慢慢逛，我們也別急。",
        "gal_map_text_205100726=唐笑笑冷漠地跟著你走，沒有絲毫留戀。",
        "gal_map_text_205100727=走就走，本來也逛得差不多了。文創區有扭蛋掛繩，去看看也可以，留不留紀念都無所謂。",
        "gal_map_text_205100728=唐笑笑語氣平淡，腳步輕快地往出口走。",
        "gal_map_text_205100729=無所謂，去哪都可以。你覺得累了我們就走，不用問我的意見。其實我也覺得沒什麼意思，早就想走了。",
        "gal_map_text_205100730=影看久了眼睛容易累，我們先去文創區買掛繩，給情侶扭蛋配上專屬裝飾。前面還有一家手工店，能在掛繩上刻字，我們去試試？",
        "gal_map_text_205100731=好吧，聽你的，眼睛確實有點酸了。刻字要刻什麼呀？要不刻上我們今天約會的日期，這樣以後看到就想起今天的光影隧道。",
        "gal_map_text_205100732=唐笑笑順從地跟著你走，眼神還留戀著光影。",
        "gal_map_text_205100733=你們拍了不少照片，帶著滿滿的紀念走出光影隧道。舒緩的電子音漸漸遠去，卻仿佛還在耳邊迴響，讓人意猶未盡。唐笑笑翻看著手機裡的合照，時不時發出小聲的驚歎，手指在螢幕上輕輕滑動：“這張倒影合照真的好特別，影子連在一起，好像永遠不會分開一樣。” 你走到唐笑笑身邊，和唐笑笑一起翻看照片，肩膀不經意間碰到一起，唐笑笑沒有躲開，反而輕輕靠了過來。",
        "gal_map_text_205100734=路過博物館出口的文創區時，唐笑笑拉著你停下腳步：“我們給情侶扭蛋買個專屬掛繩吧，就選和隧道光影一樣的粉紫色，這樣就能一直想起今天的光影夢境了。” 你點頭答應，和唐笑笑一起挑選掛繩，唐笑笑認真地把掛繩系在扭蛋上，然後把自己的扭蛋和你的放在一起比對：“你看，連掛繩都這麼配。”",
        "gal_map_text_205100735=路燈的光落在唐笑笑臉上，和隧道裡的光影一樣柔和，唐笑笑的眼裡閃著滿足的光芒，曖昧的氛圍在兩人之間悄然彌漫，彼此的好感度在不知不覺中又上升了一大截。",
        "gal_map_text_205100736=採摘結束後，你們提著裝滿草莓和小番茄的竹籃，手裡拿著農場阿姨贈送的一小把迷迭香，香氣清新淡雅。離開種植區後，你們在露臺的另一角發現了一個別致的小秋千 —— 用粗壯的麻繩和復古舊木板搭建而成，剛好夠兩個人並肩坐下，秋千兩側還纏繞著細小的白色燈帶，在夜色中散發著柔和的暖光。",
        "gal_map_text_205100737=夜色已濃，城市的燈火化作一片流動的星河，成為天然的背景板。你們輕輕坐上秋千，唐笑笑把竹籃放在腳邊，雙手輕輕抓住兩側的麻繩，深深吸了口氣，又慢慢呼出來，迷迭香的香氣混合著晚風帶來的不知名花草香，讓人身心格外鬆弛。你輕輕晃動秋千，幅度不大，晚風拂過臉頰，帶著一絲涼意，卻讓人覺得格外愜意。",
        "gal_map_text_205100738=這個秋千也太舒服了，坐在這裡看夜景，感覺所有的煩惱都消失了。迷迭香的香氣好好聞，和晚風搭配在一起，太治癒了。",
        "gal_map_text_205100739=真的好鬆弛啊，平時在城市裡很少有機會這樣安靜地坐著看夜景，還有這麼舒服的秋千。謝謝你陪我來採摘，還找到這麼棒的地方。",
        "gal_map_text_205100740=秋千輕輕晃動，白色燈帶的光芒落在兩人身上，暖融融的。農場阿姨推著一輛小推車路過，車上放著剛泡好的花草茶和小點心：“晚上風大，喝點花草茶暖暖身子吧，情侶們可以試試‘共飲一杯’的小互動，分享同一杯茶，寓意甜甜蜜蜜哦～” 唐笑笑轉頭看向你，眼裡帶著羞澀又期待的光芒，雙手不自覺地攥緊了麻繩：“我們要不要試試？我想嘗嘗那個玫瑰花草茶，聽起來就很香甜。” 你的手臂碰到唐笑笑的胳膊，唐笑笑下意識地縮了一下，然後又慢慢放鬆，指尖輕輕碰了碰你的手背，眼神裡滿是試探。",
        "gal_map_text_205100741=共飲一杯茶 喂對方",
        "gal_map_text_205100742=晃秋千 聊趣事",
        "gal_map_text_205100743=並肩看夜景 貼肩",
        "gal_map_text_205100744=調侃唐笑笑 怕秋千晃",
        "gal_map_text_205100745=勸唐笑笑 少喝甜茶",
        "gal_map_text_205100746=當然要試！我們共飲一杯玫瑰茶，我先喂你喝，然後你再喂我，這樣才夠甜。放心，我會慢慢喂，不會讓你嗆到。",
        "gal_map_text_205100747=唐笑笑興奮地搶過茶杯，用勺子舀茶慢慢湊近你，嘴角帶調皮笑容。",
        "gal_map_text_205100748=共飲一杯也太甜了吧！我要先喂你喝，看看誰喂得更溫柔～ 你可不許躲開，不然我就把茶水輕輕潑在你臉上！",
        "gal_map_text_205100749=唐笑笑笑著張開嘴巴，眼睛亮晶晶地看著你，臉頰泛紅。",
        "gal_map_text_205100750=這個互動好浪漫！你喂我的時候慢一點，別燙到我。等下我喂你，要喂一大口，讓你也嘗嘗這麼香的茶。",
        "gal_map_text_205100751=唐笑笑表情平靜，乖乖張開嘴巴，眼神裡帶著溫柔。",
        "gal_map_text_205100752=謝謝你喂我，茶很香。我們慢慢喝，不用著急，這樣共飲的感覺確實很特別。",
        "gal_map_text_205100753=唐笑笑語氣平淡，主動靠近你方便餵食，身體微微前傾。",
        "gal_map_text_205100754=晚上喝太多甜茶不好，少嘗一點就行。不過既然是共飲，我就陪你試試。你喂我的時候我會慢慢喝。",
        "gal_map_text_205100755=慢點喝，有點燙。玫瑰茶的香氣和迷迭香很搭，剛才摘的草莓也甜，等下我們把草莓和茶一起吃，味道肯定更特別。",
        "gal_map_text_205100756=好香呀！甜而不膩，太好喝了。現在換我喂你，這次要喂一大口，讓你也嘗嘗這麼香的茶。你剛才摘的草莓還剩幾顆？我們分著吃吧",
        "gal_map_text_205100757=唐笑笑張嘴喝下茶，眼睛亮晶晶的。",
        "gal_map_text_205100758=我們一邊晃秋千一邊聊小時候的趣事吧。我小時候第一次蕩秋千摔下來，現在想起來還覺得好笑，你小時候有沒有好玩的事。",
        "gal_map_text_205100759=唐笑笑主動分享糗事，語氣帶著小傲嬌。",
        "gal_map_text_205100760=聊趣事可以，但我先說！我小時候蕩秋千讓爸爸推很高，差點飛出去，現在想起來還覺得刺激。不過現在有你晃得這麼慢，一點都不刺激。",
        "gal_map_text_205100761=唐笑笑笑著分享，側頭看你，主動提問。",
        "gal_map_text_205100762=我小時候也有好玩的事！有一次和小朋友比賽蕩秋千，摔下來哭了好久，現在想想還覺得好笑。你小時候有沒有難忘的趣事？",
        "gal_map_text_205100763=唐笑笑興奮地拉著你的胳膊，眼神裡滿是期待。",
        "gal_map_text_205100764=哇，你小時候也太勇敢了吧！我小時候不敢讓別人推太高，怕摔下來。現在有你在，我覺得很安全，想試試稍微推高一點。",
        "gal_map_text_205100765=唐笑笑微微低頭，聲音軟軟的，身體靠在你肩膀上。",
        "gal_map_text_205100766=我小時候沒怎麼玩過秋千，有點羡慕你有這麼多有趣的回憶。你聊的趣事好好聽，我還想多聽一點，你再說說嘛。",
        "gal_map_text_205100767=我小時候第一次蕩秋千，被我爸推得太高，嚇得哭了好久，現在想起來還覺得好笑。你小時候有沒有和秋千有關的趣事？",
        "gal_map_text_205100768=當然有！我小時候和小朋友比賽蕩秋千，摔下來哭了好久，還發誓再也不玩了，結果第二天又跑去玩了。你爸也太敢推了，要是你現在推我，可不許推那麼高。",
        "gal_map_text_205100769=唐笑笑笑著點頭，身體隨秋千輕輕晃動。",
        "gal_map_text_205100770=我們坐近一點，並肩看夜景，這樣也能擋點風。你看遠處的摩天輪，燈火閃爍，和星星一樣美。",
        "gal_map_text_205100771=唐笑笑興奮地拉著你的手，一起閉眼深呼吸。",
        "gal_map_text_205100772=迷迭香的味道好治癒！我們一起閉上眼睛深呼吸，感受香氣和晚風～ 太舒服了！聞完我們再去逛逛，看看還有沒有其他好玩的地方。",
        "gal_map_text_205100773=唐笑笑笑著閉上眼睛，身體微微放鬆，語氣溫柔。",
        "gal_map_text_205100774=聞迷迭香放鬆確實不錯，這裡的香氣很純粹。我們閉上眼睛深呼吸，能忘記所有煩惱。聞完我們再坐一會兒，聊聊心裡話。",
        "gal_map_text_205100775=唐笑笑表情平靜，閉上眼睛，雙手放鬆搭在麻繩上。",
        "gal_map_text_205100776=迷迭香有安神效果，搭配晚風確實挺治癒。我閉上眼睛試試，你別趁我不注意晃秋千太厲害。",
        "gal_map_text_205100777=唐笑笑語氣平淡，輕輕聞了聞迷迭香，眼神看向遠方夜景。",
        "gal_map_text_205100778=確實挺放鬆的，但不用這麼刻意。聞一會兒就行，不用閉眼睛，這樣安靜坐著也挺好。",
        "gal_map_text_205100779=你看遠處的摩天輪，燈火像巨大的花環，轉動起來的樣子好浪漫。風有點大，靠我近一點，能擋點風。",
        "gal_map_text_205100780=真的好浪漫！我一直想去坐摩天輪，但是沒人陪我。和你一起站在這裡看，感覺比坐上去還幸福。你看那邊的車燈，像流動的星星一樣。",
        "gal_map_text_205100781=唐笑笑輕輕靠在你的肩膀上，聲音軟軟的。",
        "gal_map_text_205100782=你是不是怕秋千晃太厲害？看你抓麻繩抓得這麼緊。放心，我會晃得很慢，不過你緊張的樣子挺可愛。",
        "gal_map_text_205100783=唐笑笑撅起嘴巴，不服氣地瞪你，身體微微前傾。",
        "gal_map_text_205100784=我才不怕呢！只是抓著麻繩更安全而已。不過你覺得我緊張的樣子可愛，那我就勉強讓你多看一會兒～ 你晃快一點試試，我才不怕！",
        "gal_map_text_205100785=唐笑笑笑著瞪你一眼，主動轉移話題，手指輕輕放鬆麻繩。",
        "gal_map_text_205100786=討厭，不許調侃我！我只是有點緊張，不過有你在，我就不害怕了。我們繼續晃秋千，聊點別的，別總說我緊張。",
        "gal_map_text_205100787=唐笑笑小聲說，表情平靜，手指依舊抓著麻繩。",
        "gal_map_text_205100788=我不是怕，只是習慣抓緊一點，這樣更安全。你不用放慢幅度，正常晃就好。調侃別人也不太禮貌，希望你以後別這樣。",
        "gal_map_text_205100789=唐笑笑聲音帶著點委屈，頭微微低下，手指攥緊麻繩。",
        "gal_map_text_205100790=我知道你是開玩笑，但我確實有點怕晃太厲害。如果你覺得我緊張很可愛，那隨便你怎麼想，別太過分就行。",
        "gal_map_text_205100791=看你抓麻繩抓得這麼緊，手心都出汗了吧？其實不用怕，我扶著秋千呢，不會晃太厲害。你放鬆一點，感受風的感覺，很舒服的。",
        "gal_map_text_205100792=才沒有怕呢！只是習慣抓緊一點，這樣更安全。不過被你這麼一說，好像確實不用這麼緊張。你再晃慢一點，我想多坐會兒，看看夜景。",
        "gal_map_text_205100793=唐笑笑臉頰泛紅，稍微鬆開一點麻繩。",
        "gal_map_text_205100794=玫瑰茶雖然香甜，但晚上喝太多甜的對牙齒不好，還影響睡眠。我們少嘗一點就行，重點是坐在這裡放鬆。",
        "gal_map_text_205100795=唐笑笑撅起嘴巴，拿起茶杯喝了一小口，帶著小任性。",
        "gal_map_text_205100796=知道啦知道啦，不用你囉嗦！偶爾放縱一下沒關係，我就想多喝兩口，這麼香的茶只喝一口太可惜了。",
        "gal_map_text_205100797=唐笑笑溫和順從，主動提議新活動，眼神裡帶著期待。",
        "gal_map_text_205100798=好吧，聽你的，少喝一點。不過這個茶真的很好喝，謝謝你提醒我。我們喝完茶，一起分享小點心吧，我看到有曲奇餅乾。",
        "gal_map_text_205100799=唐笑笑微微點頭，把茶杯放在旁邊，身體靠在你身邊。",
        "gal_map_text_205100800=好呀，聽你的，少喝一點就好。你考慮得真周到，怕我喝多了不舒服。有你在身邊真安心，什麼都替我想到了。",
        "gal_map_text_205100801=唐笑笑聲音軟軟的，眼神裡滿是依賴，拉著你的手。",
        "gal_map_text_205100802=我都聽你的，你說少喝就少喝。我本來也不太懂這些，有你提醒我就放心了。以後不管什麼事，你都多提醒我一點好不好？",
        "gal_map_text_205100803=玫瑰茶雖然好喝，但晚上喝太多甜的對牙齒不好，還影響睡眠。我們留著明天喝，現在一起嘗嘗農場的小餅乾？剛才阿姨說都是手工做的，很健康。",
        "gal_map_text_205100804=好吧，聽你的，牙齒確實很重要。這個餅乾好好吃，有淡淡的香草味。我們慢慢吃，再聊會兒天，不用著急走，這麼舒服的夜景不多見。",
        "gal_map_text_205100805=唐笑笑點頭答應，拿起一塊餅乾放進嘴裡。",
        "gal_map_text_205100806=你們喝完茶，繼續坐在秋千上輕輕晃動，白色燈帶的光芒暖融融地包裹著兩人。唐笑笑靠在秋千的欄杆上，抬頭看著漫天繁星，又低頭看向下方的城市夜景，眼神裡滿是愜意和滿足。你坐在唐笑笑身邊，能清晰地聞到唐笑笑身上淡淡的花香和迷迭香的混合氣息，讓人忍不住心動。",
        "gal_map_text_205100807=過了一會兒，唐笑笑轉頭看向你，眼裡閃著亮晶晶的光：“今天真的太完美了，有草莓、有花草茶、有舒服的秋千，還有你陪著我。我從來沒有這麼放鬆過，也從來沒有這麼開心過。” 唐笑笑主動靠近你，肩膀輕輕靠在你的肩膀上，手臂不自覺地挽住你的胳膊。你能感受到唐笑笑微微加速的心跳，還有唐笑笑對這份感情的期待。",
        "gal_map_text_205100808=你輕輕拍了拍唐笑笑的手背，唐笑笑順勢握緊了你的手，手指與你緊緊相扣。秋千慢慢停下，夜色漸深，晚風帶著花草的香氣輕輕吹過，城市的燈火在遠處閃爍，像星星落在了人間。你們靜靜地坐在秋千上，享受著這份難得的寧靜和曖昧，彼此的好感度在不知不覺中達到了新的高度，為接下來的感情升溫埋下了溫柔的伏筆。",
        "gal_map_text_205100809=掛著復古煤油燈的僻靜小巷盡頭，旋轉鐵梯通向“觀星閣”屋頂平臺。木質地板搭配籐椅小圓桌，頭頂無遮擋，雨後天晴的夜空繁星璀璨，煤油燈暖光與城市燈火交相輝映，晚風帶著雨後清新氣息，靜謐又浪漫。",
        "gal_map_text_205100810=離開主街拐進小巷，你們順著鐵梯登上平臺。唐笑笑扶著木質欄杆抬頭望星，頭髮被晚風輕吹，語氣滿是驚喜：“沒想到藏著這麼棒的地方，和你一起看星星，連星星都變亮了。” 坐了一會兒，唐笑笑突然指著天空喊“流星”，兩人閉眼許願後視線相撞，唐笑笑臉頰泛紅往你身邊靠。遠處傳來悶雷，晚風變大，唐笑笑下意識往你懷裡縮了縮，眼神帶著慌亂。",
        "gal_map_text_205100811=獵戶座腰帶三星特別明顯，坐下來歇歇？聊聊小時候關於星星的回憶，我都陪你。",
        "gal_map_text_205100812=好呀！我小時候以為星星是糖果，想摘一顆嘗嘗。現在能和人安靜看星星，還是這麼美的地方，太幸福了。",
        "gal_map_text_205100813=唐笑笑緊緊攥著你的胳膊，身體微微顫抖，煤油燈被風吹得輕輕晃動，暖光在唐笑笑臉上忽明忽暗。曖昧氛圍在兩人之間彌漫，你想借著這份悸動安撫唐笑笑，同時拉近距離。",
        "gal_map_text_205100814=伸手攬肩",
        "gal_map_text_205100815=聊許願內容",
        "gal_map_text_205100816=起身關門",
        "gal_map_text_205100817=風好像越來越大了，我們往籐椅那邊挪挪，我把外套給你披上，別著涼了，剛好再好好聊聊你小時候摘星星的趣事。",
        "gal_map_text_205100818=唐笑笑拍著胸口，臉頰泛紅，沒有鬆開你的胳膊。",
        "gal_map_text_205100819=還好有你護著我！剛才嚇我一跳，不過被你摟著肩膀，特別有安全感。",
        "gal_map_text_205100820=唐笑笑笑著往你懷裡湊了湊，身體緊緊貼向你。",
        "gal_map_text_205100821=哇！你反應好快！這樣靠在你懷裡好暖和，早知道就多待一會兒了。",
        "gal_map_text_205100822=唐笑笑聲音輕輕的，頭微微低著，手指攥著你的衣袖。",
        "gal_map_text_205100823=謝謝你…… 剛才真的有點怕。被你護著的時候，我心跳都變快了。",
        "gal_map_text_205100824=唐笑笑聲音軟糯，身體微微顫抖，順勢靠在你胸口。",
        "gal_map_text_205100825=我剛才腿都軟了…… 有你抱著，感覺特別安心。",
        "gal_map_text_205100826=有我在，別怕。你靠得再近一點，風就吹不到你了。其實剛才許願，我也希望能一直這樣陪著你。",
        "gal_map_text_205100827=嗯，有你在我就什麼都不怕了。剛才靠在你懷裡，感覺所有的害怕都消失了，還挺安心的。",
        "gal_map_text_205100828=唐笑笑臉頰泛紅，手指輕輕回握你的手。",
        "gal_map_text_205100829=我的願望其實和你有關，想以後不管是看星星還是做甜品，都能和你一起。對了，你小時候除了想摘星星，還有什麼特別想實現的願望？",
        "gal_map_text_205100830=唐笑笑眼睛亮晶晶的，主動分享，手指輕輕碰你的手。",
        "gal_map_text_205100831=我的願望和今天的約會有關！我希望以後能經常和你一起看星星、做甜品。你呢？是不是和我心有靈犀。",
        "gal_map_text_205100832=唐笑笑興奮地湊近你，語速輕快，滿臉笑意。",
        "gal_map_text_205100833=天呐！我許願說想和你一起去更多地方！原來你也這麼想，我們也太有默契了。",
        "gal_map_text_205100834=唐笑笑語氣平淡，輕輕點頭，眼神裡帶著一絲柔和。",
        "gal_map_text_205100835=我的願望很簡單，不過和你想的差不多。謝謝你願意坦誠告訴我，我很開心。",
        "gal_map_text_205100836=唐笑笑身體微微後傾，語氣疏離，但沒有打斷你的話。",
        "gal_map_text_205100837=願望說出來就不靈了。不過你願意說，我就聽著，不用追問我。",
        "gal_map_text_205100838=我的願望就是以後能和你一起看更多次星星、做更多喜歡的事。原來我們這麼有默契，這就是心有靈犀吧。",
        "gal_map_text_205100839=真的太有默契了！我從來沒和人這麼合拍過。以後我們一定要把願望一一實現，創造更多美好的回憶。",
        "gal_map_text_205100840=唐笑笑側頭看你，嘴角帶著淺淺笑意。",
        "gal_map_text_205100841=門已經關好啦，風小多了。你在這裡坐著等我，我去旁邊的便利店買兩杯熱飲，回來我們繼續看星星、聊心願。",
        "gal_map_text_205100842=唐笑笑主動鬆開你的胳膊，笑著示意你快去，語氣幹練。",
        "gal_map_text_205100843=好呀，這裡風確實大。你快去關門，我在這裡等你，順便整理一下頭髮。",
        "gal_map_text_205100844=唐笑笑語氣帶著小驕傲，起身往平臺入口走，腳步輕快。",
        "gal_map_text_205100845=不用你特意去，我自己去關門就行！不過還是謝謝你，這麼細心。",
        "gal_map_text_205100846=唐笑笑輕輕拉著你的手，眼神依賴地看著你，聲音軟軟的。",
        "gal_map_text_205100847=哇，你好細心！我一個人在這裡有點怕，你快去快回，別讓我等太久。",
        "gal_map_text_205100848=唐笑笑緊緊拉住你的手，身體幾乎靠在你身上，眼神滿是依賴。",
        "gal_map_text_205100849=我不敢一個人待著…… 你能不能帶著我一起去？有你在身邊，我就不害怕了。",
        "gal_map_text_205100850=你在這裡乖乖等著，我馬上就回來。別亂跑，要是害怕就喊我，我能聽到。",
        "gal_map_text_205100851=好，我等你回來。你快點，別讓我等太久。其實有你這麼細心照顧我，我真的很開心。",
        "gal_map_text_205100852=唐笑笑輕輕點頭，眼神裡滿是期待。",
        "gal_map_text_205100853=風漸漸小了，星星變得更加明亮。你們並肩坐在籐椅上，肩膀緊緊貼在一起，手裡握著彼此的手。唐笑笑靠在你肩膀上輕聲說：“今天真的太難忘了，從甜品店到小巷，再到這個觀星閣，每一刻都很開心。” 唐笑笑抬頭看你，眼神裡滿是依賴和溫柔：“以後不管去哪裡，只要有你在，我就很滿足。” 你們靜靜地坐了一會兒，享受著這份寧靜和曖昧，彼此的心意在沉默中傳遞，好感度達到了臨近告白的臨界點。",
        "gal_map_text_205100854=巨大的主題扭蛋牆足足兩米高，擺滿密密麻麻的扭蛋機，涵蓋未知生物骨骼標本、世界名勝微縮模型、“真心話”“大冒險”等趣味系列。扭蛋牆旁圍著幾個年輕人討論“隱藏款”，空氣中彌漫著塑膠與興奮的氣息，熱鬧又有趣。",
        "gal_map_text_205100855=離開氣球小販，你們被主題扭蛋牆吸引，唐笑笑拉著你的手在扭蛋機之間穿梭：“這個‘真心話’扭蛋好有意思！還有埃菲爾鐵塔微縮模型，和我想去的地方一模一樣！” 唐笑笑在“情侶默契”扭蛋機前停下，你們各扭一次，居然開出同款小愛心配件，兌換到“情侶默契勳章”。店員提議參與“真心話”挑戰，唐笑笑拿著勳章眼睛亮晶晶：“我們繼續挑戰！我問你答，不許撒謊！” 手指輕輕碰了碰你的手，眼神裡滿是羞澀與期待。",
        "gal_map_text_205100856=這個“情侶默契”扭蛋真有意思，我們試試？不管開出什麼，都是我們的專屬回憶，我都陪你。",
        "gal_map_text_205100857=好呀好呀！我們先試“情侶默契”的，再扭“真心話”的。我想知道你有沒有小秘密沒告訴過我，也想和你比比誰的運氣好。",
        "gal_map_text_205100858=唐笑笑緊緊攥著情侶默契勳章，手指輕輕摩挲著勳章邊緣，臉頰泛紅，眼神裡滿是期待。扭蛋機的燈光閃爍，映在唐笑笑臉上，曖昧氛圍漸濃。你想借著這個機會拉近距離，4個迴圈選項貼合當下互動場景。",
        "gal_map_text_205100859=坦誠心意",
        "gal_map_text_205100860=追隱藏款",
        "gal_map_text_205100861=兌換甜品",
        "gal_map_text_205100862=定制勳章",
        "gal_map_text_205100863=其實我對你的感覺很特別，和你在一起的每一刻都很開心。那你呢？除了想知道我的感覺，你心裡是不是也有話想對我說？",
        "gal_map_text_205100864=唐笑笑眼睛亮晶晶的，主動拿起“真心話”扭蛋，語氣裡滿是期待，身體微微靠近。",
        "gal_map_text_205100865=好呀好呀！我要問你，你對我的感覺怎麼樣？不許撒謊！其實我也有話想對你說。",
        "gal_map_text_205100866=唐笑笑興奮地湊近你，語速輕快，臉頰泛紅，雙手緊緊攥著扭蛋。",
        "gal_map_text_205100867=天呐！終於可以問你了！我一直想知道，你是不是也喜歡和我待在一起？快如實回答",
        "gal_map_text_205100868=唐笑笑語氣平淡，拿起扭蛋機的搖杆，眼神裡沒有過多情緒，保持適當距離。",
        "gal_map_text_205100869=問就問吧，不過我也不會問太私人的問題。你如實回答就好，我聽著。",
        "gal_map_text_205100870=唐笑笑身體微微後傾，語氣疏離，卻還是準備參與，手指輕輕搭在扭蛋機上。",
        "gal_map_text_205100871=其實我覺得沒必要玩這個，不過既然你想試，我就配合你。別問太奇怪的問題。",
        "gal_map_text_205100872=我對你的感覺很好，和你在一起的每一天都很開心。其實我也很喜歡和你待在一起，想和你創造更多美好的回憶。",
        "gal_map_text_205100873=哇，聽到你這麼說我真的太開心了！其實我也很喜歡和你待在一起，不管做什麼都覺得很有意思。",
        "gal_map_text_205100874=唐笑笑臉頰泛紅，嘴角帶著甜甜的笑容。",
        "gal_map_text_205100875=我們分工合作，你負責觀察扭蛋機指示燈的規律，我負責投幣，爭取把隱藏款一次性拿下，回去和我們的情侶扭蛋湊一套。",
        "gal_map_text_205100876=唐笑笑興奮地拍手，眼神緊緊盯著扭蛋機，語氣裡滿是鬥志，認真觀察。",
        "gal_map_text_205100877=好耶！追隱藏款太有意思了！我負責觀察扭蛋機指示燈，你負責投幣，我們分工合作，肯定能抽到。",
        "gal_map_text_205100878=唐笑笑拉著你的手在扭蛋機之間穿梭，腳步輕快，興奮地大喊，手指指著指示燈。",
        "gal_map_text_205100879=哇！隱藏款聽起來好酷！我們快點找，爭取把所有系列的隱藏款都抽到，成為“扭蛋大神”。",
        "gal_map_text_205100880=唐笑笑語氣溫和，認真觀察扭蛋機的狀態，語氣裡滿是耐心，慢慢記錄指示燈變化。",
        "gal_map_text_205100881=追隱藏款可以，不過不用太著急。我們慢慢找，仔細觀察，總能抽到的。",
        "gal_map_text_205100882=唐笑笑語氣平靜，邏輯清晰，開始分析扭蛋機的規律，時不時和你交流。",
        "gal_map_text_205100883=其實隱藏款概率很低，不過既然你想試，我就陪你。我們理性分析，慢慢找，不用盲目投幣。",
        "gal_map_text_205100884=好，我們分工合作！你負責觀察，我負責投幣。只要我們齊心協力，肯定能抽到隱藏款。找到隱藏款我們就去兌換甜品慶祝。",
        "gal_map_text_205100885=好！我們一定能抽到！我已經觀察到這個扭蛋機的規律了，快投幣試試，說不定這次就能中。",
        "gal_map_text_205100886=唐笑笑手指著扭蛋機，語氣裡滿是期待。",
        "gal_map_text_205100887=剛好扭蛋店可以用積分兌換甜夢研究所的迷你甜品，我兌換了兩份草莓慕斯，來，張嘴，讓我嘗嘗你的手藝有沒有進步。",
        "gal_map_text_205100888=唐笑笑著點頭，主動張開嘴巴，眼神裡滿是期待，吃完後拿起另一份喂你。",
        "gal_map_text_205100889=好呀好呀！我要吃“甜夢專屬”甜品，你喂我吃。不過作為交換，我也會喂你吃的。",
        "gal_map_text_205100890=唐笑笑興奮地湊近你，身體微微前傾，語氣裡滿是激動，張嘴等著餵食。",
        "gal_map_text_205100891=哇！甜品聽起來好甜！你快喂我吃，我已經迫不及待了。這個甜品肯定超好吃。",
        "gal_map_text_205100892=唐笑笑臉頰泛紅，聲音輕輕的，眼神裡滿是期待，慢慢張開嘴巴。",
        "gal_map_text_205100893=其實…… 我也想嘗嘗那個甜品。如果你不介意的話，喂我吃一口就好。",
        "gal_map_text_205100894=唐笑笑聲音軟糯，頭微微低著，臉頰泛紅，不好意思地靠近。",
        "gal_map_text_205100895=甜品看起來好好吃，不過我自己吃就好。如果你想喂我，我…… 我也不介意。",
        "gal_map_text_205100896=來，張嘴，嘗嘗這個“甜夢專屬”甜品，甜不甜？我特意選了草莓味的，知道你喜歡。",
        "gal_map_text_205100897=哇，好甜！太好吃了！現在換我喂你吃，你也要好好嘗嘗這個美味的甜品。",
        "gal_map_text_205100898=唐笑笑興奮地舀起一勺甜品，遞到你嘴邊，眼神裡滿是笑意。",
        "gal_map_text_205100899=我們把名字縮寫和今天的日期刻在勳章上，做成專屬情侶款，以後不管去哪裡，都能帶著這份紀念，想起今天的扭蛋冒險。",
        "gal_map_text_205100900=唐笑笑笑著點頭，主動和店員溝通刻字字體，語氣幹練，認真挑選。",
        "gal_map_text_205100901=好呀！我們把名字縮寫刻在勳章上，再加上今天的日期。不過我要自己選刻字的字體，我喜歡可愛一點的。",
        "gal_map_text_205100902=唐笑笑語氣帶著小驕傲，主動和店員對接，安排得井井有條，和店員確認細節。",
        "gal_map_text_205100903=沒問題！刻字的事交給我，我知道哪種字體好看。你放心，我肯定能刻得漂漂亮亮的。",
        "gal_map_text_205100904=唐笑笑輕輕靠在你身邊，眼神依賴地看著你，聲音軟軟的，跟著你一起選。",
        "gal_map_text_205100905=哇，這個主意好浪漫！我都聽你的，你選字體、選位置就好。只要是和你一起定制的，我都喜歡。",
        "gal_map_text_205100906=唐笑笑緊緊拉住你的手，身體微微靠近你，語氣裡滿是信任，乖乖站在你身邊。",
        "gal_map_text_205100907=我沒什麼想法，都聽你的。你想怎麼刻就怎麼刻，我相信你的眼光。只要能和你一起定制勳章，我就很開心。",
        "gal_map_text_205100908=我們把名字縮寫刻在一起，再加上今天的日期，這樣以後看到勳章，就能想起今天一起扭蛋、贏默契獎的時光。",
        "gal_map_text_205100909=好呀！我想選可愛的字體，這樣勳章會更特別。以後看到這個勳章，就會想起今天的開心時光，還有你對我的心意。",
        "gal_map_text_205100910=唐笑笑臉頰泛紅，嘴角帶著淺淺笑意。",
        "gal_map_text_205100911=唐笑笑主動握住你的手，手指緊緊相扣：“以後我們還要一起扭很多扭蛋，挑戰更多默契遊戲。和你在一起，不管做什麼都很有意思。” 你看著唐笑笑燦爛的笑容，心裡充滿了暖意，彼此的心意在甜蜜的氛圍中逐漸清晰，就差最後一步的告白。",
        "gal_map_text_205100912=博物館角落的DIY迷你音樂盒工作臺，擺放著空白小木盒、五顏六色的顏料、畫筆和各類扭蛋配件——小齒輪、卡通人物、迷你扭蛋模型，還能選擇《天空之城》《卡農》等經典音樂晶片。工作臺旁只有一對情侶安靜創作，氛圍專注溫馨，空氣中彌漫著木質與顏料的淡淡氣息。",
        "gal_map_text_205100913=走出光影隧道，唐笑笑被DIY音樂盒工作臺吸引，拿起白色小木盒眼神滿是期待：“我想做帶情侶扭蛋圖案的音樂盒，選《天空之城》旋律，不過我畫畫不好，你得幫我。” 你們分工合作，唐笑笑負責塗色裝飾，你負責畫圖案、裝音樂晶片，合作得十分默契。就在安裝晶片時，唐笑笑不小心把膠水蹭到手指，又抹到木盒上留下印記，瞬間慌了神：“怎麼辦？都怪我不小心。” 你伸手想幫唐笑笑擦手指，唐笑笑下意識握住你的手，指尖微微顫抖。",
        "gal_map_text_205100914=《天空之城》旋律很溫柔，和你很配。我們一起做獨一無二的音樂盒，做好後我放床頭，聽著就想起今天。",
        "gal_map_text_205100915=好呀！我給扭蛋配件塗亮晶晶的顏料，你畫圖案時要把我們的情侶扭蛋畫得近一點。",
        "gal_map_text_205100916=唐笑笑看著木盒上的印記，眼裡滿是自責，手指緊緊攥著你的手。你看著唐笑笑慌亂又倔強的樣子，想借著這個小意外拉近距離，升溫感情。",
        "gal_map_text_205100917=溫柔擦手",
        "gal_map_text_205100918=掩蓋印記",
        "gal_map_text_205100919=分享遺憾",
        "gal_map_text_205100920=你手指上的膠水擦乾淨啦，我把這個小印記改成愛心圖案，正好當我們的專屬標記，以後聽音樂的時候就想起今天的小意外。",
        "gal_map_text_205100921=唐笑笑臉頰泛紅，沒有鬆開你的手，主動湊近看圖案。",
        "gal_map_text_205100922=謝謝你幫我擦手！這個小愛心圖案好特別，比原來的樣子還好看",
        "gal_map_text_205100923=唐笑笑興奮地摟住你的胳膊，身體緊緊貼向你。",
        "gal_map_text_205100924=哇！你也太會救場了吧！早知道故意弄點印記讓你設計了",
        "gal_map_text_205100925=唐笑笑聲音輕輕的，頭微微低著，手指輕輕摩挲木盒。",
        "gal_map_text_205100926=其實…… 我還挺自責的，還好有你。這個圖案很可愛，謝謝你不怪我。",
        "gal_map_text_205100927=唐笑笑聲音軟糯，眼神裡滿是感激，慢慢靠向你。",
        "gal_map_text_205100928=我以為會搞砸…… 謝謝你幫我補救。這個愛心圖案，我很喜歡",
        "gal_map_text_205100929=能幫你補救就好，你的手指軟軟的，粘到膠水都可愛。這個愛心圖案，就當是我們的專屬標記。",
        "gal_map_text_205100930=你別調侃我啦！不過這個標記真的很特別，以後看到就想起今天你幫我擦手的樣子。",
        "gal_map_text_205100931=唐笑笑臉頰泛紅，主動拿起顏料幫你塗色。",
        "gal_map_text_205100932=我們用星星亮片和迷你扭蛋模型裝飾一下，剛好和音樂盒的《天空之城》主題呼應，讓它變成獨一無二的專屬款。",
        "gal_map_text_205100933=唐笑笑眼睛亮晶晶，主動拿起亮片往木盒上貼。",
        "gal_map_text_205100934=這個星星配件太合適了！我們再加點亮片，肯定更特別。剛才謝謝你沒有責怪我",
        "gal_map_text_205100935=唐笑笑興奮地湊近你，語速輕快，滿臉笑意。",
        "gal_map_text_205100936=天呐！這樣完全看不出印記了！我們再貼點小扭蛋模型，讓音樂盒變成專屬款。",
        "gal_map_text_205100937=唐笑笑語氣平淡，輕輕拿起亮片，有節奏地粘貼。",
        "gal_map_text_205100938=嗯，這樣挺好的，能掩蓋印記就好。亮片別貼太多，不然會顯得亂。",
        "gal_map_text_205100939=唐笑笑身體微微後傾，語氣疏離，但還是配合你粘貼配件。",
        "gal_map_text_205100940=其實不用這麼麻煩，簡單蓋住就行。不過還是謝謝你的提議。",
        "gal_map_text_205100941=我們再把情侶扭蛋模型貼在旁邊，和愛心圖案呼應。這樣既有設計感，又都是我們的回憶。",
        "gal_map_text_205100942=好呀好呀！這樣搭配起來超好看。和你一起做手工，就算出錯也很有意思。",
        "gal_map_text_205100943=唐笑笑興奮地接過模型，小心翼翼地貼在木盒上。",
        "gal_map_text_205100944=我小時候做手工也總搞砸，比如把膠水粘滿手，最後作品雖然不完美，但每次看到都能想起當時的開心，其實不完美才更難忘。",
        "gal_map_text_205100945=唐笑笑笑著捏了捏你的手，眼裡滿是笑意。",
        "gal_map_text_205100946=原來你小時候也會搞砸手工呀！那我心裡平衡多了。這個小印記，以後就是我們的專屬回憶。",
        "gal_map_text_205100947=唐笑笑",
        "gal_map_text_205100948=哇！你居然也有糗事！那我們的音樂盒就是“不完美專屬款”，以後看到就想起今天。",
        "gal_map_text_205100949=唐笑笑語氣溫和，輕輕拿起畫筆，繼續裝飾。",
        "gal_map_text_205100950=你說得對，有遺憾的作品才更有回憶。我們繼續完成剩下的部分，肯定能做出好看的音樂盒",
        "gal_map_text_205100951=唐笑笑語氣平靜，眼神裡的自責漸漸消散。",
        "gal_map_text_205100952=其實我也知道不用追求完美，只是有點自責。謝謝你的安慰，我們一起把它做完吧。",
        "gal_map_text_205100953=小時候做手工總怕搞砸，後來發現不完美才更難忘。這個小印記，以後就是我們的“專屬回憶點”。",
        "gal_map_text_205100954=你這麼說我就放心了！其實我很少和人一起做手工，你是第一個願意陪我補救錯誤的人。",
        "gal_map_text_205100955=唐笑笑側頭看你，嘴角帶著淺淺笑意。",
        "gal_map_text_205100956=音樂盒終於完成，《天空之城》的溫柔旋律緩緩流淌。唐笑笑靠在你身邊認真聽著，眼神裡滿是感動：“這是我收到過最特別的禮物，以後每天都會聽，想起今天你握著我的手做手工的樣子。” 唐笑笑小心翼翼地抱著音樂盒：“謝謝你願意陪我補救錯誤，和你在一起，就算出錯也很開心。” 旋律在空氣中回蕩，曖昧氛圍越來越濃，彼此都能感受到對方的心意，就差一個合適的時機說出心裡話。",
        "gal_map_text_205100957=博物館角落的復古大頭貼機，裝飾得花裡胡哨，貼滿彩色貼紙和卡通圖案，螢幕迴圈播放會眨眼的星星、飄動的愛心等可愛特效，還有“情侶專屬”相框範本——甜美粉色愛心款、復古膠片款等款式繁多。空氣中殘留著輕微的塑膠貼紙氣味，混合著場館內淡淡的木質香氣，復古按鍵聲和輕快背景音交織，熱鬧又懷舊。",
        "gal_map_text_205100958=走出光影隧道，唐笑笑瞬間被復古大頭貼機吸引，拉著你的手快步上前：“哇，我小時候超喜歡拍大頭貼！我們也拍一組，選愛心相框，加好多可愛特效～” 你投幣後，唐笑笑興奮地挑選相框，嘴裡嘀咕：“這個粉愛心好甜，膠片款也有感覺……” 剛選定三組相框，機器突然黑屏，傳出“滋滋”電流聲，唐笑笑嚇了一跳，下意識抱住你的胳膊。",
        "gal_map_text_205100959=幾秒後螢幕恢復正常，卻提示“僅能拍攝一組，贈送情侶貼紙一套”，唐笑笑撅著嘴巴委屈地看著你：“只能拍一組了，好可惜。”",
        "gal_map_text_205100960=我好久沒拍大頭貼了，今天陪你重溫童年。就算只能拍一組，我們也能靠貼紙裝飾得很特別。",
        "gal_map_text_205100961=太棒了！我們要拍貼臉的，還要加愛心特效。你等下不許僵硬，要笑起來露出牙齒，拍出來才好看。",
        "gal_map_text_205100962=唐笑笑拿著情侶貼紙，手指輕輕攥著機器邊緣，臉頰泛紅：“其實…… 我想拍稍微親密點的，但又有點不好意思。” 機器倒計時提示音響起，螢幕上的愛心特效開始閃爍，曖昧氛圍在兩人之間悄然彌漫，你想借著這份悸動進一步拉近距離。",
        "gal_map_text_205100963=選貼臉相框，安撫唐笑笑",
        "gal_map_text_205100964=選搞怪特效，逗唐笑笑笑",
        "gal_map_text_205100965=承諾下次再拍，補償唐笑笑",
        "gal_map_text_205100966=用貼紙，裝飾照片",
        "gal_map_text_205100967=這個貼臉相框的愛心特效剛好能擋住機器的小瑕疵，我們靠近一點，把影子拍得連在一起，看起來更有情侶感，肯定特別好看。",
        "gal_map_text_205100968=唐笑笑主動往你身邊湊，臉頰幾乎貼到你的臉，配合調整姿勢。",
        "gal_map_text_205100969=好呀好呀！靠這麼近真的好甜～ 你托著我臉的時候，我心跳都加速了。",
        "gal_map_text_205100970=唐笑笑興奮地摟住你的脖子，身體緊緊貼向你，眼裡滿是雀躍。",
        "gal_map_text_205100971=哇！這樣也太親密了吧～ 不過我超喜歡！你靠過來一點，再近一點。",
        "gal_map_text_205100972=唐笑笑乖乖靠向你，保持合適距離，表情平靜，眼神盯著鏡頭。",
        "gal_map_text_205100973=嗯，這樣挺好的，不會太刻意。拍的時候別亂動，儘量一次拍好。",
        "gal_map_text_205100974=唐笑笑身體微微僵硬，還是輕輕靠向你，語氣平淡，配合拍照。",
        "gal_map_text_205100975=其實不用靠這麼近，保持一點距離也能拍得好看。",
        "gal_map_text_205100976=能和你拍這麼親密的合照，我開心還來不及呢。你靠得再近一點，讓愛心特效把我們裹在一起。",
        "gal_map_text_205100977=哇，這樣真的好甜～ 拍照的時候，我感覺心跳都快停了。以後看到這張照片，就會想起今天的小意外和你的溫柔。",
        "gal_map_text_205100978=唐笑笑臉頰泛紅，手指輕輕攥著你的衣角。",
        "gal_map_text_205100979=我們選兔子耳朵和吐舌頭的搞怪特效，剛好能化解只能拍一組的小遺憾，拍出來又可愛又有紀念意義，以後看了還能笑出來。",
        "gal_map_text_205100980=唐笑笑興奮地對著螢幕做鬼臉，動作誇張可愛。",
        "gal_map_text_205100981=哈哈，這個搞怪特效也太有意思了！我吐舌頭你戴兔子耳朵，肯定能拍出超搞笑的照片。",
        "gal_map_text_205100982=唐笑笑瘋狂切換特效，手腳並用地比姿勢，語氣雀躍。",
        "gal_map_text_205100983=哇！這個兔子耳朵特效好可愛！我們一起搞怪～ 你吐舌頭我歪頭，再比個歪歪扭扭的愛心。",
        "gal_map_text_205100984=唐笑笑輕輕調整表情，做溫和的搞怪姿勢，語氣平靜。",
        "gal_map_text_205100985=搞怪特效確實能緩解尷尬，這個兔子耳朵還挺可愛的。我們稍微收斂一點，別太誇張。",
        "gal_map_text_205100986=唐笑笑表情平靜，按照你說的做簡單搞怪動作，眼神專注。",
        "gal_map_text_205100987=其實我不太擅長搞怪，但既然你想試，我就配合你。你選好姿勢告訴我。",
        "gal_map_text_205100988=你吐舌頭的樣子好可愛，這個兔子耳朵特效和你超配。以後看到這張照片，肯定會想起今天笑到肚子痛的樣子。",
        "gal_map_text_205100989=哈哈，你戴兔子耳朵也太搞笑了！其實親密的合照真的很有紀念意義，以後翻看的時候，就能想起今天的小羞澀。",
        "gal_map_text_205100990=唐笑笑笑著繼續做搞怪姿勢，眼裡滿是笑意。",
        "gal_map_text_205100991=下次我提前查好這家店的營業時間，避開高峰期，我們把所有相框和特效都試一遍，拍一整本大頭貼，彌補今天的小遺憾。",
        "gal_map_text_205100992=唐笑笑笑著點頭，眼神裡滿是期待。",
        "gal_map_text_205100993=好呀！你不許反悔，下次一定要專門陪我來拍，把所有相框和特效都試一遍。",
        "gal_map_text_205100994=唐笑笑語氣帶著小驕傲，快速選定相框。",
        "gal_map_text_205100995=放心，我本來就打算下次再來的！這次故障不算什麼，我們先把這組拍好。",
        "gal_map_text_205100996=唐笑笑輕輕靠在你的胳膊上，眼神依賴地看著你。",
        "gal_map_text_205100997=哇，你真好！那我們下次一定要來，我想拍那個膠片款和星星款的。",
        "gal_map_text_205100998=唐笑笑緊緊拉住你的手，身體微微靠近你。",
        "gal_map_text_205100999=其實只要能和你一起拍，拍幾組都無所謂。你說下次來就一定來，我相信你。",
        "gal_map_text_205101000=下次我提前做攻略，把所有好看的相框都列出來，我們從早拍到晚，拍個夠本。",
        "gal_map_text_205101001=好呀好呀！你可不許反悔。其實我小時候也攢了一整本大頭貼，後來搬家弄丟了，一直很遺憾。",
        "gal_map_text_205101002=唐笑笑主動分享回憶，手指輕輕碰了碰你的手。",
        "gal_map_text_205101003=我們用這些情侶貼紙把照片裝飾得滿滿當當，貼滿愛心和星星，再寫上彼此的名字縮寫，讓它變成獨一無二的專屬紀念。",
        "gal_map_text_205101004=唐笑笑拿起貼紙就開始動手，動作乾脆。",
        "gal_map_text_205101005=好呀好呀！我負責貼愛心和星星，你貼我們的名字縮寫。我們把照片貼得滿滿當當的。",
        "gal_map_text_205101006=唐笑笑瘋狂往照片上貼貼紙，手指飛快。",
        "gal_map_text_205101007=哇！這些情侶貼紙也太甜了吧！我要把所有愛心貼紙都用上，再貼滿我們的名字縮寫。",
        "gal_map_text_205101008=唐笑笑拿起貼紙猶豫了一下，輕輕貼在照片角落。",
        "gal_map_text_205101009=其實…… 這些貼紙都挺好看的，我們稍微貼一點就好，不用太滿。",
        "gal_map_text_205101010=唐笑笑聲音軟軟的，輕輕拿起貼紙遞給你。",
        "gal_map_text_205101011=這些貼紙都很可愛，你想怎麼貼都可以。我…… 我幫你遞貼紙。",
        "gal_map_text_205101012=你貼的星星好好看，我們的名字縮寫放在一起也很配。這張照片雖然只有一組，但比拍好幾組還特別。",
        "gal_map_text_205101013=是啊！這樣裝飾完，完全看不出只能拍一組的遺憾了。以後我們把它貼在手機殼上，走到哪裡都能看到。",
        "gal_map_text_205101014=唐笑笑嘴角帶著甜甜的笑容，繼續認真貼貼紙。",
        "gal_map_text_205101015=你們拿著裝飾好的大頭貼，照片上的兩人或貼臉甜笑，或搞怪賣萌，周圍貼滿愛心、星星貼紙和彼此的名字縮寫，滿滿都是專屬感。唐笑笑把照片從中間撕開，遞給你一半：“你拿一半，我拿一半，這樣我們就有專屬的情侶信物了。” 離開大頭貼機時，唐笑笑把自己的那半小心翼翼放進錢包裡：“下次你一定要帶我再來拍，不許反悔！其實…… 我很喜歡和你一起拍照片，想把我們在一起的每一刻都記錄下來。”",
        "gal_map_text_205101016=路過文創區時，唐笑笑拉著你停下腳步，拿起和照片風格匹配的情侶掛繩：“我們給照片買個掛繩，掛在手機上，走到哪裡都能看到。” 場館內的燈光柔和落在唐笑笑臉上，曖昧氣息越來越濃，彼此的好感度又上升了一大截，就差最後一步的心意傳遞。",
        "gal_map_text_205101017=露臺邊緣的觀景欄杆前，城市夜景毫無遮擋鋪展。車流劃出光軌如流動星河，遠處高樓霓虹勾勒城市輪廓，晚風裹挾草木清香，吹起唐笑笑的長髮，帶著淡淡的洗髮水味，欄杆冰涼與夜色交融，浪漫氛圍拉滿。",
        "gal_map_text_205101018=秋千上的對話讓氣氛柔軟，唐笑笑提議去觀景欄杆看看。你們並肩走向欄杆，唐笑笑扶著欄杆抬頭望星、低頭俯瞰夜景，眼神滿是憧憬。頭髮被風吹亂時，唐笑笑抬手整理，指尖不經意碰到你的手。遠處突然綻放煙花，唐笑笑驚喜指認時腳下一滑，下意識抓住你的胳膊，身體向你倒來。",
        "gal_map_text_205101019=和你一起看夜景，感覺比平時更美好。你看那邊的摩天輪，燈火像巨大花環，要不要靠近點？風大，我幫你擋著。",
        "gal_map_text_205101020=好呀！摩天輪好漂亮，我一直想去坐卻沒人陪。和你一起站在這裡也很幸福，謝謝你幫我擋風，這樣靠著你就不冷了。",
        "gal_map_text_205101021=煙花光芒在唐笑笑臉上流轉，勾勒出溫柔側臉，眼睛亮晶晶盛滿星光。唐笑笑站穩後仍緊緊抓著你的胳膊，身體微微顫抖，眼裡帶著後怕與興奮。晚風清涼但兩人距離貼近，曖昧氛圍漸濃，你想借著悸動拉近距離。",
        "gal_map_text_205101022=伸手扶腰，穩住唐笑笑",
        "gal_map_text_205101023=聊煙花回憶，分享心事",
        "gal_map_text_205101024=帶唐笑笑去避風處休息",
        "gal_map_text_205101025=剛才真是嚇我一跳，還好扶住你了，沒摔著吧？我們往避風的地方挪挪，那邊有長椅，坐下來歇歇，順便再看看遠處的煙花餘輝。",
        "gal_map_text_205101026=唐笑笑拍著胸口，臉頰泛紅，沒鬆開你的胳膊。",
        "gal_map_text_205101027=還好有你扶我！剛才差點摔倒嚇死我了，不過你扶著我的時候，還挺有安全感的。",
        "gal_map_text_205101028=唐笑笑笑著調侃，身體緊緊往你身邊靠。",
        "gal_map_text_205101029=哇！你反應好快！被你攬著腰的感覺好特別，早知道就故意站不穩了。",
        "gal_map_text_205101030=唐笑笑聲音輕輕的，頭微低，手指攥著你的衣袖。",
        "gal_map_text_205101031=謝謝你…… 剛才真的嚇到我了。你扶著我的時候，我心跳都變快了。",
        "gal_map_text_205101032=唐笑笑聲音軟糯，身體微顫，順勢輕輕靠在你懷裡。",
        "gal_map_text_205101033=還好有你…… 我剛才腿都軟了。被你抱著，感覺很安心。",
        "gal_map_text_205101034=剛才嚇死我了，還好扶住你。你剛才嚇得身體都在抖，現在好點了嗎？",
        "gal_map_text_205101035=好多了，有你在就不怕了。剛才太突然了，還好你反應快，不然我肯定摔慘了。",
        "gal_map_text_205101036=唐笑笑臉頰仍泛紅，手指緊緊抓著你的衣袖。",
        "gal_map_text_205101037=我小時候過年，全家一起看煙花、放孔明燈，現在想想還懷念。你奶奶真好，還會告訴你這樣的小美好，你放孔明燈時會許什麼願呀？",
        "gal_map_text_205101038=唐笑笑眼睛亮晶晶，主動分享，手指輕碰你的手。",
        "gal_map_text_205101039=我小時候和奶奶一起看煙花！奶奶說看到煙花能實現願望，現在和你一起看，感覺願望要成真了。",
        "gal_map_text_205101040=唐笑笑興奮湊近，語速輕快，滿臉笑意。",
        "gal_map_text_205101041=天呐！你也喜歡看煙花呀！我小時候總追著煙花跑，現在有你陪著，站在這裡就超幸福。",
        "gal_map_text_205101042=唐笑笑語氣平淡，輕輕點頭，眼神帶一絲柔和。",
        "gal_map_text_205101043=我小時候也看過煙花，沒什麼特別回憶，但和你一起看，確實挺有意思。",
        "gal_map_text_205101044=唐笑笑身體微後傾，語氣疏離，沒打斷你。",
        "gal_map_text_205101045=煙花而已，沒什麼好看的。不過你想聊，我就聽你說。",
        "gal_map_text_205101046=我小時候過年，全家一起看煙花、放孔明燈，現在想想還懷念。你奶奶真好，還會告訴你這樣的小美好。",
        "gal_map_text_205101047=是啊，奶奶總說要記著生活裡的小幸運。現在和你一起看煙花，也是新的小幸運。你放孔明燈時會許什麼願呀？",
        "gal_map_text_205101048=唐笑笑側頭看你，眼裡滿是好奇。",
        "gal_map_text_205101049=這裡風小多了，你坐下歇歇，我給你拿水喝。剛才腿麻還受了驚嚇，別硬撐，我們慢慢坐會兒，等你緩過來再繼續看夜景。",
        "gal_map_text_205101050=唐笑笑主動提議，從包裡拿紙巾，語氣幹練。",
        "gal_map_text_205101051=好呀，這裡風確實大。我們去避風處坐會兒，我帶了紙巾，擦擦嚇出來的汗。",
        "gal_map_text_205101052=唐笑笑語氣帶小驕傲，往前走卻放慢腳步等你。",
        "gal_map_text_205101053=不用你扶，我自己能走！不過謝謝你，避風處更舒服，我去占位置。",
        "gal_map_text_205101054=唐笑笑輕輕拉你的手，身體微依賴地靠向你。",
        "gal_map_text_205101055=哇，你好細心！我剛才腿還在抖，正好去坐會兒，你扶著我點，怕又站不穩。",
        "gal_map_text_205101056=唐笑笑緊緊拉你的手，身體幾乎靠在你身上，聲音軟軟的。",
        "gal_map_text_205101057=我走不動了…… 你扶著我好不好？有你在我就不害怕，去哪裡都聽你的。",
        "gal_map_text_205101058=這裡風小多了，你坐下歇歇，我給你拿水喝。剛才腿麻還受了驚嚇，別硬撐。",
        "gal_map_text_205101059=謝謝你，還是你想的周到。坐在這裡確實舒服多了，剛才在欄杆邊，風都快把我吹跑了。",
        "gal_map_text_205101060=唐笑笑接過水壺喝一口，嘴角帶笑。",
        "gal_map_text_205101061=煙花漸漸放完，夜空恢復寧靜。你們並肩坐在避風處，手握彼此的手，感受對方溫度。唐笑笑靠在你肩膀上輕聲說：“剛才被你抱著的時候很安心，我很喜歡這種被你保護的感覺。” 唐笑笑抬頭看你，眼裡滿是溫柔：“以後不管遇到什麼危險，只要你在，我就什麼都不怕。和你一起看夜景、看煙花，是我最美好的回憶。” 晚風帶草木清香，心意在溫柔氛圍中傳遞，好感度達頂峰。",
        "gal_map_text_205101062=農場入口的透明小暖房內，橘黃色燈光柔和溫暖，暖意混合濕潤泥土氣息與香草清香。幾張籐椅圍繞小圓桌，角落吧台後，農場阿姨煮著蘋果肉桂茶，香氣彌漫，暖房裡種滿多肉與香草，綠意盎然，靜謐治癒。",
        "gal_map_text_205101063=晚風帶涼意，唐笑笑搓著手臂說“有點冷了”。你提議去暖房休息，兩人走進暖房瞬間驅散涼意。阿姨遞上熱飲，唐笑笑雙手捧杯取暖，指著一盆多肉說像小嬰兒。你們聊天時，阿姨端來香草小餅乾，提議參與“心願牌”活動，唐笑笑咬著餅乾，眼睛亮晶晶地說想把去海邊的願望寫下來，聲音漸小，臉頰泛紅。",
        "gal_map_text_205101064=蘋果肉桂茶的香氣太治癒了，這些多肉和你一樣可愛。我們坐會兒聊聊，你想去哪裡，我都陪你。",
        "gal_map_text_205101065=好呀！我想去海邊看日出撿貝殼，不過我有點怕水。和你一起去，我應該就不怕了。",
        "gal_map_text_205101066=唐笑笑拿餅乾的手指微微蜷縮，眼裡滿是羞澀與期待。暖房內燈光、茶香、餅乾香氣交織，氛圍溫馨曖昧。你看著唐笑笑放鬆的模樣，想借著溫暖拉近距離，構思4個互動方向，貼合當下氛圍。",
        "gal_map_text_205101067=聊海邊計畫",
        "gal_map_text_205101068=分享秘密",
        "gal_map_text_205101069=互寫心願",
        "gal_map_text_205101070=寫共同心願",
        "gal_map_text_205101071=你看這家民宿，陽臺正對著大海，早上拉開窗簾就能看日出，還帶小院子。我們選這家好不好？我已經開始期待和你一起在院子裡吹海風了。",
        "gal_map_text_205101072=唐笑笑興奮放下茶碗，腦袋靠在你肩膀上。",
        "gal_map_text_205101073=好耶！去海邊超開心的！我要住能看海的民宿，快讓我看看有沒有好看的。",
        "gal_map_text_205101074=唐笑笑手指快速劃手機，語氣激動。",
        "gal_map_text_205101075=哇！海邊計畫太浪漫了！我想要帶小院子的民宿，晚上能吹海風，現在就查。",
        "gal_map_text_205101076=唐笑笑輕輕放下茶碗，語氣溫和提建議。",
        "gal_map_text_205101077=海邊氛圍很愜意，行程不用太趕，民宿選乾淨舒服的就好。",
        "gal_map_text_205101078=唐笑笑拿出手機記錄，語氣平靜有條理。",
        "gal_map_text_205101079=嗯，海邊計畫不錯，我整理幾個核心需求，按這個篩選更高效。",
        "gal_map_text_205101080=你看這家民宿，陽臺正對著大海，早上拉開窗簾就能看日出，還帶小院子。我們選這家好不好？我已經開始期待和你一起看日出了。",
        "gal_map_text_205101081=哇！這個院子還有吊椅，太舒服了！我們就選這家！我還要在院子裡擺小零食，和你一起吹海風、聊心裡話。",
        "gal_map_text_205101082=唐笑笑手指戳著螢幕，語氣興奮。",
        "gal_map_text_205101083=其實我後來嘗試過學游泳，但一到深水區就想起被嗆的感覺，一直沒克服。不過有你陪著，我好像沒那麼怕了，你有沒有什麼小秘密想告訴我？",
        "gal_map_text_205101084=唐笑笑動握住你的手，語氣坦誠。",
        "gal_map_text_205101085=哇！原來你也有這樣的小秘密！我小時候超怕黑，現在有你在，一點都不怕了。",
        "gal_map_text_205101086=唐笑笑興奮湊近，主動分享自己的秘密。",
        "gal_map_text_205101087=天呐！你居然願意告訴我這個秘密！我小時候怕打雷，現在有你陪著，打雷也不怕了。",
        "gal_map_text_205101088=唐笑笑語氣平淡，輕輕點頭。",
        "gal_map_text_205101089=哦，原來你怕水。我小時候也有害怕的東西，不過現在忘了。謝謝你願意說。",
        "gal_map_text_205101090=唐笑笑微微皺眉，身體後傾，語氣疏離。",
        "gal_map_text_205101091=這種秘密沒必要說出來吧。我沒什麼想分享的，換個話題吧。",
        "gal_map_text_205101092=其實我後來嘗試過學游泳，但一到深水區就想起被嗆的感覺，一直沒克服。不過有你陪著，我好像沒那麼怕了。",
        "gal_map_text_205101093=沒關係呀，我們去海邊就待淺水區，我陪著你，絕對不讓你往深的地方去。以後不管什麼害怕的事，我們都一起面對。",
        "gal_map_text_205101094=唐笑笑握你的手緊了緊，眼神裡滿是心疼。",
        "gal_map_text_205101095=我們把想一起實現的願望寫在卡片上，交換後掛在香草架上，讓香草和願望一起成長，以後每實現一個就回來畫個勾。",
        "gal_map_text_205101096=唐笑笑認真書寫，寫完輕輕放在桌上。",
        "gal_map_text_205101097=互寫心願可以，不過我寫的願望會自己努力實現，我們也可以各自為願望加油。",
        "gal_map_text_205101098=唐笑笑語氣堅定，快速寫完後遞給你。",
        "gal_map_text_205101099=我覺得願望要靠自己實現，不過和你交換卡片也可以。我的願望我會自己完成，不用你幫忙。",
        "gal_map_text_205101100=唐笑笑依賴地看著你，寫完後把卡片遞給你。",
        "gal_map_text_205101101=好呀，我寫的願望都和你有關。我希望我們能一起實現這些願望，全靠你啦。",
        "gal_map_text_205101102=唐笑笑聲音軟軟的，等你寫完後跟著寫一樣的內容。",
        "gal_map_text_205101103=我沒什麼想法，就寫希望能一直和你在一起。你寫什麼都好，我都跟著你實現。",
        "gal_map_text_205101104=我的願望肯定和你有關，等下交換了你就知道了。希望我們的願望都能實現，以後一起把願望清單一個個打勾。",
        "gal_map_text_205101105=我也是！我的願望裡有好多和你一起做的事。交換後我們一起掛在香草架上，讓願望和香草一起成長。",
        "gal_map_text_205101106=唐笑笑接過卡片，認真書寫，寫完小心翼翼遞到你面前。",
        "gal_map_text_205101107=我們把想一起完成的小事都列出來，比如一起看海、一起煮熱飲，寫在同一張卡片上，貼緊肩膀一起寫，讓字跡也沾著彼此的溫度。",
        "gal_map_text_205101108=唐笑笑笑著點頭，起身借紙筆，回來後輕輕靠向你。",
        "gal_map_text_205101109=好呀！一起寫心願很有紀念意義。我們把想一起做的事寫上去，我去拿紙筆。",
        "gal_map_text_205101110=唐笑笑眼睛亮晶晶，興奮跑向吧台，回來後肩膀緊緊貼住你。",
        "gal_map_text_205101111=哇！這個提議超棒的！我們把心願掛在最顯眼的地方，我現在就去借紙筆。",
        "gal_map_text_205101112=唐笑笑臉頰泛紅，輕聲回應，慢慢借紙筆後輕輕挪向你。",
        "gal_map_text_205101113=其實…… 我也想和你一起寫心願。這樣以後再來暖房，就能想起今天的事了。",
        "gal_map_text_205101114=唐笑笑聲音軟軟的，頭微微低著，等你借完紙筆後主動湊近。",
        "gal_map_text_205101115=一起寫…… 好像挺好的。能和你把心願寫在一起，我很開心。",
        "gal_map_text_205101116=那我們把想一起完成的小事都列出來，比如一起看海、一起煮熱飲，每實現一個就回來畫個勾，讓心願牌變成“回憶清單”。",
        "gal_map_text_205101117=好呀！我還要加“一起再來暖房吃小餅乾”，今天的餅乾太好吃了。再加“一起看海邊日出”，圓我寫在心願牌上的願望。",
        "gal_map_text_205101118=唐笑笑起筆，在紙上畫小愛心，臉頰泛紅。",
        "gal_map_text_205101119=你們把心願牌掛在香草架上，卡片在暖房燈光下輕輕晃動，心裡滿是期待。唐笑笑靠在你身邊，捧著熱飲輕聲說：“我相信我們的願望一定會實現，以後我們會一起去海邊，一起做很多事。” 唐笑笑的聲音軟軟的，帶著羞澀：“其實…… 從一起蕩秋千開始，我就對你有不一樣的感覺了。和你在一起，我覺得很放鬆、很快樂。” 暖房暖意與香氣交織，曖昧氛圍漸濃，彼此都能感受到對方心意，就差最後一步告白確定關係。",
        "gal_map_text_205101120=商業街的繁華漸漸沉澱，暖黃燈光的手工小店沿街排列。一家陶藝工作室的櫥窗格外吸睛，裡面擺著歪扭的杯子、胖乎乎的動物擺件，還有情侶合作的手印盤，每個作品都帶著獨特溫度，泥土清香從門縫溢出，溫柔又治癒。",
        "gal_map_text_205101121=你們被櫥窗吸引推門而入，店主笑著介紹“情侶陶藝體驗”：可合作做情侶杯，現場簡單烤制留作紀念。唐笑笑眼睛亮晶晶地看著你：“我們做一對杯子吧，以後喝甜品就能用！” 你們坐在工作臺前，接過店主遞來的濕潤陶泥，指尖觸碰到泥土的溫度，仿佛能感受到彼此傳遞的心意。",
        "gal_map_text_205101122=我們合作做獨一無二的情侶杯，你塑形我修飾。從觀星閣看星星開始，和你在一起的每一刻都像甜品一樣甜，讓人捨不得結束。",
        "gal_map_text_205101123=太棒了！我要把杯子做圓滾滾的，畫兩個小愛心。不管是扭蛋、看星星還是玩陶泥，和你在一起都很安心。",
        "gal_map_text_205101124=杯子剛塑形完成，唐笑笑指尖不小心按出一個小凹陷，瞬間慌了神：“哎呀，按壞了……” 你笑著安慰唐笑笑，店主走過來說：“不完美的痕跡才是專屬回憶，能改成字母縮寫或小太陽。” 唐笑笑看著凹陷，又轉頭看向你，眼裡滿是期待，等著你的回應。",
        "gal_map_text_205101125=共同印記",
        "gal_map_text_205101126=未來約定",
        "gal_map_text_205101127=牽手印記",
        "gal_map_text_205101128=我們把凹陷改成專屬印記，刻上彼此名字首字母和小笑臉。和你在一起，順利時光或小意外都很珍貴，想一直和你創造回憶",
        "gal_map_text_205101129=唐笑笑臉頰泛紅，主動握緊你的手。",
        "gal_map_text_205101130=哼，算你識相！你說的話還挺讓人心動，這個印記很特別，以後用杯子就想起今天",
        "gal_map_text_205101131=唐笑笑笑著配合刻字，眼神溫柔。",
        "gal_map_text_205101132=好呀！一起刻印記很有意義，我也很珍惜和你在一起的時光，做什麼都開心。",
        "gal_map_text_205101133=唐笑笑輕輕靠在你肩膀，聲音軟軟的。",
        "gal_map_text_205101134=哇，好浪漫！有你的名字縮寫，看到杯子就像看到你，想一直和你創造回憶。",
        "gal_map_text_205101135=唐笑笑緊緊挨著你，眼神滿是依賴。",
        "gal_map_text_205101136=只要和你一起就好，這個專屬印記我會好好珍藏，以後常用這對杯子。",
        "gal_map_text_205101137=這個印記是我們的專屬，以後看到杯子就想起今天的心動。不管以後遇到什麼，我都想和你一起創造更多回憶。",
        "gal_map_text_205101138=我也是，和你在一起的每一刻都很珍貴。這個杯子我會好好保存，每次用都想起我們一起刻印記的樣子。",
        "gal_map_text_205101139=唐笑笑輕輕撫摸杯身，臉頰泛紅。",
        "gal_map_text_205101140=把凹陷畫成小蛋糕，和甜夢研究所超配。以後用杯子就想起今天，還想和你一起做蠟燭、畫油畫，把每一次見面都變成專屬回憶。",
        "gal_map_text_205101141=唐笑笑興奮湊近，眼睛亮晶晶。",
        "gal_map_text_205101142=好呀好呀！畫小蛋糕太可愛了！我加個小愛心，以後每月都來一次手工約會。",
        "gal_map_text_205101143=唐笑笑拿起畫筆一起創作，笑容燦爛。",
        "gal_map_text_205101144=這個想法不錯，和你嘗試新事物很有意思，我們把所有手工都體驗一遍。",
        "gal_map_text_205101145=唐笑笑語氣平淡，但配合畫圖案，眼神柔和。",
        "gal_map_text_205101146=嗯，圖案和場館很搭，以後用杯子能想起今天，挺好的。",
        "gal_map_text_205101147=唐笑笑身體微後傾，不拒絕也不主動。",
        "gal_map_text_205101148=不用搞複雜，簡單畫就行，你說的未來約定我沒意見。",
        "gal_map_text_205101149=我們把每一次手工約會都記錄下來，下次做蠟燭時，就用這對杯子喝甜飲，讓回憶連在一起。",
        "gal_map_text_205101150=好呀！我已經開始期待下次了。這個杯子上的小蛋糕，會提醒我和你在一起的每一份甜。",
        "gal_map_text_205101151=唐笑笑主動畫小愛心，語氣興奮。",
        "gal_map_text_205101152=我們把彼此手印印在凹陷旁，變成牽手圖案。我喜歡和你牽手的溫暖安心，想一直這樣牽著你走下去。",
        "gal_map_text_205101153=唐笑笑主動按手印，臉頰泛紅。",
        "gal_map_text_205101154=好呀！牽手印記很特別，和你牽手確實安心，以後看到杯子就想起現在的感覺。",
        "gal_map_text_205101155=唐笑笑興奮按手印，輕輕蹭你的手。",
        "gal_map_text_205101156=哇！這個主意超棒，我們的手印貼在一起，像永遠不分開。",
        "gal_map_text_205101157=唐笑笑輕輕按手印，聲音輕輕的。",
        "gal_map_text_205101158=這樣挺有意義的，和你牽手很溫暖，我很珍惜。",
        "gal_map_text_205101159=唐笑笑小心翼翼按手印，身體微靠近。",
        "gal_map_text_205101160=我喜歡和你牽手，這個印記會讓我想起今天的溫柔，謝謝你。",
        "gal_map_text_205101161=這對牽手印記就像我們的約定，以後不管去哪裡，我都會牽著你的手。用杯子時，就想起此刻的溫暖。",
        "gal_map_text_205101162=和你牽手真的很安心，這個印記會一直陪著我們。以後我們就用這對杯子，把每一個日常都過成回憶。",
        "gal_map_text_205101163=唐笑笑輕輕靠在你身邊，聲音軟軟的。",
        "gal_map_text_205101164=你們帶著做好的情侶杯離開陶藝工作室，杯身上的印記或圖案成為專屬紀念。唐笑笑把杯子抱在懷裡，輕聲說：“這對杯子很特別，不管是專屬印記還是小凹陷，都藏著今天的回憶。” 路過甜品店時，唐笑笑拉著你進去買了兩杯熱飲，用新做的杯子裝著：“以後我們就用這對杯子喝甜飲，把每一次甜蜜都記下來。” 暖飲的溫度透過杯子傳遞過來，像彼此靠近的心意，曖昧氛圍在日常互動中漸漸沉澱為堅定的陪伴。",
        "gal_map_text_205101165=商業街的繁華漸漸沉澱，暖黃燈光的手工小店沿街排列。一家陶藝工作室的櫥窗格外吸睛，裡面擺著歪扭的杯子、胖乎乎的動物擺件，還有情侶合作的手印盤，每個作品都帶著獨特溫度，泥土清香從門縫溢出，溫柔又治癒。",
        "gal_map_text_205101166=你們被櫥窗吸引推門而入，店主笑著介紹“情侶陶藝體驗”：可合作做情侶杯，現場簡單烤制留作紀念。唐笑笑眼睛亮晶晶地看著你：“我們做一對杯子吧，以後喝甜品就能用！” 你們坐在工作臺前，接過店主遞來的濕潤陶泥，指尖觸碰到泥土的溫度，仿佛能感受到彼此傳遞的心意。",
        "gal_map_text_205101167=我們合作做獨一無二的情侶杯，你塑形我修飾。從觀星閣看星星開始，和你在一起的每一刻都像甜品一樣甜，讓人捨不得結束。",
        "gal_map_text_205101168=太棒了！我要把杯子做圓滾滾的，畫兩個小愛心。不管是扭蛋、看星星還是玩陶泥，和你在一起都很安心。",
        "gal_map_text_205101169=杯子剛塑形完成，唐笑笑指尖不小心按出一個小凹陷，瞬間慌了神：“哎呀，按壞了……” 你笑著安慰唐笑笑，店主走過來說：“不完美的痕跡才是專屬回憶，能改成字母縮寫或小太陽。” 唐笑笑看著凹陷，又轉頭看向你，眼裡滿是期待，等著你的回應。",
        "gal_map_text_205101170=完美心意",
        "gal_map_text_205101171=陪伴心意",
        "gal_map_text_205101172=日常約定",
        "gal_map_text_205101173=不用修飾凹陷，它像我們的回憶，不完美但真實。和你在一起，不用刻意追求完美，自然的樣子就很好。",
        "gal_map_text_205101174=唐笑笑笑著點頭，眼神明亮。",
        "gal_map_text_205101175=你說得對！不完美才特別，以後看到凹陷就想起今天的小意外，很有紀念意義。",
        "gal_map_text_205101176=唐笑笑興奮拍手，語氣激動。",
        "gal_map_text_205101177=哇！這個想法好特別，不完美的回憶才難忘，以後我們就帶著小遺憾一起走。",
        "gal_map_text_205101178=唐笑笑語氣溫和，輕輕點頭。",
        "gal_map_text_205101179=你說得有道理，不完美也是美好，和你自然相處很舒服。",
        "gal_map_text_205101180=唐笑笑語氣平靜，眼神認可。",
        "gal_map_text_205101181=接受不完美才真實，以後用杯子就想起這份坦誠心意。",
        "gal_map_text_205101182=完美的回憶才更真實，就像我們的相處，不用刻意也很舒服。以後看到這個凹陷，就想起今天的小意外。",
        "gal_map_text_205101183=你說得對，不用追求完美。和你在一起，不管是順利還是小意外，都是珍貴的回憶。",
        "gal_map_text_205101184=唐笑笑點頭微笑，眼神柔和。",
        "gal_map_text_205101185=用陶泥條把凹陷圍成交織線條，像我們的相處。我很珍惜和你在一起的時光，不管做什麼，有你在就有意義。",
        "gal_map_text_205101186=唐笑笑語氣帶小驕傲，嘴角帶笑。",
        "gal_map_text_205101187=線條修飾得挺好看，和你在一起很開心，以後有機會再體驗更多事。",
        "gal_map_text_205101188=唐笑笑笑著點頭，整理桌上陶泥。",
        "gal_map_text_205101189=這個修飾很簡約，我喜歡，以後就用這對杯子記錄每一次陪伴。",
        "gal_map_text_205101190=唐笑笑輕輕拉你的手，眼神依賴。",
        "gal_map_text_205101191=哇，你修飾得真好看，有你陪著做什麼都有意義，以後要經常一起。",
        "gal_map_text_205101192=唐笑笑緊緊挨著你，聲音軟糯。",
        "gal_map_text_205101193=只要有你在就好，這個杯子我會好好保存，每次用都想起你的陪伴。",
        "gal_map_text_205101194=這個交織的線條像我們的緣分，不管以後走多久，都想這樣陪著你。杯子會見證我們的每一次見面。",
        "gal_map_text_205101195=我也想和你一直這樣，每次用杯子都想起今天的陪伴。以後我們多找機會一起體驗新鮮事。",
        "gal_map_text_205101196=唐笑笑嘴角帶笑，眼神期待。",
        "gal_map_text_205101197=今天做陶藝的過程很難忘，從塑形到補救每一步都有意思。以後我們用這對杯子喝甜飲、喝熱水，讓它陪著我們的每一天。",
        "gal_map_text_205101198=唐笑笑興奮接杯子，眼神發亮。",
        "gal_map_text_205101199=對呀！今天超開心，以後每天都用這對杯子，讓它見證我們的日常。",
        "gal_map_text_205101200=唐笑笑笑著碰了碰你的杯子。",
        "gal_map_text_205101201=我也覺得難忘，以後用杯子就想起今天，還想和你把日常過得甜甜的。",
        "gal_map_text_205101202=唐笑笑語氣平淡，小心放好杯子。",
        "gal_map_text_205101203=做陶藝挺有意思，以後用杯子就用吧，日常用著方便。",
        "gal_map_text_205101204=唐笑笑身體微後傾，語氣疏離但不排斥。",
        "gal_map_text_205101205=杯子挺實用，以後日常用就好，不用太刻意。",
        "gal_map_text_205101206=日常的陪伴最珍貴，以後用這對杯子喝甜飲、聊心事，讓它成為我們生活的一部分。",
        "gal_map_text_205101207=嗯，平凡的日子有你陪著就很美好。這個杯子會陪著我們，把每一個日常都變得有意義。",
        "gal_map_text_205101208=唐笑笑微笑點頭，眼神滿足。",
        "gal_map_text_205101209=你們帶著做好的情侶杯離開陶藝工作室，杯身上的印記或圖案成為專屬紀念。唐笑笑把杯子抱在懷裡，輕聲說：“這對杯子很特別，不管是專屬印記還是小凹陷，都藏著今天的回憶。” 路過甜品店時，唐笑笑拉著你進去買了兩杯熱飲，用新做的杯子裝著：“以後我們就用這對杯子喝甜飲，把每一次甜蜜都記下來。” 暖飲的溫度透過杯子傳遞過來，像彼此靠近的心意，曖昧氛圍在日常互動中漸漸沉澱為堅定的陪伴。",
        "gal_map_text_205101210=夜色漸深，商業街的喧囂退去。你們拐進隱藏在樓宇間的街心花園，幾盞地燈照亮長椅和開滿小花的灌木，空氣中飄著淡淡的植物清香。這裡遠離熱鬧，只有輕柔的風聲和遠處隱約的琴聲，靜謐又浪漫。",
        "gal_map_text_205101211=你們坐在長椅上，手裡握著之前拍的復古大頭貼，照片上的兩人貼著臉笑，周圍貼滿愛心貼紙。唐笑笑輕輕摩挲照片：“今天太難忘了，光影隧道、音樂盒、大頭貼，每一件事都很有意思。” 晚風拂過，唐笑笑的頭髮掃過你的肩膀，帶著淡淡的香味。",
        "gal_map_text_205101212=和你在一起的時光過得很快。從DIY音樂盒開始，和你相處就很舒服，不管是追光影還是補救小瑕疵，都想一直這樣陪著你。",
        "gal_map_text_205101213=我好久沒這麼開心了。和你在一起不用偽裝，搞怪拍照或緊張手抖你都不覺得奇怪，很珍惜這種感覺。",
        "gal_map_text_205101214=遠處傳來悠揚的吉他聲，旋律溫柔治癒。唐笑笑側耳傾聽，眼神陶醉：“這首歌和這裡的氛圍太配了。” 轉頭看向你，眼睛亮晶晶的：“其實我想和你一起聽一場現場音樂會。” 聲音裡滿是期待，等著你的回應。",
        "gal_map_text_205101215=珍視心意",
        "gal_map_text_205101216=音樂會約定",
        "gal_map_text_205101217=定制情侶掛繩",
        "gal_map_text_205101218=這首歌和我們今天的回憶一樣難忘，光影隧道的合照、音樂盒的旋律、大頭貼的笑容，都深深印在我心裡。想和你一起實現更多願望，一直走下去。",
        "gal_map_text_205101219=唐笑笑興奮抱你的胳膊，語氣激動。",
        "gal_map_text_205101220=天呐！你記得這麼清楚！我也把每一刻記在心裡，想和你去更多地方，創造更多回憶。",
        "gal_map_text_205101221=唐笑笑臉頰泛紅，主動握你的手。",
        "gal_map_text_205101222=其實我也很珍視今天的時光，從光影隧道到街心花園，每一刻都很幸福，想和你一直走下去。",
        "gal_map_text_205101223=唐笑笑語氣平淡，眼神帶一絲溫柔。",
        "gal_map_text_205101224=你說得對，今天的回憶很難忘，如果可以，以後也能一起去更多地方。",
        "gal_map_text_205101225=唐笑笑體微後傾，語氣疏離但不拒絕。",
        "gal_map_text_205101226=這些回憶我也記得，如果你想繼續，我沒意見。",
        "gal_map_text_205101227=和你在一起的每一個瞬間都值得珍藏，以後我們把每一次約會都變成回憶，慢慢攢滿我們的時光。",
        "gal_map_text_205101228=我也是，從來沒有這麼珍惜過一段時光。以後不管去哪裡，做什麼，我都想和你一起，把回憶越攢越多。",
        "gal_map_text_205101229=唐笑笑眼眶微紅，握緊你的手。",
        "gal_map_text_205101230=我們現在就查音樂會場次，選你喜歡的風格。我想陪你坐在台下聽音樂，就像現在這樣陪著你，看到你開心我就滿足。",
        "gal_map_text_205101231=唐笑笑興奮湊到手機旁，眼神發亮。",
        "gal_map_text_205101232=好耶！聽音樂會超浪漫，我喜歡古典音樂，我們選這場，以後還要一起體驗更多浪漫的事。",
        "gal_map_text_205101233=唐笑笑手指快速劃手機，語氣激動。",
        "gal_map_text_205101234=哇！馬上就查！我早就想和喜歡的人一起聽音樂會，終於實現了！以後還要看話劇、看展覽。",
        "gal_map_text_205101235=唐笑笑語氣溫和，認真看手機。",
        "gal_map_text_205101236=音樂會挺好的，古典音樂很舒緩，和你一起聽會很愜意。",
        "gal_map_text_205101237=唐笑笑語氣平靜，點頭認可。",
        "gal_map_text_205101238=嗯，音樂會是不錯的選擇，和你一起體驗安靜的活動也挺好，就選這場。",
        "gal_map_text_205101239=就選這場古典音樂會，我已經記下來了。那天我會提前到，給你帶喜歡的花，讓這場音樂會成為我們的專屬回憶。",
        "gal_map_text_205101240=太好啦！我已經開始期待了。和你一起聽音樂會，肯定會很浪漫，以後還要一起體驗更多喜歡的事。",
        "gal_map_text_205101241=唐笑笑眼神發亮，語氣興奮。",
        "gal_map_text_205101242=我們去文創區給情侶扭蛋定制專屬掛繩，刻上彼此名字縮寫，選和光影隧道一樣的粉紫色，走到哪裡都能想起今天的專屬時光",
        "gal_map_text_205101243=唐笑笑興奮跟著你走，腳步輕快。",
        "gal_map_text_205101244=好呀！定制掛繩很特別，以後看到扭蛋就想起今天的約會，我們選最搭的顏色。",
        "gal_map_text_205101245=唐笑笑拉著你的手快步走，語氣激動。",
        "gal_map_text_205101246=哇！這個主意超棒！要刻上我們的名字，選最亮眼的顏色，讓人一看就知道我們是情侶。",
        "gal_map_text_205101247=唐笑笑臉頰泛紅，輕聲提議。",
        "gal_map_text_205101248=定制掛繩很有意義，我想選粉紫色，和光影隧道的顏色一樣，很有紀念感。",
        "gal_map_text_205101249=唐笑笑輕輕跟著你，聲音軟軟的。",
        "gal_map_text_205101250=我都聽你的，你選顏色和樣式就好，只要是和你一起定制的，我都喜歡。",
        "gal_map_text_205101251=我們選粉紫色掛繩，刻上彼此的名字縮寫，這樣不管去哪裡，看到扭蛋就想起今天的光影隧道和彼此。",
        "gal_map_text_205101252=好呀！這個掛繩和我們的扭蛋太配了，以後我要一直帶著，讓它見證我們的每一次見面。",
        "gal_map_text_205101253=唐笑笑認真看著掛繩，臉頰泛紅。",
        "gal_map_text_205101254=唐笑笑翻看著手機裡的合照，時不時發出小聲驚歎：“這張倒影合照真的好特別，影子連在一起，好像永遠不會分開一樣。” 路過文創店時，唐笑笑買了一對迷你扭蛋鑰匙扣，遞給你一個：“以後我們就帶著這個，像帶著彼此的心意，走到哪裡都能想起今天的約會。” 晚風帶著草木清香，彼此的心意在約定中漸漸清晰，成為情侶間最溫暖的羈絆。",
        "gal_map_text_205101255=夜色漸深，商業街的喧囂退去。你們拐進隱藏在樓宇間的街心花園，幾盞地燈照亮長椅和開滿小花的灌木，空氣中飄著淡淡的植物清香。這裡遠離熱鬧，只有輕柔的風聲和遠處隱約的琴聲，靜謐又浪漫。",
        "gal_map_text_205101256=你們坐在長椅上，手裡握著之前拍的復古大頭貼，照片上的兩人貼著臉笑，周圍貼滿愛心貼紙。唐笑笑輕輕摩挲照片：“今天太難忘了，光影隧道、音樂盒、大頭貼，每一件事都很有意思。” 晚風拂過，唐笑笑的頭髮掃過你的肩膀，帶著淡淡的香味。",
        "gal_map_text_205101257=和你在一起的時光過得很快。從DIY音樂盒開始，和你相處就很舒服，不管是追光影還是補救小瑕疵，都想一直這樣陪著你。",
        "gal_map_text_205101258=我好久沒這麼開心了。和你在一起不用偽裝，搞怪拍照或緊張手抖你都不覺得奇怪，很珍惜這種感覺。",
        "gal_map_text_205101259=遠處傳來悠揚的吉他聲，旋律溫柔治癒。唐笑笑側耳傾聽，眼神陶醉：“這首歌和這裡的氛圍太配了。” 轉頭看向你，眼睛亮晶晶的：“其實我想和你一起聽一場現場音樂會。” 聲音裡滿是期待，等著你的回應。",
        "gal_map_text_205101260=聊大頭貼",
        "gal_map_text_205101261=未來期待",
        "gal_map_text_205101262=扭蛋回憶",
        "gal_map_text_205101263=這張大頭貼我們笑得真開心，我貼在手機殼裡，每次打開手機就能看到。很珍惜這些小美好，想一直和你創造更多。",
        "gal_map_text_205101264=唐笑笑語氣帶小驕傲，嘴角帶笑。",
        "gal_map_text_205101265=這張照片拍得不錯，我也貼在錢包裡了，以後我們可以多拍點照片記錄日常。",
        "gal_map_text_205101266=唐笑笑笑著點頭，翻看手機照片。",
        "gal_map_text_205101267=我也很喜歡這張大頭貼，很有紀念意義，以後我們每月拍一次合照，攢成相冊。",
        "gal_map_text_205101268=唐笑笑輕輕靠在你身邊，眼神依賴。",
        "gal_map_text_205101269=哇，你居然貼在手機殼裡！我也要好好保存，每次看到就想起今天的開心時光，以後還要拍更多。",
        "gal_map_text_205101270=唐笑笑緊緊拉你的手，聲音軟糯。",
        "gal_map_text_205101271=只要能和你一起拍照，拍什麼都好，這張照片我會一直帶在身上，像帶著你一樣。",
        "gal_map_text_205101272=這些小美好攢起來就是我們的故事，以後我們多拍合照，把每一個開心的瞬間都記錄下來。",
        "gal_map_text_205101273=嗯，照片是最好的紀念，每次看到就能想起當時的開心。以後我們繼續拍更多合照，把故事越寫越長。",
        "gal_map_text_205101274=唐笑笑微笑點頭，眼神滿足。",
        "gal_map_text_205101275=我很期待和你一起做更多事，除了音樂會，還想一起逛更多博物館、收集更多扭蛋、拍更多照片，讓生活充滿期待。",
        "gal_map_text_205101276=唐笑笑興奮拍手，語氣激動。",
        "gal_map_text_205101277=我也是！我還想去逛主題公園、打卡美食店，以後我們一起把願望清單一個個打勾。",
        "gal_map_text_205101278=唐笑笑拿出手機列清單，手指飛快。",
        "gal_map_text_205101279=哇！未來的計畫太讓人期待了，我們現在就列清單，以後一一實現，每天都有新樂趣。",
        "gal_map_text_205101280=唐笑笑語氣溫和，眼神平靜溫柔。",
        "gal_map_text_205101281=你的期待很美好，我也想和你一起體驗更多事，我們慢慢規劃，不用著急。",
        "gal_map_text_205101282=唐笑笑語氣平靜，點頭認可。",
        "gal_map_text_205101283=未來的日子有期待挺好，我們按部就班，一起體驗不同的事，讓生活更豐富。",
        "gal_map_text_205101284=有你在，未來的每一天都充滿期待。我們慢慢實現這些計畫，把每一次陪伴都過得有意義。",
        "gal_map_text_205101285=和你一起規劃未來真的很安心，不管是逛博物館還是收集扭蛋，只要有你陪著，就很開心。",
        "gal_map_text_205101286=唐笑笑輕輕靠在你肩膀，聲音軟軟的。",
        "gal_map_text_205101287=小時候總攢錢扭蛋，卻沒和人一起過，今天和你一起扭蛋、做音樂盒，找回了童年的快樂。以後我們把扭蛋當成日常小儀式，偶爾就來收集一個。",
        "gal_map_text_205101288=唐笑笑興奮分享回憶，語氣激動。",
        "gal_map_text_205101289=我小時候也攢錢扭蛋！今天和你一起太開心了，以後我們就把扭蛋當成小約定，每次見面都來抽一個。",
        "gal_map_text_205101290=唐笑笑笑著點頭，分享自己的童年。",
        "gal_map_text_205101291=我也有類似的回憶，今天和你一起重溫童年很有意思，以後我們可以經常來，讓扭蛋成為我們的專屬儀式。",
        "gal_map_text_205101292=唐笑笑語氣平淡，眼神帶一絲懷念。",
        "gal_map_text_205101293=我小時候也扭過蛋，今天和你一起確實挺有意思，以後偶爾來一次也可以。",
        "gal_map_text_205101294=唐笑笑身體微後傾，語氣疏離但不拒絕。",
        "gal_map_text_205101295=扭蛋是童年回憶，今天體驗得不錯，以後如果想來，我可以陪你。",
        "gal_map_text_205101296=童年的快樂因為有你，變得更特別了。以後我們偶爾來扭蛋，讓童年的快樂延續到我們的日常裡。",
        "gal_map_text_205101297=是啊，和你一起重溫童年很有意思。以後我們就把扭蛋當成小儀式，給日常加點甜。",
        "gal_map_text_205101298=唐笑笑嘴角帶笑，眼神溫柔。",
        "gal_map_text_205101299=唐笑笑翻看著手機裡的合照，時不時發出小聲驚歎：“這張倒影合照真的好特別，影子連在一起，好像永遠不會分開一樣。” 路過文創店時，唐笑笑買了一對迷你扭蛋鑰匙扣，遞給你一個：“以後我們就帶著這個，像帶著彼此的心意，走到哪裡都能想起今天的約會。” 晚風帶著草木清香，彼此的心意在約定中漸漸清晰，成為情侶間最溫暖的羈絆。",
        "gal_map_text_205101300=暖意和果茶的香甜還留在身上，你們回到樓頂電梯口。玻璃門外是璀璨的城市夜景，門內是安靜等待的電梯轎廂。晚風從通風口吹進來，帶著淡淡的草木清香，約會的時光即將結束，空氣中滿是不舍的溫柔。",
        "gal_map_text_205101301=唐笑笑靠在玻璃門上，看著外面的夜景，眼神裡滿是不舍：“今天太完美了，草莓、秋千、暖房、心願牌，還有和你一起看的煙花，真不想結束。” 唐笑笑的頭髮被風吹起，拂過臉頰，帶著一絲溫柔的悵然。",
        "gal_map_text_205101302=我也不想結束。從暖房寫心願牌開始，就想對你說，和你在一起的每一刻都像這夜景一樣美好，喜歡和你聊天、看風景、做小事的感覺，希望這樣的時光能一直延續。",
        "gal_map_text_205101303=我也是…… 以前很少和人待這麼久，也很少這麼放鬆地分享心事。但和你在一起很安心，想把心裡的話都告訴你，真的很珍惜今天的時光和你。",
        "gal_map_text_205101304=電梯“叮”的一聲提示到達，打破了短暫的沉默，但唐笑笑沒有動，依舊看著你，眼裡滿是期待，仿佛在等你回應這份不舍與心意。晚風輕輕吹過，帶著草木的清香，曖昧的氛圍在兩人之間彌漫。",
        "gal_map_text_205101305=聊心願牌",
        "gal_map_text_205101306=海邊約會",
        "gal_map_text_205101307=夜景心動",
        "gal_map_text_205101308=電梯來了，但我還想多陪你一會兒。暖房裡的心願牌，我寫的不只是去海邊，更是希望以後所有心願都和你一起實現。今天的草莓、秋千、煙花，都讓我覺得無比珍貴，想把這份感覺一直延續。",
        "gal_map_text_205101309=唐笑笑興奮抱你，語氣激動。",
        "gal_map_text_205101310=天呐！我也是！我的心願牌裡全是和你有關的事！從來沒這麼珍惜過一段時光，想和你一起實現所有願望。",
        "gal_map_text_205101311=唐笑笑臉頰泛紅，主動握你的手。",
        "gal_map_text_205101312=其實我也是，從蕩秋千開始就對你心動了。今天的每一刻都很幸福，也想和你一起實現所有心願。",
        "gal_map_text_205101313=唐笑笑語氣平淡，眼神帶溫柔。",
        "gal_map_text_205101314=你說得對，今天的時光很珍貴，如果可以，我也想和你一起實現心願。",
        "gal_map_text_205101315=唐笑笑身體微後傾，語氣疏離但堅定。",
        "gal_map_text_205101316=這些心願我也記得，如果你想繼續，我會陪著你。",
        "gal_map_text_205101317=不管是去海邊還是其他心願，我都想和你一起實現。以後我們把每一個願望都變成現實，讓心願牌上的每一筆都成為我們的回憶。",
        "gal_map_text_205101318=我也是，從來沒有這麼期待過未來。和你一起實現願望的過程，一定會很幸福，我會一直記著今天的約定。",
        "gal_map_text_205101319=唐笑笑眼眶微紅，聲音軟軟的。",
        "gal_map_text_205101320=我們約定下次去海邊看日出，我提前訂帶露臺的民宿，保護你不靠近深水，陪你撿貝殼、吹海風。想一直這樣守護你，陪你去所有想去的地方。",
        "gal_map_text_205101321=唐笑笑語氣帶小驕傲，嘴角帶笑。",
        "gal_map_text_205101322=好呀！海邊約會很浪漫，我也會提前做攻略，以後我們互相照顧。",
        "gal_map_text_205101323=唐笑笑笑著點頭，討論細節。",
        "gal_map_text_205101324=沒問題！海邊計畫很期待，我們分工合作，我查美食你訂民宿，有你守護我很安心。",
        "gal_map_text_205101325=唐笑笑輕輕靠在你懷裡，聲音軟軟的。",
        "gal_map_text_205101326=哇，你想得好周到！有你在我就不怕水了，以後去哪裡都想跟著你，海邊約會超期待。",
        "gal_map_text_205101327=唐笑笑緊緊抱你，眼神滿是依賴。",
        "gal_map_text_205101328=只要有你陪著就好，你會保護我，我就放心了，以後永遠跟著你。",
        "gal_map_text_205101329=我已經開始想像和你在海邊看日出的樣子了，我會一直護著你，不讓你受一點委屈。海邊的每一個瞬間，都會成為我們的專屬回憶。",
        "gal_map_text_205101330=有你在，我什麼都不怕。我已經開始期待海邊的日出和貝殼了，和你在一起，每一次約定都很安心。",
        "gal_map_text_205101331=唐笑笑輕輕靠在你懷裡，語氣滿足。",
        "gal_map_text_205101332=其實我從來沒覺得夜景這麼美，直到今天和你一起看。和你在一起的每一刻都讓我心動，想把你護在身邊，一起看遍所有美好風景。",
        "gal_map_text_205101333=唐笑笑臉頰泛紅，主動握你的手。",
        "gal_map_text_205101334=我也是！和你一起看夜景很心動，以後我們要一起去看更多風景，把每一次心動都記下來。",
        "gal_map_text_205101335=唐笑笑興奮抱你的胳膊，語氣激動。",
        "gal_map_text_205101336=哇！你終於說出來了！我早就對你心動了，從你幫我摘草莓的時候就開始了！以後我們要一起看遍全世界的風景。",
        "gal_map_text_205101337=唐笑笑聲音輕輕的，頭微低。",
        "gal_map_text_205101338=其實…… 我也覺得和你在一起很心動，能和你一起看風景，是我最開心的事。",
        "gal_map_text_205101339=唐笑笑聲音軟糯，身體微靠近。",
        "gal_map_text_205101340=我…… 很喜歡和你在一起的感覺，只要能陪著你，看什麼風景都好。",
        "gal_map_text_205101341=和你在一起的每一次心動都很珍貴，以後我會把你護在身邊，一起看遍所有美景，讓每一次心動都延續下去。",
        "gal_map_text_205101342=我也是，和你在一起的每一刻都很心動。以後我們就一起去看更多風景，把心動變成長久的陪伴。",
        "gal_map_text_205101343=唐笑笑臉頰泛紅，握緊你的手。",
        "gal_map_text_205101344=唐笑笑靠在你身邊，輕聲說：“今天真的太完美了，有草莓的甜、秋千的愜意、暖房的治癒，還有你的陪伴。” 電梯門再次打開，唐笑笑卻沒有立刻進去，而是轉頭看著你：“下次見面要快點來，我已經開始期待和你一起實現心願了。” 晚風帶著草木清香，彼此的心意在不舍與期待中沉澱，成為最堅定的陪伴約定。",
        "gal_map_text_205101345=暖意和果茶的香甜還留在身上，你們回到樓頂電梯口。玻璃門外是璀璨的城市夜景，門內是安靜等待的電梯轎廂。晚風從通風口吹進來，帶著淡淡的草木清香，約會的時光即將結束，空氣中滿是不舍的溫柔。",
        "gal_map_text_205101346=唐笑笑靠在玻璃門上，看著外面的夜景，眼神裡滿是不舍：“今天太完美了，草莓、秋千、暖房、心願牌，還有和你一起看的煙花，真不想結束。” 唐笑笑的頭髮被風吹起，拂過臉頰，帶著一絲溫柔的悵然。",
        "gal_map_text_205101347=我也不想結束。從暖房寫心願牌開始，就想對你說，和你在一起的每一刻都像這夜景一樣美好，喜歡和你聊天、看風景、做小事的感覺，希望這樣的時光能一直延續。",
        "gal_map_text_205101348=我也是…… 以前很少和人待這麼久，也很少這麼放鬆地分享心事。但和你在一起很安心，想把心裡的話都告訴你，真的很珍惜今天的時光和你。",
        "gal_map_text_205101349=電梯“叮”的一聲提示到達，打破了短暫的沉默，但唐笑笑沒有動，依舊看著你，眼裡滿是期待，仿佛在等你回應這份不舍與心意。晚風輕輕吹過，帶著草木的清香，曖昧的氛圍在兩人之間彌漫。",
        "gal_map_text_205101350=聊草莓",
        "gal_map_text_205101351=不舍",
        "gal_map_text_205101352=暖房回憶",
        "gal_map_text_205101353=今天摘的草莓真甜，就像和你在一起的感覺。我把最甜的那顆留了下來，想一直記住這個味道，也想珍惜和你在一起的所有小美好。",
        "gal_map_text_205101354=唐笑笑笑著接草莓，語氣明亮。",
        "gal_map_text_205101355=這顆草莓真的好甜！和你在一起的感覺也甜甜的，以後我們經常來摘草莓，把這份甜一直延續。",
        "gal_map_text_205101356=唐笑笑興奮拍手，小心收好草莓。",
        "gal_map_text_205101357=哇！你居然還留著草莓！今天的草莓是我吃過最甜的，以後我們每個季節都來摘當季水果，一直甜下去。",
        "gal_map_text_205101358=唐笑笑語氣溫柔，咬一口草莓。",
        "gal_map_text_205101359=草莓確實很甜，和你在一起的時光也很美好，以後我們可以經常來農場，享受這份寧靜。",
        "gal_map_text_205101360=唐笑笑語氣平靜，眼神珍惜。",
        "gal_map_text_205101361=這個味道很難忘，以後我們可以偶爾來這裡，重溫今天的感覺。",
        "gal_map_text_205101362=這份甜不僅是草莓的味道，也是和你在一起的味道。以後我們多創造這樣的小美好，把每一份甜都記在心裡。",
        "gal_map_text_205101363=嗯，和你在一起的每一個小瞬間都很珍貴。以後我們經常來摘草莓，把這份甜一直延續下去。",
        "gal_map_text_205101364=唐笑笑嘴角帶笑，眼神滿足。",
        "gal_map_text_205101365=真的不捨得結束今天的約會，和你在一起的時光過得太快了。但也很期待下次見面，想和你一起實現更多願望，創造更多美好回憶。",
        "gal_map_text_205101366=唐笑笑眼神不舍與期待。",
        "gal_map_text_205101367=真的不捨得結束今天的約會，和你在一起的時光過得太快了。但也很期待下次見面，想和你一起實現更多願望，創造更多美好回憶",
        "gal_map_text_205101368=唐笑笑語氣帶小驕傲，眼神堅定。",
        "gal_map_text_205101369=我也覺得今天過得很快，很開心。下次見面我們就去實現心願牌的約定，我會提前規劃好。",
        "gal_map_text_205101370=唐笑笑笑著點頭，主動約定。",
        "gal_map_text_205101371=我也不捨得結束，今天太完美了。下次我們就去海邊，我已經開始期待了。",
        "gal_map_text_205101372=唐笑笑緊緊拉你的手，眼神依賴。",
        "gal_map_text_205101373=只要能和你在一起，多久都不夠。下次見面不管去哪裡，我都跟著你，只要有你就好。",
        "gal_map_text_205101374=雖然捨不得結束，但下次見面的期待讓這份不舍變得更有意義。我們把今天的美好記在心裡，等著下次見面一起實現更多願望。",
        "gal_map_text_205101375=是啊，期待下次見面能快點來。和你在一起的時光總是很短暫，卻很美好，我會一直等著和你一起實現心願。",
        "gal_map_text_205101376=唐笑笑點頭微笑，眼神期待。",
        "gal_map_text_205101377=暖房裡的蘋果肉桂茶、香草小餅乾，還有一起寫的心願牌，都讓我覺得很治癒。以後我們可以把這裡當成秘密基地，偶爾來休息、聊天，享受安靜的時光。",
        "gal_map_text_205101378=唐笑笑興奮提議，眼神發亮。",
        "gal_map_text_205101379=好呀好呀！暖房真的很治癒，以後我們經常來，帶自己做的小零食，一起喝茶聊天。",
        "gal_map_text_205101380=唐笑笑笑著點頭，分享感受。",
        "gal_map_text_205101381=我也很喜歡暖房的氛圍，很放鬆。以後我們就把這裡當成秘密基地，偶爾來逃離城市的喧囂。",
        "gal_map_text_205101382=唐笑笑語氣平淡，眼神嚮往。",
        "gal_map_text_205101383=暖房確實挺治癒的，以後偶爾來休息也不錯，安安靜靜的挺好。",
        "gal_map_text_205101384=唐笑笑身體微後傾，語氣疏離但不拒絕。",
        "gal_map_text_205101385=這裡的氛圍還行，以後如果想來，我可以陪你，安靜的時光也挺難得。",
        "gal_map_text_205101386=安靜的時光因為有你，變得更珍貴了。以後我們就把這裡當成秘密基地，累的時候就來休息，聊聊天，享受屬於我們的平靜。",
        "gal_map_text_205101387=好呀，有這樣一個秘密基地真的很好。以後不管多忙，我們都來這裡放鬆，讓每一次見面都很愜意。",
        "gal_map_text_205101388=唐笑笑輕輕靠在你肩膀，聲音軟軟的。",
        "gal_map_text_205101389=唐笑笑靠在你身邊，輕聲說：“今天真的太完美了，有草莓的甜、秋千的愜意、暖房的治癒，還有你的陪伴。” 電梯門再次打開，唐笑笑卻沒有立刻進去，而是轉頭看著你：“下次見面要快點來，我已經開始期待和你一起實現心願了。” 晚風帶著草木清香，彼此的心意在不舍與期待中沉澱，成為最堅定的陪伴約定。",
        "gal_map_text_205101390=陶藝體驗結束後，你們坐在甜品店的窗邊，分享著最後一塊提拉米蘇。唐笑笑突然想起什麼，從隨身攜帶的、印有可愛圖案的保溫杯套夾層裡，小心翼翼地取出一個扁平的、約名片大小的透明亞克力封片。封片裡，鑲嵌著一段極其纖細、顏色從暖粉漸變到橙黃再到靜謐藍的特殊纖維，纖維被精密地排列成一段緩慢起伏的波形。",
        "gal_map_text_205101391=唐笑笑的臉頰泛紅，聲音軟軟的。",
        "gal_map_text_205101392=這是我提前準備的，這段波形是《甜夢研究所》店歌的旋律，顏色是今天我們看到的晚霞和觀星閣的夜色。我想把今天的甜和溫柔，都做成能隨身攜帶的紀念。",
        "gal_map_text_205101393=唐笑笑把封片輕輕放在你手心",
        "gal_map_text_205101394=以後不管你去哪裡，看到它，就會想起我們一起做陶藝、看星星、喝甜飲的日子。希望我們的時光，能像這段旋律一樣，一直溫柔下去。",
        "gal_map_text_205101395=你握緊封片，感受著它的細膩質感，心裡滿是暖意，彼此的回憶被定格在這枚獨特的信物裡。",
        "gal_map_text_205101396=幾天後，你收到一個快遞包裹，打開後是兩個透著可愛稚氣的陶杯 —— 正是你們那天一起做的情侶杯。一個杯子上畫著小燒瓶，另一個畫著小星星，杯身都有意留了些空白和未連接的線條。附在杯子旁的便簽上，是唐笑笑清秀的字跡。",
        "gal_map_text_205101397=是唐笑笑清秀的字跡：",
        "gal_map_text_205101398=那天的小凹陷，我後來讓店主幫忙做了小小的填充，變成了隱藏的小愛心～ 空白的線條，是想讓我們以後一起慢慢補完，比如每一起去一次甜品店，就畫一個小甜品。",
        "gal_map_text_205101399=晚上手機視頻時，唐笑笑笑著說：",
        "gal_map_text_205101400=以後我們就用這對杯子喝甜飲、喝熱水，讓它陪著我們的每一個日常。希望我們的感情，能像這陶杯一樣，樸實又溫暖，越用越有味道。",
        "gal_map_text_205101401=你拿起杯子，仿佛能感受到那天一起揉陶泥的溫度，心裡滿是踏實的幸福。",
        "gal_map_text_205101402=離開甜品店時，夜色已深。你們並肩走在安靜的街區。",
        "gal_map_text_205101403=唐笑笑笑著說。",
        "gal_map_text_205101404=今天的陶藝體驗和甜品都超棒！以後我們每個月都來一次‘甜夢之約’吧，嘗試不同的手工，打卡不同口味的甜品。",
        "gal_map_text_205101405=唐笑笑主動握住你的手，手指緊緊相扣。",
        "gal_map_text_205101406=我想和你一起，把平凡的日子都過得甜甜的。下次我們可以試試做蠟燭，把今天的香味也留下來。",
        "gal_map_text_205101407=晚風帶著甜香，你們的腳步聲交織在一起，約定著未來的每一個甜蜜瞬間。",
        "gal_map_text_205101408=你們沿著復古煤油燈照亮的小巷往回走",
        "gal_map_text_205101409=唐笑笑突然停下腳步，指著觀星閣的方向。",
        "gal_map_text_205101410=那天在屋頂看星星的樣子，我一直記得。",
        "gal_map_text_205101411=唐笑笑靠在你的肩膀上，輕聲說。",
        "gal_map_text_205101412=其實不用刻意準備信物，和你一起經歷的每一件事，都是最好的紀念。以後我們可以經常來這條小巷散步，去觀星閣看星星，聊心裡話。",
        "gal_map_text_205101413=你轉頭看向唐笑笑，路燈的光暈落在唐笑笑臉上，溫柔又美好。彼此的心意無需過多言語，陪伴就是最好的約定。",
        "gal_map_text_205101414=在博物館最安靜的 “復古迴廊” 展區，你們剛看完一套以 “童年記憶” 為主題的系列膠囊。夕陽透過彩窗，在你們之間投下溫暖的光斑。沉默片刻後。",
        "gal_map_text_205101415=唐笑笑輕輕拉住你的衣袖。",
        "gal_map_text_205101416=今天…… 好像坐上了時光機。謝你，陪我找回這麼多差點被遺忘的感覺。",
        "gal_map_text_205101417=唐笑笑打開隨身的帆布包，小心取出一枚復古風格的簡約懷錶。但特別之處在于，表蓋內側不是傳統圖案，而是一個可旋轉的、琺瑯彩繪的微縮星座星圖盤，十二星座的標識清晰精緻。",
        "gal_map_text_205101418=表蓋的星圖，是那天在街心花園聽到的吉他曲旋律對應的星座軌跡。",
        "gal_map_text_205101419=唐笑笑輕聲解釋。",
        "gal_map_text_205101420=懷錶的走時，是我們今天約會的時長。我想把和你一起的時光，變成可以珍藏的“時光紀念”。",
        "gal_map_text_205101421=唐笑笑把懷錶放在你手心。",
        "gal_map_text_205101422=植鞣革會隨著使用慢慢變色，就像我們一起經歷的日子，會留下專屬的痕跡。以後我們可以給它加活頁紙，記錄下每一個值得珍藏的瞬間，讓這個封面，裝滿我們的故事。",
        "gal_map_text_205101423=你握緊懷錶，感受著它的厚重質感，仿佛握住了彼此的美好時光。",
        "gal_map_text_205101424=離開街心花園時。",
        "gal_map_text_205101425=唐笑笑從帆布包裡拿出一個小盒子，遞給你。",
        "gal_map_text_205101426=這是給你的小禮物。",
        "gal_map_text_205101427=唐笑笑打開盒子，裡面是一個老式的、黃銅外殼的“迷你膠片相機” 鑰匙扣，相機側面精巧地鑲嵌著一枚真實的、封裝完好的舊式 135 膠捲膠囊。笑著說",
        "gal_map_text_205101428=鑰匙扣是復古款，和我們拍的大頭貼很配。以後你掛在鑰匙上，每次看到它，就會想起我們一起追光影、做音樂盒、搞怪拍照的日子。",
        "gal_map_text_205101429=唐笑笑輕輕轉動相機的鏡頭。",
        "gal_map_text_205101430=等以後我們拍了更多照片，就把膠捲洗出來，做成一本小小的相冊。希望這個鑰匙扣，能陪著你走過每一段路，也見證我們的每一個小美好。",
        "gal_map_text_205101431=你把鑰匙扣掛在鑰匙上，心裡滿是甜蜜的回憶。",
        "gal_map_text_205101432=你們走出博物館，夜色已經籠罩了街區。",
        "gal_map_text_205101433=唐笑笑抬頭看著博物館的招牌，眼神裡滿是不舍。",
        "gal_map_text_205101434=今天真的太開心了，光影隧道和音樂盒都讓我很難忘。",
        "gal_map_text_205101435=唐笑笑主動握住你的手。",
        "gal_map_text_205101436=以後我們每個季度都來一次博物館吧，打卡不同的展覽，收集更多有趣的扭蛋。我想和你一起，把更多有趣的瞬間，變成我們的專屬回憶。",
        "gal_map_text_205101437=你笑著點頭，彼此的約定在夜色中格外溫暖，未來的每一次見面都充滿了期待。",
        "gal_map_text_205101438=街心花園的吉他聲還在隱約回蕩。",
        "gal_map_text_205101439=唐笑笑輕聲說。",
        "gal_map_text_205101440=那天約定的音樂會，我已經查好場次了，下週末就有一場古典音樂會。",
        "gal_map_text_205101441=唐笑笑轉頭看著你，眼神裡滿是期待。",
        "gal_map_text_205101442=其實不用信物也沒關係，和你一起去聽音樂會、逛博物館、做很多小事，就是最好的紀念。希望我們以後能一起體驗更多新鮮事，把每一次約定都變成難忘的回憶。",
        "gal_map_text_205101443=你握緊唐笑笑的手，心裡滿是對未來的憧憬，彼此的感情在一次次約定中慢慢升溫。",
        "gal_map_text_205101444=約會後的第三天，你收到一個快遞，裡面是一個精緻的木盒。打開後，是一台老式的、保養得極好的 “拍立得相機”，旁邊還有幾盒未拆封的相紙。相機皮套上貼著一張便簽，是唐笑笑清秀的字跡：",
        "gal_map_text_205101445=那晚的星星、草莓和秋千，可惜都不能真的裝進籃子帶回家。",
        "gal_map_text_205101446=但這個老夥計，可以把下一次、下下次…… 我們所有的“共同瞬間”，都變成能握在手裡的紀念品。",
        "gal_map_text_205101447=晚上和唐笑笑手機視頻時，唐笑笑笑著說。",
        "gal_map_text_205101448=以後我們去海邊看日出，就用它拍照片；一起去逛公園、吃美食，也用它記錄。我想把我們在一起的每一個美好瞬間，都變成實體的回憶，攢起來，等以後慢慢看。",
        "gal_map_text_205101449=你拿起相機，輕輕按下快門，雖然沒有裝相紙，但仿佛已經定格了此刻的幸福。這台相機，成為了你們未來回憶的 “收藏者”，見證著每一個甜蜜瞬間。",
        "gal_map_text_205101450=約會後的第一次見面，是在一家咖啡館。唐笑笑坐在窗邊，手裡拿著一個細長的、用深藍絲絨布包裹的盒子。",
        "gal_map_text_205101451=唐笑笑把盒子推到你面前",
        "gal_map_text_205101452=有份“戰利品” 忘了給你，是那天在星光露臺的紀念。",
        "gal_map_text_205101453=打開盒子，裡面是一支精緻的黃銅望遠鏡，不算大，剛好可以手持。鏡身被打磨得溫潤光亮，調節旋鈕轉動順滑。",
        "gal_map_text_205101454=唐笑笑的臉頰泛紅。",
        "gal_map_text_205101455=這是我特意選的，那天我們在觀景欄杆看夜景，我就想，以後不管我們去哪裡，都能用它一起看更遠的風景。比如去海邊看遠處的船隻，去山頂看遠處的城市，去郊外看遠處的星空。",
        "gal_map_text_205101456=唐笑笑拿起望遠鏡，遞給你。",
        "gal_map_text_205101457=希望它能陪著我們，一起探索更多未知的美好，也見證我們越來越近的距離。",
        "gal_map_text_205101458=你透過望遠鏡看向窗外，仿佛又看到了那天璀璨的夜景和唐笑笑溫柔的笑容。",
        "gal_map_text_205101459=離開電梯間後，你們一起走向地鐵站。",
        "gal_map_text_205101460=唐笑笑笑著說。",
        "gal_map_text_205101461=心願牌上的海邊約定，我們下週末就去吧？我已經查好了民宿，推開窗就能看到大海。",
        "gal_map_text_205101462=唐笑笑的眼神裡滿是期待。",
        "gal_map_text_205101463=我想和你一起看日出，一起撿貝殼，一起在沙灘上散步，把暖房裡寫的心願一一實現。其實不用信物，只要能和你一起去更多地方，看更多風景，就是最好的回憶。",
        "gal_map_text_205101464=你握緊唐笑笑的手，心裡滿是對未來的憧憬，彼此的約定在夜色中格外堅定。",
        "gal_map_text_205101465=你們站在地鐵站口，唐笑笑抬頭看著天空，雖然沒有星星。",
        "gal_map_text_205101466=唐笑笑眼神裡滿是溫柔。",
        "gal_map_text_205101467=那天的煙花和星星，我一直記得。以後我們可以經常去星光露臺，或者找更多能看星星的地方。",
        "gal_map_text_205101468=唐笑笑轉頭看著你。",
        "gal_map_text_205101469=我想和你一起，看遍所有的星空，聊遍所有的心裡話。和你在一起的時光，不管是熱鬧的還是安靜的，都讓我覺得很幸福。希望我們能一直這樣，把平凡的日子過得浪漫又美好。",
        "gal_map_text_205101470=晚風輕輕吹過，彼此的心意在沉默中傳遞，溫暖而堅定。",
        "gal_map_text_205101471=一個週末的午後，你們坐在一家充滿復古氣息的咖啡館裡，桌上擺著你收集到的四件信物 —— 透明亞克力封片、復古懷錶、拍立得相機和黃銅望遠鏡。",
        "gal_map_text_205101472=唐笑笑看著這些信物，笑著說。",
        "gal_map_text_205101473=想到我們已經一起經歷了這麼多，還攢下了這麼多紀念。",
        "gal_map_text_205101474=唐笑笑從包裡拿出一個精緻的木質收納盒，把信物一個個放進去",
        "gal_map_text_205101475=這是我為這些“回憶”準備的家。每個信物都代表著我們的一段時光，以後我們還會有更多信物，填滿這個盒子。",
        "gal_map_text_205101476=唐笑笑把收納盒推到你面前。",
        "gal_map_text_205101477=其實完美的不是信物本身，而是和你一起創造回憶的過程。謝謝你陪我走過這麼多溫柔的日子，希望我們以後能一起，把這個盒子裝滿，把我們的時光過成最想要的樣子。",
        "gal_map_text_205101478=你拿起收納盒，指尖摩挲著木質紋理，裡面的每一件信物都承載著清晰的回憶 —— 亞克力封片的旋律、懷錶的星圖、拍立得的期待、望遠鏡的遠方。",
        "gal_map_text_205101479=其實我也攢了很多小物件。",
        "gal_map_text_205101480=你從包裡拿出一個小袋子，裡面是之前拍的大頭貼底片、陶藝杯的手繪草稿、心願牌的影本。",
        "gal_map_text_205101481=我想和你一起，把這些也放進收納盒裡，讓每一段回憶都有跡可循。",
        "gal_map_text_205101482=唐笑笑的眼睛亮晶晶的，主動握住你的手。",
        "gal_map_text_205101483=以後我們去海邊，就用拍立得記錄日出；去郊外看星星，就用望遠鏡找星座；喝甜飲時，就想起亞克力封片的旋律；翻看回憶時，就打開懷錶聽聽時光的聲音。",
        "gal_map_text_205101484=唐笑笑靠在你的肩膀上，聲音軟軟的。",
        "gal_map_text_205101485=完美的時光，從來不是一蹴而就的，而是和你一起，把每一個平凡的瞬間都變得珍貴。這個收納盒，會陪著我們走過更多日子，裝滿更多屬於我們的“共同瞬間”。",
        "gal_map_text_205101486=咖啡館的陽光透過窗戶，灑在收納盒上，折射出溫暖的光斑。你們一起把小物件一個個放進盒子裡，每放一件，就聊起一段回憶 —— 甜夢研究所的提拉米蘇、奇趣膠囊的音樂盒、星光露臺的煙花。",
        "gal_map_text_205101487=唐笑笑笑著說。",
        "gal_map_text_205101488=以後我們每年都來這裡一次，給收納盒添新的“回憶”，等到盒子裝滿了，我們就換一個更大的，一直這樣攢下去。",
        "gal_map_text_205101489=你握緊唐笑笑的手，心裡滿是踏實的幸福。完美結局從來不是擁有所有華麗的信物，而是和喜歡的人一起，把回憶珍藏、把時光延續、把陪伴變成最長情的約定。收納盒裡的每一件信物，都是你們愛情的見證；而未來的每一個日子，都會因為彼此的陪伴，變得更加完整而美好。",
        "gal_map_text_201200000=夜色籠罩下的遊樂園，霓虹勾勒出建築的柔和輪廓，晚風裹挾著焦糖與草木的氣息，入口處人流漸緩，靜謐中藏著幾分曖昧。",
        "gal_map_text_201200001=我循著約定方向走去，遠遠望見蘇蟬立在路燈下，淺色系衣裙被晚風輕拂，眉眼精緻，手中攥著一支霜淇淋正低頭出神。",
        "gal_map_text_201200002=磨磨蹭蹭的，你遲到了快十分鐘，沒點時間觀念嗎？笨蛋。",
        "gal_map_text_201200003=剛才路上臨時封路維修，繞了一段路，先去哪個區域？你定。",
        "gal_map_text_201200004=你是男生，去哪裡不是應該由你來決定嗎，我隨便去哪都行。",
        "gal_map_text_201200005=話音未落，蘇嬋指尖一松，霜淇淋摔在地上，蘇嬋瞳孔微縮，嘴角緊抿，眼底閃過明顯心疼，卻立刻踢了踢地面，強裝不屑",
        "gal_map_text_201200006=等著。",
        "gal_map_text_201200007=片刻後，我拿著兩支草莓味霜淇淋返回，遞到她面前。",
        "gal_map_text_201200008=給你，算是我補償給你的，你最喜歡的口味。",
        "gal_map_text_201200009=蘇嬋猶豫兩秒接過，她的手不經意觸到我的手，臉頰微熱卻強裝鎮定，只是用餘光觀察我的表情。",
        "gal_map_text_201200010=你別以為送兩支霜淇淋我就能夠原諒你，我只是不想浪費錢，勉強收下而已。",
        "gal_map_text_201200011=我抬手指向三個方向，語氣自然地試探，雖然蘇蟬表面冷漠，但是細微的動作表情還是出賣了她的心思。",
        "gal_map_text_201200012=前面的摩天輪能俯瞰星空夜景，左邊旋轉木馬的燈光氛圍感不錯，右邊是刺激的過山車，有沒有特別想先體驗的專案？",
        "gal_map_text_201200013=都可以，反正我跟著你就是了。",
        "gal_map_text_201200014=你察覺蘇嬋的眼神在三個專案間遊移，似乎自身也沒有決定好應該去什麼地方，因此直接將決定權丟給你。",
        "gal_map_text_201200015=奔赴星空摩天輪",
        "gal_map_text_201200016=前往旋轉木馬",
        "gal_map_text_201200017=挑戰刺激過山車",
        "gal_map_text_201200018=那去摩天輪吧，能夠在高空俯瞰城市的夜景一直是這裡的特色之一。",
        "gal_map_text_201200019=夜景而已，又不是沒有看過，別這麼大驚小怪。",
        "gal_map_text_201200020=快到入口了，跟緊我，別跟丟了。",
        "gal_map_text_201200021=我才不會跟丟呢，倒不如說你自己別走得太快，免得我還要去失物招領處找你。",
        "gal_map_text_201200022=我之前聽過一個傳聞，晚上來遊樂園的男女很容易走散，分散的兩個人會被困在兩個不同的項目，必須體驗滿999次才能夠離開。",
        "gal_map_text_201200023=我又不是小孩子，才不會被你這種故事嚇到呢。",
        "gal_map_text_201200024=蘇嬋嘴上強硬，手指卻悄悄勾住我的袖口飛快攥緊，眼神躲閃不敢看我，小聲嘀咕著什麼“千萬別丟了，要是剩我一個人可怎麼辦。”",
        "gal_map_text_201200025=看來我講故事的水準還不夠，下次我一定會努力改進。",
        "gal_map_text_201200026=我們去試試旋轉木馬吧，木馬的燈光襯著夜色，也別有風味。",
        "gal_map_text_201200027=沒想到你竟然會喜歡這種小孩子的項目，難道你以前沒有坐過嗎？",
        "gal_map_text_201200028=小時候和父母一起來過，後來，自己一個人也不會想要來這裡。",
        "gal_map_text_201200029=那你下次……下次想坐的話喊上我，你不要誤會，我不是喜歡坐，而是怕你一個人無聊，千萬別多想……",
        "gal_map_text_201200030=那我真得謝謝你，能夠滿足我小時候的願望，有你這句話我以後至少一周來坐一次。",
        "gal_map_text_201200031=笨蛋，你就算每天來坐一次都可以，我都可以陪你的。",
        "gal_map_text_201200032=蘇嬋雖然嘴上不饒你，但是我還是聽到她的喃喃自語，不過我並沒有揭穿她的傲嬌，而是笑著道謝。",
        "gal_map_text_201200033=那可說好了，等會兒結束我就去買張年卡，可不能浪費了。",
        "gal_map_text_201200034=過山車上周剛開放了新的軌道，聽說刺激度有五顆星，要不我們去試試吧？",
        "gal_map_text_201200035=這才是我們來遊樂園應該玩的項目，那些慢悠悠的項目一點也不好玩。",
        "gal_map_text_201200036=馬上就到入口了，你現在反悔的話我們還可以離開，要是買完票你可就只能上去咯。",
        "gal_map_text_201200037=誰要離開了？不會是你害怕了吧，所以才把我當作藉口？",
        "gal_map_text_201200038=你想要體驗我當然奉陪到底，那我們就來比比，看看等會兒誰喊的聲音小。",
        "gal_map_text_201200039=哼，我敢保證等一會兒我一聲都不會吭，讓看看我的膽量。",
        "gal_map_text_201200040=蘇嬋雖然嘴上說著自己不害怕，但是挪動的腳步卻明顯變慢，像是下定了很大的決心。",
        "gal_map_text_201200041=你們兩人走進遊樂園，霓虹將彼此的影子拉得很長，晚風裡的甜香愈發濃郁。",
        "gal_map_text_201200042=摩天輪緩緩轉動，座艙內燈光柔和，窗外是漫天星光與城市燈火，座艙隨轉動輕微晃動。",
        "gal_map_text_201200043=我與蘇蟬並肩坐在座艙兩側，蘇蟬雙手抱胸，假裝眺望窗外。",
        "gal_map_text_201200044=突然，摩天輪輕微晃動，讓蘇嬋臉上明顯浮現出一絲驚慌。",
        "gal_map_text_201200045=喂，這摩天輪怎麼回事？怎麼還晃？",
        "gal_map_text_201200046=座艙轉向時的正常現象，別緊張。",
        "gal_map_text_201200047=我可沒有緊張！我只是覺得不舒服。",
        "gal_map_text_201200048=話音剛落，摩天輪再晃，蘇嬋驚呼一聲，起身想往我身邊挪，卻因起身過急腳下一滑，徑直撲進我的懷裡。",
        "gal_map_text_201200049=蘇嬋臉頰瞬間貼緊我的胸口，雙手下意識抓住我的衣襟。",
        "gal_map_text_201200050=小心鬆手",
        "gal_map_text_201200051=順勢安撫",
        "gal_map_text_201200052=小心點，坐好。",
        "gal_map_text_201200053=蘇嬋埋在我懷裡，臉頰滾燙，掙扎著想起身。",
        "gal_map_text_201200054=我自己能夠站起來，你把我放開，別想趁機占我便宜，你這個傢伙！",
        "gal_map_text_201200055=別亂動，萬一再晃一下，離遠了容易磕碰。之前我看到一個新聞，女生離男生太遠，結果晃動的時候直接被甩出去了。",
        "gal_map_text_201200056=聽到我的話，蘇嬋身體一僵，眼底閃過一絲害怕，悄悄往我懷裡縮了縮。",
        "gal_map_text_201200057=那你要小心點，我要是掉下去的話一定會拉著你！",
        "gal_map_text_201200058=小心點，下次我可不一定能接住你。",
        "gal_map_text_201200059=蘇嬋埋在我懷裡，臉頰滾燙。",
        "gal_map_text_201200060=怎麼可能會有下次，我只是想看看你那邊的星空，起身時沒有站穩罷了。",
        "gal_map_text_201200061=嗯，我知道，你只是沒站穩而已。靠著我吧，這樣穩當。",
        "gal_map_text_201200062=知道了……不許笑，不然我跟你沒完。",
        "gal_map_text_201200063=蘇蟬乖乖靠在我身邊，雙手仍攥著我的衣襟，座艙緩緩上升，窗外風景愈發清晰，你們兩人之間的距離在不經意間被拉近。",
        "gal_map_text_201200064=雙層旋轉木馬被霓虹包裹，馬匹造型精緻，溫柔音樂緩緩流淌。",
        "gal_map_text_201200065=蘇蟬走到旋轉木馬前，看著一匹白色木馬，眼底閃過一絲期待，卻故意站在邊上裝作不屑。",
        "gal_map_text_201200066=我就選這個吧，反正都差不多，騎哪個都一樣。",
        "gal_map_text_201200067=表面上說著都差不多，但蘇嬋的眼神還是不斷瞟向木馬，你心知她肯定中意這匹全場最帥氣的白色駿馬。",
        "gal_map_text_201200068=你要是覺得幼稚的話，我們換一個項目也可以，反正遊樂園裡能玩的很多。",
        "gal_map_text_201200069=來都來了，總不能白跑一趟，趕緊做完吧，省得等會兒你說我不陪你。",
        "gal_map_text_201200070=蘇嬋說著走向高頭木馬，抬腳想坐卻因身高不夠屢屢失敗，臉色漸漸慌亂。",
        "gal_map_text_201200071=偷偷幫扶",
        "gal_map_text_201200072=順勢調侃",
        "gal_map_text_201200073=踩著馬鐙，我幫你坐上去。",
        "gal_map_text_201200074=誰要你幫忙，我只是沒有踩對位置，我自己可以……",
        "gal_map_text_201200075=蘇嬋話未說完，身體便被溫和的力量托起，然後穩穩坐在木馬上。",
        "gal_map_text_201200076=坐好，別摔下來。",
        "gal_map_text_201200077=知道了，明明我自己也能夠上來的，你這屬於多管閒事。",
        "gal_map_text_201200078=難道你小時候沒有騎過旋轉木馬嗎，之前怎麼不說呢？",
        "gal_map_text_201200079=沒騎過就沒騎過，我又不愛騎，你從哪裡看出我喜歡了，還不是為了陪你。",
        "gal_map_text_201200080=抓好扶手，這個摔下來可是很痛的哦。",
        "gal_map_text_201200081=知道了，你還是趕緊找個位置坐好，馬上就要激活了。",
        "gal_map_text_201200082=旋轉木馬緩緩開啟，蘇蟬隨著木馬轉動，眼底滿是笑意，我坐在另一個木馬上，將她的一顰一笑盡收眼底。",
        "gal_map_text_201200083=懸掛式過山車軌道在夜色中蜿蜒起伏，燈光勾勒出驚險弧線，過山車上不時傳來驚呼，空氣中彌漫著緊張又興奮的氣息。",
        "gal_map_text_201200084=蘇蟬走到排隊區，抬頭望著高聳的軌道強裝鎮定，但是眼神中卻透出緊張與不安，手指扯著裙角來回攪動。",
        "gal_map_text_201200085=怎麼會有人喜歡坐這種東西，也就只有一點點刺激，看起來也就那麼回事。",
        "gal_map_text_201200086=蘇嬋語氣故作豪邁，卻帶著不易察覺的顫抖，心裡其實早已慌了神",
        "gal_map_text_201200087=那我怎麼感覺你有些發抖，你不會是打算在這裡打退堂鼓，不敢坐了吧？",
        "gal_map_text_201200088=誰……誰不敢了！我只是覺得軌道太短不夠刺激。",
        "gal_map_text_201200089=再說，有你在邊上我有什麼好怕的，我看是你害怕了吧。",
        "gal_map_text_201200090=是嗎？那坐的時候別發抖。",
        "gal_map_text_201200091=我才不會發抖！你少看不起人！",
        "gal_map_text_201200092=蘇嬋雖然強硬地反駁我，但在坐上車的時候悄悄貼在我身邊，手指緊緊攥著我的衣角。",
        "gal_map_text_201200093=溫柔護著",
        "gal_map_text_201200094=輕聲調侃",
        "gal_map_text_201200095=別擔心，害怕就靠在我肩上。",
        "gal_map_text_201200096=誰要靠你肩上！我才不怕……",
        "gal_map_text_201200097=蘇嬋話未說完，過山車激活，聲音瞬間弱下去，雙手下意識抱緊我的手臂。",
        "gal_map_text_201200098=攥這麼緊，看來我的手很有安全感？",
        "gal_map_text_201200099=胡說！我是擔心你害怕，等會兒做出危險動作，給你壯膽呢！",
        "gal_map_text_201200100=那你可要緊緊地抓著我，別讓我因為害怕溜走了。",
        "gal_map_text_201200101=這還用你說！我才不會讓你有機會溜走呢。",
        "gal_map_text_201200102=過山車飛速穿梭在軌道上，風聲與尖叫聲交織，蘇蟬緊緊攥著你的胳膊，身體相貼的溫度讓緊張氛圍中多了一絲別樣的旖旎。",
        "gal_map_text_201200103=摩天輪抵達最高點，座艙靜止片刻，窗外是漫天璀璨星空，腳下是遊樂園的萬家燈火，靜謐氛圍中，曖昧氣息悄然蔓延。",
        "gal_map_text_201200104=蘇蟬望著窗外風景，目光溫柔，完全沉浸在浪漫的夜色之中，並未察覺我的目光。見此情景我拿出手機按下快門，定格下她的側影。",
        "gal_map_text_201200105=這一張拿去參賽的話，起碼能夠拿到二等獎。",
        "gal_map_text_201200106=聽到你的評價蘇嬋猛然回頭，目光死死盯著你手中的相機，眯著眼睛露出危險的神情。",
        "gal_map_text_201200107=你拍什麼呢！把手機給我看看，趕緊刪掉。",
        "gal_map_text_201200108=不刪，這可是我的作品，怎麼可能這麼輕易地刪掉。",
        "gal_map_text_201200109=蘇嬋見狀直接上手搶奪，你們兩人在拉扯間，距離驟然拉近，鼻尖相距僅幾釐米。",
        "gal_map_text_201200110=蘇嬋臉頰瞬間爆紅，眼神躲閃卻未後退，只不過手中的動作不知何時停了下來。",
        "gal_map_text_201200111=你趕緊把照片給我刪掉，不然今天一整天都不理你了。",
        "gal_map_text_201200112=還記得有一次你爬到樹上找東西，結果卻踩空掉下來，正好摔進我的懷裡，當時的距離也是這麼近。",
        "gal_map_text_201200113=後來你說自己的腳扭傷了，還是我背著你一路走回旅館，路上你還在抱怨那棵樹的樹幹不結實。",
        "gal_map_text_201200114=聽你說起往事，蘇嬋面色更加紅潤，聲音中還帶著一絲顫抖，表情和當年伏在你背上的時候一樣嬌羞。",
        "gal_map_text_201200115=誰.......誰還記得那些！都怪那棵樹，也不知道多吸收一些營養，哎呀，你提起這個幹嘛！",
        "gal_map_text_201200116=兩人維持著近距離姿勢，座艙內空氣仿佛凝固，蘇蟬眼底藏著一絲期待，指尖不自覺靠近你的手腕。",
        "gal_map_text_201200117=我只是想要告訴你，不管是過去還是現在，我都會陪在你身邊。",
        "gal_map_text_201200118=拉近距離",
        "gal_map_text_201200119=化解羞澀",
        "gal_map_text_201200120=別躲，我只是想多看你一眼。",
        "gal_map_text_201200121=誰........誰要你看！笨蛋！",
        "gal_map_text_201200122=可我現在最想做的就是這樣看著你，你比外面的任何景色都要好看。",
        "gal_map_text_201200123=蘇嬋別過臉，漲紅的臉頰出賣了她此刻的心情。",
        "gal_map_text_201200124=笨蛋……想看也不要說出來……多讓人難為情。",
        "gal_map_text_201200125=你這個口是心非的毛病，不管在哪裡都改不了。",
        "gal_map_text_201200126=你才口是心非！上次我買了巧克力蛋糕，你說著不想再吃巧克力，結果我轉身去倒水的工夫你就全部吃掉了。",
        "gal_map_text_201200127=那不是和你一樣，擔心浪費錢嘛，畢竟是你買的，當然要全部吃掉。",
        "gal_map_text_201200128=哼！你這口是心非的問題可不比我差。",
        "gal_map_text_201200129=摩天輪緩緩下降，兩人距離雖有所拉開，心卻貼得更近，藏在話語裡的心意，彼此都已讀懂。",
        "gal_map_text_201200130=旋轉木馬依舊緩緩轉動，音樂溫柔悠揚，霓虹燈光灑在蘇蟬髮絲上勾勒出柔和的輪廓。",
        "gal_map_text_201200131=蘇蟬坐在木馬上，笑容明媚，隨著木馬轉動輕輕晃身，完全沉浸在快樂中。",
        "gal_map_text_201200132=你悄悄走下自己的木馬，趁著旋轉的間隙坐上蘇嬋的木馬，雙臂從她身後輕輕環過，溫柔地擁住她。",
        "gal_map_text_201200133=蘇嬋渾身一僵，驚呼一聲！",
        "gal_map_text_201200134=——呀",
        "gal_map_text_201200135=別怕，是我！上次在社區的公園玩秋千，你總吵著要坐最高的，可蕩起來又怕得緊緊攥著繩子。那時我就悄悄繞到你身後，用手穩住秋千……你還一直以為是自己的技術很好。",
        "gal_map_text_201200136=後來你蕩得太高，嚇得叫出聲，我連忙從後面抱住你。你明明眼淚都在打轉，卻還嘴硬說是風太大了……那時我就想，如果能一直這樣護著你就好了。",
        "gal_map_text_201200137=誰、誰怕了……還不都怪你當時不告訴我……",
        "gal_map_text_201200138=早知道我就不坐那個秋千了，免得變成黑歷史被天天念叨。",
        "gal_map_text_201200139=那可不是黑歷史，我現在告訴你——不只是以前，現在、以後，我都想在你身邊。像這樣抱著你，陪著你，無論在哪。",
        "gal_map_text_201200140=……隨你，反正我又不會阻止你。",
        "gal_map_text_201200141=旋轉木馬緩緩轉動，你們兩人依偎在一起，音樂與風聲交織，蘇蟬臉頰始終泛紅，眼神中藏著羞澀。",
        "gal_map_text_201200142=訴說心意",
        "gal_map_text_201200143=輕輕調侃",
        "gal_map_text_201200144=如果當時我沒有在背後扶住你，你落地後會不會當場哭出來。",
        "gal_map_text_201200145=臉頰瞬間通紅，輕輕捶打你抱住她的手。",
        "gal_map_text_201200146=我怎麼會哭！我當時可一點都不怕的好嘛，你不要自作多情！",
        "gal_map_text_201200147=好，是我自作多情了，你怎麼可能會害怕呢，你可是天不怕地不怕的。",
        "gal_map_text_201200148=原來你也會害羞，以前怎麼沒發現。",
        "gal_map_text_201200149=蘇嬋瞪了我一眼。",
        "gal_map_text_201200150=要你管！趕緊鬆開，別人都看著呢！",
        "gal_map_text_201200151=好不容易抱住你，我怎麼可能會這麼輕易地鬆開呢。",
        "gal_map_text_201200152=蘇嬋掙扎一下，沒有掙脫，只能任由你將她環在懷中。",
        "gal_map_text_201200153=隨便你……",
        "gal_map_text_201200154=旋轉木馬緩緩停下，你們兩人並肩走下，蘇嬋似乎還沉浸在剛剛的遊玩之中，眼神不斷回望剛騎過的旋轉木馬，少女的心事都寫在臉上。",
        "gal_map_text_201200155=過山車停靠在月臺，蘇蟬臉色有些發白，我扶著她走到長椅上坐下。",
        "gal_map_text_201200156=蘇蟬坐在長椅上，胸口微微起伏，下意識看向身邊，卻發現我突然不在。剛要起身尋找，便看見我端著兩杯奶茶走來。",
        "gal_map_text_201200157=喏，壓壓驚，三分糖，你喜歡的口味。",
        "gal_map_text_201200158=蘇嬋接過奶茶放在一旁，兇狠狠地瞪了你一眼。",
        "gal_map_text_201200159=為什麼突然離開不和我說一聲，我差點以為遊樂園的那個傳聞是真的。",
        "gal_map_text_201200160=別生氣啦，我只是想讓補充點糖分，這樣就沒那麼糖分了。",
        "gal_map_text_201200161=我哪有害怕，反而是你突然失蹤才讓我擔心，這麼大的遊樂園我上哪找你。",
        "gal_map_text_201200162=是嗎？那剛才在過山車上，是誰緊緊抓著我的手，還閉著眼睛喊我的名字？",
        "gal_map_text_201200163=我拿出手機調出一張在過山車上偷拍的照片，照片上的蘇蟬眉頭緊鎖，始終不敢睜開眼睛直視眼前的軌道。",
        "gal_map_text_201200164=蘇嬋看到照片後，連忙伸手去搶奪手機，但你將手機藏到背後讓她無法得手。",
        "gal_map_text_201200165=你可別想刪掉這個，我好不容易才拍到的，回去之後我要把這個列印出來放在相冊裡。",
        "gal_map_text_201200166=只要有空就拿出來看看，一天看上十遍都不會膩的。",
        "gal_map_text_201200167=你這人怎麼這樣，就喜歡收集別人的醜照！",
        "gal_map_text_201200168=趕緊給我刪掉，不然我就對你不客氣了！",
        "gal_map_text_201200169=刪掉是不可能刪掉的，大不了讓你打一頓出出氣，我之前就說過，我要記錄你的一點一滴，留下所有的回憶。",
        "gal_map_text_201200170=這也不是你偷拍我的理由，這一次就放過你，下一次必須和我報備！",
        "gal_map_text_201200171=晚風伴著柔和的燈光，你們兩個人坐在長椅上，空氣中彌漫著繾綣旖旎的氣息，蘇蟬眼神不時瞟向你，手指慢慢纏上了你的手指。",
        "gal_map_text_201200172=拉近關係",
        "gal_map_text_201200173=訴說心意",
        "gal_map_text_201200174=符合口味嗎？我應該沒記錯，這是你喜歡的口味吧。",
        "gal_map_text_201200175=算你有點良心，沒忘我的口味。",
        "gal_map_text_201200176=那以後，我經常買給你喝，好不好？",
        "gal_map_text_201200177=隨便……我可是很挑的，口味每天都會變化，你真的能全部記住嗎。",
        "gal_map_text_201200178=只要你願意喝，不管你有一百種變化還是一千種變化，我就會全部記住。",
        "gal_map_text_201200179=哼！隨便你。",
        "gal_map_text_201200180=怎麼樣，你喜歡奶茶的甜度和加的料，我沒有記錯吧。",
        "gal_map_text_201200181=錯了！笨蛋，我可是更喜歡黑珍珠一點，這裡面可沒有。",
        "gal_map_text_201200182=是嗎？我記得你最討厭的就是黑珍珠，什麼時候突然喜歡上了？",
        "gal_map_text_201200183=我剛剛喜歡上的，誰讓你老是說些肉麻的話，還自作多情特意跑去買奶茶。",
        "gal_map_text_201200184=我沒有自作多情，我只是想對你好，一直對你好。",
        "gal_map_text_201200185=哼！隨便你。",
        "gal_map_text_201200186=約會即將落幕，蘇蟬深吸一口氣，攥緊口袋裡的禮物，準備向男主送上精心準備的心意。",
        "gal_map_text_201200187=夜色漸深，遊樂園燈光依舊璀璨，兩人並肩走在通往出口的小路上，晚風裹挾著煙火氣，氛圍溫柔靜謐。",
        "gal_map_text_201200188=一路沉默，蘇蟬心跳飛快，不時低頭看向口袋，猶豫許久，終於在我即將走出大門時，快步上前攔住我，臉頰泛紅，眼神慌亂。",
        "gal_map_text_201200189=喂，你等一下！走那麼快幹嘛！",
        "gal_map_text_201200190=怎麼了？還有事嗎？",
        "gal_map_text_201200191=蘇嬋從口袋裡拿出一個精緻盒子塞到我手中，話語間眼神躲閃，語速很快，但手卻不自覺地攥緊裙擺。",
        "gal_map_text_201200192=給、給你的！別誤會……這可不是我特意準備的，是今天來的時候玩遊戲贏的，拿著礙事才給你！",
        "gal_map_text_201200193=很精緻，我很喜歡。",
        "gal_map_text_201200194=誰……誰要你喜歡！我只是看你今天做了那麼多，順手送你的。",
        "gal_map_text_201200195=不管你送的是什麼，我都很喜歡，況且送出去的禮物哪有收回去的道理，謝謝你。",
        "gal_map_text_201200196=誰要你謝！我只是覺得今天玩得還行罷了……",
        "gal_map_text_201200197=蘇嬋轉身快步離開，卻悄悄放慢了腳步，心裡暗自歡喜。",
        "gal_map_text_201200198=我看穿她刻意放慢的節奏，快步跟了上去。",
        "gal_map_text_201200199=這份禮物，我會好好珍藏。不過……我居然沒給你準備禮物。這樣吧，你可以提一個條件，我一定會做到。",
        "gal_map_text_201200200=這可是你說的，我現在還沒想好……等我想好再告訴你。",
        "gal_map_text_201200201=我打開盒子，裡面是一款復古黃銅望遠鏡造型的便攜音樂盒，輕輕撥動，旋律隨之流淌。",
        "gal_map_text_201200202=以後每次聽到這個旋律，我都會想起今天的摩天輪夜景，想起你。",
        "gal_map_text_201200203=誰……誰要你想起我！愛想起誰想起誰！",
        "gal_map_text_201200204=看你慌張的樣子，還說不希望我想起你？",
        "gal_map_text_201200205=閉嘴！再說我可要收回禮物了。",
        "gal_map_text_201200206=蘇嬋臉上帶著羞澀，卻故意裝作氣鼓鼓地朝遊樂園門口走去。",
        "gal_map_text_201200207=我打開盒子，裡面是一個樂園主題的拼圖夜燈和一張拼圖步驟說明書。",
        "gal_map_text_201200208=原來你贏的獎品這麼精緻，早知道我也去玩，說不定也能夠給你贏一個。",
        "gal_map_text_201200209=你以為誰都能贏嗎？也就我運氣好……才贏了這個。",
        "gal_map_text_201200210=不過說起來，這真不是你偷偷買來送我的？卻故意說是玩遊戲贏的？",
        "gal_map_text_201200211=怎麼可能！我才不會特意給你買禮物呢，不過這拼圖夜燈很難的，你拼好記得拍照給我看。",
        "gal_map_text_201200212=遵命！大小姐。",
        "gal_map_text_201200213=兩人並肩走出遊樂園，信物在手，心意在胸，那份藏在傲嬌背後的喜歡，彼此都已讀懂。",
        "gal_map_text_201200214=旋轉木馬的音樂漸漸遠去，兩人並肩走在小路上，霓虹燈光溫柔灑落，晚風輕拂，氛圍甜美好似童話。",
        "gal_map_text_201200215=蘇蟬一路心神不寧，攥緊口袋裡的禮物，終於在出口處攔住我，臉頰緋紅，眼神閃爍，指尖緊緊捏著禮物盒。",
        "gal_map_text_201200216=喂，等一下！笨蛋，別走那麼急。",
        "gal_map_text_201200217=怎麼了？",
        "gal_map_text_201200218=她將盒子塞進我手裡，別過臉去，聲音又輕又快。",
        "gal_map_text_201200219=給……給你的！別誤會，這其實是之前給你準備的生日禮物……上次錯過了，這次就當補上。",
        "gal_map_text_201200220=謝謝你，還記得我的生日。",
        "gal_map_text_201200221=我打開盒子，裡面是一本手工鑲嵌的童話劇場微縮立體書燈，展開書頁暖光亮起，旋轉木馬的微縮場景靜靜浮現。",
        "gal_map_text_201200222=這可不是特意給你做的，前兩天收拾房間看到以前做手工剩下的材料……",
        "gal_map_text_201200223=很用心，我很喜歡。我知道你手巧，但很少送人手作。",
        "gal_map_text_201200224=就是順手做的，我也沒有花多長時間。",
        "gal_map_text_201200225=我會好好把它放在書架上珍藏的。",
        "gal_map_text_201200226=……別弄壞了。否則我絕不放過你。",
        "gal_map_text_201200227=這是我收到的最珍貴的禮物，我一定會把它放在最顯眼的地方，這樣每天都能夠看到。",
        "gal_map_text_201200228=那我下次去你家一定要檢查一下，是不是放在最顯眼的地方。",
        "gal_map_text_201200229=我打開盒子，拿出可旋轉童話風音樂盒徽章，我輕輕旋轉徽章的機關，美妙旋律跟隨轉動流出。",
        "gal_map_text_201200230=這是給你的，買東西的時候看到的，我想著也沒送過你什麼東西，就買下來了。",
        "gal_map_text_201200231=看起來很小巧，但是裡面暗藏玄機，你的眼光非常不錯。",
        "gal_map_text_201200232=那當然，也不看看我是誰，趕緊收好了，別弄丟了。",
        "gal_map_text_201200233=這裡面的旋律聽起來很熟悉，我是不是在哪裡聽到過？",
        "gal_map_text_201200234=哎呀，想聽就回去聽，趕緊把東西收好，要是丟了我可饒不了你。",
        "gal_map_text_201200235=放心吧，我一定把這個東西時時刻刻帶在身邊，當作是寶物一樣好好保存。",
        "gal_map_text_201200236=希望你說到做到，我會不定時檢查的，如果讓我發現你沒有戴的話，哼哼——",
        "gal_map_text_201200237=你們兩人並肩走出遊樂園，立體書燈的微光仿佛還在眼前，耳畔還回蕩著熟悉的音樂，彼此間的親昵在緩緩升溫。",
        "gal_map_text_201200238=夜色漸深，遊樂園燈光依舊爛漫，兩人沿著出口的小路緩步而行，晚風帶走疲憊，只餘溫柔縈繞身旁。",
        "gal_map_text_201200239=蘇蟬一路沉默，心跳如鼓，掌心微微出汗，終於在我即將走出大門時拉住了我的衣角。",
        "gal_map_text_201200240=喂，等等……你這個人，走那麼快幹嘛",
        "gal_map_text_201200241=啊，再不快點可能要錯過末班車了。",
        "gal_map_text_201200242=她迅速把一個小盒子塞過來，目光遊移，聲音越來越小。",
        "gal_map_text_201200243=給……給你的！就是逛商店時看到打折順手買的……留著占地方才給你！",
        "gal_map_text_201200244=你竟然還給我準備了禮物，裡面裝的是什麼，應該不是什麼惡作劇玩具吧？",
        "gal_map_text_201200245=我打開盒子，一隻精緻沙漏映入眼簾，細沙緩緩流淌，中央嵌著“離心時光”四字。",
        "gal_map_text_201200246=竟然是這個，沒想到你還記得我喜歡這種能夠記錄時光的小物件。",
        "gal_map_text_201200247=我才沒有記這些東西，只是正好買東西的時候剛好看到，你要是嫌棄的話……",
        "gal_map_text_201200248=不嫌棄，一點都不嫌棄！我會把它放在書桌上，每次翻轉時，都會想起今天——",
        "gal_map_text_201200249=……那、那你要小心擺放，別摔了。要是摔碎了……你得賠我個一模一樣的，而且別指望我再送你東西了。",
        "gal_map_text_201200250=知道啦，就算我自己摔了也不會讓它摔著。",
        "gal_map_text_201200251=這可是你的心意，說什麼都不會讓它有絲毫的損傷的。",
        "gal_map_text_201200252=你最好說到做到……",
        "gal_map_text_201200253=盒子裡放著一個白色的陶瓷咖啡杯，杯身絲網印著簡潔的、由點線構成的過山車軌道側寫圖案，碟子則是深邃的藍色，上面散落著些許燙金的星星光點。",
        "gal_map_text_201200254=也不是什麼特別珍貴的東西，只是在商店裡正好看到，上次看你喝水的杯子壞了，就想著給你換一個。",
        "gal_map_text_201200255=用上這麼特別的杯子的話，我一天至少要喝八杯水才行。",
        "gal_map_text_201200256=愛喝幾杯喝幾杯，趕緊收好，別弄碎了。",
        "gal_map_text_201200257=你說我拿這個泡咖啡會不會非常好喝，還能夠從裡面喝出獨屬於你的味道。",
        "gal_map_text_201200258=你再胡說八道我就把東西拿回來了。",
        "gal_map_text_201200259=好好好，既然已經是送給我的，當然不可能讓你拿回去，以後我就靠這個東西喝水了。",
        "gal_map_text_201200260=哼哼，這還差不多。",
        "gal_map_text_201200261=兩人並肩走出遊樂園，沙漏中的細沙靜靜流淌，如同悄然沉澱的心意，在夜色中溫柔閃爍。",
        "gal_map_text_201200262=遊樂園門口，霓虹漸隱，晚風輕拂，人流漸疏。夜空靜謐，空氣中彌漫著約會尾聲特有的、微甜的不舍。",
        "gal_map_text_201200263=你護送蘇蟬走到門口，蘇蟬忽然停下腳步，轉過身，微微踮起腳尖，飛快地在你臉頰上印下一個輕吻。",
        "gal_map_text_201200264=今天的約會……我很喜歡，也很……",
        "gal_map_text_201200265=恰在此時，煙花毫無預兆地在夜空中盛放，將她的後半句話淹沒在絢爛的轟鳴裡。我只看見她的嘴唇輕輕動了動，眼底映著璀璨的光。不等我反應，蘇嬋已拉起我的手，向不遠處的透明情侶觀景電梯跑去。",
        "gal_map_text_201200266=你之前不是說答應我一個條件嗎？今天我想好了，你就陪我坐這個。",
        "gal_map_text_201200267=好，不過用了這次，可就沒下次了，真想好了？",
        "gal_map_text_201200268=別廢話，快走！",
        "gal_map_text_201200269=電梯緩緩攀升，化為一個懸空的玻璃小匣，將我們與綻放的夜空溫柔包裹。她倚在窗邊，指著窗外連綿的光景，語氣裡滿是雀躍",
        "gal_map_text_201200270=快拿手機！要把我、煙花，還有整個遊樂園都拍進去哦！",
        "gal_map_text_201200271=放心，一定把你拍得特別好看。看鏡頭——",
        "gal_map_text_201200272=快門輕響，瞬間定格。照片裡，她回眸一笑，整個人都融在煙花溫柔的光暈裡。",
        "gal_map_text_201200273=蘇嬋立刻湊到螢幕前仔細端詳，嘴角不自覺地揚起一個小小弧度。",
        "gal_map_text_201200274=嗯……還行，總算沒把我拍醜，起碼這個拍照技術是可以誇的。",
        "gal_map_text_201200275=電梯緩緩下降，走出轎廂後，蘇嬋望著天際殘餘的星火出神片刻，忽然轉向我",
        "gal_map_text_201200276=對了，手機再給我看看，剛才沒仔細看，要是拍得不好……就重拍！",
        "gal_map_text_201200277=好，你說了算。要是拍得不好，我無條件給你重拍，直到你滿意為止。",
        "gal_map_text_201200278=她低頭翻閱著相冊，嘴角的笑意越來越藏不住。趁我抬頭望向夜空時，她指尖輕點，迅速將那張合照設成了我的手機壁紙，然後裝作若無其事地將手機塞回我手裡，只是耳尖早已泛紅。",
        "gal_map_text_201200279=還行……勉強能看。快收好，別把照片弄丟了。",
        "gal_map_text_201200280=嗯，我會好好存著，和你送我的禮物放在一起珍藏。",
        "gal_map_text_201200281=誰要你放一起……！快走啦，該回去了，再晚街上就要沒有人啦。",
        "gal_map_text_201200282=夜色微涼，煙花的餘韻在天邊淡淡化開。兩人並肩朝家的方向走去，路燈將他們的影子拉得很長，一路上是心照不宣的寧靜。到了房間門口，蘇蟬轉過身來，眼中流轉著清晰的不舍。",
        "gal_map_text_201200283=今天……謝謝你，不管是去玩還是別的……",
        "gal_map_text_201200284=以後這樣的機會還有很多，我們還能夠創造更多的回憶。",
        "gal_map_text_201200285=蘇蟬輕輕咬了下唇，轉身走進房間。關門之前，她又回頭望了我一眼。看著關閉的房門，我悄然解鎖手機，她的笑顏瞬間撞滿整個螢幕，照亮了返程的路。",
        "gal_map_text_204000000=夜幕降臨，你家樓下，路燈映著一輛線條流暢的頂級跑車，洛鳶正姿態慵懶地倚坐在駕駛位。",
        "gal_map_text_204000001=我精心打扮後出門，剛走到樓下，便被那輛引人注目的跑車和車內的身影瞬間攫住了目光。",
        "gal_map_text_204000002=嘖嘖，這就是你所謂的“自行車和步行”？藏得夠深啊。",
        "gal_map_text_204000003=對外自然要低調務實，但今晚不同，我約了位重要的‘客戶’。",
        "gal_map_text_204000004=客戶？那看來我今天的預約，得給貴客讓路了？",
        "gal_map_text_204000005=慌什麼，上車。",
        "gal_map_text_204000006=這位‘貴客’，也和我們去同一個地方？",
        "gal_map_text_204000007=洛鳶將手機自然遞到你面前，螢幕上是三個地點的簡介。",
        "gal_map_text_204000008=嗯，有幾個選項還不錯，你眼光還行，替我看看。",
        "gal_map_text_204000009=行吧，要是選不好你可不要找我麻煩。",
        "gal_map_text_204000010=我接過手機流覽，目光卻不著痕跡地掠過洛鳶，口中隨意評價地點，實則觀察著她每一絲細微的反應。",
        "gal_map_text_204000011=霓虹迷宮酒吧",
        "gal_map_text_204000012=復古改裝車夜市",
        "gal_map_text_204000013=主題櫥窗漫步",
        "gal_map_text_204000014=那就霓虹迷宮吧，燈光氛圍適合談事情。",
        "gal_map_text_204000015=行，聽你的。",
        "gal_map_text_204000016=你這位‘客戶’，排場不小。",
        "gal_map_text_204000017=到了你自然知道，坐穩。",
        "gal_map_text_204000018=跑車平穩駛出，兩人在引擎的低鳴聲中有一搭沒一搭地閒聊。",
        "gal_map_text_204000019=你最初的失落感被好奇與隱約的期待取代，這看似由“客戶”主導的約會，在無聲的試探與回應中，悄然滋生出別樣的張力。",
        "gal_map_text_204000020=復古改裝車夜市？這個倒是挺特別。",
        "gal_map_text_204000021=眼光尚可，就它吧。",
        "gal_map_text_204000022=你對改裝車也有研究？",
        "gal_map_text_204000023=去過幾次，還算不錯的地方，現在專心指路。",
        "gal_map_text_204000024=跑車平穩駛出，兩人在引擎的低鳴聲中有一搭沒一搭地閒聊。",
        "gal_map_text_204000025=你最初的失落感被好奇與隱約的期待取代，這看似由“客戶”主導的約會，在無聲的試探與回應中，悄然滋生出別樣的張力。",
        "gal_map_text_204000026=主題櫥窗漫步看起來最輕鬆，適合邊走邊聊。",
        "gal_map_text_204000027=可以，只要別覺得乏味就好。",
        "gal_map_text_204000028=櫥窗主題不會都是些童話故事吧？",
        "gal_map_text_204000029=我的品位，什麼時候低過？ 看著就好。",
        "gal_map_text_204000030=跑車平穩駛出，兩人在引擎的低鳴聲中有一搭沒一搭地閒聊。",
        "gal_map_text_204000031=你最初的失落感被好奇與隱約的期待取代，這看似由“客戶”主導的約會，在無聲的試探與回應中，悄然滋生出別樣的張力。",
        "gal_map_text_204000032=商業街頂樓，露天電影酒吧，角落卡座視野極佳，晚風微涼。",
        "gal_map_text_204000033=服務員上前招待，將兩人領到視野絕佳的角落卡座，遞上酒水單。你快速掃了一眼價格，目光停頓了一下。",
        "gal_map_text_204000034=這裡的消費標準，看來洛總的‘客戶’預算很足，可我在這裡消費是不是不太合適？",
        "gal_map_text_204000035=慌什麼。 今晚我請，你只管挑想試的。",
        "gal_map_text_204000036=那……我就要杯蘇打水好了。",
        "gal_map_text_204000037=來這裡喝蘇打水？把這幾款招牌特調都上一份，麻煩快一點。",
        "gal_map_text_204000038=點這麼多，喝不完太浪費了。",
        "gal_map_text_204000039=急什麼，時間還長。 ‘客戶’也還沒到。",
        "gal_map_text_204000040=服務員很快端上數杯造型別致的飲品，其中一杯名為“Love Potion #9”的飲品尤為顯眼，杯中插著一根彎曲的雙頭愛心吸管。",
        "gal_map_text_204000041=我看著那根吸管面露訝異，洛鳶則微微抬了抬下巴，示意你靠近。",
        "gal_map_text_204000042=配合一起喝",
        "gal_map_text_204000043=提議換單吸管",
        "gal_map_text_204000044=雙份體驗？也好。 讓我嘗嘗這‘魔藥’什麼味道。",
        "gal_map_text_204000045=洛鳶主動將杯子推至中間，自己先湊近了一端吸管。",
        "gal_map_text_204000046=這才像樣。",
        "gal_map_text_204000047=偏甜，果香味很濃。",
        "gal_map_text_204000048=是嗎？我這邊倒是感覺有股辛辣的後勁。",
        "gal_map_text_204000049=洛鳶調整了一下吸管方向。",
        "gal_map_text_204000050=你再試試？",
        "gal_map_text_204000051=嗯……這次甜裡帶著一絲暖意。",
        "gal_map_text_204000052=我品嘗後才發現吸管上殘留洛鳶的口紅印記，臉頰瞬間泛紅。",
        "gal_map_text_204000053=洛鳶唇角微揚。",
        "gal_map_text_204000054=可能混合一下，才是它真正的味道。 多試幾次。",
        "gal_map_text_204000055=兩人不知不覺喝了不少，我的眼神開始有些迷離，洛鳶則只是眼尾染上淡淡緋紅，神志清明。",
        "gal_map_text_204000056=在洛鳶有意無意的引導下，你幾次不慎用了她那端的吸管，指尖與手背的輕觸在微醺的空氣中激起漣漪。",
        "gal_map_text_204000057=能不能麻煩換兩根普通的吸管？這樣……",
        "gal_map_text_204000058=洛鳶直接打斷我的話，語氣帶著不容置疑的強勢。",
        "gal_map_text_204000059=設計就是這樣，尊重一下調酒師的想法。別掃興。",
        "gal_map_text_204000060=我無奈地湊近吸了一口。",
        "gal_map_text_204000061=味道……很有層次。",
        "gal_map_text_204000062=洛鳶看著你剛離開吸管的嘴唇，自然地將自己的唇湊到你剛用過的吸管上。",
        "gal_map_text_204000063=這樣分享，味道是不是更特別了？",
        "gal_map_text_204000064=嘖嘖嘖，那可是我用過的吸管。",
        "gal_map_text_204000065=你還真是小氣，吸管還分你的我的。",
        "gal_map_text_204000066=兩人不知不覺喝了不少，我的眼神開始有些迷離，洛鳶則只是眼尾染上淡淡緋紅，神志清明。",
        "gal_map_text_204000067=在洛鳶有意無意的引導下，你幾次不慎用了她那端的吸管，指尖與手背的輕觸在微醺的空氣中激起漣漪。",
        "gal_map_text_204000068=商業街後側，復古改裝車夜市燈火通明，各式精心改裝的車輛排列整齊，低沉的引擎轟鳴聲不時響起。",
        "gal_map_text_204000069=洛鳶的跑車流暢地駛入夜市區域，幾輛鄰近的改裝車仿佛呼應般短促地轟了幾聲油門，你見狀身體微微繃緊。",
        "gal_map_text_204000070=這陣勢……看起來這裡的熟人不少？",
        "gal_map_text_204000071=放心，在這兒沒人會找我的麻煩。",
        "gal_map_text_204000072=店長：洛姐！您可算來了！大夥兒都惦記著您上次在賽道上‘教育’王公子那一手呢！",
        "gal_map_text_204000073=洛鳶隨意地擺了擺手。",
        "gal_map_text_204000074=小場面，他技術沒練到家而已。",
        "gal_map_text_204000075=賽車？你還有這本事？",
        "gal_map_text_204000076=店長：小哥你不知道？洛姐可是咱們這兒公認的“速度女王”！",
        "gal_map_text_204000077=眼見為實，光說沒什麼意思，我帶你去體驗一下。",
        "gal_map_text_204000078=洛鳶領著你走到一輛線條淩厲的紅色改裝賽車旁，拉開車門，示意你坐上副駕。",
        "gal_map_text_204000079=我看著車內專業的改裝，既好奇又本能地感到一絲畏懼。洛鳶簡單介紹了幾個關鍵配置後，好整以暇地等待你的決定。",
        "gal_map_text_204000080=大膽上車體驗",
        "gal_map_text_204000081=擔心危險拒絕",
        "gal_map_text_204000082=好！我之前只敢想，沒想到真的體驗上了。",
        "gal_map_text_204000083=有膽量。 抓穩了。",
        "gal_map_text_204000084=我第一次坐賽車，你……稍微控制一下！",
        "gal_map_text_204000085=坐穩就好，其他交給我。",
        "gal_map_text_204000086=哇！這個推背感，也太厲害了吧！",
        "gal_map_text_204000087=現在知道我不是在開玩笑了吧？",
        "gal_map_text_204000088=進入直道後，洛鳶終究還是沒忍住，在一個彎道俐落地展示了小幅度的漂移過彎。",
        "gal_map_text_204000089=強大的離心力讓你未做足準備的身體猛然傾向她，臉頰不慎擦過她的肩頸，鼻尖瞬間縈繞著她的香水味。",
        "gal_map_text_204000090=我瞬間面紅耳赤，洛鳶則穩穩控住車身，待你慌忙坐正後，眼底掠過一絲不易察覺的笑意。",
        "gal_map_text_204000091=這個……看起來太專業了，我怕我受不了。",
        "gal_map_text_204000092=有我在，能讓你出事？上車，我開穩點就是。",
        "gal_map_text_204000093=說好了，一定要慢、要穩！",
        "gal_map_text_204000094=行，膽小鬼。讓你先適應一下。",
        "gal_map_text_204000095=好像……也沒那麼可怕。你開得很穩。",
        "gal_map_text_204000096=洛鳶看了看我，歪嘴一笑。",
        "gal_map_text_204000097=這才哪到哪，我要開始加速了，你坐穩了。",
        "gal_map_text_204000098=啊.......我就不應該相信你這個老司機的話。",
        "gal_map_text_204000099=進入直道後，洛鳶終究還是沒忍住，在一個彎道俐落地展示了小幅度的漂移過彎。",
        "gal_map_text_204000100=強大的離心力讓你未做足準備的身體猛然傾向她，臉頰不慎擦過她的肩頸，鼻尖瞬間縈繞著她的香水味。",
        "gal_map_text_204000101=我瞬間面紅耳赤，洛鳶則穩穩控住車身，待你慌忙坐正後，眼底掠過一絲不易察覺的笑意。",
        "gal_map_text_204000102=商業街旁的藝術街區，各式主題櫥窗在柔和燈光下依次呈現，愛心、星空、叢林書房等主題錯落有致，行人稀少，氛圍靜謐。",
        "gal_map_text_204000103=兩人並肩漫步，我正想再次提起關於‘客戶’的話題，話未出口，便被洛鳶不由分說地拉著小跑起來，徑直停在一個佈滿暖色燈串與玫瑰的愛心主題櫥窗前",
        "gal_map_text_204000104=我們等的那位‘客戶’，他……",
        "gal_map_text_204000105=洛鳶直接打斷我的對話，將你拉到櫥窗前最佳位置。",
        "gal_map_text_204000106=現在別管那些。這個景不錯，給我拍一張。",
        "gal_map_text_204000107=好，你站那兒，對……3，2，1。",
        "gal_map_text_204000108=你這拍照技術也太差了吧。",
        "gal_map_text_204000109=會嗎，這幾張不是還不錯嘛。",
        "gal_map_text_204000110=手機拿來我教你怎麼拍照，要這樣.......這樣,會了吧。",
        "gal_map_text_204000111=抱歉抱歉，這次一定拍好。",
        "gal_map_text_204000112=動作快點，別磨蹭。",
        "gal_map_text_204000113=我認真地調整角度和光線，連拍數張後，洛鳶終於勉強點頭。",
        "gal_map_text_204000114=我本想刪掉之前幾張不滿意的‘廢片’，洛鳶卻忽然伸手按住了我的手腕。",
        "gal_map_text_204000115=怎麼了！這些不是‘廢片’嗎，你難道也要。",
        "gal_map_text_204000116=我看著有幾張還不錯，我先挑選好你在刪。",
        "gal_map_text_204000117=找地方陪她挑選找",
        "gal_map_text_204000118=提議繼續拍照打卡",
        "gal_map_text_204000119=前面有休息的長椅，我們去那邊慢慢選？",
        "gal_map_text_204000120=這還差不多。",
        "gal_map_text_204000121=你慢慢看，不滿意的我隨時重拍。",
        "gal_map_text_204000122=洛鳶接過手機，嘴上挑剔，卻沒有刪掉任何一張。",
        "gal_map_text_204000123=……這幾張還行，湊合能看。",
        "gal_map_text_204000124=剛才不是還說我拍照技術差嗎？",
        "gal_map_text_204000125=不看看是誰教出來的。",
        "gal_map_text_204000126=兩人或是並肩坐在長椅上篩選照片，指尖在螢幕上不經意輕觸。",
        "gal_map_text_204000127=或是穿梭於一個個主題櫥窗之間，你的手機相冊裡漸漸存滿了洛鳶在不同光影下的模樣，兩人模糊又親密的同框剪影。",
        "gal_map_text_204000128=要不我們把這條街好看的櫥窗都打卡一遍，最後一起篩選最好的？",
        "gal_map_text_204000129=可以。不過要是再拍不好，可要接受懲罰。",
        "gal_map_text_204000130=這個背景絕了，這次肯定出片！",
        "gal_map_text_204000131=洛鳶配合地擺出姿勢，眼神卻落在你認真的臉上。",
        "gal_map_text_204000132=拍不好，你就得陪我拍到這條街關門為止。",
        "gal_map_text_204000133=放心，這張絕對讓你滿意。",
        "gal_map_text_204000134=兩人或是並肩坐在長椅上篩選照片，指尖在螢幕上不經意輕觸。",
        "gal_map_text_204000135=或是穿梭於一個個主題櫥窗之間，你的手機相冊裡漸漸存滿了洛鳶在不同光影下的模樣，兩人模糊又親密的同框剪影。",
        "gal_map_text_204000136=露天陽臺，螢幕播放著愛情片，晚風微涼，擺放著簡約桌椅，小吃已送到桌邊。",
        "gal_map_text_204000137=洛鳶領著微醺的你在露天陽臺尋了處空位坐下。服務員恰好送來小吃，螢幕上正上演著校園青梅竹馬錯過的戲碼。",
        "gal_map_text_204000138=我在酒精的作用下，泛起了困意突然感覺到一個重物靠在我的肩上，回頭一看是洛鳶睡著。",
        "gal_map_text_204000139=洛鳶？醒醒，這裡睡容易著涼。",
        "gal_map_text_204000140=酒量差還喝那麼多酒。",
        "gal_map_text_204000141=（不犧牲一下，怎麼釣的了大魚。）",
        "gal_map_text_204000142=服務員麻煩問一下，有能讓客人休息一會兒的地方嗎？",
        "gal_map_text_204000143=服務員：有的先生，我們提供私密的影音休息室，隔音很好。 需要嗎？",
        "gal_map_text_204000144=需要，請帶路吧，謝謝。",
        "gal_map_text_204000145=辦理手續時，低聲補充，帶著職業的微笑。特意提醒我室內備有基礎用品，如果不夠的話也可以聯繫前臺索要。",
        "gal_map_text_204000146=你誤會了，我和她還只是........",
        "gal_map_text_204000147=（都這樣我們還只是什麼啊！真是一個木頭腦袋。）",
        "gal_map_text_204000148=服務員：先生懂得，懂得。",
        "gal_map_text_204000149=服務員將兩人引至一間裝潢雅致的休息室後離開。",
        "gal_map_text_204000150=洛鳶依舊“熟睡”著，全身重量依賴性地靠在你身上。扶著她站在房間中央，目光在寬敞的沙發與舒適的大床間遊移不定。",
        "gal_map_text_204000151=扶她躺到床上休息",
        "gal_map_text_204000152=讓她靠沙發小憩",
        "gal_map_text_204000153=我小心翼翼地扶著洛鳶走向床邊，將洛鳶放在床上並蓋上被子。",
        "gal_map_text_204000154=不能喝酒還點那麼多酒，如果遇到壞人今晚有你受的。",
        "gal_map_text_204000155=（我都這樣了，你難道一點想法都沒有嗎？）",
        "gal_map_text_204000156=我蹲下身，小心地為洛鳶脫下高跟鞋。",
        "gal_map_text_204000157=穿著這個睡不舒服。",
        "gal_map_text_204000158=洛鳶配合地微微抬腳",
        "gal_map_text_204000159=是我喝多了產生錯覺？她是不是主動抬腳了。",
        "gal_map_text_204000160=我接著幫洛鳶褪下略顯束縛的外套，洛鳶順從地抬肩。",
        "gal_map_text_204000161=這個酒勁還挺大，我都產出幻覺了。",
        "gal_map_text_204000162=洛鳶突然伸手環住你的脖頸，將我的臉埋近她的懷裡。",
        "gal_map_text_204000163=別走……",
        "gal_map_text_204000164=洛鳶？你醒了？",
        "gal_map_text_204000165=我內心天人交戰，最終理智佔據上風。",
        "gal_map_text_204000166=我輕輕卻堅定地解開洛鳶環抱的手，為她蓋好薄被，自己則和衣在旁邊的沙發上躺下。",
        "gal_map_text_204000167=洛鳶在黑暗中靜靜“熟睡”片刻，嘴角微動，無聲地念了句“小傻瓜”。",
        "gal_map_text_204000168=洛鳶試探了多次確認我真的沉睡後悄然起身。從手袋中取出口紅細緻塗抹，在我臉頰印下一個清晰的唇印，並用手機拍下這親密一幕。",
        "gal_map_text_204000169=洛鳶結清所有帳單後，她低聲囑咐了服務員幾句，便獨自前往隔壁酒店下榻。",
        "gal_map_text_204000170=我扶洛鳶在寬大沙發坐下，調整了一下靠墊。",
        "gal_map_text_204000171=先在這兒緩緩，我守著你。",
        "gal_map_text_204000172=酒量比我還差，還非要來點那麼多酒。",
        "gal_map_text_204000173=洛鳶在“睡夢”中輕蹙了下眉，身體微微傾斜，更貼近我身側。",
        "gal_map_text_204000174=算了還是把你扶到床上吧，睡在沙發肯定不舒服吧。",
        "gal_map_text_204000175=洛鳶手臂忽然環上我的腰，頭靠進你懷裡。",
        "gal_map_text_204000176=別動……就這樣。",
        "gal_map_text_204000177=真拿你沒辦法。",
        "gal_map_text_204000178=我渾身僵硬，一動不敢動，任由洛鳶抱著。",
        "gal_map_text_204000179=良久，察覺洛鳶呼吸平穩，才極其輕柔地掰開她的手，將她扶到床上蓋好被子，自己返回到沙發上守候著洛鳶醒來。",
        "gal_map_text_204000180=洛鳶在你呼吸變得綿長後緩緩睜開眼，俯身在你額角落下一個輕吻，留下淡淡唇彩痕跡，並用手機定格這一刻。",
        "gal_map_text_204000181=結帳並留下便條後，她悄然離去，心中評價：“雖然是個木頭但還算……體貼。”",
        "gal_map_text_204000182=賽車場休息區，長椅旁有垃圾桶，遠處夜市燈光依舊，晚風微涼。",
        "gal_map_text_204000183=你不適感緩解後，在長椅坐下喝水。",
        "gal_map_text_204000184=洛鳶遞過紙巾，我接過時抬眼望向她，眼中混雜著未散的悸動與一絲尷尬。",
        "gal_map_text_204000185=剛才……抱歉，不是故意的。",
        "gal_map_text_204000186=小事。 感覺好點了？",
        "gal_map_text_204000187=嗯。 真的沒想到，你還有這樣一面，和平時在公司的感覺完全不同。",
        "gal_map_text_204000188=人總不能一直繃著。工作夠累了， 總得有個地方透口氣。",
        "gal_map_text_204000189=兩人閒聊了幾句賽車相關的話題，但我的目光仍不時飄向夜市入口，眉宇間藏著未解的疑惑。",
        "gal_map_text_204000190=洛鳶將你這副模樣盡收眼底，好整以暇地等你開口。",
        "gal_map_text_204000191=主動問客戶去向",
        "gal_map_text_204000192=假裝不問，聊賽車",
        "gal_map_text_204000193=說起來……你那位重要的‘客戶’，我們是不是等得太久了？",
        "gal_map_text_204000194=還在惦記這個？",
        "gal_map_text_204000195=你是真的猜不到，還是假的猜不到。",
        "gal_map_text_204000196=真的猜不到。他……是不是不來了？",
        "gal_map_text_204000197=笨蛋。 我今晚要見的‘重要客戶’，從頭到尾就只有你。 不然你以為是誰？",
        "gal_map_text_204000198=我？ 可你之前說得那麼正式……",
        "gal_map_text_204000199=不然呢？ 除了你，還有誰能讓我特意空出時間，我時間很多？",
        "gal_map_text_204000200=真相揭曉，你的心中被巨大的驚喜填滿，一時無言。洛鳶不由分說地拉起你回到車上，驅車駛離夜市，最終停在郊外一片開闊的星空下。",
        "gal_map_text_204000201=洛鳶打開跑車頂篷，漫天星辰如瀑傾瀉。她自然地伸出手，在星空下輕輕握住了你的手。",
        "gal_map_text_204000202=你最開始是怎麼接觸賽車的？這愛好太酷了。",
        "gal_map_text_204000203=怎麼，不關心你的‘客戶’了？ 終於想起來要誇我了？",
        "gal_map_text_204000204=不是，我就是覺得你賽車的樣子特別……耀眼。客戶他……",
        "gal_map_text_204000205=行了，不逗你了。 ‘客戶’就是你，從約你出來那一刻起就是。",
        "gal_map_text_204000206=真的是我？我還以為今晚要陪你見別人……",
        "gal_map_text_204000207=傻瓜， 我安排的時間，怎麼可能讓無關的人打擾。",
        "gal_map_text_204000208=真相揭曉，你的心中被巨大的驚喜填滿，一時無言。洛鳶不由分說地拉起你回到車上，驅車駛離夜市，最終停在郊外一片開闊的星空下。",
        "gal_map_text_204000209=洛鳶打開跑車頂篷，漫天星辰如瀑傾瀉。她自然地伸出手，在星空下輕輕握住了你的手。",
        "gal_map_text_204000210=婚紗店內，燈光柔和，各式婚紗整齊排列，白色簡約款、黑色復古款錯落，服務員笑容熱情。",
        "gal_map_text_204000211=洛鳶拉著你踏入婚紗店，訓練有素的服務員立刻迎上，目光在兩人間快速一掃，露出了然的微笑。",
        "gal_map_text_204000212=晚上好。先生是陪這位小姐來挑選婚紗嗎？需要我為您推薦一些款式嗎？",
        "gal_map_text_204000213=不是的，我們只是……進來看看。",
        "gal_map_text_204000214=洛鳶仿佛沒聽見你的辯解，指尖拂過一件黑色復古婚紗的緞面。",
        "gal_map_text_204000215=你看，你看這件是不是設計的很好看。",
        "gal_map_text_204000216=我們走吧？ 還得等你那位‘客戶’呢。",
        "gal_map_text_204000217=怎麼，你不好奇我穿婚紗的樣子？",
        "gal_map_text_204000218=好、好奇……但是‘客戶’應該快到了吧。",
        "gal_map_text_204000219=就這件，我試試。",
        "gal_map_text_204000220=洛鳶轉身走向試衣間前，留下一句。",
        "gal_map_text_204000221=在這等我， 不許偷跑。",
        "gal_map_text_204000222=片刻後，試衣間的簾幕拉開。光，",
        "gal_map_text_204000223=身著黑色婚紗的洛鳶款步走出，剪裁得體的設計完美勾勒出她的身形，氣質在優雅與神秘間平衡，與平日強勢利落的形象迥異，瞬間吸引了全場的目光。",
        "gal_map_text_204000224=婚紗店內的其他客人也看到洛鳶身穿婚紗的樣子，竊竊私語讚歎她的好看，我的目光也定格在洛鳶的身上。",
        "gal_map_text_204000225=直白誇讚，滿眼欣賞",
        "gal_map_text_204000226=害羞低頭，輕聲誇讚",
        "gal_map_text_204000227=洛鳶，這件婚紗太適合你了，非常美。",
        "gal_map_text_204000228=洛鳶在你面前輕輕轉了小半圈，裙擺微漾。",
        "gal_map_text_204000229=是嗎？ 看你的表情好像還差點意思的樣子。",
        "gal_map_text_204000230=當然是真的，黑色很襯你，比想像中還要驚豔。",
        "gal_map_text_204000231=服務員：（適時微笑開口）小姐穿著確實非常出眾，和先生您站在一起十分般配。本店可以為試穿滿意的客人免費拍攝一張即影即有的紀念照。",
        "gal_map_text_204000232=如何？留個紀念？",
        "gal_map_text_204000233=好......好。",
        "gal_map_text_204000234=拍照時，洛鳶主動挽住你的手臂，身體輕輕依偎過去。",
        "gal_map_text_204000235=快門按下，定格兩人略顯親密的身影。洛鳶對照片效果頗為滿意，徑直示意服務員將婚紗包起。你對她直接買下的舉動有些驚訝。",
        "gal_map_text_204000236=洛鳶接過包裝精美的禮袋，語氣隨意卻不容置疑。",
        "gal_map_text_204000237=‘客戶’很滿意今天的安排， 這是給你準備的驚喜。",
        "gal_map_text_204000238=洛鳶幫她提著袋子，仍有些茫然：那……我們等的那位‘客戶’，不來了？",
        "gal_map_text_204000239=他早就到了。 走吧，我們去見‘客戶’。",
        "gal_map_text_204000240=好.....好美。",
        "gal_map_text_204000241=洛鳶走近兩步，指尖輕輕抬起你的下巴，迫使我與她對視。",
        "gal_map_text_204000242=不敢看？ 心跳加速了？",
        "gal_map_text_204000243=我....我只是被你驚豔到了，誰要娶了你那可有福了。",
        "gal_map_text_204000244=哦~那你看到我穿這件婚紗的樣子，有沒有想娶我的想法。",
        "gal_map_text_204000245=服務員：（笑著提議）二位看起來很默契呢，要拍張照片嗎？免費的紀念照。",
        "gal_map_text_204000246=來吧，再好看的婚紗不拍照留念就可惜了。",
        "gal_map_text_204000247=好。",
        "gal_map_text_204000248=拍照時，洛鳶主動挽住你的手臂，身體輕輕依偎過去。",
        "gal_map_text_204000249=快門按下，定格兩人略顯親密的身影。洛鳶對照片效果頗為滿意，徑直示意服務員將婚紗包起。你對她直接買下的舉動有些驚訝。",
        "gal_map_text_204000250=洛鳶接過包裝精美的禮袋，語氣隨意卻不容置疑。",
        "gal_map_text_204000251=‘客戶’很滿意今天的安排， 這是給你準備的驚喜。",
        "gal_map_text_204000252=洛鳶幫她提著袋子，仍有些茫然：那……我們等的那位‘客戶’，不來了？",
        "gal_map_text_204000253=他早就到了。 走吧，我們去見‘客戶’。",
        "gal_map_text_204000254=我在私人影院醒來，下意識檢查衣著——整齊如初，才松了口氣。",
        "gal_map_text_204000255=“昨晚到底喝了多少……洛鳶應該去陪客戶了吧，我竟自己醉倒，還讓她一個人應付。”",
        "gal_map_text_204000256=轉頭瞥見沙發旁桌上的信封，你微微一怔。",
        "gal_map_text_204000257=我拆信看到洛鳶的字跡：“若醒了，來商業街奶茶店。約定時間：上午11點。”你看向腕表——11:10，心頭一緊，抓起衣服便向外沖。",
        "gal_map_text_204000258=趕到奶茶店，你一眼看見窗邊的洛鳶。",
        "gal_map_text_204000259=對不起，我睡過頭了。",
        "gal_map_text_204000260=洛鳶目光沉靜地在你臉上停留片刻，並未如往常般戲謔。她只是輕輕推過手邊一個扁平的絲絨布袋。",
        "gal_map_text_204000261=打開看看。這才是今天真正的‘禮物’。",
        "gal_map_text_204000262=我解開布袋，一件沉甸甸的圓形舊物落入掌心。",
        "gal_map_text_204000263=它比懷錶略大，像一塊厚重的齒輪部件，黃銅表面氧化成溫潤的暗金色，邊緣鐫刻著無法完全辨識的細密紋路，仿佛承載著被磨損的時光。",
        "gal_map_text_204000264=中央鑲嵌的老式錶盤已然停走，指針永恆地定格在某一刻。",
        "gal_map_text_204000265=針停下的時間，是昨晚你醉倒後，我看了你十分鐘，然後決定離開的時刻。",
        "gal_map_text_204000266=我是個習慣掌控節奏的人，但那一刻，我想讓時間停一停。不是為你，是為我自己那份……有點失控的耐心。",
        "gal_map_text_204000267=……我會讓它繼續走下去的，在我的時間裡，從這一刻開始。",
        "gal_map_text_204000268=兩人在奶茶店閑坐片刻，洛鳶不時瞥向你臉頰，笑意若有若無。",
        "gal_map_text_204000269=其實我很好奇你一直在笑什麼。",
        "gal_map_text_204000270=洛鳶拿出手機，讓我看看手機螢幕的反光。",
        "gal_map_text_204000271=不許擦，這是對你遲到的懲罰，要是擦了昨晚和你這張親密照片我就要發到朋友圈上嘍。",
        "gal_map_text_204000272=我幾度想抬手，卻總在動作前想起她那句“懲罰”，最終只是無奈搖頭。氛圍在微妙的對抗中蔓延著暖意。",
        "gal_map_text_204000273=我在私人影院醒來，下意識檢查衣著——整齊如初，才松了口氣。",
        "gal_map_text_204000274=“昨晚到底喝了多少……洛鳶應該去陪客戶了吧，我竟自己醉倒，還讓她一個人應付。”",
        "gal_map_text_204000275=轉頭瞥見沙發旁桌上的信封，你微微一怔。",
        "gal_map_text_204000276=我拆信看到洛鳶的字跡：“若醒了，來商業街奶茶店。約定時間：上午11點。”你看向腕表——11:10，心頭一緊，抓起衣服便向外沖。",
        "gal_map_text_204000277=趕到奶茶店，你一眼看見窗邊的洛鳶。",
        "gal_map_text_204000278=對不起，我睡過頭了。",
        "gal_map_text_204000279=洛鳶好整以暇地打量你一番，尤其是你臉頰上那枚淡淡的唇印，笑容越發明顯。",
        "gal_map_text_204000280=洛鳶拖長語調，從身旁拿出一個閃爍著微光的透明小禮盒，放在桌上推過去。",
        "gal_map_text_204000281=遲到十分鐘……懲罰和補償都在裡面了，自己看。",
        "gal_map_text_204000282=我松了口氣，連忙打開。裡面是一個掌心大小的透明亞克力立方體。",
        "gal_map_text_204000283=仔細看去，立方體內懸浮著無數極微小的、顏色各異的光點，正在緩緩飄動，如同封存了一角迷離的星空。",
        "gal_map_text_204000284=這是……",
        "gal_map_text_204000285=昨晚的‘聲音’和‘光’，我讓助理即時採樣做的。喜歡嗎？不過——",
        "gal_map_text_204000286=在簽收這份‘紀念品’前，你是不是該解釋一下這個‘違章蓋章’？",
        "gal_map_text_204000287=什麼違章蓋章。",
        "gal_map_text_204000288=洛鳶拿出手機，讓我看看手機螢幕的反光。",
        "gal_map_text_204000289=啊！這是什麼時候留著。",
        "gal_map_text_204000290=不許擦，這是對你遲到的懲罰，要是擦了昨晚和你這張親密照片我就要發到朋友圈上嘍。",
        "gal_map_text_204000291=我認罰，不愧是你，我甘拜下風。",
        "gal_map_text_204000292=那，接下來陪我去個地方，將功補過？",
        "gal_map_text_204000293=兩人在奶茶店閑坐片刻，洛鳶不時瞥向你臉頰，笑意若有若無。",
        "gal_map_text_204000294=我幾度想抬手，卻總在動作前想起她那句“懲罰”，最終只是無奈搖頭。氛圍在微妙的對抗中蔓延著暖意。",
        "gal_map_text_204000295=我在車中醒來，只覺得胸口沉甸甸的喘不過氣，睜眼一看，洛鳶整個人趴在他身上。",
        "gal_map_text_204000296=我能清晰看到女主胸前的輪廓，也能感受到柔軟的觸感，心裡猶豫著要不要就這樣等她醒來，再三思考後還是小心翼翼將洛鳶抱回她的座位。",
        "gal_map_text_204000297=我拿出手機悄悄拍下她熟睡的樣子。",
        "gal_map_text_204000298=沒過多久，洛鳶伸著懶腰醒來，眼神朦朧地問：“幾點了？”",
        "gal_map_text_204000299=11點了。",
        "gal_map_text_204000300=這麼遲了？那我們先回改裝車夜市，旁邊有洗漱間，我們先去收拾一下。",
        "gal_map_text_204000301=好。",
        "gal_map_text_204000302=兩人下車後，洛鳶讓男主先去洗漱，自己則趁著空隙跑到小店，將準備好的禮物放進車裡，隨後才進店洗漱。",
        "gal_map_text_204000303=我洗漱完出來，看到洛鳶換上白色系裙子和帽子，瞬間看直了眼。",
        "gal_map_text_204000304=“看什麼呢？上車了。”",
        "gal_map_text_204000305=我快步上車，洛鳶將禮盒遞給我。",
        "gal_map_text_204000306=給你的，打開看看喜不喜歡。",
        "gal_map_text_204000307=我拆開禮盒，看到放映機模型。",
        "gal_map_text_204000308=太精緻了！我太喜歡了，謝謝你洛鳶！",
        "gal_map_text_204000309=洛鳶看著我拿著禮物在手裡反復把玩，愛不釋手。",
        "gal_map_text_204000310=就在這時，洛鳶突然踩下油門，跑車徑直駛離。",
        "gal_map_text_204000311=這是去哪裡啊？",
        "gal_map_text_204000312=現在輪到你的回禮了，陪我去商業街再逛一會兒，不許喊累，也不許偷懶。",
        "gal_map_text_204000313=我握緊禮物連連點頭，心裡滿是期待。陽光灑在洛鳶臉上，格外溫柔，手工鑰匙扣掛在車內輕輕晃動，跑車朝著商業街疾馳而去。",
        "gal_map_text_204000314=我在車中醒來，只覺得胸口沉甸甸的喘不過氣，睜眼一看，洛鳶整個人趴在他身上。",
        "gal_map_text_204000315=我能清晰看到女主胸前的輪廓，也能感受到柔軟的觸感，心裡猶豫著要不要就這樣等她醒來，再三思考後還是小心翼翼將洛鳶抱回她的座位。",
        "gal_map_text_204000316=我拿出手機悄悄拍下她熟睡的樣子。",
        "gal_map_text_204000317=沒過多久，洛鳶伸著懶腰醒來，眼神朦朧地問：“幾點了？”",
        "gal_map_text_204000318=11點了。",
        "gal_map_text_204000319=這麼遲了？那我們先回改裝車夜市，旁邊有洗漱間，我們先去收拾一下。",
        "gal_map_text_204000320=好。",
        "gal_map_text_204000321=兩人下車後，洛鳶讓男主先去洗漱，自己則趁著空隙跑到小店，將準備好的禮物放進車裡，隨後才進店洗漱。",
        "gal_map_text_204000322=我洗漱完出來，看到洛鳶換上白色系裙子和帽子，瞬間看直了眼。",
        "gal_map_text_204000323=“看什麼呢？上車了。”",
        "gal_map_text_204000324=我快步上車，洛鳶將禮盒遞給我。",
        "gal_map_text_204000325=我拆開禮盒，看到一個小巧的、閃著金屬光澤的東西掛向車鑰匙。",
        "gal_map_text_204000326=喏，剛做的。試試看，齒合得順不順。",
        "gal_map_text_204000327=這個小東西還挺別致的，謝謝你的禮物。",
        "gal_map_text_204000328=到你回禮的時候，系上安全帶。",
        "gal_map_text_204000329=我們這是要去哪裡？",
        "gal_map_text_204000330=陪我去商業街再逛一會兒，不許喊累，也不許偷懶。",
        "gal_map_text_204000331=我握緊禮物連連點頭，心裡滿是期待。陽光灑在洛鳶臉上，格外溫柔，手工鑰匙扣掛在車內輕輕晃動，跑車朝著商業街疾馳而去。",
        "gal_map_text_204000332=兩人從婚紗店走出，你提著洛鳶買下的婚紗。",
        "gal_map_text_204000333=‘客戶’是不是快到了，我們是不是該準備一下了。",
        "gal_map_text_204000334=在這兒等我，別亂跑。",
        "gal_map_text_204000335=你去哪？",
        "gal_map_text_204000336=暫時保密。",
        "gal_map_text_204000337=我靠在護欄邊等待，不久噴泉表演開始。你正要發消息，肩卻被輕輕一拍——洛鳶已站在身旁遞來禮盒。",
        "gal_map_text_204000338=我剛剛去見‘客戶’了，這是他給的見面禮。",
        "gal_map_text_204000339=我正準備打開禮盒，被洛鳶打斷。",
        "gal_map_text_204000340=現在還不是打開的時候，你在耐心等待一下。",
        "gal_map_text_204000341=當水幕沖天、光華絢爛的一刻，洛鳶輕輕靠向你肩頭，聲音低如呢喃。",
        "gal_map_text_204000342=休息結束之後，我又要回到那個必須強勢的樣子了……只有在你面前，我才能夠做自己。",
        "gal_map_text_204000343=下次休息，我依舊陪你做你想做的事。",
        "gal_map_text_204000344=那下次……可要好好陪我。",
        "gal_map_text_204000345=現在可以打開了。",
        "gal_map_text_204000346=我打開木盒，黑色絲絨襯墊上，是一枚極其精緻的多面黃銅棱鏡，被巧妙地鑲嵌在一小塊深色胡桃木底座上，顯得既工業又典雅。",
        "gal_map_text_204000347=我拿起它，對著噴泉的光，棱鏡立刻將白光折射成一道清晰的小彩虹，落在你的掌心。",
        "gal_map_text_204000348=棱鏡能讓光顯露出原本看不見的色彩，就像你，讓我看到了自己其他所有的可能性。",
        "gal_map_text_204000349=刻上去的，就不是秘密了。這是我的‘契約’——只在你面前生效的，只會顯露最真實的樣子。",
        "gal_map_text_204000350=這份‘契約’……我簽收了，而且，沒有試用期，也不接受退換。",
        "gal_map_text_204000351=接下來的行程，由‘我們’共同決定？比如……先找個地方，好好看看這彩虹能持續多久？",
        "gal_map_text_204000352=兩人並肩走進商業街，禮物在你的口袋裡，過往的試探與曖昧化作無需言說的默契，氛圍甜蜜又自然。",
        "gal_map_text_204000353=第二天早上洛鳶來到我房門口，敲響了房門詢問我情況，我打開酒店大門看到身穿白色連衣裙的洛鳶瞬間緩解了困意。",
        "gal_map_text_204000354=洛鳶邀請我將約會繼續進行下去，我牽著她的手離開酒店向著商業街前進。",
        "gal_map_text_204000355=兩人從婚紗店走出，你提著洛鳶買下的婚紗。",
        "gal_map_text_204000356=‘客戶’是不是快到了，我們是不是該準備一下了。",
        "gal_map_text_204000357=在這兒等我，別亂跑。",
        "gal_map_text_204000358=你去哪？",
        "gal_map_text_204000359=暫時保密。",
        "gal_map_text_204000360=我靠在護欄邊等待，不久噴泉表演開始。你正要發消息，肩卻被輕輕一拍——洛鳶已站在身旁遞來禮盒。",
        "gal_map_text_204000361=我剛剛去見‘客戶’了，這是他給的見面禮。",
        "gal_map_text_204000362=我正準備打開禮盒，被洛鳶打斷。",
        "gal_map_text_204000363=現在還不是打開的時候，你在耐心等待一下。",
        "gal_map_text_204000364=當水幕沖天、光華絢爛的一刻，洛鳶輕輕靠向你肩頭，聲音低如呢喃。",
        "gal_map_text_204000365=休息結束之後，我又要回到那個必須強勢的樣子了……只有在你面前，我才能夠做自己。",
        "gal_map_text_204000366=下次休息，我依舊陪你做你想做的事。",
        "gal_map_text_204000367=那下次……可要好好陪我。",
        "gal_map_text_204000368=現在可以打開了。",
        "gal_map_text_204000369=我打開木盒，裡面不是一個物品，而是一個微縮的世界：用紙雕、細木片和微型印刷品完美複刻了你們印象最深的那個“叢林書房”櫥窗。",
        "gal_map_text_204000370=每一片微縮樹葉的紋理都清晰可見，那本“懸浮”的書用幾乎看不見的極細魚線吊著，仿佛真的掙脫了重力。",
        "gal_map_text_204000371=這……這是怎麼……",
        "gal_map_text_204000372=我畫了草圖，請一位微縮景觀大師趕工的，你說過，那個櫥窗像‘一個逃離現實的夢’。",
        "gal_map_text_204000373=現在我把這個夢替你封存起來，你可以隨時帶走，也可以隨時打開。",
        "gal_map_text_204000374=謝謝你，這比我見過的任何櫥窗都美。因為……這裡面，現在裝著我們的共同記憶了。",
        "gal_map_text_204000375=我訂了房間。不過別誤會，是兩間。只是……我覺得今晚，這個‘櫥窗’需要最適合它的環境燈光來欣賞。",
        "gal_map_text_204000376=好，那我們去為這個‘永恆櫥窗’，揭幕。",
        "gal_map_text_204000377=兩人並肩走進商業街，禮物在你的口袋裡，過往的試探與曖昧化作無需言說的默契，氛圍甜蜜又自然。",
        "gal_map_text_204000378=第二天早上洛鳶來到我房門口，敲響了房門詢問我情況，我打開酒店大門看到身穿白色連衣裙的洛鳶瞬間緩解了困意。",
        "gal_map_text_204000379=洛鳶邀請我將約會繼續進行下去，我牽著她的手離開酒店向著商業街前進。",
        "gal_map_text_204000380=兩人漫步至商業街一家花店旁。洛鳶的目光被店內錯落有致的插花吸引，腳步自然地停下。",
        "gal_map_text_204000381=她俯身，指尖輕觸花瓣，靜靜欣賞，周身淩厲的氣質悄然褪去，眼底流轉著罕見的柔和。",
        "gal_map_text_204000382=這花顏色好奇特，藍中透著粉。",
        "gal_map_text_204000383=店員走近，熱情介紹先生好眼力，這是繡球花的一個特殊品種。",
        "gal_map_text_204000384=這種藍粉漸變，在我們花語裡，象徵著“含蓄的喜悅”和“長久的陪伴”，很適合彼此心意相通的伴侶養護呢。",
        "gal_map_text_204000385=倒是很貼切的寓意。",
        "gal_map_text_204000386=請幫我包兩盆可培育的，謝謝。",
        "gal_map_text_204000387=店員很快將兩盆花打包好。洛鳶接過，將其中一盆遞向你。",
        "gal_map_text_204000388=給你。好好養，不許養壞了。等我們這兩盆花都盛開的時候……",
        "gal_map_text_204000389=盛開的時候怎樣？會有驚喜嗎？能先透露一點嗎？",
        "gal_map_text_204000390=秘密。",
        "gal_map_text_204000391=洛鳶自然而然地牽起你的手，拉著你回到人流中繼續閒逛。",
        "gal_map_text_204000392=你心裡揣著那個未揭曉的約定，一邊走，一邊忍不住悄悄拿出手機，認真地搜索起“繡球花養護要點”，腳步不自覺地慢了下來。",
        "gal_map_text_204000393=洛鳶察覺你落後，駐足回頭，見你專注盯著手機，眉頭微挑，走上前伸手抽走我的手機。",
        "gal_map_text_204000394=走路看手機，可不是好習慣。",
        "gal_map_text_204000395=我下意識想拿回，抬頭卻愣住。",
        "gal_map_text_204000396=我撞進洛鳶含笑的目光裡。她不知何時買了一杯奶茶，正好整以暇地看著你，晃了晃手中的手機。",
        "gal_map_text_204000397=你看著她的笑容，一時失神，腦海中掠過這兩日的種種，只是呆呆看著她，忘了反應。",
        "gal_map_text_204000398=看入神了？看來，我的魅力比養花攻略大一點？",
        "gal_map_text_204000399=我、我只是突然想到點工作的事！",
        "gal_map_text_204000400=好了，不逗你了。時間不早，我送你回去。陪我逛了一天，也該累了。",
        "gal_map_text_204000401=不累！真的，還能再逛會兒！",
        "gal_map_text_204000402=話音剛落，我卻不受控制地打了個小小的哈欠，腳步也透出些許倦意。",
        "gal_map_text_204000403=嘴硬，在這裡等我，我去取車。",
        "gal_map_text_204000404=我望著她的背影，暗自懊惱。不多時，跑車穩穩停在你面前。",
        "gal_map_text_204000405=上車。",
        "gal_map_text_204000406=返程路上，車內流淌著舒緩的音樂和偶爾的閒談。很快，車停在你家樓下。",
        "gal_map_text_204000407=那我先……",
        "gal_map_text_204000408=等等。",
        "gal_map_text_204000409=嗯？",
        "gal_map_text_204000410=這裡的“紀念品”，該清理一下了。過來。",
        "gal_map_text_204000411=你聞言，乖順地將臉側向她。洛鳶仔細擦拭那早已淡去的唇印，動作輕柔。擦淨後，她看著你近在咫尺的側臉，目光微動。",
        "gal_map_text_204000412=這是今天的……晚安。",
        "gal_map_text_204000413=我怔住，隨即，仿佛某種開關被按下。緩緩閉上眼，雙手不再猶豫，輕輕環住了她的腰，將這個吻悄然加深。",
        "gal_map_text_204000414=……學得很快？",
        "gal_map_text_204000415=對不起！我……我不是……",
        "gal_map_text_204000416=快回去吧，你的花要忘了。",
        "gal_map_text_204000417=那、明天見！",
        "gal_map_text_204000418=你幾乎是逃也似地下了車，快步走進樓裡。洛鳶坐在車內，望著你的背影，指尖輕撫過自己的唇角，搖頭失笑。",
        "gal_map_text_204000419=看來，驚喜要換一個了。",
        "gal_map_text_204000420=不久，你的手機螢幕亮起，一條新資訊映入眼簾：「待到花開時，驚喜自會揭曉。晚安。」",
        "gal_map_text_203200000=公園正門，暖陽斜照，草木含香，零星遊客往來，氛圍輕快。",
        "gal_map_text_203200001=我提前十分鐘抵達公園入口，掏出手機調出電子導覽圖，指尖在螢幕上滑動，仔細標記著心儀的點位，神情專注。",
        "gal_map_text_203200002=這次準備得夠充分，路線和看點都規劃好了，卡洛菲斯應該會覺得有趣吧。",
        "gal_map_text_203200003=瀑布觀景台光線最佳，很適合幫她拍出好看的照片。",
        "gal_map_text_203200004=卡洛菲斯帶著笑意的聲音忽然從身側傳來。",
        "gal_map_text_203200005=拍照是不錯，不過峽谷頂端的全景，聽說更震撼哦。",
        "gal_map_text_203200006=峽谷頂端視野是開闊，但那段高空棧道……她會不會覺得太高了？",
        "gal_map_text_203200007=卡洛菲斯又湊近了些，語調輕快。",
        "gal_map_text_203200008=就算有點高，不是還有你在旁邊嘛？不過嘛，溪谷那邊的親水準台，看著也挺好玩的。",
        "gal_map_text_203200009=溪谷可以親水玩鬧，踩踩清涼的溪水應該很愜意。",
        "gal_map_text_203200010=卡洛菲斯輕笑出聲，帶著幾分玩味。",
        "gal_map_text_203200011=每個地方聽起來都不錯呢，所以……我們到底去哪兒？",
        "gal_map_text_203200012=啊……選哪個才好？",
        "gal_map_text_203200013=你、你什麼時候在這兒的？",
        "gal_map_text_203200014=原本想製造的驚喜被當面揭穿，卡洛菲斯卻笑得爽朗明媚，眼底掠過一絲狡黠的光。她並未直接說出偏好，只是好整以暇地等著你做決定。",
        "gal_map_text_203200015=本來想給你個驚喜的，結果，咳咳……那你想先去哪裡？",
        "gal_map_text_203200016=猜來猜去多沒勁，你定就行。反正有你帶著，去哪兒我都開心。",
        "gal_map_text_203200017=奔赴瀑布觀景台",
        "gal_map_text_203200018=登頂峽谷之巔",
        "gal_map_text_203200019=探訪溪谷戲水處",
        "gal_map_text_203200020=那我們先去瀑布觀景台吧，那裡風景好，容易拍出好看的照片，氛圍也輕鬆。",
        "gal_map_text_203200021=卡洛菲斯眼睛微微一亮，抬手輕拍了一下你的手臂。",
        "gal_map_text_203200022=算你眼光線上，帶路吧，攝影官，讓我看看你的絕美機位在什麼地方。",
        "gal_map_text_203200023=放心，機位我都研究過了，包你滿意。",
        "gal_map_text_203200024=要是拍得不好，我可要在朋友圈發你的差評了。",
        "gal_map_text_203200025=兩人並肩朝瀑布方向走去，輕鬆說笑間，距離仿佛又拉近了一些。",
        "gal_map_text_203200026=瀑布觀景台的拍照互動，將觸發一場猝不及防的親密試探。",
        "gal_map_text_203200027=那我們去峽谷頂端吧，挑戰一下高空棧道，俯瞰全景的感覺一定很過癮。",
        "gal_map_text_203200028=卡洛菲斯嘴角揚起躍躍欲試的弧度，順手將袖子挽起些許。",
        "gal_map_text_203200029=正合我意！我倒是要看看，待會兒誰先露怯。",
        "gal_map_text_203200030=我才不會。倒是你，到時候可別緊張得抓住我不放。",
        "gal_map_text_203200031=那可說不準，萬一要是我害怕的話，你可得負全責。",
        "gal_map_text_203200032=兩人步履輕快地向峽谷棧道方向走去，活力滿滿的氣氛在空氣中漾開。",
        "gal_map_text_203200033=雲崖棧道上的捉弄與試探，將讓彼此的距離悄然拉近。",
        "gal_map_text_203200034=那我們去溪谷的親水準台吧，玩水納涼，還能試試撈小魚小蝦的野趣。",
        "gal_map_text_203200035=卡洛菲斯眼底閃過興奮的光彩，腳步都輕快起來。",
        "gal_map_text_203200036=這個好，正好涼快一下。不過，等會兒比賽抓小魚你可別輸給我。",
        "gal_map_text_203200037=知道了，但你可別像上次那樣，突然就潑我一身水。",
        "gal_map_text_203200038=那就要看你今天的表現啦，要是表現不好被潑水可能是在所難免的。",
        "gal_map_text_203200039=兩人朝溪谷方向走去，期待之情在打趣中悄然流露。",
        "gal_map_text_203200040=溪谷的嬉鬧互動，將觸發一場溫柔又曖昧的近距離接觸。",
        "gal_map_text_203200041=瀑布如白練傾瀉，水霧氤氳繚繞，觀景台鋪著防滑墊，陽光穿透水幕，映出無數跳躍的細碎光斑。",
        "gal_map_text_203200042=兩人抵達觀景台，卡洛菲斯舉起手機對著瀑布連拍數張。你悄悄拿出自己的手機，將鏡頭悄悄對準她專注的側影。",
        "gal_map_text_203200043=就在按下快門時，卡洛菲斯忽然轉身，一陣山風吹過，她抬手去攏帽子的瞬間髮絲輕揚，我看得微微一怔，竟忘了按下拍照鍵。",
        "gal_map_text_203200044=卡洛菲斯快步走到你面前，自然地伸手勾住你的脖頸，舉起手機對準兩人。",
        "gal_map_text_203200045=來吧，看鏡頭～3、2、1！",
        "gal_map_text_203200046=你……也太突然了，我都沒準備好。",
        "gal_map_text_203200047=沒想到還能抓拍到你這副表情，看起來還挺有趣的。",
        "gal_map_text_203200048=我剛才都還沒有準備好，能不能重拍一張？",
        "gal_map_text_203200049=重拍？也不是不行，那就要看你之後的表現了。",
        "gal_map_text_203200050=卡洛菲斯把玩著手機，目光直白地落在你的臉上，帶著毫不掩飾的捉弄意味。",
        "gal_map_text_203200051=我心中既感無奈，又為卡洛菲斯這般鮮活的模樣心動，暗自思忖著該如何接招才能達成目的。",
        "gal_map_text_203200052=那你說說，想讓我怎麼表現，只要不是太誇張的要求，我都會儘量滿足的。",
        "gal_map_text_203200053=主動幫拍多組照",
        "gal_map_text_203200054=調侃她故意刁難",
        "gal_map_text_203200055=這樣吧，我用畢生所學給你拍一組九宮格，保證張張出片， 用這個換剛才那張合影，這樣總行了吧？",
        "gal_map_text_203200056=這還差不多，不過要是有一張拍得我不滿意，不僅不給照片，還得罰你陪我逛到太陽下山。",
        "gal_map_text_203200057=放心，絕對把你拍得比身後的瀑布還引人注目。",
        "gal_map_text_203200058=要是真拍好了，說不定有額外獎勵哦，你可要好好加油哦！",
        "gal_map_text_203200059=我專注地為卡洛菲斯尋找最佳角度，兩人在拍攝的互動中，某種微妙的親近感悄然彌漫開來。",
        "gal_map_text_203200060=休憩時的閒聊，卡洛菲斯將用直白的提問，試探你的心意。",
        "gal_map_text_203200061=你這擺明瞭是在“敲詐”嘛，要是你一直不滿意，那我今天就要變成你的私人跟班了。",
        "gal_map_text_203200062=卡洛菲斯笑著伸手，指尖輕點了一下我的額頭。",
        "gal_map_text_203200063=就“敲詐”你怎麼了？誰讓你剛才偷拍未遂還走神，這是小小懲罰。",
        "gal_map_text_203200064=好好，是我不對。那請問卡洛菲斯小姐，我到底要怎麼做，才能贖回這張照片呢？",
        "gal_map_text_203200065=試試好好求我呀？求我的話，我可能就心軟了呢。",
        "gal_map_text_203200066=你來我往的調侃間，距離在不自覺中縮短，連彼此的心跳聲都仿佛清晰可聞。",
        "gal_map_text_203200067=休憩時的閒聊，卡洛菲斯將用直白的提問，試探你的心意。",
        "gal_map_text_203200068=雲崖棧道緊貼著陡峭山壁蜿蜒而上，護欄通透，腳下是令人屏息的深谷，遠方層巒疊翠。山風拂過，帶來開闊視野與幾分驚心動魄的美。",
        "gal_map_text_203200069=兩人踏上雲崖棧道，卡洛菲斯一手扶著護欄，一邊欣賞著壯闊景色。",
        "gal_map_text_203200070=行至一處遊客稀少的轉角，卡洛菲斯忽然面向深邃的山谷，暢快地大喊了一聲，回音在山壁間層層蕩開，久久不息。",
        "gal_map_text_203200071=卡洛菲斯轉過頭看向你，眼中盛滿明亮的笑意。",
        "gal_map_text_203200072=你也試試，特別解壓，超級爽！",
        "gal_map_text_203200073=算了，太引人注意了，我有點不好意思。",
        "gal_map_text_203200074=你要是也喊了，我就給你一個驚喜，保證你不會吃虧。",
        "gal_map_text_203200075=行，那我信你一次，你可不能騙人哦。",
        "gal_map_text_203200076=我面向山谷，深吸一口氣，也大喊出聲。",
        "gal_map_text_203200077=卡洛菲斯笑得像只得逞的小狐狸。",
        "gal_map_text_203200078=你把眼睛閉上，驚喜馬上就到你面前。",
        "gal_map_text_203200079=驚喜會是什麼……？",
        "gal_map_text_203200080=好了嗎？",
        "gal_map_text_203200081=卡洛菲斯的聲音從幾步開外的棧道拐角處傳來，話語中帶著藏不住的笑意",
        "gal_map_text_203200082=騙你的，我在這兒呢！",
        "gal_map_text_203200083=我又好氣又好笑，看向不遠處正朝你得意揮手的卡洛菲斯。",
        "gal_map_text_203200084=卡洛菲斯笑得眉眼彎彎，沒有半分“愧疚”，我無奈地走過去，心裡盤算著該如何“回敬”這份捉弄。",
        "gal_map_text_203200085=你對於捉弄我這件事，還真是樂此不疲。",
        "gal_map_text_203200086=假裝生氣吐槽",
        "gal_map_text_203200087=無奈笑認包容",
        "gal_map_text_203200088=你這愛捉弄人的毛病，到底什麼時候能改改，害我白期待一場。",
        "gal_map_text_203200089=卡洛菲斯笑著伸手拉住你的胳膊，輕輕晃了晃。",
        "gal_map_text_203200090=別真生氣嘛，逗你玩的，等到了最頂上，給你真正的驚喜，這次不騙你。",
        "gal_map_text_203200091=再騙我的話，可就要損失一個攝影師咯。",
        "gal_map_text_203200092=你捨得放棄我這個模特嗎？",
        "gal_map_text_203200093=兩人繼續並肩向棧道頂端走去，方才那點小小的“氣憤”早已煙消雲散，氣氛反而更加輕鬆自在。",
        "gal_map_text_203200094=頂端涼亭的休憩，卡洛菲斯將用大膽的舉動，打破彼此的曖昧僵局。",
        "gal_map_text_203200095=也就你敢這麼明目張膽地捉弄我了。要是換作別人的話，我當場轉身就走。",
        "gal_map_text_203200096=算你有耐心，知道我和別人不一樣。快走快走，再磨蹭要錯過山頂最好的光線了！",
        "gal_map_text_203200097=走慢點，棧道有點陡，注意腳下。",
        "gal_map_text_203200098=有你在後面看著，我有什麼好害怕的。",
        "gal_map_text_203200099=你們兩人一前一後穩步向上，簡單的叮囑與回應間，流淌著無須言明的信任與淡淡的情愫。",
        "gal_map_text_203200100=頂端涼亭的休憩，卡洛菲斯將用大膽的舉動，打破彼此的曖昧僵局。",
        "gal_map_text_203200101=溪谷淺灘清澈見底，溪水潺潺，卵石被沖刷得光滑圓潤。陽光灑落在水面碎成一片躍動的粼光，岸邊綠意蔥蘢，微風送來沁人心脾的涼意。",
        "gal_map_text_203200102=兩人走到溪邊，卡洛菲斯彎下腰，將手探入溪水中，指尖傳來透心的清涼，讓她愜意地眯起了眼。",
        "gal_map_text_203200103=我看著卡洛菲斯享受的模樣，也笑著彎腰，伸手欲試。就在我的指尖即將觸到水面的瞬間，卡洛菲斯忽然撩起一捧溪水，笑著潑向你。",
        "gal_map_text_203200104=你這偷襲也太快了！",
        "gal_map_text_203200105=卡洛菲斯輕巧地跳開躲避，一邊笑一邊不甘示弱地繼續潑水。",
        "gal_map_text_203200106=來呀！看誰先認輸！",
        "gal_map_text_203200107=一番嬉鬧後，你們兩人暫時休戰，我看著卡洛菲斯被水打濕的額發，從背包裡拿出乾淨的毛巾。",
        "gal_map_text_203200108=我走到她身邊，用毛巾輕輕擦拭她濕漉的發梢。",
        "gal_map_text_203200109=不擦乾容易著涼，別光顧著玩。",
        "gal_map_text_203200110=手法挺熟練嘛，給多少個女生擦過頭髮了？",
        "gal_map_text_203200111=如果是指這種……為你擦頭髮，是第一次。",
        "gal_map_text_203200112=空氣仿佛靜默了一瞬，某種難以言喻的親密氛圍在你們兩人之間悄然滋生。",
        "gal_map_text_203200113=卡洛菲斯垂著眼睫，耳尖微微泛紅，你手中擦拭的動作不自覺地放得更輕更柔，心中思索著該如何延續這份難得的親近。",
        "gal_map_text_203200114=溪水到底還是太涼了，待會兒別玩太久了，不然真感冒就不好了。",
        "gal_map_text_203200115=溫柔叮囑保暖",
        "gal_map_text_203200116=調侃她怕感冒",
        "gal_map_text_203200117=我包裡帶了件薄外套，等下你披上，別著涼了， 不然我會擔心。",
        "gal_map_text_203200118=沒想到你還挺會照顧人，比表面上看起來靠譜多了。",
        "gal_map_text_203200119=跟你一起出來，總不能讓你感覺不舒服。",
        "gal_map_text_203200120=算你合格，給你一個好評吧。",
        "gal_map_text_203200121=我繼續細緻地為卡洛菲斯擦拭，動作輕柔，四周只剩下溪水聲與這份無聲的溫馨。",
        "gal_map_text_203200122=溪水旁的意外，將讓兩人的親密關係更進一步，觸發心意的試探。",
        "gal_map_text_203200123=原來你也害怕感冒呢，我還以為你天不怕地不怕呢。",
        "gal_map_text_203200124=卡洛菲斯抬手不輕不重地拍了下你的手背，語氣嬌嗔。",
        "gal_map_text_203200125=誰怕了！我只是不想因為生病，耽誤下次出來玩的機會，這種時間可太難得了。",
        "gal_map_text_203200126=好，知道了。下次一定還陪你出來，不過……下次可不能再搞突然襲擊了。",
        "gal_map_text_203200127=那就得看你下次的表現夠不夠好。",
        "gal_map_text_203200128=互相打趣之中，嬉鬧後的溫情讓兩人的距離感消失無蹤，只剩下自然而然的親近。",
        "gal_map_text_203200129=溪水旁的意外，將讓兩人的親密關係更進一步，觸發心意的試探。",
        "gal_map_text_203200130=觀景台旁僻靜的休憩長椅，遠離人群喧囂，瀑布的水聲淙淙不絕，微風裹挾著濕潤的水霧拂面而來，氛圍愜意中摻雜著絲絲縷縷的曖昧。",
        "gal_map_text_203200131=兩人並肩坐在長椅上，小口啜飲著飲料，偶爾閒聊幾句。",
        "gal_map_text_203200132=卡洛菲斯忽然側過頭，目光直白而灼熱地看向你，略微猶豫後主動開口，語氣裡藏著一絲不易察覺的試探。",
        "gal_map_text_203200133=今天跟我出來約會，你開心嗎？",
        "gal_map_text_203200134=當然開心，只要和你在一起，做什麼都很有意思。",
        "gal_map_text_203200135=那要是下次，我和其他女孩子同時約你出去玩，你怎麼辦？",
        "gal_map_text_203200136=那我們可以三個人一起出去玩！",
        "gal_map_text_203200137=卡洛菲斯咬了咬下唇，眼神微沉，再次清晰地問道。",
        "gal_map_text_203200138=我！是！說！你只能選一個的話，你選誰！",
        "gal_map_text_203200139=那當然是只會選你一個。",
        "gal_map_text_203200140=這還差不多，你要是個花心大蘿蔔，我就把你掰成兩段！",
        "gal_map_text_203200141=因為現在站在我面前、問這個問題的人也是你，我心底唯一的答案也是你。",
        "gal_map_text_203200142=卡洛菲斯忍不住笑出聲，抬手輕拍了你一下。",
        "gal_map_text_203200143=行啊，突然這麼會說話。",
        "gal_map_text_203200144=那說好的照片，總該發我了吧？",
        "gal_map_text_203200145=行，發你了。",
        "gal_map_text_203200146=卡洛菲斯點點頭拿出手機進行操作，發送成功後，又飛快地刷屏發去一連串搞怪表情包，瞬間把照片頂到了聊天記錄上方。",
        "gal_map_text_203200147=你絕對是故意的，找半天才翻到。",
        "gal_map_text_203200148=我凝視著照片裡兩人靠得很近的笑臉，耳根微微發熱。卡洛菲斯看著你專注的模樣，嘴角不自覺揚起，眼神溫柔得能滴出水來。",
        "gal_map_text_203200149=或許是感受到她膠著的視線，你抬眸回望，心中思索著該如何回應她這份毫不掩飾的直球心意。",
        "gal_map_text_203200150=這張照片，拍得真好。我存好了。",
        "gal_map_text_203200151=直言照片心動",
        "gal_map_text_203200152=調侃她表情包多",
        "gal_map_text_203200153=和你一起被定格在畫面裡的感覺，比單獨拍任何風景都讓人心動。",
        "gal_map_text_203200154=算你品位線上，以後想多拍這樣的照片，可得好好聽我指揮。",
        "gal_map_text_203200155=好，都聽你的，以後你想拍多少，我就陪你拍多少，不管去哪兒拍都行。",
        "gal_map_text_203200156=這還差不多。說好了，可不許反悔。",
        "gal_map_text_203200157=你們兩人一起看著手機螢幕，在輕鬆的閒聊中，心意悄然傳遞，氛圍愈發甜蜜溫馨。",
        "gal_map_text_203200158=約會即將結束，卡洛菲斯將主動攔下你，送出準備好的信物。",
        "gal_map_text_203200159=你這表情包庫存也太豐富了，故意刷屏把照片頂上去，就是不想讓我輕鬆找到吧？",
        "gal_map_text_203200160=不然呢？誰讓你剛才抓拍的時候磨磨蹭蹭的，這是小小“報復”。",
        "gal_map_text_203200161=也就你敢這麼對我，換作別人，我早就不搭理了。",
        "gal_map_text_203200162=那是因為，我和“別人”，根本不一樣，對不對？",
        "gal_map_text_203200163=兩人一來一往地調侃著，曖昧的語調和拉近的距離讓彼此的心意昭然若揭。",
        "gal_map_text_203200164=約會即將結束，卡洛菲斯將主動攔下你，送出準備好的信物。",
        "gal_map_text_203200165=峽谷頂端一座古樸的小涼亭，石椅沁著山間的微涼，清風送來草木與泥土的芬芳。",
        "gal_map_text_203200166=遠處夕陽西沉，將連綿山巒染成溫暖的金橙色，氛圍浪漫而寧靜。",
        "gal_map_text_203200167=兩人走進涼亭稍作休息。卡洛菲斯望著你，眼中閃過一絲狡黠的光，主動開口，語氣聽起來輕鬆隨意，內裡卻藏著小小的試探。",
        "gal_map_text_203200168=剛才在棧道那兒，我騙你閉眼，有沒有生我的氣？",
        "gal_map_text_203200169=是有點被捉弄到的無奈，不過等走到這頂端，看到這麼壯麗的景色，還有你陪在身邊，那點無奈也就散了。",
        "gal_map_text_203200170=那你閉上眼睛的時候，心裡期待的“驚喜”……是什麼？",
        "gal_map_text_203200171=我、我猜，大概是你準備了什麼小禮物吧。",
        "gal_map_text_203200172=哦——？難道就從來沒想過，驚喜可能是一個吻嗎？",
        "gal_map_text_203200173=怎、怎麼會！我……我當時真沒往那兒想。",
        "gal_map_text_203200174=那，你再閉上眼睛試試？這次保證有驚喜，不騙你。",
        "gal_map_text_203200175=我才不信，你又想騙我。",
        "gal_map_text_203200176=卡洛菲斯見狀，忽然伸出手輕輕捂住了你的眼睛，隨即俯身，飛快地在你唇上落下一個輕柔的吻。 然後迅速鬆手退開少許。",
        "gal_map_text_203200177=先、先別睜眼！我……我還沒準備好。",
        "gal_map_text_203200178=我緩緩睜開眼睛，仿佛定格般怔在原地，下意識地抿了抿似乎還殘留著柔軟觸感的嘴唇。",
        "gal_map_text_203200179=空氣仿佛凝固了，一種熾熱而甜蜜的曖昧氣息在涼亭中無聲蔓延。",
        "gal_map_text_203200180=卡洛菲斯看著你完全失神的模樣，臉頰染上緋紅，目光卻依舊直直地望著你不曾閃躲。",
        "gal_map_text_203200181=我從巨大的衝擊中緩緩回神，心臟狂跳，思索著該如何面對這個突如其來卻又期盼已久的吻。",
        "gal_map_text_203200182=你……這是……",
        "gal_map_text_203200183=主動靠近回應",
        "gal_map_text_203200184=溫柔輕聲詢問",
        "gal_map_text_203200185=原來……這才是你準備的，真正的驚喜。",
        "gal_map_text_203200186=怎麼樣？這個驚喜，你喜歡嗎？",
        "gal_map_text_203200187=喜歡，比任何禮物都喜歡。",
        "gal_map_text_203200188=這還差不多～",
        "gal_map_text_203200189=兩人之間的距離近在咫尺，呼吸悄然交纏，在這個吻之後，所有未曾言明的心意都已清晰無比。",
        "gal_map_text_203200190=約會即將結束，卡洛菲斯將主動攔下你，送出準備好的信物。",
        "gal_map_text_203200191=你……怎麼突然就……",
        "gal_map_text_203200192=想這麼做就做了，需要那麼多理由嗎？還是說……你不喜歡？",
        "gal_map_text_203200193=不是不喜歡……只是太突然了，我心跳到現在都還沒緩過來。",
        "gal_map_text_203200194=這才叫驚喜嘛，要是提前告訴你，還有什麼意思？",
        "gal_map_text_203200195=兩人相視而笑，那個吻帶來的熾熱溫度，徹底點燃了彼此間的關係，心意已無需多言。",
        "gal_map_text_203200196=溪谷岸邊綠蔭濃密，溪水叮咚流淌，陽光穿過枝葉縫隙，在地面投下晃動的光斑。",
        "gal_map_text_203200197=微風帶著溪水特有的涼意，氣氛在溫馨中夾雜著一絲因意外而生的緊張。",
        "gal_map_text_203200198=卡洛菲斯脫下鞋襪，赤足踏入淺水區，腳尖小心地試探著溪水的清涼。",
        "gal_map_text_203200199=小魚從她腳邊倏然遊過，她沒有看清是什麼東西被嚇了一跳，有些慌亂地向岸邊退去，不料踩到一塊長著青苔的滑石，腳下一崴，身體瞬間失去平衡向後仰倒。",
        "gal_map_text_203200200=我見狀立刻起身涉水沖到卡洛菲斯身邊。",
        "gal_map_text_203200201=沒事吧？傷到哪兒了？",
        "gal_map_text_203200202=腳踝……好像扭到了，有點使不上力。",
        "gal_map_text_203200203=我聽完毫不猶豫地將卡洛菲斯打橫抱起，穩步走回岸邊，並且迅速脫下自己的外套，仔細裹在她濕漉漉的身上。",
        "gal_map_text_203200204=你在這兒坐著別動，我去看看附近有沒有服務站或者賣衣服的地方。 濕衣服不能一直穿著。",
        "gal_map_text_203200205=我立刻去尋找商店的工作人員詢問，片刻後返回。",
        "gal_map_text_203200206=問到了，前面紀念品店有賣簡單的運動服，你等我去買回來。",
        "gal_map_text_203200207=好，你快去快回。",
        "gal_map_text_203200208=我很快買回乾淨衣物，又拿出之前用過的毛巾，用身體和展開的外套為她構築了一個臨時的“更衣間”",
        "gal_map_text_203200209=快把濕衣服換下來，我保證不偷看，你動作快些別著涼。",
        "gal_map_text_203200210=知道了，你、你可不准回頭。",
        "gal_map_text_203200211=我緊閉雙眼，耳邊傳來窸窣的衣物摩擦聲，喉結不自覺地滾動了一下，強行壓下心頭莫名的悸動",
        "gal_map_text_203200212=我動作極盡輕柔地為她檢查傷勢，神情專注。",
        "gal_map_text_203200213=卡洛菲斯看著你低垂的眉眼和小心翼翼的模樣，目光溫柔得化不開。感受到她凝注的視線，你抬起頭四目相對間，曖昧與溫情無聲流淌。",
        "gal_map_text_203200214=還疼得厲害嗎？我幫你輕輕揉一下，活絡血脈會舒服些。",
        "gal_map_text_203200215=輕柔安撫傷勢",
        "gal_map_text_203200216=自責沒有照顧好",
        "gal_map_text_203200217=忍一下，揉開了瘀血會好得快些。",
        "gal_map_text_203200218=謝謝你。今天要是沒有你，我真不知道該怎麼辦了。",
        "gal_map_text_203200219=跟我還說什麼謝謝，照顧你不是應該的嗎？",
        "gal_map_text_203200220=那以後我是不是可以，一直這麼依賴你？",
        "gal_map_text_203200221=你繼續溫柔地為她按摩腳踝，無聲的關懷與依賴在兩人之間傳遞，羈絆在細微處悄然加深。",
        "gal_map_text_203200222=都怪我，沒能及時護住你。 要是我剛才離你更近一點……",
        "gal_map_text_203200223=說什麼呢，是我自己不小心滑倒的。 而且有你這樣照顧我，我一點兒也不覺得難受。",
        "gal_map_text_203200224=以後，我會更仔細地守在你身邊，不讓你再受這樣的傷。",
        "gal_map_text_203200225=這話我可記住了，不許反悔。",
        "gal_map_text_203200226=你細緻地為她處理傷勢，溫柔的自責與體貼的回應交織，讓彼此的心意在這特殊的照料時刻變得無比清晰。",
        "gal_map_text_203200227=瀑布觀景台出口，夕陽餘暉灑在水霧上，映出一道淺淺的彩虹，遊客陸續離場，約會即將落幕，氛圍溫柔中帶著淡淡不舍。",
        "gal_map_text_203200228=兩人並肩走向出口，你正說著下次拍照的計畫，卡洛菲斯突然停下腳步。",
        "gal_map_text_203200229=快步上前攔在你身前從隨身的小包裡掏出一個包裝精緻的物品，動作乾脆俐落，唯獨耳尖洩露了一絲不易察覺的緊張。",
        "gal_map_text_203200230=等等！",
        "gal_map_text_203200231=怎麼了？",
        "gal_map_text_203200232=這個是給你的，今天玩得很開心，算是留個紀念吧……你可不許說不喜歡。",
        "gal_map_text_203200233=我拆開包裝，裡面是一個設計精巧的保溫杯，罐體是啞光質感的鈦合金材質，比常見的保溫杯更為纖細優雅。",
        "gal_map_text_203200234=罐身上蝕刻著極簡的線條——一群抽象的企鵝剪影，正以優雅的弧線向斜上方“飛翔”。",
        "gal_map_text_203200235=這個設計好特別，也很實用。我非常喜歡，謝謝你。",
        "gal_map_text_203200236=喜歡就好。它叫‘暖途’，寓意著……和你在一起的時光，總是暖洋洋的。，你可要好好用著。",
        "gal_map_text_203200237=我會的，以後不管我們去哪裡我都帶著它。",
        "gal_map_text_203200238=這還差不多～下次拍照，記得用它給我裝熱水，我要喝！",
        "gal_map_text_203200239=我收下專屬信物，夕陽的餘暉與瀑布的水聲，仿佛都在為這份心意做證。",
        "gal_map_text_203200240=你拆開包裝，一個造型圓潤可愛的企鵝夜燈兼充電寶。它採用經典的帝企鵝造型，黑白分明，而且只有巴掌大小。",
        "gal_map_text_203200241=它的“肚子”是充電寶本體，背部有一個開關。",
        "gal_map_text_203200242=這個好可愛，又實用，設計得真有意思，我很喜歡。",
        "gal_map_text_203200243=喜歡就好！晚上熬夜做你那堆攻略的時候就把它點亮，就像我在旁邊提醒你：該睡覺啦，別總熬太晚。",
        "gal_map_text_203200244=嗯，以後每次用它都會想起今天，想起某個一邊捉弄我一邊笑得很開心的人。",
        "gal_map_text_203200245=少來！下次見面，照捉不誤！",
        "gal_map_text_203200246=我收下次要信物，溫柔的燈光仿佛將此刻的輕鬆與甜蜜一同封存。",
        "gal_map_text_203200247=峽谷頂端的下山路口，夕陽西下，余暉為石階鋪上一層金邊，山風拂過髮絲，帶著涼意與一絲離別氣息。",
        "gal_map_text_203200248=兩人並肩走向下山路口，正仔細叮囑她下臺階要踩穩。",
        "gal_map_text_203200249=卡洛菲斯忽然停下，快步繞到你面前攔住去路，從背包側袋裡取出一個用絲帶系好的小盒子，但遞出時指尖的微頓暴露了她的緊張。",
        "gal_map_text_203200250=這個，拿著！",
        "gal_map_text_203200251=這是……？",
        "gal_map_text_203200252=算是，剛才的後續，也是今天登頂的見證，不許嫌棄！",
        "gal_map_text_203200253=你拆開包裝，裡面是一塊 “永久凍土”概念藝術切片標本。它並非自然產物，而是用環氧樹脂與礦物粉末複合鑄造的藝術品。",
        "gal_map_text_203200254=截面清晰分為三層：頂層是模擬白色冰晶與霜花的透明層，中層是夾雜著深褐色土壤紋理與細微仿製植物纖維的“凍結土層”，底層則是更為堅實的灰黑色“岩層”。",
        "gal_map_text_203200255=這太精巧了……就像把一段封存的時光和地質故事凝固在了手裡。",
        "gal_map_text_203200256=喜歡就好！它就像我們今天的經歷，一層一層都是獨一無二的回憶。希望以後，我們能一起‘凍存’更多這樣的瞬間。",
        "gal_map_text_203200257=一定！以後的每一段路，每一個山頂，我都想和你一起看。",
        "gal_map_text_203200258=那下山扶好我，導遊先生？",
        "gal_map_text_203200259=你收下專屬信物，山風見證著這份如同“凍土”般堅實而獨特的心意。",
        "gal_map_text_203200260=你拆開包裝，裡面是一張特製的“熱感應顯影卡”。卡片本身是深藍色的，上面只有極簡的白色線條勾勒出冰山輪廓。",
        "gal_map_text_203200261=當我的手指接觸到卡片，指尖的熱量傳遞到表面，圖案開始變化：冰山的線條被溫暖的橙色填充，旁邊還有一個由熱量喚醒的、帶著笑臉的北極熊簡筆劃。",
        "gal_map_text_203200262=這太有趣了！互動感好強，設計真巧妙。",
        "gal_map_text_203200263=喜歡吧？把它帶在身邊，你的溫度就能讓它‘活’過來，就像……嗯，就像有個小小的我。",
        "gal_map_text_203200264=放心，我會讓它一直‘活’著的。 以後看到它，就會想起今天站在山頂的感覺。",
        "gal_map_text_203200265=那還差不多～快下山吧，天要黑了。",
        "gal_map_text_203200266=你收下信物，這枚需要體溫激活的小禮物，成了兩人間獨特的秘密紐帶。",
        "gal_map_text_203200267=溪谷親水準台的出口步道，夕陽餘暉在水面碎成萬千金鱗，溪水潺潺，草木清香中混雜著一絲涼意。",
        "gal_map_text_203200268=我小心地攙著卡洛菲斯慢慢走向出口，口中還念叨著下次要選個更平緩安全的水邊。",
        "gal_map_text_203200269=卡洛菲斯忽然停下，就著被你攙扶的姿勢，用空著的那只手從包裡摸出一個用防水袋仔細包好的物品塞進你手裡。",
        "gal_map_text_203200270=喏，這個，給你。",
        "gal_map_text_203200271=腳還疼嗎？這是……？",
        "gal_map_text_203200272=今天……麻煩你了，這個算是一點謝禮，也是紀念。",
        "gal_map_text_203200273=我開防水袋，裡面是一塊未經打磨的天然深海藍方解石原石，大約有手掌大小。",
        "gal_map_text_203200274=石頭本身並不透明，呈現出從邊緣灰白到中心濃郁靛青的天然漸變色，仿佛將深海的光影層次凝固其中。",
        "gal_map_text_203200275=表面佈滿天然晶簇斷面，在光線下閃爍著如生物螢光般的冷冽碎光。",
        "gal_map_text_203200276=真美……像是把一片深海握在了手裡。 這份禮物太珍貴了，謝謝你。",
        "gal_map_text_203200277=它叫‘深藍記憶’。 就像今天溪谷的水涼涼的，但也清澈見底。",
        "gal_map_text_203200278=希望不管時間過去多久，我們在一起的時光，都能像它一樣，保持最初的顏色和光彩。",
        "gal_map_text_203200279=嗯，我會好好保存這份‘記憶’。以後，還想和你一起去看看真正的大海。",
        "gal_map_text_203200280=那你可得把我扶穩了，下次出來玩別再讓我摔進水裡。",
        "gal_map_text_203200281=我收下專屬信物，這塊沉靜的石頭，仿佛成為今日溪邊歡笑與依賴的實體見證。",
        "gal_map_text_203200282=你拆開防水袋，裡面是一張手工製作的“深海分色卡”。",
        "gal_map_text_203200283=卡紙被精心切割和層疊，通過不同深淺、透明度的藍色與紫色硫酸紙、構成了一幅抽象的色彩層次圖。",
        "gal_map_text_203200284=從最上方透亮的“透光層”，到中間濃郁的“水壓藍”，再到最下方幾乎不透明的“深淵紫”。",
        "gal_map_text_203200285=這真是手工做的嗎？太精緻了，色彩的層次感好美。",
        "gal_map_text_203200286=當然！它叫‘水色漸變’。 就像今天的溪水，看著簡單，其實有好多層次和顏色。",
        "gal_map_text_203200287=以後你看到它，就能想起今天泡在涼涼溪水裡的感覺，還有……某個被你照顧得很好的倒楣蛋。",
        "gal_map_text_203200288=不是倒楣蛋，是今天最特別的同伴。 這份禮物，我會好好珍藏的。",
        "gal_map_text_203200289=知道就好～下次，我還選有水的地方！",
        "gal_map_text_203200290=我收下信物，這張凝聚了水色光影的手工卡片，定格了溪邊獨有的清涼與悸動。",
        "gal_map_text_203200291=山地公園邊緣的音樂噴泉廣場，噴泉尚未開啟，零星的行人駐足等候，夜幕初垂，天際尚存一抹紫霞，氛圍靜謐而溫柔。",
        "gal_map_text_203200292=你與卡洛菲斯並肩走出公園，沿著林蔭道緩緩前行，陽光將你們的影子拉得細長交疊。",
        "gal_map_text_203200293=卡洛菲斯忽然停下腳步，伸手輕輕拉住你的手腕，不由分說地帶著我轉向噴泉廣場的方向，語氣爽利，卻藏著一絲罕見的柔意。",
        "gal_map_text_203200294=怎麼突然來這兒？這是哪裡？",
        "gal_map_text_203200295=噓——別急，聽我倒數。3——2——1！",
        "gal_map_text_203200296=“1”字剛落，悠揚的樂曲驟然響起，環繞廣場的噴泉口同時噴湧出晶瑩的水柱。",
        "gal_map_text_203200297=水柱隨著音樂的節奏搖曳舞動，七彩燈光從水底透出，將每一顆水珠都染上夢幻的顏色。",
        "gal_map_text_203200298=我被這突如其來的聲光盛宴驚得微微一怔。",
        "gal_map_text_203200299=卡洛菲斯趁著你失神的刹那，雙手捧住你的臉，輕輕將你的視線轉向自己，然後一頭撲進你懷裡，聲音悶在胸口，帶著得逞的笑意。",
        "gal_map_text_203200300=就這樣，別動……陪我看到最後。",
        "gal_map_text_203200301=好。",
        "gal_map_text_203200302=我在短暫的錯愕後，手臂自然而然地環上她的腰，將卡洛菲斯穩穩擁住。",
        "gal_map_text_203200303=兩人相擁立於流光溢彩的噴泉中央，音樂與水聲在耳邊交響，迷離的光影流淌過彼此的眉眼與發梢。",
        "gal_map_text_203200304=直至最後一串音符消散，水柱溫柔垂落，四周重歸寧靜，兩人才依依不捨地稍稍鬆開了懷抱，並肩向廣場外走去。",
        "gal_map_text_203200305=今天的約會，我打滿分。 而且，我希望我是第一個這樣“綁架”你來噴泉下傻站的人。",
        "gal_map_text_203200306=好，那你就賴定我吧。不過下次，也許該輪到我來策劃“驚喜”了？",
        "gal_map_text_203200307=卡洛菲斯挑眉，伸手握住你的手，指尖在你掌心迅速而清晰地畫了一個小小的愛心。",
        "gal_map_text_203200308=這個，代表“今日份滿意”。下次你捉弄我的時候，要是也能讓我這麼開心，就算你贏。",
        "gal_map_text_203200309=說完，卡洛菲斯轉鬆開手，恰好一輛車緩緩駛到路邊。她轉身拉開車門，又回頭用力朝你揮了揮手。",
        "gal_map_text_203200310=走啦！下次見！",
        "gal_map_text_203200311=路上小心。期待下次。",
        "gal_map_text_203200312=目送車輛匯入街燈流淌的車河，直至消失不見，我仍佇立原地。",
        "gal_map_text_203200313=這一切美好得不像真的，可懷裡的溫度、掌心的觸感，還有心臟清晰的鼓動，都在告訴我它的真實。",
        "gal_map_text_203200314=我想，我早已深深喜歡上這個像夏日驟雨般闖進我世界的你了。",
        "gal_map_text_203200315=我回到家中，將今日收到的信物輕輕放置在書桌最醒目的位置。指尖拂過那些獨特的紋路與質感，臉上不自覺地漾開溫柔笑意。",
        "gal_map_text_203200316=我翻開日記本，就著檯燈溫暖的光，將這一日的相遇與心動細細描摹：從公園門口精心策劃的“驚喜”敗露，到每一個場景中卡洛菲斯帶來的歡笑。",
        "gal_map_text_203200317=再到噴泉光影中那個無需言語的擁抱。筆尖流動，最後，你在嶄新的一頁鄭重寫下。",
        "gal_map_text_203200318=“噴泉會停歇，音樂會終章，但今夜因你而起的悸動，早已在我心中生根迴響。往後歲月，但願能與你並肩，共覽星河璀璨，同曆煙火尋常。”",
        "gal_map_text_206200000=博物館正門，細雨初歇，空氣浸潤著草木與遙遠年代的清冽氣息",
        "gal_map_text_206200001=敖靈撐著素色雨傘，指尖輕撚展廳導覽冊，目光掠過展區介紹後，低眸瞥了一眼腕表，眉尖幾不可察地輕蹙。",
        "gal_map_text_206200002=似乎來得太早了些……該先發條消息，萬一他臨時有事……",
        "gal_map_text_206200003=抱歉，路上耽誤了一會兒。",
        "gal_map_text_206200004=收起導覽冊，從手袋中取出一方紙巾，抬手輕拭你的額角。",
        "gal_map_text_206200005=沒事，我也剛到。",
        "gal_map_text_206200006=我指尖不經意擦過敖靈微涼的手背，呼吸微微一滯。知曉她素來不喜直白追問，他便想借由試探，捕捉她心儀的去處。",
        "gal_map_text_206200007=展區不少，導覽上標注了幾處核心陳列，我們可以慢慢看。你有特別想先看的類別嗎……",
        "gal_map_text_206200008=敖靈垂眸整理傘沿。",
        "gal_map_text_206200009=由你決定就好，我都可以。",
        "gal_map_text_206200010=探青銅銘文廳",
        "gal_map_text_206200011=尋水墨書畫廊",
        "gal_map_text_206200012=訪風雅宋展區",
        "gal_map_text_206200013=我一直對古代銘文很感興趣，那些尚未破譯的文字像沉默的謎語，先去青銅廳看看",
        "gal_map_text_206200014=敖靈指尖無意識地撫過導覽冊上青銅展區的紋樣插。",
        "gal_map_text_206200015=古老的文字自有其韻律，值得靜心品味。可以去品味一番。",
        "gal_map_text_206200016=我帶了筆記本，遇到不懂的，還得聽你講解。",
        "gal_map_text_206200017=你的筆記向來清晰，一起琢磨就好。",
        "gal_map_text_206200018=兩人並肩步入館內，向著青銅銘文廳的方向走去。",
        "gal_map_text_206200019=青銅廳籠罩在昏黃柔光中，古器默然佇立，一段意料之外的近距離交匯，正悄然醞釀。",
        "gal_map_text_206200020=水墨長廊應當清靜，適合駐足細賞。聽說《江雪圖》正在那展出，要去看看嗎？",
        "gal_map_text_206200021=水墨留白處，最見深遠意境。久聞《江雪圖》之名，今日正好親見。",
        "gal_map_text_206200022=敖靈目光掠過遠處書畫廊標識，睫毛輕顫。",
        "gal_map_text_206200023=我就猜你會喜歡。上次你提過的筆法濃淡，正好可以對照真跡細細體會。",
        "gal_map_text_206200024=嗯，實物遠比文字描述更觸動心緒。",
        "gal_map_text_206200025=兩人收傘踏入長廊，淡淡墨香與宣紙氣息如絲如縷縈繞身畔。",
        "gal_map_text_206200026=廊間畫意悠遠靜謐，一場關於“畫中藏鋒”的輕語交鋒，將讓兩人距離驟然拉近。",
        "gal_map_text_206200027=風雅宋展區多是茶器、花箋這類日常雅物，講究生活之趣，會不會覺得太過細碎？",
        "gal_map_text_206200028=宋代美學，恰藏於這煙火氣息之中，精微卻不瑣碎，值得細觀。。",
        "gal_map_text_206200029=敖靈指尖輕叩說明書上宋式茶桌配圖。",
        "gal_map_text_206200030=那我們就去那裡。正好也感受一番古人的閒情與巧思",
        "gal_map_text_206200031=你一向留心細節，定能發現不少妙處。",
        "gal_map_text_206200032=兩人緩緩走向風雅宋展區，步履輕緩，仿佛周身也染上一縷淡雅清韻。",
        "gal_map_text_206200033=展區內仿古陳設精巧雅致，一場宋式點茶體驗，即將成為兩人之間溫柔交織的契機。",
        "gal_map_text_206200034=展廳燈光幽微，青銅鼎、青銅牌靜默陳列于玻璃展櫃中，牆面映照著銘文釋義，氛圍厚重而靜謐。",
        "gal_map_text_206200035=你與敖靈並肩立于青銅鼎展櫃前，你正低頭記錄，敖靈則凝神端詳鼎身銘文，神情專注。此時，展廳角落有工作人員正在調整設備，地面因剛清潔過略顯濕滑，敖靈稍一後退，腳下便是一滑。",
        "gal_map_text_206200036=啊！",
        "gal_map_text_206200037=小心！",
        "gal_map_text_206200038=我聞聲迅速轉身，手臂環住敖靈腰側將她護向自己，兩人失衡傾跌，你以身墊護，敖靈輕伏在你身前，氣息咫尺可聞。",
        "gal_map_text_206200039=敖靈臉頰微紅，慌亂撐著你肩膀起身，語氣局促。",
        "gal_map_text_206200040=抱歉，我沒注意地上。",
        "gal_map_text_206200041=你沒事吧？有沒有碰到哪裡？",
        "gal_map_text_206200042=我沒事，倒是你……墊在下麵，疼不疼……",
        "gal_map_text_206200043=空氣裡似有若無地浮動著一絲曖昧，敖靈雖顯局促卻並未不悅。你知她素來不擅應對這般親近，便想緩和氣氛，亦借此試探她的心緒。",
        "gal_map_text_206200044=地面確實有些滑，之後我們多留意。剛才你看的那段銘文，我恰好有幾處沒太明白，可以再為我講講嗎？",
        "gal_map_text_206200045=柔聲安撫為先",
        "gal_map_text_206200046=順勢探討銘文",
        "gal_map_text_206200047=別緊張，我知道你不是故意的。",
        "gal_map_text_206200048=嗯……我明白。你自己也要當心。",
        "gal_map_text_206200049=有你在旁提醒，我一定注意。那銘文，我們待會再慢慢看？",
        "gal_map_text_206200050=好，那一處的筆意與韻律都特別，我指給你看。",
        "gal_map_text_206200051=兩人重新在展櫃前站定，彼此間的氛圍卻比先前更顯親近，言談間也添了幾分不易察覺的柔和。",
        "gal_map_text_206200052=隨著向展廳深處走去，一枚以“知音”為題的青銅銘文牌，將讓兩人間的默契再度悄然滋長。",
        "gal_map_text_206200053=你看這個“鼎”字的銘文，和常見典籍裡的寫法不同，是不是有更特定的含義？",
        "gal_map_text_206200054=這是商周時期的異體，字形更為古拙，多用於記述祭祀， 與我們之前討論過的文字流變規律倒是吻合。",
        "gal_map_text_206200055=經你這麼一點撥，就清晰多了，還是你見多識廣。",
        "gal_map_text_206200056=你能注意到字形的細微差別，也很敏銳。",
        "gal_map_text_206200057=兩人沉浸于對銘文的探討之中，知音般的投契令氣氛自然融洽，方才那一瞬親密接觸帶來的微妙尷尬，已然無聲消弭。",
        "gal_map_text_206200058=展廳深處的青銅牌，藏著一段千年知音愛戀，將觸發敖靈的心意試探。",
        "gal_map_text_206200059=長廊兩側水墨畫卷徐徐鋪展，牆面素淨，燈光柔和，空氣中若有若無地縈繞著墨香與紙韻，清雅而寧靜。",
        "gal_map_text_206200060=兩人靜立于《江雪圖》前凝神觀賞。",
        "gal_map_text_206200061=一旁，工作人員正組織“畫中尋幽”趣味活動，成功找出所有差異者可獲贈《江雪圖》精巧掛飾。敖靈主動上前參與，很快便尋出多處，唯餘最後一處隱匿難覓。",
        "gal_map_text_206200062=敖靈凝視畫作，指尖無意識地輕點下唇，低聲自語",
        "gal_map_text_206200063=最後一處……究竟在哪兒？",
        "gal_map_text_206200064=我見狀上前，自然而輕緩地托住敖靈的手，引其指尖落向畫中那處幽微的墨色變。",
        "gal_map_text_206200065=在這裡，你看山石間的暈染層次。",
        "gal_map_text_206200066=敖靈形微微一凝，臉頰暈開淡紅，指尖輕輕蜷起。",
        "gal_map_text_206200067=……",
        "gal_map_text_206200068=您好工作人員，我們找齊了。",
        "gal_map_text_206200069=我接過掛飾，轉身遞向敖靈",
        "gal_map_text_206200070=送給你。",
        "gal_map_text_206200071=敖靈心神似乎仍停留在方才觸碰的余溫裡，眼神怔了一瞬，方伸手接。",
        "gal_map_text_206200072=……謝謝。",
        "gal_map_text_206200073=敖靈將小巧的掛飾握在掌心，指尖仿佛還殘留著你掌心的溫度，頰邊緋色未褪。你此刻才留意到她的羞澀，便想以溫柔回應，悄然拉近彼此的距離。",
        "gal_map_text_206200074=這個掛飾很精緻，和你很配。剛才……是不是嚇到你了？",
        "gal_map_text_206200075=溫柔致歉釋疑",
        "gal_map_text_206200076=借畫轉移話題",
        "gal_map_text_206200077=抱歉，剛才一時心急想指給你看，沒顧上你的感受。",
        "gal_map_text_206200078=無妨，是我自己看得太入神了。還是要謝謝你。",
        "gal_map_text_206200079=能幫上忙就好。前面還有一幅《月下獨酌》，一起去看看？",
        "gal_map_text_206200080=嗯，那幅畫的留白意境，我一直很想親眼看看。",
        "gal_map_text_206200081=兩人再度並肩而行，氛圍在些許曖昧中流淌著自然的親近，敖靈清冷的氣質裡，也融入了些許柔和的溫度。",
        "gal_map_text_206200082=長廊盡頭那幅《月下獨酌》，將成為敖靈以畫喻心，試探你心意的巧妙開端。",
        "gal_map_text_206200083=這幅《江雪圖》的留白意境，實在精妙，比印在書冊上的更有呼吸感。",
        "gal_map_text_206200084=是啊，真跡的筆墨氣韻與張力，是複製品難以傳達的。",
        "gal_map_text_206200085=敖靈起眼看向你，頰邊的紅暈漸漸淡去。",
        "gal_map_text_206200086=你對於水墨的品評獨到，待會看到《月下獨酌》，可得再聽聽你的見解。",
        "gal_map_text_206200087=你對畫中細節的觀察，也從不讓人失望。",
        "gal_map_text_206200088=話題回歸畫作本身，那份知音般的默契悄然沖淡了方才的旖旎，氛圍變得愈發舒緩融洽。",
        "gal_map_text_206200089=立於《月下獨酌》畫前，熬靈將以畫中意境為引，委婉試探你的心中所想。",
        "gal_map_text_206200090=展廳色調清雅溫潤，陳列著宋代茶器、香具、花箋等雅物，一角設有仿古茶席，茶香與清雅的香料氣息交織，氛圍恬淡而雅致。",
        "gal_map_text_206200091=兩人行至仿古茶席前，工作人員微笑邀請你們體驗宋代點茶。敖靈望著眼前的茶筅與茶盞，眼中流露出一絲好奇，嘗試操作時卻稍顯生疏，幾點細小的茶末輕濺到指尖。",
        "gal_map_text_206200092=蹙眉看著指尖茶沫，正欲抬手擦拭。",
        "gal_map_text_206200093=別直接擦，擦不乾淨。",
        "gal_map_text_206200094=我取出隨身濕巾，輕輕握住她的手腕，用濕巾一角細緻拭去敖靈指尖茶沫。",
        "gal_map_text_206200095=敖靈手臂輕顫，臉頰倏然泛紅，將手收回，語速稍快了些。",
        "gal_map_text_206200096=宋人點茶，最是講究手法精微，我倒是露怯了。",
        "gal_map_text_206200097=你已學得很快了，多試幾次就熟練了。",
        "gal_map_text_206200098=幸好……有你在旁邊。",
        "gal_map_text_206200099=敖靈刻意將話題轉向茶藝，卻難掩語氣中一絲未平的波瀾。你知道她性格內斂易羞，便順著她的話題延展，同時悄然傳遞自己的心意。",
        "gal_map_text_206200100=宋人點茶品茗時，常以詩詞唱和、清談為伴，你平時還喜好哪些雅事？",
        "gal_map_text_206200101=聊茶器賞雅趣",
        "gal_map_text_206200102=說陪伴願同行",
        "gal_map_text_206200103=你看這茶盞的釉色與紋樣，清雅含蓄，宋人的審美果然在細微處見真章。",
        "gal_map_text_206200104=嗯，釉質溫潤如玉，紋樣簡約而有深意，正是宋代“雅淡”美學的體現。",
        "gal_map_text_206200105=你對美學的感知很敏銳，和你一起賞這些物件，很舒心。",
        "gal_map_text_206200106=彼此志同道合，自然舒心。",
        "gal_map_text_206200107=兩人圍坐茶席，從茶器聊到美學，知音般的默契流淌其間，氛圍溫馨而自然",
        "gal_map_text_206200108=小憩閒談時，敖靈將以宋代知己為引，試探你是否願長期相伴。",
        "gal_map_text_206200109=其實，無論是點茶，還是賞玩這些雅器，因為是你，因為在一起，才覺得格外有意義。",
        "gal_map_text_206200110=敖靈抬眼看向你，眼神帶一絲探究，語氣輕柔。",
        "gal_map_text_206200111=你……對誰都這般有耐心陪伴嗎？",
        "gal_map_text_206200112=當然是只願意這樣陪著你，和你一起經歷的這些時光，遠比獨自欣賞所有風景更珍貴。",
        "gal_map_text_206200113=敖靈垂眸抿了口茶。",
        "gal_map_text_206200114=……嗯，我明白了。",
        "gal_map_text_206200115=你直白而溫柔的回應讓空氣中彌漫開曖昧的甜意，敖靈雖未直言，眼底閃動的微光卻已洩露了心緒的波動。",
        "gal_map_text_206200116=于休息處品茶閒談時，敖靈將以一句暗藏機鋒的宋詞，作為對你“陪伴”之語的回應，將彼此的距離再次悄然拉近。",
        "gal_map_text_206200117=展廳深處，一枚鐫刻著繁複銘文的青銅牌靜靜陳列，牆面的釋義文字簡潔，四周再無他人，氛圍格外靜謐。",
        "gal_map_text_206200118=兩人並肩立於青銅牌前，細細辨讀銘文。可惜你只解讀出前半段——講述一對知音如何相遇相知，後半段因字形古奧、語義幽深，一時未能解出。",
        "gal_map_text_206200119=敖靈卻似已通讀全文，眸光微動，臉頰泛起淡淡紅暈，輕聲感歎。",
        "gal_map_text_206200120=這故事的結局……很美。",
        "gal_map_text_206200121=結局？我只看出他們相識相知，後面發生了什麼？他們最終如何？",
        "gal_map_text_206200122=銘文後半段寫道，那位看似離去的知音，實則從未遠離，歷經歲月流轉，仍在原地守候，終得重逢。",
        "gal_map_text_206200123=原來如此……所以你說結局美好。這般穿越時光的知音之誼，確實珍貴。",
        "gal_map_text_206200124=敖靈臉頰微紅，試探著問道。",
        "gal_map_text_206200125=那你覺得……知音之間，是否應當彼此守候，不論時光長短？",
        "gal_map_text_206200126=敖靈的試探含蓄而又清晰，你敏銳地捕捉到她話中的深意，便想借著這段古老的故事，給出自己的答案。",
        "gal_map_text_206200127=世間志趣相投者本就難尋，既已遇見，怎能輕易錯過。",
        "gal_map_text_206200128=喻情千年守候",
        "gal_map_text_206200129=直言願伴左右",
        "gal_map_text_206200130=就像這銘文裡的人，等待或許漫長，但只要是對的人，便都值得。而我，也願意成為那個懂得守候的人。",
        "gal_map_text_206200131=敖靈垂睫避開你專注的目光，頰邊緋色更深。",
        "gal_map_text_206200132=千年……太過遙遠了。能夠把握的當下，彼此相伴，就已很好。",
        "gal_map_text_206200133=現在的每一刻相伴，我都會珍惜。而我更希望的，是未來也能一直這樣陪在你身邊。",
        "gal_map_text_206200134=敖靈抬眸我你對視，眼中漾開柔光。",
        "gal_map_text_206200135=嗯……我聽見了。",
        "gal_map_text_206200136=古老銘文的故事仿佛一面鏡子，映照出兩人間悄然流動的心意，氛圍溫馨而堅定。",
        "gal_map_text_206200137=約會臨近尾聲，當兩人準備離開展廳時，敖靈將輕輕拉住你，贈出一份專屬的信物。",
        "gal_map_text_206200138=於我而言，能遇見你這樣的知音，已是莫大的幸運。我不想空等虛幻的千年，只願從此刻起，就能陪伴在你身旁，無論未來如何。",
        "gal_map_text_206200139=你……有點太過直接了。",
        "gal_map_text_206200140=不過，知音相伴，本就該是相互照拂的。",
        "gal_map_text_206200141=那說好了，以後發現更有趣的銘文或故事，我們都一起來解讀，好嗎？",
        "gal_map_text_206200142=好，一起琢磨。",
        "gal_map_text_206200143=你的直率與敖靈的含蓄回應巧妙相合，彼此的關係在心照不宣中更進一步。",
        "gal_map_text_206200144=即將走出展館之際，敖靈會取出另一件精心準備的信物送給你。",
        "gal_map_text_206200145=長廊盡頭，《月下獨酌》圖高懸於壁，留白處仿佛浸潤著泠泠月華，周遭安靜得能聽見彼此清淺的呼吸聲。",
        "gal_map_text_206200146=兩人站在畫作前靜靜欣賞，良久，敖靈緩緩開口，語氣帶著感慨。",
        "gal_map_text_206200147=這畫中的孤寂，都化進了月色裡，卻又透著一份自在的灑脫。",
        "gal_map_text_206200148=你看得很透徹，不過我想，他或許並非甘於孤獨，只是尚未等到那個能讀懂這片月色的人",
        "gal_map_text_206200149=那你呢？你……可曾等到那個能讀懂你的人？",
        "gal_map_text_206200150=等到了，此刻，她就在我眼前。",
        "gal_map_text_206200151=敖靈臉頰驀地緋紅，略顯慌亂地移開視線。",
        "gal_map_text_206200152=…這幅畫的留白，虛實相生，確實比任何摹本都更有餘韻。",
        "gal_map_text_206200153=敖靈生硬地轉移了話題，卻掩不住話音裡的羞澀與細微顫抖。你深知她不慣直抒胸臆，便順著她的話，將心意包裹在更溫柔的言辭裡。",
        "gal_map_text_206200154=留白的妙處，正在於懂得的人自能領會其中真意。人與人之間，有時也只需一個眼神，一份默契，便勝過千言萬語。",
        "gal_map_text_206200155=借畫喻情表意",
        "gal_map_text_206200156=溫柔順勢回應",
        "gal_map_text_206200157=畫求知己，人亦如是。我何其有幸，能遇見讀懂我的你，就如同這幅畫，終於等來了它的知音。",
        "gal_map_text_206200158=敖靈抬眸迎上你的目光，眼中似有漣漪漾開。",
        "gal_map_text_206200159=能遇見互相懂得的人……的確是幸運。我，也是這麼覺得。",
        "gal_map_text_206200160=那以後，我們一起去更多地方，看更多的畫，讀懂每一處沉默的留白，好嗎？",
        "gal_map_text_206200161=好。",
        "gal_map_text_206200162=畫中意境與彼此的心事悄然重疊，氛圍在曖昧中流淌著無需言明的契合。",
        "gal_map_text_206200163=離開長廊時，敖靈將停下腳步，為你送上專屬信物。",
        "gal_map_text_206200164=那個讀懂我的人，不就是你嗎？無論是畫中的意境，還是我未曾說出口的話，你好像都明白。",
        "gal_map_text_206200165=敖靈身體微微一顫，隨即放鬆下來。",
        "gal_map_text_206200166=嗯……我明白的。",
        "gal_map_text_206200167=能被你懂得，真好。那從今往後，也讓我學著，更懂你的一切，可以嗎？",
        "gal_map_text_206200168=敖靈指尖輕蜷，卻沒有躲開，耳根染上緋色。",
        "gal_map_text_206200169=……好。",
        "gal_map_text_206200170=指尖傳來微暖的觸感，像一道無形的橋，將兩顆心拉近，先前那份若有若無的清冷距離，已然冰消雪融。",
        "gal_map_text_206200171=離開展館前，敖靈將拿出準備好的次要信物，贈予你。",
        "gal_map_text_206200172=展廳一隅的休息椅上，兩人面前各有一盞清茶，宋式雅物的陳設環繞四周，茶香與清幽的香料氣息嫋嫋交融，氛圍恬靜而溫馨。",
        "gal_map_text_206200173=兩人敖靈安然對坐品茗，偶爾目光相接，空氣裡彌漫著無聲的融洽。敖靈指尖輕撫過茶盞上細膩的紋路，語氣柔和地開口，似在閒談，又似藏著更深的試探。",
        "gal_map_text_206200174=宋人常歎“知己難求”，若能遇到幾個志趣相投者，烹茶細論，確實是件開心的事情。",
        "gal_map_text_206200175=能和你一起體驗這些，真的太好了。有你這樣的知己，很滿足。",
        "gal_map_text_206200176=那……要是以後我還想去探尋些別的東西，你是不是願意和我一起呢？",
        "gal_map_text_206200177=“為愛清香頻入座，欣同知己細談心。” 我當然願意。",
        "gal_map_text_206200178=你以詩作答，讓敖靈頰上紅暈更甚，心中悸動難以平復。她雖不擅熱烈直接的表達，卻也想用自己方式，給予溫柔的迴響。",
        "gal_map_text_206200179=詩句雖短……情意卻長。",
        "gal_map_text_206200180=溫柔承諾相伴",
        "gal_map_text_206200181=默契相視一笑",
        "gal_map_text_206200182=不只是風雅之事，以後你想去的地方，想看的風景，想經歷的點點滴滴，我都想陪在你身邊。",
        "gal_map_text_206200183=嗯，你的話，我記住了。",
        "gal_map_text_206200184=敖靈抬眸凝視你，眼中漾開一片暖融融的溫柔。",
        "gal_map_text_206200185=我也會，一直陪著你的。",
        "gal_map_text_206200186=有你這句話，就夠了。",
        "gal_map_text_206200187=嗯。",
        "gal_map_text_206200188=溫柔的承諾在茶香中交匯，彼此的心意再無隔閡，氛圍甜蜜而篤定。",
        "gal_map_text_206200189=約會將盡，離開展區時，敖靈將攔下你，送上專屬信物。",
        "gal_map_text_206200190=有些心意，或許不必盡數言說，對嗎？",
        "gal_map_text_206200191=嗯，是的。",
        "gal_map_text_206200192=敬知己，也敬……往後長長的日子。",
        "gal_map_text_206200193=敬知己。",
        "gal_map_text_206200194=清茶映著笑意，無聲的默契在空氣中流淌，所有未盡之言，皆已融於這相視一笑的瞬間。",
        "gal_map_text_206200195=離開展區時，敖靈將拿出準備好的次要信物，贈予你。",
        "gal_map_text_206200196=博物館出口處，夕陽餘暉透過玻璃幕牆傾灑而入，拉出長長的暖金色光痕，氛圍寧靜而溫暖。",
        "gal_map_text_206200197=我正欲開口道別，敖靈卻忽然上前一步，輕輕攔在你身前。她從隨身的手袋中取出一個素色小布囊，遞到你面前，動作帶著一絲不易察覺的緊張，目光卻清澈而堅定。",
        "gal_map_text_206200198=這個，請你收下",
        "gal_map_text_206200199=我接過尚帶余溫的布囊。",
        "gal_map_text_206200200=這是？",
        "gal_map_text_206200201=今天在展廳裡留意到的，是工作人員整理時多餘的一份小件。我覺得……你或許會喜歡，便詢問能否帶走。",
        "gal_map_text_206200202=我小心地打開布囊",
        "gal_map_text_206200203=很別致，我非常喜歡，謝謝你。",
        "gal_map_text_206200204=一塊比手掌略大的深色木制托板，托板上用極細的絲線，固定著幾片顏色、質地各異的碎片。",
        "gal_map_text_206200205=一片帶有暗綠銅銹的金屬薄片，一片邊緣焦黑的龜甲殘片，一片印著淡淡墨痕的宣紙角，還有一小塊溫潤的玉石碎屑。",
        "gal_map_text_206200206=上面刻的，是“知音”……我覺得，它很貼合我們之間",
        "gal_map_text_206200207=是，再貼合不過。我會將它好好珍藏，如同珍藏與你相遇相知的這份情誼。",
        "gal_map_text_206200208=布囊內是一枚造型古拙的銅制書簽，尾部鐫刻著簡約的雲雷紋飾，與展廳內青銅器的紋樣風格一脈相承。",
        "gal_map_text_206200209=讀書看資料時可以用來標記。以後……再一起研究那些銘文的時候，或許能用上。",
        "gal_map_text_206200210=謝謝你，考慮得這麼周到。以後每次和你看展、讀書，我都會帶著它。",
        "gal_map_text_206200211=我將信物輕輕握入掌心，暖意自指尖蔓延至心間。敖靈垂眸，唇角漾開一抹極淺的笑意，周遭空氣都浸染著無聲的溫馨。",
        "gal_map_text_206200212=我護送敖靈準備回家，一場浪漫終局即將上演。",
        "gal_map_text_206200213=博物館外，夕陽將天際暈染成淡淡的橘粉色，微風輕拂，帶著傍晚特有的溫柔暖意。",
        "gal_map_text_206200214=兩人並肩走向離館的方向，敖靈卻忽然駐足，從包中取出一個掌心大小的素雅紙盒，雙手遞到你面前。敖靈頰邊微紅，眼神卻透著少有的認真。",
        "gal_map_text_206200215=這個給你，今天看畫的時候，就覺得……它應該屬於你。",
        "gal_map_text_206200216=我接過尚帶她指尖溫度的紙盒。",
        "gal_map_text_206200217=謝謝，我很開心。",
        "gal_map_text_206200218=不知道……你會不會喜歡。",
        "gal_map_text_206200219=盒子內是一個簡約、輕薄、胎體瑩潤的白瓷碟，上方的墨痕恰好構成簡約的“月”形，與《月下獨酌》的意境呼應。",
        "gal_map_text_206200220=這墨痕，讓我想起那幅畫裡的月光，懂得的人……自然能看見其中的意境。",
        "gal_map_text_206200221=它就像你一樣，清雅、獨特，令人珍視。我一定會好好保存。",
        "gal_map_text_206200222=次級信物劇情旁白",
        "gal_map_text_206200223=這青銅上的紋樣，取自今天看過的某幅畫作的落款印，算是……今日一同賞畫的一個印記。",
        "gal_map_text_206200224=很有心思的紀念，我特別喜歡，以後每當我見到它，都會想起今天和你共度的時光。",
        "gal_map_text_206200225=小小的信物仿佛承載了千言萬語，兩人相視一笑，繼續向前走去，空氣中彌漫著心照不宣的甜蜜。",
        "gal_map_text_206200226=抵達遊樂園門口，煙花悄然綻放，浪漫終局正式開啟。",
        "gal_map_text_206200227=博物館附近的街角，夕照為景物鍍上金邊，街道安靜，空氣中仿佛還殘餘著一絲清雅的茶香。",
        "gal_map_text_206200228=你正要抬手示意車輛，敖靈輕聲喚住了你。她轉而從包中取出一個扁平的透明收納盒，遞到你手中，眼神溫柔，動作卻透著一股堅定的意味。",
        "gal_map_text_206200229=這個，請你收下，是……今天的一點紀念。",
        "gal_map_text_206200230=我接過盒子，打開後眼中漾開笑",
        "gal_map_text_206200231=真美，謝謝你，這是屬於我們共同的回憶，格外珍貴。",
        "gal_map_text_206200232=嗯，很有意義。",
        "gal_map_text_206200233=盒內精心封裝著一片以宋式技法製作的押花箋，箋紙一角，有敖靈以朱砂筆細緻勾勒的一個小小“靈”字花押。",
        "gal_map_text_206200234=旁邊還配有一枚素雅的白瓷小碟，碟身釉下透著淡淡的青瓷紋樣。",
        "gal_map_text_206200235=花箋留存今日之雅趣，這小碟……日後若一同品茶，或許用得上。",
        "gal_map_text_206200236=以後每次喝茶看到它，都會想起今天，想起此刻站在我面前的你。",
        "gal_map_text_206200237=盒旁附有一個錦緞小香囊，裡面裝著少許按古方配比的香料，隱約可辨肉桂、丁香等清雅氣息，正是宋代文人雅士常用於書齋靜思的香品。",
        "gal_map_text_206200238=這裡面的香方，是宋人讀書時常用的，有靜心凝神之效。你平日伏案工作時，或許可以伴在身旁。",
        "gal_map_text_206200239=謝謝你，如此細心。以後有它相伴，仿佛你就陪在身邊一樣，讓我感到無比安心。",
        "gal_map_text_206200240=將這份滿載心意的禮物仔細收好，心中暖意盎然。",
        "gal_map_text_206200241=博物館周邊街道，夕漸盛，街道兩旁商鋪林立，微風拂過，偶爾有行人路過，氛圍愜意溫馨。",
        "gal_map_text_206200242=兩人走出博物館，陽光透過梧桐葉灑下斑駁躍動的光點。",
        "gal_map_text_206200243=敖靈抬眼看向周邊雅致的店鋪，輕聲提議，你的目光掠過街景，瞥見一家古樸雅致的DIY扇子工坊，眼神微微一亮，順勢接話。",
        "gal_map_text_206200244=這般時光，靜謐安然。若能共同留下一件親手造就的物件，便更完滿了。",
        "gal_map_text_206200245=若能和她一同繪製一把扇子，應當會是很特別的紀念，也能……再多相處片刻。",
        "gal_map_text_206200246=附近有些有意思的小店，要不要隨意走走？",
        "gal_map_text_206200247=好啊，你看那家扇子工坊，似乎可以親手繪製。我們一起去畫一把，當作今日的紀念？",
        "gal_map_text_206200248=好。",
        "gal_map_text_206200249=兩人踏入店內，只見空間敞亮，佈置清雅，各式素扇與筆墨顏料井然陳列。敖靈選了一把白玉骨紙面摺扇，走至長案前，素手研墨，提筆蘸墨，筆尖懸於扇面片刻，方才緩緩落筆。",
        "gal_map_text_206200250=一句“山有木兮木有枝，心悅君兮君不知”隨著清秀筆跡徐徐呈現，字裡行間藏著敖靈未曾言明的心緒。",
        "gal_map_text_206200251=寫罷，敖靈輕輕合攏摺扇，仔細收入手袋之中。我也選了一把摺扇，於另一側專心勾勒著簡約的紋樣。完成後，我轉頭看向敖靈，眼中帶著溫柔的好奇。",
        "gal_map_text_206200252=這份心事，此刻還不想這般直白地道出。便讓這清風與墨蹟，暫替我言說吧。",
        "gal_map_text_206200253=你寫了什麼？看你落筆時，很是專注。",
        "gal_map_text_206200254=秘密。",
        "gal_map_text_206200255=好，那我便等著，等到你願意告訴我的那一天。",
        "gal_map_text_206200256=兩人完成扇子，結帳後走出工坊，並肩行至回家方向的岔路口。在一處樹影婆娑、行人漸稀的轉角，敖靈腳步微頓。",
        "gal_map_text_206200257=周遭安靜，唯有風穿枝葉的細響。敖靈悄悄深吸一口氣，仿佛鼓起了莫大的勇氣，忽而上前一步，輕輕環住了我。",
        "gal_map_text_206200258=與此同時，將一直收在手袋中的那把摺扇，悄無聲息地放入你外套的衣袋內。擁抱的瞬間，她身體略顯僵硬，耳尖泛紅，語氣卻輕柔而篤定。",
        "gal_map_text_206200259=今天的約會，我很喜歡。這個……算是給你的謝禮。",
        "gal_map_text_206200260=我也非常開心。謝謝你的禮物。",
        "gal_map_text_206200261=敖靈迅速退開一步，垂下眼簾不敢看你。",
        "gal_map_text_206200262=我……該去坐車了。再見。",
        "gal_map_text_206200263=好，我送你到車站。",
        "gal_map_text_206200264=我將敖靈送至公交月臺，看著她登上車，尋了靠窗的位置坐下。公車緩緩激活，匯入車流。",
        "gal_map_text_206200265=你立於原地，目送那抹身影隨著車輛漸行漸遠，最終消失在街角。",
        "gal_map_text_206200266=你轉身走向歸途，手不經意間觸及外套口袋，觸到那份微硬的異物。回到家中，你從袋中取出那把被小心收納的摺扇，在窗邊明亮的晨光裡，緩緩展開。",
        "gal_map_text_206200267=扇面上那行清雅的詩句映入眼簾，你怔然片刻，隨即，一抹無可抑制的溫柔笑意自眼底蔓延至嘴角。",
        "gal_map_text_206200268=陽光流淌過紙面，每一個字都清晰如敖靈低語，藏匿著彼此雙向的心意與註定纏繞的知音之緣。",
        "gal_map_text_206200269=原來，你的心意，與我相同。從此往後，漫漫時光，我必珍之重之，做你永恆的知己，與長久的歸處。",
        "gal_map_text_207200000=晨光和煦，路邊綠植蔥郁，空氣裡飄著淡淡的草木香。",
        "gal_map_text_207200001=你剛推開家門，便看見墨茗撐著一把淺色陽傘靜靜地立在樓下。",
        "gal_map_text_207200002=裙裾輕垂，她指尖松松握著傘柄，正抬起清澈的眼眸，帶著幾分好奇打量四周。見你出現，墨茗眸光倏然一亮，像落了星星。",
        "gal_map_text_207200003=（終於等到他啦～今天的約會一定要超級開心！提前一點過來等他，他應該不會覺得我太心急吧……）",
        "gal_map_text_207200004=不是說好直接在博物館門口見嗎？怎麼特意過來了？",
        "gal_map_text_207200005=因為太期待和你一起玩了嘛，想著如果能從這兒就一起走，相處的時光就能多一點呀。",
        "gal_map_text_207200006=你呀…… 等很久了嗎？",
        "gal_map_text_207200007=墨茗低頭看了看腕表。",
        "gal_map_text_207200008=沒有哦，才剛到五分鐘！",
        "gal_map_text_207200009=在這兒等我一下。",
        "gal_map_text_207200010=我轉身折返。",
        "gal_map_text_207200011=給，慢慢變熱了，喝點涼的。",
        "gal_map_text_207200012=謝啦～ 那我們快出發吧！",
        "gal_map_text_207200013=走吧。",
        "gal_map_text_207200014=兩人並肩走在林蔭道下，傘面不知不覺微微傾向墨茗那一側，你的手臂偶爾會輕輕擦過她的肩頭，氣氛在微妙的觸碰中泛起暖意。",
        "gal_map_text_207200015=途中，你狀似隨意地提起幾個展館，當說到機械動力館時，墨茗眼神裡透出些許興趣，輕輕歪了歪頭。",
        "gal_map_text_207200016=提及基礎科學互動館，墨茗的指尖無意識地摩挲著飲料瓶身，嘴角悄悄揚起。",
        "gal_map_text_207200017=而聊到人體生命科學館時，墨茗的臉頰微微發熱，腳步也不自覺地慢了半拍。",
        "gal_map_text_207200018=看墨茗的反應，互動館似乎最讓她心動。不過，還是把選擇藏在輕鬆的試探裡吧，讓她順著自己的心意來。",
        "gal_map_text_207200019=初探機械動力館",
        "gal_map_text_207200020=玩轉科學互動館",
        "gal_map_text_207200021=漫步生命科學館",
        "gal_map_text_207200022=機械動力館裡有很多復古機械裝置，齒輪咬合轉動的樣子有種獨特的精密美感，我們先從那兒開始看起？",
        "gal_map_text_207200023=好呀，齒輪轉動……彼此連攜行動，特別有趣呢。",
        "gal_map_text_207200024=那種機械的美感很特別，你不是很喜好這些，到時候可以解釋給我聽。",
        "gal_map_text_207200025=包在我身上，有我在旁邊講，你就不要怕看不懂啦～",
        "gal_map_text_207200026=科學互動館裡有很多可以親手體驗的項目，比如光影互動、力學平衡挑戰之類的，應該很合你口味。",
        "gal_map_text_207200027=真的嗎？可以自己動手玩？太好啦！我們快去！",
        "gal_map_text_207200028=墨茗瞬間鼓了鼓臉頰，嬌嗔地瞪你一眼。",
        "gal_map_text_207200029=墨茗瞬間鼓了鼓臉頰，嬌嗔地瞪你一眼。",
        "gal_map_text_207200030=才不用你教呢！我肯定能行！……到時候誰幫誰還不一定呢。",
        "gal_map_text_207200031=生命科學館氛圍比較安靜，能看到生命演化的歷程和人體結構的奧秘，適合靜靜逛逛，增長見識，先去那裡走走？",
        "gal_map_text_207200032=嗯……好。就是……那些人體模型會不會特別嚇人？",
        "gal_map_text_207200033=都是科普展示，設計得很溫和，一點也不嚇人。我會一直陪在你旁邊的。",
        "gal_map_text_207200034=我才不怕呢，我什麼恐怖的東西沒有見過，你也太小看我了。",
        "gal_map_text_207200035=兩人一路說說笑笑，很快抵達科技博物館門口。檢票後，你們並肩朝著選定的展館走去，輕鬆愉悅的氛圍裡，悄然纏繞著一絲甜美的曖昧。",
        "gal_map_text_207200036=進入對應展館，開啟第二階段劇情，觸發專屬親密互動事件。",
        "gal_map_text_207200037=展館內光線柔和，各式復古機械裝置錯落陳列，齒輪、連杆靜靜交錯，偶爾傳來低微而規律的運轉聲響，質感沉穩厚重。",
        "gal_map_text_207200038=兩人步入機械動力館，墨茗對眼前的一切都充滿了新奇，左看看右瞧瞧，腳步輕快雀躍。",
        "gal_map_text_207200039=行至一台復古蒸汽機模型前，墨茗駐足凝望，目光被展品旁的操作杆吸引。",
        "gal_map_text_207200040=猶豫片刻，墨茗伸出手輕輕拉動。模型應聲激活，內部齒輪開始飛速旋轉，就在這時，一股模擬蒸汽“噗”的一聲噴出，墨茗驚得輕呼一聲，下意識就朝你身邊靠去，指尖緊緊攥住了你的衣袖。",
        "gal_map_text_207200041=（哎呀！怎麼突然噴氣……嚇我一跳……東西不小但是動靜真大。）",
        "gal_map_text_207200042=別怕，這是模型預設的演示效果，蒸汽是類比的，很安全。",
        "gal_map_text_207200043=這種東西屬於不安全的隱患，在操作流程中是不允許的。",
        "gal_map_text_207200044=你看，拉下操作杆後，齒輪組帶動活塞運動，產生的動力推動機械運轉，你天天擺弄這種東西還會被嚇到嗎？",
        "gal_map_text_207200045=墨茗漸漸放鬆下來，不自覺地又往你身側挪近了一點。",
        "gal_map_text_207200046=我接觸的東西都有最基礎的保護措施，哪像這東西看起來就嚇人。",
        "gal_map_text_207200047=你講解時，手臂很自然地虛攬在她身後，形成一個保護般的姿態，兩人的距離在無形中被拉得更近，甚至能隱約感受到彼此的體溫。",
        "gal_map_text_207200048=墨茗專注地聽著，臉頰浮起淡淡紅暈，眼神裡滿是全然的依賴。",
        "gal_map_text_207200049=細緻拆解原理",
        "gal_map_text_207200050=輕調侃安撫",
        "gal_map_text_207200051=你看，這個大齒輪帶動小齒輪，轉速會提升，這樣活塞往復運動的效率就增加了……",
        "gal_map_text_207200052=但還是缺少一些效率，如果在這個地方加上動能回收裝置的話，還能夠提高更多的效率。",
        "gal_map_text_207200053=你喜歡聽就好，我還怕我說得不專業，以後遇到感興趣的，你都這樣講給我聽。",
        "gal_map_text_207200054=放心，我對這些可熟悉了。",
        "gal_map_text_207200055=剛才還嚇得往我身後躲，現在又湊這麼近仔細看？你不是說自己膽子大嗎，是彈性制的嗎？",
        "gal_map_text_207200056=喂！誰、誰彈性了！我這是好奇！你再笑話我，我……我就和你拼了",
        "gal_map_text_207200057=好好好，我不調侃你了，是我錯了。別生氣了，好不好？",
        "gal_map_text_207200058=哼！這次就算了……下不為例！",
        "gal_map_text_207200059=兩人繼續在展館裡邊走邊看，你時而提問，時而調侃惹得墨茗嬌嗔，氛圍溫馨而有趣，彼此間的距離在不知不覺中又縮短了些許。",
        "gal_map_text_207200060=逛累後前往休息區，開啟第三階段劇情，解鎖關係試探互動。",
        "gal_map_text_207200061=展館內色彩明亮活潑，光影交織變幻，各式互動裝置旁圍著不少遊客，歡笑聲與驚歎聲此起彼伏，氛圍輕鬆而熱鬧。",
        "gal_map_text_207200062=兩人一走進科學互動館，墨茗立刻被一台造型別致的投影儀吸引，小跑過去查看說明。",
        "gal_map_text_207200063=得知操作得當就能投射出自己設計的圖案，墨茗瞬間興致高昂。",
        "gal_map_text_207200064=墨茗反復按動調校按鈕，可投射出的光影總是差強人意，急得臉頰微微泛紅，嘴角也無意識地抿緊了。",
        "gal_map_text_207200065=你見狀走近，從她側後方微微俯身，指尖輕點著面板，陪她一同調試。沒過多久，清晰完美的圖案便如願投射在牆面上。",
        "gal_map_text_207200066=哇！成功了！太好啦！",
        "gal_map_text_207200067=嗯，配合默契。",
        "gal_map_text_207200068=墨茗開心地轉過身，下意識伸出手與你擊掌",
        "gal_map_text_207200069=耶！多虧有你，不然還不知道什麼時候才能成功呢，我們去玩下一個吧！",
        "gal_map_text_207200070=墨茗拉著你來到雙人平衡挑戰區，率先站上平衡板，向你揮手。",
        "gal_map_text_207200071=快來！我們一起挑戰這個！",
        "gal_map_text_207200072=好，都聽你的。",
        "gal_map_text_207200073=工作人員（詢問）：兩位準備好可以開始了嗎？",
        "gal_map_text_207200074=準備好啦！",
        "gal_map_text_207200075=平衡板的固定裝置鬆開，板面開始輕微晃動，墨茗身體一晃，下意識就環住了你的腰尋求穩定。",
        "gal_map_text_207200076=你、你別亂動哦！要是害我掉下去……我可不輕饒你！",
        "gal_map_text_207200077=你們兩人相互借力，慢慢找到了平衡的節奏，最終平穩地完成了挑戰。",
        "gal_map_text_207200078=墨茗輕巧地跳下平衡板，臉上寫滿了小小的得意，仰起臉看向你，眼神裡帶著“快誇我”的炫耀。",
        "gal_map_text_207200079=你看著她這副明明有點後怕卻硬要裝出驕傲的模樣，眼底的笑意更深了。",
        "gal_map_text_207200080=順勢誇她厲害",
        "gal_map_text_207200081=調侃她依賴人",
        "gal_map_text_207200082=真厲害，平衡感很好。多虧你帶得好，我們才能完成得這麼順利。厲害呀，多虧有你，不然還真完不成挑戰。",
        "gal_map_text_207200083=那當然，不過……你也還算配合啦。",
        "gal_map_text_207200084=對對對，你最棒了。接下來想去哪裡？那邊好像有紀念品商店。",
        "gal_map_text_207200085=墨茗眼底閃著欣喜的光，很自然地牽起你的手。",
        "gal_map_text_207200086=那我們快去看看吧！說不定有可愛的小東西～",
        "gal_map_text_207200087=剛才不知道是誰，緊緊抱著我的腰不敢鬆手？現在倒是一副“我最棒”的樣子了。",
        "gal_map_text_207200088=喂！我那是為了保持整體平衡！是策略！ 你、你可別亂講！",
        "gal_map_text_207200089=好好，是策略，是我理解錯了。不生氣了，帶你去紀念品商店看看？",
        "gal_map_text_207200090=墨茗別過臉去，小小地“哼”了一聲，手卻沒有鬆開，反而牽得更緊了些。",
        "gal_map_text_207200091=這還差不多……走吧！",
        "gal_map_text_207200092=兩人牽著手走向紀念品商店，墨茗興致勃勃地打量著四周新奇有趣的陳設，熱鬧歡快的氛圍裡，悄然摻入了一絲只屬於彼此的親昵甜意。",
        "gal_map_text_207200093=展館內光線柔和均勻，氛圍安靜而莊重，人體結構模型與生命演化展板有序陳列，遊客們大多低聲交談，生怕打破了這份寧靜。",
        "gal_map_text_207200094=兩人走進生命科學館，墨茗看著那些精細的人體結構模型，眼神裡交織著好奇與一絲怯意，不自覺地就挨近了你，手指悄悄捏住了你的一片衣角。",
        "gal_map_text_207200095=當走到一具完整的骨骼模型前時，她明顯僵了一下，轉而緊緊握住了你的手，聲音都有些發顫。",
        "gal_map_text_207200096=這個……有點嚇人，我們去看別的吧……",
        "gal_map_text_207200097=好，不看這個了。",
        "gal_map_text_207200098=我牽著她來到生命演化展區的動態螢幕前，指著上面播放的視頻",
        "gal_map_text_207200099=你看這個，生命的演化過程，很神奇。",
        "gal_map_text_207200100=墨茗情緒慢慢平復，被螢幕內容吸引，偶爾發出小小的疑問。",
        "gal_map_text_207200101=這麼一個小小的細胞……真的能慢慢變成我們現在這樣嗎？",
        "gal_map_text_207200102=對啊，生命就是從一個微小的起點開始，經歷漫長而精妙的演化，才成為如今看到的樣子。",
        "gal_map_text_207200103=你察覺到了墨的羞澀與不自在，以為她是對這類內容感到尷尬或是累了，便體貼地帶她來到休息區，遞過一瓶水，示意她坐下休息。",
        "gal_map_text_207200104=墨茗接過水小口喝著，眼神卻時不時悄悄瞟向你，臉上的紅暈還未完全褪去。",
        "gal_map_text_207200105=輕聲轉移話題",
        "gal_map_text_207200106=溫柔詢問狀態",
        "gal_map_text_207200107=休息一下，待會兒我們去那邊的生態展區看看？那邊是關於動植物演化的，內容比較輕鬆。",
        "gal_map_text_207200108=嗯，好。謝謝你呀……一直這麼耐心陪我，還給我講解。",
        "gal_map_text_207200109=跟我不用說謝謝。休息好了我們就慢慢逛過去，不著急。",
        "gal_map_text_207200110=嗯～和你一起，怎麼看都不會膩。",
        "gal_map_text_207200111=是不是逛累了？還是……有哪裡覺得不舒服？",
        "gal_map_text_207200112=沒有，我沒事……就是……剛才那個視頻，讓人有點不好意思啦。你別、別誤會……",
        "gal_map_text_207200113=好，我不誤會。那你安心休息，我在這兒。",
        "gal_map_text_207200114=嗯，我知道。",
        "gal_map_text_207200115=兩人在休息區靜靜地坐了一會兒，墨茗逐漸放鬆下來，眼中的羞澀被更多的依賴與溫柔所取代。",
        "gal_map_text_207200116=展館角落的休息區，光線柔和，幾張座椅整齊擺放，窗外的陽光透過玻璃灑進來，暖意融融，偶有遊客輕聲經過。",
        "gal_map_text_207200117=兩人逛得有些累了，在休息區並肩坐下。",
        "gal_map_text_207200118=你在這裡等我一下，我去買點喝的。有什麼特別不喝的嗎？",
        "gal_map_text_207200119=和你一樣就好。",
        "gal_map_text_207200120=我起身離開，不多時便拿著兩瓶飲料回來，將其中一瓶遞給她。",
        "gal_map_text_207200121=墨茗接過，小口啜飲著。你拿出手機，翻看方才拍攝的展品照片，墨茗好奇地湊近，腦袋不知不覺輕輕倚在了你的肩上。",
        "gal_map_text_207200122=這些照片拍得好清晰呀，剛才那個蒸汽機的金屬質感都拍出來了呢。",
        "gal_map_text_207200123=嗯，覺得你會喜歡，就多留了幾張記錄。",
        "gal_map_text_207200124=這張……你怎麼會有我上次運動會的照片？是跑接力最後衝刺的時候拍下的吧？",
        "gal_map_text_207200125=對，那天看你全力以赴的樣子，特別耀眼，就忍不住存下來了。",
        "gal_map_text_207200126=墨茗聽後，臉頰紅暈更甚，眼中漾開嬌嗔與羞澀交織的波光。",
        "gal_map_text_207200127=墨茗忽然伸手拉住你的胳膊，將你往自己身邊帶了帶，另一隻手舉起手機對準兩人。",
        "gal_map_text_207200128=我看著墨茗難得主動的模樣，眼底漫開一片化不開的溫柔。",
        "gal_map_text_207200129=配合拍合影",
        "gal_map_text_207200130=調侃她較真",
        "gal_map_text_207200131=好，那就拍一張。來，看鏡頭。",
        "gal_map_text_207200132=3、2、1～ 好啦！這下我們扯平了！",
        "gal_map_text_207200133=墨茗開心地擺弄著手機，指尖輕點將照片設為鎖屏壁紙。",
        "gal_map_text_207200134=你看，這張拍得多好！我設成壁紙啦！",
        "gal_map_text_207200135=嗯，很好看。以後每次看手機，都會想起今天。",
        "gal_map_text_207200136=是呀～每次看到，都會想起和你一起度過的這段時光。",
        "gal_map_text_207200137=這麼較真呀？一張照片而已，還要專門拍合影來“扯平”？",
        "gal_map_text_207200138=墨茗瞬間鼓起臉頰，瞪了你一眼，手上卻抓得更緊。",
        "gal_map_text_207200139=這哪裡是較真！這叫公平！你再笑我……我、我真把合影刪掉哦！",
        "gal_map_text_207200140=好好，是我說錯了。這張合影拍得特別好，可千萬別刪。",
        "gal_map_text_207200141=哼～這還差不多。這麼珍貴的合影，我才捨不得刪呢！",
        "gal_map_text_207200142=兩人在休息區靜靜地坐著，墨茗心滿意足地欣賞著手機螢幕，你則溫柔地注視著她，溫馨的氛圍裡流淌著無需言明的心意。",
        "gal_map_text_207200143=展館出口旁的主題禮品店，光線明亮溫馨，各式以科學為靈感的文創產品琳琅滿目，玩偶、配飾、趣味擺件等陳列有序，氛圍熱鬧而充滿生機。",
        "gal_map_text_207200144=兩人走進禮品店，墨茗立刻被各式可愛的小物件吸引，興致勃勃地穿梭其間，拿起這個看看，那個摸摸，眼睛亮晶晶的。",
        "gal_map_text_207200145=你始終跟在她身側，目光溫柔地追隨著她的身影。墨茗拿起一頂帶有俏皮卡通元素的帽子戴在頭上，轉過身，滿含期待地望向你。",
        "gal_map_text_207200146=你看，這個適合我嗎？是不是很可愛？",
        "gal_map_text_207200147=很適合，戴著很亮眼，像個小太陽。",
        "gal_map_text_207200148=墨茗眉眼彎彎，拿起另一頂風格相配的帽子，輕輕戴在你頭上",
        "gal_map_text_207200149=那這頂給你！來來，我們拍幾張～",
        "gal_map_text_207200150=拍得還行嗎？可別把我拍得太傻。",
        "gal_map_text_207200151=放心啦！拍得特別帥！",
        "gal_map_text_207200152=我走到一個造型圓潤可愛的科技館吉祥物玩偶前，輕輕戳了戳它的臉頰。",
        "gal_map_text_207200153=這個玩偶的神態，好像某個時候的你，圓乎乎的，有點呆萌。",
        "gal_map_text_207200154=墨茗一聽，瞬間像被踩了尾巴的小貓，叉腰瞪向你，正要嬌嗔反駁。",
        "gal_map_text_207200155=我去一下洗手間，你在這裡慢慢逛，我很快回來。",
        "gal_map_text_207200156=叮囑她別亂跑",
        "gal_map_text_207200157=調侃她別亂買",
        "gal_map_text_207200158=我很快就回來，你就在這附近等我，別走遠了。",
        "gal_map_text_207200159=知道啦，我就在這兒等你。快點回來哦～",
        "gal_map_text_207200160=等久了嗎？買了什麼好東西？",
        "gal_map_text_207200161=墨茗將袋子往身後藏了藏，聲音帶著小小的神秘。",
        "gal_map_text_207200162=不告訴你，哼哼，是秘密！等會兒你就知道啦。",
        "gal_map_text_207200163=（雖然他說像我……但明明很可愛嘛。買下來送給他，以後他看到這個玩偶，應該就會想起我吧？）",
        "gal_map_text_207200164=墨茗小心翼翼地將裝有玩偶的袋子護在身邊，和你一同走出禮品店，準備離開，眼中閃爍著期待與甜蜜。",
        "gal_map_text_207200165=展館外連接主廊的通道，光線柔和靜謐，牆上點綴著生命科學的藝術海報，此時遊客稀少，微風從半開的窗櫺徐來，平添幾分寧靜與溫柔。",
        "gal_map_text_207200166=短暫休息後，兩人走出展館，沿著通道緩步而行。墨茗主動伸出手，輕輕握住了我的手，指尖在你掌心無意識地摩挲著。",
        "gal_map_text_207200167=我感受著這份依戀，隨即回握，將墨茗的小手穩穩包裹在掌心。兩人就這樣十指相扣，步履一致地慢慢向前。",
        "gal_map_text_207200168=還有別的想逛嗎？再往前走，差不多就到出口了。",
        "gal_map_text_207200169=墨茗仰起臉看你，眼中盛著依賴與一絲羞澀。",
        "gal_map_text_207200170=今天已經逛得很滿足啦，謝謝你一直陪著我。下次……要是換個別的地方，你還願意和我一起嗎？",
        "gal_map_text_207200171=當然願意。只要是你想去的地方，我都樂意奉陪。",
        "gal_map_text_207200172=那就說定啦！這次是你選，下次輪到我！",
        "gal_map_text_207200173=兩人輕聲說笑，墨茗一時沒留意腳下略微不平的地面，被輕輕絆了一下，身體瞬間失去平衡，整個人驚呼著向前撲去，正好落入你張開的懷抱裡。",
        "gal_map_text_207200174=你反應迅速地接住她，雙臂穩穩環住她的腰身。兩人霎時貼得極近，彼此的心跳與呼吸清晰可聞。",
        "gal_map_text_207200175=恰巧一對情侶路過，傳來帶著笑意的低語：“看，那對情侶感情真好。”",
        "gal_map_text_207200176=穩穩抱著她",
        "gal_map_text_207200177=調侃她冒失",
        "gal_map_text_207200178=沒事吧？有沒有崴到腳？",
        "gal_map_text_207200179=墨茗將發燙的臉頰埋在你肩頭，聲音悶悶的。",
        "gal_map_text_207200180=沒、沒事……就是嚇了一跳。還好你接住我了……",
        "gal_map_text_207200181=沒事就好，下次要看清腳下。",
        "gal_map_text_207200182=那……能再這樣待一會兒嗎？就一小會兒……",
        "gal_map_text_207200183=好，你想待多久都行。",
        "gal_map_text_207200184=墨茗安心地依偎著，過了好一會兒，才依依不捨地緩緩退開。",
        "gal_map_text_207200185=走路又不看路，這麼不小心。要不是我在這兒，你可要摔個結實的了。",
        "gal_map_text_207200186=墨茗立刻從你懷裡抬起紅透的臉，羞惱地瞪你，手卻還抓著你的衣服。",
        "gal_map_text_207200187=都怪地不平！你、你不許笑話我！再笑……我就直接躺在地上了。",
        "gal_map_text_207200188=好，不笑你了，先起來好不好？",
        "gal_map_text_207200189=墨茗依然將臉埋著。",
        "gal_map_text_207200190=那你再抱一會兒……不然我還生氣。",
        "gal_map_text_207200191=好，聽你的。",
        "gal_map_text_207200192=墨茗抱了一會，這才滿意地安靜下來，許久才慢慢鬆開。",
        "gal_map_text_207200193=兩人分開後，手卻依然緊緊相牽，繼續向出口走去。墨茗臉頰上的紅霞未褪，眼中柔光瀲灩，空氣中彌漫著心動後的甜蜜與寧靜。",
        "gal_map_text_207200194=博物館出口大廳，光線明亮通透，人流已漸稀疏，空氣中隱約飄散著淡淡的消毒水氣味與窗外滲入的草木清香，氛圍溫馨中縈繞著一絲淡淡的離別意味。",
        "gal_map_text_207200195=兩人自機械動力館走出，緩緩向出口行去。",
        "gal_map_text_207200196=就在即將步出大廳的瞬間，墨茗忽然停下腳步，快走兩步繞到你身前，從隨身的小包裡取出一個精心包裝的盒子，有些羞澀地雙手遞上。",
        "gal_map_text_207200197=墨茗指尖無意識地輕捏著盒子的邊緣，眼中盛滿期待與不易察覺的緊張。",
        "gal_map_text_207200198=等一下！這個……送給你。是特意為你準備的禮物。今天和你一起逛，我特別開心，希望……希望你會喜歡。",
        "gal_map_text_207200199=我停下腳步，接過那只尚帶著她掌心溫度的盒子。",
        "gal_map_text_207200200=謝謝你還為我費心準備禮物，我很感動。",
        "gal_map_text_207200201=你打開看看嘛～是我挑選了好久才選中的，感覺……特別適合你。",
        "gal_map_text_207200202=我依言輕輕打開盒蓋，看清盒中之物時，眼中掠過清晰的驚喜與溫柔，指尖下意識地拂過信物細膩的紋路。",
        "gal_map_text_207200203=墨茗屏息凝神地注視著你的每一個表情變化，嘴角不自覺地微微抿緊，生怕錯過你任何一絲不喜歡的跡象。",
        "gal_map_text_207200204=我凝視著盒內靜靜躺著的黃銅船鐘，聲音裡帶著驚喜",
        "gal_map_text_207200205=這只船鐘真精緻，復古的黃銅質感，搭配深色的內襯，顯得格外有韻味。 我非常喜歡。",
        "gal_map_text_207200206=真的嗎？太好了！我覺得它的氣質和機械館很搭，也特別像你。船鐘寓意著陪伴與指引，以後讓它陪著你，就像……就像我也在一樣。",
        "gal_map_text_207200207=嗯，我會好好珍惜它，時時帶在身邊。如同你一直在我身邊。",
        "gal_map_text_207200208=你喜歡就好～以後不管你走到哪裡，看到這只船鐘，可要記得想起我哦。",
        "gal_map_text_207200209=一定。無論我去哪裡，都會想著你，然後邀請你再出來。",
        "gal_map_text_207200210=我展開盒內的藍曬工藝長卷畫。",
        "gal_map_text_207200211=這幅畫的色調和工藝很特別，復古的藍白之間，勾勒出的機械圖案也很精巧。謝謝你。",
        "gal_map_text_207200212=我就猜你會喜歡～這是我特意尋來的，上面的圖案都取自機械館的展品。看到它，就能回憶起今天我們一同在這裡度過的時光了。",
        "gal_map_text_207200213=我會好好珍藏這幅畫，永遠記得今天這份美好的記憶。",
        "gal_map_text_207200214=喜歡就好～ 要是你敢忘記今天的時光，忘記我，我就把這張畫收回來！",
        "gal_map_text_207200215=好，我不敢忘記。以後我會經常陪你，創造更多美好的回憶。",
        "gal_map_text_207200216=博物館出口旁的露天平臺，光線明媚，微風輕拂，平臺上不少遊客正在拍照留念，不遠處自助照片印表機旁聚著三兩人群，氛圍熱鬧而溫馨。",
        "gal_map_text_207200217=兩人走出博物館，來到陽光灑落的平臺邊。",
        "gal_map_text_207200218=墨茗忽然駐足並且叫住你，然後從一直提在身側的禮品袋中，取出那個包裝好的盒子遞到你面前，眼中閃爍著小鹿般的期待與羞澀。",
        "gal_map_text_207200219=盒中正是她先前在禮品店悄悄買下的科技館吉祥物玩偶，而玩偶的手中，還靜靜地托著另一份心意。",
        "gal_map_text_207200220=等等！這個給你～這就是剛才我說的“秘密”哦！快打開看看！",
        "gal_map_text_207200221=我接過盒子，輕輕揭開盒蓋，看到裡面的玩偶，眼神一亮。",
        "gal_map_text_207200222=原來是它。",
        "gal_map_text_207200223=墨茗緊張地觀察著你的反應。",
        "gal_map_text_207200224=怎麼樣？喜歡嗎？這是科技館的吉祥物，我覺得它特別可愛，就想著……送給你。",
        "gal_map_text_207200225=你拿起那只圓潤可愛的玩偶，隨即發現了被巧妙安置在玩偶手中的另一件小物。",
        "gal_map_text_207200226=你眼中驚喜更濃，指尖輕輕拈起那枚信物，放在陽光下仔細端詳。墨茗的心跳隨著你的動作微微加快，手指無意識地絞著衣角，唇瓣輕抿。",
        "gal_map_text_207200227=這砝碼的設計真別致，兩枚並置，封裝得也很用心。我很喜歡。",
        "gal_map_text_207200228=太好了！我覺得它和互動館裡那些平衡裝置很配呢。砝碼象徵著精准與平衡，就像……嗯，就像我們之間那種默契的感覺。",
        "gal_map_text_207200229=希望你每次看到它和這個小傢伙，都能想起今天。",
        "gal_map_text_207200230=我會好好收著它們，每次看見，都會想起今天與你共度的、充滿笑聲的時光。",
        "gal_map_text_207200231=你喜歡就好～這個玩偶，就當作我的替身吧。以後要是想我了，就多看看它們怎麼樣？",
        "gal_map_text_207200232=好。不僅如此，我還會經常來找你，不讓你有太多時間想念。",
        "gal_map_text_207200233=這個永動球擺件很有意思，蘊含著簡單的力學原理， 很有科學趣味，我很喜歡。",
        "gal_map_text_207200234=我就知道你會欣賞～它象徵著永恆的動力與迴圈，就像我們今天收穫的快樂，希望它能一直延續下去。",
        "gal_map_text_207200235=看到它，就能想起我們一起體驗那些互動項目時的開心吧。",
        "gal_map_text_207200236=我會把它放在常能看到的地方，讓它提醒我，永遠記得今天的快樂，和帶來這份快樂的你。",
        "gal_map_text_207200237=喜歡就好，不過！要是你敢把它們冷落在角落，忘記今天，我可不會輕易原諒你哦！",
        "gal_map_text_207200238=不敢。我會把它們放在書桌最顯眼的位置，每日相見，就像看到你一樣。",
        "gal_map_text_207200239=兩人相視而笑，眼波流轉間盡是化不開的溫柔與默契，玩偶與信物靜靜地成為今日甜蜜的見證。",
        "gal_map_text_207200240=博物館出口處的露天平臺，陽光和煦，灑在身上暖洋洋的，平臺四周綠意點綴，空氣清新。遊客們或拍照或休憩，氛圍悠閒愜意。",
        "gal_map_text_207200241=兩人漫步至露天平臺。墨茗望著周遭拍照留念的人們，眼中掠過一絲羡慕，卻並未立刻開口，只是靜靜地站在你身側，手指悄悄收攏，更緊地握住了你的手。",
        "gal_map_text_207200242=片刻，她仿佛終於鼓足勇氣，從包裡拿出一個系著細絲帶的盒子，帶著羞澀遞到你面前，眸光瀲灩，滿是期待。",
        "gal_map_text_207200243=這個送給你，是為今天準備的禮物。謝謝你陪我逛生命科學館，一直耐心地講解，也謝謝你的保護。 我真的很開心。",
        "gal_map_text_207200244=我接過那只精巧的盒子。",
        "gal_map_text_207200245=謝謝你，收到你的禮物，我同樣非常開心。",
        "gal_map_text_207200246=打開看看吧，是我覺得，最能代表今天心情的禮物。",
        "gal_map_text_207200247=你輕輕解開絲帶，打開盒蓋。看清內裡信物的刹那，你眼中清晰地映出驚喜與動容，指尖小心翼翼地將其取出，細細端詳。",
        "gal_map_text_207200248=墨茗一眨不眨地望著你，唇瓣不自覺地抿起，眼底的期待幾乎要滿溢出來。",
        "gal_map_text_207200249=這個模型真可愛，設計得既有趣又充滿關懷的意味，和今天的主題很契合，我非常喜歡。",
        "gal_map_text_207200250=太好了！我覺得它象徵著守護與健康。希望你以後一直都能健健康康、平平安安的。 有它陪著你，就像有我的一份祝福在身邊。",
        "gal_map_text_207200251=我會好好珍藏這份祝福，也會好好照顧自己，不讓你擔心。有你在身邊，本身就是我最安心的力量。",
        "gal_map_text_207200252=你喜歡就好～以後無論你去往何方，看到這個小機器人，可要記得，有個人在默默祝福著你哦。",
        "gal_map_text_207200253=嗯，我會記得。以後的路，我也想更多地陪在你身邊，帶你看遍你想看的風景，守護你的每一抹笑容。",
        "gal_map_text_207200254=這個掛飾很別致，Q版造型讓它顯得可愛又特別。謝謝你的心意。",
        "gal_map_text_207200255=我就知道你會懂，它代表著生機與希望，就像我們在生命科學館感受到的，生命那種堅韌又美好的力量。",
        "gal_map_text_207200256=希望每次看到它，你都能想起今天，想起這份充滿希望的心情。",
        "gal_map_text_207200257=我會的，它不僅是一件紀念品，更是今天所有美好與心意的縮影，我會永遠記得。",
        "gal_map_text_207200258=墨茗故作嚴肅地板起小臉，卻掩不住嘴角笑意。",
        "gal_map_text_207200259=喜歡就好，不過嘛，要是你敢把今天的回憶、把我的這份心意給弄丟了，我可是要收回它的！",
        "gal_map_text_207200260=我向你保證，絕不會弄丟。你與今日的一切，都將是我最珍貴的收藏。",
        "gal_map_text_207200261=兩人並肩立於融融日光之下，微風拂過發梢，彼此眼中倒映著對方溫柔的笑靨，心意借由小小的信物深深聯結。",
        "gal_map_text_207200262=博物館出口的露天平臺，陽光正好，光線澄澈，平臺周圍綠植蔥郁，風過處，枝葉沙沙作響，隱約傳來遊客的歡聲笑語，空氣裡彌漫著暖意與一絲淡淡的離別氛圍。",
        "gal_map_text_207200263=不遠處的自助照片印表機指示燈靜靜閃爍，等待著定格此刻的溫柔。",
        "gal_map_text_207200264=墨茗望著平臺上拍照留念的人們，忍不住輕輕拉了拉你的衣袖，眼中盛滿明晃晃的期待。",
        "gal_map_text_207200265=你會意一笑，拿出手機，選好角度準備拍攝。墨茗湊過去看了看預覽，皺了皺鼻子，嬌聲要求重拍。",
        "gal_map_text_207200266=她在平臺上輕盈地變換著姿勢，笑容燦爛，仿佛自帶光芒。",
        "gal_map_text_207200267=忽然，一陣稍大的風卷過，你轉身遮擋卷起的砂礫，手機“啪嗒”一聲輕響落在地上，螢幕亮起，恰好定格在一張墨茗自然轉身的側影上。",
        "gal_map_text_207200268=墨茗快步靠近，雙手輕輕捧住你的臉。",
        "gal_map_text_207200269=沒事吧？眼睛是不是進沙子了？我幫你吹吹。",
        "gal_map_text_207200270=嗯，有一點，吹一下應該就都出來了。",
        "gal_map_text_207200271=墨茗輕輕柔柔地吹了幾口氣，你眨了眨眼，緩緩睜開，俯身撿起手機。",
        "gal_map_text_207200272=你看這風沙還幫了個忙，這張抓拍的，倒很好看。",
        "gal_map_text_207200273=嗯……是挺自然的，就這張吧",
        "gal_map_text_207200274=好，我去把照片列印出來。你在這裡等我，別走開。",
        "gal_map_text_207200275=嗯，我就在這兒等你，小心點。",
        "gal_map_text_207200276=你拿著手機走向自助印表機，熟練地將照片上傳，靜靜等待輸出。",
        "gal_map_text_207200277=即便是夕陽也依舊灼熱，你瞥見墨茗光潔的額角滲出了細密的汗珠，便開口。",
        "gal_map_text_207200278=照片快打好了，你在這兒等一下，我去旁邊便利店給你買瓶冰飲。",
        "gal_map_text_207200279=墨茗乖乖應下。你轉身快步離開。沒多久，印表機“哢嗒”一聲吐出了照片，墨茗上前取過，指尖溫柔地撫過照片上自己的笑顏。",
        "gal_map_text_207200280=趁你還沒回來，她從包裡取出一支精緻的記號筆，在照片背面小心翼翼地寫下：“我有一個小秘密，藏在眉眼間，繞在舌尖上，只對你一人洩露，是什麼？”",
        "gal_map_text_207200281=又在字跡旁畫了一個圓潤可愛的Q版自畫像，筆觸俏皮。",
        "gal_map_text_207200282=她捧著照片，嘴角不自覺地漾開溫柔的笑意。正出神時，臉頰忽然被一個冰涼的東西輕輕貼了一下，驚得她輕呼一聲，猛地回頭。",
        "gal_map_text_207200283=討厭！冰死啦！",
        "gal_map_text_207200284=墨茗說著，她伸手接過你遞來的飲料，卻趁你不備將自己那瓶冰飲也貼向你的臉頰，並且得意地笑出聲。",
        "gal_map_text_207200285=這下扯平啦！",
        "gal_map_text_207200286=好了，不鬧你了，快喝點涼的解解暑。",
        "gal_map_text_207200287=兩人並肩行至回家的岔路口，路旁樹影搖曳，空氣中彌漫著約會將盡的眷戀。墨茗從手中的照片裡，抽出那張寫了字的照片，遞到你面前。",
        "gal_map_text_207200288=這個……是今天約會的紀念，給你。",
        "gal_map_text_207200289=這張照片裡的你，特別好看。",
        "gal_map_text_207200290=那當然，我什麼時候不好看過，我可是怎麼拍都好看？",
        "gal_map_text_207200291=照片背面有驚喜……如果你猜到了答案，要告訴我哦。",
        "gal_map_text_207200292=好。",
        "gal_map_text_207200293=墨茗立刻撲進你懷裡，雙手環住你的腰，將發燙的臉頰埋在你肩頭，隨後微微踮腳，湊近你耳邊，輕聲呢喃。",
        "gal_map_text_207200294=照片裡有驚喜，如果你知道答案後，請告訴我。",
        "gal_map_text_207200295=說完，她用嘴唇輕輕碰了碰你的耳垂，隨即像受驚的小鹿般迅速退開，向後小跑了兩步，轉身朝著家的方向跑去，一邊跑一邊回頭用力揮手。",
        "gal_map_text_207200296=拜拜！",
        "gal_map_text_207200297=我站在原地，低頭看向手中的照片，好奇地尋找她所說的“驚喜”。",
        "gal_map_text_207200298=將照片翻轉，背面的娟秀字跡與俏皮畫像映入眼簾，你的目光霎時柔軟。",
        "gal_map_text_207200299=你凝視著那句謎語，沉思片刻，心中已然有了清晰的答案。你拿出手機，解鎖，點開與墨茗的聊天視窗，指尖懸在輸入框上良久，最終卻只是緩緩按熄了螢幕，將手機收回口袋。",
        "gal_map_text_207200300=你握緊手中的照片，心想，這個關於“秘密”的答案，或許暫時藏在彼此心照不宣的默契裡，會更加浪漫。",
        "gal_map_text_202200000=暑假的校園正門，香樟樹投下清涼綠蔭，蟬鳴聲時隱時現，陽光透過葉隙灑落光斑，靜謐中縈繞著夏日獨有的慵懶與微燥。",
        "gal_map_text_202200001=我準時抵達校門口，看了眼手錶，距離約定時間還有五分鐘，便靜靜站在樹蔭下等候。",
        "gal_map_text_202200002=不多時，遠處一個熟悉的身影匆匆跑來——是阿米菈，手裡還攥著半袋沒吃完的麵包，略顯慌忙的模樣卻依然透著往日的靈動。",
        "gal_map_text_202200003=還是老樣子，又睡過頭了？",
        "gal_map_text_202200004=阿米菈趕緊咽下口中的麵包，眨了眨眼，俏皮地辯解。",
        "gal_map_text_202200005=才不是呢！是路上碰到點小狀況，耽誤了一下～看你來得這麼早，肯定沒吃早餐吧，這半塊分給你吧。",
        "gal_map_text_202200006=我自然地接過她遞來的麵包，就著阿米菈咬過的地方直接下嘴",
        "gal_map_text_202200007=你怎麼知道我餓了，等會兒我們先去把東西拿好，想好去哪了嗎？",
        "gal_map_text_202200008=都聽你的，你來決定就好，我跟著你～",
        "gal_map_text_202200009=你們兩人先到儲物櫃存好東西，隨後並肩走在安靜的校園林蔭道上。",
        "gal_map_text_202200010=我刻意放慢腳步，不著痕跡地試探她的偏好——當提起圖書館時，阿米菈的指尖無意識地輕輕撚著書包帶子。",
        "gal_map_text_202200011=說到音樂室，她腳步微微一頓，眼底似有星光亮起。",
        "gal_map_text_202200012=而聊到美術室時，她不自覺地朝你靠近了半步，手指悄悄捏住了你襯衫的一角。",
        "gal_map_text_202200013=正好圖書館、音樂室還有美術室暑假都開放著，你想去哪個？",
        "gal_map_text_202200014=我覺得都可以，還是你來選吧畢竟我叫你來學校陪我的。",
        "gal_map_text_202200015=赴圖書館靜讀",
        "gal_map_text_202200016=探音樂室彈琴",
        "gal_map_text_202200017=進美術室作畫",
        "gal_map_text_202200018=那去圖書館吧，那裡安靜，也涼爽，可以看看書。",
        "gal_map_text_202200019=阿米菈眼底掠過一絲如願的欣喜，唇角彎起溫柔的弧度。",
        "gal_map_text_202200020=好呀，正好想找本書看看提升一下，有你在旁邊就更好了。",
        "gal_map_text_202200021=聽說圖書館最近新進了一批書，不過熱門的總被借得快。",
        "gal_map_text_202200022=那這次我們算早的，說不定能搶到呢，要是沒有借到的話，我就陪你看你喜好的題材。",
        "gal_map_text_202200023=要不去音樂室？很久沒碰琴了，今天想重溫一下。",
        "gal_map_text_202200024=真的嗎？我還從來沒聽過你彈琴呢！今天終於能聽到了～",
        "gal_map_text_202200025=真的很久沒練了，可能彈得不好，到時候別笑我。",
        "gal_map_text_202200026=怎麼會！能聽你彈琴我就很開心了。就算生疏也沒關係，我覺得一定很好聽。",
        "gal_map_text_202200027=那去美術室吧，突然有點想動筆畫點東西。",
        "gal_map_text_202200028=太好啦！我早就想看你畫畫時的樣子了，說不定我還能給你當模特呢。",
        "gal_map_text_202200029=當模特可不容易，要一直保持一個姿勢，會很累的。",
        "gal_map_text_202200030=阿米菈挺直背脊，一副“包在我身上”的模樣。",
        "gal_map_text_202200031=放心吧！我耐力可好了。而且能當你的第一個模特，這多特別呀。",
        "gal_map_text_202200032=兩人拿著各自的物品，並肩朝著選定的方向走去，夏日微風中，彌漫著淡淡青澀又甜蜜的氣息。",
        "gal_map_text_202200033=圖書館內靜謐無聲，陽光透過百葉窗灑在成排的書架上，空氣中只有書頁翻動的輕響與彼此清淺的呼吸聲。",
        "gal_map_text_202200034=你們兩人一同走進涼爽安靜的圖書館，你邊走邊低聲向阿米菈介紹著最近的新書，兩人在書架間慢慢穿梭，各自尋覓。",
        "gal_map_text_202200035=就在你們不約而同地將手伸向同一層書架時，指尖幾乎相觸，目光也透過書冊的間隙悄然相遇，兩人都微微一怔，隨即不約而同地泛起一絲赧然。",
        "gal_map_text_202200036=你……找到想看的了嗎？選好了的話，我們去靠窗的位置？",
        "gal_map_text_202200037=找到了，我們坐那邊吧，光線很舒服。",
        "gal_map_text_202200038=好，小心腳下，書架間的過道有點窄。",
        "gal_map_text_202200039=知道啦～",
        "gal_map_text_202200040=你們兩人在靠窗的桌旁並肩坐下，時間在字裡行間悄然流淌，過了許久，你轉頭看向阿米菈，發現她不知何時已闔上眼簾。",
        "gal_map_text_202200041=阿米菈頭微微側向一旁，枕著自己的手臂睡著了，纖長的睫毛在眼下投出淺淺的陰影，模樣沉靜可愛。",
        "gal_map_text_202200042=我猶豫片刻，還是動作極輕地脫下自己的薄外套，小心翼翼地披在她肩上。",
        "gal_map_text_202200043=靜靜守護不打擾",
        "gal_map_text_202200044=輕輕叫醒她休息",
        "gal_map_text_202200045=睡吧，我在這兒。",
        "gal_map_text_202200046=阿米菈在睡夢中仿佛有所感應，無意識地輕輕攏了攏肩上的外套，唇邊溢出模糊的囈語。",
        "gal_map_text_202200047=……謝謝……",
        "gal_map_text_202200048=沒有，你要是還覺得困就再休息一會兒，我幫你看著書。",
        "gal_map_text_202200049=嗯，那我就再偷懶一小會兒哦，你千萬別走遠哦。",
        "gal_map_text_202200050=醒醒，這樣睡，等下該脖子疼了。",
        "gal_map_text_202200051=阿米菈睫毛顫了顫，緩緩睜開惺忪的睡眼，看到肩頭的外套先是茫然，隨即臉紅。",
        "gal_map_text_202200052=我、我怎麼睡著了，是不是耽誤你看書了？",
        "gal_map_text_202200053=沒有耽誤，只是怕你著涼，要是還累的話可以靠著椅背閉目養神一會兒。",
        "gal_map_text_202200054=有你在身邊，不知道為什麼睡得特別安心。",
        "gal_map_text_202200055=阿米菈小憩片刻後醒來，兩人繼續安靜地看書，偶爾就書中的內容低聲交換幾句看法，一種無聲的默契與溫柔在空氣中靜靜流淌。",
        "gal_map_text_202200056=音樂室內光線柔和，一架黑色的三角鋼琴靜靜地立於角落，空氣中縈繞著淡淡的松木與舊紙張的氣息，靜謐而富有藝術感。",
        "gal_map_text_202200057=你們推門而入，在鋼琴前駐足片刻，隨後掀開琴蓋坐了下來。",
        "gal_map_text_202200058=修長的手指輕輕落在琴鍵上，一段舒緩而熟悉的旋律便流瀉而出，在空曠的室內悠悠回蕩。",
        "gal_map_text_202200059=你的聽眾倚在門邊安靜聆聽，直到最後一個音符消散，才忍不住輕輕鼓掌。",
        "gal_map_text_202200060=你彈得也太棒了！我從來不知道你鋼琴彈得這麼好！",
        "gal_map_text_202200061=只是小時候學過幾年，很久沒練，都生疏了。",
        "gal_map_text_202200062=一點也聽不出來！真的超級好聽，那個，你能教我嗎？我一直覺得會彈鋼琴的人特別厲害。",
        "gal_map_text_202200063=當然可以，來吧，我先教你最簡單的指法。",
        "gal_map_text_202200064=你示意阿米菈坐到自己身邊的琴凳上，執起她的右手，輕輕將她的指尖擺放在中央C的位置。",
        "gal_map_text_202200065=阿米菈的指尖因緊張而微微顫抖，臉頰也染上緋紅，手背上傳來我掌心的溫度，讓她的心跳漏了一拍。",
        "gal_map_text_202200066=耐心細緻教導",
        "gal_map_text_202200067=調侃式輕鬆教學",
        "gal_map_text_202200068=放鬆，手腕不要太用力，然後像這樣輕輕地按下去就好。",
        "gal_map_text_202200069=我來試試看，有你這麼仔細地教我，我感覺我一定能學會。",
        "gal_map_text_202200070=對，就是這樣。慢慢來，不著急。",
        "gal_map_text_202200071=阿米菈成功按出一個清晰的音符，欣喜地抬頭看我。",
        "gal_map_text_202200072=那要是以後我想學琴的時候，還能來找你當老師嗎？",
        "gal_map_text_202200073=原來你也有這麼緊張的時候啊，你看你這個手指都繃成小木棍了。",
        "gal_map_text_202200074=喂！我是初學者嘛！你再笑我，我、我真不學了哦！",
        "gal_map_text_202200075=好，不笑了。我們認真學，保證不敷衍。",
        "gal_map_text_202200076=這還差不多～那就請老師，請多指教！",
        "gal_map_text_202200077=在你耐心的指導下，阿米菈漸漸放鬆下來，簡單的音符開始在琴鍵上跳躍。",
        "gal_map_text_202200078=兩人並肩坐在琴凳上，身體挨得很近，空氣中彌漫著音符與心動的氣息。",
        "gal_map_text_202200079=美術室內擺滿了畫架、石膏像與靜物，空氣中混合著顏料、松節油與畫紙的獨特氣味。陽光傾灑進來，照亮空氣中飛舞的微塵，溫暖而寧靜。",
        "gal_map_text_202200080=進入美術室，阿米菈被裡面陳列的學生畫作吸引，輕輕拉住了我的衣袖。",
        "gal_map_text_202200081=阿米菈轉過身，用一雙寫滿期待的眼睛望向你，小聲提出了想讓你為自己畫一幅畫的請求。",
        "gal_map_text_202200082=你答應後，阿米菈立刻興奮地掏出手機翻找參考，選定一個姿勢後，便端坐在窗邊的椅子上，努力擺出優雅的樣子。",
        "gal_map_text_202200083=不用這麼刻意挺直的，時間久了你會很累。",
        "gal_map_text_202200084=那、那怎麼樣才好，我就是想讓你畫得順手一點……",
        "gal_map_text_202200085=放輕鬆就好，最自然的狀態就是最美的，我來幫你調整一下。",
        "gal_map_text_202200086=得到阿米菈羞澀的同意後，我伸出手輕柔地扶正她的肩膀，又將她的手臂擺放到更舒適自然的位置。",
        "gal_map_text_202200087=偶爾不經意地擦過她頸側或手腕的皮膚，帶來微涼的觸感，讓兩人都有一瞬的凝滯。",
        "gal_map_text_202200088=阿米菈的臉頰迅速漫上紅暈，卻沒有閃躲，反而在你的引導下更加鬆弛下來。",
        "gal_map_text_202200089=調整完畢，我退後一步準備作畫，這才後知後覺地意識到自己方才的舉動或許有些逾越。",
        "gal_map_text_202200090=溫柔道歉並誇讚",
        "gal_map_text_202200091=自然開口開啟作畫",
        "gal_map_text_202200092=抱歉，剛才沒先問你就動手調整。不過現在這個姿態，真的很適合入畫，很好看。",
        "gal_map_text_202200093=阿米菈臉上的紅暈更深，連忙搖頭。",
        "gal_map_text_202200094=沒關係的……你覺得好看，我就放心了。",
        "gal_map_text_202200095=那我開始了，你要是覺得累了就隨時告訴我，我們可以休息。",
        "gal_map_text_202200096=能被你畫下來，再累一點也值得。",
        "gal_map_text_202200097=我專注於勾勒線條與色彩，阿米菈則盡力維持著姿勢，目光卻總是不由自主地飄向認真作畫的你。",
        "gal_map_text_202200098=寂靜的畫室裡，只有畫筆的沙沙聲與彼此交織的視線，曖昧與溫馨無聲滋長。",
        "gal_map_text_202200099=好了，這樣很自然，也很美。保持住，我要開始畫了。",
        "gal_map_text_202200100=嗯，我會堅持住的，你慢慢畫，不用急。",
        "gal_map_text_202200101=你的眼睛很美，裡面好像有光，我會盡力把它畫出來。",
        "gal_map_text_202200102=真的嗎？那……請務必把我畫得好看一點呀，這可是第一幅呢。",
        "gal_map_text_202200103=我專注於勾勒線條與色彩，阿米菈則盡力維持著姿勢，目光卻總是不由自主地飄向認真作畫的你。",
        "gal_map_text_202200104=寂靜的畫室裡，只有畫筆的沙沙聲與彼此交織的視線，曖昧與溫馨無聲滋長。",
        "gal_map_text_202200105=圖書館內依舊靜謐，午後的陽光逐漸西斜，透過窗戶灑在兩人身上，給彼此鍍上一層暖橙色的光暈。",
        "gal_map_text_202200106=過了一會兒，她將身上披著的外套攏緊了些，頭輕輕埋進衣領間，仿佛在感受那上面殘留的、令人安心的氣息。",
        "gal_map_text_202200107=隨後，她悄悄往你這邊挪近了一點，將頭輕輕靠在了你肩上，聲音帶著剛醒的微啞。",
        "gal_map_text_202200108=我睡了很久嗎？是不是……耽誤你太多時間了？",
        "gal_map_text_202200109=不久。而且，等你醒來，不算是耽誤。",
        "gal_map_text_202200110=現在幾點了呀？",
        "gal_map_text_202200111=時間還很早，是還沒休息夠，可以再閉會兒眼。",
        "gal_map_text_202200112=阿米菈搖了搖頭，從口袋裡掏出手機和耳機。",
        "gal_map_text_202200113=不用啦，不過光看書好像更容易犯困……我們聽聽歌吧？這樣也許能精神點。",
        "gal_map_text_202200114=我接過她遞來的一邊耳機戴上，耳邊立刻流淌起一首舒緩的鋼琴曲。",
        "gal_map_text_202200115=正想開口問她是否偏愛這類音樂，卻感覺肩頭的重量微微下沉——她不知何時又闔上了眼睛，呼吸變得均勻綿長。",
        "gal_map_text_202200116=見狀，我無奈又寵溺地笑了笑，悄悄拿出手機調整角度，拍下了兩人依偎著的側影。",
        "gal_map_text_202200117=隨後小心翼翼地調整了一下坐姿，讓她靠得更安穩些。",
        "gal_map_text_202200118=靜靜陪伴至她睡醒",
        "gal_map_text_202200119=輕輕叫醒她準備離開",
        "gal_map_text_202200120=睡吧，我會一直在這裡。等你自然醒。",
        "gal_map_text_202200121=阿米菈在睡夢中無意識地蹭了蹭我的肩膀，唇角微彎。",
        "gal_map_text_202200122=嗯……很安心……",
        "gal_map_text_202200123=沒關係，看你睡得香，我也覺得平靜。不急，我們慢慢來。",
        "gal_map_text_202200124=你真好……那如果以後我還有不小心睡著的時候，你還會這樣陪我嗎？",
        "gal_map_text_202200125=當然會等著你，不管你睡多久都會等你。",
        "gal_map_text_202200126=兩人開始輕聲收拾書本，阿米菈始終將那件外套抱在胸前，眼中流轉著溫柔與隱約的期待。",
        "gal_map_text_202200127=阿米菈，該醒醒啦，我們差不多該走了。",
        "gal_map_text_202200128=阿米菈睫毛顫動幾下，緩緩睜開眼，眼神還有些迷蒙。",
        "gal_map_text_202200129=啊……我怎麼又睡著了……讓你一直不能動，對不起……",
        "gal_map_text_202200130=沒事，別道歉。我們收拾一下，準備回去吧。",
        "gal_map_text_202200131=阿米菈點點頭，將外套仔細疊好，卻沒有立刻還給你，而是抱在懷裡。",
        "gal_map_text_202200132=這個……我先幫你保管吧？這樣……下次見面，我才有理由還給你呀。",
        "gal_map_text_202200133=兩人開始輕聲收拾書本，阿米菈始終將那件外套抱在胸前，眼中流轉著溫柔與隱約的期待。",
        "gal_map_text_202200134=音樂室內，午後的陽光斜照在光潔的鋼琴漆面上，空氣裡仿佛還殘留著方才的音符，氛圍溫馨而寧靜。",
        "gal_map_text_202200135=在我的耐心指導下，阿米菈逐漸掌握了基礎指法。",
        "gal_map_text_202200136=我適時提議嘗試簡單的四手聯彈，導致她既緊張又期待，生怕自己出錯破壞氛圍，但更不願錯過與你共同完成一曲的機會，於是用力點了點頭。",
        "gal_map_text_202200137=你們兩人重新在琴凳上坐好，指尖一同落向琴鍵。起初她難免失誤，在你溫和的鼓勵與帶領下，幾次嘗試後。",
        "gal_map_text_202200138=一段雖然簡單卻完整和諧的旋律終於從你們的指尖流淌而出。",
        "gal_map_text_202200139=阿米菈彈完最後一個音符，興奮地轉過身與我擊掌。",
        "gal_map_text_202200140=我們做到了！配合得真好！",
        "gal_map_text_202200141=是你學得快，而且樂感很好，要不要再來一遍？這次，我們可以錄下來留個紀念。",
        "gal_map_text_202200142=好呀好呀！一定要錄！這可是我們第一次合作的“作品”呢！",
        "gal_map_text_202200143=好，那我們準備一下，這次爭取一次成功！",
        "gal_map_text_202200144=兩人調整好姿勢，在手機鏡頭的記錄下，再次專注地演繹剛才的旋律。",
        "gal_map_text_202200145=這一次更加流暢，音符如溪流般自然而動聽。",
        "gal_map_text_202200146=兩個人都沉浸在合作的愉悅中，偶爾抬眸，視線相撞，彼此眼中都映著笑意與一絲別樣的溫柔，錄製完成。",
        "gal_map_text_202200147=我要把這首曲子設成鈴聲，以後每次電話響起，都會想起今天，和我並肩坐在鋼琴前的時光吧。",
        "gal_map_text_202200148=準備離開時，鋼琴下掉落一本舊琴譜。彎腰拾起，封面上《secret》的曲名讓我目光微頓。",
        "gal_map_text_202200149=我打開《secret》曲譜介紹上面寫著跟隨著音符踏上旅程，第一眼就決定了緣分，當旅途走到了末路時，回路藏在急速音律裡。",
        "gal_map_text_202200150=詢問琴譜由來",
        "gal_map_text_202200151=直接準備離開",
        "gal_map_text_202200152=《secret》......你看這個琴譜有些年頭了，上面寫的內容讓我有點興趣。",
        "gal_map_text_202200153=是嗎？讓我看看，第一眼就決定了緣分是有什麼特別的意思嗎？",
        "gal_map_text_202200154=要不嘗試一下，感覺像是一首很有趣的曲子。",
        "gal_map_text_202200155=那就試一試吧！",
        "gal_map_text_202200156=我剛開始彈奏，周圍的事物和時間會倒退一樣，阿米菈還在沉浸在琴聲中，再次反應過來發現剛剛已經收好的手機放在錄製的位置。",
        "gal_map_text_202200157=阿米菈收回手機，突然覺得不對勁，連忙湊到我身邊讓我快點離開音樂教，我將琴譜放回鋼琴下和阿米菈一起走出音樂室。",
        "gal_map_text_202200158=剛剛發生奇怪的事情，我明明將手機放到包裡，就你在剛剛彈琴的時候。手機從我包裡有放在錄製的地方了。",
        "gal_map_text_202200159=你是不是又丟三落四了，怎麼可能會出現這種事情。",
        "gal_map_text_202200160=咦，剛剛錄製的視頻還在，難道是我剛剛忘記收回手機了嗎？抱歉，剛剛的舉動嚇到你了。",
        "gal_map_text_202200161=沒事，剛剛那個曲子真好聽，我們回去看看有沒有東西落下了。",
        "gal_map_text_202200162=好，我陪你一起去！",
        "gal_map_text_202200163=兩人來到音樂室開始檢查有沒有落下東西，阿米菈時不時點亮手機螢幕，看一眼那段珍貴的視頻，嘴角掛著藏不住的笑意。",
        "gal_map_text_202200164=時間不早了，我們該走了。",
        "gal_map_text_202200165=嗯……今天在這裡的時光，真的好開心，有點捨不得結束。",
        "gal_map_text_202200166=以後如果你想彈琴，或者想聽我彈，隨時都可以來找我。",
        "gal_map_text_202200167=一言為定！這可是你說的哦～以後我找你，你可不能嫌我煩。",
        "gal_map_text_202200168=兩人開始收拾個人物品，阿米菈時不時點亮手機螢幕，看一眼那段珍貴的視頻，嘴角掛著藏不住的笑意。",
        "gal_map_text_202200169=美術室內，畫作已接近完成，西斜的陽光為畫布蒙上一層溫暖的光澤，混合著顏料氣息的空氣裡，彌漫著創作即將收尾的專注與淡淡的成就感。",
        "gal_map_text_202200170=我察覺到阿米菈維持姿勢有些吃力，便及時叫停讓她休息。結果她迫不及待地走到畫架前，當看清畫布上的自己時，忍不住發出一聲小小的驚歎。",
        "gal_map_text_202200171=阿米菈目不轉睛地看著畫。",
        "gal_map_text_202200172=畫得……太好了！比我想像中還要美很多！",
        "gal_map_text_202200173=是因為模特本身就很‘上鏡’，給了我很多靈感。",
        "gal_map_text_202200174=那……你以後，還會為別人畫這樣的畫嗎？",
        "gal_map_text_202200175=不會。這是第一次，也是唯一一次，為某個人全心投入地完成一幅肖像。只為你。",
        "gal_map_text_202200176=阿米菈眼底瞬間漾開明亮的光彩，她小心翼翼地從畫架上取下已經幹透的畫，像捧著什麼稀世珍寶。",
        "gal_map_text_202200177=那……這幅畫，可以送給我嗎？",
        "gal_map_text_202200178=當然，它本來就是屬於你的。",
        "gal_map_text_202200179=阿米菈立刻找來一支筆，請求你在畫作角落簽下名字。依言簽名後，阿米菈笑著說希望以後能一直當你的“專屬模特”。",
        "gal_map_text_202200180=阿米菈拿起筆，偷偷我的簽名旁邊，極其認真地畫上了一把小小的、傘下有兩個緊挨著的小人的圖案，並在下方簽上了自己的名字。",
        "gal_map_text_202200181=簽名後溫柔叮囑",
        "gal_map_text_202200182=簽名後調侃互動",
        "gal_map_text_202200183=好好收著，別讓它沾了灰或受了潮。",
        "gal_map_text_202200184=嗯！我一定會用最最好的方式珍藏它。因為……這是你為我畫的，獨一無二的禮物。",
        "gal_map_text_202200185=好，我答應你。只要你想，隨時都可以來做我的模特。",
        "gal_map_text_202200186=嗯，你這個承諾，可不許反悔哦。",
        "gal_map_text_202200187=我先行離開，阿米菈獨自留在漸漸暗下來的美術室裡，指尖輕輕拂過畫作上那片新添的、傘下雙人的小小圖案，嘴角揚起一抹甜蜜而滿足的弧度。",
        "gal_map_text_202200188=說好了當專屬模特，以後可是要隨叫隨到的，不能臨時偷懶哦。",
        "gal_map_text_202200189=知道啦～保證完成任務！不過，作為交換，你也要答應我，你的畫筆，只能畫我一個人。",
        "gal_map_text_202200190=好，一言為定。不過你也得保證，每次都要像今天一樣認真才行。",
        "gal_map_text_202200191=是！保證拿出百分百的認真態度！",
        "gal_map_text_202200192=我先行離開，阿米菈獨自留在漸漸暗下來的美術室裡，指尖輕輕拂過畫作上那片新添的、傘下雙人的小小圖案，嘴角揚起一抹甜蜜而滿足的弧度。",
        "gal_map_text_202200193=兩人並肩走出圖書館，沿著林蔭道緩步向校門走去。",
        "gal_map_text_202200194=阿米菈忽然停下腳步，輕聲喚住你，從隨身的小包裡取出一個用素雅包裝紙仔細包好的小盒子，有些羞澀卻又堅定地遞到你面前，眼中閃爍著明亮的期待。",
        "gal_map_text_202200195=等一下！這個……是給你的。我特意準備的禮物，希望……希望你會喜歡。",
        "gal_map_text_202200196=我接過那份尚帶阿米菈掌心溫度的小盒子。",
        "gal_map_text_202200197=你打開看看嘛～我花了挺多心思的，是獨一無二的哦。",
        "gal_map_text_202200198=在阿米菈期待的目光中，小心地拆開包裝。看清盒中之物時，你的眼中清晰地映出驚喜與感動。",
        "gal_map_text_202200199=她屏息凝神地注視著你的每一個細微表情，心中既期待又有些忐忑。",
        "gal_map_text_202200200=直到聽到我溫柔的回應，那份緊張才化作甜蜜的暖流。",
        "gal_map_text_202200201=我拿起那枚造型精巧別致的黃銅鑰匙扣，看了看。",
        "gal_map_text_202200202=這個設計好特別，黃銅的質感，消防栓扳手的造型……很有個性，也很實用。",
        "gal_map_text_202200203=是吧～我找了好久才找到這款。它叫“守護者”。以後……我的平安，就交給你來“扳動”和守護啦～",
        "gal_map_text_202200204=交給我吧，我會好好帶著它，也會好好守護你。",
        "gal_map_text_202200205=你喜歡就好～以後它就要天天陪著你了，就像……我在你身邊一樣。",
        "gal_map_text_202200206=嗯，它會一直在。你，也會一直在我心裡。",
        "gal_map_text_202200207=禮物被鄭重收下，兩人之間流動著一種心照不宣的甜蜜與親近，夕陽的餘暉將你們的影子拉長，緊密相連。",
        "gal_map_text_202200208=我端詳著手中那塊做舊風格的金屬課表牌，看了看。",
        "gal_map_text_202200209=這個課表牌的復古工藝很漂亮，設計也很簡潔大方。",
        "gal_map_text_202200210=我就猜你會喜歡～它叫“時光刻度”。",
        "gal_map_text_202200211=以後不管你用它來規劃什麼，看到它的時候，希望能想起今天，想起在圖書館裡，有我安靜陪伴的這段時光。",
        "gal_map_text_202200212=嗯，我會的。這段安靜的陪伴，和這份禮物一樣，我都會好好珍藏。",
        "gal_map_text_202200213=喜歡就好！不過，要是你敢把今天的時光忘了……她拖長語調，那我可要‘罰’你陪我再來圖書館泡一整天哦！",
        "gal_map_text_202200214=好，這個‘懲罰’，我欣然接受，以後也隨時奉陪。",
        "gal_map_text_202200215=禮物被鄭重收下，兩人之間流動著一種心照不宣的甜蜜與親近，夕陽的餘暉將你們的影子拉長，緊密相連。",
        "gal_map_text_202200216=音樂室外，夕陽將天邊染成暖橘色，空氣中仿佛仍隱約回蕩著方才的琴音，寧靜而浪漫。",
        "gal_map_text_202200217=走出音樂室，兩人沿著琴房外的長廊慢慢前行。",
        "gal_map_text_202200218=阿米菈忽然加快兩步，繞到你面前，從包裡拿出一個用絲帶系好的小紙袋，雙手遞到你眼前，臉上帶著混合了雀躍與羞澀的紅暈。",
        "gal_map_text_202200219=等一下！還有個驚喜要給你～這個，快打開看看！",
        "gal_map_text_202200220=我停下腳步，接過那個輕巧的紙袋。",
        "gal_map_text_202200221=今天真是驚喜不斷，謝謝你。",
        "gal_map_text_202200222=快看看嘛～我覺得，它和音樂特別配！",
        "gal_map_text_202200223=我解開絲帶，紙袋裡是一個透明的小小密封罐。看清內容物後，你眼中掠過明顯的訝異與溫柔。",
        "gal_map_text_202200224=阿米菈緊張地觀察著你的反應，直到看到你唇角漾開的笑意，自己也不自覺地笑了出來。",
        "gal_map_text_202200225=我小心地取出那個栽種在拇指盆裡的嫩綠植物，仔細端詳。",
        "gal_map_text_202200226=是心葉球蘭……這麼小，形態卻已經很可愛了",
        "gal_map_text_202200227=嗯！它的葉子是心形的，所以叫‘心意’。我希望……我對你的心意，也能像它一樣，慢慢地、扎實地生長下去。",
        "gal_map_text_202200228=我會好好照顧這份‘心意’。讓它，也讓我們，都茁壯成長。",
        "gal_map_text_202200229=你喜歡就好～等它再長大一點，長出更多心形的葉子，我們就一起給它換個大點的家，好嗎？",
        "gal_map_text_202200230=好。到時候就請你來為它挑選新家。",
        "gal_map_text_202200231=一份關於生長與氣息的約定悄然達成，兩人相視而笑，傍晚的風都染上了甜蜜的氣息。",
        "gal_map_text_202200232=我看著手中那個設計精巧、內置乾燥花草與精油的迷你香氛盒，有些驚奇。",
        "gal_map_text_202200233=這是……植物香氛？設計得很別致。",
        "gal_map_text_202200234=對！它叫“縈繞”。裡面是我挑的，讓人放鬆的草木香。",
        "gal_map_text_202200235=以後當你需要靈感，或者想安靜一下的時候，打開它，就像回到了今天這個充滿琴聲的、令人安心的空間裡。",
        "gal_map_text_202200236=也像……我還在你身邊，給你支持一樣。",
        "gal_map_text_202200237=很棒的禮物。以後聞到這個味道，就會想起今天，想起你。",
        "gal_map_text_202200238=喜歡就好！以後要是想我了，或者想聽琴聲了，就打開它聞一聞～雖然不能真的彈出聲音，但感覺會很像我在旁邊給你加油哦！",
        "gal_map_text_202200239=嗯，一言為定。你的“加油”，我一定會好好守著。",
        "gal_map_text_202200240=一份關於生長與氣息的約定悄然達成，兩人相視而笑，傍晚的風都染上了甜蜜的氣息。",
        "gal_map_text_202200241=美術室外，夕陽的余暉為白牆染上暖色，空氣中隱約還能嗅到松節油與顏料未散盡的氣息，氛圍寧靜而充滿藝術感。",
        "gal_map_text_202200242=阿米菈將畫作仔細收好後走出美術室，看到你正在門口的銀杏樹下等她。兩人匯合，一同向校門走去。",
        "gal_map_text_202200243=在穿過中心花園的小徑時，阿米菈忽然停下，轉身面向你，從畫袋的側兜裡取出一個扁平的、用牛皮紙包裹的方正物件，雙手遞上。",
        "gal_map_text_202200244=那個……這個也給你。",
        "gal_map_text_202200245=今天收穫真豐富，謝謝你的禮物，阿米菈。",
        "gal_map_text_202200246=我接過那份手感扎實的禮物。",
        "gal_map_text_202200247=打開看看吧？我覺得……它很適合你，也適合今天。",
        "gal_map_text_202200248=我拆開牛皮紙，露出裡面物品古樸雅致的本來面貌。",
        "gal_map_text_202200249=你的目光在禮物上停留片刻，隨即抬起，眼中滿是了然與深深的溫柔。",
        "gal_map_text_202200250=阿米菈在你專注的凝視下，耳尖漸漸發燙，心中卻滿是期待被理解的甜蜜。",
        "gal_map_text_202200251=我撫摸著手工紙張粗糙而富有質感的封面，以及精緻的皮質包角。",
        "gal_map_text_202200252=一本古董風格的空白筆記本……紙張和裝幀都很考究，是記錄靈感和速寫的絕佳選擇。",
        "gal_map_text_202200253=嗯！它叫“留白”。我希望，以後你所有關於美的靈感、我們之間值得記住的點滴，都能被安放在這裡。由你親手填滿。",
        "gal_map_text_202200254=好。它的第一頁，就從今天開始。我會好好使用它，珍藏所有與你有關的‘靈感’。",
        "gal_map_text_202200255=你喜歡就好～那，作為這本‘留白’的第一位靈感來源……她俏皮地指了指自己，我這位專屬模特，是不是也算入股了呀？",
        "gal_map_text_202200256=當然！你不僅是靈感來源，更是這本書未來所有篇章的……主角。",
        "gal_map_text_202200257=關於記錄與珍藏的約定在暮色中落定，兩人並肩的身影被夕陽拉長，心意在禮物與話語間完成了無聲而深刻的交匯。",
        "gal_map_text_202200258=我拿起那把造型復古、宛如老式行李箱鑰匙的黃銅物件，仔細端詳。",
        "gal_map_text_202200259=一把很特別的鑰匙……設計很有巧思。",
        "gal_map_text_202200260=雖然它打不開現實中的鎖，但可以幫你‘鎖住’美好的時光碎片。",
        "gal_map_text_202200261=以後我們所有的快樂回憶，都可以想像著被它小心收納起來，永不遺失。",
        "gal_map_text_202200262=我將鑰匙輕輕握住，仿佛真的握住了某種無形的珍貴之物。",
        "gal_map_text_202200263=很浪漫的寓意。我會用它，好好‘鎖住’今天的每一刻，以及未來的所有美好。",
        "gal_map_text_202200264=喜歡吧？那說好了哦，以後我們每創造一份新的快樂，你都要記得用這把‘鑰匙’，把它‘哢嚓’一下，好好存起來！",
        "gal_map_text_202200265=好，一言為定，我們的記憶一定會越來越滿。",
        "gal_map_text_202200266=關於記錄與珍藏的約定在暮色中落定，兩人並肩的身影被夕陽拉長，心意在禮物與話語間完成了無聲而深刻的交匯。",
        "gal_map_text_202200267=夕陽沉落西山，教學樓外的林蔭道被暮色染透，晚風卷著落葉沙沙作響，空氣裡殘留著幾分夏日的燥熱與疲憊，周遭的靜謐反倒襯得心頭有些空落。",
        "gal_map_text_202200268=兩人並肩走出教學樓，你手裡緊握著阿米菈贈送的信物，指尖無意識地摩挲著上面的紋路，仿佛要將今日所有溫存的瞬間都鐫刻進觸感裡。",
        "gal_map_text_202200269=忽然，一陣毫無預兆的劇烈眩暈襲來，眼前的光影瞬間扭曲模糊，你腳步踉蹌，無力地向一旁栽倒。",
        "gal_map_text_202200270=意識再次回歸時，映入眼簾的是醫務室素白的天花板，鼻尖縈繞著消毒水特有的刺鼻氣味，耳畔傳來細碎而慌亂的聲響。",
        "gal_map_text_202200271=阿米菈就坐在床邊的椅子上，懷裡抱著好幾瓶不同的藥劑，眉頭緊鎖，一會兒笨拙地翻看藥盒上的說明文字，一會兒又無措地擰著瓶蓋。",
        "gal_map_text_202200272=平日裡總是盛滿笑意的眼眸，此刻只餘下濃得化不開的焦急與慌亂。",
        "gal_map_text_202200273=別擔心，我沒事。",
        "gal_map_text_202200274=阿米菈聞聲猛地抬頭，眼眶瞬間就紅了，睫毛上還掛著未拭去的淚珠。",
        "gal_map_text_202200275=你醒了！你終於醒了！感覺怎麼樣？我、我找了好幾種藥，可都看不懂該怎麼用……我從來沒遇到過這種事，剛才……剛才真的嚇壞了！",
        "gal_map_text_202200276=別慌，就是最近熬夜學習，可能是低血糖犯了，歇一會兒就好，讓你擔心了。",
        "gal_map_text_202200277=：都怪我……今天光顧著開心，都沒注意到你臉色不太好。要是我能細心一點，你也許就不會……",
        "gal_map_text_202200278=不是你的錯，我真的沒事。你也坐下歇會兒吧，陪我一會兒就好。",
        "gal_map_text_202200279=我就在這兒，哪兒也不去。今天和你相處的每一刻我都覺得特別開心。",
        "gal_map_text_202200280=嗯，對我來說也是，有你在身邊，連時光都變得溫柔了。以後……只要是你想做的事，我都想陪著你一起。",
        "gal_map_text_202200281=大約休息了半個多小時，我感覺精神恢復了不少，在阿米菈照顧下我狀態好了很多，兩人慢慢走出醫務室，朝著校門方向走去。",
        "gal_map_text_202200282=走到校門口，兩人不約而同地停下腳步，空氣中彌漫著夏日傍晚特有的、混合著青草氣息的靜謐，以及一絲淡淡的離別眷戀。",
        "gal_map_text_202200283=阿米菈抬起頭，望向你的眼睛，平日裡靈動狡黠的眼神，此刻盈滿了羞澀與一種前所未有的堅定。",
        "gal_map_text_202200284=她深吸一口氣，仿佛用盡了此刻所有的勇氣，不等你反應，便快速踮起腳尖，在你臉頰上留下一個輕柔如羽、一觸即離的吻。",
        "gal_map_text_202200285=阿米菈隨後轉身就跑，長髮在晚風中劃出一道飛揚的弧線，像一隻受驚又雀躍的鳥兒。",
        "gal_map_text_202200286=今天謝謝你！我玩得超級——開心！下次，還要一起哦！",
        "gal_map_text_202200287=好，我等你。",
        "gal_map_text_202200288=我佇立在原地，目送著阿米菈的身影漸漸融入街道的暮色與燈光之中，手中依舊緊握著那枚承載著一天回憶與心意的信物。",
        "gal_map_text_202200289=晚風再次卷起地上的落葉，發出窸窣的聲響，如同在低聲複誦這一日的篇章——所有共用的時光，此刻都沉澱為心底最柔軟而堅固的琥珀。",
        "gal_map_text_205000000=夏末的商業街拐角，梧桐葉的影子灑在石板路上。唐笑笑蹲在一家花店旁，指尖輕點著一隻三花小貓的下巴，笑聲清脆。",
        "gal_map_text_205000001=暑假將盡，我本想隨意逛逛打發時間，卻在熟悉的街角遇見了她。那隻貓在她手邊磨蹭，她笑得眼睛彎成月牙。",
        "gal_map_text_205000002=唐笑笑？",
        "gal_map_text_205000003=唐笑笑抬起頭，眼睛一亮。",
        "gal_map_text_205000004=哎？是你啊！快看，這貓超乖的！",
        "gal_map_text_205000005=你還是很喜歡小貓。",
        "gal_map_text_205000006=那當然！毛茸茸的多治癒啊——你出來幹嘛？宅在家裡發霉了喔？",
        "gal_map_text_205000007=差不多，隨便逛逛。",
        "gal_map_text_205000008=唐笑笑站起身，拍拍短褲。",
        "gal_map_text_205000009=那一起吧！我也無聊死了！",
        "gal_map_text_205000010=兩人並肩走進翻新過的商業街。新店開業的海報塞滿入口，你接過一張，唐笑笑立刻湊了過來。",
        "gal_map_text_205000011=我看看……哇，這家DIY甜品店情侶免費哎！你可以假裝我男友啊，反正你挺愛吃甜的。",
        "gal_map_text_205000012=唐笑笑指向另一欄。",
        "gal_map_text_205000013=欸欸，這個扭蛋店！有《星海軌跡》的限定模型！隱藏款超——難抽！",
        "gal_map_text_205000014=唐笑笑手指滑到海報背面。",
        "gal_map_text_205000015=還有屋頂迷你農場？能摘小番茄，還有一個籐椅拍照肯定好看。",
        "gal_map_text_205000016=唐笑笑每說一處就抬頭看你一眼，腳尖無意識地輕輕點著扭蛋店的宣傳圖，手指反復摩挲著海報上模型的小圖。",
        "gal_map_text_205000017=提議去DIY甜品店",
        "gal_map_text_205000018=提議去扭蛋遊戲廳",
        "gal_map_text_205000019=提議去屋頂迷你農場",
        "gal_map_text_205000020=天這麼熱，先去室內吧。那家DIY店……你不是說想試試新品？",
        "gal_map_text_205000021=誰、誰想試了！我就是給你個建議！不過……既然你都這麼說了，那就去唄。",
        "gal_map_text_205000022=喂，等會兒真要假裝情侶啊？你可別穿幫。",
        "gal_map_text_205000023=你比較像會露餡的那個吧。",
        "gal_map_text_205000024=蛤？我演技超好的好不好！",
        "gal_map_text_205000025=唐笑笑哼著歌走到你前面，步伐一晃一晃。",
        "gal_map_text_205000026=《星海軌跡》的模型……是那個拿太刀的角色？我記得你課間畫過。",
        "gal_map_text_205000027=我、我那是隨便畫的！不過……你居然記得？那、那去看看也行，反正順路！",
        "gal_map_text_205000028=先說好，要是抽不到隱藏款，你不准笑我。",
        "gal_map_text_205000029=你抽十次不出的時候我再笑。",
        "gal_map_text_205000030=你敢！",
        "gal_map_text_205000031=唐笑笑和你保持半步內的距離，時不時瞄一眼海報上的扭蛋機圖片。",
        "gal_map_text_205000032=去屋頂吹吹風？看看除了小番茄，還有沒有其他水果。籐椅和你很配不一定能幫你拍出‘夏日治癒感’照片？",
        "gal_map_text_205000033=那就去唄！剛好體驗一把田園風光。",
        "gal_map_text_205000034=等會兒你給我當好攝影師，不許嫌煩。",
        "gal_map_text_205000035=我這個拍照技術確定拍出來能看？",
        "gal_map_text_205000036=我擺造型很好的！當然.......要是你連快門都不會按，我也沒辦法。",
        "gal_map_text_205000037=唐笑笑拿出手機調試假裝試鏡，鏡頭卻悄悄對著你側臉停了好幾秒。",
        "gal_map_text_205000038=甜品店鋪明亮乾淨，操作臺擺滿各式模具與原料。空氣裡是甜膩的奶油香。",
        "gal_map_text_205000039=唐笑笑自然地挽住你的手臂走進店內，店員迎了上來，目光在你們之間轉了轉。",
        "gal_map_text_205000040=歡迎光臨！情侶可以免費體驗DIY哦，不過需要完成一個小挑戰證明關係～",
        "gal_map_text_205000041=什麼挑戰？",
        "gal_map_text_205000042=店員從圍裙口袋掏出一根巧克力棒",
        "gal_map_text_205000043=Pocky挑戰！兩位分別從兩頭開始吃，剩下五釐米以內就算成功。",
        "gal_map_text_205000044=我還在猶豫，唐笑笑已經收緊挽著你的手。",
        "gal_map_text_205000045=當然要挑戰！對吧？",
        "gal_map_text_205000046=唐笑笑仰頭看你，眼神裡半是挑釁半是狡黠。",
        "gal_map_text_205000047=接受挑戰",
        "gal_map_text_205000048=提議付費",
        "gal_map_text_205000049=行……但是這個挑戰會不會太親密了點？",
        "gal_map_text_205000050=唐笑笑得逞般笑起來，接過巧克力棒直接含住一端。",
        "gal_map_text_205000051=快點呀！",
        "gal_map_text_205000052=我鼓起勇氣，含住了巧克力的另一端。",
        "gal_map_text_205000053=開始！",
        "gal_map_text_205000054=唐笑笑閉上眼向前",
        "gal_map_text_205000055=我逐漸能聞到她頭髮上淡淡的桃子香",
        "gal_map_text_205000056=距離迅速縮短。我停在規定位置，她卻還在靠近——鼻尖相撞。她忽然睜眼，兩人相距不過釐米。她瞳孔微顫，臉瞬間紅了。",
        "gal_map_text_205000057=他……你怎麼停住了？",
        "gal_map_text_205000058=……到頭了。",
        "gal_map_text_205000059=她下意識又往前探了一點。你心臟猛跳，齒間下意識用力——哢嚓。",
        "gal_map_text_205000060=巧克力棒斷了。",
        "gal_map_text_205000061=恭喜通關！這是你們的入場徽章～",
        "gal_map_text_205000062=唐笑笑鬆開嘴，別過臉嚼著巧克力。",
        "gal_map_text_205000063=好甜，比之前吃過的巧克力棒甜。",
        "gal_map_text_205000064=嗯....嗯。",
        "gal_map_text_205000065=唐笑笑接過兩枚徽章，低頭給你別上時，手指有點抖。金屬扣哢噠一聲輕響，像某種心跳的餘韻。",
        "gal_map_text_205000066=進入DIY區的一路，她始終挽著你的手，比剛才更緊了些。",
        "gal_map_text_205000067=還是付費吧，這個挑戰有點……",
        "gal_map_text_205000068=唐笑笑立刻鬆開手，瞪大眼睛。",
        "gal_map_text_205000069=你不會是怕了吧！",
        "gal_map_text_205000070=只是覺得沒必要。",
        "gal_map_text_205000071=哦……隨你便。",
        "gal_map_text_205000072=整個付款過程唐笑笑都沒說話。直到拿到工具圍短褲，她才忽然拽了拽你袖子。",
        "gal_map_text_205000073=……喂。",
        "gal_map_text_205000074=嗯？",
        "gal_map_text_205000075=唐笑笑有點生氣，別開臉。",
        "gal_map_text_205000076=就算不是挑戰……你也得好好配合我。我可不想做出失敗品。",
        "gal_map_text_205000077=我知道了。",
        "gal_map_text_205000078=唐笑笑系圍短褲時故意讓我幫忙綁背後的帶子，指尖不經意掠過我手背。",
        "gal_map_text_205000079=霓虹燈光旋轉，扭蛋機列陣般排開。金屬碰撞聲與歡呼聲此起彼伏。",
        "gal_map_text_205000080=唐笑笑熟門熟路地帶你穿過走道，最終停在一台貼滿《星海軌跡》海報的機器前。",
        "gal_map_text_205000081=就是它！隱藏款概率只有0.5%……我今天一定要抽到！",
        "gal_map_text_205000082=你確定不是來給店老闆捐款的？",
        "gal_map_text_205000083=呸！看我的！",
        "gal_map_text_205000084=唐笑笑連續投了十次幣。地上滾落的扭蛋裡全是普通角色。第十一次落空時，她蹲到牆角，整個人蔫了",
        "gal_map_text_205000085=安慰並幫忙抽",
        "gal_map_text_205000086=調侃她運氣差",
        "gal_map_text_205000087=酋長大人，讓屬下來試試？",
        "gal_map_text_205000088=我蹲到唐笑笑旁邊，拍拍她肩。",
        "gal_map_text_205000089=你肯定也抽不到……",
        "gal_map_text_205000090=你墊了這麼多次，該出貨了。",
        "gal_map_text_205000091=我投幣，轉動。扭蛋滾出——仍是普通款。她噗嗤笑出聲。",
        "gal_map_text_205000092=看吧！我就說隱藏款哪裡有這麼好出。",
        "gal_map_text_205000093=我就不信了，再來這次肯定會出的。",
        "gal_map_text_205000094=又連續三發落空。我輕踢了下機器底座。",
        "gal_map_text_205000095=哈哈哈哈你好像更非——啊！",
        "gal_map_text_205000096=她笑得前仰後合，沒注意踩到地上的扭蛋殼，整個人向後滑倒。你下意識伸手攬住她的腰往回帶。她撞進你懷裡，笑聲戛然而止",
        "gal_map_text_205000097=沒事吧？",
        "gal_map_text_205000098=唐笑笑臉貼在你胸前，聲音發悶。",
        "gal_map_text_205000099=沒、沒事……",
        "gal_map_text_205000100=我扶她站穩。她低頭拍了拍短褲，耳根通紅。",
        "gal_map_text_205000101=最後抽一次！抽不到就走！",
        "gal_map_text_205000102=相信我最後一發必出！",
        "gal_map_text_205000103=我再次投幣。扭蛋滾出——打開瞬間，一抹金色閃光。",
        "gal_map_text_205000104=出了！你看看是不是那個隱藏款。",
        "gal_map_text_205000105=什麼什麼？哇！隱藏款！真是隱藏款！",
        "gal_map_text_205000106=唐笑笑抓住你袖子看向模型，眼睛亮得像盛滿星星。",
        "gal_map_text_205000107=哥哥……這個能讓給我嗎？硬幣錢我全出！",
        "gal_map_text_205000108=送你了。",
        "gal_map_text_205000109=真的嗎？你可不許反悔。",
        "gal_map_text_205000110=今天陪你打發時間，本來就很開心了。",
        "gal_map_text_205000111=唐笑笑捧著模型，臉頰越來越紅，最後把臉埋進模型盒子裡，小小嗯了一聲。",
        "gal_map_text_205000112=酋長果然名不虛傳，要不要我幫你聯繫一下慈善機構？",
        "gal_map_text_205000113=唐笑笑猛地站起來，炸毛。",
        "gal_map_text_205000114=你再說一遍！",
        "gal_map_text_205000115=實話實說嘛。",
        "gal_map_text_205000116=那你來抽！抽不到你就是副酋長！",
        "gal_map_text_205000117=我抽了幾次同樣落空。唐笑笑正要嘲笑，自己卻腳下一滑。你扶住她時，她氣得臉頰鼓鼓。",
        "gal_map_text_205000118=都、都怪這破地板！",
        "gal_map_text_205000119=是是是，都怪地板。",
        "gal_map_text_205000120=你語氣好敷衍！",
        "gal_map_text_205000121=我最後抽中隱藏款時，她瞪大眼睛，半晌才憋出一句：……運氣真好。",
        "gal_map_text_205000122=這個就送你了，看你這麼喜歡。",
        "gal_map_text_205000123=謝謝。不過你別得意，下次我肯定也能抽到！",
        "gal_map_text_205000124=嗯，但下次還抽不到我就不送你了。",
        "gal_map_text_205000125=唐笑笑撇撇嘴，卻把模型小心地收進包裡最內側。",
        "gal_map_text_205000126=商場屋頂被改造成城市綠洲。藤蔓纏繞欄杆，小番茄藤在架子上垂下紅果，多肉植物胖嘟嘟地擠滿陶盆。",
        "gal_map_text_205000127=清風拂過，帶著泥土與青草氣息。唐笑笑深吸一口氣，笑容舒展。",
        "gal_map_text_205000128=工作人員遞來小籃子",
        "gal_map_text_205000129=摘滿就可以帶走哦～",
        "gal_map_text_205000130=謝謝！",
        "gal_map_text_205000131=唐笑笑拽著你袖子",
        "gal_map_text_205000132=快快快，那邊番茄超紅！",
        "gal_map_text_205000133=她踮腳去夠高處的果子，幾次失敗後氣鼓鼓地跺腳。",
        "gal_map_text_205000134=幫我摘那個！就那個啦！",
        "gal_map_text_205000135=你輕鬆摘下遞給她。她咬了一口，汁水濺到嘴角。",
        "gal_map_text_205000136=超甜！你也嘗——哎呀。",
        "gal_map_text_205000137=唐笑笑看到你籃子裡只有零星幾顆，忽然把手裡那半顆遞到你嘴邊。",
        "gal_map_text_205000138=就著她的手吃掉",
        "gal_map_text_205000139=自己接過來吃",
        "gal_map_text_205000140=我低頭就著她手指咬下",
        "gal_map_text_205000141=嗯，很甜。",
        "gal_map_text_205000142=唐笑笑手指像被燙到般縮回，臉瞬間漲紅",
        "gal_map_text_205000143=你、你幹嘛不自己拿啦！",
        "gal_map_text_205000144=你遞過來的啊。",
        "gal_map_text_205000145=唐笑笑盯著自己指尖看了兩秒，忽然轉身跑到多肉區。",
        "gal_map_text_205000146=來種這個！你扶著我填土！",
        "gal_map_text_205000147=兩人蹲在花盆旁。唐笑笑填土時胳膊總碰著你。種好起身時，她腳絆到花盆邊緣，你下意識攬住她肩膀——",
        "gal_map_text_205000148=兩人一起跌進旁邊的籐椅裡。她整個人趴在你胸口，呆了幾秒，手忙腳亂爬起來。",
        "gal_map_text_205000149=對、對不起！",
        "gal_map_text_205000150=沒事，你有沒有傷到哪裡了。",
        "gal_map_text_205000151=唐笑笑低頭擺弄多肉葉子，聲音很小。",
        "gal_map_text_205000152=我沒事，倒是你怎麼心跳跳著這麼快。",
        "gal_map_text_205000153=因為你很重。",
        "gal_map_text_205000154=喂！",
        "gal_map_text_205000155=她抱著那盆多肉坐回秋千，和你隔了半臂距離。",
        "gal_map_text_205000156=我接過番茄",
        "gal_map_text_205000157=謝謝，那我不客氣了。",
        "gal_map_text_205000158=是不是超級甜！",
        "gal_map_text_205000159=嗯，挺甜的。",
        "gal_map_text_205000160=唐笑笑看向多肉區，挽著我手臂走向多肉區。",
        "gal_map_text_205000161=我們來種這個吧。",
        "gal_map_text_205000162=種多肉時她格外安靜。起身時她絆了一下，我扶住她手臂。",
        "gal_map_text_205000163=小心。",
        "gal_map_text_205000164=抱歉，我沒有注意到腳邊還有藤蔓。",
        "gal_map_text_205000165=沒事，要不要去休息一下，今天太陽挺大的小心中暑。",
        "gal_map_text_205000166=唐笑笑點了點頭，抱著多肉盆栽指了指秋千的位置。",
        "gal_map_text_205000167=我們去秋千那邊坐坐吧。",
        "gal_map_text_205000168=兩人坐在秋千上，唐笑笑將採摘小番茄的籃子放在我腿上，小口吃著番茄，目光飄向遠處街景。",
        "gal_map_text_205000169=風吹起她鬢角的碎發。她偶爾轉頭看你，像想說什麼，又咽了回去。",
        "gal_map_text_205000170=操作臺上，慕斯蛋糕初具雛形。奶油槍、果醬瓶、糖粉罐列隊待命。",
        "gal_map_text_205000171=唐笑笑搶著要擠奶油裱花，手卻總抖。你不得不一邊看手冊，一邊當她的人形穩定器。",
        "gal_map_text_205000172=（擠歪了一朵花）啊呀……",
        "gal_map_text_205000173=要不讓我來吧，你手總抖。",
        "gal_map_text_205000174=不要！說好合作的！",
        "gal_map_text_205000175=唐笑笑重新擠，我托著蛋糕底盤微調角度。兩人的手時不時碰在一起。",
        "gal_map_text_205000176=終於擠完最後一圈裱花。她長舒一口氣，鼻尖蹭到一點奶油。",
        "gal_map_text_205000177=你臉上沾到了。",
        "gal_map_text_205000178=哪裡？",
        "gal_map_text_205000179=唐笑笑用手背抹，反而抹開一片。",
        "gal_map_text_205000180=幫她擦掉",
        "gal_map_text_205000181=笑她小花貓",
        "gal_map_text_205000182=我抽了張衛生紙，輕輕擦掉她鼻尖的奶油",
        "gal_map_text_205000183=別動。",
        "gal_map_text_205000184=唐笑笑身體僵住，眼睛睜得圓圓。",
        "gal_map_text_205000185=麻煩你了，你可要幫我擦乾淨。",
        "gal_map_text_205000186=擦乾淨後，她盯著我看了幾秒，忽然伸手抹了把你臉頰——那裡也不知何時沾了奶油。",
        "gal_map_text_205000187=你也有！",
        "gal_map_text_205000188=你這是故意的吧。",
        "gal_map_text_205000189=禮尚往來嘛。",
        "gal_map_text_205000190=唐笑笑指尖還沾著從你臉上抹來的奶油。在我反應過來前，她忽然湊近，飛快地舔了下自己指尖。",
        "gal_map_text_205000191=好甜。",
        "gal_map_text_205000192=你也太調皮了吧。",
        "gal_map_text_205000193=怎麼了？不能浪費糧食！",
        "gal_map_text_205000194=唐笑笑轉身去洗手，耳根紅得透明。",
        "gal_map_text_205000195=回來時，她挨著我站，胳膊貼著我胳膊，假裝專心給蛋糕擺草莓。",
        "gal_map_text_205000196=變成小花貓了。",
        "gal_map_text_205000197=哪裡？哪裡？",
        "gal_map_text_205000198=唐笑笑像嘗試抹掉，沒想到將奶油越摸越多了。",
        "gal_map_text_205000199=越來越花了。",
        "gal_map_text_205000200=那你幫我擦！",
        "gal_map_text_205000201=自己擦。",
        "gal_map_text_205000202=不！就要你擦！",
        "gal_map_text_205000203=唐笑笑抓住我手腕，把我手裡的紙巾按到自己臉上。我無奈地幫她擦乾淨。",
        "gal_map_text_205000204=看，這不是挺好的？",
        "gal_map_text_205000205=……麻煩精。",
        "gal_map_text_205000206=就麻煩你，怎麼啦？",
        "gal_map_text_205000207=唐笑笑說完自己也愣了下，低頭擺弄裱花袋，不說話了。",
        "gal_map_text_205000208=蛋糕完成後，她拿出手機對著蛋糕拍起照片來。",
        "gal_map_text_205000209=遊戲廳深處，抓娃娃機閃著夢幻的光。玻璃櫃裡堆滿毛絨玩偶。",
        "gal_map_text_205000210=唐笑笑對那台裝著貓咪玩偶的機器產生了執念。投了二十個幣，一無所獲。",
        "gal_map_text_205000211=唐笑笑捶了捶機器",
        "gal_map_text_205000212=這爪子肯定是棉花做的！",
        "gal_map_text_205000213=讓我來試一試。",
        "gal_map_text_205000214=你也肯定不行——咦？",
        "gal_map_text_205000215=我投入硬幣，控制起爪子。只見爪子落下抓住一隻毛絨玩偶落下出洞口。唐笑笑在旁邊看的目瞪口呆。",
        "gal_map_text_205000216=運氣！絕對是運氣！",
        "gal_map_text_205000217=我再次抓出一隻玩偶。",
        "gal_map_text_205000218=這機器肯定是壞了！",
        "gal_map_text_205000219=讓我來！我要自己抓到！",
        "gal_map_text_205000220=她又失敗了十幾次。最終盯著爪子空抓上升，整個人蔫成一團。",
        "gal_map_text_205000221=我可能真的沒有抓娃娃的天賦。",
        "gal_map_text_205000222=偷偷從背後手把手教她",
        "gal_map_text_205000223=提議玩其他項目",
        "gal_map_text_205000224=我偷偷站在她身後手臂虛環，手放在她手上幫她控制著爪子。",
        "gal_map_text_205000225=角度不對，你應該瞄準著毛絨玩偶的衣服或裝飾品上下手。",
        "gal_map_text_205000226=唐笑笑身體一僵，動都不敢動。",
        "gal_map_text_205000227=原來如此，難怪我怎麼都抓不到。",
        "gal_map_text_205000228=我握著她的手移動搖杆。她後腦勺靠在你肩前。",
        "gal_map_text_205000229=就是這個時候，按下按鈕。",
        "gal_map_text_205000230=唐笑笑屏住呼吸。",
        "gal_map_text_205000231=爪子落下穩穩抓住一隻毛絨玩偶，滾進出物口。",
        "gal_map_text_205000232=唐笑笑轉身歡呼，差點撞到你下巴。",
        "gal_map_text_205000233=抓到了！我抓到了！",
        "gal_map_text_205000234=恭喜，恭喜！",
        "gal_map_text_205000235=是你教得好……師傅？",
        "gal_map_text_205000236=這稱呼我喜歡。",
        "gal_map_text_205000237=得意什麼！",
        "gal_map_text_205000238=唐笑笑抱著戰利品跟在你身後，偶爾用玩偶碰碰你後背，像小動物確認跟隨。",
        "gal_map_text_205000239=要不玩點別的？那邊有你喜歡的鼓鼓達人。",
        "gal_map_text_205000240=不要。我就要抓到這個。",
        "gal_map_text_205000241=唐笑笑繼續投幣。我靠在旁邊機器上看。第10次失敗時，她轉身把額頭抵在你肩上。",
        "gal_map_text_205000242=我好菜。抓這麼多次都沒有抓到。",
        "gal_map_text_205000243=遊戲而已，不要放在心上要不要去旁邊休息一會。",
        "gal_map_text_205000244=唐笑笑沒抬頭，在你肩上靠了好一會兒。",
        "gal_map_text_205000245=你剛才怎麼抓到的？",
        "gal_map_text_205000246=看爪子晃動的節奏。它第三次晃的時候按，成功率最高。",
        "gal_map_text_205000247=那你為什麼不早說，不早點教我。",
        "gal_map_text_205000248=就是有點想看你抓不到會成什麼樣子。",
        "gal_map_text_205000249=煩死了！你真人就是在這點上讓人討厭。",
        "gal_map_text_205000250=她按你說的方法試，終於抓到一個。雖然不是你抓的那種小貓，只是普通小熊，她卻抱得緊緊的。",
        "gal_map_text_205000251=居然真的抓上來，謝謝你的秘訣。",
        "gal_map_text_205000252=學的還挺快，看來我這個抓娃娃技術有傳人了。",
        "gal_map_text_205000253=唐笑笑抱著小熊，跟在你身後半步，偶爾偷偷看你側臉。",
        "gal_map_text_205000254=秋千輕輕搖晃。籃子裡小番茄泛著水光，多肉盆栽放在腳邊。",
        "gal_map_text_205000255=雲朵將太陽遮住。唐笑笑靠在秋千鏈上，腳尖點地，讓秋千微微晃動。",
        "gal_map_text_205000256=來張嘴，最後一顆給你吃。",
        "gal_map_text_205000257=都最後一顆了，還是你吃吧。",
        "gal_map_text_205000258=哪來那麼多事情，給你吃你就吃就是了。",
        "gal_map_text_205000259=她說完頓了下，扭頭看遠處。頭慢慢靠在我肩上。",
        "gal_map_text_205000260=沉默在兩人之間蔓延，卻不尷尬。她忽然深吸一口氣，像下了什麼決心。",
        "gal_map_text_205000261=喂。",
        "gal_map_text_205000262=嗯？",
        "gal_map_text_205000263=今天還是要謝謝你，讓度過充實的一天。",
        "gal_map_text_205000264=說以後也可以陪你",
        "gal_map_text_205000265=說今天我也很開心",
        "gal_map_text_205000266=以後如果你想也無聊的話，也可以叫上我來陪你。",
        "gal_map_text_205000267=真的假的？你別隨口答應。我最討厭放鴿子的人。",
        "gal_map_text_205000268=我像是那種隨便放人鴿子的人嗎？",
        "gal_map_text_205000269=唐笑笑盯著你看了幾秒，忽然笑了。",
        "gal_map_text_205000270=那就說好了！下次就我來選地方，我想去的地方可多了，水族館的企鵝隧道，老街哪家首飾店。",
        "gal_map_text_205000271=唐笑笑語速越來越快，臉也越來越紅。",
        "gal_map_text_205000272=你怎麼說著說著臉紅了。",
        "gal_map_text_205000273=要你管！臉紅是太熱了，沒看見太陽這麼大嗎？",
        "gal_map_text_205000274=好好好，你剛剛說的我記下來。",
        "gal_map_text_205000275=唐笑笑整個人僵住，然後猛地站起來。",
        "gal_map_text_205000276=時間差不多了，我們走吧！",
        "gal_map_text_205000277=這不是挺早的嗎？",
        "gal_map_text_205000278=我說晚就是晚！",
        "gal_map_text_205000279=唐笑笑快步走向出口，卻在你沒跟上時，偷偷放慢腳步。",
        "gal_map_text_205000280=今天我也很開心。很久沒這麼放鬆了。",
        "gal_map_text_205000281=是嗎？我還有點擔心今天會讓你覺得有點無聊。",
        "gal_map_text_205000282=唐笑笑低頭摳秋千鏈，半晌才輕聲說",
        "gal_map_text_205000283=在學校內為了扮演好學生的樣子，總是緊繃著神經，這次有你的陪伴也讓我感受久違的放鬆。",
        "gal_map_text_205000284=下次我遇到學術上的困難就多多拜託你啦！",
        "gal_map_text_205000285=真的？萬一你找別的女同學討論不找我怎麼辦。",
        "gal_map_text_205000286=你不會再吃上次我和蘇嬋同學一起討論學術問題的醋吧.",
        "gal_map_text_205000287=才沒有了，你真煩。",
        "gal_map_text_205000288=直到起身離開，都能在唐笑笑身上嗅到一絲醋味的氣息。",
        "gal_map_text_205000289=街道上的燈光亮起，夜幕低垂，她走在我身側，手時不時碰到我的手。忽然，她停下腳步。",
        "gal_map_text_205000290=等一下！",
        "gal_map_text_205000291=唐笑笑翻找背包，掏出一個小巧的絲絨盒子。塞進我手裡。",
        "gal_map_text_205000292=送給你的，就當你陪我打發時間的謝禮。",
        "gal_map_text_205000293=我打開盒子，盒子裡是一塊精緻的復古碼錶，錶盤透明，能看到內部齒輪緩緩咬合。側面刻著極小的字：共感時刻。",
        "gal_map_text_205000294=這是……",
        "gal_map_text_205000295=就、就是個碼錶！你以後上課別再遲到了……還有，那個……",
        "gal_map_text_205000296=你按下側面的按鈕試試。",
        "gal_map_text_205000297=我按下側鍵，碼錶沒有計時，反而輕輕震動了一下——幾乎同時，她口袋裡的另一個懷錶也震動了起來。",
        "gal_map_text_205000298=她掏出同款碼錶，也按下了側鍵。",
        "gal_map_text_205000299=以後我按一下，你的懷錶就會震。比如……我想你的時候。",
        "gal_map_text_205000300=唐笑笑介紹完禮物就想跑，我抓住她的手腕。",
        "gal_map_text_205000301=幹.....幹嘛？",
        "gal_map_text_205000302=謝謝你，我很喜歡這個禮物，如果我想你的時候，我也會按下側鍵。",
        "gal_map_text_205000303=喜歡就好！還有該鬆手啦，你手心出汗了........",
        "gal_map_text_205000304=我收下了她的禮物，因為剛剛激動的行為導致手心出汗出囧了。",
        "gal_map_text_205000305=街道華燈初上，她走在我身側，手時不時碰到我的手。忽然，她停下腳步。",
        "gal_map_text_205000306=喂！手伸出來。",
        "gal_map_text_205000307=伸手幹嘛",
        "gal_map_text_205000308=我讓你伸出來就伸出來磨磨唧唧的。",
        "gal_map_text_205000309=我伸手。她放上一個透明的亞克力立方體，裡面封著一朵小小的、用糖霜做的奶油花。",
        "gal_map_text_205000310=喏，紀念品。我剛剛在你給你給蛋糕封頂的時候偷偷做的。",
        "gal_map_text_205000311=委屈你了，這花做的的這麼好吃的樣子，你居然捨得送給我。",
        "gal_map_text_205000312=就是隨便做的！就當你請我吃蛋糕的回禮了。你別多想！",
        "gal_map_text_205000313=這個奶油花和在你鼻子上的那個奶油還挺像的小花貓。",
        "gal_map_text_205000314=你閉嘴！",
        "gal_map_text_205000315=她快步往前走，又忍不住回頭。",
        "gal_map_text_205000316=你不要給我弄丟或者送人了，要是被我知道我可饒不了你。",
        "gal_map_text_205000317=我怎麼捨得，這個可是我收到最特別的禮物。",
        "gal_map_text_205000318=唐笑笑等你跟上，並肩時，手指悄悄鉤住你袖口。",
        "gal_map_text_205000319=街道華燈初上，她走在我身側，手時不時碰到我的手。忽然，她停下腳步。",
        "gal_map_text_205000320=等一下！",
        "gal_map_text_205000321=唐笑笑從包裡掏出一個小紙袋。",
        "gal_map_text_205000322=這個，給你。",
        "gal_map_text_205000323=是一台迷你的老式放映機模型，黃銅材質，細節精緻。轉動側面搖柄，膠片輪真的會轉。",
        "gal_map_text_205000324=這是……",
        "gal_map_text_205000325=剛才玩扭蛋機的時候扭出來的來，我感覺它挺特別的就送給你，就當做自己的紀念品了。",
        "gal_map_text_205000326=唐笑笑揚起下把，眼裡藏著期待。",
        "gal_map_text_205000327=這個東西還挺厲害的，你剛剛怎麼不拿出給我看還偷偷藏著。",
        "gal_map_text_205000328=當時就拿出來給你，就少了一些驚喜感。",
        "gal_map_text_205000329=這個放映機啊……雖然不能真的放膠片，但是——",
        "gal_map_text_205000330=她湊近，手指點向放映鏡頭。",
        "gal_map_text_205000331=你從這兒往裡看。",
        "gal_map_text_205000332=我湊近。鏡頭裡不是黑暗，而是一張微縮照片——是你們剛才在遊戲廳的合影，她正笑著朝鏡頭比耶，我在旁邊一臉無奈。",
        "gal_map_text_205000333=今天的一切，我都存進去了。你隨時可以‘放映’出來看。",
        "gal_map_text_205000334=唐笑笑！你放的照片就不能好看一點。",
        "gal_map_text_205000335=她轉身想跑，被我一把手拉住。",
        "gal_map_text_205000336=謝謝你。",
        "gal_map_text_205000337=肉麻死了，你不要再說了啦。",
        "gal_map_text_205000338=唐笑笑反握住你的手，晃了晃才鬆開。",
        "gal_map_text_205000339=街道華燈初上，她走在我身側，手時不時碰到我的手。忽然，她停下腳步。",
        "gal_map_text_205000340=等等！",
        "gal_map_text_205000341=唐笑笑從包裡掏出一個小盒子，遞給我。",
        "gal_map_text_205000342=這個給你。",
        "gal_map_text_205000343=是兩個手工製作的鑰匙扣。一個是Q版貓咪，一個是小狗，粗糙卻可愛。背面分別刻著S和T。",
        "gal_map_text_205000344=這個是從你抓玩偶的身上取下來的，貓咪是我，小狗是你。",
        "gal_map_text_205000345=為什麼我是狗？",
        "gal_map_text_205000346=因為你像小狗一樣，有時候很可愛，有時候又愛理不理的！而且……你剛才抓玩偶時，表情特別溫柔。",
        "gal_map_text_205000347=那你為什麼是貓。",
        "gal_map_text_205000348=我嘛……因為你今天陪我，開心得有點像小貓。",
        "gal_map_text_205000349=你還挺貼切的嗎。",
        "gal_map_text_205000350=不准笑我！",
        "gal_map_text_205000351=她晃了晃鑰匙串，小貓扣叮噹輕響。",
        "gal_map_text_205000352=街道華燈初上，她走在我身側，手時不時碰到我的手。忽然，她停下腳步。",
        "gal_map_text_205000353=把眼睛閉上一下。",
        "gal_map_text_205000354=你這是要幹嘛，不會要送我禮物吧。",
        "gal_map_text_205000355=讓你閉上就閉上，你一個大男人磨磨唧唧的。",
        "gal_map_text_205000356=我眼睛閉上。掌心被放入一個冰涼的小物件。",
        "gal_map_text_205000357=我睜眼看見掌心是一枚三棱鏡，只有拇指大小，邊緣打磨光滑。夕陽穿過它，在你手心投下一道小小的彩虹。",
        "gal_map_text_205000358=我上個月在手工玻璃作坊做的。本來想自己留著……但今天覺得，送你更合適。",
        "gal_map_text_205000359=這麼特別的禮物我怎麼好意思收下。",
        "gal_map_text_205000360=讓你收下就收下。",
        "gal_map_text_205000361=她拿起棱鏡，讓彩虹落在你臉頰。",
        "gal_map_text_205000362=你有時候像光一樣，看起來淡淡的，其實藏著很多顏色。我想……成為能讓你折射出彩虹的那個人",
        "gal_map_text_205000363=我、我就是比喻一下！你別誤會！",
        "gal_map_text_205000364=那你說說看，我到底還藏著什麼顏色。",
        "gal_map_text_205000365=顏色太多了一時半會說不清楚。",
        "gal_map_text_205000366=唐笑笑蹦跳著往前走兩步，回頭牽住你的手。",
        "gal_map_text_205000367=街道華燈初上，她走在我身側，手時不時碰到我的手。忽然，她停下腳步。",
        "gal_map_text_205000368=這個，給你。",
        "gal_map_text_205000369=唐笑笑從背包中筆記本裡小心抽出一張卡片。",
        "gal_map_text_205000370=是一張微型印刷品，約名片大小。畫面精緻複刻了商場某個櫥窗——那是你們剛才路過的叢林書房主題陳列：藤蔓纏繞書架，書本間藏著松鼠模型。",
        "gal_map_text_205000371=這個約名卡還挺別致的，你啥時候買的我怎麼都沒有注意到。",
        "gal_map_text_205000372=是我之前拜託朋友列印的，剛好列印了兩份，多的這一份就送給你了。",
        "gal_map_text_205000373=你不要亂想，沒有別的意思，就是當你今天陪伴的謝禮。",
        "gal_map_text_205000374=真的假的？我明明看到卡片一角寫著一行小字。",
        "gal_map_text_205000375=不許看，快收好別弄丟了這個東西僅有一份多了也沒有了。",
        "gal_map_text_205000376=好的，我這就收好。",
        "gal_map_text_205000377=我把卡片收好，卡片上的一行小字：晴空少女與追風少年。我充滿好奇到底是什麼意思。",
        "gal_map_text_205000378=並肩走在商業街，微風把一天的溫柔都吹得格外清晰。",
        "gal_map_text_205000379=你們聊著剛才的心動與歡喜，腳步不自覺慢下來。路過最開始拿海報的地方，糖笑笑忽然頓了一下，像是忽然想起什麼重要的事。",
        "gal_map_text_205000380=唐笑笑忽然停下，輕輕拉了一下你的衣袖。",
        "gal_map_text_205000381=等等…… 我好像想起一件超重要的事！",
        "gal_map_text_205000382=咋了，想起什麼重要的事。",
        "gal_map_text_205000383=海報背面好像寫著，為了慶祝商業街周年慶，下午五點半開始有特別紀念活動。",
        "gal_map_text_205000384=我愣了一下，這才想起海報背面似乎確實有內容，拿出海報看了看。",
        "gal_map_text_205000385=還真是，但這個條件....",
        "gal_map_text_205000386=啥條件讓我看看。",
        "gal_map_text_205000387=情侶同行，可領取周年紀念打卡券，集滿指定店鋪印章，即可兌換限定紀念品一份……",
        "gal_map_text_205000388=唐笑笑念到情侶兩個字時，她的聲音不自覺地放輕，臉頰也微微泛紅。她抬起頭，認真地看向你，眼睛在燈光下閃爍著期待又帶著點不確定的光。",
        "gal_map_text_205000389=我們還去嘛，或者說我們只去看看也行。",
        "gal_map_text_205000390=那就去看看吧，實在不行我就假裝你女友。我演技很好的。",
        "gal_map_text_205000391=行……行吧。",
        "gal_map_text_205000392=我們手牽手，並肩走向活動諮詢處。工作人員熱情地遞給你們一張設計精美的打卡券和一枚小巧的集章手冊。",
        "gal_map_text_205000393=唐笑笑拿著打卡券，看著上面需要蓋章的各個店鋪圖示，忽然停下了腳步。",
        "gal_map_text_205000394=唐笑笑抬起頭，看向蜿蜒熱鬧、人山人海的商業街，聲音很輕，像在自言自語，又像在問你。",
        "gal_map_text_205000395=我們今天……從在街角遇到開始，然後一起做了蛋糕，一起抓了娃娃，一起摘了果子，還……還一起經歷了那麼多……現在，又這樣牽著手……",
        "gal_map_text_205000396=這算不算是……已經不知不覺，把這場周年慶的‘活動’，從頭到尾，都體驗了一遍？",
        "gal_map_text_205000397=何止是體驗了一遍，這大概......是我參加過，最棒的一場‘活動’了，沒有之一。",
        "gal_map_text_205000398=那……我們，去把最後一個紀念章補蓋上，好不好？",
        "gal_map_text_205000399=就當是……給今天的我們，蓋上一個正式的句點。一個隻屬於我們兩個人的限定活動。",
        "gal_map_text_205000400=兩人手牽手，並肩走向最後的蓋章櫃檯。工作人員是一位慈祥的阿姨，她看著你們緊握的雙手和略帶羞澀但幸福洋溢的臉，露出了了然而祝福的笑容。",
        "gal_map_text_205000401=來，兩位，在這裡蓋章哦。一左一右，蓋在一起，就能拼成一個完整的心形。",
        "gal_map_text_205000402=她遞上兩枚小小的、圖案分別是半顆心的印章。",
        "gal_map_text_205000403=你們相視一笑。糖笑笑先拿起左邊的印章，在打卡券指定的位置，輕輕按下。然後，你將右邊的印章，嚴絲合縫地蓋在了她留下的印記旁邊。",
        "gal_map_text_205000404=哢噠，一聲輕微的、令人心安的貼合聲。",
        "gal_map_text_205000405=兩枚半心印章完美地拼接在一起，在打卡券上形成了一個完整的、線條流暢的愛心。",
        "gal_map_text_205000406=你知道嗎，我剛才忽然覺得，海報上寫的這個活動，簡直就像個‘幌子’。",
        "gal_map_text_205000407=幌子？",
        "gal_map_text_205000408=嗯。真正的‘限定活動’，獨一無二、僅此一次的……其實是和你一起度過的，這一整個漫長的時光。",
        "gal_map_text_205000409=這個，才是用什麼都換不到的。",
        "gal_map_text_205000410=就在我話音落下的瞬間——嘭！嘭！嘭！",
        "gal_map_text_205000411=一連串輕響從商業街中心廣場傳來，緊接著，無數五彩斑斕的、帶著LED小燈的氣球，如同逆流的彩虹，齊齊升上夜空！它們交織、盤旋，將整條商業街的上空點綴成一片絢爛而夢幻的海洋。",
        "gal_map_text_205000412=快來！幫我拍一張！要拍出‘晴空慶典限定版’的感覺！",
        "gal_map_text_205000413=我著拿出手機，對準她。",
        "gal_map_text_205000414=鏡頭裡的她，身後是漫天飛舞的絢爛氣球和璀璨霓虹，臉上是毫無保留的、自信又燦爛的笑容，青春的氣息撲面而來，耀眼得讓人移不開視線。",
        "gal_map_text_205000415=哢嚓一聲。我按下快門，定格了這個瞬間。",
        "gal_map_text_205000416=怎麼樣？這個‘周年慶氣球海洋限定版’的我，是不是比平時那個的我，要耀眼那麼一點點？",
        "gal_map_text_205000417=很特別，我平時見過的你想像中的，還要耀眼的多。",
        "gal_map_text_205000418=用蓋滿印章的打卡券，你們兌換了一對小巧精緻的情侶鑰匙扣，一隻小貓，一隻小狗，和今天的故事奇妙地呼應。真正的禮物似乎早已在過程中獲得。",
        "gal_map_text_205000419=該分別了。你們並肩走到地鐵站入口，喧囂漸漸被拋在身後。",
        "gal_map_text_205000420=唐笑笑捏著交通卡，在閘機前磨蹭著。",
        "gal_map_text_205000421=所以！下、下次！如果……如果你又覺得在家裡無聊，想要出來隨便逛逛的時候……能不能……也帶上我？",
        "gal_map_text_205000422=下次地點我定！你……願不願意，再跟我一起去？",
        "gal_map_text_205000423=好。下次，還在老地方碰面。",
        "gal_map_text_205000424=說定了！不准遲到！不准放鴿子！",
        "gal_map_text_205000425=閘機門嘀”的一聲打開，又即將關閉。",
        "gal_map_text_205000426=唐笑笑刷卡，轉身走進閘機。走了幾步，忽然又停下，轉過身，小跑著回來——",
        "gal_map_text_205000427=隔著閘機的欄杆，她飛快地踮起腳尖，在你臉頰上留下一個輕柔如羽毛、卻帶著她特有桃子甜香的吻。",
        "gal_map_text_205000428=這、這是預付的定金！怕你反悔！我……我走了！下次見！",
        "gal_map_text_205000429=我站在原地，指尖輕輕碰了碰臉頰被親吻過的地方。那裡好像還留著柔軟的觸感，和一股說不上來的、暖暖的悸動。",
        "gal_map_text_205000430=微風穿過地鐵站口，帶來夏末夜晚特有的微涼，卻吹不散心頭那份持續升溫的、名為期待”的暖意。",
        "gal_map_text_205000431=口袋裡的情侶鑰匙扣輕輕相碰，發出細微的脆響。你轉身步入夜色，腳步不自覺地變得輕快，嘴角揚起的弧度，久久未曾落下。",
        "player_name=【不用翻譯】，程式使用的id，填寫此文本id，程式會修改為使用玩家自己取的名字作為名字顯示",
