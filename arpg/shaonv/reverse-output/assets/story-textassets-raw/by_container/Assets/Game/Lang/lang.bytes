        "push_news_title_1=塵世探秘結束",
        "push_news_title_2=戰爭提示",
        "push_news_title_3=免戰狀態",
        "push_news_title_4=建造空閒",
        "push_news_title_5=研究空閒",
        "push_news_title_6=資源工廠空閒",
        "push_news_title_7=訓練完成",
        "push_news_title_8=部隊動態",
        "push_news_title_9=公會指揮部即將受到攻擊",
        "push_news_title_10=異裝入侵準備階段",
        "push_news_title_11=異裝入侵開始迎敵",
        "push_news_title_12=死翼降臨",
        "push_news_content_1=當塵世探秘結束時，將會收到手機通知",
        "push_news_content_2=被攻擊、偵查時，將會收到手機推送",
        "push_news_content_3=當防護罩即將消失時，將會收到手機推送",
        "push_news_content_4=當城內建造隊列處於空閒時，將會收到手機推送",
        "push_news_content_5=當研究所的研究隊列處於空閒時，將會收到手機推送",
        "push_news_content_6=當資源工廠處於無人委任情況下，將會收到手機推送",
        "push_news_content_7=當士兵訓練完成時，將會收到手機推送",
        "push_news_content_8=當出征部隊回城時，將會收到手機推送",
        "push_news_content_9=當發現有敵軍向公會指揮部行軍時，將會收到手機推送",
        "push_news_content_10=異裝入侵活動開始後，將會收到手機推送",
        "push_news_content_11=異裝入侵開啟迎敵後，將會收到手機推送",
        "push_news_content_12=死亡之翼出現後，將會收到手機推送",
        "push_news_push_title_1=塵世探秘結束",
        "push_news_push_title_2=戰爭提醒",
        "push_news_push_title_3=防護罩消失",
        "push_news_push_title_4=建造完成",
        "push_news_push_title_5=研究完成",
        "push_news_push_title_6=資源工廠空閒",
        "push_news_push_title_7=士兵訓練完成",
        "push_news_push_title_8=部隊返回",
        "push_news_push_txt_1=引航者，您的塵世探秘部隊已返回！",
        "push_news_push_txt_2=引航者，發現有來歷不明的隊伍正在向您城市行軍！",
        "push_news_push_txt_3=引航者，您的防護罩即將消失！",
        "push_news_push_txt_4=引航者，您的城內建造隊列處於空閒中！",
        "push_news_push_txt_5=引航者，您的科研隊列處於空閒中！",
        "push_news_push_txt_6=引航者，資源工廠處於空閒中！",
        "push_news_push_txt_7=引航者，您的士兵訓練完成！",
        "push_news_push_txt_8=引航者，您的部隊已返回到城市！",
        "playlv_101=速通次數{0}",
        "playlv_102=攻擊災械行軍速度+{0}%",
        "playlv_103=資源產量+{0}%",
        "playlv_104=採集速度+{0}%",
        "playlv_105=部隊負重+{0}%",
        "playlv_106=女僕容量+{0}",
        "playlv_107=機裝人型等級上限提升至{0}",
        "system_notice1=<Color=#00aeff>{0}</Color>公會成功擊敗了<Color=#ff8729>{1}</Color>級鐵鷲BOSS，使全公會成員獲得豐厚獎勵！",
        "system_notice2=<Color=#00aeff>{0}</Color>誠心邀請各位引航者加入公會共同發展！",
        "system_notice3=恭喜<Color=#00aeff>{0}</Color>招募到了{1}幻靈{2}！",
        "system_notice5=寶箱活動開啟啦！請各位引航者前往世界尋找寶箱！豐厚大禮等你來拿！",
        "system_notice6=<Color=#00aeff>{0}</Color>級精英災械出現在世界座標<Color=#ff8729>{1}</Color>為非作歹，還望各位引航者派兵將其擊敗",
        "system_notice7=恭喜<Color=#00aeff>{0}</Color>打開了<Color=#ff8729>{1}</Color>意外獲得{2}",
        "system_notice8=恭喜<Color=#00aeff>{0}</Color>在<Color=#ff8729>{1}</Color>索敵意外獲得{2}",
        "system_notice10=<Color=#00aeff>{0}</Color>級死亡之翼已經降臨在座標<Color=#ff8729>{1}</Color>，請全服幻靈前往擊敗，守護世界",
        "system_notice11=鐵鷲突襲活動已開啟，鐵鷲巨像將於每日19:00-23:00整點隨機降臨在世界各個角落，請各位幻靈組隊前往擊敗。",
        "system_notice13=距離要塞爭霸爭奪階段開啟，還剩<Color=#00aeff>{0}</Color>分鐘，請司令官們做好戰鬥準備",
        "system_notice14=距離要塞爭霸爭奪階段結束，還剩<Color=#00aeff>{0}</Color>分鐘，司令官們請把握最後的時間喲",
        "system_notice15=恭喜<Color=#218aff>{0}</Color>成功擊退Lv.{1}{2}，完成首殺。",
        "system_notice16=距離遺跡爭霸爭奪階段開啟，還剩{0}分鐘，請司令官們做好戰鬥準備",
        "system_notice17=距離遺跡爭霸爭奪階段結束，還剩{0}分鐘，司令官們請抓緊最後的時間喲",
        "system_notice18=恭喜{0}率領{1}在遺跡爭霸排行中獲得第1名，成為本任時空掌控者！",
        "system_notice19=恭喜司令官<Color=#218aff>{0}</Color>在超值大轉盤中獲得<Color=#218aff>{1}%收益</Color>",
        "system_notice20=恭喜{0}率領{1}在遺跡爭霸排行中獲得第1名，成為本任時空掌控者！",
        "system_notice23=恭喜<Color=#00aeff>{0}</Color>擊退<Color=#ff8729>Lv.{1}{2}</Color>完成個人首殺，獲得{3}",
        "system_notice24=恭喜<Color=#00aeff>{0}</Color>擊退<Color=#ff8729>Lv.{1}{2}</Color>，獲得{3}",
        "system_notice25=恭喜<Color=#00aeff>{0}</Color>將{1}提升至<Color=#00aeff>{2}</Color>星",
        "system_notice26=恭喜<Color=#00aeff>{0}</Color>將{1}覺醒至<Color=#00aeff>{2}</Color>星",
        "time_login1001=【定時登入活動】\n\n1.每日<Color=#215aff>11:00-14:00</Color>,<Color=#215aff>18:00-21:00</Color>上線，均可領取<Color=#215aff>星鑽獎勵</Color>。\n2.累計領取一定次數後，獎勵將<Color=#215aff>提升</Color>，可以領取<Color=#215aff>更多星鑽</Color>。",
        "advanced_account_02=低",
        "evolution_des_01=【品質突破】\n\n1.當角色星級到達<Color=#218aff>5星</Color>，可以進行通過突破<Color=#218aff>提升品質</Color>\n\n2.突破消耗角色<Color=#218aff>專屬道具</Color>，道具可以通過活動或星鑽商城購買。\n\n3.進階後，屬性成長，主動技能與天賦都將獲得提升。\n\n4.突破後，幻靈等級、靈裝和靈階均<Color=#218aff>保留</Color>，幻靈星級衰減為4星。\n\n5.突破後可以繼續使用原升星道具提升星級。\n\n6.僅<Color=#218aff>蘇嬋與法芙娜</Color>可以進行品質突破",
        "UI80913=1.靈裝進階後會出現隨機出現強力的詞條提升戰鬥力\n2.司令官可以自己根據當前幻靈的特性選擇洗練來定制屬於自己的靈盔屬性\n3.洗練屬性功能會隨機替換當前選中詞條的屬性與數值\n4.洗練數值功能功能會鎖定當前屬性，只改變對應的數值\n5.洗練後即使不滿意結果也不要緊，只有點擊確認後才會更換對應數值\n6.同一把靈盔中，不會同時出現兩個相同詞條，如兩個統帥值詞條\n7.靈裝洗練評級是用來評價一把靈盔的稀有程度的，不一定是最適合該幻靈的，請司令官根據實際情況自行斟酌靈盔詞條\n8.靈盔與勳章可獲得詞條:統帥值，水相陣容攻擊，風相攻擊，火相陣容攻擊，土相陣容攻擊，水相傷害加成，風相傷害加成，火炮傷害加成，土相傷害加成，暴擊率，命中率，對災械傷害加成\n9.靈甲與靈靴可獲得詞條:統率值，水相生命，風相生命，火炮生命，土相生命，水相傷害減免，風相傷害減免，火炮傷害減免，土相傷害減免，抗暴率，閃避率",
        "fwdate_001=長期光顧的熟客贈送一張高級咖啡豆優惠券，下一次進貨時能夠獲得雙倍原料。<Color=#228B22>（下次獲得的獎勵翻倍，不包括精英）</Color>",
        "fwdate_002=宅男團集體使用「痛充電寶」導致跳閘，售賣商品一定時間內無法結算。<Color=#FF0000>（下次獲得的獎勵無效，不包括精英）</Color>",
        "fwdate_003=你發動女僕專屬技能“萌力全開”，快速完成100杯訂單，再次獲得200杯訂單。<Color=#228B22>（當前已獲得的獎勵翻倍，不包括精英）</Color>",
        "fwdate_004=參加「萌系甜點大賽」時烤焦三盤曲奇，並在滅火時撞翻放在操作臺的麵粉。<Color=#FF0000>（損失了1件物品）</Color>",
        "fwdate_005=與虛擬偶像聯動直播時，誤將螢光棒當作攪拌棒投入咖啡機引發劇烈爆炸。<Color=#FF0000>（損失2件物品）</Color>",
        "fwdate_006=暴雨中配送「獸耳便當盒」，女僕們配送的商品被突如其來的洪水沖走。<Color=#FF0000>（損失3件物品）</Color>",
        "fwdate_007=小學生闖入後廚玩「廚房過家家」，點燃廚房的物資和商品，雖然火災很快被撲滅，還是損失了大量半成品。<Color=#FF0000>（損失了4件物品）</Color>",
        "fwdate_008=「顧客VS女僕日」混戰中，狂熱的粉絲擠進咖啡店，擁擠的人流造成巨大的混亂，櫃檯的商品受到不同程度的損壞。<Color=#FF0000>（損失5件物品）</Color>",
        "fwdate_009=偶像聲優的素人替身姐妹花入職，外貌相似度引發雙胞胎應聘熱潮。<Color=#228B22>（本輪已獲得女僕數量翻倍）</Color>",
        "fwdate_010=部分女僕被甜品店挖角成為「試吃網紅」，辭職信寫著“去追尋奶油人生”。<Color=#FF0000>（失去了10%本輪已獲得女僕）</Color>",
        "fwdate_011=許多女僕沉迷《女僕榮耀》手遊，大家相約集體離職前往其他城市的線下賽場觀賽。<Color=#FF0000>（失去了20%本輪已獲得女僕）</Color>",
        "fwdate_012=《整人大賞》的嘉賓偽裝成客人惡搞，導致許多女僕因為受到嚴重驚嚇提交辭呈。<Color=#FF0000>（失去了30%本輪已獲得女僕）</Color>",
        "fwdate_013=電路老化導致全店黑暗，大量女僕自發組成“光明特攻隊”前往批發市場，卻因沉迷試吃草莓樣品再也沒有回來。<Color=#FF0000>（失去了40%本輪已獲得女僕）</Color>",
        "liuming=女僕",
        "core_001=1.穿戴傳承契印會為當前幻靈所攜帶的兵種提升強力的屬性\n2.每個傳承契印都有其對應的套裝效果，當集齊相同種類的<Color=#215aff>四件傳承契印</Color>後，將激活強大的套裝效果\n3.傳承契印有位置區分，如01象限的傳承契印不可以穿戴到02象限\n4.穿戴兩件相同套裝的核心後可以激活<Color=#215aff>2件套特殊效果</Color>，該效果只能生效一次，所有套裝共用\n5.消耗3個<Color=#215aff>完全相同的套裝</Color>可以合成<Color=#215aff>同位置同套裝</Color>的更高等級套裝，高等級傳承契印擁有巨大的戰鬥力提升\n",
